        # To efficiently handle all possible targets, we can precompute all possible sums and their contributions
        sum_contributions = defaultdict(int)
        for i in range(n):
            h1 = unique_heights[i]
            for j in range(i + 1, n):
                h2 = unique_heights[j]
                s = h1 + h2
                sum_contributions[s] += min(freq[h1], freq[h2])

        # Now, for each possible target (original or sum), compute the maximum possible planks
