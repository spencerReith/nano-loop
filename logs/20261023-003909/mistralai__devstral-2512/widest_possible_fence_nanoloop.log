```python
from collections import defaultdict

class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        freq = defaultdict(int)
        for h in planks:
            freq[h] += 1
        unique_heights = list(freq.keys())
        possible_heights = set()
        n = len(unique_heights)

        for i in range(n):
            h1 = unique_heights[i]
            possible_heights.add(h1)
            for j in range(i + 1, n):
                h2 = unique_heights[j]
                possible_heights.add(h1 + h2)

        max_width = 0
        for h in possible_heights:
            total = freq.get(h, 0)
            for a in unique_heights:
                b = h - a
                if b < a:
                    continue
                if b in freq:
                    if a == b:
                        total += freq[a] // 2
                    else:
                        total += min(freq[a], freq[b])
            if total > max_width:
                max_width = total

        if max_width == 0 and planks:
            return 1
        return max_width
```