from collections import defaultdict

class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        freq = defaultdict(int)
        for h in planks:
            freq[h] += 1
        unique_heights = list(freq.keys())
        max_width = 0
        n = len(unique_heights)

        # Check all possible target heights: original heights and sums of two distinct heights
        # To avoid duplicates, we can consider all possible sums of two distinct heights
        possible_heights = set()
        for i in range(n):
            h1 = unique_heights[i]
            possible_heights.add(h1)
            for j in range(i + 1, n):
                h2 = unique_heights[j]
                possible_heights.add(h1 + h2)

        for h in possible_heights:
            total = 0
            # Count original planks with height h
            total += freq.get(h, 0)
            # Count pairs that sum to h
            # We need to find all pairs (a, b) where a < b and a + b = h
            # Also, a and b must be in the original planks
            # To avoid double counting, we can iterate through all possible a in unique_heights
            # and check if (h - a) exists and is >= a (to avoid duplicates)
            used = set()
            for a in unique_heights:
                b = h - a
                if b < a:
                    continue  # to avoid processing (a,b) and (b,a) separately
                if b in freq:
                    if a == b:
                        # Need to choose 2 distinct planks of height a
                        cnt = freq[a]
                        pairs = cnt * (cnt - 1) // 2
                        total += pairs
                    else:
                        total += freq[a] * freq[b]
            max_width = max(max_width, total)

        # Also, the minimal case is 1 (using any single plank)
        if max_width == 0:
            if planks:
                return 1
            else:
                return 0
        return max_width
