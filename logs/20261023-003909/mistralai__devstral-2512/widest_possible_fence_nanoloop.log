from collections import defaultdict

class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        freq = defaultdict(int)
        for h in planks:
            freq[h] += 1
        unique_heights = list(freq.keys())
        possible_heights = set()
        n = len(unique_heights)

        # Generate all possible heights: original and sums of two distinct heights
        for i in range(n):
            h1 = unique_heights[i]
            possible_heights.add(h1)
            for j in range(i + 1, n):
                h2 = unique_heights[j]
                possible_heights.add(h1 + h2)

        max_width = 0
        for h in possible_heights:
            total = freq.get(h, 0)
            # Now count the number of pairs (a, b) with a < b and a + b = h
            # Also, for a == b, count C(freq[a], 2)
            # To avoid double counting, iterate a in unique_heights and b = h - a >= a
            for a in unique_heights:
                b = h - a
                if b < a:
                    continue
                if b in freq:
                    if a == b:
                        total += freq[a] // 2
                    else:
                        total += min(freq[a], freq[b])
            if total > max_width:
                max_width = total

        # The minimal case is 1 if there's at least one plank
        if max_width == 0 and planks:
            return 1
        return max_width
```

