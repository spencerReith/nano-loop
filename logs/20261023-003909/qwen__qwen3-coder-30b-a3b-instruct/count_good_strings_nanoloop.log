```python
class Solution:
    def countGoodStrings(self, n: int) -> int:
        MOD = 10**9 + 7
        
        # Base cases
        if n == 1:
            return 2
        if n == 2:
            return 2
        if n == 3:
            return 4
        if n == 4:
            return 6
        
        # For n >= 5, the sequence follows f(n) = f(n-1) + f(n-2)
        # This is derived from the mathematical structure of the problem  
        prev2 = 2  # f(2)      
        prev1 = 4  # f(3)  
        
        for i in range(4, n + 1):
            current = (prev1 + prev2) % MOD
            prev2 = prev1
            prev1 = current
            
        return prev1
```