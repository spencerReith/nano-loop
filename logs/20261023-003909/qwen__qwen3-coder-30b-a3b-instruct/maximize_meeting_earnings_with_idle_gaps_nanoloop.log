class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        # Sort meetings by start time
        meetings.sort()
        n = len(meetings)
        
        # dp[i] = maximum total earnings considering meetings 0 to i, with meeting i included in the best arrangement
        dp = [0] * n
        
        for i in range(n):
            # Option 1: Don't take meeting i
            if i > 0:
                dp[i] = dp[i-1]
            else:
                dp[i] = 0
            
            # Option 2: Take meeting i
            current_revenue = meetings[i][2]
            
            # Find latest meeting that doesn't overlap with current meeting
            # Binary search for the latest meeting that ends <= current start time
            prev_non_overlap = -1
            left, right = 0, i - 1
            while left <= right:
                mid = (left + right) // 2
                if meetings[mid][1] <= meetings[i][0]:
                    prev_non_overlap = mid
                    left = mid + 1
                else:
                    right = mid - 1
            
            # If there's a previous non-overlapping meeting
            if prev_non_overlap != -1:
                # Idle time is current start - previous end
                idle_time = meetings[i][0] - meetings[prev_non_overlap][1]
                # Total is current revenue + idle time + best earnings up to previous meeting
                dp[i] = max(dp[i], current_revenue + idle_time + dp[prev_non_overlap])
            else:
                # No previous meeting, just take current revenue
                dp[i] = max(dp[i], current_revenue)
                
        return dp[n-1]
