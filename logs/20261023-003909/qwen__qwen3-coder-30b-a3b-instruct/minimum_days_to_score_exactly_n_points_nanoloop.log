```python
class Solution:
    def minDays(self, n: int) -> int:
        # This is the standard DP approach for this type of problem
        # dp[i] represents the minimum number of days to earn exactly i points
        dp = [float('inf')] * (n + 1)
        dp[0] = 0
        
        # For each point value from 1 to n
        for i in range(1, n + 1):
            # Try forming a streak from k consecutive earning days
            # A streak of k days gives 1+2+...+k = k*(k+1)/2 points
            # This takes exactly k days
            k = 1
            while k * (k + 1) // 2 <= i:
                points_in_streak = k * (k + 1) // 2
                remaining_points = i - points_in_streak
                dp[i] = min(dp[i], k + dp[remaining_points])
                k += 1
                
        return dp[n]
```