```python
class Solution:
    def minDays(self, n: int) -> int:
        dp = [float('inf')] * (n + 1)
        dp[0] = 0
        
        for i in range(1, n + 1):
            k = 1
            while k * (k + 1) // 2 <= i:
                points_from_streak = k * (k + 1) // 2
                remaining = i - points_from_streak
                dp[i] = min(dp[i], k + dp[remaining])
                k += 1
                
        return dp[n]
```

