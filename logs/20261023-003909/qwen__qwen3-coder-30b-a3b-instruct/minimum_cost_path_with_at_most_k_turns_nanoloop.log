```python
import heapq
from typing import List

class Solution:
    def minCost(self, grid: List[List[int]], k: int) -> int:
        m, n = len(grid), len(grid[0])
        
        # Directions: up, down, left, right
        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]
        
        # Dijkstra with state (cost, row, col, turns, last_direction)
        # last_direction: 0=up, 1=down, 2=left, 3=right, -1=none (start)
        pq = [(grid[0][0], 0, 0, 0, -1)]
        
        # visited[state] = minimum cost to reach that state
        visited = {}
        
        while pq:
            cost, i, j, turns, last_dir = heapq.heappop(pq)
            
            # If we reached the destination
            if i == m - 1 and j == n - 1:
                return cost
            
            # Skip if we've seen this state before with better cost
            state = (i, j, turns, last_dir)
            if state in visited and visited[state] <= cost:
                continue
            visited[state] = cost
            
            # Try all 4 directions
            for dir_idx, (di, dj) in enumerate(directions):
                ni, nj = i + di, j + dj
                
                # Check bounds
                if 0 <= ni < m and 0 <= nj < n:
                    # Calculate new turns count
                    new_turns = turns
                    if last_dir != -1 and last_dir != dir_idx:
                        # Direction changed, increment turns
                        new_turns += 1
                    
                    # Check if we exceed the turn limit
                    if new_turns <= k:
                        new_cost = cost + grid[ni][nj]
                        new_state = (ni, nj, new_turns, dir_idx)
                        
                        # Only add to queue if we haven't visited this state with better cost
                        if new_state not in visited or visited[new_state] > new_cost:
                            heapq.heappush(pq, (new_cost, ni, nj, new_turns, dir_idx))
        
        return -1
```