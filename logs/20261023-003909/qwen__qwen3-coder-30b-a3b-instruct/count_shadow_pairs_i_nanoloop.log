class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        
        # Check all pairs where nums[i] < nums[j]
        for i in range(n):
            for j in range(i + 1, n):
                # Check if nums[i] < nums[j]
                if nums[i] < nums[j]:
                    # Check if all elements between i and j are >= nums[i]
                    valid = True
                    for k in range(i + 1, j):
                        if nums[k] < nums[i]:
                            valid = False
                            break
                    
                    if valid:
                        count += 1
                        
        return count
