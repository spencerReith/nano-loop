```python
class Solution:
    def minDays(self, n: int) -> int:
        from collections import deque
        
        # BFS with state (score, streak_length)
        queue = deque([(0, 0, 0)])  # (score, streak_length, days)
        visited = set()
        visited.add((0, 0))
        
        while queue:
            score, streak, days = queue.popleft()
            
            if score == n:
                return days
                
            # Option 1: Continue streak (earn next point)
            next_streak = streak + 1
            new_score = score + next_streak
            if new_score <= n and (new_score, next_streak) not in visited:
                visited.add((new_score, next_streak))
                queue.append((new_score, next_streak, days + 1))
            
            # Option 2: Skip (reset streak)
            if (score, 0) not in visited:
                visited.add((score, 0))
                queue.append((score, 0, days + 1))
        
        return -1  # Should never reach here for valid input
```