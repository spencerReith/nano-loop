```python
from collections import defaultdict

class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        if not planks:
            return 0
        
        # Count occurrences of each height
        count = defaultdict(int)
        for h in planks:
            count[h] += 1
        
        # For each unique height, count how many planks can form it
        # Either as-is, or combined from two different planks
        unique_heights = sorted(count.keys())
        result = 0
        
        for h in unique_heights:
            # Planks with exact height h
            width = count[h]
            
            # For each other height a
            for a in unique_heights:
                b = h - a
                if b not in count:
                    continue
                if a == b:
                    # Two planks of same height needed
                    if count[a] >= 2:
                        width += count[a] - 1
                else:
                    # Count combinations of planks of height a and height b
                    # Only count each unordered pair once (a < b)
                    # We can make min(count[a], count[b]) pairs
                    if a < b:
                        width += min(count[a], count[b])
            
            result = max(result, width)
        
        return result
```