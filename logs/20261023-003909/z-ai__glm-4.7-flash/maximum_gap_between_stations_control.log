class Solution:
    def maximumGap(self, skill: str, station: str) -> int:
        # Dictionary to store indices of stations matching a skill
        skill_to_stations = {}
        for idx, char in enumerate(station):
            if char not in skill_to_stations:
                skill_to_stations[char] = []
            skill_to_stations[char].append(idx)
        
        m = len(station)
        # We maintain the smallest index for the previous worker's station
        prev_station_idx = -m
        
        max_gap = 0
        
        # Iterate through the workers in order
        for char in skill:
            # Ensure we have enough stations for this skill
            station_indices = skill_to_stations[char]
            
            # We need to assign a distinct station to this worker.
            # To maximize the gap, we should assign the largest remaining index for this worker.
            # This places the current worker as far to the right as possible.
            # Since we process workers in order (left to right),
            # using the largest available index acts like a greedy greedy choice 
            # similar to a "nearest feasible solution" from the right end.
            current_station_idx = station_indices[-1]
            station_indices.pop() # Remove the used station from the pool
            
            # Calculate the gap
            gap = current_station_idx - prev_station_idx
            max_gap = max(max_gap, gap)
            
            # Update the previous station index
            prev_station_idx = current_station_idx
            
        return max_gap
