1. For the first worker, use the leftmost position of their skill to leave room for later.
2. For each subsequent worker, use the rightmost position of their skill to maximize the gap.

This ensures we always pick the farthest possible valid position, maximizing the maximum gap.</think>```python
class Solution:
    def maximumGap(self, skill: str, station: str) -> int:
        from bisect import bisect_right

        # Build a map from character to list of its indices in station
        pos_map = {}
        for idx, char in enumerate(station):
            if char not in pos_map:
                pos_map[char] = []
            pos_map[char].append(idx)

        max_gap = 0
        prev_idx = -1

        # Assign each worker
        for i in range(len(skill)):
            char = skill[i]
            positions = pos_map[char]
            
            if i == 0:
                # Use leftmost position for first worker
                idx = positions[0]
            else:
                # For subsequent workers, use rightmost position > prev_idx
                idx = positions[-1]
            
            if i > 0:
                gap = idx - prev_idx
                max_gap = max(max_gap, gap)
            
            prev_idx = idx

        return max_gap
