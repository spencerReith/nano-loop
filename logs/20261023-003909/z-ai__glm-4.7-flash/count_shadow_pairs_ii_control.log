class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        
        # We will iterate j from 1 to n-1
        for j in range(1, n):
            current_val = nums[j]
            # We look at all i < j to find candidate pairs
            for i in range(j):
                if nums[i] < current_val:
                    # Check if there exists k in (i, j)
                    # such that nums[i] < nums[k] < current_val
                    # This is equivalent to checking if nums[i] is the immediate
                    # previous minimum in the range (0, j)
                    if nums[i] == min(nums[0:j]):
                        count += 1
                        
        return count
