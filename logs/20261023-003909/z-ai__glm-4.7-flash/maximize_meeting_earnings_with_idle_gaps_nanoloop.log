class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        # Sort meetings by start time
        meetings.sort(key=lambda x: x[0])
        n = len(meetings)
        if n == 0:
            return 0
        
        # Sort meetings by end time for binary search
        meetings_by_end = sorted([(end, start, revenue) for start, end, revenue in meetings])
        
        # dp: stores (end_time, max_earnings) pairs in increasing end time
        dp = []
        for start_i, end_i, rev_i in meetings:
            # Find best meeting that ends <= start_i
            best_take_idx = -1
            lo, hi = 0, len(meetings_by_end) - 1
            while lo <= hi:
                mid = (lo + hi) // 2
                if meetings_by_end[mid][0] <= start_i:
                    best_take_idx = mid
                    lo = mid + 1
                else:
                    hi = mid - 1
            
            # Calculate base earnings for taking meeting i
            if best_take_idx == -1:
                base = rev_i
            else:
                # Find max earnings among meetings ending <= start_i
                lo_dp, hi_dp = 0, len(dp) - 1
                best_dp_idx = -1
                while lo_dp <= hi_dp:
                    mid = (lo_dp + hi_dp) // 2
                    if dp[mid][0] <= start_i:
                        best_dp_idx = mid
                        lo_dp = mid + 1
                    else:
                        hi_dp = mid - 1
                if best_dp_idx == -1:
                    base = rev_i
                else:
                    base = dp[best_dp_idx][1] + rev_i
            
            # Add idle gap
            if best_take_idx != -1:
                base += start_i - meetings_by_end[best_take_idx][0]
            
            # Insert into dp in sorted order by end time
            lo, hi = 0, len(dp) - 1
            while lo <= hi:
                mid = (lo + hi) // 2
                if dp[mid][0] <= end_i:
                    lo = mid + 1
                else:
                    hi = mid - 1
            dp.insert(lo, (end_i, base))
        
        return dp[-1][1]
