class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        
        # Iterate through each possible left index i
        for i in range(n):
            left_val = nums[i]
            shadow_count = 0
            
            # Iterate through each possible right index j > i
            for j in range(i + 1, n):
                right_val = nums[j]
                
                # Condition 1: nums[i] < nums[j]
                if left_val >= right_val:
                    break
                
                # Condition 2: No index k exists such that i < k < j and nums[k] < nums[i] < nums[j]
                is_shadow = True
                
                # Optimization: check if the minimum element in (i, j) is greater than or equal to nums[i]
                # If so, the second condition is satisfied. Otherwise, it's not.
                min_subarray = min(nums[i+1:j])
                
                if min_subarray < left_val:
                    is_shadow = False
                
                if is_shadow:
                    shadow_count += 1
            
            count += shadow_count
        
        return count
