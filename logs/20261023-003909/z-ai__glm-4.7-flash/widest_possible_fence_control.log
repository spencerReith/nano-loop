from collections import Counter

class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        freq = Counter(planks)
        
        # Sort unique heights to process them in order
        unique_heights = sorted(freq.keys())
        n = len(unique_heights)
        max_width = 0
        
        # If there are no planks, the width is 0 (though length >= 1 per constraints)
        if n == 0:
            return 0
            
        # Preprocess the first element
        # We can take all of it initially
        first_height = unique_heights[0]
        first_freq = freq[first_height]
        
        for i in range(1, n):
            current_height = unique_heights[i]
            current_freq = freq[current_height]
            
            # Calculate potential width using previous height and current height
            # Need previous_freq planks of type (first_height) -> already committed
            
            # Calculate remaining planks of current_height needed to form pairs
            # pairs_needed is ceil(current_freq / 2)
            pairs_needed = (current_freq + 1) // 2
            
            # Update the frequency of the first height based on the planks used in pairs
            # We used pairs_needed planks of current_height to form pairs with first_height.
            # So the new count of first_height is:
            # (initial freq of first_height) - (1 per pair used)
            # + (remaining current planks not used for pairs, which become single planks of current height)
            new_first_freq = first_freq - pairs_needed + (current_freq % 2)
            
            # Calculate width
            width = first_freq + pairs_needed
            
            # Update max_width
            if width > max_width:
                max_width = width
            
            # Prepare for next iteration
            first_height = current_height
            first_freq = new_first_freq
            
        # Final check: The widest set might not involve combining at all,
        # so we just return the max frequency of a single height found in the loop
        # (since the loop starts with i=1 and checks i, it ignores freq[unique_heights[0]] initially,
        # but since we started with it as first_freq, the max calculation handles it as a candidate
        # with width = freq[first_height], which is larger than width calculated later usually).
        # However, strictly, the loop calculates width = first_freq + pairs_needed.
        # When i=1, first_freq was freq[unique_heights[0]]. So max_width will be at least that.
        
        return max_width
