class Solution:
    def minDays(self, n: int) -> int:
        # This is a known solution pattern
        # The answer is the smallest integer k such that k(k+1)/2 >= n
        # But not quite, because we need exactly n.
        
        # The correct solution uses recursion with memoization:
        
        from functools import lru_cache
        
        @lru_cache(maxsize=None)
        def min_days(rem):
            if rem == 0:
                return 0
            if rem == 1:
                return 1
            
            # Find the largest k such that k(k+1)/2 <= rem
            k = int((2 * rem) ** 0.5)
            while k * (k + 1) // 2 > rem:
                k -= 1
            
            # If we can achieve exactly rem with streak of length k
            if k * (k + 1) // 2 == rem:
                return k
            
            # Otherwise, we need a skip and then more points
            return k + 1 + min_days(rem - k * (k + 1) // 2)
        
        return min_days(n)
