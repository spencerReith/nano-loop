class Solution:
    def minDays(self, n: int) -> int:
        # Find the largest k such that k*(k+1)/2 <= n
        k = int((2 * n) ** 0.5)
        while k * (k + 1) // 2 > n:
            k -= 1
        
        # If we can achieve exactly n with one streak
        if k * (k + 1) // 2 == n:
            return k
        
        # Otherwise, we need at least k+1 days
        # The remaining points needed
        remaining = n - k * (k + 1) // 2
        
        # Find the minimum days needed to get exactly 'remaining' points
        # This is a similar problem
        # The answer is k + 1 + minDays(remaining)
        # But we can compute it directly
        # The minimum days to achieve exactly 'remaining' points is the same problem
        # Let's use the same algorithm recursively, but let's try to avoid deep recursion
        # Instead, let's use a while loop to simulate
        
        # Since remaining < k*(k+1)/2 and k is roughly sqrt(2n), the recursion depth is small
        # We'll use recursion with memoization
        
        from functools import lru_cache
        
        @lru_cache(maxsize=None)
        def min_days(rem):
            if rem == 0:
                return 0
            if rem == 1:
                return 1
            
            # Find max k such that k(k+1)/2 <= rem
            k = int((2 * rem) ** 0.5)
            while k * (k + 1) // 2 > rem:
                k -= 1
            
            total_points = k * (k + 1) // 2
            if total_points == rem:
                return k
            
            return k + 1 + min_days(rem - total_points)
        
        return k + 1 + min_days(remaining)
