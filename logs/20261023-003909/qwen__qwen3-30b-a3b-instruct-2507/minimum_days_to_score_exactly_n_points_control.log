```python
class Solution:
    def minDays(self, n: int) -> int:
        from functools import lru_cache
        
        @lru_cache(maxsize=None)
        def min_days(rem):
            if rem == 0:
                return 0
            if rem == 1:
                return 1
            
            # Find the maximum k such that k(k+1)/2 <= rem
            max_k = int((2 * rem) ** 0.5)
            while max_k * (max_k + 1) // 2 > rem:
                max_k -= 1
            
            # Try all k from 1 to max_k
            min_days_so_far = float('inf')
            for k in range(1, max_k + 1):
                total = k * (k + 1) // 2
                if total > rem:
                    break
                # If we can achieve exactly rem with this k, good
                if total == rem:
                    min_days_so_far = min(min_days_so_far, k)
                else:
                    # We need more days: k days, 1 skip, and min_days(rem - total) more days
                    days = k + 1 + min_days(rem - total)
                    min_days_so_far = min(min_days_so_far, days)
            
            return min_days_so_far
        
        return min_days(n)
