class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        # Sort meetings by start time
        meetings.sort()
        
        n = len(meetings)
        # dp[i] represents the maximum earnings we can achieve by selecting meetings 
        # ending at or before the end time of meeting i, considering all meetings up to i
        # We'll use a different approach: for each meeting, we consider whether to include it
        
        # We'll use binary search to find the latest non-overlapping meeting
        # Instead of a full DP array, we can use a list to store (end_time, max_earnings)
        # and use binary search to find the rightmost meeting that doesn't overlap
        
        # Sort by end time for binary search
        meetings_by_end = sorted(meetings, key=lambda x: x[1])
        
        # dp[i] = maximum total earnings using meetings up to index i (by end time)
        dp = [0] * n
        
        # Base case: first meeting
        dp[0] = meetings_by_end[0][2]  # revenue of first meeting
        
        # Fill dp array
        for i in range(1, n):
            start, end, revenue = meetings_by_end[i]
            
            # Option 1: Don't take current meeting
            # Option 2: Take current meeting
            # If we take current meeting, we need to find the latest meeting that ends <= start
            
            # Binary search for the largest index j such that meetings_by_end[j][1] <= start
            left, right = 0, i - 1
            last_non_overlap = -1
            
            while left <= right:
                mid = (left + right) // 2
                if meetings_by_end[mid][1] <= start:
                    last_non_overlap = mid
                    left = mid + 1
                else:
                    right = mid - 1
            
            # Calculate total earnings if we take current meeting
            current_earnings = revenue
            if last_non_overlap != -1:
                current_earnings += dp[last_non_overlap]
            
            # Take maximum of including or excluding current meeting
            dp[i] = max(dp[i-1], current_earnings)
        
        return dp[n-1]
