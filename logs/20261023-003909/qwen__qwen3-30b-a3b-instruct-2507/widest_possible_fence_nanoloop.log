```python
class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        from collections import Counter
        
        # Count frequency of each plank height
        freq = Counter(planks)
        max_width = 0
        
        # Consider all possible target heights
        # All existing heights and all possible sums
        possible_heights = set(planks)
        for i in range(len(planks)):
            for j in range(i + 1, len(planks)):
                possible_heights.add(planks[i] + planks[j])
        
        for target in possible_heights:
            # Create a copy of freq to simulate this target
            curr_freq = freq.copy()
            width = 0
            
            # First, use direct planks of the target height
            if target in curr_freq:
                width += curr_freq[target]
                del curr_freq[target]
            
            # Now try to form pairs that sum to target
            # We'll continue until no more pairs can be formed
            changed = True
            while changed and curr_freq:
                changed = False
                # Look for pairs that sum to target
                heights = list(curr_freq.keys())
                for h1 in heights:
                    h2 = target - h1
                    if h1 == h2:
                        # Same height, need at least 2
                        if curr_freq[h1] >= 2:
                            pairs = curr_freq[h1] // 2
                            width += pairs
                            curr_freq[h1] -= pairs * 2
                            if curr_freq[h1] == 0:
                                del curr_freq[h1]
                            changed = True
                            break
                    else:
                        # Different heights
                        if h2 in curr_freq and curr_freq[h2] > 0:
                            pairs = min(curr_freq[h1], curr_freq[h2])
                            width += pairs
                            curr_freq[h1] -= pairs
                            curr_freq[h2] -= pairs
                            if curr_freq[h1] == 0:
                                del curr_freq[h1]
                            if curr_freq[h2] == 0:
                                del curr_freq[h2]
                            changed = True
                            break
            
            max_width = max(max_width, width)
        
        return max_width
