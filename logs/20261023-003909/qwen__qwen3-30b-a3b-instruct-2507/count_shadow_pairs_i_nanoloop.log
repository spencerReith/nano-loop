```python
class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        total = 0
        
        # For each i, find the next element smaller than nums[i]
        for i in range(n):
            # Find the next element smaller than nums[i]
            next_smaller = n  # If no smaller element found, j can go up to n-1
            for j in range(i + 1, n):
                if nums[j] < nums[i]:
                    next_smaller = j
                    break
            
            # Count valid j indices from i+1 to next_smaller-1 where nums[j] > nums[i]
            for j in range(i + 1, next_smaller):
                if nums[j] > nums[i]:
                    total += 1
        
        return total
```