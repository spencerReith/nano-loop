class Solution:
    def maximumGap(self, skill: str, station: str) -> int:
        n = len(skill)
        if n == 1:
            return 0
            
        # For each skill, store all positions in station
        skill_positions = {}
        for i, ch in enumerate(station):
            if ch not in skill_positions:
                skill_positions[ch] = []
            skill_positions[ch].append(i)
        
        # Process first n-1 workers
        prev_station = -1
        max_gap = 0
        
        for i in range(n-1):
            skill_type = skill[i]
            positions = skill_positions[skill_type]
            
            # Binary search for the first position > prev_station
            left, right = 0, len(positions) - 1
            candidate = -1
            while left <= right:
                mid = (left + right) // 2
                if positions[mid] > prev_station:
                    candidate = positions[mid]
                    right = mid - 1
                else:
                    left = mid + 1
            
            # The gap is from prev_station to candidate
            gap = candidate - prev_station
            max_gap = max(max_gap, gap)
            prev_station = candidate
        
        # Assign the last worker to the rightmost position of their skill that is > prev_station
        last_skill = skill[n-1]
        last_positions = skill_positions[last_skill]
        
        # Binary search for the largest position > prev_station
        left, right = 0, len(last_positions) - 1
        candidate = -1
        while left <= right:
            mid = (left + right) // 2
            if last_positions[mid] > prev_station:
                candidate = last_positions[mid]
                left = mid + 1
            else:
                right = mid - 1
        
        # Last gap
        gap = candidate - prev_station
        max_gap = max(max_gap, gap)
        
        return max_gap
