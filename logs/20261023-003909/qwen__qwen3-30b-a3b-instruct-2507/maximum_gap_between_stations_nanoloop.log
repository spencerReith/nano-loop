```python
class Solution:
    def maximumGap(self, skill: str, station: str) -> int:
        n = len(skill)
        if n == 1:
            return 0
            
        # For each skill, store all positions in station
        skill_positions = {}
        for i, ch in enumerate(station):
            if ch not in skill_positions:
                skill_positions[ch] = []
            skill_positions[ch].append(i)
        
        # Assign first n-1 workers to the leftmost positions
        # and the last worker to the rightmost position of their skill
        prev_station = -1
        max_gap = 0
        
        for i in range(n-1):  # workers 0 to n-2
            skill_type = skill[i]
            # Find the first position of skill_type that is > prev_station
            positions = skill_positions[skill_type]
            # Binary search for the first position > prev_station
            left, right = 0, len(positions) - 1
            candidate = -1
            while left <= right:
                mid = (left + right) // 2
                if positions[mid] > prev_station:
                    candidate = positions[mid]
                    right = mid - 1
                else:
                    left = mid + 1
            
            if candidate == -1:
                # This shouldn't happen as assignment is guaranteed
                return -1
                
            # Update prev_station and max_gap for this gap
            max_gap = max(max_gap, candidate - prev_station)
            prev_station = candidate
        
        # Assign last worker to the rightmost position of their skill that is > prev_station
        last_skill = skill[n-1]
        last_positions = skill_positions[last_skill]
        
        # Find the largest position > prev_station
        left, right = 0, len(last_positions) - 1
        candidate = -1
        while left <= right:
            mid = (left + right) // 2
            if last_positions[mid] > prev_station:
                candidate = last_positions[mid]
                left = mid + 1
            else:
                right = mid - 1
        
        # The gap is candidate - prev_station, and this is the last gap
        max_gap = max(max_gap, candidate - prev_station)
        
        return max_gap
```

