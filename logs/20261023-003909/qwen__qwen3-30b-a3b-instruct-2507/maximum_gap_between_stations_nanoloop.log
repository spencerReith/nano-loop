class Solution:
    def maximumGap(self, skill: str, station: str) -> int:
        n = len(skill)
        if n == 1:
            return 0
            
        # For each skill, store all positions in station
        skill_positions = {}
        for i, ch in enumerate(station):
            if ch not in skill_positions:
                skill_positions[ch] = []
            skill_positions[ch].append(i)
        
        # Assign first n-1 workers to the leftmost positions
        prev_station = -1
        max_gap = 0
        
        # Process first n-1 workers
        for i in range(n-1):
            skill_type = skill[i]
            positions = skill_positions[skill_type]
            
            # Binary search for the first position > prev_station
            left, right = 0, len(positions) - 1
            candidate = -1
            while left <= right:
                mid = (left + right) // 2
                if positions[mid] > prev_station:
                    candidate = positions[mid]
                    right = mid - 1
                else:
                    left = mid + 1
            
            # Update previous station and max gap
            prev_station = candidate
            max_gap = max(max_gap, prev_station - prev_station)  # Wait, this is wrong!
        
        # I see the error. The gap is between consecutive assignments.
        # Let me fix this.

        # Assign first n-1 workers
        prev_station = -1
        max_gap = 0
        
        for i in range(n-1):
            skill_type = skill[i]
            positions = skill_positions[skill_type]
            
            # Find first position > prev_station
            left, right = 0, len(positions) - 1
            candidate = -1
            while left <= right:
                mid = (left + right) // 2
                if positions[mid] > prev_station:
                    candidate = positions[mid]
                    right = mid - 1
                else:
                    left = mid + 1
            
            # The gap is from previous station to current station
            gap = candidate - prev_station
            max_gap = max(max_gap, gap)
            prev_station = candidate
        
        # Assign the last worker
        last_skill = skill[n-1]
        last_positions = skill_positions[last_skill]
        
        # Find the largest position > prev_station
        left, right = 0, len(last_positions) - 1
        candidate = -1
        while left <= right:
            mid = (left + right) // 2
            if last_positions[mid] > prev_station:
                candidate = last_positions[mid]
                left = mid + 1
            else:
                right = mid - 1
        
        # Last gap
        gap = candidate - prev_station
        max_gap = max(max_gap, gap)
        
        return max_gap
