```python
import heapq

class Solution:
    def minCost(self, grid: list[list[int]], k: int) -> int:
        m, n = len(grid), len(grid[0])
        
        # Directions: up, right, down, left
        directions = [(-1, 0), (0, 1), (1, 0), (0, -1)]
        
        # Priority queue: (cost, row, col, direction, turns_used)
        pq = [(grid[0][0], 0, 0, -1, 0)]  # -1 means no previous direction (start)
        
        # visited[row][col][direction][turns_used] = min_cost
        # Use dictionary to store minimum cost for each state
        visited = {}
        
        while pq:
            cost, row, col, prev_dir, turns = heapq.heappop(pq)
            
            # Check if we reached the destination
            if row == m - 1 and col == n - 1:
                return cost
            
            # Skip if we've seen this state with better cost
            state = (row, col, prev_dir, turns)
            if state in visited and visited[state] <= cost:
                continue
            visited[state] = cost
            
            # Try all four directions
            for dir_idx, (dr, dc) in enumerate(directions):
                new_row, new_col = row + dr, col + dc
                
                # Check bounds
                if new_row < 0 or new_row >= m or new_col < 0 or new_col >= n:
                    continue
                
                # Calculate new turn count
                new_turns = turns
                if prev_dir != -1 and prev_dir != dir_idx:
                    new_turns = turns + 1
                
                # Skip if we exceed k turns
                if new_turns > k:
                    continue
                
                # Calculate new cost
                new_cost = cost + grid[new_row][new_col]
                
                # Add to priority queue
                heapq.heappush(pq, (new_cost, new_row, new_col, dir_idx, new_turns))
        
        return -1
