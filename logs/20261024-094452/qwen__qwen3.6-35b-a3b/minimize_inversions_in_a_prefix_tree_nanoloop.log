Let me rewrite with optimizations:

```python
class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n = len(words)
        
        # Build position mapping
        pos = [0] * n
        for i in range(n):
            pos[target[i]] = i
        
        # Build prefix tree
        class TreeNode:
            def __init__(self):
                self.children = {}
                self.word_index = -1
                self.subtree_indices = []
        
        root = TreeNode()
        
        for i, word in enumerate(words):
            node = root
            for char in word:
                if char not in node.children:
                    node.children[char] = TreeNode()
                node = node.children[char]
            node.word_index = i
        
        def get_subtree_indices(node):
            indices = []
            if node.word_index != -1:
                indices.append(node.word_index)
            for child in node.children.values():
                indices.extend(get_subtree_indices(child))
            node.subtree_indices = indices
            return indices
        
        get_subtree_indices(root)
        
        def count_inversions_between(list1, list2):
            """Count pairs (a, b) with a in list1, b in list2, pos[a] > pos[b]"""
            count = 0
            for a in list1:
                for b in list2:
                    if pos[a] > pos[b]:
                        count += 1
            return count
        
        def solve(node):
            if not node.children:
                if node.word_index != -1:
                    return 0, [node.word_index]
                else:
                    return 0, []
            
            children_results = []
            for char in node.children:
                child = node.children[char]
                cost, ordered_indices = solve(child)
                children_results.append((cost, ordered_indices))
            
            child_costs = [cr[0] for cr in children_results]
            child_lists = [cr[1] for cr in children_results]
            total_cost = sum(child_costs)
            
            def compare_lists(list1, list2):
                inv12 = count_inversions_between(list1, list2)
                inv21 = count_inversions_between(list2, list1)
                if inv12 < inv21:
                    return -1
                elif inv12 > inv21:
                    return 1
                else:
                    return 0
            
            from functools import cmp_to_key
            sorted_child_lists = sorted(child_lists, key=cmp_to_key(compare_lists))
            
            final_ordered = []
            if node.word_index != -1:
                final_ordered.append(node.word_index)
            
            for cl in sorted_child_lists:
                final_ordered.extend(cl)
            
            # Count inversions between current node and children
            if node.word_index != -1:
                for cl in sorted_child_lists:
                    for idx in cl:
                        if pos[node.word_index] > pos[idx]:
                            total_cost += 1
            
            # Count inversions between different children
            for i in range(len(sorted_child_lists)):
                for j in range(i + 1, len(sorted_child_lists)):
                    total_cost += count_inversions_between(sorted_child_lists[i], sorted_child_lists[j])
            
            return total_cost, final_ordered
        
        return solve(root)[0]
