```python
import bisect
from typing import List

class FenwickTree:
    def __init__(self, size):
        self.n = size
        self.tree = [float('-inf')] * (self.n + 1)
    
    def update(self, index, value):
        while index <= self.n:
            if value > self.tree[index]:
                self.tree[index] = value
            index += index & (-index)
    
    def query(self, index):
        res = float('-inf')
        while index > 0:
            if self.tree[index] > res:
                res = self.tree[index]
            index -= index & (-index)
        return res

class Solution:
    def maxEarnings(self, meetings: List[List[int]]) -> int:
        meetings.sort(key=lambda x: x[0])
        n = len(meetings)
        
        # Get sorted unique end times
        end_times = sorted(set(m[1] for m in meetings))
        end_to_idx = {end: i+1 for i, end in enumerate(end_times)}
        m = len(end_times)
        
        fenw = FenwickTree(m)
        ans = 0
        
        for i in range(n):
            start, end, rev = meetings[i]
            
            # Find the rightmost end_time that is <= start
            idx_in_end_times = bisect.bisect_right(end_times, start) - 1
            
            if idx_in_end_times >= 0:
                query_idx = end_to_idx[end_times[idx_in_end_times]]
                max_prev = fenw.query(query_idx)
            else:
                max_prev = float('-inf')
            
            if max_prev == float('-inf'):
                current_dp = rev
            else:
                current_dp = rev + max_prev + start
            
            if current_dp > ans:
                ans = current_dp
            
            # Update the Fenwick tree at the position corresponding to 'end'
            val = current_dp - end
            pos = end_to_idx[end]
            fenw.update(pos, val)
        
        return ans
