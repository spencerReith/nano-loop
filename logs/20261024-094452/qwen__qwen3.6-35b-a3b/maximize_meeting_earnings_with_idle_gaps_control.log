class FenwickTree:
    def __init__(self, size):
        self.n = size
        self.tree = [float('-inf')] * (self.n + 1)
    
    def update(self, index, value):
        # index is 1-based
        while index <= self.n:
            if value > self.tree[index]:
                self.tree[index] = value
            index += index & (-index)
    
    def query(self, index):
        # query max in [1, index]
        res = float('-inf')
        while index > 0:
            if self.tree[index] > res:
                res = self.tree[index]
            index -= index & (-index)
        return res

class Solution:
    def maxEarnings(self, meetings: List[List[int]]) -> int:
        # Sort meetings by start time
        meetings.sort(key=lambda x: x[0])
        n = len(meetings)
        
        # Collect all end times for coordinate compression
        end_times = sorted(set(m[1] for m in meetings))
        end_to_idx = {end: i+1 for i, end in enumerate(end_times)}  # 1-based index
        m = len(end_times)
        
        # Initialize Fenwick tree
        fenw = FenwickTree(m)
        
        # dp[i] is not explicitly stored; we compute on the fly
        # But we need to update the Fenwick tree with dp[i] - end_i
        
        ans = 0
        for i in range(n):
            start, end, rev = meetings[i]
            
            # Find the largest end_time <= start
            # Use bisect_right to find the insertion point, then go back
            import bisect
            idx_in_end_times = bisect.bisect_right(end_times, start) - 1
            
            if idx_in_end_times >= 0:
                # Get the 1-based index for the Fenwick tree query
                query_idx = end_to_idx[end_times[idx_in_end_times]]
                max_val = fenw.query(query_idx)
            else:
                max_val = float('-inf')
            
            if max_val == float('-inf'):
                dp_i = rev
            else:
                dp_i = rev + max_val + start
            
            # Update the answer
            if dp_i > ans:
                ans = dp_i
            
            # Update Fenwick tree with dp_i - end
            val = dp_i - end
            pos = end_to_idx[end]
            fenw.update(pos, val)
        
        return ans
```

