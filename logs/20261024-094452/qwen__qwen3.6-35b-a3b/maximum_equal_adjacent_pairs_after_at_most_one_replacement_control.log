        # Wait, but pairs where both were z (z != x, z != y) remain unchanged.
        # Pairs where one was x and one was z (z != y) become (y, z) which is not equal.
        # Pairs where one was y and one was z (z != x, z != y) remain (y, z) which is not equal.
        
        # Let me define:
        # original_equal = count of i where nums[i] == nums[i+1]
        
        # When replacing x with y:
        # New equal pairs = original_equal 
        #                  - (pairs that were equal but become unequal)
        #                  + (pairs that were unequal but become equal)
        
        # Pairs that were equal but become unequal:
        # - Pairs where both were x and y are different from x? No, if both were x, they become both y, still equal.
        # - Actually, pairs where both elements are x remain equal (both become y).
        # - Pairs where both elements are some z != x remain equal.
        # - So no equal pairs become unequal due to the replacement? Let's see:
        #   - A pair (a, b) is equal means a == b.
        #   - After replacing x with y:
        #     - If a == x and b == x: both become y, so still equal.
        #     - If a == z and b == z where z != x: no change, still equal.
        #     - If a == x and b == z where z != x: a becomes y, b stays z. Since a==b originally meant x==z, but z!=x, contradiction. So this case doesn't arise for equal pairs.
        #   So indeed, no originally equal pairs become unequal.
        
        # Pairs that were unequal but become equal:
        # - Pair (a, b) where a != b.
        # - After replacement, a' == b' where a' is a with x->y, b' is b with x->y.
        # - Cases:
        #   - a == x, b == y: a' = y, b' = y -> equal. Was unequal since x != y.
        #   - a == y, b == x: a' = y, b' = y -> equal. Was unequal since y != x.
        #   - a == x, b == z (z != x, z != y): a' = y, b' = z -> not equal (y != z).
        #   - a == z, b == x (z != x, z != y): a' = z, b' = y -> not equal.
        #   - a == y, b == z (z != x, z != y): a' = y, b' = z -> not equal.
        #   - a == z, b == y (z != x, z != y): a' = z, b' = y -> not equal.
        #   - Other cases don't involve x, so no change.
        
        # So the gain is the number of adjacent pairs where one element is x and the other is y.
        
        # Therefore, new_count = original_equal + count_adjacent_xy(x, y)
        
        # We want to maximize this over all distinct x, y.
        
        # But wait, we can also choose not to do any operation.
        # So answer = max(original_equal, max over distinct x, y of (original_equal + count_adjacent_xy(x, y)))
        #           = original_equal + max(0, max over distinct x, y of count_adjacent_xy(x, y))
        
        # So we need to find the maximum number of adjacent pairs that are (x, y) or (y, x) for some distinct x, y.
        
        # Let's count the number of adjacent pairs for each unordered pair {x, y} where x != y.
        
        from collections import defaultdict
        
        # Count original equal pairs
        original_equal = 0
        for i in range(n - 1):
            if nums[i] == nums[i + 1]:
                original_equal += 1
        
        if original_equal == 0:
            return 0
        
        # Count adjacent pairs of type (x, y) or (y, x) for x != y
        # We'll use a dictionary with frozenset({x, y}) as key
        pair_counts = defaultdict(int)
        
        for i in range(n - 1):
            a, b = nums[i], nums[i + 1]
            if a != b:
                key = (min(a, b), max(a, b))
                pair_counts[key] += 1
        
        # Find the maximum count for any such pair
        max_gain = 0
        for key in pair_counts:
            if pair_counts[key] > max_gain:
                max_gain = pair_counts[key]
        
        return original_equal + max_gain
