class Solution:
    def findDisappearedNumbers(self, nums: list[int], lower: int, upper: int) -> list[list[int]]:
        """
        Find all missing integers in the range [lower, upper] that do not appear in nums.
        Return them as contiguous ranges in increasing order.
        """
        # Use a set for O(1) lookups
        present = set(nums)
        
        # Collect all missing integers
        missing = []
        for num in range(lower, upper + 1):
            if num not in present:
                missing.append(num)
        
        # If no missing integers, return empty array
        if not missing:
            return []
        
        # Group into contiguous ranges
        result = []
        start = missing[0]
        end = missing[0]
        
        for i in range(1, len(missing)):
            if missing[i] == end + 1:
                # Extend current range
                end = missing[i]
            else:
                # Close current range and start a new one
                result.append([start, end])
                start = missing[i]
                end = missing[i]
        
        # Don't forget the last range
        result.append([start, end])
        
        return result
