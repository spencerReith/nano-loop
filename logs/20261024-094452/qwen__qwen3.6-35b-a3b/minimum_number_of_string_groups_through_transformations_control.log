def least_rotation(S):
    S += S  # Concatenate to handle wrap-around
    n = len(S) // 2
    f = [-1] * n  # Failure function
    k = 0  # Best starting position found so far
    for j in range(1, n):
        sj = S[j]
        i = f[j - k - 1] if j - k - 1 >= 0 else -1
        while i != -1 and sj != S[k + i + 1]:
            if sj < S[k + i + 1]:
                k = j - i - 1
            i = f[i] if i > 0 else -1
        if sj != S[k + i + 1]:
            if sj < S[k]:
                k = j
            f[j - k] = -1
        else:
            f[j - k] = i + 1
    return k
```

