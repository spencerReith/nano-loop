def min_rotation(s):
    n = len(s)
    i, j, k = 0, 1, 0
    while i < n and j < n and k < n:
        delta = s[(i + k) % n] - s[(j + k) % n]
        if delta == 0:
            k += 1
        else:
            if delta > 0:
                i = i + k + 1
            else:
                j = j + k + 1
            if i == j:
                j += 1
            k = 0
    return min(i, j)
```

