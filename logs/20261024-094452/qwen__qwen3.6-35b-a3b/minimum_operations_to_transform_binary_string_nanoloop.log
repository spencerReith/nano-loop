            if s1[i] == '1' and s2[i] == '0' and s1[i+1] == '1' and s2[i+1] == '0':
                p += 1
                i += 2  # Skip the next position
            else:
                i += 1
        
        cost = n01 + p + 2 * (n10 - 2 * p)
        return cost
