class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        
        # For each pair (i,j) with i < j and nums[i] < nums[j],
        # check if there exists k such that i < k < j and nums[i] < nums[k] < nums[j]
        
        for j in range(1, n):
            # For current j, find all valid i's
            for i in range(j - 1, -1, -1):
                if nums[i] < nums[j]:
                    # Check if there's any k between i and j with nums[i] < nums[k] < nums[j]
                    is_shadow = True
                    for k in range(i + 1, j):
                        if nums[i] < nums[k] < nums[j]:
                            is_shadow = False
                            break
                    if is_shadow:
                        count += 1
        
        return count
