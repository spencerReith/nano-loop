class Solution:
    def getLength(self, nums: list[int]) -> int:
        """
        Returns the length of the longest frequency balance subarray.
        
        A frequency balance subarray is defined as:
        - If the subarray contains only one distinct value, it is frequency balanced.
        - Otherwise, there must exist a positive integer f such that every distinct value 
          in the subarray occurs either f or 2*f times, and both frequencies occur among 
          the distinct values.
        """
        n = len(nums)
        if n == 0:
            return 0
        
        max_len = 1  # At minimum, a single element is a valid subarray
        
        # Brute force: check all subarrays
        for i in range(n):
            freq = {}
            for j in range(i, n):
                val = nums[j]
                freq[val] = freq.get(val, 0) + 1
                
                # Check if the current subarray nums[i..j] is frequency balanced
                if self.is_frequency_balanced(freq):
                    max_len = max(max_len, j - i + 1)
        
        return max_len
    
    def is_frequency_balanced(self, freq: dict[int, int]) -> bool:
        """
        Check if the frequency dictionary represents a frequency balance subarray.
        
        Conditions:
        1. If there's only one distinct value, it's balanced.
        2. Otherwise, there exists a positive integer f such that:
           - Every distinct value occurs either f or 2*f times.
           - Both frequencies (f and 2*f) occur among the distinct values.
        """
        if len(freq) == 0:
            return False
        
        frequencies = list(freq.values())
        
        # Case 1: Only one distinct value
        if len(freq) == 1:
            return True
        
        # Get all unique frequencies
        unique_freqs = set(frequencies)
        
        # There must be exactly two distinct frequencies: f and 2*f
        if len(unique_freqs) != 2:
            return False
        
        f1, f2 = min(unique_freqs), max(unique_freqs)
        
        # Check if the larger frequency is exactly twice the smaller one
        if f2 != 2 * f1:
            return False
        
        # Both f and 2*f must be positive (which they are since f1 >= 1)
        if f1 <= 0:
            return False
        
        return True
