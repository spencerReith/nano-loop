```python
class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        from collections import defaultdict
        
        def get_canonical(s):
            if not s:
                return ""
            # Find all cyclic shifts and return the lexicographically smallest
            n = len(s)
            best = s
            for i in range(1, n):
                shifted = s[i:] + s[:i]
                if shifted < best:
                    best = shifted
            return best
        
        groups = set()
        for word in words:
            # Extract even and odd indexed characters
            even_chars = word[0::2]
            odd_chars = word[1::2]
            
            # Get canonical forms
            canonical_even = get_canonical(even_chars)
            canonical_odd = get_canonical(odd_chars)
            
            groups.add((canonical_even, canonical_odd))
        
        return len(groups)
```

