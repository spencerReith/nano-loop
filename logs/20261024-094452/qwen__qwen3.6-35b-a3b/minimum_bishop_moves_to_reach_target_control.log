class Solution:
    def minBishopMoves(self, source: list[int], target: list[int]) -> int:
        sr, sc = source
        tr, tc = target
        
        # Check if source and target are on the same diagonal
        # Two squares are on the same diagonal if:
        # |sr - tr| == |sc - tc|
        
        # Case 1: Source and target are already on the same diagonal
        if abs(sr - tr) == abs(sc - tc):
            return 1
        
        # Case 2: Can we reach in 2 moves?
        # A bishop can reach any square of the same color in at most 2 moves.
        # The color of a square (r, c) can be determined by (r + c) % 2.
        # If source and target have different colors, it's impossible.
        if (sr + sc) % 2 != (tr + tc) % 2:
            return -1
        
        # If they're on the same color but not the same diagonal, 
        # the answer is always 2 moves.
        # This is because from any square, a bishop can reach any other square 
        # of the same color in at most 2 moves (by going to an intermediate square 
        # that lies on both diagonals).
        return 2
