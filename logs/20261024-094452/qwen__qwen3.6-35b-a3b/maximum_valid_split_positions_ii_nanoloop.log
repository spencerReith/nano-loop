import math
from functools import reduce

class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)
        
        # Precompute prefix GCDs
        prefix_gcd = [0] * n
        prefix_gcd[0] = nums[0]
        for i in range(1, n):
            prefix_gcd[i] = math.gcd(prefix_gcd[i-1], nums[i])
        
        # Precompute suffix GCDs
        suffix_gcd = [0] * n
        suffix_gcd[n-1] = nums[n-1]
        for i in range(n-2, -1, -1):
            suffix_gcd[i] = math.gcd(suffix_gcd[i+1], nums[i])
        
        # Function to compute GCD of range [l, r]
        # We'll use a sparse table for O(1) queries
        import math
        
        LOG = n.bit_length()
        sparse = [[0] * n for _ in range(LOG)]
        sparse[0] = nums[:]
        
        for j in range(1, LOG):
            for i in range(n - (1 << j) + 1):
                sparse[j][i] = math.gcd(sparse[j-1][i], sparse[j-1][i + (1 << (j-1))])
        
        def query_gcd(l, r):
            if l > r:
                return 0  # Identity for GCD
            j = (r - l + 1).bit_length() - 1
            return math.gcd(sparse[j][l], sparse[j][r - (1 << j) + 1])
        
        def count_valid_splits(remove_idx):
            # arr has length n-1
            # For split position i in arr (0 <= i < n-2):
            # If i < remove_idx:
            #   left = nums[0..i], right = nums[i+1..remove_idx-1] + nums[remove_idx+1..n-1]
            # If i >= remove_idx:
            #   left = nums[0..remove_idx-1] + nums[remove_idx+1..i+1], right = nums[i+2..n-1]
            
            count = 0
            for i in range(n - 2):
                if i < remove_idx:
                    left_gcd = prefix_gcd[i]
                    # Right part: nums[i+1..remove_idx-1] and nums[remove_idx+1..n-1]
                    g1 = query_gcd(i + 1, remove_idx - 1) if i + 1 <= remove_idx - 1 else 0
                    g2 = query_gcd(remove_idx + 1, n - 1) if remove_idx + 1 <= n - 1 else 0
                    right_gcd = math.gcd(g1, g2) if g1 != 0 or g2 != 0 else 0
                else:
                    # i >= remove_idx, so in arr, split at i means left = arr[0..i]
                    # left = nums[0..remove_idx-1] + nums[remove_idx+1..i+1]
                    g1 = query_gcd(0, remove_idx - 1) if remove_idx - 1 >= 0 else 0
                    g2 = query_gcd(remove_idx + 1, i + 1)
                    left_gcd = math.gcd(g1, g2) if g1 != 0 or g2 != 0 else 0
                    # Right part: arr[i+1..n-2] = nums[i+2..n-1]
                    right_gcd = query_gcd(i + 2, n - 1) if i + 2 <= n - 1 else 0
                
                if left_gcd == right_gcd and left_gcd != 0:
                    count += 1
            return count
        
        # Case 1: No removal
        max_score = 0
        for i in range(n - 1):
            left_gcd = prefix_gcd[i]
            right_gcd = suffix_gcd[i + 1]
            if left_gcd == right_gcd:
                max_score = max(max_score, 1)  # We count all valid, not just max
        
        # Actually, we need to count all valid split positions
        count_no_removal = 0
        for i in range(n - 1):
            left_gcd = prefix_gcd[i]
            right_gcd = suffix_gcd[i + 1]
            if left_gcd == right_gcd:
                count_no_removal += 1
        max_score = count_no_removal
        
        # Case 2: Remove each element
        for k in range(n):
            count = count_valid_splits(k)
            max_score = max(max_score, count)
        
        return max_score
