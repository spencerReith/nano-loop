            """Count valid splits when element at index k is removed."""
            count = 0
            
            # arr has elements: nums[0], ..., nums[k-1], nums[k+1], ..., nums[n-1]
            # arr has length n-1, so split positions are 0 to n-3.
            
            # Case 1: Split position i in arr corresponds to a split before nums[k] in the original array.
