```python
import math
from typing import List

class Solution:
    def maxValidSplits(self, nums: List[int]) -> int:
        n = len(nums)
        
        if n == 2:
            if nums[0] == nums[1]:
                return 1
            else:
                return 0
        
        # Precompute prefix GCDs
        prefix_gcd = [0] * n
        prefix_gcd[0] = nums[0]
        for i in range(1, n):
            prefix_gcd[i] = math.gcd(prefix_gcd[i-1], nums[i])
        
        # Precompute suffix GCDs
        suffix_gcd = [0] * n
        suffix_gcd[n-1] = nums[n-1]
        for i in range(n-2, -1, -1):
            suffix_gcd[i] = math.gcd(suffix_gcd[i+1], nums[i])
        
        # Sparse table for range GCD queries
        LOG = n.bit_length()
        sparse = [nums[:]]
        for j in range(1, LOG):
            prev = sparse[-1]
            new_level = [0] * (n - (1 << j) + 1)
            for i in range(len(new_level)):
                new_level[i] = math.gcd(prev[i], prev[i + (1 << (j-1))])
            sparse.append(new_level)
        
        def query_gcd(l, r):
            if l > r:
                return 0
            j = (r - l + 1).bit_length() - 1
            return math.gcd(sparse[j][l], sparse[j][r - (1 << j) + 1])
        
        # Count valid splits for no removal
        max_score = 0
        for i in range(n - 1):
            if prefix_gcd[i] == suffix_gcd[i + 1]:
                max_score += 1
        
        # For each removal, count valid splits
        for k in range(n):
            current_count = 0
            
            # Case 1: i < k
            G_right = suffix_gcd[k + 1] if k + 1 < n else 0
            
            for i in range(k):
                left_gcd = prefix_gcd[i]
                if i + 1 <= k - 1:
                    q_gcd = query_gcd(i + 1, k - 1)
                    right_gcd = math.gcd(q_gcd, G_right) if q_gcd != 0 or G_right != 0 else 0
                else:
                    right_gcd = G_right if G_right != 0 else 0
                
                if left_gcd == right_gcd and left_gcd != 0:
                    current_count += 1
            
            # Case 2: i >= k
            G_left = query_gcd(0, k - 1) if k - 1 >= 0 else 0
            
            for i in range(k, n - 2):
                q_gcd = query_gcd(k + 1, i + 1)
                if G_left != 0:
                    left_gcd = math.gcd(G_left, q_gcd)
                else:
                    left_gcd = q_gcd
                
                right_gcd = query_gcd(i + 2, n - 1)
                
                if left_gcd == right_gcd and left_gcd != 0:
                    current_count += 1
            
            if current_count > max_score:
                max_score = current_count
        
        return max_score
```

