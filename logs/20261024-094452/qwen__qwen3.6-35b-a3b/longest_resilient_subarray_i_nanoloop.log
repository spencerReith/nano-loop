```python
from math import gcd

class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        max_len = 1
        
        # Group into contiguous blocks of same residue
        i = 0
        while i < n:
            r = nums[i] % k
            j = i
            while j < n and nums[j] % k == r:
                j += 1
            # Block from i to j-1, length L = j - i
            block_len = j - i
            if r == 0:
                max_len = max(max_len, block_len)
            else:
                g = gcd(r, k)
                step = k // g
                # Max L such that L-1 is a multiple of step and L <= block_len
                max_m = (block_len - 1) // step
                valid_len = max_m * step + 1
                max_len = max(max_len, valid_len)
            i = j
        
        return max_len
```

