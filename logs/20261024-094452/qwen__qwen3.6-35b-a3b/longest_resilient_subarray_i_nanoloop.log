class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        max_len = 1  # Single element is always resilient
        
        for i in range(n):
            total = 0
            for j in range(i, n):
                total += nums[j]
                # Check if subarray nums[i:j+1] is resilient
                resilient = True
                for m in range(i, j + 1):
                    if (total - nums[m]) % k != 0:
                        resilient = False
                        break
                if resilient:
                    max_len = max(max_len, j - i + 1)
        
        return max_len
```

