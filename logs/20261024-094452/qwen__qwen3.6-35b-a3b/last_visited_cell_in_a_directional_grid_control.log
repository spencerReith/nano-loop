class Solution:
    def lastVisitedCell(self, grid: list[list[str]]) -> list[int]:
        m = len(grid)
        n = len(grid[0])
        
        # Track visited cells
        visited = [[False] * n for _ in range(m)]
        
        # Start at (0, 0)
        r, c = 0, 0
        visited[r][c] = True
        
        # Direction mappings
        dir_map = {
            'L': (0, -1),
            'R': (0, 1),
            'U': (-1, 0),
            'D': (1, 0)
        }
        
        last_r, last_c = r, c
        
        while True:
            # Get the direction from current cell
            direction = grid[r][c]
            dr, dc = dir_map[direction]
            
            # Calculate next position
            nr, nc = r + dr, c + dc
            
            # Check if move is valid (within bounds and not visited)
            if 0 <= nr < m and 0 <= nc < n and not visited[nr][nc]:
                # Make the move
                r, c = nr, nc
                visited[r][c] = True
                last_r, last_c = r, c
            else:
                # Move is invalid, process ends
                break
        
        return [last_r, last_c]
