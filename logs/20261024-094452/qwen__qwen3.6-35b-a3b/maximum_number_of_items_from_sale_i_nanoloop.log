class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        min_p = min(item[1] for item in items)
        
        # Precompute g(i): number of items j != i such that factor_i divides factor_j
        g = [0] * n
        for i in range(n):
            fi = items[i][0]
            for j in range(n):
                if i != j and items[j][0] % fi == 0:
                    g[i] += 1
        
        # Knapsack: dp[w] = max (sum of (1 + g(i))) for subsets with total weight w
        dp = [-1] * (budget + 1)
        dp[0] = 0
        
        for i in range(n):
            fi, pi = items[i]
            val = 1 + g[i]
            for w in range(budget, pi - 1, -1):
                if dp[w - pi] != -1:
                    dp[w] = max(dp[w], dp[w - pi] + val)
        
        # Find answer
        ans = 0
        for w in range(budget + 1):
            if dp[w] != -1:
                ans = max(ans, dp[w] + (budget - w) // min_p)
        
        return ans
```

