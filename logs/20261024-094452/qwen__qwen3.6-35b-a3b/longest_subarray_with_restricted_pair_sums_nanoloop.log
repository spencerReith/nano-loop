class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        max_len = 0
        
        for l in range(n):
            # Try to extend the window from l
            seen = set()
            for r in range(l, n):
                # Check if nums[r] creates an invalid triplet with elements in [l, r-1]
                # Case 1: nums[i] + nums[j] == nums[r] for some i, j in [l, r-1]
                # Case 2: nums[i] + nums[r] == nums[j] for some i in [l, r-1], j in [l, r-1]
                
                is_valid = True
                
                # Check all pairs in current window [l, r-1]
                for i in range(l, r):
                    for j in range(i + 1, r):
                        if nums[i] + nums[j] == nums[r]:
                            is_valid = False
                            break
                        if nums[i] + nums[r] == nums[j]:
                            is_valid = False
                            break
                        if nums[j] + nums[r] == nums[i]:
                            is_valid = False
                            break
                    if not is_valid:
                        break
                
                if is_valid:
                    max_len = max(max_len, r - l + 1)
                else:
                    break  # Can't extend further from l
        
        return max_len
