class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 2:
            return n
        max_len = 2
        
        for l in range(n - 2):
            # Build window incrementally
            for r in range(l + 2, n):
                # Check if subarray nums[l..r] is valid by checking triplets involving r
                # A triplet (i, j, r) is invalid if nums[i] + nums[j] == nums[r]
                # Or (i, r, j) where nums[i] + nums[r] == nums[j]
                # Since we already validated nums[l..r-1], we only need to check triplets
                # that include r
                
                is_valid = True
                for i in range(l, r):
                    for j in range(i + 1, r):
                        if nums[i] + nums[j] == nums[r]:
                            is_valid = False
                            break
                        if nums[i] + nums[r] == nums[j]:
                            is_valid = False
                            break
                        if nums[j] + nums[r] == nums[i]:
                            is_valid = False
                            break
                    if not is_valid:
                        break
                
                if is_valid:
                    max_len = max(max_len, r - l + 1)
                else:
                    break  # Can't extend further
        
        return max_len
```

