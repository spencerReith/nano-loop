```python
import heapq
from typing import List

class Solution:
    def minTimeMaxPower(self, n: int, edges: List[List[int]], power: int, cost: List[int], source: int, target: int) -> List[int]:
        # Build adjacency list
        graph = [[] for _ in range(n)]
        for u, v, t in edges:
            graph[u].append((v, t))
        
        # dist[u][p] = minimum time to reach node u with exactly p remaining power
        # Initialize with infinity
        INF = float('inf')
        dist = [[INF] * (power + 1) for _ in range(n)]
        dist[source][power] = 0
        
        # Priority queue: (time, remaining_power, node)
        pq = [(0, power, source)]
        
        while pq:
            t, p, u = heapq.heappop(pq)
            
            # If we found a shorter time to this state already, skip
            if t > dist[u][p]:
                continue
            
            # If we are at the target, we don't stop because we need to find the best power for the min time
            # But we can continue to explore other states
            
            # Try to traverse outgoing edges
            for v, time_cost in graph[u]:
                # Check if we have enough power to leave node u
                if p >= cost[u]:
                    new_power = p - cost[u]
                    new_time = t + time_cost
                    if new_time < dist[v][new_power]:
                        dist[v][new_power] = new_time
                        heapq.heappush(pq, (new_time, new_power, v))
        
        # Find the minimum time to reach target
        min_time = INF
        for p in range(power + 1):
            if dist[target][p] < min_time:
                min_time = dist[target][p]
        
        if min_time == INF:
            return [-1, -1]
        
        # Among all paths with minimum time, find the maximum remaining power
        max_power = -1
        for p in range(power + 1):
            if dist[target][p] == min_time:
                if p > max_power:
                    max_power = p
        
        return [min_time, max_power]
