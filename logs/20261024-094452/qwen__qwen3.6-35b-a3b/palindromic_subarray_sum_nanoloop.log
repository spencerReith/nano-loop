### Solution

```python
class Solution:
    def getSum(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 0:
            return 0
        # Precompute prefix sums
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i+1] = prefix[i] + nums[i]
        
        max_sum = max(nums)  # at least the max single element
        
        # Helper function to compute sum of subarray [l, r]
        def subarray_sum(l, r):
            return prefix[r+1] - prefix[l]
        
        # Expand around center for odd-length palindromes
        for center in range(n):
            l, r = center, center
            while l >= 0 and r < n and nums[l] == nums[r]:
                current_sum = subarray_sum(l, r)
                if current_sum > max_sum:
                    max_sum = current_sum
                l -= 1
                r += 1
                
        # Expand around center for even-length palindromes
        for center in range(n-1):
            l, r = center, center+1
            while l >= 0 and r < n and nums[l] == nums[r]:
                current_sum = subarray_sum(l, r)
                if current_sum > max_sum:
                    max_sum = current_sum
                l -= 1
                r += 1
                
        return max_sum
```

