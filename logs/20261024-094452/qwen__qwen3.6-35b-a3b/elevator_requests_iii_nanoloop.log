class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[list[int]]) -> int:
        m = len(requests)
        INF = float('inf')
        full_mask = (1 << m) - 1
        # dp[mask][last] = minimum time to fulfill requests in mask, ending at request last
        dp = [[INF] * m for _ in range(1 << m)]
        
        # Base case: start from 'start' floor, fulfill request i
        for i in range(m):
            arrival_i, floor_i = requests[i]
            time_to_reach = abs(start - floor_i)
            fulfilled_time = max(time_to_reach, arrival_i)
            dp[1 << i][i] = fulfilled_time
        
        # Fill DP
        for mask in range(1, 1 << m):
            for last in range(m):
                if dp[mask][last] == INF:
                    continue
                if not (mask & (1 << last)):
                    continue
                current_time = dp[mask][last]
                current_floor = requests[last][1]
                
                # Try to fulfill a new request 'next'
                for next_req in range(m):
                    if mask & (1 << next_req):
                        continue
                    arrival_next, floor_next = requests[next_req]
                    time_to_move = abs(current_floor - floor_next)
                    new_time = current_time + time_to_move
                    # Must wait until arrival time if we get there early
                    fulfilled_time = max(new_time, arrival_next)
                    new_mask = mask | (1 << next_req)
                    if fulfilled_time < dp[new_mask][next_req]:
                        dp[new_mask][next_req] = fulfilled_time
                        
        # Answer is the minimum time to fulfill all requests, ending at any request
        return min(dp[full_mask])
