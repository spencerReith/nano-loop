```python
from collections import Counter
import random

class Solution:
    def validSubarrays(self, nums: list[int], k: int, queries: list[list[int]]) -> list[bool]:
        n = len(nums)
        # For each index, compute a hash of the parity of counts
        # parity_hash[i] represents the parity signature of nums[0..i-1]
        # Two indices l and r+1 have all even frequencies in nums[l..r]
        # if their parity hashes are equal (for all elements).
        
        # We use a rolling hash with random values for each number
        random.seed(42)
        val_to_hash = {}
        for val in set(nums):
            val_to_hash[val] = random.getrandbits(64)
        
        # Compute prefix parity hashes
        prefix_hash = [0] * (n + 1)
        for i in range(n):
            prefix_hash[i + 1] = prefix_hash[i] ^ val_to_hash[nums[i]]
        
        # Now, for subarray nums[l..r], all frequencies are even iff
        # prefix_hash[l] == prefix_hash[r+1]
        
        ans = []
        for l, r in queries:
            # Check if all frequencies are even
            if prefix_hash[l] != prefix_hash[r + 1]:
                ans.append(False)
                continue
            
            # Check if exactly k distinct elements
            freq = Counter(nums[l:r+1])
            if len(freq) == k:
                ans.append(True)
            else:
                ans.append(False)
        
        return ans
```
