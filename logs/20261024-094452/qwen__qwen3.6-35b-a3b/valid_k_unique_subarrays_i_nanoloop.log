from collections import Counter

class Solution:
    def validSubarrays(self, nums: list[int], k: int, queries: list[list[int]]) -> list[bool]:
        n = len(nums)
        ans = []
        for l, r in queries:
            subarray = nums[l:r+1]
            freq = Counter(subarray)
            # Check if exactly k distinct elements
            if len(freq) != k:
                ans.append(False)
                continue
            # Check if all frequencies are even
            if all(count % 2 == 0 for count in freq.values()):
                ans.append(True)
            else:
                ans.append(False)
        return ans
```

