class Solution:
    def countLocalMaximums(self, matrix: list[list[int]]) -> int:
        n = len(matrix)
        m = len(matrix[0])
        count = 0
        
        for i in range(n):
            for j in range(m):
                x = matrix[i][j]
                # Non-zero cell must be checked
                if x == 0:
                    continue
                
                # Check if this cell is a local maximum
                is_local_max = True
                
                # Consider every cell within x rows and x columns of (i, j)
                # Row range: [i-x, i+x], Col range: [j-x, j+x]
                # Ignore cells outside the matrix
                # Ignore cells where both row distance and column distance are exactly x
                
                for di in range(-x, x + 1):
                    for dj in range(-x, x + 1):
                        ni, nj = i + di, j + dj
                        
                        # Check if within matrix bounds
                        if ni < 0 or ni >= n or nj < 0 or nj >= m:
                            continue
                        
                        # Skip the cell itself? No, the problem says "checks the cells near it"
                        # But let's re-read: "Consider every cell within x rows and x columns of (row, col)"
                        # Then ignore cells where both row distance and column distance are exactly x
                        # The cell itself has row distance 0 and column distance 0, which is not both equal to x (unless x=0, but x is non-zero)
                        
                        # Check if both row distance and column distance are exactly x
                        if abs(di) == x and abs(dj) == x:
                            continue
                        
                        # This is a considered cell
                        if matrix[ni][nj] > x:
                            is_local_max = False
                            break
                    
                    if not is_local_max:
                        break
                
                if is_local_max:
                    count += 1
        
        return count
