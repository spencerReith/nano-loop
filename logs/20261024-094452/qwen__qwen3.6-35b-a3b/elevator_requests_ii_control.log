   Let's code accordingly.

```python
class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        # Filter out the start floor if it's in requests
        filtered_requests = [r for r in requests if r != start]
        K = len(filtered_requests)
        if K == 0:
            return 0
        
        left = [r for r in filtered_requests if r < start]
        right = [r for r in filtered_requests if r > start]
        
        # Sort left in descending order (closest to start first)
        left.sort(reverse=True)
        # Sort right in ascending order (closest to start first)
        right.sort()
        
        m = len(left)
        n = len(right)
        
        # dp[i][j][0] : visited i left and j right, last was left -> current pos = left[i-1]
        # dp[i][j][1] : visited i left and j right, last was right -> current pos = right[j-1]
        # Initialize with a large number
        INF = float('inf')
        dp = [[[INF, INF] for _ in range(n+1)] for _ in range(m+1)]
        
        # Base cases
        if m > 0:
            dp[1][0][0] = abs(start - left[0]) * K
        if n > 0:
            dp[0][1][1] = abs(start - right[0]) * K
            
        # Iterate over the number of requests visited
        # total = i + j, from 1 to K-1 (since we start with 1 request visited in base cases, and go up to K)
        # But we can iterate i from 0 to m, j from 0 to n, and skip (0,0)
        # However, we need to process in increasing order of i+j.
        for total in range(1, K):  # total from 1 to K-1
            for i in range(0, m+1):
                j = total - i
                if j < 0 or j > n:
                    continue
                # Process state (i, j, 0)
                if dp[i][j][0] != INF:
                    # Try going to next left: if i < m
                    if i < m:
                        next_i = i + 1
                        next_j = j
                        # Current pos: left[i-1], next pos: left[i]
                        dist = abs(left[i-1] - left[i])
                        weight = K - total
                        new_cost = dp[i][j][0] + dist * weight
                        if new_cost < dp[next_i][next_j][0]:
                            dp[next_i][next_j][0] = new_cost
                    # Try going to next right: if j < n
                    if j < n:
                        next_i = i
                        next_j = j + 1
                        dist = abs(left[i-1] - right[j])
                        weight = K - total
                        new_cost = dp[i][j][0] + dist * weight
                        if new_cost < dp[next_i][next_j][1]:
                            dp[next_i][next_j][1] = new_cost
                            
                # Process state (i, j, 1)
                if dp[i][j][1] != INF:
                    # Try going to next left: if i < m
                    if i < m:
                        next_i = i + 1
                        next_j = j
                        # Current pos: right[j-1], next pos: left[i]
                        dist = abs(right[j-1] - left[i])
                        weight = K - total
                        new_cost = dp[i][j][1] + dist * weight
                        if new_cost < dp[next_i][next_j][0]:
                            dp[next_i][next_j][0] = new_cost
                    # Try going to next right: if j < n
                    if j < n:
                        next_i = i
                        next_j = j + 1
                        dist = abs(right[j-1] - right[j])
                        weight = K - total
                        new_cost = dp[i][j][1] + dist * weight
                        if new_cost < dp[next_i][next_j][1]:
                            dp[next_i][next_j][1] = new_cost
                            
        return min(dp[m][n][0], dp[m][n][1])
