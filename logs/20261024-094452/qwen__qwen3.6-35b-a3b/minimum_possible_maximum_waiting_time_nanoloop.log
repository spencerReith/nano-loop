```python
class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        n = len(demand)
        
        from functools import lru_cache
        
        @lru_cache(maxsize=None)
        def solve(car_idx, f0, f1, ft0, ft1, last_start):
            if car_idx == n:
                return (0, 0)
            
            allow_time = last_start
            
            # Check which dispensers are valid
            valid_disp = []
            if f0 >= demand[car_idx]:
                valid_disp.append(0)
            if f1 >= demand[car_idx]:
                valid_disp.append(1)
            
            if not valid_disp:
                return (0, float('inf'))
            
            best_cars = 0
            best_max_wait = float('inf')
            
            for d in valid_disp:
                if d == 0:
                    start_time = max(allow_time, ft0)
                    new_ft0 = start_time + demand[car_idx]
                    new_ft1 = ft1
                    new_f0 = f0 - demand[car_idx]
                    new_f1 = f1
                else:
                    start_time = max(allow_time, ft1)
                    new_ft0 = ft0
                    new_ft1 = start_time + demand[car_idx]
                    new_f0 = f0
                    new_f1 = f1 - demand[car_idx]
                
                wait = start_time - allow_time
                
                res = solve(car_idx + 1, new_f0, new_f1, new_ft0, new_ft1, start_time)
                
                if res[0] + 1 > best_cars:
                    best_cars = res[0] + 1
                    best_max_wait = max(wait, res[1])
                elif res[0] + 1 == best_cars:
                    best_max_wait = min(best_max_wait, max(wait, res[1]))
            
            return (best_cars, best_max_wait)
        
        result = solve(0, fuel[0], fuel[1], 0, 0, 0)
        
        if result[0] == 0:
            return -1
        
        return result[1]
```

