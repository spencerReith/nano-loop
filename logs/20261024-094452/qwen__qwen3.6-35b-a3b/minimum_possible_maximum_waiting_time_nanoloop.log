class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        n = len(demand)
        
        from functools import lru_cache
        
        # State: (car_idx, f0, f1, ft0, ft1)
        # ft0, ft1: time when each dispenser becomes free
        # When we start car i on dispenser j at time t:
        #   t = max(allow_time, ft_j)
        #   new_ft_j = t + demand[i]
        #   waiting = t - allow_time
        #   allow_time for car i+1 = t
        
        # But allow_time depends on previous car's start time, which is in the state...
        # Let me include allow_time in the state or track it differently.
        
        # Actually, allow_time for car i is determined by the start time of car i-1.
        # So if we track the start time of the last car, we know the allow time for the next.
        
        # State: (car_idx, f0, f1, ft0, ft1, last_start_time)
        # For car 0, last_start_time is 0 (allow time is 0)
        
        @lru_cache(maxsize=None)
        def solve(car_idx, f0, f1, ft0, ft1, last_start):
            if car_idx == n:
                return (0, 0)
            
            allow_time = last_start
            
            best_cars = 0
            best_max_wait = float('inf')
            
            # Try dispenser 0
            if f0 >= demand[car_idx]:
                start_time = max(allow_time, ft0)
                new_ft0 = start_time + demand[car_idx]
                wait = start_time - allow_time
                
                res = solve(car_idx + 1, f0 - demand[car_idx], f1, new_ft0, ft1, start_time)
                if res[0] + 1 > best_cars or (res[0] + 1 == best_cars and max(wait, res[1]) < best_max_wait):
                    best_cars = res[0] + 1
                    best_max_wait = max(wait, res[1])
            
            # Try dispenser 1
            if f1 >= demand[car_idx]:
                start_time = max(allow_time, ft1)
                new_ft1 = start_time + demand[car_idx]
                wait = start_time - allow_time
                
                res = solve(car_idx + 1, f0, f1 - demand[car_idx], ft0, new_ft1, start_time)
                if res[0] + 1 > best_cars or (res[0] + 1 == best_cars and max(wait, res[1]) < best_max_wait):
                    best_cars = res[0] + 1
                    best_max_wait = max(wait, res[1])
            
            # If we can't serve this car, we serve 0 more
            if not (f0 >= demand[car_idx] or f1 >= demand[car_idx]):
                return (0, float('inf'))
            
            return (best_cars, best_max_wait)
        
        result = solve(0, fuel[0], fuel[1], 0, 0, 0)
        
        if result[0] == 0:
            return -1
        
        return result[1]
