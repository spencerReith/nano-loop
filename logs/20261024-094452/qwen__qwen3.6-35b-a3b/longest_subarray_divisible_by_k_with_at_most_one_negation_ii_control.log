class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        # Prefix sums modulo k
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i+1] = (prefix[i] + nums[i]) % k
        
        # First and last occurrence of each remainder
        first_occurrence = [-1] * k
        last_occurrence = [-1] * k
        
        for idx, val in enumerate(prefix):
            r = val % k
            if first_occurrence[r] == -1:
                first_occurrence[r] = idx
            last_occurrence[r] = idx
            
        ans = 0
        
        # Case 1: No negation needed
        for r in range(k):
            if first_occurrence[r] != -1 and last_occurrence[r] != -1:
                length = last_occurrence[r] - first_occurrence[r]
                if length > ans:
                    ans = length
                    
        # Case 2: One negation
        # For each element nums[m] being negated, we need:
        # prefix[i] % k == (prefix[j+1] - 2 * nums[m]) % k
        # Let s = prefix[j+1] % k, r = prefix[i] % k
        # r = (s - 2 * nums[m]) % k
        # Constraints: i = first_occurrence[r] <= m, j+1 = last_occurrence[s] >= m+1
        
        for m in range(n):
            shift = (2 * nums[m]) % k
            for s in range(k):
                r = (s - shift) % k
                # Check if remainders exist
                if first_occurrence[r] == -1 or last_occurrence[s] == -1:
                    continue
                i_idx = first_occurrence[r]
                j1_idx = last_occurrence[s] # This is j+1
                # The subarray is nums[i_idx ... j1_idx-1]
                # It contains m if i_idx <= m and j1_idx-1 >= m => j1_idx >= m+1
                if i_idx <= m and j1_idx >= m + 1:
                    length = j1_idx - i_idx
                    if length > ans:
                        ans = length
                        
        return ans
```

