### Code Implementation

```python
import bisect
from collections import defaultdict

class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        prefix_even = [0] * (n + 1)
        prefix_odd = [0] * (n + 1)
        
        for i in range(n):
            prefix_even[i+1] = prefix_even[i] + (1 if nums[i] % 2 == 0 else 0)
            prefix_odd[i+1] = prefix_odd[i] + (1 if nums[i] % 2 != 0 else 0)
            
        # diff[k] = prefix_even[k] * b - prefix_odd[k] * a
        diffs = [prefix_even[i] * b - prefix_odd[i] * a for i in range(n + 1)]
        
        # Compress diff values
        sorted_diffs = sorted(set(diffs))
        rank_map = {val: i + 1 for i, val in enumerate(sorted_diffs)}
        M = len(sorted_diffs)
        
        # Fenwick Tree
        bit = [0] * (M + 1)
        
        def update(idx, val):
            while idx <= M:
                bit[idx] += val
                idx += idx & (-idx)
                
        def query(idx):
            s = 0
            while idx > 0:
                s += bit[idx]
                idx -= idx & (-idx)
            return s
            
        # For each prefix_odd level, maintain a sorted list of diff values
        odd_diff_sorted = defaultdict(list)
        
        # Add index 0
        d0 = diffs[0]
        r0 = rank_map[d0]
        update(r0, 1)
        bisect.insort(odd_diff_sorted[prefix_odd[0]], d0)
        
        ans = 0
        for i in range(1, n + 1):
            d = diffs[i]
            o = prefix_odd[i]
            
            # If there are no odd elements in the entire prefix, no valid subarray can end here
            if o == 0:
                # Still need to add to structures for future, but no valid j < i exists with o_j < 0
                # Actually, if o == 0, then prefix_odd[i] == 0. Any j < i has prefix_odd[j] == 0.
            # We want j < i with prefix_odd[j] < o. If o==0, no such j exists.
            # So if o > 0:
            if o > 0:
                r = rank_map[d]
                # Count all j < i with diff[j] >= d
                # BIT query for sum from r to M
                count_all = query(M) - query(r - 1)
                
                # Count j < i with prefix_odd[j] == o and diff[j] >= d
                lst = odd_diff_sorted[o]
                # Find first index in lst where val >= d
                idx = bisect.bisect_left(lst, d)
                count_same_odd = len(lst) - idx
                
                valid_count = count_all - count_same_odd
                ans += valid_count
            
            # Add current index i to structures
            r = rank_map[d]
            update(r, 1)
            bisect.insort(odd_diff_sorted[o], d)
            
        return ans
