```python
import heapq

class Solution:
    def shortestPath(self, n: int, edges: list[list[int]], labels: str, k: int) -> int:
        # Build adjacency list
        adj = [[] for _ in range(n)]
        for u, v, w in edges:
            adj[u].append((v, w))
        
        # State: (distance, node, last_char_code, consecutive_count)
        # We use a priority queue for Dijkstra
        
        # dist[node][last_char_code][consecutive_count] = minimum distance
        # But last_char_code can be 26 possibilities, so we use a dict or array
        
        # Actually, let's use: dist[node][char_index][count]
        # char_index: 0-25 for 'a'-'z'
        # count: 0 to k (but actually, when we arrive at a node, count starts at 1 for that node's label)
        
        # More precisely: when we're at a node, we track:
        # - the character we're on
        # - how many consecutive of that character we've accumulated
        
        # Initialize: start at node 0, with labels[0], count=1
        start_char = ord(labels[0]) - ord('a')
        # dist[node][char_idx][cnt] = min distance
        # Initialize with infinity
        INF = float('inf')
        
        # Using a 3D array: dist[n][26][k+1]
        dist = [[[INF] * (k + 1) for _ in range(26)] for _ in range(n)]
        
        dist[0][start_char][1] = 0
        
        # Priority queue: (weight, node, char_idx, count)
        pq = [(0, 0, start_char, 1)]
        
        while pq:
            d, u, char_idx, cnt = heapq.heappop(pq)
            
            if u == n - 1:
                return d
            
            if d > dist[u][char_idx][cnt]:
                continue
            
            for v, w in adj[u]:
                v_char = ord(labels[v]) - ord('a')
                
                if v_char == char_idx:
                    # Same character as previous
                    new_cnt = cnt + 1
                    if new_cnt <= k:
                        new_dist = d + w
                        if new_dist < dist[v][v_char][new_cnt]:
                            dist[v][v_char][new_cnt] = new_dist
                            heapq.heappush(pq, (new_dist, v, v_char, new_cnt))
                else:
                    # Different character, reset count to 1
                    new_cnt = 1
                    new_dist = d + w
                    if new_dist < dist[v][v_char][new_cnt]:
                        dist[v][v_char][new_cnt] = new_dist
                        heapq.heappush(pq, (new_dist, v, v_char, new_cnt))
        
        return -1
```


