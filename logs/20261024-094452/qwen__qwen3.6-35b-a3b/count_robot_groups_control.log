class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)
        stack = []
        for i in range(n-1, -1, -1):
            # Calculate time to catch the next robot
            if i < n-1 and speed[i] > speed[i+1]:
                t = (position[i+1] - position[i]) / (speed[i] - speed[i+1])
            else:
                t = float('inf')
            
            # If the current robot can catch the next group before it merges with the next next group
            while stack and t <= stack[-1]:
                stack.pop()
            stack.append(t)
        return len(stack)
