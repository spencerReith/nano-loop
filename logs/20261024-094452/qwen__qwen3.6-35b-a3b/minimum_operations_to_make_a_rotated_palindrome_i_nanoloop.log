```python
class Solution:
    def minOperations(self, s: str) -> int:
        n = len(s)
        min_cost = float('inf')
        
        for rotation in range(n):
            # Rotate left by `rotation` positions
            rotated = s[rotation:] + s[:rotation]
            
            # Calculate cost to make it a palindrome
            cost = 0
            for i in range(n // 2):
                a = rotated[i]
                b = rotated[n - 1 - i]
                diff = abs(ord(a) - ord(b))
                cost += min(diff, 26 - diff)
            
            total_cost = rotation + cost
            min_cost = min(min_cost, total_cost)
        
        return min_cost
```
