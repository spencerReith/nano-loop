class Solution:
    def minOperations(self, nums: list[int], k: int) -> int:
        # Separate even and odd indexed elements
        even_elements = [nums[i] for i in range(0, len(nums), 2)]
        odd_elements = [nums[i] for i in range(1, len(nums), 2)]
        
        # Precompute remainders for even and odd elements
        even_rems = [n % k for n in even_elements]
        odd_rems = [n % k for n in odd_elements]
        
        def cost_for_remainder(rems, target_rem):
            """Calculate total cost to make all elements in rems have target_rem modulo k."""
            total = 0
            for r in rems:
                diff = abs(target_rem - r)
                total += min(diff, k - diff)
            return total
        
        min_total = float('inf')
        
        # Try all pairs (x, y) where x != y
        for x in range(k):
            cost_even = cost_for_remainder(even_rems, x)
            for y in range(k):
                if x == y:
                    continue
                cost_odd = cost_for_remainder(odd_rems, y)
                total = cost_even + cost_odd
                min_total = min(min_total, total)
        
        return min_total
