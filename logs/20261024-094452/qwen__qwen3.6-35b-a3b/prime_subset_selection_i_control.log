class Solution:
    def maxPrimes(self, n: int, s: int) -> list[int]:
        if s < 2:
            return []
        
        # Sieve of Eratosthenes
        is_prime = [True] * (n + 1)
        is_prime[0] = is_prime[1] = False
        for i in range(2, int(n**0.5) + 1):
            if is_prime[i]:
                for j in range(i*i, n + 1, i):
                    is_prime[j] = False
        
        primes = [i for i, prime in enumerate(is_prime) if prime]
        if not primes:
            return []
        
        m = len(primes)
        # Prefix sums for primes
        prefix_sum = [0] * (m + 1)
        for i in range(m):
            prefix_sum[i+1] = prefix_sum[i] + primes[i]
            
        # Find max k: largest k such that sum of first k primes <= s
        # prefix_sum[k] is sum of primes[0]...primes[k-1]
        k = 0
        # Binary search for k in [0, m]
        low, high = 0, m
        while low < high:
            mid = (low + high + 1) // 2
            if prefix_sum[mid] <= s:
                low = mid
            else:
                high = mid - 1
        k = low
        
        if k == 0:
            return []
        
        res = []
        last_idx = -1
        remaining_sum = s
        
        # Precompute the range for binary search
        # For each step i (0 to k-1), we pick the i-th element of the result
        num_primes_left = k
        for i in range(k):
            t = k - i  # number of primes to pick including this one
            num_after = t - 1
            
            min_idx = last_idx + 1
            max_idx = m - num_after  # because we need num_after primes after this index
            
            # We want the largest idx in [min_idx, max_idx] such that:
            # primes[idx] + sum(primes[idx+1 : idx+1+num_after]) <= remaining_sum
            # sum(primes[idx+1 : idx+1+num_after]) = prefix_sum[idx+1+num_after] - prefix_sum[idx+1]
            
            # f(idx) = primes[idx] + prefix_sum[idx+1+num_after] - prefix_sum[idx+1]
            # f is non-decreasing with idx. So we binary search for the largest idx with f(idx) <= remaining_sum.
            
            l, r = min_idx, max_idx
            best_idx = -1
            while l <= r:
                mid = (l + r) // 2
                # Calculate f(mid)
                # sum of next num_after primes: from mid+1 to mid+1+num_after-1 = mid+1 to mid+num_after
                end_sum_idx = mid + num_after + 1  # prefix_sum index: exclusive end
                start_sum_idx = mid + 1
                if end_sum_idx > m:
                    # This should not happen because max_idx = m - num_after, so mid <= m - num_after => mid+num_after <= m
                    s_val = 0
                else:
                    s_val = prefix_sum[end_sum_idx] - prefix_sum[start_sum_idx]
                    
                f_val = primes[mid] + s_val
                if f_val <= remaining_sum:
                    best_idx = mid
                    l = mid + 1
                else:
                    r = mid - 1
            
            if best_idx == -1:
                # Should not happen if k was computed correctly
                break
                
            res.append(primes[best_idx])
            remaining_sum -= primes[best_idx]
            last_idx = best_idx
            
        return res
```

