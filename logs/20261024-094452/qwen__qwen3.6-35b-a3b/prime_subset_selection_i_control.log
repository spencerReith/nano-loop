class Solution:
    def maxPrimes(self, n: int, s: int) -> list[int]:
        if s < 2:
            return []
        
        # Sieve of Eratosthenes
        is_prime = [True] * (n + 1)
        is_prime[0] = is_prime[1] = False
        for i in range(2, int(n**0.5) + 1):
            if is_prime[i]:
                for j in range(i*i, n + 1, i):
                    is_prime[j] = False
        
        primes = [i for i, prime in enumerate(is_prime) if prime]
        if not primes:
            return []
        
        m = len(primes)
        # Prefix sums for primes
        prefix_sum = [0] * (m + 1)
        for i in range(m):
            prefix_sum[i+1] = prefix_sum[i] + primes[i]
            
        # Find max k: largest k such that sum of first k primes <= s
        low, high = 0, m
        while low < high:
            mid = (low + high + 1) // 2
            if prefix_sum[mid] <= s:
                low = mid
            else:
                high = mid - 1
        k = low
        
        if k == 0:
            return []
        
        res = []
        last_idx = -1
        remaining_sum = s
        
        for i in range(k):
            t = k - i  # number of primes to pick including this one
            num_after = t - 1
            
            min_idx = last_idx + 1
            # We need num_after primes after mid. Indices: mid+1, ..., mid+num_after.
            # Last index = mid+num_after <= m-1 => mid <= m-1-num_after
            max_idx = m - 1 - num_after
            
            if min_idx > max_idx:
                break
                
            # Binary search for largest idx in [min_idx, max_idx] with f(idx) <= remaining_sum
            l, r = min_idx, max_idx
            best_idx = -1
            while l <= r:
                mid = (l + r) // 2
                # Sum of primes[mid+1 : mid+1+num_after]
                # Indices from mid+1 to mid+num_after (inclusive)
                # Number of elements = num_after
                # Sum = prefix_sum[mid+1+num_after] - prefix_sum[mid+1]
                end_prefix_idx = mid + 1 + num_after  # This is <= m because mid <= m-1-num_after => mid+1+num_after <= m
                s_val = prefix_sum[end_prefix_idx] - prefix_sum[mid+1]
                f_val = primes[mid] + s_val
                if f_val <= remaining_sum:
                    best_idx = mid
                    l = mid + 1
                else:
                    r = mid - 1
            
            if best_idx == -1:
                break
                
            res.append(primes[best_idx])
            remaining_sum -= primes[best_idx]
            last_idx = best_idx
            
        return res
