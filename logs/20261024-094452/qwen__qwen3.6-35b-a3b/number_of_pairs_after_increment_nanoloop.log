class Solution:
    def numberOfPairs(self, nums1: list[int], nums2: list[int], queries: list[list[int]]) -> list[int]:
        from collections import defaultdict
        
        freq = defaultdict(int)
        for num in nums2:
            freq[num] += 1
        
        n = len(nums2)
        answer = []
        
        for q in queries:
            if q[0] == 1:
                # [1, x, y, val]: Add val to nums2[x..y]
                x, y, val = q[1], q[2], q[3]
                for i in range(x, y + 1):
                    old_val = nums2[i]
                    new_val = old_val + val
                    nums2[i] = new_val
                    freq[old_val] -= 1
                    if freq[old_val] == 0:
                        del freq[old_val]
                    freq[new_val] += 1
            else:
                # [2, tot]: Count pairs (j, k) such that nums1[j] + nums2[k] == tot
                tot = q[1]
                count = 0
                for num1 in nums1:
                    target = tot - num1
                    count += freq.get(target, 0)
                answer.append(count)
        
        return answer
