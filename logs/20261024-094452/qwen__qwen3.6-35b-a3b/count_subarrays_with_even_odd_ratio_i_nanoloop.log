```python
class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        count = 0
        
        for i in range(n):
            even = 0
            odd = 0
            for j in range(i, n):
                if nums[j] % 2 == 0:
                    even += 1
                else:
                    odd += 1
                
                # Check if subarray is valid: odd > 0 and even/odd <= a/b
                # Cross-multiply: even * b <= odd * a
                if odd > 0 and even * b <= odd * a:
                    count += 1
        
        return count
```
