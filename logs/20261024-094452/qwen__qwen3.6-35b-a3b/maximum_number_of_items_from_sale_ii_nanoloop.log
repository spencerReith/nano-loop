```python
class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        factors = [item[0] for item in items]
        prices = [item[1] for item in items]
        
        # Group items by factor
        # Count how many items have each factor
        factor_count = [0] * (n + 1)
        for f in factors:
            factor_count[f] += 1
        
        # For each item i, out_degree[i] = count of j != i where factor_i | factor_j
        # For a factor f, out_degree[f] = sum of factor_count[m] for m = f, 2f, 3f, ..., up to n
        #                                minus 1 (to exclude item i itself, but since there are factor_count[f] items with factor f,
        #                                we need to subtract 1 for each item with factor f... wait, no.
        
        # Actually, let's think differently. For all items with factor f:
        #   Each such item has out_degree = (sum of factor_count[m] for m = f, 2f, ..., up to n) - 1
        #   The -1 is because we exclude the item itself.
        
        # Compute sum_factor[f] = sum of factor_count[m] for m = f, 2f, ..., up to n
        sum_factor = [0] * (n + 1)
        for f in range(1, n + 1):
            total = 0
            for m in range(f, n + 1, f):
                total += factor_count[m]
            sum_factor[f] = total
        
        # out_degree for an item with factor f = sum_factor[f] - 1
        out_degree_for_factor = [sum_factor[f] - 1 if sum_factor[f] > 0 else 0 for f in range(n + 1)]
        
        # Now compute out_degree for each item
        out_degree = [0] * n
        for i in range(n):
            out_degree[i] = out_degree_for_factor[factors[i]]
        
        two_item_options = []
        for i in range(n):
            if out_degree[i] > 0:
                two_item_options.append((prices[i], out_degree[i]))
        
        # Sort by price ascending
        two_item_options.sort(key=lambda x: x[0])
        
        total_items = 0
        remaining = budget
        
        # Buy "2-item" copies
        for price, count in two_item_options:
            buy = min(count, remaining // price)
            total_items += buy * 2
            remaining -= buy * price
        
        # Now buy "1-item" copies. The cheapest item overall is the best.
        min_price = min(prices)
        if remaining > 0:
            total_items += remaining // min_price
        
        return total_items
```
