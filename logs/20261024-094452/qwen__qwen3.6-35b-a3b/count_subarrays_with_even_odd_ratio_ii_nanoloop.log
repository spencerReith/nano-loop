```python
class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        
        # Build prefix arrays for even and odd counts
        # E[i] = number of even elements in nums[0..i-1]
        # O[i] = number of odd elements in nums[0..i-1]
        E = [0] * (n + 1)
        O = [0] * (n + 1)
        
        for i in range(n):
            E[i + 1] = E[i] + (1 if nums[i] % 2 == 0 else 0)
            O[i + 1] = O[i] + (1 if nums[i] % 2 == 1 else 0)
        
        # P[k] = E[k] * b - O[k] * a
        P = [E[i] * b - O[i] * a for i in range(n + 1)]
        
        # Count pairs (l, r) with l < r and P[r] <= P[l]
        # For each r, count l < r with P[l] >= P[r]
        
        # Use coordinate compression + BIT
        sorted_P = sorted(set(P))
        rank = {val: i + 1 for i, val in enumerate(sorted_P)}  # 1-indexed
        max_rank = len(sorted_P)
        
        # BIT for counting
        bit = [0] * (max_rank + 1)
        
        def update(i, delta=1):
            while i <= max_rank:
                bit[i] += delta
                i += i & (-i)
        
        def query(i):
            """Sum from 1 to i"""
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & (-i)
            return s
        
        count = 0
        for r in range(n + 1):
            # Count l < r with P[l] >= P[r]
            # That means rank of P[l] >= rank of P[r]
            # Total elements so far - query(rank[P[r]] - 1)
            r_rank = rank[P[r]]
            # Elements with rank >= r_rank: total - query(r_rank - 1)
            if r > 0:  # l must be < r, so at least one l exists
                total_before = r  # number of elements before current position
                count_before_less = query(r_rank - 1)  # elements with rank < r_rank
                count += total_before - count_before_less
            update(r_rank)
        
        return count
```
