```python
class Solution:
    def minPenalty(self, period: int, lights: list[int], arrivalTime: list[int]) -> int:
        # Binary search on the answer (penalty)
        # For a given penalty P, check if it's possible to assign all cars
        # such that each car has waiting time <= P
        
        def can_assign(P):
            """Check if it's possible to assign all cars with max waiting time <= P"""
            for t in arrivalTime:
                r = t % period
                # Car can use light i if: r < lights[i] or r >= period - P
                can_use_any_light = False
                for L in lights:
                    if r < L or r >= period - P:
                        can_use_any_light = True
                        break
                if not can_use_any_light:
                    return False
            return True
        
        # Binary search for minimum P
        lo, hi = 0, period - 1
        while lo < hi:
            mid = (lo + hi) // 2
            if can_assign(mid):
                hi = mid
            else:
                lo = mid + 1
        
        return lo
