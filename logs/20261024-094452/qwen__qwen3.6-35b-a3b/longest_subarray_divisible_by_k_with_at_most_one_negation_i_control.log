class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        max_len = 0
        
        # We need to find the longest subarray such that:
        # 1. Its sum is divisible by k, OR
        # 2. Negating one element makes its sum divisible by k
        
        # For a subarray from index i to j:
        # sum = prefix[j+1] - prefix[i]
        # If we negate element at index m (i <= m <= j), the new sum becomes:
        # sum - 2 * nums[m]
        
        # So we need:
        # (prefix[j+1] - prefix[i]) % k == 0  OR
        # (prefix[j+1] - prefix[i] - 2 * nums[m]) % k == 0 for some m in [i, j]
        
        # Let's compute prefix sums
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + nums[i]
        
        # For each possible subarray (i, j), check conditions
        # With n <= 1000, O(n^2) is acceptable
        
        for i in range(n):
            for j in range(i, n):
                subarray_sum = prefix[j + 1] - prefix[i]
                length = j - i + 1
                
                # Check if sum is already divisible by k
                if subarray_sum % k == 0:
                    max_len = max(max_len, length)
                    continue
                
                # Check if negating one element makes it divisible
                # We need (subarray_sum - 2 * nums[m]) % k == 0 for some m in [i, j]
                # i.e., 2 * nums[m] % k == subarray_sum % k
                
                remainder = subarray_sum % k
                found = False
                for m in range(i, j + 1):
                    if (2 * nums[m]) % k == remainder:
                        found = True
                        break
                
                if found:
                    max_len = max(max_len, length)
        
        return max_len
