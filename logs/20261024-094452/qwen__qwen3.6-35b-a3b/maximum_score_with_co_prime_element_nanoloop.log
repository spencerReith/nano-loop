```python
from math import gcd
from collections import Counter

class Solution:
    def maxScore(self, nums: list[int], maxVal: int) -> int:
        n = len(nums)
        max_num = max(max(nums), maxVal)
        
        # Count frequency of each number
        freq = Counter(nums)
        
        # Compute count_multiples[d] for d from 1 to max_num
        # count_multiples[d] = number of elements in nums divisible by d
        count_multiples = [0] * (max_num + 1)
        for d in range(1, max_num + 1):
            for multiple in range(d, max_num + 1, d):
                count_multiples[d] += freq.get(multiple, 0)
        
        # Precompute Möbius function up to max_num
        mu = [0] * (max_num + 1)
        is_prime = [True] * (max_num + 1)
        primes = []
        mu[1] = 1
        for i in range(2, max_num + 1):
            if is_prime[i]:
                primes.append(i)
                mu[i] = -1
            for p in primes:
                if i * p > max_num:
                    break
                is_prime[i * p] = False
                if i % p == 0:
                    mu[i * p] = 0
                    break
                else:
                    mu[i * p] = -mu[i]
        
        # Precompute divisors for each number
        divisors = [[] for _ in range(max_num + 1)]
        for d in range(1, max_num + 1):
            for multiple in range(d, max_num + 1, d):
                divisors[multiple].append(d)
        
        # For each v, compute total_non_coprime[v]
        # total_non_coprime[v] = n - coprime_count[v]
        # coprime_count[v] = sum_{d|v} mu[d] * count_multiples[d]
        total_non_coprime = [0] * (max_num + 1)
        for v in range(1, max_num + 1):
            coprime_count = sum(mu[d] * count_multiples[d] for d in divisors[v])
            total_non_coprime[v] = n - coprime_count
        
        best_score = -float('inf')
        
        # Case 1: selected value = v, where v is in nums (no change to nums[i])
        for v in freq:
            if v > max_num:
                continue  # shouldn't happen
            score = v - total_non_coprime[v] + (1 if v > 1 else 0)
            best_score = max(best_score, score)
        
        # Case 2: selected value = v, where v <= maxVal (change nums[i] to v)
        for v in range(1, maxVal + 1):
            if total_non_coprime[v] > 0:
                score = v - total_non_coprime[v]
            else:
                score = v - 1
            best_score = max(best_score, score)
        
        return best_score
```
