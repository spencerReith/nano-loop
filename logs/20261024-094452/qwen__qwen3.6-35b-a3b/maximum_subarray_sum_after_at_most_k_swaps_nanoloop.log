```python
class Solution:
    def maxSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        result = float('-inf')
        
        # Iterate over all possible subarray lengths
        for size in range(1, n + 1):
            # Iterate over all starting positions for subarrays of this size
            for i in range(n - size + 1):
                window = nums[i:i+size]
                outside = nums[:i] + nums[i+size:]
                
                # We can perform up to k swaps.
                # A swap is beneficial if an element in 'outside' is greater than an element in 'window'.
                # We want to replace the smallest elements in 'window' with the largest in 'outside'.
                
                # Sort window ascending to easily pick smallest
                window_sorted = sorted(window)
                # Sort outside descending to easily pick largest
                outside_sorted = sorted(outside, reverse=True)
                
                current_window_sum = sum(window_sorted)
                current_k_swaps = k
                
                # Perform beneficial swaps
                for s in range(current_k_swaps):
                    # If we have exhausted outside elements or swaps, break
                    if s >= len(outside_sorted):
                        break
                    if s >= len(window_sorted):
                        break
                        
                    largest_outside = outside_sorted[s]
                    smallest_inside = window_sorted[s]
                    
                    if largest_outside > smallest_inside:
                        # Swap: remove smallest_inside, add largest_outside
                        current_window_sum = current_window_sum - smallest_inside + largest_outside
                    else:
                        # No more beneficial swaps possible
                        break
                
                result = max(result, current_window_sum)
        
        return result
```

