class Solution:
    def maxSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        result = float('-inf')
        
        # Optimization: Precompute total sum of positive numbers? No.
        
        for size in range(1, n + 1):
            # Determine how many swaps we can actually use
            max_swaps = min(k, size)
            
            # Precompute the global sorted list for reference? No, needed per window for outside.
            
            for i in range(n - size + 1):
                # Extract window and outside
                # Slicing is O(L) and O(N-L)
                window = nums[i:i+size]
                outside = nums[:i] + nums[i+size:]
                
                # We need sum of smallest 'max_swaps' in window
                # And sum of largest 'max_swaps' in outside
                
                # Find smallest max_swaps in window
                # If max_swaps is large, use nlargest to find sum of kept?
                # Keep = Sum(Window) - Sum(Smallest k)
                # Replace = Sum(Largest k in Outside)
                
                # Fast way to get sum of smallest k:
                # Use nsmallest from heapq
                import heapq
                smallest_in_window = heapq.nsmallest(max_swaps, window)
                kept_sum = sum(window) - sum(smallest_in_window)
                
                largest_outside = heapq.nlargest(max_swaps, outside)
                replace_sum = sum(largest_outside)
                
                current_total = kept_sum + replace_sum
                result = max(result, current_total)
                
        return result
```
