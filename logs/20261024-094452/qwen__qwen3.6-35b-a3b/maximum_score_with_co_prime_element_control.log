```python
import math
from typing import list

class Solution:
    def maxScore(self, nums: list[int], maxVal: int) -> int:
        n = len(nums)
        # Frequency array for numbers 1 to maxVal
        freq = [0] * (maxVal + 1)
        for x in nums:
            if x <= maxVal:
                freq[x] += 1
        
        # Precompute cnt[d]: number of elements in nums divisible by d
        cnt = [0] * (maxVal + 1)
        for d in range(1, maxVal + 1):
            for j in range(d, maxVal + 1, d):
                cnt[d] += freq[j]
        
        # Precompute spf (smallest prime factor) for numbers up to maxVal
        spf = list(range(maxVal + 1))  # spf[x] = smallest prime factor of x
        for i in range(2, int(maxVal**0.5) + 1):
            if spf[i] == i:  # i is prime
                for j in range(i*i, maxVal + 1, i):
                    if spf[j] == j:
                        spf[j] = i
        
        # Function to get distinct prime factors of a number
        def get_prime_factors(x):
            factors = set()
            while x > 1:
                p = spf[x]
                factors.add(p)
                while x % p == 0:
                    x //= p
            return factors
        
        # Inclusion-exclusion for non_coprime_count[v]
        # non_coprime_count[v] = count of x in nums such that gcd(v, x) != 1
        # = inclusion-exclusion over prime factors of v
        
        # Precompute the maximum score
        max_score = -10**18
        
        # We'll iterate v from 1 to maxVal
        for v in range(1, maxVal + 1):
            # Get distinct prime factors of v
            primes = get_prime_factors(v)
            
            # Inclusion-exclusion to compute non_coprime_count[v]
            k = len(primes)
            non_coprime = 0
            # Iterate over all non-empty subsets of primes
            # There are 2^k - 1 subsets
            for i in range(1, 1 << k):
                product = 1
                sign = 1
                bits = 0
                for j in range(k):
                    if i & (1 << j):
                        product *= primes[j]
                        bits += 1
                if bits % 2 == 1:
                    sign = 1
                else:
                    sign = -1
                non_coprime += sign * cnt[product]
            
            # Now compute best_adjustment[v]
            has_v = (freq[v] > 0)
            has_non_v = (n - freq[v] > 0)
            
            # Count of elements in nums that are not co-prime with v, excluding the occurrences of v itself (if v>1)
            # For v==1: gcd(1,1)=1, so the freq[1] elements are co-prime, so they are not in non_coprime.
            # For v>1: gcd(v,v)=v>1, so the freq[v] elements are not co-prime, so they are included in non_coprime.
            count_non_v_non_coprime = non_coprime - (freq[v] if v > 1 else 0)
            
            has_non_v_and_non_coprime = (count_non_v_non_coprime > 0)
            
            # Case 1: choose an index i with nums[i] == v
            case1_adjustment = float('inf')
            if has_v:
                if v == 1:
                    case1_adjustment = 0
                else:
                    case1_adjustment = -1
                    
            # Case 2: choose an index i with nums[i] != v
            case2_adjustment = float('inf')
            if has_non_v:
                if has_non_v_and_non_coprime:
                    case2_adjustment = 0
                else:
                    case2_adjustment = 1
                    
            best_adj = min(case1_adjustment, case2_adjustment)
            
            if best_adj == float('inf'):
                # No valid index? This should not happen because n>=1, so at least one case is available.
                continue
                
            total_cost = non_coprime + best_adj
            score = v - total_cost
            if score > max_score:
                max_score = score
                
        return max_score
