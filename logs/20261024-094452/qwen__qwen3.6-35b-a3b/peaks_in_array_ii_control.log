import bisect

class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums)
        # is_peak_arr[i] is True if index i is a peak (only for i in 1..n-2)
        is_peak_arr = [False] * n
        peaks = []  # sorted list of peak indices
        
        # Precompute initial peaks
        for i in range(1, n-1):
            if nums[i] > nums[i-1] and nums[i] > nums[i+1]:
                is_peak_arr[i] = True
                peaks.append(i)
        peaks.sort()
        
        def count_non_peak_subarrays(gap_len: int) -> int:
            if gap_len < 3:
                return 0
            return (gap_len - 1) * (gap_len - 2) // 2
        
        ans = []
        
        for q in queries:
            if q[0] == 1:
                _, l, r = q
                length = r - l + 1
                if length < 3:
                    ans.append(0)
                    continue
                total_subarrays = (length - 1) * (length - 2) // 2
                
                # Find peaks in [l+1, r-1]
                if l+1 > r-1:
                    ans.append(0)
                    continue
                    
                left_idx = bisect.bisect_left(peaks, l+1)
                right_idx = bisect.bisect_right(peaks, r-1) - 1
                
                if left_idx > right_idx or left_idx >= len(peaks):
                    # no peaks in the range
                    ans.append(0)
                    continue
                    
                # Get the list of peaks in the range
                # We don't need to create a new list, just iterate
                non_peak_subs = 0
                # gap before first peak
                first_peak = peaks[left_idx]
                gap0 = first_peak - l
                non_peak_subs += count_non_peak_subarrays(gap0)
                
                # gaps between consecutive peaks
                for i in range(left_idx, right_idx):
                    p1 = peaks[i]
                    p2 = peaks[i+1]
                    gap_len = p2 - p1 - 1
                    non_peak_subs += count_non_peak_subarrays(gap_len)
                    
                # gap after last peak
                last_peak = peaks[right_idx]
                gap_last = r - last_peak
                non_peak_subs += count_non_peak_subarrays(gap_last)
                
                ans.append(total_subarrays - non_peak_subs)
                
            else:
                _, index, val = q
                nums[index] = val
                # Check indices: index-1, index, index+1 if they are in [1, n-2]
                for idx in (index-1, index, index+1):
                    if 1 <= idx <= n-2:
                        new_peak = (nums[idx] > nums[idx-1] and nums[idx] > nums[idx+1])
                        if new_peak != is_peak_arr[idx]:
                            is_peak_arr[idx] = new_peak
                            if new_peak:
                                bisect.insort(peaks, idx)
                            else:
                                i = bisect.bisect_left(peaks, idx)
                                if i < len(peaks) and peaks[i] == idx:
                                    peaks.pop(i)
                                    
        return ans
