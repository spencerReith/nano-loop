class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        count = 0
        
        # Precompute prefix counts of even and odd numbers
        # prefix_even[i] = number of even elements in nums[0..i-1]
        # prefix_odd[i] = number of odd elements in nums[0..i-1]
        
        prefix_even = [0] * (n + 1)
        prefix_odd = [0] * (n + 1)
        
        for i in range(n):
            prefix_even[i + 1] = prefix_even[i] + (1 if nums[i] % 2 == 0 else 0)
            prefix_odd[i + 1] = prefix_odd[i] + (1 if nums[i] % 2 != 0 else 0)
        
        # For each subarray [j, i], even count = prefix_even[i+1] - prefix_even[j],
        # odd count = prefix_odd[i+1] - prefix_odd[j]
        # Condition: y > 0 and x/y <= a/b, i.e., x * b <= y * a
        
        for i in range(n):
            for j in range(i + 1):
                x = prefix_even[i + 1] - prefix_even[j]
                y = prefix_odd[i + 1] - prefix_odd[j]
                if y > 0 and x * b <= y * a:
                    count += 1
        
        return count
