class Solution:
    def maxScore(self, grid: list[list[int]]) -> int:
        m, n = len(grid), len(grid[0])
        
        from collections import deque
        
        def get_all_paths(start, end, m, n, moves):
            paths = []
            queue = deque([(start, [start])])
            while queue:
                (r, c), path = queue.popleft()
                if (r, c) == end:
                    paths.append(path)
                    continue
                for dr, dc in moves:
                    nr, nc = r + dr, c + dc
                    if 0 <= nr < m and 0 <= nc < n:
                        queue.append(((nr, nc), path + [(nr, nc)]))
            return paths
        
        # For small inputs, brute force
        if m * n <= 100:
            p1_moves = [(1, 0), (0, 1)]
            p2_moves = [(-1, 0), (0, 1)]
            
            p1_paths = get_all_paths((0, 0), (m-1, n-1), m, n, p1_moves)
            p2_paths = get_all_paths((m-1, 0), (0, n-1), m, n, p2_moves)
            
            max_score = float('-inf')
            for p1 in p1_paths:
                p1_set = set(p1)
                for p2 in p2_paths:
                    shared = p1_set.intersection(set(p2))
                    score = sum(grid[r][c] for r, c in shared)
                    if score > max_score:
                        max_score = score
            
            return max_score
        
        # For larger inputs, use step-based DP
        # Process by step k (0 to m+n-2)
        # At step k, P1 is at (r1, k-r1), P2 is at (r2, k-m+1+r2)
        # Count cells when both are at the same cell
        
        total_steps = m + n - 2
        NEG_INF = float('-inf')
        
        dp = [[NEG_INF] * m for _ in range(m)]
        
        # Step 0: P1 at (0,0), P2 at (m-1, 0)
        if m == 1 and n == 1:
            dp[0][0] = grid[0][0]
        elif m == 1:
            # P1 at (0,0), P2 at (0,0) if m=1
            dp[0][0] = grid[0][0]
        else:
            dp[0][m-1] = 0  # Different cells
        
        for k in range(1, total_steps + 1):
            new_dp = [[NEG_INF] * m for _ in range(m)]
            
            r1_min = max(0, k - (n - 1))
            r1_max = min(k, m - 1)
            
            r2_min = max(0, m - 1 - k)
            r2_max = min(m - 1, m - 1 - k + n - 1)
            
            for r1 in range(r1_min, r1_max + 1):
                c1 = k - r1
                if c1 < 0 or c1 >= n:
                    continue
                for r2 in range(r2_min, r2_max + 1):
                    c2 = k - m + 1 + r2
                    if c2 < 0 or c2 >= n:
                        continue
                    
                    prev_score = NEG_INF
                    
                    p1_prev = []
                    if r1 > 0:
                        p1_prev.append((r1 - 1, c1))
                    if c1 > 0:
                        p1_prev.append((r1, c1 - 1))
                    
                    p2_prev = []
                    if r2 < m - 1:
                        p2_prev.append((r2 + 1, c2))
                    if c2 > 0:
                        p2_prev.append((r2, c2 - 1))
                    
                    for pr1, pc1 in p1_prev:
                        if pr1 + pc1 != k - 1:
                            continue
                        for pr2, pc2 in p2_prev:
                            if pc2 != k - m + pr2:
                                continue
                            if dp[pr1][pr2] != NEG_INF:
                                if dp[pr1][pr2] > prev_score:
                                    prev_score = dp[pr1][pr2]
                    
                    if prev_score != NEG_INF:
                        if r1 == r2 and c1 == c2:
                            current_score = prev_score + grid[r1][c1]
                        else:
                            current_score = prev_score
                        if current_score > new_dp[r1][r2]:
                            new_dp[r1][r2] = current_score
            
            dp = new_dp
        
        result = max(max(row) for row in dp)
        return result
