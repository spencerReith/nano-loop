import math
from typing import List

class Solution:
    def maxValidSplits(self, nums: List[int]) -> int:
        n = len(nums)
        if n == 2:
            # Can remove one element, left with 1 element, no split positions.
            # Or no removal: split at 0, left=[2], right=[4] -> gcd(2)=2, gcd(4)=4 -> not equal.
            return 0
        
        # Sparse table for range GCD queries
        # LOG = ceil(log2(n)) + 1
        LOG = (n).bit_length()
        st = [[0] * n for _ in range(LOG)]
        st[0] = nums[:]
        
        for j in range(1, LOG):
            for i in range(n - (1 << j) + 1):
                st[j][i] = math.gcd(st[j-1][i], st[j-1][i + (1 << (j-1))])
        
        def query_gcd(l, r):
            if l > r:
                return 0
            j = (r - l + 1).bit_length() - 1
            return math.gcd(st[j][l], st[j][r - (1 << j) + 1])
        
        # Precompute prefix_gcd and suffix_gcd for original array
        prefix_gcd = [0] * n
        suffix_gcd = [0] * n
        
        prefix_gcd[0] = nums[0]
        for i in range(1, n):
            prefix_gcd[i] = math.gcd(prefix_gcd[i-1], nums[i])
            
        suffix_gcd[n-1] = nums[n-1]
        for i in range(n-2, -1, -1):
            suffix_gcd[i] = math.gcd(suffix_gcd[i+1], nums[i])
            
        best_score = 0
        
        # Case 1: No removal
        # arr = nums, m = n
        # split i from 0 to n-2
        # left: gcd(0..i), right: gcd(i+1..n-1)
        current_score = 0
        for i in range(n - 1):
            g_left = prefix_gcd[i]
            g_right = suffix_gcd[i+1]
            if g_left == g_right:
                current_score += 1
        best_score = max(best_score, current_score)
        
        # Case 2: Remove element at index k
        # New array length m = n - 1
        # Split positions i from 0 to m - 2 = n - 3
        
        # For each k, iterate i from 0 to n-3
        # We need to compute left_gcd and right_gcd for each split i
        
        for k in range(n):
            # New array: nums[0..k-1] + nums[k+1..n-1]
            # Split i in new array:
            # If i < k:
            #   left = new[0..i] = nums[0..i]
            #   right = new[i+1..end] = nums[i+1..k-1] + nums[k+1..n-1]
            # If i >= k:
            #   left = new[0..i] = nums[0..k-1] + nums[k+1..i+1]
            #   right = new[i+1..end] = nums[i+2..n-1]
            
            score = 0
            # i ranges from 0 to n-3
            for i in range(n - 2):  # because new array has length n-1, splits from 0 to n-3
                if i < k:
                    # Left GCD
                    g_left = prefix_gcd[i]
                    # Right GCD: GCD of nums[i+1..k-1] and nums[k+1..n-1]
                    # Range 1: i+1 to k-1
                    # Range 2: k+1 to n-1
                    if i + 1 <= k - 1 and k + 1 < n:
                        g_mid = query_gcd(i+1, k-1)
                        g_right = math.gcd(g_mid, suffix_gcd[k+1])
                    elif i + 1 <= k - 1:
                        # k+1 >= n, so second range is empty
                        g_right = query_gcd(i+1, k-1)
                    elif k + 1 < n:
                        # First range is empty (i+1 > k-1 => i >= k-1, but i < k, so i=k-1)
                        g_right = suffix_gcd[k+1]
                    else:
                        # Both empty? should not happen as right part must exist
                        g_right = 0
                else:
                    # i >= k
                    # Right GCD: nums[i+2..n-1]
                    if i + 2 < n:
                        g_right = suffix_gcd[i+2]
                    else:
                        # Right part empty? but i <= n-3, so i+2 <= n-1. If i+2==n, then right part empty, but i<=n-3 => i+2<=n-1.
                        # If i+2 > n-1, then right part is empty, which shouldn't happen for a valid split.
                        # Actually, if i = n-3, right part is new[n-2..n-2] which is one element.
                        # In original, new index j corresponds to:
                        # j < k -> original j
                        # j >= k -> original j+1
                        # So right part starts at new index i+1, which corresponds to original index:
                        # if i+1 < k: original i+1
                        # if i+1 >= k: original i+2
                        # Here i >= k, so i+1 >= k+1 > k, so original index i+2.
                        # Right part is new[i+1 .. end], which is original[i+2 .. n-1] (since new end is original n-1, and new index j>=k maps to original j+1, so new end index n-2 maps to original n-1).
                        # So right part is original[i+2 .. n-1].
                        if i + 2 <= n - 1:
                            g_right = suffix_gcd[i+2]
                        else:
                            g_right = 0
                    
                    # Left GCD: nums[0..k-1] and nums[k+1..i+1]
                    # Range 1: 0 to k-1
                    # Range 2: k+1 to i+1
                    if k - 1 >= 0 and k + 1 <= i + 1:
                        g_prefix = prefix_gcd[k-1]
                        g_mid = query_gcd(k+1, i+1)
                        g_left = math.gcd(g_prefix, g_mid)
                    elif k - 1 >= 0:
                        # Second range empty: k+1 > i+1 => k > i, but i>=k, contradiction. So this case doesn't happen when i>=k and k>0.
                        g_left = prefix_gcd[k-1]
                    elif k + 1 <= i + 1:
                        # First range empty: k-1 < 0 => k=0.
                        g_left = query_gcd(k+1, i+1)
                    else:
                        # Both empty? only if n=1, but n>=2 and after removal n-1>=1, but if n=2, removal, new length 1, no splits.
                        g_left = 0
                        
                if g_left == g_right and g_left != 0:
                    score += 1
            best_score = max(best_score, score)
            
        return best_score
