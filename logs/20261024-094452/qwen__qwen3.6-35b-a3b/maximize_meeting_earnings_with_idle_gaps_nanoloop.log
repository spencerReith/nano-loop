            all_ends = sorted(set(m[1] for m in meetings))
            end_to_idx = {end: i for i, end in enumerate(all_ends)}
            num_ends = len(all_ends)
            
            # Fenwick tree for range max query
            # Tree size: num_ends + 1
            tree = [-10**18] * (num_ends + 1)
            
            def update(idx, value):
                # idx is 0-based index in compressed coordinates
                # Convert to 1-based
                i = idx + 1
                while i <= num_ends:
                    if value > tree[i]:
                        tree[i] = value
                    i += i & (-i)
                    
