import math

class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        
        if n == 0:
            return 0
        
        # For a subarray to be resilient:
        # All elements must have the same remainder r mod k,
        # and length * r ≡ r (mod k), i.e. r * (length - 1) ≡ 0 (mod k)
        # Length 1 is always resilient (0 is divisible by k)
        
        result = 1  # At least length 1 is always resilient
        
        # Single pass: find contiguous runs of same remainder mod k
        i = 0
        while i < n:
            r = nums[i] % k
            start = i
            while i < n and nums[i] % k == r:
                i += 1
            run_length = i - start
            
            if r == 0:
                # If remainder is 0, every subarray within this run is valid
                # because all elements are divisible by k
                result = max(result, run_length)
            else:
                # We need r * (len - 1) ≡ 0 (mod k)
                # So (len - 1) must be a multiple of k / gcd(r, k)
                g = math.gcd(r, k)
                step = k // g
                # Longest len where (len-1) % step == 0
                # i.e., len - 1 = 0, step, 2*step, ...
                # len = 1, step+1, 2*step+1, ...
                # Max such len <= run_length
                if run_length >= 1:
                    max_full_steps = (run_length - 1) // step
                    candidate = max_full_steps * step + 1
                    result = max(result, candidate)
        
        return result
