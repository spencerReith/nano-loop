class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        # prefix_sum[i] = sum of nums[0..i-1]
        prefix_sum = [0] * (n + 1)
        for i in range(n):
            prefix_sum[i + 1] = prefix_sum[i] + nums[i]
        
        result = 0
        
        # For case 1 (no negation needed):
        # Find longest subarray where sum % k == 0
        remainder_first = {}  # remainder -> first index where this prefix sum mod k occurs
        current_mod = 0
        remainder_first[0] = 0  # prefix_sum[0] = 0, mod k = 0 at index 0
        
        for j in range(1, n + 1):
            current_mod = prefix_sum[j] % k
            if current_mod in remainder_first:
                result = max(result, j - remainder_first[current_mod])
            else:
                remainder_first[current_mod] = j
        
        # For case 2 (negate one element):
        # For a subarray [i, j) containing element at index m (where i <= m < j),
        # if we negate nums[m], the new sum = (prefix_sum[j] - prefix_sum[i]) - 2*nums[m]
        # This should be divisible by k.
        # So: (prefix_sum[j] - prefix_sum[i] - 2*nums[m]) % k == 0
        # Which means: (prefix_sum[j] - prefix_sum[i]) % k == (2*nums[m]) % k
        
        # Precompute for each remainder, sorted lists of indices
        from collections import defaultdict
        import bisect
        
        remainder_indices = defaultdict(list)
        for idx in range(n + 1):
            r = prefix_sum[idx] % k
            remainder_indices[r].append(idx)
        
        for m in range(n):
            target = (2 * nums[m]) % k
            # We need: (prefix_sum[j] - prefix_sum[i]) % k == target
            # i.e., prefix_sum[j] % k == (prefix_sum[i] % k + target) % k
            
            # For each remainder r for prefix_sum[i] (where i <= m):
            for r in range(k):
                if r not in remainder_indices:
                    continue
                indices = remainder_indices[r]
                
                # Find first index <= m for this remainder
                pos = bisect.bisect_right(indices, m)
                if pos == 0:
                    continue  # No index <= m for this remainder
                first_i = indices[pos - 1]
                
                # Now we need last index > m for remainder remainder (r + target) % k
                required_r = (r + target) % k
                if required_r not in remainder_indices:
                    continue
                req_indices = remainder_indices[required_r]
                
                # Find first index > m in req_indices
                pos_req = bisect.bisect_right(req_indices, m)
                if pos_req == len(req_indices):
                    continue  # No index > m for this remainder
                last_j = req_indices[-1]  # Last element is guaranteed to be > m
                
                length = last_j - first_i
                result = max(result, length)
        
        return result
