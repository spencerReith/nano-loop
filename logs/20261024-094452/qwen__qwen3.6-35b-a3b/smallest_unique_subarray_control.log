class Solution:
    def smallestUniqueSubarray(self, nums: list[int]) -> int:
        # Suffix Automaton implementation
        # Each state: [len, link, next_dict, cnt]
        # We'll use lists for state attributes for efficiency
        
        # Initialize root state
        st_len = [0]
        st_link = [-1]
        st_next = [{}]
        cnt = [0]
        
        last = 0  # index of the last state
        
        for c in nums:
            cur = len(st_len)
            st_len.append(st_len[last] + 1)
            st_link.append(0)
            st_next.append({})
            cnt.append(1)
            
            p = last
            while p != -1 and c not in st_next[p]:
                st_next[p][c] = cur
                p = st_link[p]
            
            if p == -1:
                st_link[cur] = 0
            else:
                q = st_next[p][c]
                if st_len[p] + 1 == st_len[q]:
                    st_link[cur] = q
                else:
                    clone = len(st_len)
                    st_len.append(st_len[p] + 1)
                    st_link.append(st_link[q])
                    st_next.append(st_next[q].copy())
                    cnt.append(0)
                    
                    while p != -1 and st_next[p].get(c) == q:
                        st_next[p][c] = clone
                        p = st_link[p]
                    
                    st_link[q] = clone
                    st_link[cur] = clone
            last = cur
        
        # Propagate counts from longer states to their suffix links
        # Get states sorted by length descending
        states_by_len = sorted(range(len(st_len)), key=lambda i: st_len[i], reverse=True)
        
        for u in states_by_len:
            if u == 0:
                continue
            link = st_link[u]
            if link != -1:
                cnt[link] += cnt[u]
        
        # Find the minimum minlen for states with cnt==1
        ans = float('inf')
        for u in range(1, len(st_len)):  # skip root (0)
            if cnt[u] == 1:
                # The shortest substring in this state has length = st_len[st_link[u]] + 1
                link = st_link[u]
                min_len = st_len[link] + 1
                if min_len < ans:
                    ans = min_len
                    
        return ans
```

