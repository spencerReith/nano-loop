import bisect

class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums)
        
        def f(s):
            """Count subarrays of length >= 3 in an interval of length s."""
            if s < 3:
                return 0
            return (s - 2) * (s - 1) // 2
        
        def is_peak(k):
            if k <= 0 or k >= n - 1:
                return False
            return nums[k] > nums[k - 1] and nums[k] > nums[k + 1]
        
        # Maintain a sorted list of peak indices
        peaks = []
        for k in range(1, n - 1):
            if is_peak(k):
                peaks.append(k)
        
        # Precompute prefix sums of f(p_{i+1} - p_i + 1) for consecutive peaks
        # gap_contribution[i] = f(peaks[i+1] - peaks[i] + 1)
        # prefix_gap[i] = sum(gap_contribution[0..i-1])
        # prefix_gap[0] = 0
        # prefix_gap[k] = sum of gap contributions for peaks[0..k-1] to peaks[1..k]
        
        m_peaks = len(peaks)
        prefix_gap = [0] * (m_peaks + 1)
        for i in range(m_peaks - 1):
            gap = peaks[i + 1] - peaks[i] + 1
            prefix_gap[i + 1] = prefix_gap[i] + f(gap)
        prefix_gap[m_peaks] = prefix_gap[m_peaks - 1] if m_peaks > 0 else 0
        
        answer = []
        
        for query in queries:
            if query[0] == 1:
                _, l, r = query
                m = r - l + 1
                if m < 3:
                    answer.append(0)
                    continue
                
                total = f(m)
                
                # Find peaks in (l, r)
                left_idx = bisect.bisect_left(peaks, l + 1)
                right_idx = bisect.bisect_right(peaks, r - 1)
                num_peaks = right_idx - left_idx
                
                if num_peaks == 0:
                    answer.append(0)
                    continue
                
                # no_peak_count = f(p1 - l + 1) + sum(f(gap_i)) + f(r - pm + 1)
                # where p1 = peaks[left_idx], pm = peaks[right_idx - 1]
                
                p1 = peaks[left_idx]
                pm = peaks[right_idx - 1]
                
                no_peak_count = f(p1 - l + 1) + f(r - pm + 1)
                
                # Sum of gap contributions from peak left_idx to right_idx - 2
                # i.e., gaps between peaks[left_idx], peaks[left_idx+1], ..., peaks[right_idx-1]
                # The gaps are indexed from left_idx to right_idx - 2
                # prefix_gap[right_idx - 1] - prefix_gap[left_idx]
                
                if right_idx - 1 > left_idx:
                    no_peak_count += prefix_gap[right_idx - 1] - prefix_gap[left_idx]
                
                answer.append(total - no_peak_count)
                
            else:
                _, index, val = query
                old_val = nums[index]
                nums[index] = val
                
                # Update peak status for indices: index-1, index, index+1
                for k in [index - 1, index, index + 1]:
                    pos = bisect.bisect_left(peaks, k)
                    old_is_peak = (pos < len(peaks) and peaks[pos] == k)
                    new_is_peak = is_peak(k)
                    
                    if old_is_peak and not new_is_peak:
                        # Remove k from peaks
                        idx_in_peaks = peaks.index(k)
                        peaks.pop(idx_in_peaks)
                        
                        # Recompute prefix_gap (expensive, but only done on updates)
                        m_peaks = len(peaks)
                        prefix_gap = [0] * (m_peaks + 1)
                        for i in range(m_peaks - 1):
                            gap = peaks[i + 1] - peaks[i] + 1
                            prefix_gap[i + 1] = prefix_gap[i] + f(gap)
                        if m_peaks > 0:
                            prefix_gap[m_peaks] = prefix_gap[m_peaks - 1]
                        
                    elif not old_is_peak and new_is_peak:
                        # Add k to peaks
                        bisect.insort(peaks, k)
                        
                        # Recompute prefix_gap
                        m_peaks = len(peaks)
                        prefix_gap = [0] * (m_peaks + 1)
                        for i in range(m_peaks - 1):
                            gap = peaks[i + 1] - peaks[i] + 1
                            prefix_gap[i + 1] = prefix_gap[i] + f(gap)
                        if m_peaks > 0:
                            prefix_gap[m_peaks] = prefix_gap[m_peaks - 1]
        
        return answer
