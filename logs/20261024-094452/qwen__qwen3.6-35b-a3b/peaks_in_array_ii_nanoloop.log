from sortedcontainers import SortedList

class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums)
        
        def is_peak(k):
            if k <= 0 or k >= n - 1:
                return False
            return nums[k] > nums[k - 1] and nums[k] > nums[k + 1]
        
        # Maintain a sorted list of peak indices
        peaks = SortedList()
        for k in range(1, n - 1):
            if is_peak(k):
                peaks.add(k)
        
        answer = []
        
        for query in queries:
            if query[0] == 1:
                _, l, r = query
                # Count peak subarrays in nums[l..r]
                # A peak subarray has length >= 3 and contains at least one peak index k with l < k < r
                
                m = r - l + 1
                if m < 3:
                    answer.append(0)
                    continue
                
                # Total subarrays of length >= 3
                total = (m - 2) * (m - 1) // 2
                
                # Find peaks in (l, r), i.e., indices k such that l < k < r
                # Using bisect
                import bisect
                # Get peaks in range [l+1, r-1]
                left_idx = bisect.bisect_left(peaks, l + 1)
                right_idx = bisect.bisect_right(peaks, r - 1)
                peak_indices_in_range = list(peaks[left_idx:right_idx])
                
                if not peak_indices_in_range:
                    # No peaks, all subarrays have no peaks
                    answer.append(0)
                    continue
                
                # Compute subarrays with no peaks
                # The peaks partition [l, r] into segments
                # Segments are: [l, p1-1], [p1+1, p2-1], ..., [pm+1, r]
                
                no_peak_count = 0
                
                # First segment: from l to peak_indices_in_range[0] - 1
                first_peak = peak_indices_in_range[0]
                seg_len = first_peak - l
                if seg_len >= 3:
                    no_peak_count += (seg_len - 2) * (seg_len - 1) // 2
                
                # Middle segments
                for idx in range(len(peak_indices_in_range) - 1):
                    p1 = peak_indices_in_range[idx]
                    p2 = peak_indices_in_range[idx + 1]
                    seg_len = p2 - p1 - 1
                    if seg_len >= 3:
                        no_peak_count += (seg_len - 2) * (seg_len - 1) // 2
                
                # Last segment: from last_peak + 1 to r
                last_peak = peak_indices_in_range[-1]
                seg_len = r - last_peak
                if seg_len >= 3:
                    no_peak_count += (seg_len - 2) * (seg_len - 1) // 2
                
                answer.append(total - no_peak_count)
                
            else:
                _, index, val = query
                old_val = nums[index]
                nums[index] = val
                
                # Update peak status for indices: index-1, index, index+1
                for k in [index - 1, index, index + 1]:
                    old_is_peak = k in peaks
                    new_is_peak = is_peak(k)
                    
                    if old_is_peak and not new_is_peak:
                        peaks.remove(k)
                    elif not old_is_peak and new_is_peak:
                        peaks.add(k)
        
        return answer
```

