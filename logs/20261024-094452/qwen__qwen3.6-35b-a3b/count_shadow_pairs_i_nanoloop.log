```python
class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        
        # For each i, find the first index j > i where nums[j] < nums[i]
        # This is the "next smaller element to the right"
        # We can use a monotonic stack for this
        
        next_smaller = [n] * n  # next_smaller[i] = first index j > i with nums[j] < nums[i], or n if none
        stack = []  # monotonic increasing stack (stores indices)
        
        for i in range(n - 1, -1, -1):
            while stack and nums[stack[-1]] >= nums[i]:
                stack.pop()
            if stack:
                next_smaller[i] = stack[-1]
            stack.append(i)
        
        # For each i, valid j's are in range [i+1, next_smaller[i]-1]
        # We need to count j in this range where nums[j] > nums[i]
        
        # Collect all queries
        queries = []
        for i in range(n):
            L, R = i + 1, next_smaller[i] - 1
            if L <= R:
                queries.append((L, R, nums[i], i))
        
        # Create list of (value, position) sorted by value descending
        elements = [(nums[i], i) for i in range(n)]
        elements.sort(key=lambda x: -x[0])
        
        # BIT over positions (1-indexed)
        bit = [0] * (n + 2)
        
        def update(pos, val):
            pos += 1  # 1-indexed
            while pos <= n:
                bit[pos] += val
                pos += pos & (-pos)
        
        def query_bit(pos):
            pos += 1  # 1-indexed
            s = 0
            while pos > 0:
                s += bit[pos]
                pos -= pos & (-pos)
            return s
        
        def query_range(l, r):
            if l > r:
                return 0
            return query_bit(r) - query_bit(l - 1)
        
        # Sort queries by threshold descending
        sorted_queries = sorted(queries, key=lambda x: -x[2])
        
        result = [0] * len(sorted_queries)
        elem_idx = 0
        
        for q_idx, (L, R, V, original_i) in enumerate(sorted_queries):
            # Add all elements with value > V
            while elem_idx < len(elements) and elements[elem_idx][0] > V:
                update(elements[elem_idx][1], 1)
                elem_idx += 1
            
            # Now query range [L, R]
            result[q_idx] = query_range(L, R)
        
        return sum(result)
