```python
from collections import deque

class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        # For each number, compute all reachable values and minimum cost to reach them
        # We only care about values <= target_sum (since all numbers are positive)
        
        def get_reachable(x, max_val):
            """Get all reachable values from x and their minimum costs."""
            # BFS to find minimum cost to reach each value
            # Start from x with cost 0
            cost_map = {x: 0}
            queue = deque([(x, 0)])
            
            while queue:
                curr, cost = queue.popleft()
                new_cost = cost + 1
                
                # Try multiplying by 2
                val1 = 2 * curr
                if val1 <= max_val and val1 not in cost_map:
                    cost_map[val1] = new_cost
                    queue.append((val1, new_cost))
                
                # Try dividing by 2
                val2 = curr // 2
                if val2 > 0 and val2 not in cost_map:
                    cost_map[val2] = new_cost
                    queue.append((val2, new_cost))
            
            return cost_map
        
        max_val = sum
        
        # For each number, get its reachable values and costs
        options = []
        for x in nums:
            reachable = get_reachable(x, max_val)
            options.append(reachable)
        
        # Now we need to select at most one value from each option such that
        # the sum equals target_sum with minimum total cost.
        # This is like a bounded knapsack / subset sum problem.
        
        # dp[s] = minimum cost to achieve sum s
        # Initialize with infinity, dp[0] = 0
        INF = float('inf')
        dp = [INF] * (sum + 1)
        dp[0] = 0
        
        for option in options:
            # For each option, we can pick at most one value (or skip this number entirely)
            # Create new dp array
            new_dp = dp[:]  # We can choose not to use this number
            
            for val, cost in option.items():
                for s in range(sum, val - 1, -1):
                    if dp[s - val] != INF:
                        new_dp[s] = min(new_dp[s], dp[s - val] + cost)
            
            dp = new_dp
        
        return dp[sum] if dp[sum] != INF else -1
