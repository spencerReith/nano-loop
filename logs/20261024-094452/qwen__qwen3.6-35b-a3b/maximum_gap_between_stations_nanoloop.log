```python
import bisect

class Solution:
    def maximumGap(self, skill: str, station: str) -> int:
        n = len(skill)
        m = len(station)
        
        # Collect all station indices for each skill character
        station_indices = {}
        for idx, s in enumerate(station):
            if s not in station_indices:
                station_indices[s] = []
            station_indices[s].append(idx)
        
        # Compute latest possible station for each worker (working backwards)
        # latest[i] = the latest station index worker i can take such that workers i+1..n-1 can still be assigned
        latest = [0] * n
        latest[n-1] = station_indices[skill[n-1]][-1]
        
        for i in range(n-2, -1, -1):
            target_skill = skill[i]
            targets = station_indices[target_skill]
            # Find the largest index in targets that is < latest[i+1]
            pos = bisect.bisect_left(targets, latest[i+1])
            if pos == 0:
                # No valid station < latest[i+1]
                # This shouldn't happen based on problem guarantee
                pass
            else:
                latest[i] = targets[pos - 1]
        
        # Assign each worker to the latest possible valid station
        assignments = [0] * n
        assignments[0] = station_indices[skill[0]][0]  # earliest possible for first worker
        
        for i in range(1, n):
            target_skill = skill[i]
            targets = station_indices[target_skill]
            # Find the largest index in targets that is in (assignments[i-1], latest[i]]
            # i.e., > assignments[i-1] and <= latest[i]
            low = bisect.bisect_right(targets, assignments[i-1])
            high = bisect.bisect_left(targets, latest[i] + 1) - 1
            if low <= high:
                assignments[i] = targets[high]  # latest valid
            else:
                # Shouldn't happen
                assignments[i] = targets[low]
        
        max_gap = 0
        for i in range(1, n):
            gap = assignments[i] - assignments[i-1]
            max_gap = max(max_gap, gap)
        
        return max_gap
