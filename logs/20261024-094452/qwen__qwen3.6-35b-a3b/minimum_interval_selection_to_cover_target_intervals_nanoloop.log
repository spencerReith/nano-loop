import heapq

class Solution:
    def minSelection(self, availableIntervals: list[list[int]], targetIntervals: list[list[int]]) -> int:
        # Step 1: Merge target intervals to get the union of all ranges that need to be covered
        targetIntervals.sort()
        merged_targets = []
        for start, end in targetIntervals:
            if merged_targets and start <= merged_targets[-1][1]:
                merged_targets[-1][1] = max(merged_targets[-1][1], end)
            else:
                merged_targets.append([start, end])
        
        # Step 2: Sort available intervals by start time
        availableIntervals.sort()
        
        # Step 3: Greedily cover all merged target intervals using a priority queue
        total_count = 0
        avail_idx = 0
        n = len(availableIntervals)
        
        # Use a max-heap to track available intervals (negate for max-heap)
        heap = []  # max-heap by end time (stored as negative)
        
        for target_start, target_end in merged_targets:
            current = target_start
            while current < target_end:
                # Add all available intervals that start at or before current position
                while avail_idx < n and availableIntervals[avail_idx][0] <= current:
                    start, end = availableIntervals[avail_idx]
                    if end > current:
                        heapq.heappush(heap, (-end, start))
                    avail_idx += 1
                
                # Remove intervals from heap that end at or before current (useless now)
                while heap and -heap[0][0] <= current:
                    heapq.heappop(heap)
                
                # If no suitable interval found, it's impossible
                if not heap:
                    return -1
                
                # Use the interval that extends farthest to the right
                best_end, _ = heapq.heappop(heap)
                total_count += 1
                current = -best_end
        
        return total_count
