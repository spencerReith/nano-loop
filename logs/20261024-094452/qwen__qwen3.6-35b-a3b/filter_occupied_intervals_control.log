class Solution:
    def filterOccupiedIntervals(self, occupiedIntervals: list[list[int]], freeStart: int, freeEnd: int) -> list[list[int]]:
        if not occupiedIntervals:
            return []
        
        # Sort intervals by start time
        occupiedIntervals.sort(key=lambda x: x[0])
        
        # Merge overlapping or touching intervals
        merged = []
        for interval in occupiedIntervals:
            start, end = interval
            if not merged:
                merged.append([start, end])
            else:
                last_start, last_end = merged[-1]
                # Check if current interval overlaps or touches the last merged interval
                # Touching means the next interval starts immediately after the last one ends
                if start <= last_end + 1:
                    merged[-1][1] = max(last_end, end)
                else:
                    merged.append([start, end])
        
        # Now remove the free interval from each merged interval
        result = []
        for start, end in merged:
            # The free interval is [freeStart, freeEnd]
            # We need to remove all points in [freeStart, freeEnd] from [start, end]
            
            # Case 1: The occupied interval is completely before the free interval
            if end < freeStart:
                result.append([start, end])
            # Case 2: The occupied interval is completely after the free interval
            elif start > freeEnd:
                result.append([start, end])
            # Case 3: There is an overlap
            else:
                # Remove the part that overlaps with [freeStart, freeEnd]
                
                # Part before the free interval
                if start < freeStart:
                    result.append([start, min(end, freeStart - 1)])
                
                # Part after the free interval
                if end > freeEnd:
                    result.append([max(start, freeEnd + 1), end])
        
        return result
