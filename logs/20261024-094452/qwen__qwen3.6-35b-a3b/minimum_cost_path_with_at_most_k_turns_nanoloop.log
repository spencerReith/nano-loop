```python
import heapq
from typing import List

class Solution:
    def minCost(self, grid: List[List[int]], k: int) -> int:
        m, n = len(grid), len(grid[0])
        
        # Directions: (dr, dc, dir_index)
        # 0=up, 1=down, 2=left, 3=right
        directions = [(-1, 0, 0), (1, 0, 1), (0, -1, 2), (0, 1, 3)]
        
        # dist[row][col][direction][turns] = minimum cost
        INF = float('inf')
        # Create a 4D array: [m][n][4][k+1]
        dist = []
        for i in range(m):
            row_dist = []
            for j in range(n):
                col_dist = []
                for d in range(4):
                    col_dist.append([INF] * (k + 1))
                row_dist.append(col_dist)
            dist.append(row_dist)
        
        # Priority queue: (cost, row, col, direction, turns)
        # direction: -1 for start (no direction yet)
        pq = [(grid[0][0], 0, 0, -1, 0)]
        
        while pq:
            cost, r, c, dir_idx, turns = heapq.heappop(pq)
            
            # If we reached the destination, return cost
            if r == m - 1 and c == n - 1:
                return cost
            
            # If this state is worse than what we've seen, skip
            if dir_idx != -1:
                if cost > dist[r][c][dir_idx][turns]:
                    continue
            
            # Explore all directions
            for dr, dc, d_idx in directions:
                nr, nc = r + dr, c + dc
                if 0 <= nr < m and 0 <= nc < n:
                    new_turns = turns
                    if dir_idx != -1 and dir_idx != d_idx:
                        new_turns = turns + 1
                    
                    if new_turns <= k:
                        new_cost = cost + grid[nr][nc]
                        if dir_idx != -1:
                            if new_cost < dist[nr][nc][d_idx][new_turns]:
                                dist[nr][nc][d_idx][new_turns] = new_cost
                                heapq.heappush(pq, (new_cost, nr, nc, d_idx, new_turns))
                        else:
                            # First move, no turn counted
                            if new_cost < dist[nr][nc][d_idx][new_turns]:
                                dist[nr][nc][d_idx][new_turns] = new_cost
                                heapq.heappush(pq, (new_cost, nr, nc, d_idx, new_turns))
        
        return -1
