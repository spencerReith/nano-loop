```python
class Solution:
    def findDisappearedNumbers(self, nums: list[int], lower: int, upper: int) -> list[list[int]]:
        num_set = set(nums)
        result = []
        
        i = lower
        while i <= upper:
            if i not in num_set:
                # Start of a missing range
                start = i
                while i <= upper and i not in num_set:
                    i += 1
                end = i - 1
                result.append([start, end])
            else:
                i += 1
        
        return result
```
