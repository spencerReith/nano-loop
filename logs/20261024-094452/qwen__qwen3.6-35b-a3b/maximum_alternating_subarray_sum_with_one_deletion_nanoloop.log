class Solution:
    def maxAlternatingSum(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 0:
            return 0
        
        # States representing the maximum alternating sum ending with the last included element
        # at the current or earlier position, with the given parity and deletion status:
        # e_no_del: even position in subarray, no deletion used
        # o_no_del: odd position in subarray, no deletion used  
        # e_del: even position in subarray, one deletion used
        # o_del: odd position in subarray, one deletion used
        
        e_no_del = nums[0]  # subarray [nums[0]], even position
        o_no_del = float('-inf')  # can't end at odd position with 1 element
        e_del = float('-inf')
        o_del = float('-inf')
        
        ans = e_no_del
        
        for i in range(1, n):
            num = nums[i]
            
            # e_no_del: even position, no deletion
            # - Start new subarray: num
            # - Extend from odd position (no del): o_no_del + num
            nxt_e_no_del = max(num, (o_no_del + num) if o_no_del > float('-inf') / 2 else float('-inf'))
            
            # o_no_del: odd position, no deletion
            # - Extend from even position (no del): e_no_del - num
            nxt_o_no_del = e_no_del - num
            
            # e_del: even position, deletion used
            # - Delete nums[i] (keep previous best from e_no_del): e_no_del
            # - Extend from odd position (del used): o_del + num
            # - Start new subarray at i after deletion: num
            nxt_e_del = max(
                e_no_del,
                (o_del + num) if o_del > float('-inf') / 2 else float('-inf'),
                num,
            )
            
            # o_del: odd position, deletion used
            # - Delete nums[i] (keep previous best from o_no_del): o_no_del
            # - Extend from even position (del used): e_del - num
            nxt_o_del = max(
                o_no_del,
                (e_del - num) if e_del > float('-inf') / 2 else float('-inf'),
            )
            
            e_no_del, o_no_del, e_del, o_del = nxt_e_no_del, nxt_o_no_del, nxt_e_del, nxt_o_del
            ans = max(ans, e_no_del, o_no_del, e_del, o_del)
        
        return ans
