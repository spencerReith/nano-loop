class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n = len(source)
        m = len(rules)
        
        # Precompute wildcard counts for each rule
        wildcard_counts = [rule[0].count('*') for rule in rules]
        
        # dp[i] = min cost to transform source[i:] to target[i:]
        dp = [float('inf')] * (n + 1)
        dp[n] = 0
        
        for i in range(n - 1, -1, -1):
            # Option 1: Don't apply any rule at i, only valid if source[i] == target[i]
            if source[i] == target[i]:
                dp[i] = dp[i + 1]
            else:
                dp[i] = float('inf')
            
            # Option 2: Apply a rule starting at i
            for k in range(m):
                pattern, replacement = rules[k]
                plen = len(pattern)
                
                # Check if rule fits
                if i + plen > n:
                    continue
                
                # Check if pattern matches source[i:i+plen]
                # and replacement matches target[i:i+plen]
                match_source = True
                for j in range(plen):
                    if pattern[j] != '*' and pattern[j] != source[i + j]:
                        match_source = False
                        break
                
                if not match_source:
                    continue
                
                if replacement != target[i:i + plen]:
                    continue
                
                # Calculate cost
                cost = costs[k] + wildcard_counts[k]
                if dp[i + plen] != float('inf'):
                    total_cost = cost + dp[i + plen]
                    if total_cost < dp[i]:
                        dp[i] = total_cost
        
        return dp[0] if dp[0] != float('inf') else -1
```

