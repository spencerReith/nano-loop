class Solution:
    def kthDigit(self, k: int) -> int:
        if k <= 9:
            return k
        
        k -= 9  # skip first 9 digits
        
        # Find which block
        block_num = 0
        while True:
            block_num += 1
            b = block_num
            # Numbers in this block: 10b to 10b+9
            num_digits = len(str(10 * b))
            block_length = 10 * num_digits
            
            if k <= block_length:
                # Found the block
                pos_in_block = k - 1
                
                if b % 2 == 1:  # odd, decreasing
                    number_index = pos_in_block // num_digits
                    digit_index = pos_in_block % num_digits
                    number = 10 * b + 9 - number_index
                else:  # even, increasing
                    number_index = pos_in_block // num_digits
                    digit_index = pos_in_block % num_digits
                    number = 10 * b + number_index
                
                num_str = str(number)
                return int(num_str[digit_index])
            else:
                k -= block_length
