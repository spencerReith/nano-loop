```python
class Solution:
    def kthDigit(self, k: int) -> int:
        if k <= 9:
            return k
        
        k -= 9
        
        # Find which digit-length group
        # Groups: 2-digit (blocks 1-9), 3-digit (blocks 10-99), etc.
        
        digit_len = 2
        block_start = 1
        block_end = 9
        
        while True:
            num_blocks_in_group = block_end - block_start + 1
            total_digits_in_group = num_blocks_in_group * 10 * digit_len
            
            if k <= total_digits_in_group:
                # k is within this group
                # Find which block in this group
                block_index = (k - 1) // (10 * digit_len)
                b = block_start + block_index
                pos_in_block = (k - 1) % (10 * digit_len)
                
                if b % 2 == 1:  # odd, decreasing
                    number_index = pos_in_block // digit_len
                    digit_index = pos_in_block % digit_len
                    number = 10 * b + 9 - number_index
                else:  # even, increasing
                    number_index = pos_in_block // digit_len
                    digit_index = pos_in_block % digit_len
                    number = 10 * b + number_index
                
                num_str = str(number)
                return int(num_str[digit_index])
            else:
                k -= total_digits_in_group
                digit_len += 1
                block_start = block_end + 1
                block_end = block_end * 10
```

