class Solution:
    def kthDigit(self, k: int) -> int:
        if k <= 9:
            return k
        
        # Subtract the first 9 digits
        k -= 9
        
        # Each block has 10 numbers with 2 digits each = 20 digits
        # Block b starts at position 10 + 20*(b-1) for b >= 1
        
        # Find which block
        block_index = (k - 1) // 20  # 0-indexed block index (0 corresponds to b=1)
        b = block_index + 1  # actual block number
        
        # Position within the block
        pos_in_block = (k - 1) % 20
        
        # Determine the number and its position
        if b % 2 == 1:  # odd block, decreasing order
            # Numbers from 10b+9 down to 10b
            # Each number takes 2 positions
            number_index = pos_in_block // 2
            digit_index = pos_in_block % 2
            
            number = 10*b + 9 - number_index
        else:  # even block, increasing order
            number_index = pos_in_block // 2
            digit_index = pos_in_block % 2
            
            number = 10*b + number_index
        
        # Get the digit
        num_str = str(number)
        return int(num_str[digit_index])
```

