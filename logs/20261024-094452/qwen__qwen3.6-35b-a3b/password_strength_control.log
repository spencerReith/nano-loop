class Solution:
    def passwordStrength(self, password: str) -> int:
        lower = set()
        upper = set()
        digits = set()
        special = set("!@#$")
        special_found = set()
        
        for ch in password:
            if ch.islower():
                lower.add(ch)
            elif ch.isupper():
                upper.add(ch)
            elif ch.isdigit():
                digits.add(ch)
            elif ch in special:
                special_found.add(ch)
        
        strength = 0
        strength += len(lower) * 1
        strength += len(upper) * 2
        strength += len(digits) * 3
        strength += len(special_found) * 5
        
        return strength
