```python
from collections import deque
from typing import list

class Solution:
    def findColoredRoot(self, edges: list[list[int]], colors: str) -> int:
        n = len(colors)
        # Build graph and degree count
        graph = [[] for _ in range(n)]
        degree = [0] * n
        for u, v in edges:
            graph[u].append(v)
            graph[v].append(u)
            degree[u] += 1
            degree[v] += 1
            
        # Map colors to integers
        color_map = {'R': 0, 'B': 1, 'W': 2}
        colors_int = [color_map[c] for c in colors]
        
        # Three sequences: s=0,1,2
        # For a sequence s, val[u] = (colors_int[u] - s) % 3
        # But we want val[u] in {0,1,2}, and (a % 3) in Python is non-negative.
        
        for s in range(3):
            val = [(colors_int[u] - s) % 3 for u in range(n)]
            
            # Check local condition for all edges
            local_valid = True
            for u, v in edges:
                diff = (val[u] - val[v]) % 3
                if diff != 1 and diff != 2: 
                    # diff must be 1 or 2 (i.e., ±1 mod 3)
                    local_valid = False
                    break
                    
            if not local_valid:
                continue
                
            # Find candidates: val[r]==0 and degree[r]<=2
            candidates = []
            for r in range(n):
                if val[r] == 0 and degree[r] <= 2:
                    candidates.append(r)
                    
            # For each candidate, do BFS to check the pattern
            for r in candidates:
                # BFS from r
                dist = [-1] * n
                dist[r] = 0
                queue = deque([r])
                valid = True
                while queue:
                    curr = queue.popleft()
                    if dist[curr] % 3 != val[curr]:
                        valid = False
                        break
                    for neighbor in graph[curr]:
                        if dist[neighbor] == -1:
                            dist[neighbor] = dist[curr] + 1
                            queue.append(neighbor)
                if valid:
                    # Also check that we visited all nodes? BFS in a tree from r will visit all.
                    # But if the tree is not connected? The problem says it's a tree, so connected.
                    return r
                    
        return -1
```

