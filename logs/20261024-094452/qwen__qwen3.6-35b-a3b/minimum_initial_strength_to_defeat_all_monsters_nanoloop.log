class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        
        # Compute bonus for each monster using difference array
        diff = [0] * (n + 1)
        for l, r, v in boosts:
            diff[l] += v
            if r + 1 < n:
                diff[r + 1] -= v
        
        bonus = [0] * n
        current = 0
        for i in range(n):
            current += diff[i]
            bonus[i] = current
        
        # Work backwards to find minimum required strength
        # req[i] = minimum strength needed before fighting monster i
        req = [0] * (n + 1)  # req[n] = 0 (base case)
        
        for i in range(n - 1, -1, -1):
            if req[i + 1] > 0:
                req[i] = max(monsters[i] - bonus[i], monsters[i] + req[i + 1])
            else:
                req[i] = max(0, monsters[i] - bonus[i])
        
        return req[0]
```
