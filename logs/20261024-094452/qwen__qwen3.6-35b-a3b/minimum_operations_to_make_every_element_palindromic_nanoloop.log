class Solution:
    def minOperations(self, nums: list[int]) -> int:
        def make_palindrome(num: int) -> int:
            """Create a palindrome from the first half of the number."""
            s = str(num)
            n = len(s)
            # Take the first half (including middle for odd length)
            half = s[:(n + 1) // 2]
            # Mirror it to create a palindrome
            if n % 2 == 0:
                palindrome = half + half[::-1]
            else:
                palindrome = half + half[:-1][::-1]
            return int(palindrome)
        
        def closest_palindrome_same_parity(num: int) -> int:
            """Find the closest palindrome to num with the same parity."""
            if num < 10:
                # Single digit numbers are already palindromes
                return num
            
            # Generate candidate palindromes
            candidates = set()
            
            # The palindrome made by mirroring the first half
            s = str(num)
            n = len(s)
            
            # Try the prefix as-is
            for start_len in [(n + 1) // 2]:
                prefix = s[:start_len]
                # Create palindrome from this prefix
                if n % 2 == 0:
                    pal = prefix + prefix[::-1]
                else:
                    pal = prefix + prefix[:-1][::-1]
                candidates.add(int(pal))
            
            # Try prefix - 1
            for start_len in [(n + 1) // 2]:
                prefix = s[:start_len]
                prefix_val = int(prefix) - 1
                if prefix_val > 0:
                    prefix_str = str(prefix_val)
                    if n % 2 == 0:
                        pal = prefix_str + prefix_str[::-1]
                    else:
                        pal = prefix_str + prefix_str[:-1][::-1]
                    candidates.add(int(pal))
            
            # Try prefix + 1
            for start_len in [(n + 1) // 2]:
                prefix = s[:start_len]
                prefix_val = int(prefix) + 1
                prefix_str = str(prefix_val)
                if n % 2 == 0:
                    # If prefix length changes, the palindrome length changes
                    if len(prefix_str) == len(prefix):
                        pal = prefix_str + prefix_str[::-1]
                        candidates.add(int(pal))
                    else:
                        # New length, create palindrome with new length
                        new_n = 2 * len(prefix_str)
                        pal = prefix_str + prefix_str[::-1]
                        candidates.add(int(pal))
                else:
                    if len(prefix_str) == len(prefix):
                        pal = prefix_str + prefix_str[:-1][::-1]
                        candidates.add(int(pal))
                    else:
                        new_n = 2 * len(prefix_str) - 1
                        pal = prefix_str + prefix_str[:-1][::-1]
                        candidates.add(int(pal))
            
            # Also add single digit palindromes (1-9) as candidates
            for i in range(1, 10):
                candidates.add(i)
            
            # Add smallest palindrome of same length and parity
            # For even length: smallest is 10...01
            # For odd length: smallest is 10...0...01
            # Actually, let's also consider edge cases
            
            # Filter to only palindromes with same parity as num
            same_parity_candidates = [c for c in candidates if c > 0 and c % 2 == num % 2]
            
            if not same_parity_candidates:
                # Fallback: find closest by checking neighbors
                pass
            
            # Find the one with minimum absolute difference
            best = min(same_parity_candidates, key=lambda x: (abs(x - num), x))
            return best
        
        result = 0
        for num in nums:
            target = closest_palindrome_same_parity(num)
            result += abs(num - target) // 2
        
        return result
