class Solution:
    def countValidSubarrays(self, nums: list[int], x: int) -> int:
        n = len(nums)
        count = 0
        
        # Precompute prefix sums to quickly calculate subarray sums
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + nums[i]
        
        # For each subarray, compute the sum and check conditions
        for l in range(n):
            for r in range(l, n):
                sub_sum = prefix[r + 1] - prefix[l]
                
                # Get the last digit
                last_digit = sub_sum % 10
                
                # Get the first digit
                first_digit = int(str(sub_sum)[0])
                
                if first_digit == x and last_digit == x:
                    count += 1
        
        return count
