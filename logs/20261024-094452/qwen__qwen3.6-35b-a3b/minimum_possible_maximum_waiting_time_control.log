import functools
from typing import List

class Solution:
    def minMaxWaitingTime(self, demand: List[int], fuel: List[int]) -> int:
        n = len(demand)
        
        @functools.lru_cache(None)
        def solve(i, f0, f1, t0, t1, current_allowed):
            # Base case: all cars served
            if i == n:
                return (0, n)
            
            best_max_wait = float('inf')
            best_served = i
            
            # Try using dispenser 0 for car i
            if f0 >= demand[i]:
                start0 = max(current_allowed, t0)
                wait0 = start0 - current_allowed
                new_t0 = start0 + demand[i]
                new_f0 = f0 - demand[i]
                
                res0 = solve(i + 1, new_f0, f1, new_t0, t1, start0)
                max_wait0 = max(wait0, res0[0])
                served0 = res0[1]
                
                if served0 > best_served or (served0 == best_served and max_wait0 < best_max_wait):
                    best_max_wait = max_wait0
                    best_served = served0
            
            # Try using dispenser 1 for car i
            if f1 >= demand[i]:
                start1 = max(current_allowed, t1)
                wait1 = start1 - current_allowed
                new_t1 = start1 + demand[i]
                new_f1 = f1 - demand[i]
                
                res1 = solve(i + 1, f0, new_f1, t0, new_t1, start1)
                max_wait1 = max(wait1, res1[0])
                served1 = res1[1]
                
                if served1 > best_served or (served1 == best_served and max_wait1 < best_max_wait):
                    best_max_wait = max_wait1
                    best_served = served1
            
            return (best_max_wait, best_served)
        
        result = solve(0, fuel[0], fuel[1], 0, 0, 0)
        if result[1] == 0:
            return -1
        return result[0]
