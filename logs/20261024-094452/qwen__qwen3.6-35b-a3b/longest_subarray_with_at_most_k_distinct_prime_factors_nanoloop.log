```python
class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        def get_prime_factors(n):
            """Get distinct prime factors of n"""
            factors = set()
            d = 2
            while d * d <= n:
                while n % d == 0:
                    factors.add(d)
                    n //= d
                d += 1
            if n > 1:
                factors.add(n)
            return factors
        
        # Precompute prime factors for all numbers in nums
        prime_factors_list = [get_prime_factors(num) for num in nums]
        
        left = 0
        max_length = 0
        # Count of each prime in the current window
        prime_count = {}
        
        for right in range(len(nums)):
            # Add prime factors of nums[right] to the window
            for prime in prime_factors_list[right]:
                prime_count[prime] = prime_count.get(prime, 0) + 1
            
            # Shrink window from left while we have more than k distinct primes
            while len(prime_count) > k:
                for prime in prime_factors_list[left]:
                    prime_count[prime] -= 1
                    if prime_count[prime] == 0:
                        del prime_count[prime]
                left += 1
            
            # Update max length
            max_length = max(max_length, right - left + 1)
        
        return max_length
```
