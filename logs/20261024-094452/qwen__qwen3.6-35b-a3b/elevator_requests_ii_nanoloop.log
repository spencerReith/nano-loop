class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        total_penalty = 0
        current_floor = start
        remaining = len(requests)
        
        while remaining > 0:
            # Find the closest request
            min_dist = float('inf')
            closest_idx = -1
            for i, req in enumerate(requests):
                dist = abs(current_floor - req)
                if dist < min_dist:
                    min_dist = dist
                    closest_idx = i
            
            # Add penalty: min_dist * remaining (this distance adds to all remaining requests' times)
            total_penalty += min_dist * remaining
            
            # Move to the closest request
            current_floor = requests[closest_idx]
            # Remove this request
            requests.pop(closest_idx)
            remaining -= 1
        
        return total_penalty
```
