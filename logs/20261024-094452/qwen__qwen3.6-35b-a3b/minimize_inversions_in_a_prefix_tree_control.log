```python
class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n = len(words)
        # Map word to its index
        word_to_index = {word: i for i, word in enumerate(words)}
        # Precompute pos: pos[i] = index of i in target
        pos = [0] * n
        for i, idx in enumerate(target):
            pos[idx] = i
            
        # Build trie
        # Each node: dictionary of children, and a word index (if the node marks a word)
        # We can use a dictionary: key is character, value is a node (dict or object)
        # Let's use a class for TrieNode
        class TrieNode:
            def __init__(self):
                self.children = {}
                self.word_index = None  # if this node marks a word, store the index
                
        root = TrieNode()
        for word in words:
            node = root
            for char in word:
                if char not in node.children:
                    node.children[char] = TrieNode()
                node = node.children[char]
            node.word_index = word_to_index[word]
            
        # We'll write a recursive function
        # To avoid passing large lists, we'll build the traversal list at each node.
        
        # Preallocate a frequency array for each node? No, we build it per child in the node.
        
        # We need a function to compute inv(A, B) using precomputed prefix arrays for B.
        # But we'll build the prefix array for each child's list in the node's processing.
        
        def solve(node):
            # Base case: if no children and no word index, return empty list and 0 inversions
            if not node.children and node.word_index is None:
                return ([], 0)
            
            # List to store (child_char, child_traversal_list, child_inv, child_prefix)
            # Actually, we need the prefix array for each child for the comparator.
            children_data = []  # list of tuples: (child_char, traversal_list, child_inv, prefix_array)
            
            total_inv = 0
            # Sort children by character to have deterministic order, but we will re-sort by comparator
            # Get children in a fixed order (e.g., sorted by key)
            sorted_keys = sorted(node.children.keys())
            for char in sorted_keys:
                child_node = node.children[char]
                child_list, child_inv = solve(child_node)
                total_inv += child_inv
                # Precompute prefix array for child_list
                # The pos values are in [0, n-1]
                freq = [0] * n
                for idx in child_list:
                    p = pos[idx]
                    freq[p] += 1
                prefix = [0] * (n+1)
                for i in range(1, n+1):
                    prefix[i] = prefix[i-1] + freq[i-1]
                children_data.append((char, child_list, child_inv, prefix))
            
            # Now, handle the current node's word index
            my_list = []
            if node.word_index is not None:
                my_list = [node.word_index]
                
            # Compute inversions between my_list and all children's lists
            if my_list:
                for idx in my_list:
                    p = pos[idx]
                    # Count elements in all children's lists with pos < p
                    for _, _, _, prefix in children_data:
                        # count_less = prefix[p]  (because prefix[p] = sum_{i=0}^{p-1} freq[i])
                        count = prefix[p]
                        total_inv += count
                        
            # Now, sort children_data by the comparator that minimizes cross inversions
            # Comparator: for two items A and B, 
            #   inv_AB = sum_{a in A_list} prefix_B[pos[a]]
            #   inv_BA = sum_{b in B_list} prefix_A[pos[b]]
            #   if inv_AB < inv_BA, then A comes before B
            
            from functools import cmp_to_key
            def compare(itemA, itemB):
                # itemA and itemB are (char, listA, invA, prefixA)
                listA = itemA[1]
                listB = itemB[1]
                prefixA = itemA[3]
                prefixB = itemB[3]
                
                # Compute inv(listA, listB): for each a in listA, count elements in listB with pos < pos[a]
                inv_AB = 0
                for a in listA:
                    p = pos[a]
                    inv_AB += prefixB[p]  # prefixB[p] is the count of elements in listB with pos in [0, p-1]
                    
                inv_BA = 0
                for b in listB:
                    p = pos[b]
                    inv_BA += prefixA[p]
                    
                if inv_AB < inv_BA:
                    return -1
                elif inv_AB > inv_BA:
                    return 1
                else:
                    return 0
                    
            children_data.sort(key=cmp_to_key(compare))
            
            # Now, compute the cross inversions between the children blocks in the sorted order
            # The sorted order is children_data[0], children_data[1], ...
            # The cross inversions are the sum for all i < j of inv(list_i, list_j)
            # But note: the comparator ensures that for each pair, the order is optimal. However, the total cross inversion is the sum over all pairs (i<j) of inv(list_i, list_j) in the sorted order.
            # We can compute this by iterating over all pairs in the sorted list.
            num_children = len(children_data)
            for i in range(num_children):
                for j in range(i+1, num_children):
                    # inv between children_data[i].list and children_data[j].list
                    list_i = children_data[i][1]
                    list_j = children_data[j][1]
                    prefix_j = children_data[j][3]
                    inv_ij = 0
                    for a in list_i:
                        p = pos[a]
                        inv_ij += prefix_j[p]
                    total_inv += inv_ij
                    
            # Construct the traversal list for this node
            traversal = my_list[:]
            for _, child_list, _, _ in children_data:
                traversal.extend(child_list)
                
            return (traversal, total_inv)
        
        _, result = solve(root)
        return result

```

