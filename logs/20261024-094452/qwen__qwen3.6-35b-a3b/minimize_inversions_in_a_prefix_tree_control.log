```python
import bisect
from functools import cmp_to_key

class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n = len(words)
        word_to_index = {word: i for i, word in enumerate(words)}
        pos = [0] * n
        for i, idx in enumerate(target):
            pos[idx] = i
            
        class TrieNode:
            __slots__ = ['children', 'word_index']
            def __init__(self):
                self.children = {}
                self.word_index = None
                
        root = TrieNode()
        for word in words:
            node = root
            for char in word:
                if char not in node.children:
                    node.children[char] = TrieNode()
                node = node.children[char]
            node.word_index = word_to_index[word]
            
        def solve(node):
            if not node.children and node.word_index is None:
                return ([], 0)
            
            children_data = []
            total_inv = 0
            sorted_keys = sorted(node.children.keys())
            for char in sorted_keys:
                child_node = node.children[char]
                child_list, child_inv = solve(child_node)
                total_inv += child_inv
                sorted_pos = sorted(pos[x] for x in child_list)
                children_data.append((char, child_list, child_inv, sorted_pos))
                
            my_list = [node.word_index] if node.word_index is not None else []
            
            if my_list:
                for idx in my_list:
                    p = pos[idx]
                    for _, _, _, sorted_pos in children_data:
                        count = bisect.bisect_left(sorted_pos, p)
                        total_inv += count
                        
            def compare(itemA, itemB):
                listA = itemA[1]
                listB = itemB[1]
                sorted_posA = itemA[3]
                sorted_posB = itemB[3]
                
                inv_AB = 0
                j = 0
                lenB = len(sorted_posB)
                for p in sorted_posA:
                    while j < lenB and sorted_posB[j] < p:
                        j += 1
                    inv_AB += j
                    
                inv_BA = 0
                j = 0
                lenA = len(sorted_posA)
                for p in sorted_posB:
                    while j < lenA and sorted_posA[j] < p:
                        j += 1
                    inv_BA += j
                    
                if inv_AB < inv_BA:
                    return -1
                elif inv_AB > inv_BA:
                    return 1
                else:
                    return 0
                    
            children_data.sort(key=cmp_to_key(compare))
            
            for i in range(len(children_data)):
                for j in range(i+1, len(children_data)):
                    list_i = children_data[i][1]
                    list_j = children_data[j][1]
                    sorted_pos_j = children_data[j][3]
                    pos_list_i = [pos[x] for x in list_i]
                    pos_list_i.sort()
                    inv_ij = 0
                    j_ptr = 0
                    len_j = len(sorted_pos_j)
                    for p in pos_list_i:
                        while j_ptr < len_j and sorted_pos_j[j_ptr] < p:
                            j_ptr += 1
                        inv_ij += j_ptr
                    total_inv += inv_ij
                    
            traversal = my_list[:]
            for _, child_list, _, _ in children_data:
                traversal.extend(child_list)
                
            return (traversal, total_inv)
            
        _, result = solve(root)
        return result
```

Note: This solution has been designed to meet the time constraints by efficiently computing the inversion counts using sorted lists and two-pointer technique. The memory usage is also optimized by storing only the sorted position lists for each child's traversal.
