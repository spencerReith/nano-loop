class Solution:
    def sumDecoded(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        
        total = 0
        
        for num in nums:
            width = num % 10
            d = num // 10
            
            # Convert d to string to extract digits
            d_str = str(d)
            
            # x_i is the first `width` digits of d
            x_str = d_str[:width]
            # y_i is the remaining digits
            y_str = d_str[width:]
            
            x = int(x_str)
            y = int(y_str)
            
            # Compute x^y mod MOD
            decoded_val = pow(x, y, MOD)
            total = (total + decoded_val) % MOD
        
        return total
