### Final Implementation

```python
class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        pos0 = []
        pos1 = []
        pos2 = []
        
        for i, x in enumerate(nums):
            if x < a:
                pos0.append(i)
            elif x <= b:
                pos1.append(i)
            else:
                pos2.append(i)
                
        count0 = len(pos0)
        count1 = len(pos1)
        count2 = len(pos2)
        
        # Precompute prefix sums for the base costs
        # prefix0[i] = sum_{m=0}^{i-1} (pos0[m] - m)
        prefix0 = [0] * (count0 + 1)
        current = 0
        for i in range(count0):
            current += pos0[i] - i
            prefix0[i+1] = current
            
        prefix1 = [0] * (count1 + 1)
        current = 0
        for i in range(count1):
            current += pos1[i] - i
            prefix1[i+1] = current
            
        prefix2 = [0] * (count2 + 1)
        current = 0
        for i in range(count2):
            current += pos2[i] - i
            prefix2[i+1] = current
            
        mod = 10**9 + 7
        min_swaps = float('inf')
        
        # Iterate over all possible i and j
        for i in range(count0 + 1):
            for j in range(count1 + 1):
                # k is fixed as count2
                k = count2
                # Cost calculation
                # Cost for part 0: prefix0[i]
                # Cost for part 1: prefix1[j] - i * j
                # Cost for part 2: prefix2[k] - (i+j) * k
                
                cost = prefix0[i] + (prefix1[j] - i * j) + (prefix2[k] - (i + j) * k)
                if cost < min_swaps:
                    min_swaps = cost
                    
        return min_swaps % mod
