```python
class Solution:
    def minDays(self, n: int) -> int:
        dp = [float('inf')] * (n + 1)
        dp[0] = 0
        
        # Generate all triangular numbers up to n
        tri = []
        j = 1
        while True:
            t = j * (j + 1) // 2
            if t > n:
                break
            tri.append((t, j))
            j += 1
            
        for i in range(1, n + 1):
            for t, j_val in tri:
                if t > i:
                    break
                prev = i - t
                cost = j_val + (1 if prev > 0 else 0)
                if dp[prev] + cost < dp[i]:
                    dp[i] = dp[prev] + cost
                    
        return dp[n]
```
