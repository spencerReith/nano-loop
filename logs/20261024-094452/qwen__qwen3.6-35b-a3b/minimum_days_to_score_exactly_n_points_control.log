Note: We can precompute the triangular numbers to avoid recalculating.

```python
class Solution:
    def minDays(self, n: int) -> int:
        # dp[i] = minimum days to get exactly i points
        dp = [float('inf')] * (n + 1)
        dp[0] = 0
        
        # Precompute triangular numbers up to n
        # j_max: largest j such that j*(j+1)//2 <= n
        j = 1
        tri = []
        while True:
            t = j * (j + 1) // 2
            if t > n:
                break
            tri.append((t, j))
            j += 1
        
        for i in range(1, n + 1):
            for t, j_val in tri:
                if t > i:
                    break
                prev = i - t
                # cost: j_val days for the streak, plus 1 skip if there was a previous part (prev > 0)
                cost = j_val + (1 if prev > 0 else 0)
                if dp[prev] + cost < dp[i]:
                    dp[i] = dp[prev] + cost
                    
        return dp[n]
```

