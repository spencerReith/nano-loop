class Solution:
    def countKthRoots(self, l: int, r: int, k: int) -> int:
        # Find smallest x such that x^k >= l
        lo, hi = 0, 10**9 + 1
        while lo < hi:
            mid = (lo + hi) // 2
            if mid ** k >= l:
                hi = mid
            else:
                lo = mid + 1
        x_min = lo
        
        # Find largest x such that x^k <= r
        lo, hi = 0, 10**9 + 1
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if mid ** k <= r:
                lo = mid
            else:
                hi = mid - 1
        x_max = lo
        
        return max(0, x_max - x_min + 1)
