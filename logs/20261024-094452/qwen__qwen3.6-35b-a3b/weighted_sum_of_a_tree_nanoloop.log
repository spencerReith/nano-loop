```python
class Solution:
    def weightedSum(self, parent: list[int], nums: list[int]) -> int:
        n = len(parent)
        
        # Build adjacency list for the tree
        children = [[] for _ in range(n)]
        for i in range(1, n):
            children[parent[i]].append(i)
        
        # Calculate depth of each node using BFS or DFS
        # Root (0) has depth 1
        depth = [0] * n
        depth[0] = 1
        
        # BFS to calculate depths
        from collections import deque
        queue = deque([0])
        
        while queue:
            node = queue.popleft()
            for child in children[node]:
                depth[child] = depth[node] + 1
                queue.append(child)
        
        # Find the height of the tree (maximum depth)
        h = max(depth)
        
        # Calculate the sum of weights
        total = 0
        for i in range(n):
            d = depth[i]
            weight = nums[i] * (h - d + 1)
            total += weight
        
        return total
