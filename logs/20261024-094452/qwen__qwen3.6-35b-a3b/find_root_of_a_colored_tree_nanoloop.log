```python
class Solution:
    def findColoredRoot(self, edges: list[list[int]], colors: str) -> int:
        n = len(colors)
        color_map = {'R': 0, 'B': 1, 'W': 2}
        
        # Next color mapping: R→B, B→W, W→R
        next_color = {0: 1, 1: 2, 2: 0}
        
        # Build adjacency list and degree array
        degree = [0] * n
        for u, v in edges:
            degree[u] += 1
            degree[v] += 1
        
        # For each edge, determine the valid orientation
        # in_degree[u] counts how many edges are oriented towards u
        in_degree = [0] * n
        
        for u, v in edges:
            u_color = color_map[colors[u]]
            v_color = color_map[colors[v]]
            
            if v_color == next_color[u_color]:
                in_degree[v] += 1
            elif u_color == next_color[v_color]:
                in_degree[u] += 1
            else:
                return -1
        
        # Find the root: the node with in-degree 0
        roots = [i for i in range(n) if in_degree[i] == 0]
        
        if len(roots) != 1:
            return -1
        
        root = roots[0]
        
        # Check if the root has degree ≤ 2
        if degree[root] > 2:
            return -1
        
        # Check that all other nodes have in-degree 1
        for i in range(n):
            if i != root and in_degree[i] != 1:
                return -1
        
        return root
```

