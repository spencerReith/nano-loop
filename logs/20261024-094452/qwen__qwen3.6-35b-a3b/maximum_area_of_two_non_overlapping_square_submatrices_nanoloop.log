class Solution:
    def maxArea(self, mat: list[list[int]]) -> int:
        m, n = len(mat), len(mat[0])
        
        # dp[i][j] = side length of largest all-1s square with bottom-right at (i,j)
        dp = [[0] * n for _ in range(m)]
        for i in range(m):
            for j in range(n):
                if mat[i][j] == 1:
                    if i > 0 and j > 0:
                        dp[i][j] = min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1]) + 1
                    else:
                        dp[i][j] = 1
                else:
                    dp[i][j] = 0
        
        max_k = 0
        for i in range(m):
            for j in range(n):
                max_k = max(max_k, dp[i][j])
        
        if max_k < 1:
            return 0
        
        # Binary search on k
        lo, hi = 1, max_k
        ans = 0
        
        while lo <= hi:
            k = (lo + hi) // 2
            if self.can_find_two(m, n, dp, k):
                ans = k * k
                lo = k + 1
            else:
                hi = k - 1
        
        return ans
    
    def can_find_two(self, m, n, dp, k):
        # valid[i][j] = True if square of size k with top-left at (i,j) is all 1s
        # A square of size k with top-left (i,j) has bottom-right (i+k-1, j+k-1)
        # dp[i+k-1][j+k-1] >= k means such a square exists
        valid = [[False] * n for _ in range(m)]
        for i in range(m - k + 1):
            for j in range(n - k + 1):
                if dp[i + k - 1][j + k - 1] >= k:
                    valid[i][j] = True
        
        # Create 2D prefix sum of valid array
        prefix = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(1, m + 1):
            for j in range(1, n + 1):
                prefix[i][j] = valid[i-1][j-1] + prefix[i-1][j] + prefix[i][j-1] - prefix[i-1][j-1]
        
        def count_rect(r1, c1, r2, c2):
            # Count valid squares in rectangle [r1, r2] x [c1, c2]
            if r1 > r2 or c1 > c2:
                return 0
            r1 = max(0, r1)
            c1 = max(0, c1)
            r2 = min(m - k, r2)
            c2 = min(n - k, c2)
            if r1 > r2 or c1 > c2:
                return 0
            return prefix[r2+1][c2+1] - prefix[r1][c2+1] - prefix[r2+1][c1] + prefix[r1][c1]
        
        total_valid = count_rect(0, 0, m - k, n - k)
        if total_valid < 2:
            return False
        
        for i in range(m - k + 1):
            for j in range(n - k + 1):
                if not valid[i][j]:
                    continue
                # Forbidden region: [i, i+k-1] x [j, j+k-1] for bottom-right
                # A square at (r2, c2) overlaps if r2 < i+k and r2+k > i and c2 < j+k and c2+k > j
                # Simplify: r2 in [i-k+1, i+k-1] intersect [0, m-k] and c2 in [j-k+1, j+k-1] intersect [0, n-k]
                # Non-overlapping regions:
                # 1. r2 <= i - k: rows [0, i-k]
                # 2. r2 >= i + k: rows [i+k, m-k]
                # 3. c2 <= j - k: columns [0, j-k]
                # 4. c2 >= j + k: columns [j+k, n-k]
                
                # Check region 1: rows [0, i-k], all columns
                cnt1 = count_rect(0, 0, i - k, n - k)
                if cnt1 > 0:
                    return True
                
                # Check region 2: rows [i+k, m-k], all columns
                cnt2 = count_rect(i + k, 0, m - k, n - k)
                if cnt2 > 0:
                    return True
                
                # Check region 3: all rows, columns [0, j-k]
                cnt3 = count_rect(0, 0, m - k, j - k)
                if cnt3 > 0:
                    return True
                
                # Check region 4: all rows, columns [j+k, n-k]
                cnt4 = count_rect(0, j + k, m - k, n - k)
                if cnt4 > 0:
                    return True
        
        return False
