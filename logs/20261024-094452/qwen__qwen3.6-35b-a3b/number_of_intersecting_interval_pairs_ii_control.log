```python
class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        n = len(intervals)
        if n < 2:
            return 0
        
        # Sort by start time
        intervals.sort(key=lambda x: x[0])
        
        # Coordinate compression for end points
        ends = sorted(set(interval[1] for interval in intervals))
        end_to_rank = {val: i + 1 for i, val in enumerate(ends)}
        m = len(ends)
        
        # Fenwick Tree (Binary Indexed Tree)
        bit = [0] * (m + 1)
        
        def update(i, delta):
            while i <= m:
                bit[i] += delta
                i += i & (-i)
                
        def query(i):
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & (-i)
            return s
        
        import bisect
        
        non_intersecting = 0
        for s, e in intervals:
            # Count how many previous intervals end before s
            # Find rank of largest value < s
            # bisect_left returns index where s could be inserted while maintaining order
            # all values to the left are < s
            idx = bisect.bisect_left(ends, s)
            # The ranks for values < s are 1 to idx
            if idx > 0:
                non_intersecting += query(idx)
            
            # Add current end point to BIT
            rank = end_to_rank[e]
            update(rank, 1)
            
        total_pairs = n * (n - 1) // 2
        return total_pairs - non_intersecting
```
