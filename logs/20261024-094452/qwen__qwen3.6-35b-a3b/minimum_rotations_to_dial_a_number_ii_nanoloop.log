```python
class Solution:
    def minRotations(self, n: int, s: str) -> int:
        def cost(a, b):
            return min(abs(a - b), 10 - abs(a - b))
        
        # Precompute prefix costs
        # prefix_cost[i] = cost to dial s[0..i-1] starting from 0
        prefix_cost = [0] * (n + 1)
        current_pos = 0
        for i in range(n):
            d = int(s[i])
            prefix_cost[i+1] = prefix_cost[i] + cost(current_pos, d)
            current_pos = d
        
        # Precompute suffix internal costs and sums
        # suffix_internal[j] = cost(s[j+1], s[j])
        suffix_internal = [0] * n
        for j in range(n-2, -1, -1):
            suffix_internal[j] = cost(int(s[j+1]), int(s[j]))
        
        # suffix_sum[k] = sum(suffix_internal[j] for j from k to n-2)
        suffix_sum = [0] * (n + 1)
        for j in range(n-2, -1, -1):
            suffix_sum[j] = suffix_sum[j+1] + suffix_internal[j]
        
        ans = float('inf')
        
        # No reversal
        ans = min(ans, prefix_cost[n])
        
        # Reversal at index k
        for k in range(n):
            if k == 0:
                start = 0
            else:
                start = int(s[k-1])
            
            d_end = int(s[n-1])
            total = prefix_cost[k] + cost(start, d_end) + suffix_sum[k]
            ans = min(ans, total)
        
        return ans
```
