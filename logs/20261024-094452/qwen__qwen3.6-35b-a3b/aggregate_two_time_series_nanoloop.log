class Solution:
    def aggregateTimeSeries(self, series1: list[list[int]], series2: list[list[int]]) -> list[list[int]]:
        # Get all unique timestamps from both series
        all_timestamps = set()
        for ts, val in series1:
            all_timestamps.add(ts)
        for ts, val in series2:
            all_timestamps.add(ts)
        
        sorted_timestamps = sorted(all_timestamps)
        
        def get_value_at(series, timestamp):
            """Find the value at or after the given timestamp using the next available rule."""
            # Binary search for the first entry with timestamp >= timestamp
            lo, hi = 0, len(series)
            while lo < hi:
                mid = (lo + hi) // 2
                if series[mid][0] >= timestamp:
                    hi = mid
                else:
                    lo = mid + 1
            if lo < len(series):
                return series[lo][1]
            return 0
        
        result = []
        for ts in sorted_timestamps:
            val1 = get_value_at(series1, ts)
            val2 = get_value_at(series2, ts)
            result.append([ts, val1 + val2])
        
        return result
