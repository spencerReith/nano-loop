class Solution:
    def maxSum(self, nums: list[int], k: int, mul: int) -> int:
        # Select the top k largest elements
        top_k = sorted(nums, reverse=True)[:k]
        
        # Precompute prefix sums
        prefix_sum = [0] * (k + 1)
        prefix_weighted_sum = [0] * (k + 1)
        for i in range(k):
            prefix_sum[i + 1] = prefix_sum[i] + top_k[i]
            prefix_weighted_sum[i + 1] = prefix_weighted_sum[i] + i * top_k[i]
        
        best = 0
        for r in range(k + 1):
            total = mul * prefix_sum[r] - prefix_weighted_sum[r] + (prefix_sum[k] - prefix_sum[r])
            if total > best:
                best = total
        
        return best
```

This is O(n log n) due to sorting, which is fine.

