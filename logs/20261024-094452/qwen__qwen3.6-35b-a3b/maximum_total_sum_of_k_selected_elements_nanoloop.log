class Solution:
    def maxSum(self, nums: list[int], k: int, mul: int) -> int:
        # Select the top k largest elements
        top_k = sorted(nums, reverse=True)[:k]
        
        best = 0
        # Try all possible numbers of elements to multiply (from 0 to k)
        for r in range(k + 1):
            total = 0
            for i in range(r):
                # Multiply the i-th largest element by (mul - i)
                total += top_k[i] * (mul - i)
            for i in range(r, k):
                # Just add the remaining elements
                total += top_k[i]
            if total > best:
                best = total
        
        return best
```

