class Solution:
    def maxPrimeSubset(self, n: int, s: int) -> list[int]:
        # Generate primes <= n using sieve
        if n < 2:
            return []
        
        primes = []
        is_prime = [True] * (n + 1)
        is_prime[0] = is_prime[1] = False
        for i in range(2, n + 1):
            if is_prime[i]:
                primes.append(i)
                for j in range(i * i, n + 1, i):
                    is_prime[j] = False
        
        if not primes:
            return []
        
        # dp[j] = best subset (tuple) that sums to exactly j
        # "best" means: among subsets with sum j, the one with fewest elements,
        # and among those, the lexicographically smallest
        dp = [None] * (s + 1)
        dp[0] = ()  # empty subset with sum 0
        
        for prime in primes:
            # Process in reverse to avoid using the same prime twice
            for j in range(s, prime - 1, -1):
                if dp[j - prime] is not None:
                    new_subset = dp[j - prime] + (prime,)
                    # Sort the subset to maintain increasing order
                    new_subset = tuple(sorted(new_subset))
                    
                    if dp[j] is None:
                        dp[j] = new_subset
                    else:
                        # Compare: first by number of elements (fewer is better),
                        # then by lexicographic order
                        existing = dp[j]
                        if (len(new_subset), new_subset) < (len(existing), existing):
                            dp[j] = new_subset
        
        # Find the best among all dp[j] for j from 0 to s
        # We want max sum, then min elements, then lex smallest
        best = None
        for j in range(s, -1, -1):
            if dp[j] is not None:
                best = dp[j]
                break
        
        if best is None or len(best) == 0:
            return []
        
        return list(best)
