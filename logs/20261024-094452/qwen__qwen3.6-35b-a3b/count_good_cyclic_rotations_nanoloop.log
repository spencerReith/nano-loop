```python
class Solution:
    def countGoodRotations(self, nums: list[int]) -> int:
        n = len(nums)
        half = n // 2
        
        # Compute prefix sums for the original array
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + nums[i]
        
        def sum_range(start, length):
            """Sum of length elements starting at index start (0-indexed, in the original array, with wrap-around)"""
            # Normalize start to be within [0, n-1]
            start = start % n
            end = start + length
            if end <= n:
                return prefix[end] - prefix[start]
            else:
                # Wraps around
                return prefix[n] - prefix[start] + prefix[end - n]
        
        count = 0
        for k in range(n):
            first_sum = sum_range(k, half)
            second_sum = sum_range(k + half, half)
            if first_sum > second_sum:
                count += 1
        
        return count
