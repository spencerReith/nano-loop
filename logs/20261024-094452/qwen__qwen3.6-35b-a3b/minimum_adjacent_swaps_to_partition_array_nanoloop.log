Now I need to implement this efficiently. Computing inversions can be done in O(n log n) using merge sort or a Fenwick tree / BIT.

```python
class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        MOD = 10**9 + 7
        
        # Determine the group of each element
        groups = []
        for x in nums:
            if x < a:
                groups.append(0)
            elif x <= b:
                groups.append(1)
            else:
                groups.append(2)
        
        # Count how many of each group
        c0 = groups.count(0)
        c1 = groups.count(1)
        c2 = groups.count(2)
        
        # Assign target positions
        # For group 0: positions 0 to c0-1
        # For group 1: positions c0 to c0+c1-1
        # For group 2: positions c0+c1 to n-1
        # Within each group, maintain relative order
        
        target = [0] * n
        count = [0, 0, 0]
        for i, g in enumerate(groups):
            if g == 0:
                target[i] = count[g]
                count[g] += 1
            elif g == 1:
                target[i] = c0 + count[g]
                count[g] += 1
            else:
                target[i] = c0 + c1 + count[g]
                count[g] += 1
        
        # Count inversions in target
        # Using merge sort to count inversions in O(n log n)
        def count_inversions(arr):
            if len(arr) <= 1:
                return 0
            mid = len(arr) // 2
            left = arr[:mid]
            right = arr[mid:]
            inversions = count_inversions(left) + count_inversions(right)
            
            i = j = k = 0
            while i < len(left) and j < len(right):
                if left[i] <= right[j]:
                    arr[k] = left[i]
                    i += 1
                else:
                    arr[k] = right[j]
                    inversions += len(left) - i
                    j += 1
                k += 1
            
            while i < len(left):
                arr[k] = left[i]
                i += 1
                k += 1
            
            while j < len(right):
                arr[k] = right[j]
                j += 1
                k += 1
            
            return inversions
        
        return count_inversions(target[:]) % MOD
```

