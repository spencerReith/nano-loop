class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        MOD = 10**9 + 7
        
        # Determine the group of each element
        groups = []
        for x in nums:
            if x < a:
                groups.append(0)
            elif x <= b:
                groups.append(1)
            else:
                groups.append(2)
        
        # Count how many of each group
        c0 = groups.count(0)
        c1 = groups.count(1)
        c2 = groups.count(2)
        
        # Target: first c0 positions are 0, next c1 are 1, last c2 are 2
        # Minimum swaps is the number of inversions in the groups array when sorting by group
        # For three-way partition, we can compute this by counting pairs that are out of order
        
        # An inversion is a pair (i, j) with i < j but groups[i] > groups[j] in terms of desired order
        # Desired order: 0 < 1 < 2, so inversions are:
        # - (0, 1) where 0 appears after 1 in the desired sense... no wait
        # Actually, inversions are pairs (i, j) with i < j such that groups[i] should come after groups[j]
        # Since we want 0s first, then 1s, then 2s, an inversion is when groups[i] > groups[j] for i < j
        
        # Number of inversions:
        # Pairs of (1, 0) where 1 comes before 0: these need to be swapped
        # Pairs of (2, 0) where 2 comes before 0: these need to be swapped  
        # Pairs of (2, 1) where 2 comes before 1: these need to be swapped
        
        # We can compute this efficiently:
        ans = 0
        count1 = 0  # count of 1s seen so far
        count2 = 0  # count of 2s seen so far
        
        for g in groups:
            if g == 0:
                # Every 1 and 2 before this 0 is an inversion
                ans += count1 + count2
            elif g == 1:
                count1 += 1
            elif g == 2:
                count2 += 1
        
        return ans % MOD
```

