```python
class Solution:
    def countSpecialIntegers(self, nums: list[int]) -> int:
        from collections import defaultdict
        
        # Collect all indices for each number
        indices_map = defaultdict(list)
        for i, num in enumerate(nums):
            indices_map[num].append(i)
        
        count = 0
        for num, indices in indices_map.items():
            # Need at least 3 occurrences
            if len(indices) < 3:
                continue
            
            # Check if all indices are equally spaced
            # Calculate the common difference from first two
            diff = indices[1] - indices[0]
            
            is_special = True
            for j in range(2, len(indices)):
                if indices[j] - indices[j-1] != diff:
                    is_special = False
                    break
            
            if is_special:
                count += 1
        
        return count
```
