```python
class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        from collections import defaultdict
        freq = defaultdict(int)
        left = 0
        max_len = 0
        n = len(nums)
        
        # Handle edge case
        if n == 0:
            return 0
            
        for right in range(n):
            x = nums[right]
            # Check if adding x is valid
            while True:
                valid = True
                # Check1: look for two distinct elements that sum to x
                for a in range(1, x):
                    b = x - a
                    if a in freq:
                        if a != b:
                            if b in freq:
                                valid = False
                                break
                        else: # a == b
                            if freq[a] >= 2:
                                valid = False
                                break
                if not valid:
                    break
                # Check2: look for a and a+x in freq
                for a in list(freq.keys()):
                    if (a + x) in freq:
                        valid = False
                        break
                if not valid:
                    break
                # If valid, break the while loop
                break
            # If not valid, shrink from left
            while not valid:
                # Remove nums[left] from freq
                freq[nums[left]] -= 1
                if freq[nums[left]] == 0:
                    del freq[nums[left]]
                left += 1
                # Recheck validity after shrinking
                # Check1
                check1 = True
                for a in range(1, x):
                    b = x - a
                    if a in freq:
                        if a != b:
                            if b in freq:
                                check1 = False
                                break
                        else:
                            if freq[a] >= 2:
                                check1 = False
                                break
                if not check1:
                    # Need to shrink more
                    continue
                # Check2
                check2 = True
                for a in list(freq.keys()):
                    if (a + x) in freq:
                        check2 = False
                        break
                if not check2:
                    continue
                valid = True
                break
                
            # Add x to freq
            freq[x] += 1
            max_len = max(max_len, right - left + 1)
            
        return max_len
```

