```python
class Solution:
    def countTasks(self, tasks: list[int], shifts: list[int]) -> list[int]:
        n = len(tasks)
        ans = []
        curr_task = 0
        remaining = 0  # remaining time needed for current task
        completed_all_prev = False
        
        for shift_time in shifts:
            time_left = shift_time
            
            # If all tasks were completed in the previous shift, restart from task 0
            if completed_all_prev:
                curr_task = 0
                remaining = 0
                completed_all_prev = False
            
            # Apply carry-over time to the current task
            if remaining > 0:
                deduct = min(time_left, remaining)
                time_left -= deduct
                remaining -= deduct
                if remaining == 0:
                    curr_task += 1
            
            # Process remaining shifts time
            while curr_task < n and time_left > 0:
                task_time = tasks[curr_task]
                if time_left >= task_time:
                    time_left -= task_time
                    curr_task += 1
                else:
                    remaining = task_time - time_left
                    time_left = 0
                    break
            
            # Record unfinished tasks
            if curr_task >= n:
                ans.append(0)
                completed_all_prev = True
            else:
                ans.append(n - curr_task)
                completed_all_prev = False
                
        return ans
```
