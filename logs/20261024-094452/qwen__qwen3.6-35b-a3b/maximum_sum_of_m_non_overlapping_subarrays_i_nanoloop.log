```python
class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        
        # Precompute prefix sums for efficient subarray sum calculation
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + nums[i]
        
        # Helper function to get sum of subarray from index start to end (inclusive)
        def get_sum(start, end):
            return prefix[end + 1] - prefix[start]
        
        # dp[i][j] = maximum sum using exactly j subarrays from the first i elements
        # Initialize with a very small number to represent "unreachable"
        NEG_INF = float('-inf')
        dp = [[NEG_INF] * (m + 1) for _ in range(n + 1)]
        
        # Base case: 0 subarrays from 0 elements has sum 0
        dp[0][0] = 0
        
        for i in range(1, n + 1):
            for j in range(m + 1):
                # Option 1: Don't include element i in any new subarray
                dp[i][j] = dp[i - 1][j]
                
                # Option 2: Include a subarray ending at position i with length k (where l <= k <= r)
                if j >= 1:
                    for k in range(l, min(r, i) + 1):
                        # Check if we can form j-1 subarrays from the first i-k elements
                        if dp[i - k][j - 1] != NEG_INF:
                            subarray_sum = get_sum(i - k, i - 1)
                            dp[i][j] = max(dp[i][j], dp[i - k][j - 1] + subarray_sum)
        
        # The answer is the maximum value in dp[n][j] for all j from 1 to m (at least 1 subarray must be selected)
        result = max(dp[n][1:])
        return result
