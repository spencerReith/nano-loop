class Solution:
    def countGoodStrings(self, n: int) -> int:
        MOD = 10**9 + 7
        if n == 1:
            return 2
        if n == 2:
            return 2

        # Fibonacci-like recurrence: G(n) = G(n-1) + G(n-2)
        # G(1) = 2, G(2) = 2
        a, b = 2, 2
        for _ in range(3, n + 1):
            a, b = b, (a + b) % MOD
        return b
```
