class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        from collections import Counter
        
        count = Counter(planks)
        n = len(planks)
        
        # Get all unique target heights to consider
        # Target heights can be:
        # 1. Any existing plank height
        # 2. Any sum of two distinct plank heights
        
        targets = set(count.keys())
        # Also consider sums of pairs
        # But there could be many pairs, so let's be smart
        
        # Actually, the target height must be achievable. Let's consider:
        # - All existing heights
        # - All possible sums of two heights that appear in the array
        
        # Generate all possible target heights
        unique_heights = list(count.keys())
        targets = set(unique_heights)
        
        # For efficiency, since n <= 1000, we can iterate through pairs
        # But O(n^2) pairs could be up to ~500K which is manageable
        
        for i in range(len(unique_heights)):
            for j in range(i, len(unique_heights)):
                targets.add(unique_heights[i] + unique_heights[j])
        
        max_width = 1  # At minimum, we can use one plank
        
        for H in targets:
            # Create a temporary counter without the planks used as-is
            temp_count = Counter(planks)
            
            # Use original planks of height H
            num_original = min(temp_count[H], float('inf'))  # All of them
            if temp_count[H] > 0:
                num_used = temp_count[H]
                temp_count[H] = 0
            else:
                num_used = 0
            
            # Now find pairs in remaining planks that sum to H
            # We need to count maximum disjoint pairs
            
            # Get all remaining heights and their counts
            remaining = temp_count.copy()
            
            # Find pairs
            num_pairs = 0
            heights = list(remaining.keys())
            for h in heights:
                if h == 0:
                    continue
                target_pair = H - h
                if h < target_pair:
                    # Count pairs between h and target_pair
                    if target_pair in remaining:
                        pairs = min(remaining[h], remaining[target_pair])
                        num_pairs += pairs
                        remaining[h] -= pairs
                        remaining[target_pair] -= pairs
                elif h == target_pair:
                    # Pairs within the same height group: h + h = H => h = H/2
                    if H % 2 == 0 and h == H // 2:
                        num_pairs += remaining[h] // 2
                        remaining[h] %= 2
            
            if num_original + num_pairs > max_width:
                max_width = num_original + num_pairs
        
        return max_width
