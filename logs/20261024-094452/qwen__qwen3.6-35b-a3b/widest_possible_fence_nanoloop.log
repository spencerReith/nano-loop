```python
class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        from collections import Counter
        
        count = Counter(planks)
        unique_heights = sorted(count.keys())
        
        # Generate all possible target heights
        targets = set(unique_heights)
        for i in range(len(unique_heights)):
            for j in range(i, len(unique_heights)):
                targets.add(unique_heights[i] + unique_heights[j])
        
        max_width = 1
        
        for H in targets:
            # Work with a copy
            temp_count = Counter(planks)
            
            # Use all original planks of height H
            if temp_count[H] > 0:
                num_used = temp_count[H]
                temp_count[H] = 0
            else:
                num_used = 0
            
            # Find pairs from remaining
            remaining = temp_count.copy()
            num_pairs = 0
            
            heights = list(remaining.keys())
            for h in heights:
                target_pair = H - h
                if h > target_pair:
                    continue  # Already handled when we processed target_pair
                if h == target_pair:
                    # Same height pair: need h + h = H
                    if h * 2 == H:
                        num_pairs += remaining[h] // 2
                elif target_pair in remaining:
                    pairs = min(remaining[h], remaining[target_pair])
                    num_pairs += pairs
            
            if num_used + num_pairs > max_width:
                max_width = num_used + num_pairs
        
        return max_width
