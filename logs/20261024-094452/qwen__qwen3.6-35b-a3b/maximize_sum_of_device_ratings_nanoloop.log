            if len(heap) <= 1:
                return 0
            min1 = heap[0]
            temp = heapq.heappop(heap)
            min2 = heap[0] if heap else min1
            heapq.heappush(heap, temp)
            return min2 - min1
        
        # Function to get the current rating of a device
        def get_rating(heap):
            return heap[0] if heap else 0
        
        # Current ratings
        current_ratings = [get_rating(device_heaps[i]) for i in range(m)]
        
        # Sorted list of (current_rating, device_index)
        # We'll maintain this list sorted by current_rating
        sorted_receivers = sorted([(current_ratings[i], i) for i in range(m)])
        
        # Initial gains
        gain_heap = []
        for i in range(m):
            gain = calculate_gain(device_heaps[i])
            if gain > 0:
                transfer_unit = device_heaps[i][0] if device_heaps[i] else 0
                heapq.heappush(gain_heap, (-gain, i, transfer_unit))
        
        # Track which devices have been used as sources
        used_source = [False] * m
        
        while gain_heap:
            neg_gain, source_idx, transfer_unit = heapq.heappop(gain_heap)
            gain = -neg_gain
            
            if used_source[source_idx]:
                continue
            
            # Recalculate the gain for this device
            actual_gain = calculate_gain(device_heaps[source_idx])
            actual_transfer_unit = device_heaps[source_idx][0] if device_heaps[source_idx] else 0
            
            if actual_gain <= 0:
                continue
            
            gain = actual_gain
            transfer_unit = actual_transfer_unit
            
            used_source[source_idx] = True
            
            # Find the best receiver:
            # 1. If there's a receiver with current_rating <= transfer_unit, pick any (loss=0).
            # 2. Otherwise, pick the receiver with the smallest current_rating (minimize loss).
            
            # Check if there's a receiver with current_rating <= transfer_unit
            # sorted_receivers is sorted by current_rating. Find the first receiver with current_rating > transfer_unit.
            # All receivers before that have current_rating <= transfer_unit.
            idx = bisect_left(sorted_receivers, (transfer_unit, float('inf')))
            # sorted_receivers[idx] is the first with current_rating > transfer_unit, or out of bounds.
            # Receivers 0 to idx-1 have current_rating <= transfer_unit.
            
            best_receiver = -1
            min_loss = float('inf')
            
            if idx > 0:
                # There's at least one receiver with current_rating <= transfer_unit
                # Pick any, say the first one
                best_receiver = sorted_receivers[0][1]
                min_loss = 0
            else:
                # All receivers have current_rating > transfer_unit
                # Pick the one with the smallest current_rating
                if idx < len(sorted_receivers):
                    best_receiver = sorted_receivers[idx][1]
                    min_loss = current_ratings[best_receiver] - transfer_unit
                else:
                    # No receivers? (shouldn't happen if m>=2)
                    continue
            
            # Skip if the best receiver is the source
            if best_receiver == source_idx:
                # Try the next best
                if idx > 1:
                    best_receiver = sorted_receivers[1][1]
                    min_loss = 0
                elif idx < len(sorted_receivers) and idx > 0:
                    best_receiver = sorted_receivers[idx][1]
                    min_loss = current_ratings[best_receiver] - transfer_unit
                else:
                    continue  # No valid receiver
            
            net_gain = gain - min_loss
            if net_gain > 0:
                # Perform the transfer
                # Source: remove minimum
                heapq.heappop(device_heaps[source_idx])
                new_source_rating = get_rating(device_heaps[source_idx])
                current_ratings[source_idx] = new_source_rating
                
                # Receiver: add the transferred unit
                heapq.heappush(device_heaps[best_receiver], transfer_unit)
                new_receiver_rating = get_rating(device_heaps[best_receiver])
                current_ratings[best_receiver] = new_receiver_rating
                
                # Update the sorted_receivers list:
