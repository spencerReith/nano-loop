import heapq

class Solution:
    def maxRatings(self, units: list[list[int]]) -> int:
        m = len(units)
        
        # For each device, create a min-heap of units
        device_heaps = []
        for i in range(m):
            heap = units[i][:]
            heapq.heapify(heap)
            device_heaps.append(heap)
        
        # Function to calculate the gain for a device
        def calculate_gain(heap):
            if len(heap) <= 1:
                return 0
            # Get min and second min
            min1 = heap[0]
            temp = heapq.heappop(heap)
            min2 = heap[0] if heap else min1
            heapq.heappush(heap, temp)
            return min2 - min1
        
        # Function to get the current rating of a device
        def get_rating(heap):
            return heap[0] if heap else 0
        
        # Initial gains
        # Use a max-heap for gains: (-gain, device_idx, transfer_unit)
        gain_heap = []
        for i in range(m):
            gain = calculate_gain(device_heaps[i])
            if gain > 0:
                transfer_unit = device_heaps[i][0] if device_heaps[i] else 0
                heapq.heappush(gain_heap, (-gain, i, transfer_unit))
        
        # Current ratings
        current_ratings = [get_rating(device_heaps[i]) for i in range(m)]
        
        # Track which devices have been used as sources
        used_source = [False] * m
        
        while gain_heap:
            neg_gain, source_idx, transfer_unit = heapq.heappop(gain_heap)
            gain = -neg_gain
            
            if used_source[source_idx]:
                continue
            
            # Recalculate the gain for this device (in case it changed)
            actual_gain = calculate_gain(device_heaps[source_idx])
            actual_transfer_unit = device_heaps[source_idx][0] if device_heaps[source_idx] else 0
            
            if actual_gain <= 0:
                continue
            
            # Use the actual values
            gain = actual_gain
            transfer_unit = actual_transfer_unit
            
            used_source[source_idx] = True
            
            # Find the best receiver
            best_receiver = -1
            min_loss = float('inf')
            
            for receiver_idx in range(m):
                if receiver_idx == source_idx:
                    continue
                if not device_heaps[receiver_idx]:
                    loss = 0
                else:
                    loss = max(0, current_ratings[receiver_idx] - transfer_unit)
                if loss < min_loss:
                    min_loss = loss
                    best_receiver = receiver_idx
            
            net_gain = gain - min_loss
            if net_gain > 0:
                # Perform the transfer
                # Source: remove minimum
                heapq.heappop(device_heaps[source_idx])
                current_ratings[source_idx] = get_rating(device_heaps[source_idx])
                
                # Receiver: add the transferred unit
                heapq.heappush(device_heaps[best_receiver], transfer_unit)
                current_ratings[best_receiver] = get_rating(device_heaps[best_receiver])
                
                # Update gains for all devices
                # This is expensive: O(m log m) per transfer, and there are at most m transfers.
                # Total: O(m^2 log m), which might be too slow for m=10^5.
                # But m*n <= 2*10^5, so m can be up to 10^5 only if n=1.
                # If n=1, there are no gains (since len(heap)<=1), so no transfers.
                # If n>=2, m <= 10^5, but m*n <= 2*10^5, so m <= 10^5 and n <= 2.
                # Wait, no: m*n <= 2*10^5, so if m=10^5, n<=2. If n=2, m<=10^5.
                # So m can be up to 10^5.
                # Recalculating gains for all devices after each transfer is O(m), and there are at most m transfers.
                # Total: O(m^2), which is too slow for m=10^5.
                
                # Instead, let's only update the gain for the receiver, since that's the only device whose state changed besides the source.
                receiver_idx = best_receiver
                if not used_source[receiver_idx]:
