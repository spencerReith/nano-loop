class Solution:
    def maxRatings(self, units: list[list[int]]) -> int:
        m = len(units)
        
        # For each device, get sorted units and compute initial rating
        device_sorted = []
        ratings = []
        for i in range(m):
            sorted_units = sorted(units[i])
            device_sorted.append(sorted_units)
            ratings.append(sorted_units[0])
        
        # Calculate potential gain for each device if we remove its minimum
        gains = []
        for i in range(m):
            if len(device_sorted[i]) > 1:
                gain = device_sorted[i][1] - device_sorted[i][0]
                if gain > 0:
                    gains.append((gain, i, device_sorted[i][0]))
        
        # Sort by gain descending
        gains.sort(reverse=True)
        
        # Current ratings
        current_ratings = list(ratings)
        
        # Track which devices have been used as sources
        used_source = [False] * m
        
        for gain, source_idx, transfer_unit in gains:
            if used_source[source_idx]:
                continue
            used_source[source_idx] = True
            
            # Find the best receiver: minimize loss = max(0, current_ratings[receiver] - transfer_unit)
            # We want to maximize (current_ratings[receiver] - transfer_unit) but capped at 0... 
            # Actually, loss = max(0, current_ratings[receiver] - transfer_unit)
            # To minimize loss, we want current_ratings[receiver] <= transfer_unit (loss=0), or as close as possible.
            
            best_receiver = -1
            min_loss = float('inf')
            
            for receiver_idx in range(m):
                if receiver_idx == source_idx:
                    continue
                loss = max(0, current_ratings[receiver_idx] - transfer_unit)
                if loss < min_loss:
                    min_loss = loss
                    best_receiver = receiver_idx
            
            # Check if net gain is positive
            net_gain = gain - min_loss
            if net_gain > 0:
                # Perform the transfer
                current_ratings[source_idx] += gain  # Source's new rating
                if min_loss > 0:
                    current_ratings[best_receiver] = transfer_unit  # New rating is transfer_unit
                # If min_loss == 0, receiver's rating doesn't change
        
        return sum(current_ratings)
