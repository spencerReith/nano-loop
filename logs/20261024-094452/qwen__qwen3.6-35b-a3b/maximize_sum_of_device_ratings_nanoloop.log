import heapq

class Solution:
    def maxRatings(self, units: list[list[int]]) -> int:
        m = len(units)
        
        # For each device, create a min-heap of units
        device_heaps = []
        for i in range(m):
            heap = units[i][:]  # Copy the list
            heapq.heapify(heap)
            device_heaps.append(heap)
        
        # Function to get the minimum and second minimum of a device
        def get_min_second(heap):
            if len(heap) == 0:
                return (0, 0)  # Empty device, rating 0
            min1 = heap[0]
            # Get second min
            temp = heapq.heappop(heap)
            if len(heap) == 0:
                # Only one unit
                heapq.heappush(heap, temp)
                return (min1, min1)  # No second min, gain would be 0
            min2 = heap[0]
            heapq.heappush(heap, temp)
            return (min1, min2)
        
        # Calculate initial gains
        # gains: (gain, device_idx, transfer_unit)
        gains = []
        for i in range(m):
            min1, min2 = get_min_second(device_heaps[i])
            gain = min2 - min1
            if gain > 0:
                gains.append((gain, i, min1))
        
        # Sort by gain descending
        gains.sort(reverse=True)
        
        # Current ratings
        # Rating of a device is its minimum
        current_ratings = [device_heaps[i][0] if device_heaps[i] else 0 for i in range(m)]
        
        # Track which devices have been used as sources
        used_source = [False] * m
        
        for gain, source_idx, transfer_unit in gains:
            if used_source[source_idx]:
                continue
            used_source[source_idx] = True
            
            # Find the best receiver: minimize loss
            best_receiver = -1
            min_loss = float('inf')
            
            for receiver_idx in range(m):
                if receiver_idx == source_idx:
                    continue
                if not device_heaps[receiver_idx]:
                    loss = 0  # Empty device, adding any unit doesn't change rating (still 0)
                    # Wait, no: if a device is empty, its rating is 0. Adding a unit x makes it [x], rating=x.
                    # So loss = 0 - x = -x? No, loss = current_rating - new_rating = 0 - x = -x. But loss is max(0, ...).
                    # Actually, loss = max(0, current_rating - transfer_unit) = max(0, 0 - x) = 0.
                    # So loss is 0.
                else:
                    loss = max(0, current_ratings[receiver_idx] - transfer_unit)
                if loss < min_loss:
                    min_loss = loss
                    best_receiver = receiver_idx
            
            net_gain = gain - min_loss
            if net_gain > 0:
                # Perform the transfer
                # Source: remove minimum
                heapq.heappop(device_heaps[source_idx])
                # New rating for source: min of remaining, or 0 if empty
                if device_heaps[source_idx]:
                    current_ratings[source_idx] = device_heaps[source_idx][0]
                else:
                    current_ratings[source_idx] = 0
                
                # Receiver: add the transferred unit
                heapq.heappush(device_heaps[best_receiver], transfer_unit)
                # New rating for receiver: min of all units, or 0 if empty (but we're adding, so not empty)
                current_ratings[best_receiver] = device_heaps[best_receiver][0]
                
                # Update gain for the receiver if it's not used as a source
                # Actually, we need to recalculate gains for all devices that haven't been used as sources
                # But this is expensive. Let me think about whether we need to.
        
        return sum(current_ratings)
