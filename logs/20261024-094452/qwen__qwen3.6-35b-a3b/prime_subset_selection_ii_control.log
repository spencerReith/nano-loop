class Solution:
    def maxPrimeSubset(self, n: int, s: int) -> list[int]:
        # Generate all primes <= n
        def get_primes(limit):
            if limit < 2:
                return []
            sieve = [True] * (limit + 1)
            sieve[0] = sieve[1] = False
            for i in range(2, int(limit**0.5) + 1):
                if sieve[i]:
                    for j in range(i*i, limit + 1, i):
                        sieve[j] = False
            return [i for i in range(2, limit + 1) if sieve[i]]
        
        primes = get_primes(n)
        
        if not primes:
            return []
        
        # Filter out primes > s since they can't be included
        primes = [p for p in primes if p <= s]
        
        if not primes:
            return []
        
        # We need to select a subset of primes such that:
        # 1. Sum <= s, maximized
        # 2. Fewest elements among those with max sum
        # 3. Lexicographically smallest (in increasing order) among ties
        
        # This is a variation of the knapsack problem with multiple objectives.
        # Since n, s <= 1000, and the number of primes <= 1000 is 168,
        # we can use dynamic programming.
        
        # Let's define dp[v] = (max_sum_achievable_with_value_v, min_count, best_subset)
        # But storing subsets is expensive. Instead, we can store:
        # dp[v] = (best_count_for_sum_exactly_v, best_lex_order_subset_for_that_count)
        # But we need to track the actual sum achieved. Actually, we want max sum <= s.
        
        # Alternative approach: 
        # dp[v] stores a tuple (min_count, lexicographically_smallest_subset) for achieving exactly sum v.
        # Then at the end, we look at all v from s down to 0, find the max v where dp[v] is valid,
        # and among those with the same max v (which is just one value - the max achievable), 
        # we pick the one with min count and lex smallest subset.
        
        # Initialize dp: dp[v] = None means not achievable
        # dp[0] = (0, [])  # 0 count, empty subset for sum 0
        
        # We'll iterate through each prime and update the dp table.
        # To avoid using the same prime multiple times, we iterate backwards or use a copy.
        
        INF = float('inf')
        
        # dp[v] = (min_count, subset_as_tuple) for achieving sum exactly v
        # Initialize with None for unachievable
        dp = [None] * (s + 1)
        dp[0] = (0, ())  # sum 0 achieved with 0 elements, empty tuple
        
        for p in primes:
            # Iterate backwards to avoid using the same prime multiple times in one iteration
            for v in range(s, p - 1, -1):
                if dp[v - p] is not None:
                    prev_count, prev_subset = dp[v - p]
                    new_count = prev_count + 1
                    new_subset = prev_subset + (p,)  # tuple, primes are added in increasing order if we process them in order
                    
                    if dp[v] is None:
                        dp[v] = (new_count, new_subset)
                    else:
                        curr_count, curr_subset = dp[v]
                        # Compare: first by count (minimize), then by lex order of subset
                        if new_count < curr_count:
                            dp[v] = (new_count, new_subset)
                        elif new_count == curr_count:
                            # Lex comparison: both are tuples of increasing numbers
                            # Since we process primes in increasing order, and we append,
                            # the subsets should naturally be in increasing order.
                            # For lex comparison of two sorted tuples, standard tuple comparison works.
                            if new_subset < curr_subset:
                                dp[v] = (new_count, new_subset)
        
        # Find the maximum sum v (<= s) that is achievable
        max_sum = -1
        for v in range(s, -1, -1):
            if dp[v] is not None:
                max_sum = v
                break
        
        if max_sum == -1 or max_sum == 0:
            # Only sum 0 is achievable, which means no primes selected.
            # The problem says "non-empty subset", so return empty.
            return []
        
        _, best_subset = dp[max_sum]
        return list(best_subset)
