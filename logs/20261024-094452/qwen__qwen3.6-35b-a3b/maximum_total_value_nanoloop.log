class Solution:
    def maxTotalValue(self, value: list[int], decay: list[int], m: int) -> int:
        MOD = 10**9 + 7
        n = len(value)
        
        # For each index, compute max selections where marginal value is positive
        k_max = []
        for i in range(n):
            # marginal value of k-th selection (1-indexed) is value[i] - decay[i]*(k-1)
            # positive when k-1 < value[i]/decay[i], i.e., k <= (value[i]-1)//decay[i] + 1
            if value[i] <= 0:
                k_max.append(0)
            else:
                km = (value[i] - 1) // decay[i] + 1
                k_max.append(km)
        
        total_k_max = sum(k_max)
        
        if m >= total_k_max:
            # Take all useful selections
            total = 0
            for i in range(n):
                k = k_max[i]
                if k > 0:
                    # Sum of arithmetic sequence: k * value[i] - decay[i] * k*(k-1)/2
                    total += k * value[i] - decay[i] * k * (k - 1) // 2
            return total % MOD
        
        # Binary search for threshold T
        # We want largest T such that count(T) >= m
        # count(T) = sum over i of min(k_max[i], max(0, (value[i] - T) // decay[i] + 1))
        
        low = 0  # Minimum possible marginal value could be 0 or negative, but we only care about positive ones
        high = max(value)  # Maximum marginal value is max(value)
        
        def count_ge(T):
            """Count number of marginal values >= T"""
            cnt = 0
            for i in range(n):
                if value[i] < T:
                    continue
                # Marginal value of k-th selection: value[i] - decay[i]*(k-1) >= T
                # k-1 <= (value[i] - T) / decay[i]
                # k <= (value[i] - T) // decay[i] + 1
                k_count = (value[i] - T) // decay[i] + 1
                k_count = max(0, min(k_max[i], k_count))
                cnt += k_count
            return cnt
        
        # Binary search: find largest T such that count_ge(T) >= m
        while low < high:
            mid = (low + high + 1) // 2
            if count_ge(mid) >= m:
                low = mid
            else:
                high = mid - 1
        
        T_star = low
        
        # Now select all marginal values > T_star, and some equal to T_star to reach m
        # First, count how many are > T_star and their sum
        selected = 0
        total_value = 0
        
        for i in range(n):
            if value[i] <= T_star:
                continue
            # Count selections with marginal value > T_star
            # value[i] - decay[i]*(k-1) > T_star
            # k-1 < (value[i] - T_star) / decay[i]
            # k-1 <= (value[i] - T_star - 1) // decay[i]
            # k <= (value[i] - T_star - 1) // decay[i] + 1
            
            k_above = (value[i] - T_star - 1) // decay[i] + 1
            k_above = max(0, min(k_max[i], k_above))
            
            if k_above > 0:
                # Sum of marginal values for first k_above selections
                # Sum = k_above * value[i] - decay[i] * (k_above * (k_above - 1) // 2)
                s = k_above * value[i] - decay[i] * k_above * (k_above - 1) // 2
                total_value += s
                selected += k_above
        
        # Now select enough marginal values equal to T_star to reach m
        remaining = m - selected
        if remaining > 0:
            total_value += remaining * T_star
        
        return total_value % MOD
