class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        for i in range(n):
            for j in range(i + 1, n):
                if nums[i] < nums[j]:
                    # Check if there exists k in (i, j) such that nums[i] < nums[k] < nums[j]
                    is_shadow = True
                    for k in range(i + 1, j):
                        if nums[i] < nums[k] < nums[j]:
                            is_shadow = False
                            break
                    if is_shadow:
                        count += 1
        return count
```

