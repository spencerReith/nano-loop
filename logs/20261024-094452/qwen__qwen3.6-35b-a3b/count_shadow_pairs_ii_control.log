class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        for i in range(n):
            for j in range(i + 1, n):
                if nums[i] < nums[j]:
                    # Check for any k in (i, j) with nums[i] < nums[k] < nums[j]
                    if not any(nums[i] < nums[k] < nums[j] for k in range(i + 1, j)):
                        count += 1
        return count
```

