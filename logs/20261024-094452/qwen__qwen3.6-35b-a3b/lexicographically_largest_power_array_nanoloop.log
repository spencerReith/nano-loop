class Solution:
    def largestPower(self, nums: list[int]) -> list[int]:
        nums.sort(reverse=True)
        n = len(nums)
        power = [0] * 15
        
        for b in range(14, -1, -1):
            count = 0
            for x in nums:
                if (x >> b) & 1:
                    count += 1
                else:
                    break
            power[14 - b] = count
        
        return power
```

