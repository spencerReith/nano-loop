class Solution:
    def maxEqualPairs(self, nums: list[int]) -> int:
        n = len(nums)
        
        # Calculate baseline: count of adjacent equal pairs
        baseline = 0
        for i in range(n - 1):
            if nums[i] == nums[i + 1]:
                baseline += 1
        
        # Count adjacent pairs: for each (x, y) where x and y are distinct,
        # count how many times (x, y) and (y, x) appear as adjacent pairs
        # We only care about y that are adjacent to x
        
        # For each x, find all y values that are adjacent to x
        # and count the number of (x,y) and (y,x) pairs
        
        from collections import defaultdict
        
        # adjacent_pairs[x] will store a dict of {y: count of (x,y) pairs}
        adjacent_pairs = defaultdict(lambda: defaultdict(int))
        
        for i in range(n - 1):
            x, y = nums[i], nums[i + 1]
            if x != y:
                adjacent_pairs[x][y] += 1
        
        max_count = baseline  # Case of doing nothing
        
        for x in adjacent_pairs:
            for y, count_xy in adjacent_pairs[x].items():
                # Count (y, x) pairs
                count_yx = adjacent_pairs[y][x] if y in adjacent_pairs else 0
                gain = count_xy + count_yx
                max_count = max(max_count, baseline + gain)
        
        return max_count
