Let's code this.

```python
import bisect

class Solution:
    def maximumMEX(self, nums: list[int]) -> list[int]:
        n = len(nums)
        
        # Step 1: Precompute suffix_mex[i] for all i from 0 to n
        # suffix_mex[i] is the MEX of nums[i:]
        suffix_mex = [0] * (n + 1)
        freq = set()
        mex = 0
        # Process from right to left
        for i in range(n - 1, -1, -1):
            freq.add(nums[i])
            if nums[i] == mex:
                while mex in freq:
                    mex += 1
            suffix_mex[i] = mex
        suffix_mex[n] = 0  # MEX of empty array is 0
        
        # Step 2: Precompute occurrences of each number
        occ = {}
        for idx, num in enumerate(nums):
            if num not in occ:
                occ[num] = []
            occ[num].append(idx)
        
        result = []
        i = 0
        while i < n:
            max_m = suffix_mex[i]
            if max_m == 0:
                # Take the first element
                result.append(0)
                i += 1
            else:
                # Find the smallest k such that nums[i:i+k] contains 0..max_m-1
                # This is equivalent to finding the maximum first occurrence of each v in 0..max_m-1 in the suffix starting at i
                max_idx = i
                for v in range(max_m):
                    if v in occ:
                        # Find the first index >= i in occ[v]
                        indices = occ[v]
                        pos = bisect.bisect_left(indices, i)
                        if pos < len(indices):
                            if indices[pos] > max_idx:
                                max_idx = indices[pos]
                        else:
                            # This should not happen because suffix_mex[i] == max_m implies 0..max_m-1 are in nums[i:]
                            pass
                    else:
                        # This should not happen
                        pass
                k = max_idx - i + 1
                result.append(max_m)
                i += k
                
        return result
