```python
from typing import List

class Solution:
    def maxValidPairSum(self, nums: List[int], k: int) -> int:
        n = len(nums)
        max_i_val = nums[0]
        ans = float('-inf')
        for j in range(k, n):
            if nums[j-k] > max_i_val:
                max_i_val = nums[j-k]
            current = max_i_val + nums[j]
            if current > ans:
                ans = current
        return ans
