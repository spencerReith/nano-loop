class Solution:
    def findColoredRoot(self, edges: list[list[int]], colors: str) -> int:
        n = len(colors)
        degree = [0] * n
        indegree = [0] * n
        
        nxt = {'R': 'B', 'B': 'W', 'W': 'R'}
        
        for u, v in edges:
            degree[u] += 1
            degree[v] += 1
            c_u = colors[u]
            c_v = colors[v]
            if c_u == c_v:
                return -1
            if c_v == nxt[c_u]:
                indegree[v] += 1
            else:
                indegree[u] += 1
        
        zero_indegree = [i for i in range(n) if indegree[i] == 0]
        if len(zero_indegree) != 1:
            return -1
        
        r = zero_indegree[0]
        if degree[r] > 2:
            return -1
        
        return r
