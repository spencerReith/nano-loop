from collections import Counter

class Solution:
    def validSubarrays(self, nums: list[int], k: int, queries: list[list[int]]) -> list[bool]:
        ans = []
        for l, r in queries:
            sub = nums[l:r+1]
            cnt = Counter(sub)
            distinct = len(cnt)
            all_even = all(v % 2 == 0 for v in cnt.values())
            ans.append(distinct == k and all_even)
        return ans
