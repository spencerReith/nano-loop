class Solution:
    def divisibleGame(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        
        # collect all divisors > 1 of all numbers
        candidates = set()
        for v in nums:
            d = 2
            while d * d <= v:
                if v % d == 0:
                    candidates.add(d)
                    while v % d == 0:
                        v //= d
                d += 1 if d == 2 else 2  # skip even numbers after 2
            if v > 1:
                candidates.add(v)
        
        best_diff = None
        best_k = None
        
        for k in candidates:
            cur = 0
            for x in nums:
                if x % k == 0:
                    cur += x
                else:
                    cur -= x
            # we want maximum cur, and for ties smallest k
            if best_diff is None or cur > best_diff or (cur == best_diff and k < best_k):
                best_diff = cur
                best_k = k
        
        ans = (best_diff % MOD) * best_k % MOD
        return ans

