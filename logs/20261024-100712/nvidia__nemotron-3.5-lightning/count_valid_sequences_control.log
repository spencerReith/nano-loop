class Solution:
    def countValidSequences(self, n: int, k: int) -> int:
        MOD = 10**9 + 7

        # ---------- Stirling numbers of the second kind ----------
        # S[n][k] = number of partitions of n labeled items into k nonempty unlabeled subsets
        # We only need S[i][j] for 0 <= i <= n, 1 <= j <= k
        # Compute recurrence S[i][j] = j * S[i-1][j] + S[i-1][j-1]

        # dp[j] will hold S[i][j] for the current i
        dp = [0] * (k + 1)
        dp[0] = 1  # S[0][0] = 1
        for i in range(1, n + 1):
            # update j from min(i, k) down to 1
            limit = min(i, k)
            for j in range(limit, 0, -1):
                dp[j] = (j * dp[j] + dp[j - 1]) % MOD

        S = dp  # S[j] = Stirling numbers S[n][j] after the loop? Wait we need S[n][k] but we overwrite...
        # Actually after the loop dp holds S[n][j] for all j because we iterated i from 1 to n.
        # However we need S[n][k] but also intermediate sums. Let's keep a 2D array or compute differently.
        # Simpler: keep a 2D list S[i][j] only up to needed sizes.

        # Let's redo with full table for clarity, n <= 5e5, k <= n but k can be up to n.
        # However memory O(n*k) might be too big if k ~ n = 5e5 -> 2.5e11 impossible.
        # We need a smarter way.

        # Observation: We need number of compositions of n into k positive parts with at least one even.
        # Total compositions of n into k positive parts = C(n-1, k-1) (stars and bars).
        # Number of compositions where all parts are odd = ?

        # A part is odd => each part >= 1 and odd => write part = 2*x + 1, x >= 0.
        # Sum of k odd parts = 2*(sum x_i) + k = n  => sum x_i = (n - k)/2.
        # This requires n - k even. If n - k is odd, zero odd-part compositions.
        # If n - k even, number of solutions for x_i >=0 summing to (n-k)/2 is C((n-k)/2 + k - 1, k - 1) = C((n+k)/2 - 1, k-1).

        # Thus:
        # total = C(n-1, k-1)
        # all_odd = if (n - k) % 2 == 0: C((n+k)//2 - 1, k-1) else 0
        # answer = (total - all_odd) % MOD

        # compute nCk modulo MOD with precomputed factorials up to n (max 5e5)
        fact = [1] * (n + 1)
        for i in range(1, n + 1):
            fact[i] = fact[i-1] * i % MOD
        inv_fact = [1] * (n + 1)
        inv_fact[n] = pow(fact[n], MOD-2, MOD)
        for i in range(n, 0, -1):
            inv_fact[i-1] = inv_fact[i] * i % MOD

        def nCr(N, R):
            if R < 0 or R > N:
                return 0
            return fact[N] * inv_fact[R] % MOD * inv_fact[N-R] % MOD

        total = nCr(n - 1, k - 1)

        if (n - k) % 2 == 0:
            # number of compositions with all odd parts
            # x_i >=0 sum to (n-k)//2 -> stars and bars: C((n-k)//2 + k - 1, k-1)
            # which equals C((n+k)//2 - 1, k-1)
            all_odd = nCr((n + k) // 2 - 1, k - 1)
        else:
            all_odd = 0

        ans = (total - all_odd) % MOD
        return ans
