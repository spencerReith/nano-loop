class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        # Pairwise cross-multiply to avoid floating point inaccuracies.
        # x / y <= a / b  <=>  x * b <= a * y
        n = len(nums)
        ans = 0
        # For each possible left bound, expand the right bound and keep running counts.
        for left in range(n):
            even = 0
            odd = 0
            for right in range(left, n):
                if nums[right] % 2 == 0:
                    even += 1
                else:
                    odd += 1
                # Subarray must contain at least one odd element.
                if odd > 0 and even * b <= a * odd:
                    ans += 1
        return ans
