class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        # pref[i] = (nums[0] + ... + nums[i-1]) % k, pref[0] = 0
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = (pref[i] + nums[i]) % k

        # need[i] = (2 * nums[i]) % k  -- the change in sum modulo k when nums[i] is negated
        need = [(2 * nums[i]) % k for i in range(n)]

        # first_occ[rem] = smallest index l such that pref[l] == rem (among l < current r)
        # initially only pref[0] = 0 at index 0 is known
        first_occ = [float('inf')] * k
        first_occ[0] = 0

        # max_need[t] = largest index i < current r such that need[i] == t
        # (used to ensure the negated element lies within the subarray [l, r))
        max_need = [-1] * k

        # active list: t values for which max_need[t] >= 0 (at least one such element seen so far)
        active = []
        in_active = [False] * k

        ans = 0

        for r in range(1, n + 1):
            v = need[r - 1]

            # update max_need with the new element nums[r-1]
            if r - 1 > max_need[v]:
                if max_need[v] == -1:
                    max_need[v] = r - 1
                    in_active[v] = True
                    active.append(v)
                else:
                    max_need[v] = r - 1

            # Case 1: no negation needed -- subarray sum already divisible by k
            target1 = pref[r]
            l1 = first_occ[target1]
            if l1 < r:
                length = r - l1
                if length > ans:
                    ans = length
                    if ans == n:
                        return ans

            # Case 2: negate exactly one element within the subarray
            # We need (pref[r] - pref[l] - need[i]) % k == 0 for some i in [l, r-1].
            # This is equivalent to: l <= max_need[t] and pref[l] == (pref[r] - t) % k
            # for some t where max_need[t] >= 0.
            pref_r = pref[r]
            for t in active:
                m = max_need[t]          # guaranteed >= 0 because t in active
                target2 = (pref_r - t) % k
                l2 = first_occ[target2]
                if l2 <= m:              # l2 is the smallest index with that pref;
                                         # if it satisfies l2 <= m, the whole subarray [l2, r) is valid
                    length = r - l2
                    if length > ans:
                        ans = length
                        if ans == n:
                            return ans

            # update first_occ with the current prefix remainder pref[r]
            # we only set it the first time we see this remainder (smallest index wins)
            if first_occ[pref[r]] == float('inf'):
                first_occ[pref[r]] = r

        return ans
