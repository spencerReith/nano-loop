class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        # Remove start from requests if present (fulfilled at time 0, no penalty)
        req = [f for f in requests if f != start]
        req.sort()
        m = len(req)
        if m == 0:
            return 0
        
        INF = float('inf')
        # dp[l][r][0] = min penalty serving req[l..r] with elevator at req[l] (leftmost)
        # dp[l][r][1] = min penalty serving req[l..r] with elevator at req[r] (rightmost)
        dp = [[[INF, INF] for _ in range(m)] for __ in range(m)]
        
        # Initialize: serve first request
        for i in range(m):
            dist = abs(start - req[i])
            dp[i][i][0] = m * dist
            dp[i][i][1] = m * dist
        
        # Expand intervals
        for k in range(1, m):  # k = number of served requests so far
            for l in range(0, m - k + 1):
                r = l + k - 1
                weight = m - k
                
                # Expand left to req[l-1]
                if l > 0:
                    # from elevator at req[l] (side 0)
                    D = abs(req[l] - req[l-1])
                    new_pen = dp[l][r][0] + D * weight
                    if new_pen < dp[l-1][r][0]:
                        dp[l-1][r][0] = new_pen
                    # from elevator at req[r] (side 1)
                    D = abs(req[r] - req[l-1])
                    new_pen = dp[l][r][1] + D * weight
                    if new_pen < dp[l-1][r][0]:
                        dp[l-1][r][0] = new_pen
                
                # Expand right to req[r+1]
                if r < m - 1:
                    # from elevator at req[l] (side 0)
                    D = abs(req[l] - req[r+1])
                    new_pen = dp[l][r][0] + D * weight
                    if new_pen < dp[l][r+1][1]:
                        dp[l][r+1][1] = new_pen
                    # from elevator at req[r] (side 1)
                    D = abs(req[r] - req[r+1])
                    new_pen = dp[l][r][1] + D * weight
                    if new_pen < dp[l][r+1][1]:
                        dp[l][r+1][1] = new_pen
        
        return min(dp[0][m-1][0], dp[0][m-1][1])
```
