        Now, the overall algorithm:
        ```python
        class Solution:
            def maxTotal(self, nums: list[int], s: str) -> int:
                n = len(nums)
                total = 0
                i = 0
                while i < n:
                    if s[i] == '1':
                        start = i
                        while i < n and s[i] == '1':
                            i += 1
                        m = i - start  # number of tokens in this block
                        if start == 0:
                            # block starts at 0
                            # sum nums from 0 to m-1
                            total += sum(nums[:m])  # nums[0..m-1]
                        else:
                            # standard DP for block starting at start, size m
                            # total_nums = sum(nums[start-1 : start+m])  # indices start-1 to start+m-1 inclusive
                            # We can compute total_nums by summing.
                            # DP:
                            dp0 = nums[start-1]
                            dp1 = 0
                            for j in range(1, m):  # j from 1 to m-1
                                # j corresponds to the transition step
                                # new_dp0 = min(dp0, dp1 + nums[start-1 + j])
                                # new_dp1 = min(dp0, dp1)
                                new_dp0 = dp0 if dp0 < dp1 + nums[start-1 + j] else dp1 + nums[start-1 + j]
                                new_dp1 = dp0 if dp0 < dp1 else dp1
                                dp0, dp1 = new_dp0, new_dp1
                            # after loop, dp0 and dp1 are for i=m
                            min_cost = dp0 if dp0 < dp1 + nums[start-1 + m] else dp1 + nums[start-1 + m]
                            block_sum = (sum(nums[start-1 : start+m]) - min_cost)
                            total += block_sum
                    else:
                        i += 1
                return total
        ```

