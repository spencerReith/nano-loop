        ```python
        class Solution:
            def maxTotal(self, nums: list[int], s: str) -> int:
                n = len(nums)
                total = 0
                i = 0
                while i < n:
                    if s[i] == '1':
                        start = i
                        while i < n and s[i] == '1':
                            i += 1
                        m = i - start  # number of tokens in this block
                        if start == 0:
                            # Block starts at index 0; optimal to keep all tokens in place
                            total += sum(nums[:m])  # indices 0 to m-1
                        else:
                            # Standard DP for block starting at 'start' with size 'm'
                            # Total nums over indices start-1 to start+m-1 inclusive
                            total_nums = sum(nums[start-1 : start+m])
                            dp0 = nums[start-1]  # dp[i][0] for i=1
                            dp1 = 0              # dp[i][1] for i=1
                            for j in range(1, m):
                                # Transition from token j to j+1
                                # nums index: start-1 + j
                                # new_dp0: if we set next token to 0 (stay? actually move left? careful with states)
                                # new_dp1: if we set next token to 1 (move left)
                                # Based on derived DP:
                                new_dp0 = dp0 if dp0 < dp1 + nums[start-1 + j] else dp1 + nums[start-1 + j]
                                new_dp1 = dp0 if dp0 < dp1 else dp1
                                dp0, dp1 = new_dp0, new_dp1
                            # After processing all m tokens, compute min cost
                            min_cost = dp0 if dp0 < dp1 + nums[start-1 + m] else dp1 + nums[start-1 + m]
                            block_sum = total_nums - min_cost
                            total += block_sum
                    else:
                        i += 1
                return total
        ```

