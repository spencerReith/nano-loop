        We'll output the Python code block.```python
class Solution:
    def maxTotal(self, nums: list[int], s: str) -> int:
        n = len(nums)
        total = 0
        i = 0
        while i < n:
            if s[i] == '1':
                start = i
                while i < n and s[i] == '1':
                    i += 1
                m = i - start  # number of tokens in this contiguous block
                
                if start == 0:
                    # Block starts at index 0.
                    # The first token cannot move left; all tokens in this block are best left in place.
                    total += sum(nums[:m])   # indices 0 .. m-1
                else:
                    # Standard DP for a block starting at 'start' with size 'm'.
                    # The relevant indices are start-1 up to start+m-1 inclusive.
                    total_nums = sum(nums[start-1 : start+m])
                    
                    dp0 = nums[start-1]   # dp[i][0] for the first token
                    dp1 = 0               # dp[i][1] for the first token
                    for j in range(1, m):
                        # Transition when moving to the next token.
                        idx = start - 1 + j
                        # new_dp0: set next token's final position so that it stays (or doesn't uncover advantageously)
                        # new_dp1: set next token to move left.
                        new_dp0 = dp0 if dp0 < dp1 + nums[idx] else dp1 + nums[idx]
                        new_dp1 = dp0 if dp0 < dp1 else dp1
                        dp0, dp1 = new_dp0, new_dp1
                    
                    # After processing all m tokens, add the end-condition cost.
                    idx = start - 1 + m
                    min_cost = dp0 if dp0 < dp1 + nums[idx] else dp1 + nums[idx]
                    block_sum = total_nums - min_cost
                    total += block_sum
            else:
                i += 1
        return total
