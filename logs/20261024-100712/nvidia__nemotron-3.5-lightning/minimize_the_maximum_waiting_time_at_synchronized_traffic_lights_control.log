class Solution:
    def minPenalty(self, period: int, lights: list[int], arrivalTime: list[int]) -> int:
        # Greedy assignment: always assign each car to the light that gives the
        # smallest waiting time for that particular arrival.
        # Since each car's waiting time is independent, the overall penalty is the
        # maximum of those individual waiting times.
        penalty = 0
        for t in arrivalTime:
            best = period  # upper bound: waiting time cannot exceed period - 1
            for g in lights:
                r = t % period
                if r < g:
                    wait = 0
                else:
                    wait = period - r
                if wait < best:
                    best = wait
                    if best == 0:
                        break  # cannot improve further for this car
            if best > penalty:
                penalty = best
        return penalty
