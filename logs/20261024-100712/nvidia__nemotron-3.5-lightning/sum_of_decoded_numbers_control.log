class Solution:
    def sumDecoded(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        total = 0
        for val in nums:
            width = val % 10
            d = val // 10
            s = str(d)
            x = int(s[:width])
            y = int(s[width:])
            total = (total + pow(x, y, MOD)) % MOD
        return total
