class Solution:
    def maxArea(self, mat: list[list[int]]) -> int:
        m, n = len(mat), len(mat[0])

        # dp[i][j] = side length of the largest square of 1's ending at (i, j)
        dp = [[0] * n for _ in range(m)]
        for i in range(m):
            for j in range(n):
                if mat[i][j] == 1:
                    if i == 0 or j == 0:
                        dp[i][j] = 1
                    else:
                        dp[i][j] = 1 + min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1])

        # pref[i][j] = number of 1's in rectangle (0,0) .. (i-1, j-1)
        pref = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(m):
            row_sum = 0
            for j in range(n):
                row_sum += mat[i][j]
                pref[i+1][j+1] = pref[i][j+1] + row_sum

        def count_ones(r1: int, c1: int, r2: int, c2: int) -> int:
            """Return number of ones in submatrix rows r1..r2, cols c1..c2 inclusive."""
            return (pref[r2+1][c2+1] - pref[r1][c2+1]
                    - pref[r2+1][c1] + pref[r1][c1])

        def can_place(k: int) -> bool:
            """Check if there exist two non‑overlapping k×k squares of 1's."""
            if k == 0:
                return True
            # collect all valid top‑left corners for a k×k square
            corners = []
            for i in range(m - k + 1):
                for j in range(n - k + 1):
                    # bottom‑right corner is (i+k-1, j+k-1)
                    if count_ones(i, j, i + k - 1, j + k - 1) == k * k:
                        corners.append((i, j))

            if len(corners) < 2:
                return False

            # test every pair
            for a in range(len(corners)):
                i1, j1 = corners[a]
                for b in range(a + 1, len(corners)):
                    i2, j2 = corners[b]
                    # non‑overlapping condition:
                    # rectangles are disjoint iff one is completely to the left,
                    # right, above, or below the other.
                    if (i1 + k <= i2) or (i2 + k <= i1) or \
                       (j1 + k <= j2) or (j2 + k <= j1):
                        return True
            return False

        # binary search on side length k
        lo, hi = 1, min(m, n)
        ans = 0
        while lo <= hi:
            mid = (lo + hi) // 2
            if can_place(mid):
                ans = mid
                lo = mid + 1
            else:
                hi = mid - 1

        return ans * ans
