class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        # The elevator can move only up or down one floor per second.
        # Since there are no other constraints (e.g., capacity, ordering),
        # the optimal strategy is to serve each request independently.
        # The time needed to serve a request at floor f is the absolute
        # distance from the start floor: |start - f|.
        # The penalty contributed by that request is exactly that time.
        # The total minimum penalty is the sum of these distances.
        total = 0
        for f in requests:
            total += abs(start - f)
        return total
