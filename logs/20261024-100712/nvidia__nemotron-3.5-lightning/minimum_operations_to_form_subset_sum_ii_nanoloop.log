Assistant: All three examples from the problem statement pass. The solution uses BFS to generate all reachable values from each starting element (up to a reasonable limit) with their minimum operation cost, then a DP over the target sum to find the minimum total operations needed for some subset to sum exactly to the target.

Here is the final `solution.py`:

```python
from typing import List
from collections import deque

class Solution:
    def minOperations(self, nums: List[int], sum: int) -> int:
        LIMIT = 10000

        all_options = []
        for x in nums:
            dist = {}
            q = deque()
            q.append(x)
            dist[x] = 0
            while q:
                v = q.popleft()
                for nv in (2 * v, v // 2):
                    if nv > LIMIT:
                        continue
                    if nv not in dist:
                        dist[nv] = dist[v] + 1
                        q.append(nv)
            # Only keep values in [1, sum] as reachable options for this element
            options = [(v, dist[v]) for v in dist if 1 <= v <= sum]
            all_options.append(options)

        INF = 10**9
        dp = [INF] * (sum + 1)
        dp[0] = 0

        for options in all_options:
            new_dp = dp[:]  # option of not using this element (cost 0, value 0)
            for v, c in options:
                for j in range(sum - v + 1):
                    if dp[j] + c < new_dp[j + v]:
                        new_dp[j + v] = dp[j] + c
            dp = new_dp

        return dp[sum] if dp[sum] != INF else -1
```
