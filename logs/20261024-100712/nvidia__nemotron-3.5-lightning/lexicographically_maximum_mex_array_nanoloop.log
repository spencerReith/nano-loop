We need to implement the `Solution` class with method `maximumMEX`.

We'll write:

```python
class Solution:
    def maximumMEX(self, nums: list[int]) -> list[int]:
        n = len(nums)
        if n == 0:
            return []
        # Compute max_val for array sizes
        max_val = max(n, max(nums)) + 2
        
        # Precompute suffix_mex
        suffix_mex = [0] * (n + 1)
        freq = [0] * max_val
        mex = 0
        for i in range(n-1, -1, -1):
            x = nums[i]
            freq[x] += 1
            if x == mex:
                while mex < max_val and freq[mex] > 0:
                    mex += 1
            suffix_mex[i] = mex
        suffix_mex[n] = 0
        
        result = []
        start = 0
        # seen array for tracking first occurrences in current segment
        seen = [0] * max_val
        cur_time = 0
        
        while start < n:
            m = suffix_mex[start]
            if m == 0:
                result.append(0)
                start += 1
                continue
            # new segment with m > 0
            cur_time += 1
            collected = 0
            i = start
            while i < n:
                x = nums[i]
                if x < m:
                    if seen[x] != cur_time:
                        seen[x] = cur_time
                        collected += 1
                if collected == m:
                    k = i - start + 1
                    break
                i += 1
            # After loop, collected must be m
            result.append(m)
            start = start + k
        return result
```

