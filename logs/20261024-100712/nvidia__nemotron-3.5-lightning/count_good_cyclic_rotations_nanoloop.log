```python
from typing import List

class Solution:
    def countGoodRotations(self, nums: List[int]) -> int:
        n = len(nums)
        half = n // 2
        total = sum(nums)
        first_sum = sum(nums[:half])
        count = 0
        for i in range(n):
            if first_sum > total - first_sum:
                count += 1
            first_sum = first_sum - nums[i] + nums[(i + half) % n]
        return count
