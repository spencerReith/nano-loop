```python
from typing import List

class Solution:
    def countTasks(self, tasks: List[int], shifts: List[int]) -> List[int]:
        n = len(tasks)
        i = 0  # next task index to process (0-based)
        rem = tasks[0] if n > 0 else 0  # remaining time on current task
        
        ans = []
        
        for s in shifts:
            time_left = s
            while time_left > 0 and i < n:
                if rem <= time_left:
                    # this task finishes
                    time_left -= rem
                    i += 1
                    if i < n:
                        rem = tasks[i]
                    else:
                        rem = 0  # all tasks done
                else:
                    # partially finish this task
                    rem -= time_left
                    time_left = 0
            if i == n:
                # all tasks completed; next shift starts from task 0
                i = 0
                rem = tasks[0] if n > 0 else 0
                unfinished = 0
            else:
                unfinished = n - i
            ans.append(unfinished)
        
        return ans
