class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        # Transform even numbers to +b, odd numbers to -a.
        # For a subarray, let S = sum of transformed values.
        # x = even count, y = odd count.
        # condition x / y <= a / b  <=>  x * b <= a * y  <=>  x * b - a * y <= 0
        # Since each even contributes +b and odd -a, the condition is exactly S <= 0.
        # Also we need y > 0, i.e. the subarray must contain at least one odd.
        # We need to count pairs (l, r) with l < r such that pref[r] <= pref[l]
        # and the subarray nums[l:r] has at least one odd.

        # pref[i] = sum of transformed values of nums[0:i] (i elements)
        pref = [0] * (n + 1)
        # pref_odd[i] = number of odd elements in nums[0:i]
        pref_odd = [0] * (n + 1)

        for i, v in enumerate(nums, 1):
            if v % 2 == 0:
                pref[i] = pref[i-1] + b
            else:
                pref[i] = pref[i-1] - a
            pref_odd[i] = pref_odd[i-1] + (v % 2)

        # Coordinate compression for pref values
        uniq = sorted(set(pref))
        rank = {v: i + 1 for i, v in enumerate(uniq)}  # 1‑based for BIT

        bit = [0] * (len(uniq) + 2)

        def bit_add(idx: int, delta: int) -> None:
            while idx < len(bit):
                bit[idx] += delta
                idx += idx & -idx

        def bit_sum(idx: int) -> int:
            s = 0
            while idx > 0:
                s += bit[idx]
                idx -= idx & -idx
            return s

        ans = 0
        # Iterate over right endpoint r from 1 to n
        # For each r we need count of l in [0, r-1] with pref[l] <= pref[r] and odd count condition.
        # We'll maintain a BIT of pref[l] for valid left endpoints l.
        # A left endpoint l is valid if the subarray nums[l:r] contains at least one odd.
        # That is equivalent to pref_odd[r] - pref_odd[l] > 0  =>  pref_odd[l] < pref_odd[r].

        # We'll process r increasing, and add l = r-1 to the structure after we have queried for r.
        # But we must ensure that only l with pref_odd[l] < pref_odd[r] are considered.
        # Since pref_odd is non‑decreasing, we can maintain a pointer of l's that have
        # pref_odd[l] < current pref_odd[r].

        # Actually simpler: iterate r, keep a BIT of all l < r, but when querying we only want
        # those with pref_odd[l] < pref_odd[r]. We'll achieve this by only inserting l when its
        # pref_odd becomes < pref_odd[r]. Because pref_odd only increases, we can add l's lazily.

        # Let's keep a list of "ready" l's whose pref_odd is strictly less than the current r's odd count.
        # We'll maintain a pointer `ptr` over l = 0 .. n-1, and add l to BIT when pref_odd[l] < pref_odd[r].

        ptr = 0  # next l to potentially add
        # Initially add l = 0 if its odd count condition holds for r=1 later, but we'll handle in loop.

        for r in range(1, n + 1):
            # Add all l < r that have pref_odd[l] < pref_odd[r]
            while ptr < r and pref_odd[ptr] < pref_odd[r]:
                bit_add(rank[pref[ptr]], 1)
                ptr += 1
            # Now query how many added l have pref[l] <= pref[r]
            ans += bit_sum(rank[pref[r]])

        return ans
