```python
from collections import defaultdict

class Solution:
    def maxEqualPairs(self, nums: list[int]) -> int:
        n = len(nums)
        # Count existing equal adjacent pairs
        original = 0
        for i in range(n - 1):
            if nums[i] == nums[i + 1]:
                original += 1
        
        # Build adjacency count: adj[a][b] = number of times a is immediately followed by b
        adj = defaultdict(lambda: defaultdict(int))
        for i in range(n - 1):
            a, b = nums[i], nums[i + 1]
            adj[a][b] += 1
        
        max_gain = 0
        # For every distinct adjacent pair (a, b), compute the gain from replacing a with b.
        # After replacing x with y, every occurrence of x followed by y (or y followed by x) becomes equal.
        # The gain is adj[x][y] + adj[y][x]; we process each unordered pair once.
        seen = set()
        for i in range(n - 1):
            a, b = nums[i], nums[i + 1]
            if a != b:
                key = (min(a, b), max(a, b))
                if key not in seen:
                    seen.add(key)
                    gain = adj[a].get(b, 0) + adj[b].get(a, 0)
                    if gain > max_gain:
                        max_gain = gain
        
        return original + max_gain
```
