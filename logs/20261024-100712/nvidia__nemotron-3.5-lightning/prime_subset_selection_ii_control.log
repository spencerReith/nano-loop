class Solution:
    def maxPrimeSubset(self, n: int, s: int) -> list[int]:
        # ---- generate all primes <= n ----
        is_prime = [True] * (n + 1)
        is_prime[0:2] = [False, False]
        for i in range(2, int(n ** 0.5) + 1):
            if is_prime[i]:
                for j in range(i * i, n + 1, i):
                    is_prime[j] = False
        primes = [i for i in range(2, n + 1) if is_prime[i]]

        # No prime can be used because the smallest prime 2 > s
        if not primes or primes[0] > s:
            return []

        # ---- DP over primes ----
        # dp[sum] = (count, sorted_tuple_of_primes)
        # We keep the best subset for each reachable sum:
        #   best sum -> larger sum preferred
        #   among same sum -> smaller count preferred
        #   among same count -> lexicographically smallest tuple
        dp = {0: (0, ())}   # sum 0: empty subset

        for p in primes:
            # iterate over a snapshot of current sums to avoid reuse of the same prime
            current_sums = list(dp.keys())
            for cur_sum in current_sums:
                new_sum = cur_sum + p
                if new_sum > s:
                    continue
                cnt, tup = dp[cur_sum]
                new_cnt = cnt + 1
                new_tup = tup + (p,)          # tup is already sorted because we process primes increasingly
                if new_sum not in dp:
                    dp[new_sum] = (new_cnt, new_tup)
                else:
                    old_cnt, old_tup = dp[new_sum]
                    # choose better according to the problem's priority
                    if new_cnt < old_cnt:
                        dp[new_sum] = (new_cnt, new_tup)
                    elif new_cnt == old_cnt and new_tup < old_tup:
                        dp[new_sum] = (new_cnt, new_tup)

        # ---- find the answer ----
        # we need the largest sum <= s that has a non‑empty subset
        best_sum = -1
        best_subset = None
        for sum_val, (cnt, tup) in dp.items():
            if sum_val == 0:
                continue          # skip empty subset
            if sum_val > s:
                continue
            if sum_val > best_sum:
                best_sum = sum_val
                best_subset = tup
            elif sum_val == best_sum:
                # tie‑break: fewer primes, then lexicographically smallest
                old_cnt, old_tup = best_subset if best_subset is not None else (float('inf'), ())
                if cnt < old_cnt or (cnt == old_cnt and tup < old_tup):
                    best_subset = tup

        return list(best_subset) if best_subset is not None else []
