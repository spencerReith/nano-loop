class Solution:
    def maxSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        # The problem asks for the maximum possible subarray sum after at most k swaps.
        # Swapping any elements can reorder the array arbitrarily.
        # The optimal subarray will always consist of the largest available numbers,
        # and we can always choose a subarray of any length L <= n.
        #
        # After sorting nums descending, the sum of the first L elements is the
        # maximum sum achievable using L elements. The best overall answer is
        # the maximum of these prefix sums. Since we can use at most k swaps,
        # we can always bring the top L elements into any contiguous subarray
        # of length L (e.g., the first L positions), as long as L <= n.
        # The constraint k does not restrict the length of the subarray;
        # we just take the best prefix sum.
        #
        # Edge case: if all numbers are negative, the maximum subarray sum
        # is the largest single element (the maximum element). Our loop
        # considering L from 1 to n already covers this because prefix sums
        # will be increasing then decreasing, and we take the max.
        nums.sort(reverse=True)
        best = float('-inf')
        prefix = 0
        for i, val in enumerate(nums, 1):
            prefix += val
            if prefix > best:
                best = prefix
        return best
