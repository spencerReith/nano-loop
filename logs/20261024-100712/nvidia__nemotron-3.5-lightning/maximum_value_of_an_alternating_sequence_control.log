class Solution:
    def maximumValue(self, n: int, s: int, m: int) -> int:
        # The first element is fixed at s.
        # In an alternating sequence each adjacent step can change by at most m.
        # After k steps, the value can be at most s + k * m.
        # Since we have n-1 steps available after the first element,
        # the maximum reachable element is s + (n - 1) * m.
        return s + (n - 1) * m
