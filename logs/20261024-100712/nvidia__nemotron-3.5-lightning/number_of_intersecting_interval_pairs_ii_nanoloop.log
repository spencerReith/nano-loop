```python
class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        n = len(intervals)
        # Sort intervals by start time
        intervals.sort(key=lambda x: x[0])
        import heapq
        heap = []  # min-heap of end times
        ans = 0
        for start, end in intervals:
            # Remove intervals that end before the current start (strictly before, since sharing endpoint counts as intersect)
            while heap and heap[0] < start:
                heapq.heappop(heap)
            # All intervals currently in heap intersect with the current interval
            ans += len(heap)
            heapq.heappush(heap, end)
        return ans
```
