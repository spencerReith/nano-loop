from collections import Counter
from typing import List


class Solution:
    def numberOfPairs(self, nums1: List[int], nums2: List[int], queries: List[list[int]]) -> List[int]:
        freq1 = Counter(nums1)

        n = len(nums2)
        B = int(n ** 0.5) + 1

        # Build blocks, each stores 'arr' (the base values) and 'freq' (Counter of arr) and 'lazy'
        blocks = []
        for i in range(0, n, B):
            block_arr = nums2[i:i+B]
            block_freq = Counter(block_arr)
            blocks.append({
                'arr': block_arr,
                'freq': block_freq,
                'lazy': 0
            })

        answer = []

        for q in queries:
            if q[0] == 1:
                # type 1: add val to nums2[x..y]
                _, x, y, val = q
                block_l = x // B
                block_r = y // B

                if block_l == block_r:
                    # single block, update elements in range [x, y]
                    block = blocks[block_l]
                    start = x - block_l * B
                    end = y - block_l * B + 1  # exclusive
                    for idx in range(start, end):
                        old = block['arr'][idx]
                        block['freq'][old] -= 1
                        if block['freq'][old] == 0:
                            del block['freq'][old]
                        new = old + val
                        block['arr'][idx] = new
                        block['freq'][new] = block['freq'].get(new, 0) + 1
                else:
                    # left partial block
                    block = blocks[block_l]
                    start = x - block_l * B
                    end = len(block['arr'])
                    for idx in range(start, end):
                        old = block['arr'][idx]
                        block['freq'][old] -= 1
                        if block['freq'][old] == 0:
                            del block['freq'][old]
                        new = old + val
                        block['arr'][idx] = new
                        block['freq'][new] = block['freq'].get(new, 0) + 1
                    # right partial block
                    block = blocks[block_r]
                    start = 0
                    end = y - block_r * B + 1
                    for idx in range(start, end):
                        old = block['arr'][idx]
                        block['freq'][old] -= 1
                        if block['freq'][old] == 0:
                            del block['freq'][old]
                        new = old + val
                        block['arr'][idx] = new
                        block['freq'][new] = block['freq'].get(new, 0) + 1
                    # middle blocks fully covered: just add to lazy
                    for b in range(block_l + 1, block_r):
                        blocks[b]['lazy'] += val
            else:
                # type 2: compute pairs
                _, tot = q
                ans = 0
                for v, cnt1 in freq1.items():
                    target = tot - v
                    for block in blocks:
                        actual_target = target - block['lazy']
                        ans += cnt1 * block['freq'].get(actual_target, 0)
                answer.append(ans)

        return answer
