import sys

# ---------- Fenwick Tree (Binary Indexed Tree) ----------
class Fenwick:
    def __init__(self, n):
        self.n = n
        self.tree = [0] * (n + 1)

    def add(self, i, delta):
        while i <= self.n:
            self.tree[i] += delta
            i += i & -i

    def query(self, i):
        s = 0
        while i > 0:
            s += self.tree[i]
            i -= i & -i
        return s

    def total(self):
        return self.query(self.n)

    def find_kth(self, k):
        """Return smallest 1-indexed idx such that prefix frequency >= k.
        Returns -1 if k > total frequency or k <= 0."""
        if k <= 0 or k > self.total():
            return -1
        idx = 0
        bit_mask = 1 << (self.n.bit_length() - 1)
        while bit_mask:
            t = idx + bit_mask
            if t <= self.n and self.tree[t] < k:
                idx = t
                k -= self.tree[t]
            bit_mask >>= 1
        return idx + 1


# ---------- MultiSet with order statistics ----------
OFFSET = 100000
SIZE = 200001  # values -100000..100000 mapped to idx 1..200001

class MultiSet:
    def __init__(self, values=None):
        self.freq = Fenwick(SIZE)
        self.sum_tree = Fenwick(SIZE)
        self.total_freq = 0
        self.total_sum = 0
        if values is not None:
            for v in values:
                self.add(v)

    def add(self, v):
        idx = v + OFFSET + 1  # shift to 1..200001
        self.freq.add(idx, 1)
        self.sum_tree.add(idx, v)
        self.total_freq += 1
        self.total_sum += v

    def remove(self, v):
        idx = v + OFFSET + 1
        self.freq.add(idx, -1)
        self.sum_tree.add(idx, -v)
        self.total_freq -= 1
        self.total_sum -= v

    def find_kth(self, k):
        return self.freq.find_kth(k)

    def sum_smallest_t(self, t):
        """Return sum of the t smallest original values.
        If t <= 0: return 0.
        If t >= total_freq: return total_sum."""
        if t <= 0:
            return 0
        if t >= self.total_freq:
            return self.total_sum
        idx = self.find_kth(t)
        if idx == -1:
            return self.total_sum
        freq_before = self.freq.query(idx - 1)
        sum_before = self.sum_tree.query(idx - 1)
        need = t - freq_before
        v = idx - OFFSET - 1  # recover original value
        return sum_before + need * v

    def sum_largest_t(self, t):
        """Return sum of the t largest original values."""
        if t <= 0:
            return 0
        if t >= self.total_freq:
            return self.total_sum
        return self.total_sum - self.sum_smallest_t(self.total_freq - t)


# ---------- Solution ----------
class Solution:
    def maxSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        ans = -10**18  # sufficiently small

        for l in range(n):
            # outside starts with all n elements, inside empty
            outside = MultiSet(nums)
            inside = MultiSet()
            sub_sum = 0

            for r in range(l, n):
                val = nums[r]
                # move val from outside to inside
                outside.remove(val)
                inside.add(val)
                sub_sum += val

                M_in = inside.total_freq
                M_out = outside.total_freq
                t_max = min(k, M_in, M_out)

                if t_max == 0:
                    total = sub_sum
                else:
                    # binary search for largest t in [1, t_max] with outside_t > inside_t
                    lo, hi = 1, t_max
                    best_t = 0
                    while lo <= hi:
                        mid = (lo + hi) // 2
                        # t-th smallest inside
                        inside_idx = inside.find_kth(mid)
                        inside_val = inside_idx - OFFSET - 1  # recover original value
                        # t-th largest outside = (M_out - mid + 1)-th smallest outside
                        outside_smallest_idx = outside.find_kth(M_out - mid + 1)
                        outside_val = outside_smallest_idx - OFFSET - 1

                        if outside_val > inside_val:
                            best_t = mid
                            lo = mid + 1
                        else:
                            hi = mid - 1

                    if best_t > 0:
                        gain_out = outside.sum_largest_t(best_t)
                        gain_in = inside.sum_smallest_t(best_t)
                        total = sub_sum + gain_out - gain_in
                    else:
                        total = sub_sum

                if total > ans:
                    ans = total

        return ans
