def min_intervals(intervals, L, R):
    intervals.sort()
    cur = L
    count = 0
    i = 0
    n = len(intervals)
    while cur < R:
        max_end = -1
        while i < n and intervals[i][0] <= cur:
            max_end = max(max_end, intervals[i][1])
            i += 1
        if max_end < cur:
            return -1  # cannot cover
        count += 1
        cur = max_end
    return count
```
