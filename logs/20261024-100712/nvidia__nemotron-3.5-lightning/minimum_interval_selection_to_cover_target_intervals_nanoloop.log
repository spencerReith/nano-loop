class Solution:
    def minSelection(self, availableIntervals: list[list[int]], targetIntervals: list[list[int]]) -> int:
        # Merge target intervals into a sorted list of disjoint intervals
        targetIntervals.sort(key=lambda x: x[0])
        merged = []
        for cur in targetIntervals:
            if not merged or cur[0] > merged[-1][1]:
                merged.append([cur[0], cur[1]])
            else:
                merged[-1][1] = max(merged[-1][1], cur[1])

        # Sort available intervals by their start point
        availableIntervals.sort(key=lambda x: x[0])

        n = len(availableIntervals)
        m = len(merged)
        if m == 0:
            return 0

        t_idx = 0          # index of the current target we are trying to cover
        cur = merged[0][0] # leftmost point that still needs coverage
        i = 0              # pointer in the sorted available intervals
        count = 0          # number of selected intervals

        while t_idx < m:
            max_end = -1
            # Among all available intervals that start at or before cur,
            # find the one that extends farthest to the right.
            while i < n and availableIntervals[i][0] <= cur:
                if availableIntervals[i][1] > max_end:
                    max_end = availableIntervals[i][1]
                i += 1

            # If no interval covers cur, it's impossible.
            if max_end < cur:
                return -1

            count += 1
            cur = max_end

            # Move past any targets that are already fully covered by cur.
            while t_idx < m and cur >= merged[t_idx][1]:
                t_idx += 1
                # If the next target starts after cur, we need to start covering it.
                if t_idx < m and cur < merged[t_idx][0]:
                    cur = merged[t_idx][0]

        return count
