class Solution:
    def largestString(self, nums: list[int]) -> list[str]:
        ans = []
        for n in nums:
            res = []
            while n > 0:
                # Find the highest power of two <= n
                highest = 1 << (n.bit_length() - 1)
                # The bit position (0-indexed from 'a')
                pos = highest.bit_length() - 1
                res.append(chr(ord('a') + pos))
                n -= highest
            # res is already in descending order of bits (most significant first)
            ans.append(''.join(res))
        return ans
