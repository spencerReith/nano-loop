class Solution:
    def largestString(self, nums: list[int]) -> list[str]:
        ans = []
        for n in nums:
            # Find the binary representation of n
            # We want to output letters from most significant bit to least
            # bit i corresponds to chr(ord('a') + i)
            # We can iterate from the highest bit down to 0
            # Since n <= 10^8, highest bit is at most 26 (but we'll just use while n > 0)
            # Actually, we can just find bits by checking n & (1 << i)
            # But we need to output in descending order of i.
            # We can do: while n > 0: find the highest set bit, output the letter, n -= that power.
            # Or we can just convert n to binary string and map.
            # Let's do the while loop:
            res = []
            while n > 0:
                # find the highest power of 2 <= n
                # we can use n.bit_length() - 1
                highest = 1 << (n.bit_length() - 1)
                # the bit position is highest.bit_length() - 1
                pos = highest.bit_length() - 1
                res.append(chr(ord('a') + pos))
                n -= highest
            # res is from most significant to least, which is already descending order of bits
            # but we need to check if this matches the examples.
            # Example 1: nums=[2,5,7]
            # 2: highest=2, pos=1 -> 'b', n=0 -> "b"
            # 5: highest=4, pos=2 -> 'c', n=1 -> highest=1, pos=0 -> 'a' -> "ca"
            # 7: highest=4 -> 'c', n=3 -> highest=2 -> 'b', n=1 -> 'a' -> "cba"
            # Matches.
            # Example 2: [3,9,1]
            # 3: highest=2 -> 'b', n=1 -> 'a' -> "ba"
            # 9: highest=8 -> 'd' (pos=3), n=1 -> 'a' -> "da"
            # 1: highest=1 -> 'a' -> "a"
            # Matches.
            ans.append(''.join(res))
        return ans
