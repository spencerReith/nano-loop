class Solution:
    def distantSubarrays(self, nums: list[int], goal: int, k: int) -> int:
        """
        Count subarrays where |sum - goal| >= k.
        We count all subarrays and subtract those with |sum - goal| < k.
        A subarray sum S satisfies |S - goal| < k  <=>  goal - k < S < goal + k.
        Since S and goal are integers, this means S in [goal - k + 1, goal + k - 1].
        """
        n = len(nums)
        # total number of subarrays
        total = n * (n + 1) // 2

        # count subarrays with sum in [goal - k + 1, goal + k - 1]
        # we use a Fenwick tree (Binary Indexed Tree) over compressed prefix sums
        # prefix sums: pref[0] = 0, pref[i] = sum(nums[0..i-1])

        # compute all prefix sums
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]

        # values we will query/add: pref[j] and pref[j] - (goal - k + 1) and pref[j] - (goal + k - 1)
        # Actually we need to count previous pref[i] such that L <= pref[i] <= R.
        # Using order-statistic / BIT on compressed coordinates.
        # For each j from 1..n, we want number of i < j with L <= pref[i] <= R,
        # where L = goal - k + 1, R = goal + k - 1.
        # So we need to compress all pref[i] and also L-1 and R for binary search.

        L = goal - k + 1
        R = goal + k - 1

        # collect all prefix sums and the query boundaries
        vals = set(pref)
        # we will use bisect on sorted unique vals; no need to add extra values,
        # but we add L-1 and R to make bisect right work nicely.
        vals.add(L - 1)
        vals.add(R)

        sorted_vals = sorted(vals)
        m = len(sorted_vals)

        # map value -> 1-based index for BIT
        idx = {v: i + 1 for i, v in enumerate(sorted_vals)}

        bit = [0] * (m + 2)

        def bit_add(i: int, delta: int) -> None:
            while i <= m:
                bit[i] += delta
                i += i & -i

        def bit_sum(i: int) -> int:
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & -i
            return s

        # we will iterate j from 1..n, maintaining BIT of pref[0..j-1]
        # initially add pref[0] = 0
        bit_add(idx[pref[0]], 1)

        cnt = 0  # number of subarrays with |sum - goal| < k
        for j in range(1, n + 1):
            p = pref[j]
            # we need count of previous pref[i] in [L, R]
            # using bisect: left = number of elements < L  -> idx of L-1 in sorted_vals + 1
            # right = number of elements <= R -> idx of R in sorted_vals
            # count = bit_sum(right_idx) - bit_sum(left_idx - 1)
            # we can get indices via the precomputed dict for exact values,
            # but L and R might not be in sorted_vals. We'll use bisect.
            import bisect
            left_idx = bisect.bisect_left(sorted_vals, L)  # first position with value >= L
            right_idx = bisect.bisect_right(sorted_vals, R) - 1  # last position with value <= R
            if left_idx <= right_idx:
                # convert to 1-based BIT indices
                l = left_idx + 1
                r = right_idx + 1
                # sum in [l, r] = bit_sum(r) - bit_sum(l-1)
                cnt += bit_sum(r) - bit_sum(l - 1)
            # add current prefix sum to BIT for future j's
            bit_add(idx[p], 1)

        # distant subarrays = total - cnt
        return total - cnt
