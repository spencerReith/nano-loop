class Solution:
    def findDisappearedNumbers(self, nums: list[int], lower: int, upper: int) -> list[list[int]]:
        # Use a set to keep only the numbers that appear in nums.
        # We only care about numbers that lie within [lower, upper].
        present = set()
        for x in nums:
            if lower <= x <= upper:
                present.add(x)

        res: list[list[int]] = []
        i = lower
        # Scan the whole range [lower, upper] and group consecutive missing numbers.
        while i <= upper:
            if i not in present:
                start = i
                # Advance i while the next number is also missing.
                while i + 1 <= upper and (i + 1) not in present:
                    i += 1
                res.append([start, i])
            i += 1
        return res
