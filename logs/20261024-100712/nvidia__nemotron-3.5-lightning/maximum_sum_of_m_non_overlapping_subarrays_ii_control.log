            from collections import deque
            class Solution:
                def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
                    n = len(nums)
                    pref = [0] * (n + 1)
                    for i in range(n):
                        pref[i + 1] = pref[i] + nums[i]
                    
                    INF_NEG = -10**15
                    
                    # f[j] = max sum using at most (k-1) subarrays from first j elements
                    # Initially k=0: f[j] = 0 for all j
                    f = [0] * (n + 1)
                    ans = INF_NEG
                    
                    for k in range(1, m + 1):
                        new_f = [INF_NEG] * (n + 1)
                        new_f[0] = INF_NEG
                        q = deque()
                        
                        for i in range(1, n + 1):
                            # add j = i - l
                            j_add = i - l
                            if j_add >= 0:
                                # compute val_add
                                if f[j_add] != INF_NEG:
                                    val_add = f[j_add] - pref[j_add]
                                else:
                                    val_add = INF_NEG
                                # maintain decreasing order in deque
                                while q:
                                    j_back = q[-1]
                                    if f[j_back] != INF_NEG:
                                        val_back = f[j_back] - pref[j_back]
                                    else:
                                        val_back = INF_NEG
                                    if val_back <= val_add:
                                        q.pop()
                                    else:
                                        break
                                q.append(j_add)
                            
                            # remove j < i - r
                            while q and q[0] < i - r:
                                q.popleft()
                            
                            # query max
                            if q:
                                j_max = q[0]
                                if f[j_max] != INF_NEG:
                                    val_max = f[j_max] - pref[j_max]
                                else:
                                    val_max = INF_NEG
                            else:
                                val_max = INF_NEG
                            
                            if val_max != INF_NEG:
                                g = pref[i] + val_max
                            else:
                                g = INF_NEG
                            
                            new_f[i] = max(new_f[i-1], g)
                        
                        f = new_f
                        if new_f[n] > ans:
                            ans = new_f[n]
                    
                    return ans
            ```

