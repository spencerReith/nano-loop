from collections import deque
from typing import list

class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        # prefix sums: pref[i] = sum of nums[0..i-1]
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]

        INF_NEG = -10**15  # sufficiently small sentinel

        # f[j] = maximum sum using at most (k-1) subarrays from the first j elements.
        # Initially (k=0), f[j] = 0 for all j.
        f = [0] * (n + 1)
        ans = INF_NEG

        for k in range(1, m + 1):
            new_f = [INF_NEG] * (n + 1)
            new_f[0] = INF_NEG  # cannot have k>0 subarrays from 0 elements
            q = deque()  # monotonic queue storing indices j, maintaining decreasing val[j] = f[j] - pref[j]

            for i in range(1, n + 1):
                # Add candidate j = i - l (the upper bound of the start index window)
                j_add = i - l
                if j_add >= 0:
                    # value if we start a subarray at j_add
                    if f[j_add] != INF_NEG:
                        val_add = f[j_add] - pref[j_add]
                    else:
                        val_add = INF_NEG
                    # maintain decreasing order of values in the deque
                    while q:
                        j_back = q[-1]
                        if f[j_back] != INF_NEG:
                            val_back = f[j_back] - pref[j_back]
                        else:
                            val_back = INF_NEG
                        if val_back <= val_add:
                            q.pop()
                        else:
                            break
                    q.append(j_add)

                # Remove indices that are too far left: window lower bound is i - r
                while q and q[0] < i - r:
                    q.popleft()

                # Query the maximum value in the current window
                if q:
                    j_max = q[0]
                    if f[j_max] != INF_NEG:
                        val_max = f[j_max] - pref[j_max]
                    else:
                        val_max = INF_NEG
                else:
                    val_max = INF_NEG

                # Compute g[i] = pref[i] + max_{j in window} (f[j] - pref[j])
                if val_max != INF_NEG:
                    g = pref[i] + val_max
                else:
                    g = INF_NEG

                # new_f[i] = max sum using at most k subarrays from first i elements
                new_f[i] = max(new_f[i - 1], g)

            f = new_f
            if new_f[n] > ans:
                ans = new_f[n]

        return ans
