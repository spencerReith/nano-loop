 class Solution:
    def kthDigit(self, k: int) -> int:
        if k <= 9:
            return k
        
        k -= 9
        
        d = 2
        while True:
            block_count = 9 * (10 ** (d - 2))
            block_digits = block_count * 10 * d
            if k > block_digits:
                k -= block_digits
                d += 1
            else:
                block_index = (k - 1) // (10 * d)
                b = (10 ** (d - 2)) + block_index
   

