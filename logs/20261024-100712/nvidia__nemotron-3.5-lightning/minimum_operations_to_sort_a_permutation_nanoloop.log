```python
class Solution:
    def minOperations(self, nums: list[int]) -> int:
        n = len(nums)
        pos0 = nums.index(0)
        
        ans = float('inf')
        
        # Pattern 1: only left rotates
        # Need s^k(nums) = sorted, where k = pos0
        valid = True
        for i in range(n):
            if nums[(pos0 + i) % n] != i:
                valid = False
                break
        if valid:
            ans = min(ans, pos0)
        
        # Pattern 2: k left rotates then reverse
        # Need r(s^k(nums)) = sorted, where k = (pos0 + 1) % n
        # This means s^k(nums) = reversed sorted = [n-1, n-2, ..., 0]
        k2 = (pos0 + 1) % n
        valid = True
        for i in range(n):
            if nums[(k2 + i) % n] != n - 1 - i:
                valid = False
                break
        if valid:
            ans = min(ans, k2 + 1)
        
        # Pattern 3: reverse then k left rotates
        # Need s^k(r(nums)) = sorted, where k = (n - 1 - pos0) % n
        k3 = (n - 1 - pos0) % n
        # r(nums) has element at index i = nums[n-1-i]
        # After k left rotates, element at index i = nums[n-1 - ((k+i)%n)]
        # We need this to equal i for all i
        valid = True
        for i in range(n):
            if nums[n - 1 - ((k3 + i) % n)] != i:
                valid = False
                break
        if valid:
            ans = min(ans, 1 + k3)
        
        return ans if ans != float('inf') else -1
```


