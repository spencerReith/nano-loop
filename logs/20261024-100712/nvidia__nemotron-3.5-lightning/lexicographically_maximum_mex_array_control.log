class Solution:
    def maximumMEX(self, nums: list[int]) -> list[int]:
        n = len(nums)
        # suffix_mex[i] = MEX of nums[i:]
        suffix_mex = [0] * (n + 1)
        freq = [0] * (n + 2)  # freq array for numbers 0..n (and a bit extra)
        mex = 0
        # compute suffix MEX from right to left
        for i in range(n - 1, -1, -1):
            x = nums[i]
            if x <= n:
                freq[x] += 1
            while freq[mex] > 0:
                mex += 1
            suffix_mex[i] = mex
        
        # vis[x] will store the "timestamp" of when x was seen in the current step
        vis = [-1] * (n + 1)
        cur_vis = 1
        ans = []
        i = 0
        
        while i < n:
            m = suffix_mex[i]
            if m == 0:
                # MEX is 0, smallest prefix with MEX=0 has length 1
                ans.append(0)
                i += 1
                continue
            
            # find smallest k such that nums[i:i+k] contains all 0..m-1
            count = 0
            j = i
            while j < n:
                x = nums[j]
                if x < m and vis[x] != cur_vis:
                    vis[x] = cur_vis
                    count += 1
                if count == m:
                    break
                j += 1
            
            # j is the index where the condition is met
            k = j - i + 1
            ans.append(m)
            i = j + 1
            cur_vis += 1
            
        return ans
