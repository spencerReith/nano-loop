class Solution:
    def countValidSubarrays(self, nums: list[int], x: int) -> int:
        # Helper to obtain the first and last decimal digit of a non‑negative integer.
        def first_last_digits(val: int):
            # val is guaranteed > 0 because nums[i] >= 1, but guard against 0.
            if val == 0:
                return 0, 0
            # Last digit is trivial.
            last = val % 10
            # First digit: repeatedly divide by 10.
            first = val
            while first >= 10:
                first //= 10
            return first, last

        n = len(nums)
        # Prefix sums: pref[i] = sum of nums[0..i-1], pref[0] = 0.
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]

        ans = 0
        # Enumerate all subarrays (l, r) inclusive.
        for l in range(n):
            for r in range(l, n):
                s = pref[r + 1] - pref[l]          # sum of nums[l..r]
                first, last = first_last_digits(s)
                if first == x and last == x:
                    ans += 1
        return ans
