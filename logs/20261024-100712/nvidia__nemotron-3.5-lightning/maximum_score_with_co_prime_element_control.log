from typing import List

class Solution:
    def maxScore(self, nums: List[int], maxVal: int) -> int:
        n = len(nums)
        max_num = max(nums)
        M = max(maxVal, max_num)
        
        # frequency of each value in nums (up to M)
        freq = [0] * (M + 1)
        for x in nums:
            # all x are <= M by definition
            freq[x] += 1
            
        # Precompute Mobius function mu up to M
        mu = [0] * (M + 1)
        mu[1] = 1
        spf = list(range(M + 1))  # smallest prime factor
        primes = []
        for i in range(2, M + 1):
            if spf[i] == i:
                primes.append(i)
                mu[i] = -1
            for p in primes:
                if i * p > M:
                    break
                spf[i * p] = p
                if i % p == 0:
                    mu[i * p] = 0
                    break
                else:
                    mu[i * p] = -mu[i]
        
        # cnt[d] = number of elements in nums divisible by d
        cnt = [0] * (M + 1)
        for d in range(1, M + 1):
            for m in range(d, M + 1, d):
                cnt[d] += freq[m]
                
        # co[v] = number of elements in nums co-prime with v
        co = [0] * (M + 1)
        for d in range(1, M + 1):
            if mu[d] != 0:
                add = mu[d] * cnt[d]
                for v in range(d, M + 1, d):
                    co[v] += add
                    
        best = -10**9
        
        for v in range(1, M + 1):
            if v == 1:
                if freq[1] > 0:
                    cost = 0
                else:
                    cost = 1
            else:
                # if v > maxVal and v does not appear in original nums, impossible
                if v > maxVal and freq[v] == 0:
                    continue
                f = freq[v]
                if f > 0:
                    cost = n - co[v] - 1
                else:
                    if co[v] == n:
                        cost = 1
                    else:
                        cost = n - co[v]
            score = v - cost
            if score > best:
                best = score
                
        return best
```

