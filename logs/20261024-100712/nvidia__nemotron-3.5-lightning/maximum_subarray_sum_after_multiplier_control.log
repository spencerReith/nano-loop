class Solution:
    def maxSubarraySum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        
        # ---------- helper: floor division (floor towards -inf) ----------
        def floor_div(a: int, b: int) -> int:
            # floor(a / b)  where b > 0
            q, r = divmod(a, b)          # Python's divmod gives remainder with sign of divisor (positive)
            # floor division: if remainder exists and signs differ, subtract 1
            if r != 0 and ((a < 0) ^ (b < 0)):
                q -= 1
            return q

        # ---------- original maximum subarray sum (Kadane) ----------
        cur = best_original = nums[0]
        for x in nums[1:]:
            cur = max(x, cur + x)
            best_original = max(best_original, cur)

        # ---------- transformed arrays ----------
        # A[i] = floor division, B[i] = ceil division
        A = [floor_div(x, k) for x in nums]
        B = [(-(-x // k)) if x >= 0 else -((-x + k - 1) // k) for x in nums]
        # Simpler: use math.ceil for positive k, but we avoid imports:
        # For integer x and positive k:
        #   ceil(x/k) = -floor(-x/k)
        # We'll compute B using the identity: ceil(x/k) = -floor(-x/k)
        # floor(-x/k) can be computed via floor_div(-x, k)
        B = [-floor_div(-x, k) for x in nums]

        # ---------- Kadane on A and B ----------
        cur_A = best_A = A[0]
        cur_B = best_B = B[0]
        for i in range(1, n):
            cur_A = max(A[i], cur_A + A[i])
            best_A = max(best_A, cur_A)

            cur_B = max(B[i], cur_B + B[i])
            best_B = max(best_B, cur_B)

        # ---------- best subarray sum after multiplication ----------
        # We need max_{l<=r} (original_sum(l,r) + (k-1)*sum_{l,r} A[i])
        # = max_{l<=r} ( sum_{l,r} (1 + (k-1)*A[i]) )
        # Let C[i] = 1 + (k-1)*A[i]
        # Then we just need max subarray sum of C.
        cur_C = best_C = 1 + (k - 1) * A[0]
        for i in range(1, n):
            val = 1 + (k - 1) * A[i]
            cur_C = max(val, cur_C + val)
            best_C = max(best_C, cur_C)

        # The answer is the max over:
        # 1) original max subarray (no operation)
        # 2) multiply by k  -> best_C
        # 3) divide by k    -> best_B
        ans = max(best_original, best_C, best_B)
        return ans
