class Solution:
    def largestPower(self, nums: list[int]) -> list[int]:
        # count[i] = number of elements in nums that have the i-th bit set (0-indexed)
        count = [0] * 15
        for x in nums:
            for i in range(15):
                if x & (1 << i):
                    count[i] += 1

        # power[14 - i] = how many of the first j elements have the (14-i)-th bit set
        # To make the power array lexicographically largest, we place all elements that
        # have a particular bit set as early as possible. The maximum prefix length for
        # that bit is exactly the total count of numbers having that bit set.
        # Therefore power[14 - i] = count[i].
        power = [0] * 15
        for i in range(15):
            power[14 - i] = count[i]
        return power
