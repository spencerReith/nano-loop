```python
from typing import List

class Solution:
    def divisibleGame(self, nums: List[int]) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        
        # Collect all candidate k > 1: divisors of any element, plus 2
        candidates = set()
        for v in nums:
            # Find all divisors > 1 of v
            d = 2
            while d * d <= v:
                if v % d == 0:
                    candidates.add(d)
                    while v % d == 0:
                        v //= d
                d += 1 if d == 2 else 2  # skip even numbers after 2
            if v > 1:
                candidates.add(v)
        candidates.add(2)  # ensure k = 2 is always considered
        
        best_diff = float('-inf')
        best_k = None
        
        for k in sorted(candidates):
            if k <= 1:
                continue
            # Contribution of each element: +nums[i] if divisible by k, else -nums[i]
            contrib = [nums[i] if nums[i] % k == 0 else -nums[i] for i in range(n)]
            # Kadane's algorithm for maximum subarray sum
            max_ending_here = 0
            max_so_far = float('-inf')
            for val in contrib:
                max_ending_here = max(val, max_ending_here + val)
                max_so_far = max(max_so_far, max_ending_here)
            
            # Update best (k, diff) pair
            if max_so_far > best_diff or (max_so_far == best_diff and (best_k is None or k < best_k)):
                best_diff = max_so_far
                best_k = k
        
        return (best_diff * best_k) % MOD
