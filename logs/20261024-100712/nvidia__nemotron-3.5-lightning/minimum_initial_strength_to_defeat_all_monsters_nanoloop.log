```python
from typing import List

class Solution:
    def minInitialStrength(self, monsters: List[int], boosts: List[List[int]]) -> int:
        n = len(monsters)
        # compute bonus for each index using difference array
        diff = [0] * (n + 1)  # one extra for r+1
        for l, r, v in boosts:
            diff[l] += v
            if r + 1 < n:
                diff[r + 1] -= v
        bonus = [0] * n
        cur = 0
        for i in range(n):
            cur += diff[i]
            bonus[i] = cur

        # binary search the minimum initial strength
        lo = 0
        hi = 10**18  # safe upper bound

        def can(S: int) -> bool:
            cur = S
            for i in range(n):
                if cur + bonus[i] >= monsters[i]:
                    cur = max(0, cur - monsters[i])
                else:
                    return False
            return True

        while lo < hi:
            mid = (lo + hi) // 2
            if can(mid):
                hi = mid
            else:
                lo = mid + 1
        return lo
