import bisect

class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n = len(words)
        # pos[i] = position of index i in target
        pos = [0] * n
        for p, i in enumerate(target):
            pos[i] = p
        
        # Build trie
        root = {'children': {}, 'pos': None}
        for i, w in enumerate(words):
            node = root
            for ch in w:
                if ch not in node['children']:
                    node['children'][ch] = {'children': {}, 'pos': None}
                node = node['children'][ch]
            node['pos'] = pos[i]   # mark the terminal node with its target position
        
        # DFS returns (minimum inversions in subtree, sorted list of all target positions in subtree)
        def dfs(node: dict):
            ans = 0
            child_sets = []
            
            # Process all children
            for ch, child in node['children'].items():
                child_ans, child_set = dfs(child)
                ans += child_ans
                child_sets.append(child_set)
            
            marked_pos = node['pos']
            
            # Unavoidable inversions: if this node is marked, it appears before all words in its subtrees
            if marked_pos is not None:
                marked_count = 0
                for cs in child_sets:
                    for x in cs:
                        if x < marked_pos:
                            marked_count += 1
                ans += marked_count
            
            # Cross inversions between different children
            k = len(child_sets)
            for i in range(k):
                for j in range(i + 1, k):
                    set_i = child_sets[i]
                    set_j = child_sets[j]
                    si = len(set_i)
                    sj = len(set_j)
                    
                    # Count pairs (x in set_i, y in set_j) with x > y
                    if si <= sj:
                        S = sum(bisect.bisect_left(set_j, x) for x in set_i)
                    else:
                        S = sum(si - bisect.bisect_left(set_i, y) for y in set_j)
                    
                    N = si * sj
                    ans += min(S, N - S)   # optimal order for this pair of children
            
            # Build the sorted list of all target positions in this subtree
            all_elements = []
            if marked_pos is not None:
                all_elements.append(marked_pos)
            for cs in child_sets:
                all_elements.extend(cs)
            full_set = sorted(all_elements)
            return ans, full_set
        
        return dfs(root)[0]
