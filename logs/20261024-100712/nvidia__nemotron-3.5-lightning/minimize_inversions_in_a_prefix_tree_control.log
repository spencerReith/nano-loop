        # Code structure:

        ```python
        import bisect

        class Solution:
            def minInversions(self, words: list[str], target: list[int]) -> int:
                n = len(words)
                # compute pos: pos[i] = position of index i in target
                pos = [0] * n
                for p, i in enumerate(target):
                    pos[i] = p
                
                # build trie
                root = {'children': {}, 'pos': None}
                for i, w in enumerate(words):
                    node = root
                    for ch in w:
                        if ch not in node['children']:
                            node['children'][ch] = {'children': {}, 'pos': None}
                        node = node['children'][ch]
                    node['pos'] = pos[i]
                
                # dfs
                def dfs(node):
                    ans = 0
                    child_sets = []
                    for ch, child in node['children'].items():
                        child_ans, child_set = dfs(child)
                        ans += child_ans
                        child_sets.append(child_set)
                    
                    marked_pos = node['pos']
                    
                    # unavoidable inversions from marked node
                    if marked_pos is not None:
                        marked_count = 0
                        for cs in child_sets:
                            for x in cs:
                                if x < marked_pos:
                                    marked_count += 1
                        ans += marked_count
                    
                    # cross inversions between children
                    k = len(child_sets)
                    for i in range(k):
                        for j in range(i+1, k):
                            set_i = child_sets[i]
                            set_j = child_sets[j]
                            si = len(set_i)
                            sj = len(set_j)
                            if si <= sj:
                                S = sum(bisect.bisect_left(set_j, x) for x in set_i)
                            else:
                                S = sum(si - bisect.bisect_left(set_i, y) for y in set_j)
                            N = si * sj
                            ans += min(S, N - S)
                    
                    # build full set for this node
                    all_elements = []
                    if marked_pos is not None:
                        all_elements.append(marked_pos)
                    for cs in child_sets:
                        all_elements.extend(cs)
                    full_set = sorted(all_elements)
                    return ans, full_set
                
                return dfs(root)[0]
        ```

