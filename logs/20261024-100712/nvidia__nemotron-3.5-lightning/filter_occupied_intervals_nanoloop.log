from typing import List

class Solution:
    def filterOccupiedIntervals(self, occupiedIntervals: List[List[int]], freeStart: int, freeEnd: int) -> List[List[int]]:
        if not occupiedIntervals:
            return []

        # Sort intervals by start, then by end
        occupiedIntervals.sort(key=lambda x: (x[0], x[1]))

        # Merge overlapping or touching intervals
        # Two intervals touch if the second starts immediately after the first ends
        merged = []
        cur_start, cur_end = occupiedIntervals[0]

        for start, end in occupiedIntervals[1:]:
            if start <= cur_end + 1:
                # Merge: extend cur_end if needed
                if end > cur_end:
                    cur_end = end
            else:
                merged.append([cur_start, cur_end])
                cur_start, cur_end = start, end

        merged.append([cur_start, cur_end])

        # Now remove the free interval [freeStart, freeEnd] from each merged interval
        result = []
        for start, end in merged:
            if end < freeStart or start > freeEnd:
                # No overlap
                result.append([start, end])
            else:
                # There is overlap; split around the free interval
                if start < freeStart:
                    result.append([start, freeStart - 1])
                if end > freeEnd:
                    result.append([freeEnd + 1, end])
                # If the interval is completely covered by the free interval, nothing added

        return result
