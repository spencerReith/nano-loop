class Solution:
    def filterOccupiedIntervals(self, occupiedIntervals: list[list[int]], freeStart: int, freeEnd: int) -> list[list[int]]:
        if not occupiedIntervals:
            return []

        # Step 1: sort intervals by start, then by end
        occupiedIntervals.sort(key=lambda x: (x[0], x[1]))

        # Step 2: merge overlapping or touching intervals
        merged = []
        cur_start, cur_end = occupiedIntervals[0]

        for start, end in occupiedIntervals[1:]:
            # intervals touch if start <= cur_end + 1
            if start <= cur_end + 1:
                # extend the current interval if needed
                if end > cur_end:
                    cur_end = end
            else:
                merged.append([cur_start, cur_end])
                cur_start, cur_end = start, end

        merged.append([cur_start, cur_end])

        # Step 3: subtract the free interval [freeStart, freeEnd] from each merged interval
        result = []
        for s, e in merged:
            if e < freeStart or s > freeEnd:
                # completely outside the free interval
                result.append([s, e])
            else:
                # there is an overlap
                # left part (if any)
                if s < freeStart:
                    result.append([s, freeStart - 1])
                # right part (if any)
                if e > freeEnd:
                    result.append([freeEnd + 1, e])
                # if both parts are empty, nothing is added

        return result
