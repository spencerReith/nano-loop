```python
from collections import deque
from typing import List


class Solution:
    def weightedSum(self, parent: List[int], nums: List[int]) -> int:
        n = len(parent)
        # Build adjacency list (children for each node)
        children = [[] for _ in range(n)]
        root = -1
        for i, p in enumerate(parent):
            if p == -1:
                root = i
            else:
                children[p].append(i)

        # BFS to compute depth of each node
        depth = [0] * n
        q = deque()
        q.append(root)
        depth[root] = 1
        max_depth = 1
        while q:
            node = q.popleft()
            for child in children[node]:
                depth[child] = depth[node] + 1
                if depth[child] > max_depth:
                    max_depth = depth[child]
                q.append(child)

        h = max_depth
        total = 0
        for i in range(n):
            d = depth[i]
            total += nums[i] * (h - d + 1)
        return total
