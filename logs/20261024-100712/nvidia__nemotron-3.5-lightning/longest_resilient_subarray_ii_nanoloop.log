from typing import List

class Solution:
    def resilientSubarray(self, nums: List[int], k: int) -> int:
        """
        Return the length of the longest resilient subarray.
        A subarray is resilient if, for every position in it,
        deleting the element at that position leaves the remaining
        elements with a sum divisible by k.
        """
        n = len(nums)
        # prefix sums modulo k
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = (pref[i] + nums[i]) % k

        # For a subarray nums[l..r] (inclusive), its sum modulo k is
        # (pref[r+1] - pref[l]) % k.
        # The condition "deleting nums[i] leaves sum divisible by k"
        # is equivalent to: (total - nums[i]) % k == 0  <=>  nums[i] % k == total % k.
        # So for the subarray to be resilient, every element must have the same
        # remainder modulo k as the total sum of the subarray.
        # This means all elements in the subarray must have the same remainder r,
        # and the total sum modulo k must also be r.
        # Since total % k = (count * r) % k, we need (count * r) % k == r.
        # If r == 0, the condition is always satisfied regardless of count.
        # If r != 0, we need (count - 1) % k == 0, i.e., count ≡ 1 (mod k).

        # We will scan the array and group consecutive elements by their remainder.
        # For each group of elements with the same remainder r, we can find the longest
        # subarray where the count satisfies the condition.
        ans = 0
        i = 0
        while i < n:
            r = nums[i] % k
            j = i
            while j < n and nums[j] % k == r:
                j += 1
            # group is nums[i:j] all with remainder r
            length = j - i
            if r == 0:
                # any length works
                ans = max(ans, length)
            else:
                # we need count ≡ 1 (mod k)
                # largest count <= length with count % k == 1
                max_count = 1 + ((length - 1) // k) * k if length >= 1 else 0
                ans = max(ans, max_count)
            i = j

        return ans
