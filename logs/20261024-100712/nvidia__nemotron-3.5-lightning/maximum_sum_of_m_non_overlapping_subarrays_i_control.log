class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        # prefix sums: pref[i] = sum of nums[0..i-1]
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]

        # dp[k][i] = maximum sum using at most k subarrays from nums[0..i-1]
        # we only need previous row, but keep full table for simplicity (n <= 1000)
        INF_NEG = -10**18
        dp = [[INF_NEG] * (n + 1) for _ in range(m + 1)]
        for k in range(m + 1):
            dp[k][0] = 0  # empty prefix, 0 sum with 0 subarrays

        for k in range(1, m + 1):
            for i in range(1, n + 1):
                # option 1: do not end a subarray at i-1
                best = dp[k][i - 1]
                # option 2: end a subarray of length len in [l, r] at i-1
                # start index j such that length len = i - j, l <= len <= r
                # => i - r <= j <= i - l
                left = i - r
                right = i - l
                if left >= 0 and right >= 0:
                    # we need max over j in [left, right] of dp[k-1][j] + pref[i] - pref[j]
                    # = pref[i] + max_{j}(dp[k-1][j] - pref[j])
                    max_val = INF_NEG
                    for j in range(left, right + 1):
                        val = dp[k - 1][j] - pref[j]
                        if val > max_val:
                            max_val = val
                    if max_val > INF_NEG // 2:
                        cand = pref[i] + max_val
                        if cand > best:
                            best = cand
                dp[k][i] = best

        # answer is max over k=1..m of dp[k][n]
        ans = max(dp[k][n] for k in range(1, m + 1))
        return ans

