class Solution:
    def maxPrimes(self, n: int, s: int) -> list[int]:
        # Generate all primes <= n using a simple sieve
        if n < 2:
            return []
        is_prime = [True] * (n + 1)
        is_prime[0] = is_prime[1] = False
        for i in range(2, int(n ** 0.5) + 1):
            if is_prime[i]:
                step = i
                start = i * i
                is_prime[start:n+1:step] = [False] * (((n - start) // step) + 1)
        primes = [i for i, val in enumerate(is_prime) if val]

        # Greedy selection: take the smallest primes until sum exceeds s
        selected = []
        current_sum = 0
        for p in primes:
            if current_sum + p <= s:
                selected.append(p)
                current_sum += p
            else:
                break

        return selected
