class Solution:
    def maxValue(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return nums[0]
        
        # compute original alternating sum
        orig = 0
        for i, v in enumerate(nums):
            if i % 2 == 0:
                orig += v
            else:
                orig -= v
        
        # a[i] = nums[i] * (-1)^i
        # P[k] = sum_{i=0}^{k-1} a[i], P[0] = 0
        P = [0] * (n + 1)
        for i in range(n):
            if i % 2 == 0:
                P[i+1] = P[i] + nums[i]
            else:
                P[i+1] = P[i] - nums[i]
        
        NEG_INF = -10**18
        
        # Case 1: l + r is odd
        # We maximize P[x] - P[y] over 0 <= x < y <= n, x+y even, y - x >= 2
        # y ranges from 2 to n
        max_even = P[0]  # x=0 is even, always available for y=2
        max_odd = NEG_INF
        best1 = NEG_INF
        for y in range(2, n + 1):
            if y % 2 == 0:
                candidate = max_even - P[y]
            else:
                candidate = max_odd - P[y]
            if candidate > best1:
                best1 = candidate
            # make P[y-1] available for future y's (x <= (y+1)-2 = y-1)
            if (y - 1) % 2 == 0:
                if P[y-1] > max_even:
                    max_even = P[y-1]
            else:
                if P[y-1] > max_odd:
                    max_odd = P[y-1]
        
        # Case 2: l + r is even
        # We maximize P[i] - P[j] over 1 <= i < j <= n, i+j even
        # j ranges from 2 to n
        max_even2 = NEG_INF
        max_odd2 = P[1]  # i=1 is odd, smallest valid i
        best2 = NEG_INF
        for j in range(2, n + 1):
            if j % 2 == 0:
                candidate = max_even2 - P[j]
            else:
                candidate = max_odd2 - P[j]
            if candidate > best2:
                best2 = candidate
            # make P[j] available for future j's (i <= j)
            if j % 2 == 0:
                if P[j] > max_even2:
                    max_even2 = P[j]
            else:
                if P[j] > max_odd2:
                    max_odd2 = P[j]
        
        delta1 = 2 * best1 if best1 > NEG_INF // 2 else NEG_INF
        delta2 = 2 * best2 if best2 > NEG_INF // 2 else NEG_INF
        max_gain = max(0, delta1, delta2)
        
        return orig + max_gain
``````python
class Solution:
    def maxValue(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return nums[0]
        
        # compute original alternating sum: even indices positive, odd negative
        orig = 0
        for i, v in enumerate(nums):
            if i % 2 == 0:
                orig += v
            else:
                orig -= v
        
        # P[k] = sum_{i=0}^{k-1} a[i] with a[i] = nums[i] * (-1)^i
        # P[0] = 0
        P = [0] * (n + 1)
        for i in range(n):
            if i % 2 == 0:
                P[i+1] = P[i] + nums[i]
            else:
                P[i+1] = P[i] - nums[i]
        
        NEG_INF = -10**18
        
        # Case 1: l + r is odd
        # We maximize P[x] - P[y] over 0 <= x < y <= n, x+y even, y - x >= 2
        # y ranges from 2 to n (since y = r+1, r >= 1)
        max_even = P[0]          # x = 0 is even, always available for y = 2
        max_odd = NEG_INF
        best1 = NEG_INF
        for y in range(2, n + 1):
            if y % 2 == 0:
                candidate = max_even - P[y]
            else:
                candidate = max_odd - P[y]
            if candidate > best1:
                best1 = candidate
            # make P[y-1] available for the next y (x <= (y+1)-2 = y-1)
            if (y - 1) % 2 == 0:
                if P[y-1] > max_even:
                    max_even = P[y-1]
            else:
                if P[y-1] > max_odd:
                    max_odd = P[y-1]
        
        # Case 2: l + r is even
        # We maximize P[i] - P[j] over 1 <= i < j <= n, i+j even
        # j ranges from 2 to n (j = r+1, r >= 1)
        max_even2 = NEG_INF
        max_odd2 = P[1]        # i = 1 is odd, the smallest valid i
        best2 = NEG_INF
        for j in range(2, n + 1):
            if j % 2 == 0:
                candidate = max_even2 - P[j]
            else:
                candidate = max_odd2 - P[j]
            if candidate > best2:
                best2 = candidate
            # make P[j] available for future j (i <= j)
            if j % 2 == 0:
                if P[j] > max_even2:
                    max_even2 = P[j]
            else:
                if P[j] > max_odd2:
                    max_odd2 = P[j]
        
        delta1 = 2 * best1 if best1 > NEG_INF // 2 else NEG_INF
        delta2 = 2 * best2 if best2 > NEG_INF // 2 else NEG_INF
        max_gain = max(0, delta1, delta2)
        
        return orig + max_gain
