from typing import List

class Solution:
    def findColoredRoot(self, edges: List[List[int]], colors: str) -> int:
        n = len(colors)
        # color_order[t][0] is the starting color for type t
        color_order = [['R','B','W'], ['B','W','R'], ['W','R','B']]
        # next color in the cycle for each type
        nxt_map = [
            {'R': 'B', 'B': 'W', 'W': 'R'},
            {'B': 'W', 'W': 'R', 'R': 'B'},
            {'W': 'R', 'R': 'B', 'B': 'W'}
        ]
        
        for t in range(3):
            # direct each edge according to the color cycle of type t
            directed = []  # list of (parent, child)
            valid = True
            for u, v in edges:
                cu = colors[u]
                cv = colors[v]
                if cv == nxt_map[t][cu]:
                    directed.append((u, v))
                elif cu == nxt_map[t][cv]:
                    directed.append((v, u))
                else:
                    valid = False
                    break
            if not valid:
                continue
            
            in_deg = [0] * n
            for u, v in directed:
                in_deg[v] += 1
            
            # exactly one root with in-degree 0
            roots = [i for i in range(n) if in_deg[i] == 0]
            if len(roots) != 1:
                continue
            # no node may have in-degree > 1
            if any(d > 1 for d in in_deg):
                continue
            
            r = roots[0]
            # root may have at most two children (undirected degree <= 2)
            out_deg_r = sum(1 for u, v in directed if u == r)
            if out_deg_r > 2:
                continue
            
            # root's color must match the start of the sequence type t
            if colors[r] != color_order[t][0]:
                continue
            
            return r
        
        return -1
