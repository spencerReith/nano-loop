Now, implement this in Python.

We need to build adjacency or just iterate edges. We have edges list.

Let's write the solution.

```python
from typing import List

class Solution:
    def findColoredRoot(self, edges: List[List[int]], colors: str) -> int:
        n = len(colors)
        # color_order[t] = expected colors at depth d % 3 for type t
        # but we only need the start color and next function.
        color_order = [['R','B','W'], ['B','W','R'], ['W','R','B']]
        
        # next color function for type t
        def nxt(t, c):
            if t == 0:
                if c == 'R': return 'B'
                if c == 'B': return 'W'
                return 'R'  # 'W'
            elif t == 1:
                if c == 'B': return 'W'
                if c == 'W': return 'R'
                return 'B'  # 'R'
            else:  # t == 2
                if c == 'W': return 'R'
                if c == 'R': return 'B'
                return 'W'  # 'B'
        
        # Alternatively, use a dict or list lookup.
        # Let's use a list of dicts for clarity.
        nxt_map = [
            {'R': 'B', 'B': 'W', 'W': 'R'},
            {'B': 'W', 'W': 'R', 'R': 'B'},
            {'W': 'R', 'R': 'B', 'B': 'W'}
        ]
        
        for t in range(3):
            # direct edges
            directed = []  # list of (parent, child)
            valid = True
            for u, v in edges:
                cu = colors[u]
                cv = colors[v]
                if cv == nxt_map[t][cu]:
                    directed.append((u, v))
                elif cu == nxt_map[t][cv]:
                    directed.append((v, u))
                else:
                    valid = False
                    break
            if not valid:
                continue
            
            in_deg = [0] * n
            for u, v in directed:
                in_deg[v] += 1
            
            roots = [i for i in range(n) if in_deg[i] == 0]
            if len(roots) != 1:
                continue
            if any(d > 1 for d in in_deg):
                continue
            
            r = roots[0]
            # check root out-degree <= 2
            out_deg_r = sum(1 for u, v in directed if u == r)
            if out_deg_r > 2:
                continue
            
            # check root color matches start of type t
            if colors[r] != color_order[t][0]:
                continue
            
            return r
        
        return -1
```

