class Solution:
    def lastVisitedCell(self, grid: list[list[str]]) -> list[int]:
        m = len(grid)
        n = len(grid[0])
        visited = [[False] * n for _ in range(m)]
        r, c = 0, 0
        visited[r][c] = True
        last_r, last_c = r, c
        while True:
            char = grid[r][c]
            if char == 'L':
                nc = c - 1
                nr = r
            elif char == 'R':
                nc = c + 1
                nr = r
            elif char == 'U':
                nc = c
                nr = r - 1
            else:  # 'D'
                nc = c
                nr = r + 1
            # check if move is invalid
            if nr < 0 or nr >= m or nc < 0 or nc >= n:
                break
            if visited[nr][nc]:
                break
            # make the move
            r, c = nr, nc
            visited[r][c] = True
            last_r, last_c = r, c
        return [last_r, last_c]
```


