class Solution:
    def lastVisitedCell(self, grid: list[list[str]]) -> list[int]:
        m, n = len(grid), len(grid[0])
        visited = [[False] * n for _ in range(m)]
        r, c = 0, 0
        visited[r][c] = True
        
        # Direction mappings
        dirs = {
            'L': (0, -1),
            'R': (0, 1),
            'U': (-1, 0),
            'D': (1, 0)
        }
        
        while True:
            ch = grid[r][c]
            dr, dc = dirs[ch]
            nr, nc = r + dr, c + dc
            
            # Stop if out of bounds or already visited
            if nr < 0 or nr >= m or nc < 0 or nc >= n or visited[nr][nc]:
                break
            
            # Move to the new cell
            r, c = nr, nc
            visited[r][c] = True
        
        return [r, c]
