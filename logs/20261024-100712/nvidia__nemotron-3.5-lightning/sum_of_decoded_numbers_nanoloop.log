from typing import List

class Solution:
    def sumDecoded(self, nums: List[int]) -> int:
        MOD = 10**9 + 7
        total = 0
        for num in nums:
            width = num % 10
            d = num // 10
            s = str(d)
            x_str = s[:width]
            y_str = s[width:]
            x = int(x_str)
            y = int(y_str)
            total = (total + pow(x, y, MOD)) % MOD
        return total
