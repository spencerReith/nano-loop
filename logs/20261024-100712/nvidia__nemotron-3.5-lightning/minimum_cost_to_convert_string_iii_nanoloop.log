```python
class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n = len(source)
        
        # Precompute for each rule: (base_cost_with_stars, pattern_len, list of valid start positions)
        rule_data = []
        for pattern, replacement, cost in zip([r[0] for r in rules], [r[1] for r in rules], costs):
            star_count = pattern.count('*')
            base_cost = cost + star_count
            plen = len(pattern)
            
            # Find all start positions where this rule can be applied
            valid_starts = []
            for start in range(n - plen + 1):
                # Check pattern matching against source
                matches_source = True
                for j, pc in enumerate(pattern):
                    if pc != '*' and pc != source[start + j]:
                        matches_source = False
                        break
                
                # Check replacement matching against target
                matches_target = True
                for j, rc in enumerate(replacement):
                    if rc != target[start + j]:
                        matches_target = False
                        break
                
                if matches_source and matches_target:
                    valid_starts.append(start)
            
            rule_data.append((base_cost, plen, valid_starts))
        
        # DP: dp[i] = minimum cost for positions i..n-1
        dp = [float('inf')] * (n + 1)
        dp[n] = 0
        
        # For fast lookup, convert valid_starts to sets
        rule_starts_set = [set(starts) for _, _, starts in rule_data]
        
        for i in range(n - 1, -1, -1):
            # Option 1: skip position i if source[i] == target[i]
            if source[i] == target[i]:
                dp[i] = dp[i + 1]
            
            # Option 2: apply a rule starting at position i
            for idx, (base_cost, plen, starts_set) in enumerate(rule_data):
                if i in starts_set:
                    # Rule can start at position i
                    new_cost = base_cost + dp[i + plen]
                    if new_cost < dp[i]:
                        dp[i] = new_cost
        
        return dp[0] if dp[0] != float('inf') else -1
```

