class Solution:
    def minOperations(self, s: str) -> int:
        n = len(s)
        best = float('inf')
        for rot in range(n):
            t = s[rot:] + s[:rot]
            ops = 0
            for i in range(n // 2):
                j = n - 1 - i
                a = ord(t[i]) - ord('a')
                b = ord(t[j]) - ord('a')
                # Minimal increments to make a and b equal, allowing wrap-around.
                # Try all 26 possible target characters.
                wrap_ops = 50
                for target in range(26):
                    cost = ((target - a) % 26) + ((target - b) % 26)
                    if cost < wrap_ops:
                        wrap_ops = cost
                ops += wrap_ops
            total = rot + ops
            if total < best:
                best = total
        return best
