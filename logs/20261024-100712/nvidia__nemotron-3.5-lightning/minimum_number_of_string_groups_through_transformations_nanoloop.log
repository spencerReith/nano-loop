from collections import defaultdict

class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        def least_rotation_index(s: str) -> int:
            """Booth's algorithm: returns starting index of least lexicographic rotation of s."""
            n = len(s)
            if n <= 1:
                return 0
            s2 = s + s
            f = [-1] * (2 * n)
            k = 0
            for j in range(1, 2 * n):
                i = f[j - k - 1] if j > k else -1
                while i != -1 and s2[j] != s2[k + i + 1]:
                    if s2[j] < s2[k + i + 1]:
                        k = j - i - 1
                    i = f[i]
                if i == -1 and s2[j] != s2[k]:
                    if s2[j] < s2[k]:
                        k = j
                    f[j - k] = -1
                else:
                    f[j - k] = i + 1
            return k % n

        def canonical_key(word: str):
            n = len(word)
            even_chars = [word[i] for i in range(0, n, 2)]
            odd_chars = [word[i] for i in range(1, n, 2)]
            even_str = ''.join(even_chars)
            odd_str = ''.join(odd_chars)
            idx_even = least_rotation_index(even_str)
            idx_odd = least_rotation_index(odd_str)
            min_even = even_str[idx_even:] + even_str[:idx_even] if even_str else ""
            min_odd = odd_str[idx_odd:] + odd_str[:idx_odd] if odd_str else ""
            return (min_even, min_odd)

        groups = set()
        for w in words:
            groups.add(canonical_key(w))
        return len(groups)
