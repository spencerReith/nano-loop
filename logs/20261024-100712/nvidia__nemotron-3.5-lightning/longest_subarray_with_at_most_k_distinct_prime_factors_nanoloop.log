```python
from collections import defaultdict
from math import isqrt

class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        # Precompute smallest prime factor (SPF) for sieve up to max(nums)
        max_val = max(nums) if nums else 0
        spf = list(range(max_val + 1))
        for i in range(2, isqrt(max_val) + 1):
            if spf[i] == i:  # i is prime
                for j in range(i * i, max_val + 1, i):
                    if spf[j] == j:
                        spf[j] = i

        # Function to get distinct prime factors of a number using SPF
        def get_prime_factors(x: int) -> list[int]:
            factors = []
            while x > 1:
                p = spf[x]
                factors.append(p)
                while x % p == 0:
                    x //= p
            return factors

        freq = defaultdict(int)  # prime -> count in current window
        distinct = 0  # number of distinct primes in current window
        left = 0
        ans = 0

        for right, val in enumerate(nums):
            factors = get_prime_factors(val)
            for p in factors:
                if freq[p] == 0:
                    distinct += 1
                freq[p] += 1

            # Shrink window until distinct <= k
            while distinct > k:
                left_factors = get_prime_factors(nums[left])
                for p in left_factors:
                    freq[p] -= 1
                    if freq[p] == 0:
                        distinct -= 1
                left += 1

            # Window [left, right] is valid
            ans = max(ans, right - left + 1)

        return ans
