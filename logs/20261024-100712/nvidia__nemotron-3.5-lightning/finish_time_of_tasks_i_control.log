class Solution:
    def finishTime(self, n: int, edges: list[list[int]], baseTime: list[int]) -> int:
        # Build adjacency list of children for each node
        children = [[] for _ in range(n)]
        for u, v in edges:
            children[u].append(v)

        # Iterative post-order DFS using a stack of (node, visited_flag)
        stack = [(0, False)]
        finish = [0] * n  # finish[i] will store the finish time of task i

        while stack:
            node, visited = stack.pop()
            if not visited:
                # Push the node again marked as visited, then push its children
                stack.append((node, True))
                for child in children[node]:
                    stack.append((child, False))
            else:
                # All children have been processed, compute finish time
                if not children[node]:
                    # Leaf task
                    finish[node] = baseTime[node]
                else:
                    # Gather finish times of children
                    child_finish = [finish[c] for c in children[node]]
                    earliest = min(child_finish)
                    latest = max(child_finish)
                    own_duration = (latest - earliest) + baseTime[node]
                    finish[node] = latest + own_duration

        return finish[0]
