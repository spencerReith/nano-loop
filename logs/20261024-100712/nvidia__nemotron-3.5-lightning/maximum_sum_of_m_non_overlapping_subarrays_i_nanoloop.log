```python
class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        NEG_INF = -10**18
        
        # prefix sums
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]
        
        # dp[k][i] = maximum sum using exactly k non-overlapping subarrays
        # from the first i elements (nums[0:i]), each subarray length in [l, r].
        # dp[0][i] = 0 for all i (0 subarrays gives sum 0).
        # dp[k][0] = NEG_INF for k >= 1 (can't have k>0 subarrays from 0 elements).
        dp = [[NEG_INF] * (n + 1) for _ in range(m + 1)]
        for i in range(n + 1):
            dp[0][i] = 0
        
        from collections import deque
        
        for k in range(1, m + 1):
            dq = deque()
            for i in range(1, n + 1):
                # Add j = i - l to the sliding window if i >= l
                if i >= l:
                    j_new = i - l
                    if dp[k-1][j_new] != NEG_INF:
                        val = dp[k-1][j_new] - pref[j_new]
                        # Maintain decreasing order of val in deque
                        while dq and (dp[k-1][dq[-1]] - pref[dq[-1]]) <= val:
                            dq.pop()
                        dq.append(j_new)
                
                # Remove j = i - r - 1 which is now out of the window [i-r, i-l]
                j_old = i - r - 1
                if j_old >= 0 and dq and dq[0] == j_old:
                    dq.popleft()
                
                # best = max_{j in window} (dp[k-1][j] - pref[j])
                if dq:
                    best = dp[k-1][dq[0]] - pref[dq[0]]
                else:
                    best = NEG_INF
                
                # dp[k][i]: either skip nums[i-1], or end a subarray at i-1
                dp[k][i] = dp[k][i-1]
                if best != NEG_INF:
                    dp[k][i] = max(dp[k][i], best + pref[i])
        
        # Answer is the maximum over using exactly k subarrays for k = 1..m
        ans = max(dp[k][n] for k in range(1, m + 1))
        return ans
```

