class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        # Precompute smallest prime factor (spf) up to max(nums) for fast factorization
        max_val = max(nums)
        spf = list(range(max_val + 1))
        for i in range(2, int(max_val ** 0.5) + 1):
            if spf[i] == i:  # i is prime
                for j in range(i * i, max_val + 1, i):
                    if spf[j] == j:
                        spf[j] = i

        # Helper to return distinct prime factors of a number using spf
        def distinct_primes(x: int):
            primes = []
            while x > 1:
                p = spf[x]
                primes.append(p)
                while x % p == 0:
                    x //= p
            return primes

        # Precompute distinct prime factors for each element to avoid repeated work
        primes_list = [distinct_primes(v) for v in nums]

        freq = {}          # prime -> count in current window
        distinct = 0       # number of primes with count > 0 in the window
        left = 0
        best = 0

        for right, pfs in enumerate(primes_list):
            # Add primes of nums[right] into the window
            for p in pfs:
                cnt = freq.get(p, 0)
                if cnt == 0:
                    distinct += 1
                freq[p] = cnt + 1

            # Shrink window from the left while we have too many distinct primes
            while distinct > k:
                for p in primes_list[left]:
                    cnt = freq[p]
                    if cnt == 1:
                        distinct -= 1
                        del freq[p]
                    else:
                        freq[p] = cnt - 1
                left += 1

            # Window [left, right] is now valid
            best = max(best, right - left + 1)

        return best
