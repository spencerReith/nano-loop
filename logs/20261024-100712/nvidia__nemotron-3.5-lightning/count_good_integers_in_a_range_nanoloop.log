```python
def count_good_upto(x: int, k: int) -> int:
    if x < 10:
        return 0
    s = str(x)
    n = len(s)
    
    # Count all good numbers with length L (2 <= L < n)
    # For these, first digit 1-9, subsequent digits 0-9 with abs diff <= k
    # We can precompute or use DP without tight.
    
    # Function to count good numbers of exactly length L (first digit 1-9, rest 0-9)
    def count_exact_len(L: int) -> int:
        # DP: pos from 0 to L-1, prev digit
        from functools import lru_cache
        @lru_cache(None)
        def f(pos: int, prev: int) -> int:
            if pos == L:
                return 1
            start = 1 if pos == 0 else 0
            total = 0
            for d in range(start, 10):
                if pos == 0 or abs(d - prev) <= k:
                    total += f(pos + 1, d)
            return total
        return f(0, 0)  # prev unused for pos=0
    
    total = 0
    for L in range(2, n):
        total += count_exact_len(L)
    
    # Now count good numbers of length n that are <= x
    # Standard digit DP with first digit 1..limit, no leading zeros.
    @lru_cache(None)
    def dp(pos: int, prev: int, tight: bool) -> int:
        # pos: 0..n, we are about to place digit at pos (0-indexed from left)
        # prev: previous digit, for pos=0 there is no prev (but we handle separately)
        if pos == n:
            return 1
        limit = int(s[pos]) if tight else 9
        total = 0
        start = 1 if pos == 0 else 0
        for d in range(start, limit + 1):
            ntight = tight and (d == limit)
            if pos == 0:
                total += dp(pos + 1, d, ntight)
            else:
                if abs(d - prev) <= k:
                    total += dp(pos + 1, d, ntight)
        return total
    
    total += dp(0, 0, True)  # prev=0 unused for pos=0
    return total
```

