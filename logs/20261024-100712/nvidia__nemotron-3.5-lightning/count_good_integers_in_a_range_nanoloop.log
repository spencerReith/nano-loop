```python
class Solution:
    def goodIntegers(self, l: int, r: int, k: int) -> int:
        def count_good_upto(x: int) -> int:
            if x < 10:
                return 0
            s = str(x)
            n = len(s)
            
            # Count all good numbers with exactly length L (2 <= L < n)
            from functools import lru_cache
            
            def count_exact_len(L: int) -> int:
                @lru_cache(None)
                def f(pos: int, prev: int) -> int:
                    if pos == L:
                        return 1
                    start = 1 if pos == 0 else 0
                    total = 0
                    for d in range(start, 10):
                        if pos == 0 or abs(d - prev) <= k:
                            total += f(pos + 1, d)
                    return total
                return f(0, 0)
            
            total = 0
            for L in range(2, n):
                total += count_exact_len(L)
            
            # Count good numbers of length n that are <= x
            @lru_cache(None)
            def dp(pos: int, prev: int, tight: bool) -> int:
                if pos == n:
                    return 1
                limit = int(s[pos]) if tight else 9
                total = 0
                start = 1 if pos == 0 else 0
                for d in range(start, limit + 1):
                    ntight = tight and (d == limit)
                    if pos == 0:
                        total += dp(pos + 1, d, ntight)
                    else:
                        if abs(d - prev) <= k:
                            total += dp(pos + 1, d, ntight)
                return total
            
            total += dp(0, 0, True)
            return total
        
        return count_good_upto(r) - count_good_upto(l - 1)
```

