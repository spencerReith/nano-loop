```python
class Solution:
    def goodIntegers(self, l: int, r: int, k: int) -> int:
        def count_good_upto(x: int) -> int:
            if x < 10:
                return 0
            s = str(x)
            n = len(s)
            from functools import lru_cache

            # Count good numbers with exactly length L (2 <= L <= n) that are <= x
            # For L < n, we count all good numbers of length L (first digit 1-9, rest 0-9)
            # For L == n, we count good numbers of length n that are <= x
            
            total = 0
            
            # For lengths less than n, just count all good numbers of that length
            for L in range(2, n):
                # count good numbers of exactly L digits
                # first digit: 1-9, then each next digit must have abs diff <= k with previous
                # We can use DP without tight constraint
                @lru_cache(None)
                def count_len(L: int, pos: int, prev: int) -> int:
                    # pos: current position from 0 to L-1, we have already placed pos digits?
                    # Let's do: pos is the index we are about to place (0..L-1)
                    # For pos=0, we choose first digit 1-9
                    # For pos>0, we choose digit 0-9 with abs(d - prev) <= k
                    if pos == L:
                        return 1
                    start = 1 if pos == 0 else 0
                    limit = 9
                    total = 0
                    for d in range(start, limit + 1):
                        if pos == 0 or abs(d - prev) <= k:
                            total += count_len(L, pos + 1, d)
                    return total
                
                total += count_len(L, 0, 0)  # prev unused for pos=0
            
            # Now for length == n, count good numbers <= x
            @lru_cache(None)
            def dp(pos: int, prev: int, tight: bool, started: bool) -> int:
                # We will ensure started is handled by starting with first digit 1..limit
                if pos == n:
                    return 1 if started else 0
                limit = int(s[pos]) if tight else 9
                total = 0
                # determine start digit range
                if not started:
                    # we can place 0 or start with 1..limit
                    for d in range(0, limit + 1):
                        ntight = tight and (d == limit)
                        if d == 0:
                            total += dp(pos + 1, 0, ntight, False)
                        else:
                            total += dp(pos + 1, d, ntight, True)
                else:
                    for d in range(0, limit + 1):
                        if abs(d - prev) <= k:
                            ntight = tight and (d == limit)
                            total += dp(pos + 1, d, ntight, True)
                return total
            
            total += dp(0, 0, True, False)
            return total
        
        return count_good_upto(r) - count_good_upto(l - 1)
```

