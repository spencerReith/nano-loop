class Solution:
    def maxTotalValue(self, value: list[int], decay: list[int], m: int) -> int:
        MOD = 10**9 + 7
        
        # Counts how many selections have value > X, and their total sum.
        def count_greater(X: int):
            cnt = 0
            s = 0
            for v, d in zip(value, decay):
                if v > X:
                    # number of terms > X: largest t such that v - d*(t-1) > X
                    k = (v - X - 1) // d + 1
                    cnt += k
                    last = v - d * (k - 1)
                    s += k * (v + last) // 2
            return cnt, s
        
        total_pos, total_sum = count_greater(0)
        
        # If we can take all positive selections and still have m left,
        # the answer is simply the sum of all positive values.
        if m >= total_pos:
            return total_sum % MOD
        
        # Counts how many selections have value >= X, and their total sum.
        def count_ge(X: int):
            cnt = 0
            s = 0
            for v, d in zip(value, decay):
                if v >= X:
                    # number of terms >= X: largest t such that v - d*(t-1) >= X
                    k = (v - X) // d + 1
                    cnt += k
                    last = v - d * (k - 1)
                    s += k * (v + last) // 2
            return cnt, s
        
        max_val = max(value)
        lo, hi = 1, max_val
        
        # Binary search for the largest X such that at least m values are >= X.
        # This X is the m-th largest value (the threshold T).
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if count_ge(mid)[0] >= m:
                lo = mid
            else:
                hi = mid - 1
        T = lo
        
        # Number and sum of values strictly greater than T.
        cnt_greater, sum_greater = count_greater(T)
        
        # Take all values > T, and fill the rest with copies of T.
        ans = sum_greater + (m - cnt_greater) * T
        return ans % MOD
