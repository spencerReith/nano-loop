class Solution:
    def maxTotal(self, nums: list[int], s: str) -> int:
        n = len(nums)
        F_prev = 0
        T_prev = 0
        for i in range(n):
            if s[i] == '0':
                F_cur = F_prev
                T_cur = nums[i] + F_prev
            else:
                F_cur = max(nums[i] + F_prev, T_prev)
                T_cur = nums[i] + max(F_prev, T_prev)
            F_prev, T_prev = F_cur, T_cur
        return F_prev
