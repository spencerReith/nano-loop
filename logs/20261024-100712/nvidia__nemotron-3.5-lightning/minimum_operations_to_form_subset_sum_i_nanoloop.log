from typing import List

class Solution:
    def minOperations(self, nums: List[int], sum: int) -> int:
        INF = 10**9
        
        def get_reachable(x: int, max_sum: int) -> dict:
            """Return dict: value -> minimum operations to reach that value from x,
            considering only values <= max_sum."""
            reach = {}
            # Multiplications: start with x, repeatedly multiply by 2
            v = x
            cost = 0
            while v <= max_sum:
                if v not in reach or cost < reach[v]:
                    reach[v] = cost
                v *= 2
                cost += 1
            # Divisions: start with x, repeatedly floor divide by 2
            v = x
            cost = 0
            while v > 0:
                if v not in reach or cost < reach[v]:
                    reach[v] = cost
                v //= 2
                cost += 1
            return reach
        
        dp = [INF] * (sum + 1)
        dp[0] = 0
        
        for x in nums:
            reach = get_reachable(x, sum)
            new_dp = dp[:]  # copy current dp
            for s in range(sum + 1):
                if dp[s] == INF:
                    continue
                for val, cost in reach.items():
                    if s + val <= sum:
                        if dp[s] + cost < new_dp[s + val]:
                            new_dp[s + val] = dp[s] + cost
            dp = new_dp
        
        return dp[sum] if dp[sum] != INF else -1
