class Solution:
    def kthDigit(self, k: int) -> int:
        if k <= 9:
            return k
        
        cumulative = 9
        d = 1
        while True:
            d += 1
            total_d = 9 * (10 ** (d - 1)) * d
            if cumulative + total_d >= k:
                remaining_k = k - cumulative
                break
            cumulative += total_d
        
        start_b = 10 ** (d - 2)
        block_index = (remaining_k - 1) // (10 * d)
        pos_in_block = (remaining_k - 1) % (10 * d)
        b = start_b + block_index
        num_idx = pos_in_block // d
        digit_idx = pos_in_block % d
        
        if b % 2 == 0:
            num = 10 * b + num_idx
        else:
            num = 10 * b + (9 - num_idx)
        
        return int(str(num)[digit_idx])
