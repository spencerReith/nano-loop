```python
from typing import List

class Solution:
    def maxSum(self, nums: List[int], k: int, mul: int) -> int:
        nums.sort(reverse=True)
        selected = nums[:k]
        total = 0
        for i in range(k):
            multiplier = mul - i
            if multiplier > 1:
                total += selected[i] * multiplier
            else:
                total += selected[i]
        return total
