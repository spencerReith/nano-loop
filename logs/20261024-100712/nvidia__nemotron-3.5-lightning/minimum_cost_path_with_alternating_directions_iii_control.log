                            changed = True

                    # If we are at (i,j) with next action even (dp0), moving right violates parity.
                    # Pay penalty[i][j] + destination entrance cost.
                    if dp0_arr[idx] < INF:
                        move_cost = (i + 1) * (j + 2) + pen[i][j]
                        # After violating move, next action flips to even? 
                        # "After every move or wait, the action number increases by 1. Therefore, the required parity alternates after every action, regardless of whether a penalty was paid."
                        # So next action becomes odd (since we used an action). Wait: we started with next even, used action -> next becomes odd.
                        # So we update dp1 at destination.
                        cand = dp0_arr[idx] + move_cost
                        if cand < dp1_arr[dest]:
                            dp1_arr[dest] = cand
                            changed = True

                # Moving down: from (i, j) to (i+1, j)
                if i + 1 < m:
                    dest = (i + 1) * n + j
                    # Follows parity if next action odd (dp1)
                    if dp1_arr[idx] < INF:
                        move_cost = (i + 2) * (j + 1)  # dest (i+1,j): cost = ((i+1)+1)*(j+1) = (i+2)*(j+1)
                        cand = dp1_arr[idx] + move_cost
                        if cand < dp0_arr[dest]:
                            dp0_arr[dest] = cand
                            changed = True

                    # Violates parity if next action even (dp0)
                    if dp0_arr[idx] < INF:
                        move_cost = (i + 2) * (j + 1) + pen[i][j]
                        # next action becomes odd
                        cand = dp0_arr[idx] + move_cost
                        if cand < dp1_arr[dest]:
                            dp1_arr[dest] = cand
                            changed = True

                # Moving left: from (i, j) to (i, j-1)  (only valid if j > 0)
                if j > 0:
                    dest = i * n + (j - 1)
                    # Follows parity if next action even (dp0) -> move left
                    if dp0_arr[idx] < INF:
                        move_cost = (i + 1) * j  # dest (i, j-1): cost = (i+1)*((j-1)+1) = (i+1)*j
                        cand = dp0_arr[idx] + move_cost
                        if cand < dp1_arr[dest]:  # after move next action odd
                            dp1_arr[dest] = cand
                            changed = True

                    # Violates parity if next action odd (dp1) -> move left
                    if dp1_arr[idx] < INF:
                        move_cost = (i + 1) * j + pen[i][j]
                        cand = dp1_arr[idx] + move_cost
                        if cand < dp0_arr[dest]:  # after move next action even
                            dp0_arr[dest] = cand
                            changed = True

                # Moving up: from (i, j) to (i-1, j) (only if i > 0)
                if i > 0:
                    dest = (i - 1) * n + j
                    # Follows parity if next action even (dp0) -> move up
                    if dp0_arr[idx] < INF:
                        move_cost = i * (j + 1)  # dest (i-1,j): cost = (i-1+1)*(j+1) = i*(j+1)
                        cand = dp0_arr[idx] + move_cost
                        if cand < dp1_arr[dest]:
                            dp1_arr[dest] = cand
                            changed = True

                    # Violates parity if next action odd (dp1) -> move up
                    if dp1_arr[idx] < INF:
                        move_cost = i * (j + 1) + pen[i][j]
                        cand = dp1_arr[idx] + move_cost
                        if cand < dp0_arr[dest]:
                            dp0_arr[dest] = cand
                            changed = True

        # The answer is the minimum cost to reach (m-1, n-1) with any parity of next action.
        # But we must have actually arrived there; the cost already includes entrance cost of target.
        target = (m - 1) * n + (n - 1)
        ans = min(dp0_arr[target], dp1_arr[target])
        return ans
