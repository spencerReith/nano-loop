class Solution:
    def minCost(self, m: int, n: int, penalty: list[list[int]]) -> int:
        # dp0: minimum cost to reach the current cell with even action number
        # dp1: minimum cost to reach the current cell with odd action number
        INF = 10**18

        dp0 = dp1 = INF
        # start at (0, 0) before any action; the entrance cost of (0,0) is paid first
        dp0 = dp1 = (0 + 1) * (0 + 1)  # cost of cell (0,0)

        # We will iterate over all cells in row-major order.
        # For each cell we compute the best dp0/dp1 that ends at this cell.
        # Since moves are only right/down on odd steps and left/up on even steps,
        # the reachable predecessors for a cell (i, j) are:
        #   - from left (i, j-1) via a right move (needs odd step -> dp1 predecessor)
        #   - from up   (i-1, j) via a down move (needs odd step -> dp1 predecessor)
        #   - from right (i, j+1) via a left move (needs even step -> dp0 predecessor)
        #   - from down (i+1, j) via an up move (needs even step -> dp0 predecessor)
        # We process cells such that when we are at (i,j), the predecessor states
        # have already been finalised. Because moves can go left/up as well,
        # a single pass is not enough; we run a relaxation loop until no improvement.

        # However, m*n <= 1e5, so we can just perform a Dijkstra-like DP
        # or simply iterate a few times (the grid is a DAG if we consider
        # action parity, but waiting can create cycles. We'll use a queue-based
        # Bellman-Ford style relaxation limited by the small size.)

        cells = m * n
        # flatten penalty for quick access
        pen = [[penalty[i][j] for j in range(n)] for i in range(m)]

        # dp arrays indexed by linear cell id = i*n + j
        dp0_arr = [INF] * cells
        dp1_arr = [INF] * cells

        start_id = 0
        dp0_arr[start_id] = dp1_arr[start_id] = pen[0][0]  # (0+1)*(0+1)

        # We will repeatedly relax edges until convergence.
        # Since each relaxation reduces cost and costs are non‑negative,
        # at most O(cells * max_steps) iterations are needed.
        # Given constraints (cells <= 1e5) and 5s limit, a few thousand
        # iterations are fine. We'll use a simple while loop with a flag.

        changed = True
        # To avoid extremely deep loops, set a safety bound.
        max_iters = cells * 10 + 5
        iters = 0

        while changed and iters < max_iters:
            changed = False
            iters += 1

            for idx in range(cells):
                i = idx // n
                j = idx % n

                # current best costs arriving at (i,j) with even/odd action parity
                cur0 = dp0_arr[idx]
                cur1 = dp1_arr[idx]

                # ---- transitions FROM (i,j) to neighbours ----
                # action number parity after being at (i,j):
                # if we arrived with even parity (cur0), next action is odd.
                # if we arrived with odd parity (cur1), next action is even.

                # 1) Wait in place:
                #   - paying penalty[i][j] flips parity?
                #   The problem says: "If you wait in cell (i,j), pay penalty[i][j].
                #    After every move or wait, the action number increases by 1.
                #    Therefore, the required parity alternates after every action,
                #    regardless of whether a penalty was paid."
                #   So waiting always flips the parity of the action number.
                #   If we wait from a state with even action parity (meaning the next
                #   action would be odd), after wait the next action becomes even,
                #   and we stay in the same cell but with updated parity.
                #   We model this as: from cur0 we can go to a new even state? 
                #   Let's define dp0 = min cost to be at cell with the next action being even.
                #   dp1 = min cost to be at cell with the next action being odd.
                #   Initially at (0,0) we have paid entrance cost, and the "next action" is 1 (odd) -> dp1.
                #   Wait flips parity: waiting from dp1 -> next action even -> dp0.
                #   waiting from dp0 -> next action odd -> dp1.
                #   cost added = penalty[i][j]

                # Wait transitions
                if cur0 < INF:
                    # currently next action is odd (since dp1 meant odd? Let's standardise)
                    # We'll keep: dp0 = cost when the *next* action number is even.
                    # dp1 = cost when the *next* action number is odd.
                    # Initially at (0,0) after paying entrance cost, the next action is 1 (odd) => dp1.
                    # Wait: next action flips. So from dp1 (next odd) wait -> next even => dp0.
                    # from dp0 (next even) wait -> next odd => dp1.
                    # Let's re-evaluate with example 2:
                    # start: cost 1, next action 1 (odd) -> dp1 = 1, dp0 = INF
                    # wait: pay penalty[0][0]=0, action becomes 2 (even). Now we are at (0,0) with next action even.
                    # So dp0 should become 1+0 = 1.
                    # This matches example 2 where they wait then move right (action 2 even? wait rule: even action move left/up, but they move right violating rule).
                    # Actually example 2: Move 1 Wait (action 1->2), Move 2 Move right (action 2 even, move right violates rule -> pay penalty[0][0]).
                    # So after wait, next action is 2 (even). They then move right (violating even rule).
                    # So our dp states: dp0 = min cost to be at cell with next action even.
                    # dp1 = min cost to be at cell with next action odd.
                    # Initially: next action 1 odd -> dp1 = entrance cost, dp0 = INF.

                    # Wait from dp1 (next odd) -> next even -> dp0
                    new_val = cur1 + pen[i][j]
                    if new_val < dp0_arr[idx]:
                        dp0_arr[idx] = new_val
                        changed = True
                if cur1 < INF:
                    # Wait from dp1 (next odd) already handled above? Wait we need from dp0 as well.
                    # Wait from dp0 (next even) -> next odd -> dp1
                    new_val = cur0 + pen[i][j]
                    if new_val < dp1_arr[idx]:
                        dp1_arr[idx] = new_val
                        changed = True

                # 2) Move according to parity rule (no penalty)
                #    Odd action (next action odd -> dp1) => move right or down.
                #    Even action (next action even -> dp0) => move left or up.

                # Moving right: from (i, j) to (i, j+1)
                if j + 1 < n:
                    dest = i * n + (j + 1)
                    # If we are at (i,j) with next action odd (dp1), moving right follows parity -> no penalty.
                    # The cost added is entrance cost of destination cell: (i+1)*(j+2)
                    # After move, next action becomes even (since we used one action).
                    # So we transition dp1_arr[idx] -> dp0_arr[dest]
                    if dp1_arr[idx] < INF:
                        move_cost = (i + 1) * (j + 2)  # (dest i+1)*(dest j+1) but dest j = j+1
                        # Actually destination cell (i, j+1): cost = (i+1)*((j+1)+1) = (i+1)*(j+2)
                        # After move, next action flips to even, so we update dp0 at destination.
                        cand = dp1_arr[idx] + move_cost
                        if cand < dp0_arr[dest]:
