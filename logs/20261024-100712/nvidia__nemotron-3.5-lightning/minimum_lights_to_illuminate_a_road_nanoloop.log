```python
class Solution:
    def minLights(self, lights: list[int]) -> int:
        n = len(lights)
        # max_reach[i] = farthest right position reachable by a working bulb 
        # whose leftmost illuminated position is i. Initialize with -1.
        max_reach = [-1] * n
        for i, v in enumerate(lights):
            if v > 0:
                left = max(0, i - v)
                right = min(n - 1, i + v)
                if right > max_reach[left]:
                    max_reach[left] = right
        
        additional = 0
        cur = -1  # rightmost covered position (inclusive)
        for i in range(n):
            # incorporate working bulbs that start at or before i
            if max_reach[i] > cur:
                cur = max_reach[i]
            # if position i is not covered, place an additional bulb
            if i > cur:
                # place at i+1 if possible, else at i (which is n-1)
                place = i + 1
                if place >= n:
                    place = i
                # the new bulb covers up to place + 1 (capped at n-1)
                new_cur = place + 1
                if new_cur > n - 1:
                    new_cur = n - 1
                cur = new_cur
                additional += 1
        
        return additional
```

