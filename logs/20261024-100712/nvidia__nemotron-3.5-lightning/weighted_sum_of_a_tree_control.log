class Solution:
    def weightedSum(self, parent: list[int], nums: list[int]) -> int:
        n = len(parent)
        # Build adjacency list for children
        children = [[] for _ in range(n)]
        root = -1
        for i, p in enumerate(parent):
            if p == -1:
                root = i
            else:
                children[p].append(i)

        # Compute depth of each node using an iterative DFS
        depth = [0] * n
        stack = [(root, 1)]  # (node, depth)
        while stack:
            node, d = stack.pop()
            depth[node] = d
            for ch in children[node]:
                stack.append((ch, d + 1))

        # Height of the tree is the maximum depth
        h = max(depth)

        # Calculate the weighted sum
        total = 0
        for i in range(n):
            total += nums[i] * (h - depth[i] + 1)
        return total
