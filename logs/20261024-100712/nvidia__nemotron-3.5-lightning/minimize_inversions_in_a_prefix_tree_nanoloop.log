from typing import List

class Solution:
    def minInversions(self, words: List[str], target: List[int]) -> int:
        n = len(words)
        # pos[i] = position of index i in target
        pos = [0] * n
        for j, p in enumerate(target):
            pos[p] = j

        # Build trie
        # node_children: list of dicts, char -> child node id
        # node_is_end: bool list
        # node_word_idx: int list, -1 if not end
        node_children = [{}]  # root at 0
        node_is_end = [False]
        node_word_idx = [-1]

        for i, w in enumerate(words):
            node = 0
            for ch in w:
                if ch not in node_children[node]:
                    new_id = len(node_children)
                    node_children.append({})
                    node_is_end.append(False)
                    node_word_idx.append(-1)
                    node_children[node][ch] = new_id
                node = node_children[node][ch]
            node_is_end[node] = True
            node_word_idx[node] = i

        # merge sort inversion count
        def merge_count(arr):
            if len(arr) <= 1:
                return arr, 0
            mid = len(arr) // 2
            left, lc = merge_count(arr[:mid])
            right, rc = merge_count(arr[mid:])
            merged = []
            i = j = 0
            inversions = lc + rc
            while i < len(left) and j < len(right):
                if left[i] <= right[j]:
                    merged.append(left[i])
                    i += 1
                else:
                    merged.append(right[j])
                    j += 1
                    inversions += len(left) - i
            merged.extend(left[i:])
            merged.extend(right[j:])
            return merged, inversions

        # DFS returning (seq, inv)
        def dfs(u):
            children = node_children[u]
            if not children:
                # leaf node
                if node_is_end[u]:
                    return ([pos[node_word_idx[u]]], 0)
                else:
                    return ([], 0)

            child_results = []
            for ch, v in children.items():
                seq, inv = dfs(v)
                child_results.append((seq, inv))

            # sort children by the first element of their seq
            # all pos values are distinct, so first elements are distinct
            child_results.sort(key=lambda x: x[0][0] if x[0] else float('inf'))

            ordered_seqs = [seq for seq, _ in child_results]
            concat_seq = []
            for s in ordered_seqs:
                concat_seq.extend(s)

            _, total_inv = merge_count(concat_seq)
            sum_child_inv = sum(inv for _, inv in child_results)
            between = total_inv - sum_child_inv

            if node_is_end[u]:
                own_pos = pos[node_word_idx[u]]
                # count inversions between own_pos and elements in concat_seq
                own_inv = sum(1 for x in concat_seq if own_pos > x)
                inv_u = total_inv + own_inv
                seq_u = [own_pos] + concat_seq
            else:
                inv_u = total_inv
                seq_u = concat_seq

            return (seq_u, inv_u)

        _, answer = dfs(0)
        return answer
