```python
class Solution:
    def countKthRoots(self, l: int, r: int, k: int) -> int:
        if k == 1:
            return r - l + 1
        
        # Find largest x such that x^k <= r
        x_high = int(r ** (1/k))
        while (x_high + 1) ** k <= r:
            x_high += 1
        while x_high ** k > r:
            x_high -= 1
        
        # Find smallest x such that x^k >= l
        x_low = int(l ** (1/k))
        while x_low ** k < l:
            x_low += 1
        
        if x_low > x_high:
            return 0
        return x_high - x_low + 1
```


