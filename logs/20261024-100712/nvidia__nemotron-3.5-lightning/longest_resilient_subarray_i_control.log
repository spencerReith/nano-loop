class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        # A subarray is resilient iff removing any element leaves the sum divisible by k.
        # For subarray sum S and element x, S - x ≡ 0 (mod k)  <=>  x ≡ S (mod k).
        # This must hold for every element, so all elements must have the same remainder r.
        # Then S ≡ r (mod k) and r ≡ S (mod k) automatically, so condition reduces to:
        # all elements have the same remainder modulo k.
        #
        # Hence we just need the longest contiguous segment where nums[i] % k are all equal.

        n = len(nums)
        if n == 0:
            return 0

        best = 1
        cur_len = 1
        cur_rem = nums[0] % k

        for i in range(1, n):
            r = nums[i] % k
            if r == cur_rem:
                cur_len += 1
            else:
                cur_len = 1
                cur_rem = r
            if cur_len > best:
                best = cur_len

        return best
