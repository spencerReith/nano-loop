class Solution:
    def maxAlternatingSum(self, nums: list[int]) -> int:
        n = len(nums)
        # dp0: max alternating sum ending at current index with even length (next sign +)
        # dp1: max alternating sum ending at current index with odd length (next sign -)
        # Initially, we can think of dp0 = 0 (empty prefix, next sign +)
        # dp1 = -inf (cannot have odd length with 0 elements)
        INF_NEG = float('-inf')
        dp0 = 0          # max sum ending at previous index, next sign is +
        dp1 = INF_NEG    # max sum ending at previous index, next sign is -
        ans = INF_NEG

        for x in nums:
            # new dp0: we either extend a previous odd-length subarray (sign becomes +) or start fresh with +x
            new_dp0 = max(dp1 + x, x)
            # new dp1: we either extend a previous even-length subarray (sign becomes -) or start fresh with -x
            new_dp1 = max(dp0 - x, -x)

            # update answer with both possibilities
            ans = max(ans, new_dp0, new_dp1)

            dp0, dp1 = new_dp0, new_dp1

        return ans
