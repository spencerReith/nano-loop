from typing import List

class Solution:
    def maxConsistentColumns(self, grid: List[List[int]], limit: int) -> int:
        m = len(grid)
        n = len(grid[0])
        
        # dp[j] = maximum number of columns we can keep ending with column j
        dp = [1] * n
        
        for j in range(1, n):
            # try to extend any previous column i
            best = 1  # at least column j itself
            for i in range(j):
                # check if column i can precede column j in every row
                ok = True
                for r in range(m):
                    if abs(grid[r][j] - grid[r][i]) > limit:
                        ok = False
                        break
                if ok:
                    # we can keep column j after column i
                    best = max(best, dp[i] + 1)
            dp[j] = best
        
        return max(dp)
