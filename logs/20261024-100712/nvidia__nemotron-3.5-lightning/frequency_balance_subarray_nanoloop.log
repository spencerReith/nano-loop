```python
from collections import Counter

class Solution:
    def getLength(self, nums: list[int]) -> int:
        n = len(nums)
        best = 1
        
        for left in range(n):
            freq = Counter()
            for right in range(left, n):
                freq[nums[right]] += 1
                if self._is_freq_balanced(freq):
                    length = right - left + 1
                    if length > best:
                        best = length
        return best
    
    def _is_freq_balanced(self, freq: Counter) -> bool:
        distinct = len(freq)
        
        if distinct == 1:
            return True
        
        vals = list(freq.values())
        unique_freq = set(vals)
        
        if len(unique_freq) > 2:
            return False
        
        if len(unique_freq) == 1:
            return False
        
        f1, f2 = sorted(unique_freq)
        
        count_f1 = sum(1 for v in vals if v == f1)
        count_f2 = sum(1 for v in vals if v == f2)
        
        if count_f1 == 0 or count_f2 == 0:
            return False
        
        if f2 != 2 * f1:
            return False
        
        return True
