 class Solution:
    def minimumCost(self, nums: list[int], k: int) -> int:
        MOD = 10**9 + 7
        resources = k
        cost = 0
        op_count = 0
        
        for num in nums:
            while resources < num:
                op_count += 1
                cost = (cost + op_count) % MOD
                resources += k
            resources -= num
        
        return cost % MOD

