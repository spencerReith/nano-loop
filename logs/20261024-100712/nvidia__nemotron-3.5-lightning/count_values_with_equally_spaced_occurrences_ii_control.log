class Solution:
    def countSpecialIntegers(self, nums: list[int]) -> int:
        # Store the positions (indices) of each number.
        positions = {}
        for idx, val in enumerate(nums):
            positions.setdefault(val, []).append(idx)

        special_count = 0

        for val, indices in positions.items():
            # A special integer must appear at least three times.
            if len(indices) < 3:
                continue

            # Compute the common difference using the first two occurrences.
            diff = indices[1] - indices[0]
            is_special = True

            # Verify that every subsequent occurrence follows the same spacing.
            for i in range(2, len(indices)):
                if indices[i] - indices[i - 1] != diff:
                    is_special = False
                    break

            if is_special:
                special_count += 1

        return special_count
