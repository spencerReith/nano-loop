from typing import List
from collections import defaultdict
from bisect import bisect_left

class Solution:
    def countRatioSubarrays(self, nums: List[int], a: int, b: int) -> int:
        """
        Count subarrays where y > 0 and x/y <= a/b
        Equivalent to x*b <= y*a
        
        For subarray nums[l..r] (0-indexed, inclusive):
          x = number of evens, y = number of odds
          Condition: x*b <= y*a AND y > 0
        
        Using prefix sums:
          even[i] = #evens in nums[0..i-1], odd[i] = #odds in nums[0..i-1]
          val[i] = even[i]*b - odd[i]*a
          
          For subarray l..r: x = even[r+1]-even[l], y = odd[r+1]-odd[l]
          Condition: (even[r+1]-even[l])*b <= (odd[r+1]-odd[l])*a
                    val[r+1] <= val[l]
          And: odd[r+1] - odd[l] > 0 => odd[l] < odd[r+1]
        
        We need to count pairs (l, r+1) with 0 <= l < r+1 <= n
        such that val[l] >= val[r+1] AND odd[l] < odd[r+1].
        
        This is a 2D counting problem solved with a Fenwick tree (BIT)
        of sorted lists (with inner BIT for counts), processed offline.
        """
        n = len(nums)
        
        # Compute even and odd prefix counts
        even_pref = [0] * (n + 1)
        odd_pref = [0] * (n + 1)
        
        for i in range(1, n + 1):
            even_pref[i] = even_pref[i-1] + (1 if nums[i-1] % 2 == 0 else 0)
            odd_pref[i] = odd_pref[i-1] + (1 if nums[i-1] % 2 == 1 else 0)
        
        # val[i] = even_pref[i]*b - odd_pref[i]*a
        val = [0] * (n + 1)
        for i in range(n + 1):
            val[i] = even_pref[i] * b - odd_pref[i] * a
        
        # Coordinate compress val values
        sorted_vals = sorted(set(val))
        val_to_rank = {v: i+1 for i, v in enumerate(sorted_vals)}  # 1-indexed
        max_rank = len(sorted_vals)
        
        # Convert to inverted rank so that val[l] >= val[r+1]
        # becomes inv_rank[l] <= inv_rank[r+1]
        inv_max_rank = max_rank + 1
        inv_val_rank = [0] * (n + 1)
        for i in range(n + 1):
            inv_val_rank[i] = inv_max_rank - val_to_rank[val[i]] + 1
        
        # Collect all odd values for each BIT node (using inv_rank)
        # When adding point with inv_rank v, it affects BIT nodes: v, v+(v&-v), ...
        bit_odd_cols = [[] for _ in range(inv_max_rank + 1)]
        
        for i in range(n + 1):
            v = inv_val_rank[i]
            o = odd_pref[i]
            while v <= inv_max_rank:
                bit_odd_cols[v].append(o)
                v += v & -v
        
        # Sort and deduplicate each node's odd list, create rank mapping
        bit_sorted = [None] * (inv_max_rank + 1)
        bit_rank_map = [None] * (inv_max_rank + 1)
        
        for i in range(1, inv_max_rank + 1):
            if bit_odd_cols[i]:
                unique_sorted = sorted(set(bit_odd_cols[i]))
                bit_sorted[i] = unique_sorted
                bit_rank_map[i] = {o: r+1 for r, o in enumerate(unique_sorted)}
            else:
                bit_sorted[i] = []
                bit_rank_map[i] = {}
        
        # Initialize inner BIT for each node
        bit_trees = [None] * (inv_max_rank + 1)
        
        for i in range(1, inv_max_rank + 1):
            sz = len(bit_sorted[i])
            bit_trees[i] = [0] * (sz + 1)  # 1-indexed BIT
        
        def bit_update(tree, idx, delta):
            while idx < len(tree):
                tree[idx] += delta
                idx += idx & -idx
        
        def bit_query(tree, idx):
            s = 0
            while idx > 0:
                s += tree[idx]
                idx -= idx & -idx
            return s
        
        def add_point(inv_rank, odd_val):
            v = inv_rank
            while v <= inv_max_rank:
                if odd_val in bit_rank_map[v]:
                    r = bit_rank_map[v][odd_val]
                    bit_update(bit_trees[v], r, 1)
                v += v & -v
        
        def query_less(inv_rank, odd_val):
            """Count points with inv_rank' <= inv_rank and odd < odd_val"""
            result = 0
            v = inv_rank
            while v > 0:
                node_list = bit_sorted[v]
                if node_list:
                    pos = bisect_left(node_list, odd_val)
                    if pos > 0:
                        result += bit_query(bit_trees[v], pos)
                v -= v & -v
            return result
        
        # Process prefixes online: for each k=1..n, query then add point k
        # First add point l=0
        ans = 0
        add_point(inv_val_rank[0], odd_pref[0])
        
        for k in range(1, n + 1):
            # Query count of l < k with inv_val_rank[l] <= inv_val_rank[k]
            # and odd_pref[l] < odd_pref[k]
            q = query_less(inv_val_rank[k], odd_pref[k])
            ans += q
            
            # Add point k for future queries
            add_point(inv_val_rank[k], odd_pref[k])
        
        return ans
