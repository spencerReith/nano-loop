from typing import List

class Solution:
    def minAdjacentSwaps(self, nums: List[int], a: int, b) -> int:
        MOD = 10**9 + 7
        n = len(nums)

        # Categorize each element:
        # 0 if < a (first part)
        # 1 if in [a, b] (second part)
        # 2 if > b (third part)
        cat = []
        for x in nums:
            if x < a:
                cat.append(0)
            elif x > b:
                cat.append(2)
            else:
                cat.append(1)

        count0 = cat.count(0)
        count1 = cat.count(1)
        count2 = cat.count(2)

        # Collect current indices of each category
        idx0 = [i for i, c in enumerate(cat) if c == 0]
        idx1 = [i for i, c in enumerate(cat) if c == 1]
        idx2 = [i for i, c in enumerate(cat) if c == 2]

        # Build target position array
        target = [0] * n
        for new_pos, orig_idx in enumerate(idx0):
            target[orig_idx] = new_pos
        offset = count0
        for new_pos, orig_idx in enumerate(idx1):
            target[orig_idx] = offset + new_pos
        offset = count0 + count1
        for new_pos, orig_idx in enumerate(idx2):
            target[orig_idx] = offset + new_pos

        # Count inversions in target array using Fenwick tree
        bit = [0] * (n + 1)

        def bit_add(i, delta):
            while i <= n:
                bit[i] += delta
                i += i & -i

        def bit_sum(i):
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & -i
            return s

        inv = 0
        for j, t in enumerate(target):
            less_eq = bit_sum(t + 1)
            inv += j - less_eq
            bit_add(t + 1, 1)

        return inv % MOD
