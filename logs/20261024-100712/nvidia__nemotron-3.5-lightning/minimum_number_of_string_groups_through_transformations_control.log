class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        # For each word we compute a canonical signature of its even-index
        # characters and its odd-index characters after sorting each subsequence.
        # Two strings are equivalent iff their sorted even-index subsequences
        # and sorted odd-index subsequences are identical.
        signatures = set()
        for w in words:
            even = sorted(w[::2])      # characters at even positions (0-indexed)
            odd  = sorted(w[1::2])     # characters at odd positions (0-indexed)
            signatures.add((''.join(even), ''.join(odd)))
        return len(signatures)
