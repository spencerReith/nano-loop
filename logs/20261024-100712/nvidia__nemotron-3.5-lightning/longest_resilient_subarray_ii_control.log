class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        # A subarray is resilient iff for every i in the subarray,
        # (total_sum - nums[i]) % k == 0.
        # This is equivalent to: total_sum % k == nums[i] % k for all i.
        # Therefore all elements in the subarray must have the same remainder modulo k.
        # The problem reduces to finding the longest contiguous segment where all numbers
        # have the same remainder when divided by k.

        max_len = 0
        cur_len = 0
        prev_rem = None

        for x in nums:
            r = x % k
            if r == prev_rem:
                cur_len += 1
            else:
                cur_len = 1
                prev_rem = r
            if cur_len > max_len:
                max_len = cur_len

        return max_len
