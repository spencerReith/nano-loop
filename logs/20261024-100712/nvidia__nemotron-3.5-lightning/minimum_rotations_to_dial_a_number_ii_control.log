class Solution:
    def minRotations(self, n: int, s: str) -> int:
        """
        Returns the minimum total rotations needed to dial string s,
        with the option to reverse at most one suffix of s before dialing.
        """
        def digit_cost(a: int, b: int) -> int:
            """Minimum rotations on a circular 0-9 dial between digits a and b."""
            diff = abs(a - b)
            return min(diff, 10 - diff)

        # pref[i] = total rotations to dial s[0..i] starting from 0
        pref = [0] * n
        cur = 0
        total_orig = 0
        for i, ch in enumerate(s):
            nxt = int(ch)
            total_orig += digit_cost(cur, nxt)
            cur = nxt
            pref[i] = total_orig

        # adj[i] = rotations from s[i] to s[i+1] in the original string
        adj = []
        if n > 1:
            for i in range(n - 1):
                adj.append(digit_cost(int(s[i + 1]), int(s[i])))

        # suff[k] = sum_{i=k}^{n-2} adj[i], with suff[n] = suff[n-1] = 0
        suff = [0] * (n + 1)
        for k in range(n - 2, -1, -1):
            suff[k] = adj[k] + suff[k + 1]

        ans = total_orig  # case of no reversal (k = n)

        # Try every possible split point k (0 <= k <= n)
        for k in range(n + 1):
            if k == n:
                # no reversal
                prefix_cost = pref[n - 1] if n > 0 else 0
                start_digit = int(s[n - 1]) if n > 0 else 0
            else:
                # reverse suffix starting at k
                prefix_cost = pref[k - 1] if k > 0 else 0
                start_digit = 0 if k == 0 else int(s[k - 1])

            total = prefix_cost + digit_cost(start_digit, int(s[n - 1])) + suff[k]
            if total < ans:
                ans = total

        return ans
