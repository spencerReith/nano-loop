    # # # # # # I'll output the code.```python
class Solution:
    def minSelection(self, availableIntervals: list[list[int]], targetIntervals: list[list[int]]) -> int:
        # Step 1: Merge target intervals into a sorted list of disjoint intervals.
        targetIntervals.sort(key=lambda x: x[0])
        merged = []
        for l, r in targetIntervals:
            if not merged or l > merged[-1][1]:
                merged.append([l, r])
            else:
                merged[-1][1] = max(merged[-1][1], r)
        
        # Step 2: Sort available intervals by their left endpoint.
        availableIntervals.sort(key=lambda x: x[0])
        n = len(availableIntervals)
        i = 0          # pointer in availableIntervals
        ans = 0        # number of selected intervals
        pos = 0        # rightmost point covered so far (points start at 1)
        
        # Step 3: Greedily cover each merged target interval.
        for L, R in merged:
            # If we haven't covered up to the start of this target, reset pos to L.
            if pos < L:
                pos = L
            # Greedily pick intervals that start at or before pos and extend farthest right.
            while pos < R:
                next_pos = pos
                # Consider all available intervals with start <= pos.
                while i < n and availableIntervals[i][0] <= pos:
                    next_pos = max(next_pos, availableIntervals[i][1])
                    i += 1
                # If no progress can be made, coverage is impossible.
                if next_pos == pos:
                    return -1
                ans += 1
                pos = next_pos
        
        return ans
