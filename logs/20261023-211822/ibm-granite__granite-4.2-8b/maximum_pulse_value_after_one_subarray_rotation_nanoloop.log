```python
class Solution:
    def maxValue(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return nums[0]
        
        # t[i] = (-1)^i * nums[i]
        t = [nums[i] if i % 2 == 0 else -nums[i] for i in range(n)]
        
        # prefix[i] = sum(t[0..i-1]), prefix[0] = 0
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + t[i]
        P = prefix[n]
        
        INF = 10**18
        min_odd = INF  # min A(l,r) for r-l odd (length even rotation, r >= l+1)
        best_par = [-INF, -INF]  # max prefix[l] for l with par[l]=p, l < current r
        best_par[0] = prefix[0]  # l=0
        
        for r in range(1, n):
            p_r = r % 2
            # need best_par[1 - p_r] for l < r with par[l] != p_r
            if best_par[1 - p_r] > -INF:
                candidate = prefix[r + 1] - best_par[1 - p_r]
                if candidate < min_odd:
                    min_odd = candidate
            # update best_par for l=r (using prefix[r], since l=r uses prefix[r])
            if prefix[r] > best_par[p_r]:
                best_par[p_r] = prefix[r]
        
        min_even = INF  # min S(l+1,r) for r-l even (length odd rotation, r >= l+2)
        if n >= 2:
            best_par_m = [-INF, -INF]  # max prefix[m] for m with par[m-1]=p, m <= current r-1 (m = l+1)
            p0 = 0 % 2  # par[0]
            best_par_m[p0] = prefix[1]  # m=1, l=0
            for r in range(2, n):
                p_r = r % 2
                if best_par_m[p_r] > -INF:
                    candidate = prefix[r + 1] - best_par_m[p_r]
                    if candidate < min_even:
                        min_even = candidate
                p_prev = (r - 1) % 2  # par[r-1], since l = r-1 gives m = r
                if prefix[r] > best_par_m[p_prev]:
                    best_par_m[p_prev] = prefix[r]
        
        max_odd = -INF
        if min_odd < INF:
            max_odd = P - 2 * min_odd
        
        max_even = -INF
        if min_even < INF:
            max_even = P - 2 * min_even
        
        ans = max(P, max_odd, max_even)
        return ans
