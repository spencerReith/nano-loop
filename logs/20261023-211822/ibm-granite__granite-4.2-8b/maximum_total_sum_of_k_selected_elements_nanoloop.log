```python
class Solution:
    def maxSum(self, nums: list[int], k: int, mul: int) -> int:
        # Select the k largest elements
        nums.sort(reverse=True)
        selected = nums[:k]
        
        # Process in descending order (largest first) to use highest multipliers on largest numbers
        total = 0
        for i in range(k):
            current_multiplier = mul - i
            if current_multiplier > 0:
                # Multiply gives at least as much as addition (since num >= 1 and multiplier >= 1)
                total += selected[i] * current_multiplier
            else:
                # Addition is better when multiplier <= 0
                total += selected[i]
        
        return total
```
