```python
from bisect import bisect_left

class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n = len(words)
        # trie
        children = [[-1] * 10]  # each node: list of 10 child indices, -1 absent
        marked = [-1]           # -1 if not a word, else word index

        def create_node():
            children.append([-1] * 10)
            marked.append(-1)
            return len(children) - 1

        # insert words
        for idx, w in enumerate(words):
            node = 0
            for ch in w:
                c = ord(ch) - 97
                if children[node][c] == -1:
                    new_node = create_node()
                    children[node][c] = new_node
                node = children[node][c]
            marked[node] = idx

        # pos[i] = position of word index i in target
        pos = [0] * n
        for p in range(n):
            i = target[p]
            pos[i] = p

        # DFS returns (size, inv, pos_sorted) for subtree rooted at u
        def dfs(u):
            child_data = []  # list of (size, inv, pos_list) for children
            for c in range(10):
                v = children[u][c]
                if v == -1:
                    continue
                sz, invc, posc = dfs(v)
                child_data.append((sz, invc, posc))

            k = len(child_data)
            sizes = [sz for sz, _, _ in child_data]
            invs = [invc for _, invc, _ in child_data]
            pos_lists = [posc for _, _, posc in child_data]

            # cross[i][j] = #pairs (x in child i, y in child j) with pos[x] > pos[y]
            cross = [[0] * k for _ in range(k)]
            for i in range(k):
                for j in range(k):
                    if i == j:
                        continue
                    pos_i = pos_lists[i]
                    pos_j = pos_lists[j]
                    cnt = 0
                    for p in pos_i:
                        cnt += bisect_left(pos_j, p)
                    cross[i][j] = cnt

            # DP over subsets to minimize cross inversions among children
            INF = 10**18
            dp = [INF] * (1 << k)
            dp[0] = 0
            for mask in range(1 << k):
                if dp[mask] == INF:
                    continue
                for j in range(k):
                    if mask & (1 << j):
                        continue
                    add = 0
                    for i in range(k):
                        if mask & (1 << i):
                            add += cross[i][j]
                    new_mask = mask | (1 << j)
                    if dp[mask] + add < dp[new_mask]:
                        dp[new_mask] = dp[mask] + add
            total_cross = dp[(1 << k) - 1]

            # inversions contributed by the node itself (if marked) with children
            cnt_less = 0
            own_pos = None
            if marked[u] != -1:
                idx_self = marked[u]
                own_pos = pos[idx_self]
                for _, _, posc in child_data:
                    cnt_less += bisect_left(posc, own_pos)

            total_inv = sum(invs) + total_cross + cnt_less
            total_size = (1 if marked[u] != -1 else 0) + sum(sizes)

            # merge pos lists (already sorted children's lists) plus own pos if marked
            all_pos = []
            if marked[u] != -1:
                all_pos.append(own_pos)
            for posc in pos_lists:
                all_pos.extend(posc)
            all_pos.sort()
            pos_sorted = all_pos

            return (total_size, total_inv, pos_sorted)

        _, total_inv, _ = dfs(0)
        return total_inv
