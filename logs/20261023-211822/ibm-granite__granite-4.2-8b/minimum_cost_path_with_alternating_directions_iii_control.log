```python
import heapq

class Solution:
    def minCost(self, m: int, n: int, penalty: list[list[int]]) -> int:
        INF = 10**18
        # entrance cost function
        def entrance(i, j):
            return (i+1)*(j+1)
        
        # distance array: dist[i][j][0] for parity 0 (odd next), dist[i][j][1] for parity 1 (even next)
        dist = [[ [INF, INF] for _ in range(n)] for _ in range(m)]
        
        # start state
        start_par = 0  # next action is odd
        start_cost = entrance(0, 0)
        dist[0][0][start_par] = start_cost
        
        heap = [(start_cost, 0, 0, start_par)]
        
        # directions
        dirs = [(1,0), (-1,0), (0,1), (0,-1)]
        
        while heap:
            d, i, j, par = heapq.heappop(heap)
            if d != dist[i][j][par]:
                continue
            if i == m-1 and j == n-1:
                return d
            
            # wait
            new_par = par ^ 1
            nd = d + penalty[i][j]
            if nd < dist[i][j][new_par]:
                dist[i][j][new_par] = nd
                heapq.heappush(heap, (nd, i, j, new_par))
            
            # moves
            for di, dj in dirs:
                ni, nj = i+di, j+dj
                if 0 <= ni < m and 0 <= nj < n:
                    # determine if move obeys rule
                    if par == 0:  # odd action: forward = right/down
                        forward = (di == 0 and dj == 1) or (di == 1 and dj == 0)
                    else:  # par == 1: even action: forward = left/up
                        forward = (di == 0 and dj == -1) or (di == -1 and dj == 0)
                    
                    if forward:
                        edge_cost = entrance(ni, nj)
                    else:
                        edge_cost = entrance(ni, nj) + penalty[i][j]
                    
                    new_par = par ^ 1
                    nd = d + edge_cost
                    if nd < dist[ni][nj][new_par]:
                        dist[ni][nj][new_par] = nd
                        heapq.heappush(heap, (nd, ni, nj, new_par))
        
        # fallback (should not happen)
        goal_min = min(dist[m-1][n-1][0], dist[m-1][n-1][1])
        return goal_min
```

