import heapq

class Solution:
    def minCost(self, m: int, n: int, penalty: list[list[int]]) -> int:
        INF = 10**30
        # dp[i][j][par] where par 0 = next action odd, par 1 = next action even
        dp = [[[INF, INF] for _ in range(n)] for _ in range(m)]
        # start entrance cost
        dp[0][0][0] = (0+1)*(0+1)
        
        heap = [(dp[0][0][0], 0, 0, 0)]
        
        while heap:
            cost, i, j, par = heapq.heappop(heap)
            if cost > dp[i][j][par]:
                continue
            # if i == m-1 and j == n-1: pass  # Dijkstra continues to ensure all distances updated
            
            # Wait
            wait_cost = penalty[i][j]
            new_par = 1 - par
            new_cost = cost + wait_cost
            if new_cost < dp[i][j][new_par]:
                dp[i][j][new_par] = new_cost
                heapq.heappush(heap, (new_cost, i, j, new_par))
            
            # Allowed moves (no penalty)
            if par == 0:  # next odd: right/down
                # right
                if j+1 < n:
                    dest_i, dest_j = i, j+1
                    entrance = (dest_i+1)*(dest_j+1)
                    new_cost = cost + entrance
                    if new_cost < dp[dest_i][dest_j][1]:
                        dp[dest_i][dest_j][1] = new_cost
                        heapq.heappush(heap, (new_cost, dest_i, dest_j, 1))
                # down
                if i+1 < m:
                    dest_i, dest_j = i+1, j
                    entrance = (dest_i+1)*(dest_j+1)
                    new_cost = cost + entrance
                    if new_cost < dp[dest_i][dest_j][1]:
                        dp[dest_i][dest_j][1] = new_cost
                        heapq.heappush(heap, (new_cost, dest_i, dest_j, 1))
            else:  # par == 1, next even: left/up
                # left
                if j-1 >= 0:
                    dest_i, dest_j = i, j-1
                    entrance = (dest_i+1)*(dest_j+1)
                    new_cost = cost + entrance
                    if new_cost < dp[dest_i][dest_j][0]:
                        dp[dest_i][dest_j][0] = new_cost
                        heapq.heappush(heap, (new_cost, dest_i, dest_j, 0))
                # up
                if i-1 >= 0:
                    dest_i, dest_j = i-1, j
                    entrance = (dest_i+1)*(dest_j+1)
                    new_cost = cost + entrance
                    if new_cost < dp[dest_i][dest_j][0]:
                        dp[dest_i][dest_j][0] = new_cost
                        heapq.heappush(heap, (new_cost, dest_i, dest_j, 0))
            
            # Forbidden moves (with penalty from current cell)
            if par == 0:
                # left / up are forbidden
                # left
                if j-1 >= 0:
                    dest_i, dest_j = i, j-1
                    entrance = (dest_i+1)*(dest_j+1)
                    new_cost = cost + entrance + penalty[i][j]
                    if new_cost < dp[dest_i][dest_j][1]:
                        dp[dest_i][dest_j][1] = new_cost
                        heapq.heappush(heap, (new_cost, dest_i, dest_j, 1))
                # up
                if i-1 >= 0:
                    dest_i, dest_j = i-1, j
                    entrance = (dest_i+1)*(dest_j+1)
                    new_cost = cost + entrance + penalty[i][j]
                    if new_cost < dp[dest_i][dest_j][1]:
                        dp[dest_i][dest_j][1] = new_cost
                        heapq.heappush(heap, (new_cost, dest_i, dest_j, 1))
            else:  # par == 1
                # right / down are forbidden
                # right
                if j+1 < n:
                    dest_i, dest_j = i, j+1
                    entrance = (dest_i+1)*(dest_j+1)
                    new_cost = cost + entrance + penalty[i][j]
                    if new_cost < dp[dest_i][dest_j][0]:
                        dp[dest_i][dest_j][0] = new_cost
                        heapq.heappush(heap, (new_cost, dest_i, dest_j, 0))
                # down
                if i+1 < m:
                    dest_i, dest_j = i+1, j
                    entrance = (dest_i+1)*(dest_j+1)
                    new_cost = cost + entrance + penalty[i][j]
                    if new_cost < dp[dest_i][dest_j][0]:
                        dp[dest_i][dest_j][0] = new_cost
                        heapq.heappush(heap, (new_cost, dest_i, dest_j, 0))
        
        return min(dp[m-1][n-1][0], dp[m-1][n-1][1])
