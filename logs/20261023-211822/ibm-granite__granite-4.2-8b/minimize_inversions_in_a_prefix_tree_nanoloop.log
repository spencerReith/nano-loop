```python
import bisect

class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        # First, compute pos array: pos[i] = position of word i in target
        n = len(words)
        pos = [0] * n
        for i, idx in enumerate(target):
            pos[idx] = i
        
        # Build trie
        class Node:
            __slots__ = ['children', 'word_index']
            def __init__(self):
                self.children = {}
                self.word_index = None
        
        root = Node()
        for i, word in enumerate(words):
            node = root
            for ch in word:
                if ch not in node.children:
                    node.children[ch] = Node()
                node = node.children[ch]
            node.word_index = i
        
        # DFS that returns (pos_list, pos_sorted, inv)
        # pos_list: list of pos[word_index] in traversal order of subtree
        # pos_sorted: sorted list of pos[word_index] in subtree
        # inv: number of inversions in pos_list
        def dfs(node):
            if node.word_index is not None:
                pos_val = pos[node.word_index]
                pos_list = [pos_val]
                pos_sorted = [pos_val]
                inv = 0
            else:
                pos_list = []
                pos_sorted = []
                inv = 0
            
            children = list(node.children.items())  # list of (char, child)
            
            if not children:
                return pos_list, pos_sorted, inv
            
            # Process children first
            child_results = []
            for ch, child in children:
                child_pos_list, child_pos_sorted, child_inv = dfs(child)
                child_results.append((ch, child, child_pos_list, child_pos_sorted, child_inv))
            
            # Extract child info
            child_pos_lists = []
            child_pos_sorteds = []
            child_invs = []
            for ch, child, pos_list, pos_sorted, inv in child_results:
                child_pos_lists.append(pos_list)
                child_pos_sorteds.append(pos_sorted)
                child_invs.append(inv)
            
            k = len(child_pos_lists)
            
            # Sort children based on cross inversions
            # cross_inversions(A, B) = number of pairs (a in A, b in B) with pos[a] > pos[b]
            def cross_inversions(pos_list_A, pos_sorted_B):
                cnt = 0
                for pa in pos_list_A:
                    idx = bisect.bisect_left(pos_sorted_B, pa)
                    cnt += idx
                return cnt
            
            # Sort using bubble sort with comparator: prefer A before B if cross_inversions(A,B) < cross_inversions(B,A)
            indices = list(range(k))
            for _ in range(k):
                for i in range(k-1):
                    j = i+1
                    i_idx = indices[i]
                    j_idx = indices[j]
                    ci_j = cross_inversions(child_pos_lists[i_idx], child_pos_sorteds[j_idx])
                    cj_i = cross_inversions(child_pos_lists[j_idx], child_pos_sorteds[i_idx])
                    if ci_j < cj_i:
                        continue  # i before j is better
                    else:
                        indices[i], indices[j] = indices[j], indices[i]
            
            # Build ordered list of child indices
            ordered_indices = indices
            
            # Compute node_inv: if node is marked, inversions between node and children
            node_inv = 0
            if node.word_index is not None:
                pos_node = pos[node.word_index]
                for idx in ordered_indices:
                    child_pos_sorted = child_pos_sorteds[idx]
                    cnt_less = bisect.bisect_left(child_pos_sorted, pos_node)
                    node_inv += cnt_less
            
            # Compute cross_inv between children (in the final order)
            cross_inv = 0
            # Iterate over ordered_indices positions
            for i_in_order in range(k):
                orig_i = ordered_indices[i_in_order]
                for j_in_order in range(i_in_order+1, k):
                    orig_j = ordered_indices[j_in_order]
                    ci_j = cross_inversions(child_pos_lists[orig_i], child_pos_sorteds[orig_j])
                    cross_inv += ci_j
            
            # Build pos_list_full for node
            pos_list_full = []
            if node.word_index is not None:
                pos_list_full = [pos[node.word_index]]
            for idx in ordered_indices:
                pos_list_full.extend(child_pos_lists[idx])
            
            # Total inv for subtree
            total_inv = node_inv + cross_inv + sum(child_invs)
            
            # pos_sorted for subtree
            pos_sorted_full = sorted(pos_list_full)
            
            return pos_list_full, pos_sorted_full, total_inv
        
        _, _, result_inv = dfs(root)
        return result_inv
