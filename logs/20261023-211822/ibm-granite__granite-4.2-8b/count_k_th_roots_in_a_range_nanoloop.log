class Solution:
    def countKthRoots(self, l: int, r: int, k: int) -> int:
        if k == 1:
            return r - l + 1
        
        # Helper: compute x^k, but stop if > r (to avoid overflow and speed up)
        def power(x, k):
            # x >= 0, k >= 2
            res = 1
            for _ in range(k):
                res *= x
                if res > r:
                    return res  # > r
            return res
        
        # Find smallest x such that x^k >= l
        lo, hi = 0, r + 1
        while lo < hi:
            mid = (lo + hi) // 2
            val = power(mid, k)
            if val >= l:
                hi = mid
            else:
                lo = mid + 1
        
        # Check if even the smallest candidate (lo) gives < l
        # But note: if l == 0, power(0,k)=0 >= 0, so lo will be 0.
        if power(lo, k) < l:
            return 0
        x_min = lo
        
        # Find largest x such that x^k <= r
        lo, hi = 0, r + 1
        while lo < hi:
            mid = (lo + hi + 1) // 2
            val = power(mid, k)
            if val <= r:
                lo = mid
            else:
                hi = mid - 1
        x_max = lo
        
        if x_min > x_max:
            return 0
        
        return x_max - x_min + 1
