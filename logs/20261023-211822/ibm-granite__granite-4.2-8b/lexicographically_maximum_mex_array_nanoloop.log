from solution import Solution
import random

def brute_maximumMEX(nums):
    n = len(nums)
    best = None
    def dfs(start, cur):
        nonlocal best
        if start == n:
            if best is None or cur > best:
                best = cur[:]
            return
        for k in range(1, n-start+1):
            prefix = nums[start:start+k]
            seen = set(prefix)
            mex = 0
            while mex in seen:
                mex += 1
            dfs(start + k, cur + [mex])
    dfs(0, [])
    return best

s = Solution()
random.seed(42)
