```
class Solution:
    def maximumMEX(self, nums: list[int]) -> list[int]:
        n = len(nums)
        if n == 0:
            return []
        freq = [0] * (n + 2)
        res = []
        i = 0
        while i < n:
            touched = []
            cur_mex = 0
            best_mex = -1
            best_end = i
            for j in range(i, n):
                x = nums[j]
                if x <= n + 1:
                    if freq[x] == 0:
                        touched.append(x)
                    freq[x] += 1
                while cur_mex < len(freq) and freq[cur_mex] > 0:
                    cur_mex += 1
                if cur_mex > best_mex:
                    best_mex = cur_mex
                    best_end = j
            res.append(best_mex)
            # reset frequencies
            for idx in touched:
                freq[idx] = 0
            i = best_end + 1
        return res
```

