def maximumMEX(self, nums):
    n = len(nums)
    res = []
    i = 0
    while i < n:
        freq = [0] * (n + 2)  # enough size
        cur_mex = 0
        best_mex = -1
        best_end = i  # start with i
        # scan j from i to n-1
        for j in range(i, n):
            x = nums[j]
            if x <= n + 1:  # only care up to n+1 because mex <= n+1
                freq[x] += 1
            # update cur_mex: while freq[cur_mex] > 0, increment
            while cur_mex < len(freq) and freq[cur_mex] > 0:
                cur_mex += 1
            # now cur_mex is mex of nums[i:j+1]
            if cur_mex > best_mex:
                best_mex = cur_mex
                best_end = j
        # take segment i to best_end inclusive
        res.append(best_mex)
        i = best_end + 1
    return res
```

