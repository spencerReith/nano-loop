class Solution:
    def lastVisitedCell(self, grid: list[list[str]]) -> list[int]:
        m = len(grid)
        n = len(grid[0]) if m > 0 else 0
        
        visited = [[False] * n for _ in range(m)]
        visited[0][0] = True
        r, c = 0, 0
        
        # Map character to delta
        dr = {'U': -1, 'D': 1, 'L': 0, 'R': 0}
        dc = {'U': 0, 'D': 0, 'L': -1, 'R': 1}
        
        while True:
            ch = grid[r][c]
            nr, nc = r + dr[ch], c + dc[ch]
            
            # Check bounds and visited
            if not (0 <= nr < m and 0 <= nc < n):
                break
            if visited[nr][nc]:
                break
            
            visited[nr][nc] = True
            r, c = nr, nc
        
        return [r, c]
