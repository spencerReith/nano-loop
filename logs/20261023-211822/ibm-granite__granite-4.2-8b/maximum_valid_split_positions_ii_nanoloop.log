```python
import math
from typing import List

class Solution:
    def maxValidSplits(self, nums: List[int]) -> int:
        def score(arr: List[int]) -> int:
            m = len(arr)
            if m < 2:
                return 0
            # Compute left gcds
            left_vals = [arr[0]]
            cur_left = arr[0]
            for i in range(1, m):
                cur_left = math.gcd(cur_left, arr[i])
                left_vals.append(cur_left)
            
            # Traverse from right, compute right gcd on the fly
            cur_right = arr[-1]
            count = 0
            # i is the split index (between i and i+1), right_gcd = gcd(arr[i+1..end])
            # Start from the last split (i = m-2), right_gcd = arr[m-1]
            for i in range(m-2, -1, -1):
                # right_gcd is gcd(arr[i+1..end]) for current i
                if left_vals[i] == cur_right:
                    count += 1
                # Update cur_right to gcd(arr[i..end]) for next i-1
                cur_right = math.gcd(cur_right, arr[i])
            return count
        
        n = len(nums)
        best = 0
        
        # Case 1: no removal
        best = max(best, score(nums))
        
        # Case 2: remove one element
        for k in range(n):
            arr = nums[:k] + nums[k+1:]
            best = max(best, score(arr))
        
        return best
```
