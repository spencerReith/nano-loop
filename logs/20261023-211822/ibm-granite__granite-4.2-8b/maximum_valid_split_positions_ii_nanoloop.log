I'll write a helper function to compute the score for a given array:

```python
import math
from typing import List

def score(arr: List[int]) -> int:
    m = len(arr)
    if m < 2:
        return 0
    left_gcd = [0] * m
    left_gcd[0] = arr[0]
    for i in range(1, m):
        left_gcd[i] = math.gcd(left_gcd[i-1], arr[i])
    
    right_gcd = [0] * m
    right_gcd[-1] = arr[-1]
    for i in range(m-2, -1, -1):
        right_gcd[i] = math.gcd(right_gcd[i+1], arr[i])
    
    count = 0
    for i in range(m-1):
        # position between i and i+1
        if left_gcd[i] == right_gcd[i+1]:
            count += 1
    return count
```

Now, for the main function:

```python
def maxValidSplits(self, nums: List[int]) -> int:
    n = len(nums)
    best = 0
    
    # Case 1: no removal
    best = max(best, score(nums))
    
    # Case 2: remove one element
    for k in range(n):
        arr = nums[:k] + nums[k+1:]
        best = max(best, score(arr))
    
    return best
```

