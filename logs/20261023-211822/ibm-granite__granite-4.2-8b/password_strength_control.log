class Solution:
    def passwordStrength(self, password: str) -> int:
        seen_lower = set()
        seen_upper = set()
        seen_digit = set()
        seen_special = set()
        
        for ch in password:
            if 'a' <= ch <= 'z':
                seen_lower.add(ch)
            elif 'A' <= ch <= 'Z':
                seen_upper.add(ch)
            elif '0' <= ch <= '9':
                seen_digit.add(ch)
            elif ch in "!@#$":
                seen_special.add(ch)
        
        return len(seen_lower) * 1 + len(seen_upper) * 2 + len(seen_digit) * 3 + len(seen_special) * 5
