from typing import List

class Solution:
    def minOperations(self, nums: List[int]) -> int:
        n = len(nums)
        # case1: rotation only (nums rotated left by idx0 equals sorted)
        idx0 = nums.index(0)
        ok1 = True
        for i in range(n):
            j = (i + idx0) % n
            if nums[j] != i:
                ok1 = False
                break
        ans = float('inf')
        if ok1:
            ans = idx0
        
        # case3: rotation then reverse (nums rotated left by idx_n1 equals reverse sorted)
        idx_n1 = nums.index(n - 1)
        ok3 = True
        for i in range(n):
            j = (i + idx_n1) % n
            if nums[j] != (n - 1 - i):
                ok3 = False
                break
        if ok3:
            # need to rotate idx_n1 times then reverse -> ops = idx_n1 + 1
            ans = min(ans, idx_n1 + 1)
        
        # case2: reverse then rotation (reverse(nums) rotated left by idx0_rev equals sorted)
        rev_nums = nums[::-1]
        idx0_rev = rev_nums.index(0)
        ok2 = True
        for i in range(n):
            j = (i + idx0_rev) % n
            if rev_nums[j] != i:
                ok2 = False
                break
        if ok2:
            # reverse then rotate idx0_rev times -> ops = 1 + idx0_rev
            ans = min(ans, 1 + idx0_rev)
        
        if ans == float('inf'):
            return -1
        else:
            return ans
