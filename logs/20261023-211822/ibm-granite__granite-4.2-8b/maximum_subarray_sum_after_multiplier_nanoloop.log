```python
class Solution:
    def maxSubarraySum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        best = -float('inf')
        
        # Consider all possible subarrays for the operation
        for i in range(n):
            for j in range(i, n):
                # Copy the array for this operation
                arr = nums.copy()
                
                # Option 1: Multiply
                for idx in range(i, j+1):
                    arr[idx] *= k
                # Find max subarray sum
                max_sum = self._max_subarray_sum(arr)
                best = max(best, max_sum)
                
                # Option 2: Divide
                arr = nums.copy()
                for idx in range(i, j+1):
                    val = arr[idx]
                    if val >= 0:
                        arr[idx] = val // k
                    else:
                        # Ceiling division for negative numbers: ceil(a/b) = -floor(-a/b)
                        # arr[idx] = -((-val) // k)
                        # But careful: if val is exactly divisible, val//k == (-val)//k with ceil
                        # Example: -4//2 = -2, ceil(-2) = -2, -(-4)//2 = 4//2 = 2, -2 = -2. Correct.
                        # Example: -3//2 = -2, ceil(-1.5) = -1, -(-3)//2 = 3//2 = 1, -1 = -1. Correct.
                        arr[idx] = -((-val) // k)
                # Find max subarray sum
                max_sum = self._max_subarray_sum(arr)
                best = max(best, max_sum)
        
        return best
    
    def _max_subarray_sum(self, arr):
        # Standard Kadane's algorithm
        max_current = max_global = arr[0]
        for i in range(1, len(arr)):
            max_current = max(arr[i], max_current + arr[i])
            max_global = max(max_global, max_current)
        return max_global
