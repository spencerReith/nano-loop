class Solution:
    def maxSubarraySum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        
        # Precompute prefix sums
        prefix_sum = [0] * n
        prefix_sum[0] = nums[0]
        for i in range(1, n):
            prefix_sum[i] = prefix_sum[i-1] + nums[i]
        
        # Precompute pre_max[i] = max subarray sum in nums[0..i]
        pre_max = [0] * n
        pre_max[0] = nums[0]
        cur = nums[0]
        for i in range(1, n):
            cur = max(nums[i], cur + nums[i])
            pre_max[i] = max(pre_max[i-1], cur)
        
        # Precompute suf_max[i] = max subarray sum in nums[i..n-1]
        suf_max = [0] * n
        suf_max[n-1] = nums[n-1]
        cur = nums[n-1]
        for i in range(n-2, -1, -1):
            cur = max(nums[i], cur + nums[i])
            suf_max[i] = max(suf_max[i+1], cur)
        
        # Precompute left_best[i] = max(0, max subarray sum ending at i)
        left_best = [0] * n
        cur = nums[0]
        left_best[0] = max(0, nums[0])
        for i in range(1, n):
            cur = max(nums[i], cur + nums[i])
            left_best[i] = max(0, cur)
        
        # Precompute right_best[i] = max(0, max subarray sum starting at i)
        right_best = [0] * n
        cur = nums[n-1]
        right_best[n-1] = max(0, nums[n-1])
        for i in range(n-2, -1, -1):
            cur = max(nums[i], cur + nums[i])
            right_best[i] = max(0, cur)
        
        # Helper: compute max subarray sum of a list
        def max_subarray_sum(arr):
            cur = arr[0]
            best = arr[0]
            for x in arr[1:]:
                cur = max(x, cur + x)
                best = max(best, cur)
            return best
        
        best_overall = pre_max[n-1]  # Original max subarray sum (operation might not help)
        
        # Consider multiply operation
        for l in range(n):
            cur_total_mod = 0
            cur_max_mod = -10**18
            for r in range(l, n):
                val = nums[r] * k
                cur_total_mod += val  # k * nums[l] + ... + k * nums[r]
                if r == l:
                    cur_max_mod = val
                else:
                    # cur_max_mod for k*nums[l..r]
                    # We need to maintain it as we extend r
                    # Actually, better: compute cur_max_mod from scratch or update
                    # Let's recompute: cur_max_mod = max subarray sum of k*nums[l..r]
                    # We can maintain it incrementally:
                    # cur_max_mod = max(k*nums[r], cur_max_mod + k*nums[r])
                    cur_max_mod = max(val, cur_max_mod + val)
                
                # best_inside = cur_max_mod
                best_inside = cur_max_mod
                
                # best_overlap
                left_part = left_best[l-1] if l > 0 else 0
                right_part = right_best[r+1] if r < n-1 else 0
                best_overlap = max(cur_max_mod,
                                   left_part + cur_total_mod,
                                   cur_total_mod + right_part,
                                   left_part + cur_total_mod + right_part)
                
                # best_outside = max subarray sum completely outside [l, r]
                best_outside = 0
                if l > 0:
                    best_outside = max(best_outside, pre_max[l-1])
                if r < n-1:
                    best_outside = max(best_outside, suf_max[r+1])
                # Also, best_outside could be 0 if all outside negatives, but we need non-empty subarray
                # Actually, pre_max and suf_max already handle non-empty
                # But if outside is empty (l=0 and r=n-1), best_outside should be -inf (can't use outside)
                if l == 0 and r == n-1:
                    best_outside = -10**18
                # Otherwise, pre_max[l-1] and suf_max[r+1] are valid
                # But pre_max[l-1] might be < 0, same for suf_max[r+1], so we take max
                
                # Result for operation on [l, r] with multiply
                result_mult = max(best_inside, best_overlap, best_outside)
                best_overall = max(best_overall, result_mult)
        
        # Consider divide operation
        # Precompute div array
        div = [0] * n
        for i in range(n):
            if nums[i] >= 0:
                div[i] = nums[i] // k
            else:
                # ceil(nums[i]/k) = -floor(-nums[i]/k)
                div[i] = -((-nums[i]) // k)
        
        for l in range(n):
            cur_total_div = 0
            cur_max_div = -10**18
            for r in range(l, n):
                val = div[r]
                cur_total_div += val
                if r == l:
                    cur_max_div = val
                else:
                    cur_max_div = max(val, cur_max_div + val)
                
                # Same overlap and outside computation
                left_part = left_best[l-1] if l > 0 else 0
                right_part = right_best[r+1] if r < n-1 else 0
                best_inside = cur_max_div
                best_overlap = max(cur_max_div,
                                   left_part + cur_total_div,
                                   cur_total_div + right_part,
                                   left_part + cur_total_div + right_part)
                
                best_outside = 0
                if l > 0:
                    best_outside = max(best_outside, pre_max[l-1])
                if r < n-1:
                    best_outside = max(best_outside, suf_max[r+1])
                if l == 0 and r == n-1:
                    best_outside = -10**18
                
                result_div = max(best_inside, best_overlap, best_outside)
                best_overall = max(best_overall, result_div)
        
        return best_overall
