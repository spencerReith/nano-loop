class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        def is_valid(x_even, y_odd):
            # Check if y_odd > 0 and x_even / y_odd <= a / b
            # Avoid floating point by cross-multiplying
            if y_odd == 0:
                return False
            # x_even / y_odd <= a / b  <=>  x_even * b <= a * y_odd
            return x_even * b <= a * y_odd
        
        total = 0
        n = len(nums)
        
        # Iterate over all subarrays using start index
        for i in range(n):
            even_cnt = 0
            odd_cnt = 0
            # Extend subarray to the right
            for j in range(i, n):
                if nums[j] % 2 == 0:
                    even_cnt += 1
                else:
                    odd_cnt += 1
                # Check validity: y > 0 and ratio condition
                if odd_cnt > 0 and is_valid(even_cnt, odd_cnt):
                    total += 1
        
        return total
