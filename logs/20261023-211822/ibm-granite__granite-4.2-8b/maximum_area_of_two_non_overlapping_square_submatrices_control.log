class Solution:
    def maxArea(self, mat: list[list[int]]) -> int:
        m = len(mat)
        n = len(mat[0]) if m > 0 else 0
        
        # dp[i][j] = side length of largest all-1 square with bottom-right at (i, j)
        dp = [[0] * n for _ in range(m)]
        
        for i in range(m):
            for j in range(n):
                if mat[i][j] == 1:
                    if i == 0 or j == 0:
                        dp[i][j] = 1
                    else:
                        dp[i][j] = 1 + min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1])
        
        # Precompute for each possible side length k, the maximum number of non-overlapping
        # squares of size k that can be placed in the grid (ignoring overlap constraint between the two squares for now)
        # But we need to find two non-overlapping squares of same side length k, maximizing k*k.
        # We'll try all possible k from max possible down to 1, and check if we can place two non-overlapping squares of that size.
        
        max_possible_k = 0
        for i in range(m):
            for j in range(n):
                if dp[i][j] > max_possible_k:
                    max_possible_k = dp[i][j]
        
        # We'll try k from max_possible_k down to 1
        # For a given k, we need to know all positions where a square of size k can be placed (i.e., where dp[i][j] >= k and the square fits)
        # We'll collect all top-left corners of squares of size k.
        # A square of size k with bottom-right at (i, j) has top-left at (i-k+1, j-k+1) and requires i>=k-1, j>=k-1.
        # It is valid if dp[i][j] >= k.
        
        best_area = 0
        
        for k in range(max_possible_k, 0, -1):
            if k * k <= best_area:  # no need to check if k*k <= current best, since we want maximum area
                continue
            
            squares = []  # list of (top, left) for squares of size k
            for i in range(k-1, m):
                for j in range(k-1, n):
                    if dp[i][j] >= k:
                        top = i - k + 1
                        left = j - k + 1
                        squares.append((top, left))
            
            if len(squares) < 2:
                continue
            
            # Check if there exist two non-overlapping squares among the list
            found = False
            # Sort by row then column for efficiency
            squares.sort()
            # Try all pairs - but we can optimize: for each square, check if any other square does not overlap
            # Two squares of size k overlap if their bounding boxes intersect.
            # Square A: [topA, topA+k-1] x [leftA, leftA+k-1]
            # Square B: [topB, topB+k-1] x [leftB, leftB+k-1]
            # They overlap if topA < topB+k-1 and topB < topA+k-1 and leftA < leftB+k-1 and leftB < leftA+k-1
            # Non-overlap if:
            #   topA + k <= topB  OR topB + k <= topA  OR leftA + k <= leftB OR leftB + k <= leftA
            
            # We'll check all pairs; m,n <= 500, and number of squares for a given k is at most O(m*n) but typically less.
            # Worst-case k=1, squares = all ones, up to 250000, checking all pairs would be O(N^2) which might be too slow.
            # But we can break early once we find one valid pair.
            # We'll iterate and for each square, check against others that start after in row-major order to avoid duplicate checks.
            for idx in range(len(squares)):
                top1, left1 = squares[idx]
                # range of rows: [top1, top1+k-1], cols [left1, left1+k-1]
                for jdx in range(idx + 1, len(squares)):
                    top2, left2 = squares[jdx]
                    # Check non-overlap
                    if top1 + k <= top2 or top2 + k <= top1 or left1 + k <= left2 or left2 + k <= left1:
                        found = True
                        break
                if found:
                    break
            
            if found:
                best_area = k * k
                # Since we're iterating k from large to small, the first found k gives maximum area
                return best_area
        
        return 0
