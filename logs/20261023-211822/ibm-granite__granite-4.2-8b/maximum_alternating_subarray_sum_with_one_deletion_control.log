class Solution:
    def maxAlternatingSum(self, nums: list[int]) -> int:
        NEG_INF = -10**18
        
        def max_alt(arr):
            if not arr:
                return NEG_INF
            cur_even = arr[0]
            cur_odd = NEG_INF
            best = cur_even
            for x in arr[1:]:
                new_cur_even = x if cur_odd == NEG_INF else max(x, cur_odd + x)
                # Actually cur_odd might be NEG_INF for first iteration, so handle generally:
                # new_cur_even = max(x, cur_odd + x) works if cur_odd is NEG_INF? NEG_INF + x is still very small, but max(x, NEG_INF+x) = x since NEG_INF+x is very small. So we can just do:
                new_cur_even = max(x, cur_odd + x)
                new_cur_odd = cur_even - x
                cur_even, cur_odd = new_cur_even, new_cur_odd
                if cur_even > best:
                    best = cur_even
                if cur_odd > best:
                    best = cur_odd
            return best
        
        # No deletion
        ans = max_alt(nums)
        
        # One deletion
        n = len(nums)
        for del_idx in range(n):
            b = nums[:del_idx] + nums[del_idx+1:]
            if b:
                cand = max_alt(b)
                if cand > ans:
                    ans = cand
        
        return ans
