```python
import bisect

class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        # Sort intervals by start (and end for tie-breaking)
        intervals.sort(key=lambda x: (x[0], x[1]))
        
        # Collect and sort unique end values for coordinate compression
        ends = sorted({e for _, e in intervals})
        comp = {v: i+1 for i, v in enumerate(ends)}  # 1-indexed
        size = len(ends)
        
        # Fenwick Tree (Binary Indexed Tree) for prefix sums
        class BIT:
            def __init__(self, n):
                self.n = n
                self.tree = [0] * (n + 1)
            
            def update(self, i, delta):
                while i <= self.n:
                    self.tree[i] += delta
                    i += i & -i
            
            def query(self, i):
                # prefix sum 1..i; for i <= 0 return 0
                if i <= 0:
                    return 0
                s = 0
                while i > 0:
                    s += self.tree[i]
                    i -= i & -i
                return s
        
        bit = BIT(size)
        total = 0          # total intersecting pairs
        inserted = 0       # number of intervals processed so far
        
        for s, e in intervals:
            # Count of unique end values strictly less than s
            idx = bisect.bisect_left(ends, s)
            less = bit.query(idx)          # intervals with end < s
            ge = inserted - less           # intervals with end >= s (intersect)
            total += ge
            
            bit.update(comp[e], 1)
            inserted += 1
        
        return total
