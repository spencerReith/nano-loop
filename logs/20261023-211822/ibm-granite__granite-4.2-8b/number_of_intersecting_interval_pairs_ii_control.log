import bisect

class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        intervals.sort(key=lambda x: (x[0], x[1]))
        ends = sorted({e for _, e in intervals})
        comp = {v: i+1 for i, v in enumerate(ends)}
        size = len(ends)
        
        class BIT:
            def __init__(self, n):
                self.n = n
                self.tree = [0]*(n+1)
            def update(self, i, delta):
                while i <= self.n:
                    self.tree[i] += delta
                    i += i & -i
            def query(self, i):
                if i <= 0:
                    return 0
                s = 0
                while i > 0:
                    s += self.tree[i]
                    i -= i & -i
                return s
        
        bit = BIT(size)
        total = 0
        inserted = 0
        for s, e in intervals:
            idx = bisect.bisect_left(ends, s)  # count of unique ends < s
            less = bit.query(idx)
            ge = inserted - less
            total += ge
            bit.update(comp[e], 1)
            inserted += 1
        
        return total
