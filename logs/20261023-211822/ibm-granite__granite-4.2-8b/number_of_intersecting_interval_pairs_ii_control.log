```python
import bisect

class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        # Sort by start
        intervals.sort(key=lambda x: (x[0], x[1]))
        # Collect ends
        ends = sorted({e for _, e in intervals})
        # Map end to compressed index (1-based)
        comp = {v: i+1 for i, v in enumerate(ends)}
        size = len(ends)
        
        # BIT implementation
        class BIT:
            def __init__(self, n):
                self.n = n
                self.tree = [0]*(n+1)
            def update(self, i, delta):
                while i <= self.n:
                    self.tree[i] += delta
                    i += i & -i
            def query(self, i):
                # prefix sum 1..i, i can be 0 -> return 0
                if i <= 0:
                    return 0
                s = 0
                while i > 0:
                    s += self.tree[i]
                    i -= i & -i
                return s
        
        bit = BIT(size)
        total = 0
        inserted = 0
        
        for s, e in intervals:
            # number of unique ends < s
            idx = bisect.bisect_left(ends, s)  # count of ends < s
            # less = number of previous intervals with end < s
            less = bit.query(idx)  # because idx is count of unique ends < s, and their comp indices are 1..idx
            ge = inserted - less
            total += ge
            # update BIT for current interval's end
            bit.update(comp[e], 1)
            inserted += 1
        
        return total
