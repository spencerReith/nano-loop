from solution import Solution

def test():
    sol = Solution()
    
    # Example 1
    nums = [4,1,2]
    k = 3
    res = sol.longestSubarray(nums, k)
    expected = 3
    print(f"Example 1: nums={nums}, k={k}, got {res}, expected {expected}, {'PASS' if res == expected else 'FAIL'}")
    
    # Example 2
    nums = [5,3,4]
    k = 7
    res = sol.longestSubarray(nums, k)
    expected = 2
    print(f"Example 2: nums={nums}, k={k}, got {res}, expected {expected}, {'PASS' if res == expected else 'FAIL'}")
    
    # Example 3
    nums = [2,2,5]
    k = 6
    res = sol.longestSubarray(nums, k)
    expected = 2
    print(f"Example 3: nums={nums}, k={k}, got {res}, expected {expected}, {'PASS' if res == expected else 'FAIL'}")
    
    # Edge: single element divisible
    nums = [3]
    k = 3
    res = sol.longestSubarray(nums, k)
    expected = 1
    print(f"Edge 1: nums={nums}, k={k}, got {res}, expected {expected}, {'PASS' if res == expected else 'FAIL'}")
    
    # Edge: single element not divisible
    nums = [1]
    k = 1
    res = sol.longestSubarray(nums, k)
    expected = 1  # 1%1=0, divisible
    print(f"Edge 2: nums={nums}, k={k}, got {res}, expected {expected}, {'PASS' if res == expected else 'FAIL'}")
    
    # Edge: single element k=2, num=1
    nums = [1]
    k = 2
    res = sol.longestSubarray(nums, k)
    expected = 0
    print(f"Edge 3: nums={nums}, k={k}, got {res}, expected {expected}, {'PASS' if res == expected else 'FAIL'}")
    
    # Edge: nums=[1,-1], k=2
    nums = [1,-1]
    k = 2
    res = sol.longestSubarray(nums, k)
    expected = 2  # sum=0
    print(f"Edge 4: nums={nums}, k={k}, got {res}, expected {expected}, {'PASS' if res == expected else 'FAIL'}")
    
    # Edge: nums=[1,-2], k=3
    nums = [1,-2]
    k = 3
    res = sol.longestSubarray(nums, k)
    expected = 2  # [1,-2] sum=-1, negate -2 to 2: sum=3≡0
    print(f"Edge 5: nums={nums}, k={k}, got {res}, expected {expected}, {'PASS' if res == expected else 'FAIL'}")
    
    # Edge: empty? no, n>=1
    # Example: nums=[0], k=5, sum=0 divisible
    nums = [0]
    k = 5
    res = sol.longestSubarray(nums, k)
