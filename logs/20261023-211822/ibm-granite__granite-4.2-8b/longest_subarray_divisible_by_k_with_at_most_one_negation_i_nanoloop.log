def longestSubarray(self, nums: list[int], k: int) -> int:
    n = len(nums)
    if n == 0:
        return 0
    prefix = [0] * (n + 1)
    for i in range(n):
        prefix[i+1] = prefix[i] + nums[i]
    
    # case 1: no negation, sum divisible by k
    max1 = 0
    rem_to_idx1 = {0: 0}  # prefix[0] = 0 at idx 0
    for i in range(1, n + 1):
        rem = prefix[i] % k
        if rem in rem_to_idx1:
            # subarray [rem_to_idx1[rem], i-1], length i - rem_to_idx1[rem]
            length = i - rem_to_idx1[rem]
            if length > max1:
                max1 = length
        else:
            rem_to_idx1[rem] = i
    
    # case 2: exactly one negation
    max2 = 0
    for m in range(n):  # m is nums index 0..n-1
        val = (2 * nums[m]) % k
        # store prefix[i] % k for i=0..m (prefix indices)
        rem_to_idx2 = {}
        rem0 = 0 % k  # 0
        rem_to_idx2[rem0] = 0  # prefix[0] at index 0
        for i in range(1, m + 1):  # prefix indices 1..m
            rem = prefix[i] % k
            if rem not in rem_to_idx2:
                rem_to_idx2[rem] = i
        # iterate r from m to n-1 (nums index)
        for r in range(m, n):  # nums index r = m..n-1
            rem_r = prefix[r + 1] % k
            target = (rem_r - val) % k
            if target in rem_to_idx2:
                l_idx = rem_to_idx2[target]  # prefix index
                # subarray nums[l_idx..r], length r - l_idx + 1
                length = r - l_idx + 1
                if length > max2:
                    max2 = length
    
    return max(max1, max2)

Wait, in case1, length = i - rem_to_idx1[rem], since prefix[i] - prefix[j] where j = rem_to_idx1[rem], subarray nums[j..i-1], length (i-1) - j + 1 = i - j, correct.

In case2, length = r - l_idx + 1, since prefix[l_idx] = sum nums[0..l_idx-1], prefix[r+1] = sum nums[0..r], subarray nums[l_idx..r], length r - l_idx + 1, correct.

But in case1, when we see rem in rem_to_idx1, we should not update rem_to_idx1[rem] because we want the earliest index.

In the code above, for case1, if rem in rem_to_idx1, we don't set rem_to_idx1[rem] again, which is correct (keep earliest).

Similarly for case2, only set if not present.

