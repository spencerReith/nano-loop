So the code:

```python
class Solution:
    def countKthRoots(self, l: int, r: int, k: int) -> int:
        if k == 1:
            return r - l + 1
        
        total = 0
        if l <= 0 <= r:
            total = 1
        
        # For positive x (x>=1), we need to count x such that x^k in [l, r]
        # If r == 0, then no positive x can be in range (since smallest positive y=1>0), so skip counting positive x if r==0.
        # But our binary search with high_bound=2 will work.
        # Compute high_bound = int(r ** (1.0 / k)) + 2
        # Note: when r == 0, r**(1.0/k) = 0.0, so int(0.0)=0, high_bound=2.
        high_bound = int(r ** (1.0 / k)) + 2
        # However, ensure high_bound is at least 1 (but it's at least 2)
        
        # Binary search for min_x: smallest x>=1 with x^k >= l
        lo, hi = 1, high_bound
        while lo < hi:
            mid = (lo + hi) // 2
            if mid ** k < l:
                lo = mid + 1
            else:
                hi = mid
        min_x = lo
        
        # Binary search for max_x: largest x>=1 with x^k <= r
        lo2, hi2 = 1, high_bound
        while lo2 < hi2:
            mid = (lo2 + hi2 + 1) // 2
            if mid ** k <= r:
                lo2 = mid
            else:
                hi2 = mid - 1
        max_x = lo2
        
        # Check if max_x is valid (because binary search might return 1 even if 1^k>r)
        if max_x ** k > r:
            count_pos = 0
        else:
            if min_x <= max_x:
                count_pos = max_x - min_x + 1
            else:
                count_pos = 0
        
        total += count_pos
        return total
```

