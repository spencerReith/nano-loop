```python
from typing import List

class Solution:
    def maximumSaleItems(self, items: List[List[int]], budget: int) -> int:
        n = len(items)
        factors = [items[i][0] for i in range(n)]
        prices = [items[i][1] for i in range(n)]
        
        # Compute free_count[i]: number of j != i such that factor_i divides factor_j
        free_count = [0] * n
        for i in range(n):
            f_i = factors[i]
            for j in range(n):
                if i == j:
                    continue
                f_j = factors[j]
                if f_j % f_i == 0:
                    free_count[i] += 1
        
        best = 0
        # Enumerate all subsets S of item types to buy at least one copy
        # mask bit i = 1 means item i is in S (bought at least once)
        for mask in range(1 << n):
            cost_S = 0
            for i in range(n):
                if mask & (1 << i):
                    cost_S += prices[i]
            if cost_S > budget:
                continue
            size_S = bin(mask).count("1")
            free_S = 0
            for i in range(n):
                if mask & (1 << i):
                    free_S += free_count[i]
            
            # If S is empty, just buy cheapest items
            if size_S == 0:
                min_price = min(prices)
                extra = budget // min_price
                total = extra
                if total > best:
                    best = total
                continue
            
            min_price_in_S = min(prices[i] for i in range(n) if mask & (1 << i))
            extra = (budget - cost_S) // min_price_in_S
            total = size_S + free_S + extra
            if total > best:
                best = total
        
        return best
```
