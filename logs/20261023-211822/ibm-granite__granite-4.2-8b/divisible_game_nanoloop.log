import math

class Solution:
    def divisibleGame(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        
        n = len(nums)
        if n == 0:
            return 0
        
        min_nums = min(nums)
        baseline_diff = -min_nums
        
        # collect divisors >1
        divisors = set()
        for num in nums:
            if num > 1:
                divisors.add(num)
                limit = int(math.isqrt(num))
                for d in range(2, limit + 1):
                    if num % d == 0:
                        divisors.add(d)
                        other = num // d
                        if other != d:
                            divisors.add(other)
        
        # find smallest non-divisor K_min_non >1 not in divisors
        K_min_non = 2
        while K_min_non in divisors:
            K_min_non += 1
        
        # Kadane helper
        def kadane(arr):
            best = cur = arr[0]
            for x in arr[1:]:
                cur = max(x, cur + x)
                best = max(best, cur)
            return best
        
        best_diff_div = -10**18
        best_k_div = None
        
        if divisors:
            for k in divisors:
                a = []
                for val in nums:
                    if val % k == 0:
                        a.append(val)
                    else:
                        a.append(-val)
                diff_k = kadane(a)
                if diff_k > best_diff_div:
                    best_diff_div = diff_k
                    best_k_div = k
                elif diff_k == best_diff_div and k < best_k_div:
                    best_k_div = k
        
        if not divisors:
            opt_diff = baseline_diff
            opt_k = K_min_non
        else:
            if best_diff_div > baseline_diff:
                opt_diff = best_diff_div
                opt_k = best_k_div
            elif baseline_diff > best_diff_div:
                opt_diff = baseline_diff
                opt_k = K_min_non
            else:  # equal
                opt_diff = baseline_diff
                opt_k = min(K_min_non, best_k_div)
        
        result = (opt_diff * opt_k) % MOD
        return result
```
