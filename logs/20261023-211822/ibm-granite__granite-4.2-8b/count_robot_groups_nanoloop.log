    def countGroups(self, position, speed, distance):
        n = len(position)
        groups = [(position[i], speed[i]) for i in range(n)]
        
        def merge_time(g1, g2):
            pos1, spd1 = g1
            pos2, spd2 = g2
            if pos2 - pos1 <= distance:
                return 0
            if spd2 >= spd1:
                return None  # never merge if not already close
            # spd2 < spd1
            if pos2 - pos1 < distance:
                return 0
            t = (pos2 - pos1 - distance) / (spd1 - spd2)
            if t > 0:
                return t
            return None
        
        INF = 10**30
        changed = True
        while changed:
            changed = False
            min_t = INF
            to_merge = []  # list of (i,j) adjacent pairs that merge at min_t
            for i in range(len(groups)-1):
                t = merge_time(groups[i], groups[i+1])
                if t is None:
                    continue
                if t < min_t - 1e-12:  # t < current min
                    min_t = t
                    to_merge = [(i, i+1)]
                elif abs(t - min_t) < 1e-12 and t < INF:
                    to_merge.append((i, i+1))
            if min_t < INF:
                # Merge all adjacent pairs with merge time == min_t
                # Collect involved indices
                involved = set()
                for i,j in to_merge:
                    involved.add(i)
                    involved.add(j)
                involved = sorted(involved)
                # Merge consecutive involved groups
                # The merged group takes the rightmost robot's (pos, speed)
                new_groups = []
                i = 0
                while i < len(groups):
                    if i in involved:
                        # Find the rightmost index in involved block
                        # involved is sorted, find block
                        j = i
                        while j+1 < len(involved) and involved[j+1] == involved[j]+1:
                            j += 1
                        # involved[i..j] are consecutive
                        rightmost = groups[involved[j]]
                        new_groups.append(rightmost)
                        i = j+1
                    else:
                        new_groups.append(groups[i])
                        i += 1
                groups = new_groups
                changed = True
        
        return len(groups)
