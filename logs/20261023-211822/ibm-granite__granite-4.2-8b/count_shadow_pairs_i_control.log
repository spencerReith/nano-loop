class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        # Step 1: compute next smaller index (strictly less) to the right
        nxt = [n] * n
        stack = []  # store indices with increasing values (from bottom to top)
        for i in range(n-1, -1, -1):
            while stack and nums[stack[-1]] >= nums[i]:
                stack.pop()
            if stack:
                nxt[i] = stack[-1]
            # else remains n
            stack.append(i)
        
        # Step 2: build removals list
        removals = [[] for _ in range(n)]
        for i in range(n):
            if nxt[i] < n:
                removals[nxt[i]].append(i)
        
        # Step 3: coordinate compression
        vals = sorted(set(nums))
        rank_map = {v: idx+1 for idx, v in enumerate(vals)}  # 1-indexed
        m = len(vals)
        
        # Step 4: BIT
        class BIT:
            def __init__(self, size):
                self.n = size
                self.bit = [0] * (size + 1)
            def add(self, idx, delta):
                # idx is 1-indexed
                while idx <= self.n:
                    self.bit[idx] += delta
                    idx += idx & -idx
            def sum(self, idx):
                # prefix sum 1..idx, idx can be 0 -> return 0
                if idx <= 0:
                    return 0
                res = 0
                while idx > 0:
                    res += self.bit[idx]
                    idx -= idx & -idx
                return res
        
        bit = BIT(m)
        
        ans = 0
        for j in range(n):
            # remove indices scheduled for removal at j
            for i in removals[j]:
                bit.add(rank_map[nums[i]], -1)
            
            rj = rank_map[nums[j]]
            # count active i with value < nums[j]
            if rj > 1:
                cnt = bit.sum(rj - 1)
            else:
                cnt = 0
            ans += cnt
            
            # add current index j as active for future
            bit.add(rj, 1)
        
        return ans
```

