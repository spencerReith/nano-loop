```python
class Solution:
    def minCost(self, grid: list[list[int]], k: int) -> int:
        m = len(grid)
        n = len(grid[0])
        
        # Directions: down, right, up, left
        dirs = [(1, 0), (0, 1), (-1, 0), (0, -1)]
        
        from heapq import heappush, heappop
        
        # State: (cost, i, j, last_dir, turns_used)
        # last_dir = -1 for starting position (no direction yet)
        heap = []
        
        # Start at (0,0) with cost = grid[0][0]
        if m == 1 and n == 1:
            return grid[0][0]
        
        # Start with cost = grid[0][0], last_dir = -1 (no direction), turns_used = 0
        heappush(heap, (grid[0][0], 0, 0, -1, 0))
        
        # Visited set: (i, j, last_dir, turns_used)
        # We store the best cost when we pop a state (Dijkstra property with non-negative weights)
        visited = {}
        
        while heap:
            cost, i, j, d, turns = heappop(heap)
            
            # Check if we're at destination
            if i == m-1 and j == n-1:
                return cost
            
            key = (i, j, d, turns)
            if key in visited and visited[key] <= cost:
                continue
            visited[key] = cost
            
            # Try all directions
            for nd in range(4):
                ni, nj = i + dirs[nd][0], j + dirs[nd][1]
                if 0 <= ni < m and 0 <= nj < n:
                    # Check if this is a turn
                    new_turns = turns
                    if d != -1 and nd != d:  # d != -1 means we have a direction (not starting)
                        if new_turns < k:
                            new_turns += 1
                        else:
                            continue  # cannot exceed k turns
                    # For starting state, d = -1, nd is first direction, no turn
                    
                    new_cost = cost + grid[ni][nj]
                    new_key = (ni, nj, nd, new_turns)
                    # Push to heap without checking visited at push time (check at pop time)
                    heappush(heap, (new_cost, ni, nj, nd, new_turns))
        
        return -1
