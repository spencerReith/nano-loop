class Solution:
    def weightedSum(self, parent: list[int], nums: list[int]) -> int:
        n = len(nums)
        # Build adjacency list (children)
        children = [[] for _ in range(n)]
        for i, p in enumerate(parent):
            if p != -1:
                children[p].append(i)
        
        # DFS to compute depth of each node and also collect depths
        depth = [0] * n
        # root depth = 1
        depth[0] = 1
        stack = [0]
        while stack:
            node = stack.pop()
            for child in children[node]:
                depth[child] = depth[node] + 1
                stack.append(child)
        
        # height = max depth
        height = max(depth)
        
        # sum weights = sum(nums[i] * (height - depth[i] + 1))
        total = 0
        for i in range(n):
            total += nums[i] * (height - depth[i] + 1)
        return total
