        count = 0
        
        for l in range(n):
            total = 0
            for r in range(l, n):
                total += nums[r]
                # Last digit is total % 10
                if total % 10 != x:
                    continue
                # First digit is the leftmost digit in decimal representation
                # nums[i] >= 1 so total >= 1, no leading zeros
                if int(str(total)[0]) == x:
                    count += 1
        
        return count
