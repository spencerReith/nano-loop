class Solution:
    def countTasks(self, tasks: list[int], shifts: list[int]) -> list[int]:
        # Total tasks length
        n = len(tasks)
        
        # Track current task index and remaining work for current task
        cur_task = 0
        cur_remaining = tasks[0] if n > 0 else 0
        
        # Store results
        ans = []
        
        for shift_time in shifts:
            # If all tasks were completed in previous shift, restart from task 0
            if cur_task >= n:
                # Restart from task 0
                cur_task = 0
                cur_remaining = tasks[0] if n > 0 else 0
            
            # Use shift_time to process tasks
            while shift_time > 0 and cur_task < n:
                # How much can we use for current task
                use = min(shift_time, cur_remaining)
                cur_remaining -= use
                shift_time -= use
                
                # If current task is completed, move to next task
                if cur_remaining == 0:
                    cur_task += 1
                    if cur_task < n:
                        cur_remaining = tasks[cur_task]
                    else:
                        # All tasks completed in this shift
                        break
            
            # After processing this shift, count unfinished tasks
            # Unfinished tasks are all tasks from cur_task onwards (current task if in progress + all subsequent tasks)
            if cur_task < n:
                ans.append(n - cur_task)
            else:
                # All tasks completed
                ans.append(0)
        
        return ans
