class Solution:
    def minimumCost(self, nums: list[int], k: int) -> int:
        MOD = 10**9 + 7
        total_ops = 0          # number of operations performed so far
        current_res = k       # current available resources
        total_cost = 0
        
        for need in nums:
            if current_res < need:
                # deficit = need - current_res
                # each operation adds k resources
                # we need at least ceil(deficit / k) more operations
                deficit = need - current_res
                ops_needed = (deficit + k - 1) // k
                total_ops += ops_needed
                # cost of the next ops are total_ops - ops_needed + 1 ... total_ops
                # sum of arithmetic series
                start = total_ops - ops_needed + 1
                end = total_ops
                # sum = (start + end) * ops_needed // 2
                # use modular arithmetic carefully
                # ops_needed up to 1e9? but in practice limited by deficit/k, but ops_needed could be large
                # however nums length <= 1e5, and each ops_needed is at most ceil(need/k) which could be up to 1e9? need up to 1e9, k>=1, so ops_needed up to 1e9
                # but total_ops over all may be up to 1e14? However we cannot iterate per op
                # we use formula
                ops_needed_mod = ops_needed % MOD  # but division by 2 requires modular inverse? Actually we need integer sum before mod, but sum may be huge, but we can compute using integer arithmetic (Python big ints) then mod at end.
                # Python integers are arbitrary precision, so compute exact sum then mod.
                total_cost += (start + end) * ops_needed // 2
                # after adding resources from ops
                current_res += k * ops_needed
            # now current_res >= need
            current_res -= need
            
        return total_cost % MOD
