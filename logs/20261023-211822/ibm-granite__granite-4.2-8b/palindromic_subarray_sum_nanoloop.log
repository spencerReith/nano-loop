class Solution:
    def getSum(self, nums: list[int]) -> int:
        n = len(nums)
        max_sum = max(nums)  # single element
        
        # odd centers
        for i in range(n):
            left = i
            right = i
            cur_sum = nums[i]
            # expand outward
            while left - 1 >= 0 and right + 1 < n and nums[left - 1] == nums[right + 1]:
                left -= 1
                right += 1
                cur_sum += nums[left] + nums[right]
                if cur_sum > max_sum:
                    max_sum = cur_sum
        
        # even centers
        for i in range(n - 1):
            if nums[i] == nums[i + 1]:
                left = i
                right = i + 1
                cur_sum = nums[i] + nums[i + 1]
                if cur_sum > max_sum:
                    max_sum = cur_sum
                while left - 1 >= 0 and right + 1 < n and nums[left - 1] == nums[right + 1]:
                    left -= 1
                    right += 1
                    cur_sum += nums[left] + nums[right]
                    if cur_sum > max_sum:
                        max_sum = cur_sum
        
        return max_sum
