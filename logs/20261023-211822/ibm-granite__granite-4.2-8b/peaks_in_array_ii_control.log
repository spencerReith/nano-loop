        """
        import bisect

        class Solution:
            def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
                n = len(nums)
                if n < 3:
                    return []
                is_peak = [False] * n
                peaks = []
                for k in range(1, n - 1):
                    if nums[k] > nums[k - 1] and nums[k] > nums[k + 1]:
                        is_peak[k] = True
                        peaks.append(k)
                peaks.sort()
                
                answers = []
                
                for q in queries:
                    if q[0] == 1:
                        _, L, R = q
                        seg_len = R - L + 1
                        if seg_len < 3:
                            answers.append(0)
                            continue
                        total = (seg_len - 2) * (seg_len - 1) // 2
                        # get indices of peaks in [L, R]
                        left_idx = bisect.bisect_left(peaks, L)
                        right_idx = bisect.bisect_right(peaks, R) - 1
                        if left_idx > right_idx:
                            # no peaks in the segment -> all subarrays are clean -> no peak subarrays
                            answers.append(0)
                            continue
                        peaks_list = peaks[left_idx: right_idx + 1]  # sorted
                        clean_count = 0
                        ptr = 0
                        # iterate over start indices i in [L, R-2]
                        for i in range(L, R - 1):  # i <= R-2
                            # advance ptr to first peak > i
                            while ptr < len(peaks_list) and peaks_list[ptr] <= i:
                                ptr += 1
                            next_peak = peaks_list[ptr] if ptr < len(peaks_list) else R + 1
                            j_max = min(R, next_peak)  # j can be up to next_peak (peak at boundary allowed)
                            if j_max >= i + 2:
                                clean_count += j_max - i - 1
                        answers.append(total - clean_count)
                    else:  # type 2: [2, idx, val]
                        _, idx, val = q
                        nums[idx] = val
                        # recompute peak status for idx-1, idx, idx+1 (if within [1, n-2])
                        for k in (idx - 1, idx, idx + 1):
                            if k < 1 or k > n - 2:
                                continue
                            old = is_peak[k]
                            new = (nums[k] > nums[k - 1] and nums[k] > nums[k + 1])
                            if old == new:
                                continue
                            if new:
                                # add if not already present (old must be False)
                                if not old:
                                    bisect.insort(peaks, k)
                                    is_peak[k] = True
                            else:
                                # remove if old was True
                                if old:
                                    pos = bisect.bisect_left(peaks, k)
                                    if pos < len(peaks) and peaks[pos] == k:
                                        peaks.pop(pos)
                                        is_peak[k] = False
                return answers
```python
import bisect

class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums)
        if n < 3:
            return []
        is_peak = [False] * n
        peaks = []
        for k in range(1, n - 1):
            if nums[k] > nums[k - 1] and nums[k] > nums[k + 1]:
                is_peak[k] = True
                peaks.append(k)
        peaks.sort()
        
        answers = []
        
        for q in queries:
            if q[0] == 1:
                _, L, R = q
                seg_len = R - L + 1
                if seg_len < 3:
                    answers.append(0)
                    continue
                total = (seg_len - 2) * (seg_len - 1) // 2
                # get peaks in [L, R]
                left_idx = bisect.bisect_left(peaks, L)
                right_idx = bisect.bisect_right(peaks, R) - 1
                if left_idx > right_idx:
                    answers.append(0)
                    continue
                peaks_list = peaks[left_idx: right_idx + 1]
                clean_count = 0
                ptr = 0
                for i in range(L, R - 1):  # i <= R-2
                    while ptr < len(peaks_list) and peaks_list[ptr] <= i:
                        ptr += 1
                    next_peak = peaks_list[ptr] if ptr < len(peaks_list) else R + 1
                    j_max = min(R, next_peak)
                    if j_max >= i + 2:
                        clean_count += j_max - i - 1
                answers.append(total - clean_count)
            else:  # type 2: [2, idx, val]
                _, idx, val = q
                nums[idx] = val
                for k in (idx - 1, idx, idx + 1):
                    if k < 1 or k > n - 2:
                        continue
                    old = is_peak[k]
                    new = (nums[k] > nums[k - 1] and nums[k] > nums[k + 1])
                    if old == new:
                        continue
                    if new:
                        if not old:
                            bisect.insort(peaks, k)
                            is_peak[k] = True
                    else:
                        if old:
                            pos = bisect.bisect_left(peaks, k)
                            if pos < len(peaks) and peaks[pos] == k:
                                peaks.pop(pos)
                                is_peak[k] = False
        return answers
