class Solution:
    def weightedSum(self, parent: list[int], nums: list[int]) -> int:
        n = len(nums)
        children = [[] for _ in range(n)]
        for i in range(1, n):
            p = parent[i]
            children[p].append(i)
        
        # Compute depth of each node and height of the tree via DFS
        depth = [0] * n
        height = 0
        
        stack = [(0, 1)]  # (node, depth) root depth = 1
        while stack:
            node, d = stack.pop()
            depth[node] = d
            height = max(height, d)
            for child in children[node]:
                stack.append((child, d + 1))
        
        # Compute weighted sum
        total = 0
        for i in range(n):
            total += nums[i] * (height - depth[i] + 1)
        
        return total
