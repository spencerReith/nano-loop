            diff = [0] * (n + 1)
            for i, v in enumerate(lights):
                if v > 0:
                    left = max(0, i - v)
                    right = min(n - 1, i + v)
                    diff[left] += 1
                    diff[right + 1] -= 1

            cur = 0
            cover = [False] * n
            for i in range(n):
                cur += diff[i]
                if cur > 0:
                    cover[i] = True

