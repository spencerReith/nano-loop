class Solution:
    def minBishopMoves(self, source: list[int], target: list[int]) -> int:
        sr, sc = source
        tr, tc = target
        
        # Check if same parity (color) of squares
        # Bishop stays on same color
        if (sr + sc) % 2 != (tr + tc) % 2:
            return -1
        
        # If already same square (though guaranteed source != target, but safe)
        if sr == tr and sc == tc:
            return 0
        
        # If on same diagonal, one move
        if abs(sr - tr) == abs(sc - tc):
            return 1
        
        # Otherwise, on same color but not same diagonal -> need 2 moves
        return 2
