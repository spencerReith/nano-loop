```python
class Solution:
    def maxSum(self, nums: list[int], k: int, mul: int) -> int:
        # Sort nums in descending order
        nums.sort(reverse=True)
        # Take top k largest numbers
        top_k = nums[:k]
        total = sum(top_k)
        best = total
        # Maximum beneficial multiplications: cannot exceed mul because after mul multiplications, the factor becomes 0
        limit = min(k, mul)
        # Iterate over possible number of multiplications from 1 to limit
        for i in range(limit):
            # i corresponds to the (i+1)-th largest element being multiplied
            # The factor for this element is mul - i, so the extra gain over adding is (mul - i - 1) * top_k[i]
            total += top_k[i] * (mul - i - 1)
            if total > best:
                best = total
        return best
