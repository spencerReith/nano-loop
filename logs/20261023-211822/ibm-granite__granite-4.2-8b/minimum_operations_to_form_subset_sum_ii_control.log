from collections import deque

class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        INF = 10 ** 9
        total = sum                     # avoid shadowing built-in sum
        dp = [INF] * (total + 1)
        dp[0] = 0

        for num in nums:
            # upper bound to keep BFS finite
            U = max(num, 2 * total)

            # BFS to find minimal operations for all reachable values
            dist = {num: 0}
            q = deque([num])
            while q:
                v = q.popleft()
                d = dist[v]
                for nv in (v * 2, v // 2):
                    if nv not in dist and 0 <= nv <= U:
                        dist[nv] = d + 1
                        q.append(nv)

            # collect options (value, cost) with value <= total
            options = []
            for v, c in dist.items():
                if 0 <= v <= total:
                    options.append((v, c))

            # 0/1 knapsack step using a snapshot of previous dp
            dp_prev = dp[:]
            dp_cur = dp_prev[:]          # "not use" the element
            for v, c in options:
                if v == 0 and c > 0:
                    continue            # using 0 with positive cost is never optimal
                for s in range(v, total + 1):
                    if dp_prev[s - v] != INF:
                        new_cost = dp_prev[s - v] + c
                        if new_cost < dp_cur[s]:
                            dp_cur[s] = new_cost
            dp = dp_cur

        ans = dp[total] if dp[total] != INF else -1
        return ans

