class Solution:
    def minOperations(self, s: str) -> int:
        n = len(s)
        best = float('inf')
        for r in range(n):
            rotated = s[r:] + s[:r]
            inc = 0
            for i in range(n // 2):
                j = n - 1 - i
                a1 = ord(rotated[i]) - ord('a')
                a2 = ord(rotated[j]) - ord('a')
                best_pair = 27
                for t in range(26):
                    d1 = (t - a1) % 26
                    d2 = (t - a2) % 26
                    cost = d1 + d2
                    if cost < best_pair:
                        best_pair = cost
                inc += best_pair
            total = r + inc
            if total < best:
                best = total
        return int(best)
