def shadowPairs(self, nums):
    n = len(nums)
    total = 0
    for j in range(n):
        curr_max_less = -10**18  # smaller than any nums[i]
        for i in range(j-1, -1, -1):
            if nums[i] < nums[j]:
                if curr_max_less <= nums[i]:
                    total += 1
