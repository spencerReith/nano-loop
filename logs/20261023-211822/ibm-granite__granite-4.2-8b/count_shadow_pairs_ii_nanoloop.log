```python
class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        total = 0
        for j in range(n):
            curr_max_less = -10**18  # smaller than any nums[i] (nums[i] >= 1)
            for i in range(j - 1, -1, -1):
                if nums[i] < nums[j]:
                    if curr_max_less <= nums[i]:
                        total += 1
                    curr_max_less = max(curr_max_less, nums[i])
                # else: nums[i] >= nums[j], curr_max_less unchanged
        return total
```
