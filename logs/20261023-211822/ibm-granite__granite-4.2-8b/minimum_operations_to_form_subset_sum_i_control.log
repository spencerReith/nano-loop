class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        INF = 10**9
        n = len(nums)
        
        # Preprocess options for each element
        options_list = []
        for v in nums:
            # dict: value -> minimal cost
            opts = {v: 0}   # original with cost 0
            
            # positive e (multiplications only)
            e = 1
            cur = v
            while True:
                cur = v << e          # v * 2^e
                if cur > sum:
                    break
                c = e
                if cur not in opts or c < opts[cur]:
                    opts[cur] = c
                e += 1
            
            # negative e (divisions only), only keep if w <= sum (since w>sum would be dominated by original cost 0)
            d = 1
            while True:
                w = v >> d            # floor(v / 2^d)
                if w == 0:
                    break
                if w <= sum:
                    c = d
                    if w not in opts or c < opts[w]:
                        opts[w] = c
                d += 1
            
            # convert to list of (w, c)
            opt = [(w, opts[w]) for w in opts]
            options_list.append(opt)
        
        # DP over subset sum
        dp = [INF] * (sum + 1)
        dp[0] = 0
        
        for opt in options_list:
            new_dp = [INF] * (sum + 1)
            for s in range(sum + 1):
                if dp[s] == INF:
                    continue
                for w, c in opt:
                    # not include this element in the subset
                    if dp[s] + c < new_dp[s]:
                        new_dp[s] = dp[s] + c
                    # include if within sum
                    if s + w <= sum and dp[s] + c < new_dp[s + w]:
                        new_dp[s + w] = dp[s] + c
            dp = new_dp
        
        ans = dp[sum] if dp[sum] < INF else -1
        return ans
