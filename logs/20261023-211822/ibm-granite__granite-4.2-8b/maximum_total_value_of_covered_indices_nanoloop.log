```python
class Solution:
    def maxTotal(self, nums: list[int], s: str) -> int:
        n = len(nums)
        i = 0
        total = 0
        while i < n:
            if s[i] == '1':
                l = i
                while i < n and s[i] == '1':
                    i += 1
                r = i - 1
                k = r - l + 1
                vals = []
                if l > 0:
                    vals.append(nums[l-1])
                for j in range(l, r+1):
                    vals.append(nums[j])
                vals.sort(reverse=True)
                total += sum(vals[:k])
            else:
                i += 1
        return total
```

