```python
class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        INF = 10**30
        stack = []  # each element: (pos0, spd, left_lmt)

        for pos, spd in zip(position, speed):
            # Try to merge with stack top(s)
            while stack:
                last_pos0, last_spd, last_lmt = stack[-1]
                d0 = pos - last_pos0  # > 0 because positions strictly increasing
                if last_spd > spd:
                    if d0 <= distance:
                        t_merge = 0.0
                    else:
                        t_merge = (d0 - distance) / (last_spd - spd)
                else:  # last_spd <= spd
                    if d0 <= distance:
                        t_merge = 0.0
                    else:
                        t_merge = INF

                # Only merge if merge with right happens strictly earlier than
                # merge with left (last_lmt). This avoids keeping groups that
                # would merge simultaneously; simultaneous merges are handled
                # by popping the left group when the right merge time equals
                # left merge time? We use strict < to avoid keeping two groups
                # that would merge at the same time; in practice equal times
                # are rare or handled by popping earlier.
                if t_merge < last_lmt:
                    stack.pop()
                else:
                    break

            # Determine left_lmt for current robot
            if stack:
                last_pos0, last_spd, _ = stack[-1]
                d0 = pos - last_pos0
                if last_spd > spd:
                    if d0 <= distance:
                        lmt = 0.0
                    else:
                        lmt = (d0 - distance) / (last_spd - spd)
                else:
                    if d0 <= distance:
                        lmt = 0.0
                    else:
                        lmt = INF
            else:
                lmt = INF

            stack.append((pos, spd, lmt))

        return len(stack)
