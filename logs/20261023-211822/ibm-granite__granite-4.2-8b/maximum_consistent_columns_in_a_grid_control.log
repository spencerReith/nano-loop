```python
class Solution:
    def maxConsistentColumns(self, grid: list[list[int]], limit: int) -> int:
        m = len(grid)
        n = len(grid[0])
        # Precompute ok[i][j] for i < j: True if for all rows, |grid[row][j] - grid[row][i]| <= limit
        ok = [[False] * n for _ in range(n)]
        for i in range(n):
            for j in range(i + 1, n):
                consistent = True
                for row in range(m):
                    if abs(grid[row][j] - grid[row][i]) > limit:
                        consistent = False
                        break
                if consistent:
                    ok[i][j] = True
        
        dp = [1] * n  # longest consistent subsequence ending at column i
        best = 1
        for j in range(n):
            for i in range(j):
                if ok[i][j]:
                    if dp[i] + 1 > dp[j]:
                        dp[j] = dp[i] + 1
            if dp[j] > best:
                best = dp[j]
        
        return best
```

