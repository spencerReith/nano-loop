class Solution:
    def maxScore(self, grid: list[list[int]]) -> int:
        m = len(grid)
        n = len(grid[0])
        
        # DFS for player1 paths (right/down)
        def dfs1(i, j, path):
            if i == m-1 and j == n-1:
                return [path]
            res = []
            if j+1 < n:
                ns = set(path)
                ns.add((i, j+1))
                res.extend(dfs1(i, j+1, ns))
            if i+1 < m:
                ns = set(path)
                ns.add((i+1, j))
                res.extend(dfs1(i+1, j, ns))
            return res
        
        # DFS for player2 paths (right/up)
        def dfs2(i, j, path):
            if i == 0 and j == n-1:
                return [path]
            res = []
            if j+1 < n:
                ns = set(path)
                ns.add((i, j+1))
                res.extend(dfs2(i, j+1, ns))
            if i-1 >= 0:
                ns = set(path)
                ns.add((i-1, j))
                res.extend(dfs2(i-1, j, ns))
            return res
        
        start1 = {(0,0)}
        all1 = dfs1(0, 0, start1)
        start2 = {(m-1, 0)}
        all2 = dfs2(m-1, 0, start2)
        
        best = -10**9
        for p1 in all1:
            for p2 in all2:
                inter = p1 & p2
                s = sum(grid[i][j] for (i,j) in inter)
                if s > best:
                    best = s
        return best
```

