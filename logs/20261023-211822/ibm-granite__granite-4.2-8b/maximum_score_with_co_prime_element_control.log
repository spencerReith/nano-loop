```python
import math
from typing import List

class Solution:
    def maxScore(self, nums: List[int], maxVal: int) -> int:
        if not nums:
            return 0
        
        max_num = max(nums)
        M = max(max_num, maxVal)
        
        # frequency of each value in nums
        freq = [0] * (M + 1)
        for x in nums:
            freq[x] += 1
        
        # cnt[d] = number of elements in nums divisible by d
        cnt = [0] * (M + 1)
        for d in range(1, M + 1):
            for m in range(d, M + 1, d):
                cnt[d] += freq[m]
        
        # smallest prime factor sieve
        spf = list(range(M + 1))
        for i in range(2, int(M ** 0.5) + 1):
            if spf[i] == i:
                for j in range(i * i, M + 1, i):
                    if spf[j] == j:
                        spf[j] = i
        
        # total[v] = number of indices j with gcd(v, nums[j]) != 1
        total = [0] * (M + 1)
        total[1] = 0
        for v in range(2, M + 1):
            # distinct prime factors of v
            x = v
            primes = []
            while x > 1:
                p = spf[x]
                primes.append(p)
                while x % p == 0:
                    x //= p
            primes = sorted(set(primes))
            k = len(primes)
            tot = 0
            # inclusion-exclusion over non-empty subsets of prime factors
            for mask in range(1, 1 << k):
                prod = 1
                bits = 0
                for i in range(k):
                    if (mask >> i) & 1:
                        prod *= primes[i]
                        bits += 1
                if bits % 2 == 1:
                    tot += cnt[prod]
                else:
                    tot -= cnt[prod]
            total[v] = tot
        
        present = set(nums)
        best = 0
        
        for v in range(1, M + 1):
            # candidate v is allowed if it can be the selected value
            if v <= maxVal or v in present:
                if v <= maxVal:
                    if v == 1:
                        delta_min = 0 if 1 in present else 1
                    else:  # v > 1
                        if v in present:
                            delta_min = -1
                        else:
                            if total[v] > 0:
                                delta_min = 0
                            else:
                                delta_min = 1
                    min_mod = total[v] + delta_min
                else:  # v > maxVal  -> must pick an index where nums[i] = v (and not change it)
                    # v in present guaranteed by the outer if
                    min_mod = total[v] - 1
                
                score = v - min_mod
                if score > best:
                    best = score
        
        return best
