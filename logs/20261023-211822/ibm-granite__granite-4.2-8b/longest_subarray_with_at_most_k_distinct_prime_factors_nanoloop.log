class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        # Helper function to get distinct prime factors of a number
        def prime_factors(n):
            factors = set()
            # Handle 2 separately
            if n % 2 == 0:
                factors.add(2)
                while n % 2 == 0:
                    n //= 2
            # Check odd numbers up to sqrt(n)
            i = 3
            while i * i <= n:
                if n % i == 0:
                    factors.add(i)
                    while n % i == 0:
                        n //= i
                i += 2
            # If n is still > 1, it's a prime
            if n > 1:
                factors.add(n)
            return factors
        
        # Precompute factors for all numbers to avoid recomputation
        factors_list = [prime_factors(num) for num in nums]
        
        # Sliding window with prime frequency map
        prime_freq = {}
        left = 0
        distinct_primes = 0
        max_len = 0
        
        for right, factors in enumerate(factors_list):
            # Add factors to frequency map
            for p in factors:
                if p not in prime_freq or prime_freq[p] == 0:
                    distinct_primes += 1
                prime_freq[p] = prime_freq.get(p, 0) + 1
            
            # Shrink window if we exceed k
            while distinct_primes > k:
                # Remove factors from left element
                left_factors = factors_list[left]
                for p in left_factors:
                    prime_freq[p] -= 1
                    if prime_freq[p] == 0:
                        distinct_primes -= 1
                left += 1
            
            # Update max length (subarray length is right-left+1)
            max_len = max(max_len, right - left + 1)
        
        return max_len
