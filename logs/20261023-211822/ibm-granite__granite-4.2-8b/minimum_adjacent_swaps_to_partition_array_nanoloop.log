```python
class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        
        # Count categories
        L_count = 0
        M_count = 0
        R_count = 0
        
        for x in nums:
            if x < a:
                L_count += 1
            elif a <= x <= b:
                M_count += 1
            else:  # x > b
                R_count += 1
        
        # Assign ranks: 0..L_count-1 for L, L_count..L_count+M_count-1 for M,
        # L_count+M_count..n-1 for R, preserving relative order within each category
        L_pos = 0
        M_pos = 0
        R_pos = 0
        
        ranks = []
        for x in nums:
            if x < a:
                ranks.append(L_pos)
                L_pos += 1
            elif a <= x <= b:
                ranks.append(L_count + M_pos)
                M_pos += 1
            else:  # x > b
                ranks.append(L_count + M_count + R_pos)
                R_pos += 1
        
        # Count inversions in ranks using Fenwick Tree (Binary Indexed Tree)
        class FenwickTree:
            def __init__(self, size):
                self.n = size
                self.tree = [0] * (self.n + 1)
            
            def update(self, idx, delta):
                # idx is 1-based
                while idx <= self.n:
                    self.tree[idx] += delta
                    idx += idx & -idx
            
            def query(self, idx):
                # sum of [1, idx] (1-based)
                s = 0
                while idx > 0:
                    s += self.tree[idx]
                    idx -= idx & -idx
                return s
            
            def range_query(self, l, r):
                # sum of [l, r], l and r are 1-based
                if l > r:
                    return 0
                return self.query(r) - self.query(l - 1)
        
        ft = FenwickTree(n)
        inv = 0
        
        for i, r in enumerate(ranks):
            # Query how many ranks > r have been seen so far
            # ranks > r (0-based) correspond to 1-based ranks r+2 to n
            if r + 1 < n:  # if r < n-1, i.e., there exist ranks > r
                greater_count = ft.range_query(r + 2, n)
                inv += greater_count
            # Update tree at position r+1 (1-based)
            ft.update(r + 1, 1)
        
        return inv % MOD
