```python
class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        if n < 2:
            return 0
        
        stack = []  # stores indices, nums[stack] is non-decreasing
        total = 0
        
        for j in range(n):
            # Pop all indices i where nums[i] > nums[j]
            while stack and nums[stack[-1]] > nums[j]:
                stack.pop()
            
            # Binary search in stack for first index where nums[stack[k]] >= nums[j]
            lo, hi = 0, len(stack)
            while lo < hi:
                mid = (lo + hi) // 2
                if nums[stack[mid]] < nums[j]:
                    lo = mid + 1
                else:
                    hi = mid
            count = lo  # number of elements < nums[j] in stack
            
            total += count
            
            stack.append(j)
        
        return total
