from collections import deque

class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]
        
        INF_NEG = -10**18
        best_start = [-1] * n
        best_end = [INF_NEG] * n
        
        dq = deque()
        for j in range(n):
            i_min = max(0, j - r + 1)
            i_max = j - l + 1
            if i_max < 0:
                continue
            if j >= l - 1:
                i_new = j - l + 1
                while dq and pref[dq[-1]] >= pref[i_new]:
                    dq.pop()
                dq.append(i_new)
            while dq and dq[0] < i_min:
                dq.popleft()
            if dq:
                min_idx = dq[0]
                best_start[j] = min_idx
                best_end[j] = pref[j + 1] - pref[min_idx]
        
        # DP for exactly k subarrays
        dp_prev = [0] * n   # k = 0
        ans = INF_NEG
        for k in range(1, m + 1):
            # prefix max of dp_prev
            pref_prev = [INF_NEG] * n
            cur_max = INF_NEG
            for i in range(n):
                if dp_prev[i] > cur_max:
                    cur_max = dp_prev[i]
                pref_prev[i] = cur_max
            
            dp_cur = [INF_NEG] * n
            for i in range(n):
                if best_start[i] == -1:
                    # cannot take a subarray ending here
                    if i > 0:
                        dp_cur[i] = max(dp_cur[i], dp_cur[i-1])
                    continue
                
                if best_start[i] == 0:
                    if k == 1:
                        extra = 0
                    else:
                        extra = INF_NEG
                else:
                    extra = pref_prev[best_start[i] - 1]   # max dp_prev[0..best_start[i]-1]
                
                if extra != INF_NEG:
                    candidate = best_end[i] + extra
                    if candidate > INF_NEG:
                        dp_cur[i] = candidate
                if i > 0:
                    # carry over the best value for exactly k subarrays up to i-1
                    dp_cur[i] = max(dp_cur[i], dp_cur[i-1])
            
            # update answer with best total for exactly k subarrays
            cur_best = max(dp_cur) if n > 0 else INF_NEG
            if cur_best > ans:
                ans = cur_best
            
            dp_prev = dp_cur
        
        return ans if ans > INF_NEG else max(nums)  # fallback in case all -inf? but at least one subarray must exist, so ans should be set.
