class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n = len(source)
        
        # Check if source and target are already equal
        if source == target:
            return 0
        
        # Build rules info
        rule_info = []
        for i in range(len(rules)):
            pattern, replacement = rules[i]
            cost = costs[i]
            wildcards = pattern.count('*')
            rule_info.append({
                'pattern': pattern,
                'replacement': replacement,
                'base_cost': cost,
                'wildcard_cost': wildcards,  # cost to add for wildcards
                'length': len(pattern)
            })
        
        INF = 10**18
        dp = [INF] * (n + 1)
        dp[n] = 0
        
        # For each position from n-1 downto 0
        for i in range(n - 1, -1, -1):
            # Option 1: skip if source[i] == target[i]
            if source[i] == target[i]:
                dp[i] = min(dp[i], dp[i + 1])
            
            # Option 2: apply a rule starting at i
            for rule in rule_info:
                L = rule['length']
                if i + L > n:
                    continue
                
                # Check if pattern matches source[i:i+L]
                match = True
                for j in range(L):
                    pat_char = rule['pattern'][j]
                    src_char = source[i + j]
                    if pat_char != '*' and pat_char != src_char:
                        match = False
                        break
                if not match:
                    continue
                
                # Check if replacement matches target[i:i+L]
                if rule['replacement'] != target[i:i+L]:
                    continue
                
                # Cost = base_cost + wildcard_cost
                cost = rule['base_cost'] + rule['wildcard_cost']
                dp[i] = min(dp[i], cost + dp[i + L])
        
        return dp[0] if dp[0] < INF else -1
