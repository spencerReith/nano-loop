```python
MOD = 10**9 + 7

class Solution:
    def countValidSequences(self, n: int, k: int) -> int:
        if n < k:
            return 0
        
        N = n
        fact = [1] * (N + 1)
        for i in range(1, N + 1):
            fact[i] = fact[i-1] * i % MOD
        
        inv_fact = [1] * (N + 1)
        inv_fact[N] = pow(fact[N], MOD-2, MOD)
        for i in range(N, 0, -1):
            inv_fact[i-1] = inv_fact[i] * i % MOD
        
        def nCr(n, r):
            if r < 0 or r > n:
                return 0
            return fact[n] * inv_fact[r] % MOD * inv_fact[n - r] % MOD
        
        total = nCr(n-1, k-1)
        
        if (n - k) % 2 == 0 and n >= k:
            m = (n - k) // 2
            odd_only = nCr(m + k - 1, k - 1)
        else:
            odd_only = 0
        
        ans = (total - odd_only) % MOD
        return ans
