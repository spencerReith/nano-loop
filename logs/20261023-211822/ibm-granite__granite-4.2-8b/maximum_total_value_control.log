class Solution:
    def maxTotalValue(self, value: list[int], decay: list[int], m: int) -> int:
        MOD = 10**9 + 7
        n = len(value)
        # total number of positive gains
        total_pos = 0
        for i in range(n):
            total_pos += (value[i] - 1) // decay[i] + 1
        
        max_val = max(value) if n > 0 else 0
        
        if m >= total_pos:
            total = 0
            for i in range(n):
                Li = (value[i] - 1) // decay[i] + 1
                total += Li * value[i] - decay[i] * Li * (Li - 1) // 2
            return total % MOD
        
        def count_ge(T: int) -> int:
            cnt = 0
            for i in range(n):
                if value[i] < T:
                    continue
                cnt += (value[i] - T) // decay[i] + 1
            return cnt
        
        lo, hi = 1, max_val
        ansT = 1
        while lo <= hi:
            mid = (lo + hi) // 2
            if count_ge(mid) >= m:
                ansT = mid
                lo = mid + 1
            else:
                hi = mid - 1
        
        T = ansT
        cnt_gt = 0
        sum_gt = 0
        for i in range(n):
            if value[i] <= T:
                continue
            c = (value[i] - T - 1) // decay[i] + 1
            cnt_gt += c
            sum_i = c * value[i] - decay[i] * c * (c - 1) // 2
            sum_gt += sum_i
        
        remaining = m - cnt_gt
        total = sum_gt + T * remaining
        return total % MOD
