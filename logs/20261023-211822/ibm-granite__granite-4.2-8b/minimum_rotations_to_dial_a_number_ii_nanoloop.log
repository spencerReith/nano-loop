class Solution:
    def minRotations(self, n: int, s: str) -> int:
        # convert digits to ints
        d = [int(ch) for ch in s]
        
        # distance on circular dial 0-9
        def dist(a: int, b: int) -> int:
            diff = abs(a - b)
            return min(diff, 10 - diff)
        
        # pre_sum[i] = sum_{j=0}^{i-1} dist(d[j], d[j+1]) for i>=0, pre_sum[0]=0
        pre = [0] * n
        for i in range(1, n):
            pre[i] = pre[i-1] + dist(d[i-1], d[i])
        
        # suf[i] = sum_{j=i}^{n-2} dist(d[j], d[j+1]) for i <= n-2, suf[n-1]=0
        suf = [0] * n
        for i in range(n-2, -1, -1):
            suf[i] = suf[i+1] + dist(d[i], d[i+1])
        
        total_internal = pre[n-1]  # same as suf[0]
        
        # original total
        orig_total = dist(0, d[0]) + total_internal
        
        # reversal of entire string (k=0)
        total_k0 = dist(0, d[n-1]) + suf[0]
        
        best = min(orig_total, total_k0)
        
        # k from 1 to n-1
        for k in range(1, n):
            # pre[k-1] is internal prefix sum for indices 0..k-1
            # suf[k] is internal suffix sum for indices k..n-1
            total_k = dist(0, d[0]) + pre[k-1] + dist(d[k-1], d[n-1]) + suf[k]
            if total_k < best:
                best = total_k
        
        return best
