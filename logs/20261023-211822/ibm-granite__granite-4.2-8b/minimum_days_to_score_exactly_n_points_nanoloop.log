Here is the final code:

```python
class Solution:
    def minDays(self, n: int) -> int:
        from collections import deque
        if n == 0:
            return 0
        q = deque()
        q.append((0, 0, 0))  # score, streak, days
        visited = set()
        visited.add((0, 0))
        
        while q:
            score, streak, days = q.popleft()
            # earn
            new_score = score + streak + 1
            if new_score <= n:
                new_streak = streak + 1
                state = (new_score, new_streak)
                if state not in visited:
                    visited.add(state)
                    if new_score == n:
                        return days + 1
                    q.append((new_score, new_streak, days + 1))
            # skip
            state_skip = (score, 0)
            if state_skip not in visited:
                visited.add(state_skip)
                if score == n:
                    return days + 1
                q.append((score, 0, days + 1))
        # should not happen
        return -1
