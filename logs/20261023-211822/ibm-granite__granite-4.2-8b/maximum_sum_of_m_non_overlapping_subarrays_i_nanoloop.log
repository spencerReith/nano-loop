```python
class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        
        # dp[k][i] = max sum using exactly k subarrays considering first i elements
        # Initialize with -inf
        dp = [[-float('inf')] * (n + 1) for _ in range(m + 1)]
        dp[0][0] = 0  # 0 subarrays, 0 elements = 0 sum
        
        # Prefix sums for O(1) range sum queries
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i+1] = prefix[i] + nums[i]
        
        def range_sum(i: int, j: int) -> int:
            """Sum of nums[i:j+1]"""
            return prefix[j+1] - prefix[i]
        
        for i in range(n):
            # Copy from previous position (not taking nums[i] as part of a new subarray)
            for k in range(m + 1):
                dp[k][i+1] = dp[k][i]
            
            # Try to take a subarray ending at i
            for k in range(1, m + 1):
                # Possible start positions j for subarrays ending at i
                # Length = i - j + 1 must be in [l, r]
                # So j <= i - l + 1 and j >= i - r + 1
                start_j = max(0, i - r + 1)
                end_j = i - l + 1
                
                # Clamp to valid range
                start_j = max(start_j, 0)
                end_j = min(end_j, i)
                
                for j in range(start_j, end_j + 1):
                    length = i - j + 1
                    if length < l or length > r:
                        continue
                    subarray_sum = range_sum(j, i)
                    candidate = dp[k-1][j] + subarray_sum
                    if candidate > dp[k][i+1]:
                        dp[k][i+1] = candidate
        
        # Answer is max of dp[k][n] for k = 1..m (at most m subarrays, at least 1)
        return max(dp[k][n] for k in range(1, m + 1))
