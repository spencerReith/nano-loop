class Solution:
    def canMakeSubsequence(self, s: str, t: str) -> bool:
        # Quick check for no replacement
        i = 0
        for ch in t:
            if i < len(s) and ch == s[i]:
                i += 1
        if i == len(s):
            return True
        
        for k in range(len(s)):
            i = 0
            j = 0
            while i < len(s) and j < len(t):
                if i == k:
                    # replacement position: always match (consume one t character)
                    i += 1
                    j += 1
                else:
                    if s[i] == t[j]:
                        i += 1
                        j += 1
                    else:
                        j += 1
            if i == len(s):
                return True
        return False
