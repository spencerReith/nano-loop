def booth(s):
    s = s + s
    n = len(s)//2
    i = 0
    j = 1
    k = 0
    while i < n and j < n and k < n:
        if s[i+k] == s[j+k]:
            k += 1
            continue
        if s[i+k] > s[j+k]:
            i = i + k + 1
        else:
            j = j + k + 1
        if i == j:
            j += 1
        k = 0
    return min(i, j)

