                b = s2[j+k]
                if a == b:
                    k += 1
                    continue
                if a > b:
                    i = i + k + 1
                else:
                    j = j + k + 1
                if i == j:
                    j += 1
                k = 0
            start = min(i, j)
            return s[start:] + s[:start]
        
