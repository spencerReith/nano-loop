def minimal_rotation(s):
    if not s:
        return ''
    n = len(s)
    s2 = s + s
    i = 0
    j = 1
    k = 0
    while i < n and j < n and k < n:
        a = s2[i+k]
        b = s2[j+k]
        if a == b:
            k += 1
            continue
        if a > b:  # we want smallest lexicographically
            i = i + k + 1
        else:
            j = j + k + 1
        if i == j:
            j += 1
        k = 0
    start = min(i, j)
    return s[start:] + s[:start]

