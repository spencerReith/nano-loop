class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        def min_rotation(s: str) -> str:
            n = len(s)
            if n == 0:
                return ''
            if n == 1:
                return s
            s2 = s + s
            i = 0
            j = 1
            k = 0
            while i < n and j < n and k < n:
                a = s2[i + k]
                b = s2[j + k]
                if a == b:
                    k += 1
                    continue
                if a > b:
                    i = i + k + 1
                else:
                    j = j + k + 1
                if i == j:
                    j += 1
                k = 0
            start = min(i, j)
            return s[start:] + s[:start]

        signatures = set()
        for word in words:
            n = len(word)
            # even indices (0,2,4,...)
            E = ''.join(word[i] for i in range(0, n, 2))
            # odd indices (1,3,5,...)
            O = ''.join(word[i] for i in range(1, n, 2))
            canon_E = min_rotation(E)
            canon_O = min_rotation(O)
            signatures.add((canon_E, canon_O))

        return len(signatures)

