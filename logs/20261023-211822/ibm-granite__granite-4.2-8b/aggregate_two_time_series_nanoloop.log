class Solution:
    def aggregateTimeSeries(self, series1: list[list[int]], series2: list[list[int]]) -> list[list[int]]:
        # Merge unique timestamps
        i1, i2 = 0, 0
        u = []
        while i1 < len(series1) or i2 < len(series2):
            if i1 < len(series1) and (i2 >= len(series2) or series1[i1][0] < series2[i2][0]):
                u.append(series1[i1][0])
                i1 += 1
            elif i2 < len(series2) and (i1 >= len(series1) or series2[i2][0] < series1[i1][0]):
                u.append(series2[i2][0])
                i2 += 1
            else:  # equal
                u.append(series1[i1][0])
                i1 += 1
                i2 += 1
        
        idx1, idx2 = 0, 0
        res = []
        for T in u:
            while idx1 < len(series1) and series1[idx1][0] < T:
                idx1 += 1
            while idx2 < len(series2) and series2[idx2][0] < T:
                idx2 += 1
            val1 = series1[idx1][1] if idx1 < len(series1) else 0
            val2 = series2[idx2][1] if idx2 < len(series2) else 0
            res.append([T, val1 + val2])
        return res
