class Solution:
    def maxDistance(self, moves: str) -> int:
        u = d = l = r = 0
        blanks = 0
        for ch in moves:
            if ch == 'U':
                u += 1
            elif ch == 'D':
                d += 1
            elif ch == 'L':
                l += 1
            elif ch == 'R':
                r += 1
            elif ch == '_':
                blanks += 1
        return abs(r - l) + abs(u - d) + blanks
```
