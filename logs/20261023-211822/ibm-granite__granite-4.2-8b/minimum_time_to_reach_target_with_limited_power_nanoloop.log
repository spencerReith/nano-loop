import heapq
from typing import List

class Solution:
    def minTimeMaxPower(self, n: int, edges: List[List[int]], power: int, cost: List[int], source: int, target: int) -> List[int]:
        # Build adjacency list
        adj = [[] for _ in range(n)]
        for u, v, t in edges:
            adj[u].append((v, t))
        
        # dist[node][rem] = minimum time to reach node with exactly rem remaining power
        INF = 10**18
        dist = [[INF] * (power + 1) for _ in range(n)]
        dist[source][power] = 0
        
        # Priority queue: (time, remaining_power, node)
        pq = [(0, power, source)]
        
        while pq:
            time, rem, node = heapq.heappop(pq)
            
            # If we already have a better state for (node, rem), skip
            if dist[node][rem] < time:
                continue
            
            # Try all outgoing edges
            for v, t in adj[node]:
                # Need at least cost[node] power to leave node
                if rem < cost[node]:
                    continue
                
                new_rem = rem - cost[node]  # consume cost[node] when leaving node
                new_time = time + t
                
                # Update if we found a shorter time to reach v with exactly new_rem remaining power
                if new_time < dist[v][new_rem]:
                    dist[v][new_rem] = new_time
                    heapq.heappush(pq, (new_time, new_rem, v))
        
        # Find minimum time to reach target and max remaining power among all paths with that time
        min_time = INF
        max_rem_for_min_time = -1
        
        for rem in range(power + 1):
            if dist[target][rem] < min_time:
                min_time = dist[target][rem]
                max_rem_for_min_time = rem
            elif dist[target][rem] == min_time and rem > max_rem_for_min_time:
                max_rem_for_min_time = rem
        
        if min_time == INF:
            return [-1, -1]
        
        return [int(min_time), max_rem_for_min_time]
