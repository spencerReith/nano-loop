Now write solution:

```python
import math

class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        if not nums:
            return 0
        
        max_len = 1  # at least 1
        
        i = 0
        n = len(nums)
        while i < n:
            r = nums[i] % k
            j = i
            while j < n and nums[j] % k == r:
                j += 1
            L = j - i
            # process run [i, j-1] with remainder r, length L
            if r == 0:
                candidate = L
            else:
                g = math.gcd(r, k)
                k_prime = k // g
                # longest n <= L with n ≡ 1 mod k_prime
                # n = 1 + m*k_prime, m >= 0, max m = floor((L-1)/k_prime)
                m_max = (L - 1) // k_prime if L >= 1 else 0
                candidate = 1 + k_prime * m_max
            if candidate > max_len:
                max_len = candidate
            i = j
        
        return max_len
```

