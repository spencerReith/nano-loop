import heapq

class Solution:
    def maxTotalValue(self, value: list[int], decay: list[int], m: int) -> int:
        MOD = 10**9 + 7
        
        # Max-heap: store (-value[i] - decay[i]*t, i, t) since Python heapq is min-heap
        # We'll store the negative to simulate max-heap
        heap = []
        selections = [0] * len(value)
        
        for i in range(len(value)):
            # First selection value is value[i]
            if value[i] > 0:
                heapq.heappush(heap, (-value[i], i, 0))
        
        total = 0
        
        for _ in range(m):
            if not heap:
                break
            
            neg_val, i, t = heapq.heappop(heap)
            cur_val = -neg_val
            
            # Only select if cur_val > 0 (selecting 0 or negative would not increase total)
            if cur_val <= 0:
                heapq.heappush(heap, (neg_val, i, t))  # put back
                break
            
            total += cur_val
            
            # Next selection value: value[i] - decay[i]*t
            next_val = value[i] - decay[i] * t
            if next_val > 0:
                selections[i] += 1
                heapq.heappush(heap, (-next_val, i, selections[i]))
        
        return total % MOD
```

