class Solution:
    def maxValidPairSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        # The smallest index j that can pair with i is i + k.
        # So for a given i, the candidate j must be at least i + k.
        # We need the maximum nums[j] among all j >= i + k.
        # Preprocess from the right: max_suffix[i] = max(nums[i:])
        max_suffix = [0] * n
        max_suffix[-1] = nums[-1]
        for i in range(n - 2, -1, -1):
            max_suffix[i] = max(nums[i], max_suffix[i + 1])
        
        # For each i from 0 to n - k - 1, the valid j are in [i + k, n - 1].
        # The best partner for i is max_suffix[i + k] (if i + k < n).
        best = 0
        for i in range(n - k):
            j_start = i + k
            # max_suffix[j_start] holds the maximum from j_start to end.
            candidate = nums[i] + max_suffix[j_start]
            if candidate > best:
                best = candidate
        return best
