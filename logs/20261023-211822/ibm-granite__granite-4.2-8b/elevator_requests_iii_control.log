            dp[1 << i][i] = fulfill
        
        # DP over subsets
        for mask in range(1 << m):
            for i in range(m):
                if not (mask & (1 << i)) or dp[mask][i] == INF:
                    continue
                cur_time = dp[mask][i]
                for j in range(m):
