class Solution:
    def finishTime(self, n: int, edges: list[list[int]], baseTime: list[int]) -> int:
        from collections import defaultdict
        
        children = defaultdict(list)
        for u, v in edges:
            children[u].append(v)
        
        # DFS to compute finish time for each node
        # Returns the finish time of the node
        def dfs(node):
            # If leaf (no children), finish time is baseTime[node]
            if not children[node]:
                return baseTime[node]
            
            # Recursively compute finish times for all children
            child_finish = [dfs(child) for child in children[node]]
            
            earliest = min(child_finish)
            latest = max(child_finish)
            
            own_duration = (latest - earliest) + baseTime[node]
            return latest + own_duration
        
        # Root is task 0
        return dfs(0)
