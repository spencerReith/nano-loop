def largest_k_digit_palindrome_parity(k: int, p: int) -> int:
    """Largest k-digit palindrome with parity p (p=0 for even, 1 for odd)."""
    if k == 1:
        if p == 0:
            return 8  # 8 > 0, largest even 1-digit palindrome
        else:
            return 9  # largest odd 1-digit palindrome
    # k >= 2
    # First half has ceil(k/2) digits
    half = (k + 1) // 2
    # Largest first half: all 9s
    first_half_max = 10**half - 1
    # Mirror to get largest palindrome
    if k % 2 == 0:
        palindrome = int(str(first_half_max) + str(first_half_max)[::-1])
    else:
        palindrome = int(str(first_half_max) + str(first_half_max)[-2::-1])
    
    # Check parity
    if palindrome % 2 == p:
        return palindrome
    
    # Decrement first half and mirror
    first_half = str(first_half_max)
    while True:
        first_half_int = int(first_half)
        if first_half_int < 10**(half - 1):  # first digit can't be 0
            break
        first_half = str(first_half_int - 1)
        if len(first_half) < half:  # e.g., 10 -> 9, half=2 -> "09" invalid
