def min_ops_to_palindrome(n: int) -> int:
    if n < 10: return 0
    if is_palindrome(n): return 0
    
    s = str(n); d = len(s); p = n % 2
    
    # d-digit candidates
    left = s[: (d + 1) // 2]
    left_int = int(left)
    
    cand_d = []  # d-digit palindromes
    
    # cand1: mirror left (smallest d-digit palindrome >= n)
    if d % 2 == 0:
        cand1 = int(left + left[::-1])
    else:
        cand1 = int(left + left[-2::-1])
    cand_d.append(cand1)
    
    # cand2: mirror left-1 (largest d-digit palindrome <= n), if >= 10^(d-1)
    if left_int > 1:  # left-1 as string might have same length
        left_dec = str(int(left) - 1)
        # Check if mirror left-1 >= 10^(d-1)
        # For d-digit, 10^(d-1) <= number < 10^d
        # mirror left-1 >= 10^(d-1) iff first digit of left-1 >= 1 (always true since left>1),
        # but might have leading zero if left="10", left_dec="9", d=2, mirror "9" -> "9" (1-digit), <10
        # Better: compute mirror and check
        if d % 2 == 0:
            cand2 = int(left_dec + left_dec[::-1])
        else:
            cand2 = int(left_dec + left_dec[-2::-1])
        # Check if cand2 has d digits: cand2 >= 10^(d-1)
        # 10^(d-1) = 10** (d-1)
        if cand2 >= 10**(d-1):
            cand_d.append(cand2)
    
    # cand3: mirror left+1 (smallest d-digit palindrome > n)
    left_inc = str(int(left) + 1)
    if d % 2 == 0:
        cand3 = int(left_inc + left_inc[::-1])
    else:
        cand3 = int(left_inc + left_inc[-2::-1])
    cand_d.append(cand3)
    
    # (d-1)-digit candidates: largest (d-1)-digit palindrome
    cand_low = int('9' * (d - 1)) if d > 1 else None
    
    # (d+1)-digit candidates: smallest (d+1)-digit palindrome
    cand_high = int('1' + '0' * (d - 1) + '1') if d >= 1 else None
    
    candidates = cand_d + ([cand_low] if cand_low is not None else []) + ([cand_high] if cand_high is not None else [])
    
    valid_candidates = [c for c in candidates if c > 0 and c % 2 == p]
    
    best = None
    best_dist = float('inf')
    for c in valid_candidates:
        if c == n: continue
        dist = abs(c - n)
        if dist < best_dist:
            best_dist = dist
            best = c
    
    if best is None:
        # simple search
        # ...
    
    return abs(n - best) // 2
```

