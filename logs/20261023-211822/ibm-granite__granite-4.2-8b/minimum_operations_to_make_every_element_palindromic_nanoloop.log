                return int('9' * k)
                
            # d-digit candidates
            left = s[: (d + 1) // 2]
            left_int = int(left)
            cand_d = []
            
            # cand1: mirror left (smallest d-digit palindrome >= n)
            if d % 2 == 0:
                cand1 = int(left + left[::-1])
            else:
                cand1 = int(left + left[-2::-1])
            cand_d.append(cand1)
            
            # cand2: mirror left-1 (largest d-digit palindrome <= n), if valid
            if left_int > 1:
                left_dec = str(int(left) - 1)
                if d % 2 == 0:
                    cand2 = int(left_dec + left_dec[::-1])
                else:
                    cand2 = int(left_dec + left_dec[-2::-1])
                if cand2 >= 10**(d-1):
                    cand_d.append(cand2)
            
            # cand3: mirror left+1 (smallest d-digit palindrome > n)
            left_inc = str(int(left) + 1)
            if d % 2 == 0:
                cand3 = int(left_inc + left_inc[::-1])
            else:
                cand3 = int(left_inc + left_inc[-2::-1])
            cand_d.append(cand3)
            
            # (d-1)-digit candidates: largest (d-1)-digit palindrome with parity p
            cand_low = largest_k_digit_palindrome_parity(d - 1, p) if d > 1 else None
            
            # (d+1)-digit candidates: smallest (d+1)-digit palindrome with parity p
            cand_high = smallest_k_digit_palindrome_parity(d + 1, p)
            
            candidates = cand_d
            if cand_low is not None:
                candidates.append(cand_low)
            candidates.append(cand_high)
            
            # Filter
            valid_candidates = [c for c in candidates if c > 0 and c % 2 == p]
            
            # Remove n itself if present
            best = None
            best_dist = float('inf')
            for c in valid_candidates:
                if c == n:
                    continue
                dist = abs(c - n)
                if dist < best_dist:
                    best_dist = dist
                    best = c
            
            # Fallback simple search if no valid candidates (rare)
            if best is None:
                i = 0
                while True:
                    if n - 2*i > 0 and is_palindrome(n - 2*i) and (n - 2*i) % 2 == p:
                        best = n - 2*i
                        break
                    if is_palindrome(n + 2*i) and (n + 2*i) % 2 == p:
                        best = n + 2*i
                        break
                    i += 1
            
            return abs(n - best) // 2
        
        total_ops = 0
        for num in nums:
            total_ops += min_ops_to_palindrome(num)
        return total_ops
