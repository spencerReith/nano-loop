            # in that case, use largest (k-1)-digit palindrome
            return largest_k_digit_palindrome_parity(k-1, p)  # fallback
        if k % 2 == 0:
            palindrome = int(first_half + first_half[::-1])
        else:
            palindrome = int(first_half + first_half[-2::-1])
        if palindrome % 2 == p:
            return palindrome
    
    # Fallback: check all k-digit palindromes from M down
    # But this is slow, use simple for small k
