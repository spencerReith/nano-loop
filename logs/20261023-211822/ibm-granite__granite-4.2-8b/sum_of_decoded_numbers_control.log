class Solution:
    def sumDecoded(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        
        def decode(num: int) -> int:
            width = num % 10
            d = num // 10  # floor division
            # Convert d to string to extract first width digits and remaining digits
            d_str = str(d)
            # width_i digits for x
            x_str = d_str[:width]
            y_str = d_str[width:]  # remaining digits
            
            # According to constraints, no leading zeros for x and y, so int conversion safe
            x = int(x_str)
            y = int(y_str)
            # Compute x^y modulo MOD using fast exponentiation
            return pow(x, y, MOD)
        
        total = 0
        for num in nums:
            total = (total + decode(num)) % MOD
        
        return total
