```python
class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n = len(source)
        # positions where source and target differ
        required = [c1 != c2 for c1, c2 in zip(source, target)]
        
        INF = 10**9
        
        # preprocess rules: pattern, replacement, stars count, total cost (base + stars)
        rule_info = []
        for i in range(len(rules)):
            pattern = rules[i][0]
            repl = rules[i][1]
            stars = pattern.count('*')
            total = costs[i] + stars
            rule_info.append((pattern, repl, stars, total))
        
        # best[l][len-1] = minimal total cost of a rule that matches source[l:l+len] 
        # and replaces it with target[l:l+len]; len from 1 to 20.
        best = [[INF] * 21 for _ in range(n)]   # index len-1
        
        for pattern, repl, stars, total in rule_info:
            L = len(pattern)
            # try every start position
            for l in range(0, n - L + 1):
                # check pattern matches source[l:l+L]
                match = True
                for j in range(L):
                    if pattern[j] != '*' and pattern[j] != source[l + j]:
                        match = False
                        break
                if not match:
                    continue
                if repl != target[l:l+L]:
                    continue
                idx = L - 1          # store at index len-1
                if total < best[l][idx]:
                    best[l][idx] = total
        
        # collect intervals by their end index
        intervals_by_end = [[] for _ in range(n)]   # intervals_by_end[e] = list of (start, cost)
        for l in range(n):
            for L in range(1, 21):
                idx = L - 1
                cost = best[l][idx]
                if cost < INF:
                    e = l + L - 1
                    if e < n:          # always true
                        intervals_by_end[e].append((l, cost))
        
        # DP: f[i] = minimal cost to cover all required positions in prefix [0, i-1]
        f = [INF] * (n + 1)
        f[0] = 0
        
        for i in range(n):
            # if position i is not required, we may leave it uncovered
            if required[i] == 0:
                f[i+1] = min(f[i+1], f[i])
            # use all intervals that end exactly at i
            for start, cost in intervals_by_end[i]:
                if f[start] < INF:
                    new_cost = cost + f[start]
                    f[i+1] = min(f[i+1], new_cost)
        
        ans = f[n] if f[n] < INF else -1
        return ans
```
