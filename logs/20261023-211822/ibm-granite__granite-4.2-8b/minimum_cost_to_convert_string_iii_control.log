   class Solution:
       def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
           n = len(source)
           required = [c1 != c2 for c1, c2 in zip(source, target)]
           
           # Preprocess rules
           rule_costs = []  # list of (pattern, replacement, stars, total_cost)
           for i in range(len(rules)):
               pattern = rules[i][0]
               repl = rules[i][1]
               stars = pattern.count('*')
               total = costs[i] + stars
               rule_costs.append((pattern, repl, stars, total))
           
           INF = 10**9
           # best[l][len-1] where len in 1..20
           best = [[INF]*21 for _ in range(n)]  # index 0..20 for length 1..21? We'll use length-1 as index
           # Actually we need 21 entries per start, index 0..20 corresponding to length 1..21? But max length 20, so index 0..19 for length1..20. We'll allocate 21 for simplicity and ignore index 20.
           for (pattern, repl, stars, total) in rule_costs:
               L = len(pattern)
               # iterate start positions
               for l in range(0, n - L + 1):
                   # check match
                   match = True
                   for j in range(L):
                       if pattern[j] != '*' and pattern[j] != source[l+j]:
                           match = False
                           break
