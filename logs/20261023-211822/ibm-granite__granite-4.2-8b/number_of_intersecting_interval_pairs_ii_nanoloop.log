Assistant: ```python
import bisect

class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        # Sort intervals by start
        intervals_sorted = sorted(intervals, key=lambda x: x[0])
        starts = [interval[0] for interval in intervals_sorted]
        total = 0
        for i, (s_i, e_i) in enumerate(intervals_sorted):
            # Find the last index where start <= e_i
            idx = bisect.bisect_right(starts, e_i) - 1
            # Count intervals j > i with start <= e_i (they all intersect interval i)
            if idx > i:
                total += idx - i
        return total
