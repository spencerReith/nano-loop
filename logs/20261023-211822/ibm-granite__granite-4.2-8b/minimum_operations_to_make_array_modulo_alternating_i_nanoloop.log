```python
class Solution:
    def minOperations(self, nums: list[int], k: int) -> int:
        n = len(nums)
        
        # Try all possible pairs (x, y) where x != y
        # x for even indices, y for odd indices
        best = float('inf')
        
        for x in range(k):
            for y in range(k):
                if x == y:
                    continue
                
                ops = 0
                # Calculate operations for even indices (need to be ≡ x mod k)
                for i in range(0, n, 2):
                    num = nums[i]
                    r = num % k
                    # Minimal operations to make num % k = x:
                    # (r - x) % k is distance to go down to previous ≡ x mod k
                    # (x - r) % k is distance to go up to next ≡ x mod k
                    down_dist = (r - x) % k
                    up_dist = (x - r) % k
                    min_dist = min(down_dist, up_dist)
                    ops += min_dist
                
                # Calculate operations for odd indices (need to be ≡ y mod k)
                for i in range(1, n, 2):
                    num = nums[i]
                    r = num % k
                    down_dist = (r - y) % k
                    up_dist = (y - r) % k
                    min_dist = min(down_dist, up_dist)
                    ops += min_dist
                
                best = min(best, ops)
        
        return best
```
