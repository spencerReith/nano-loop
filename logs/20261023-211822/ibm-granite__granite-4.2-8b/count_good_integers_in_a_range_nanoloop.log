def count_good_len(m, k):
    if m < 2:
        return 0
    from functools import lru_cache
    # prev_digit for pos 0 is None, for pos >=1 it's a digit
    @lru_cache(maxsize=None)
    def dfs(pos, prev_digit):
        # pos: 0..m-1, prev_digit: None for pos=0, 0-9 for pos>=1
        if pos == m:
            return 1
        total = 0
        start = 1 if pos == 0 else 0
        for d in range(start, 10):
            if prev_digit is None or abs(prev_digit - d) <= k:
                total += dfs(pos + 1, d)
        return total
    return dfs(0, None)
