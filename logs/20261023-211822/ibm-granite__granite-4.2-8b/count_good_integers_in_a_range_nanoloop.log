 class Solution:
    def goodIntegers(self, l: int, r: int, k: int) -> int:
        def count_good_len(m: int, k: int) -> int:
            # Count all m-digit good numbers (first digit 1-9), m >= 2
            if m < 2:
                return 0
            from functools import lru_cache
            @lru_cache(maxsize=None)
