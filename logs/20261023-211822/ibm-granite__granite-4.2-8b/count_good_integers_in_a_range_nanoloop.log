class Solution:
    def goodIntegers(self, l: int, r: int, k: int) -> int:
        def count_good_len(m: int, k: int) -> int:
            # Count all m-digit good numbers (first digit 1-9), m >= 2
            if m < 2:
                return 0
            from functools import lru_cache
            @lru_cache(maxsize=None)
            def dfs(pos: int, prev_digit: int | None) -> int:
                # pos: 0..m-1, prev_digit: None for pos=0, else 0-9
                if pos == m:
                    return 1
                total = 0
                start = 1 if pos == 0 else 0
                for d in range(start, 10):
                    if prev_digit is None or abs(prev_digit - d) <= k:
                        total += dfs(pos + 1, d)
                return total
            return dfs(0, None)
        
        def count_good_up_to_len(m: int, s: str, k: int) -> int:
            # Count m-digit good numbers <= int(s), first digit 1-9
            from functools import lru_cache
            @lru_cache(maxsize=None)
            def dfs(pos: int, tight: bool, prev_digit: int | None) -> int:
                if pos == m:
                    return 1
                limit_digit = int(s[pos]) if tight else 9
                total = 0
                start = 1 if pos == 0 else 0
                for d in range(start, limit_digit + 1):
                    if prev_digit is None or abs(prev_digit - d) <= k:
                        new_tight = tight and (d == limit_digit)
                        total += dfs(pos + 1, new_tight, d)
                return total
            return dfs(0, True, None)
        
        def count_up_to(n: int, k: int) -> int:
            if n < 10:
                return 0
            s = str(n)
            m = len(s)
            total = 0
            # Count all good numbers with digits < m (i.e., len = 2 to m-1)
            for len_digits in range(2, m):
                total += count_good_len(len_digits, k)
            # Count good numbers with m digits <= n
            total += count_good_up_to_len(m, s, k)
            return total
        
        return count_up_to(r, k) - count_up_to(l - 1, k)
```

This solution uses digit DP to count good integers from 0 to n, then returns count(r) - count(l-1). It correctly handles the constraint that numbers are at least 10-digit numbers (no leading zeros), and uses memoization for efficiency. All provided examples and additional tests pass.

The solution runs in O(m * 10 * 2) time per DP call, where m <= 16 (since r <= 10^15), which is well within the 2s time limit.
