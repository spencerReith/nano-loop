```python
class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        # Remove start if present (penalty 0)
        req = [f for f in requests if f != start]
        # If no requests left, penalty 0
        if not req:
            return 0
        
        # Split into left (< start) and right (> start)
        left = [f for f in req if f < start]
        right = [f for f in req if f > start]
        
        # Sort left descending (closest to start first), right ascending (closest first)
        left.sort(reverse=True)   # from start downwards
        right.sort()              # from start upwards
        
        # Helper to compute total penalty for a given order (list of floors) starting at `start` at time 0
        def penalty(order):
            pos = start
            time = 0
            total = 0
            for floor in order:
                travel = abs(floor - pos)
                time += travel
                total += time
                pos = floor
            return total
        
        # Option 1: left then right
        order1 = left + right
        penalty1 = penalty(order1)
        
        # Option 2: right then left
        order2 = right + left
        penalty2 = penalty(order2)
        
        return min(penalty1, penalty2)
