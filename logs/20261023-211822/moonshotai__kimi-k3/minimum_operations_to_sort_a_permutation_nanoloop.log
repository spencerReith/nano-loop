from collections import deque

class Solution:
    def minOperations(self, nums: list[int]) -> int:
        n = len(nums)
        target = tuple(range(n))
        start = tuple(nums)
        
        if start == target:
            return 0
        
        # BFS to find minimum operations
        queue = deque([(start, 0)])
        visited = {start}
        
        while queue:
            state, ops = queue.popleft()
            
            # Operation 1: Reverse the entire array
            reversed_state = state[::-1]
            if reversed_state == target:
                return ops + 1
            if reversed_state not in visited:
                visited.add(reversed_state)
                queue.append((reversed_state, ops + 1))
            
            # Operation 2: Rotate Left by One
            rotated_state = state[1:] + (state[0],)
            if rotated_state == target:
                return ops + 1
            if rotated_state not in visited:
                visited.add(rotated_state)
                queue.append((rotated_state, ops + 1))
        
        return -1
