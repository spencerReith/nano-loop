solution.py:
class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n=len(nums)
        pref=[0]*(n+1)
        for i,x in enumerate(nums,1): pref[i]=pref[i-1]+x
        max_k=min(m, n//l)
        NEG=-10**30
        dp_prev=[0]*(n+1)  # exact 0
        ans=NEG
        from collections import deque
        for _ in range(1, max_k+1):
            dp_cur=[NEG]*(n+1)
            dq=deque()
            # val computed on fly: dp_prev[j]-pref[j] if dp_prev[j]!=NEG
            for i in range(1,n+1):
                j=i-l
                if j>=0:
                    if dp_prev[j]!=NEG:
                        v=dp_prev[j]-pref[j]
                        while dq and (dp_prev[dq[-1]]-pref[dq[-1]]) <= v:
                            dq.pop()
                        dq.append(j)
                left=i-r
                while dq and dq[0] < left:
                    dq.popleft()
                if dq:
                    cand=pref[i] + (dp_prev[dq[0]]-pref[dq[0]])
                    if cand>dp_cur[i-1]:
                        dp_cur[i]=cand
                    else:
                        dp_cur[i]=dp_cur[i-1]
                else:
                    dp_cur[i]=dp_cur[i-1]
            if dp_cur[n]>ans: ans=dp_cur[n]
            dp_prev=dp_cur
        return ans

