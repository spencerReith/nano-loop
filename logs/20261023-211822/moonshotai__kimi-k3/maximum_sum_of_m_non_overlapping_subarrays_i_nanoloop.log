from solution import Solution

def brute(nums,m,l,r):
    n=len(nums); pref=[0]
    for x in nums: pref.append(pref[-1]+x)
    best=None
    def dfs(pos,count,total):
        nonlocal best
        if pos==n:
            if count>=1 and (best is None or total>best): best=total
            return
        # skip
        dfs(pos+1,count,total)
        if count<m:
            for end in range(pos+l, min(n,pos+r)+1):
                s=pref[end]-pref[pos]
                dfs(end,count+1,total+s)
    dfs(0,0,0)
    return best

