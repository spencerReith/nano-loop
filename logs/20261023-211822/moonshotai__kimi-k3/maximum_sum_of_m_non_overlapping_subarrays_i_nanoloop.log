from collections import deque

class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        pref = [0] * (n + 1)
        for i, x in enumerate(nums, 1):
            pref[i] = pref[i - 1] + x

        # More than floor(n / l) subarrays can never fit.
        max_k = min(m, n // l)
        NEG = -10**30

        # dp_prev[j] = best sum using exactly (k-1) subarrays inside prefix nums[:j]
        dp_prev = [0] * (n + 1)  # k = 0: choose nothing anywhere
        ans = NEG

        for _ in range(1, max_k + 1):
            dp_cur = [NEG] * (n + 1)
            dq = deque()  # indices j, with dp_prev[j] - pref[j] decreasing

            for i in range(1, n + 1):
                # A subarray ending at i may start at j in [i-r, i-l].
                add = i - l
                if add >= 0 and dp_prev[add] != NEG:
                    v = dp_prev[add] - pref[add]
                    while dq and dp_prev[dq[-1]] - pref[dq[-1]] <= v:
                        dq.pop()
                    dq.append(add)

                left = i - r
                while dq and dq[0] < left:
                    dq.popleft()

                if dq:
                    j = dq[0]
                    cand = pref[i] + dp_prev[j] - pref[j]
                    if cand > dp_cur[i - 1]:
                        dp_cur[i] = cand
                    else:
                        dp_cur[i] = dp_cur[i - 1]
                else:
                    dp_cur[i] = dp_cur[i - 1]

            if dp_cur[n] > ans:
                ans = dp_cur[n]
            dp_prev = dp_cur

        return ans
