class Solution:
    def canTransform(self, source: list[int], target: list[int]) -> bool:
        # Each operation preserves the sum of the chosen pair, hence the total sum.
        # Conversely, if total sums match, we can use the last element as a buffer:
        # for each k < n - 1, operate on (k, n - 1) with
        # delta = source[k] + source[n - 1] - target[k], forcing source[k] = target[k].
        # The final element then matches automatically by equal total sum.
        return sum(source) == sum(target)
```
