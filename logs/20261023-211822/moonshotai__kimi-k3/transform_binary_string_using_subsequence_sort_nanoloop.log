class Solution:
    def transformStr(self, s: str, strs: list[str]) -> list[bool]:
        n = len(s)
        # cap[p] = number of ones in s[0..p]; the j-th '1' can only move right,
        # so a target t is reachable iff #1s(t)==#1s(s) and for every prefix p,
        # #1s in t[0..p] <= cap[p].
        cap = [0] * n
        c = 0
        for i, ch in enumerate(s):
            if ch == '1':
                c += 1
            cap[i] = c
        K = c  # total ones in s

        ans = []
        for t in strs:
            ok = True

            # Condition 1: forced '1's alone must not violate any prefix cap.
            f = 0
            for i, ch in enumerate(t):
                if ch == '1':
                    f += 1
                    if f > cap[i]:
                        ok = False
                        break

            if ok:
                # Condition 2: we must be able to place K ones on positions that
                # are not forced '0' (call this set A), respecting prefix caps.
                # These nested (prefix) constraints form a laminar matroid whose
                # rank is:
                #   rank(A) = min( |A|, min over p of cap[p] + #allowed > p ).
                # We need rank(A) >= K (then, by matroid augmentation, an
                # independent K-set containing all forced ones exists).
                total_allowed = n
                rank = n  # will take min with |A| and all prefix terms
                allowed_after = 0  # number of positions j > i with t[j] != '0'
                for i in range(n - 1, -1, -1):
                    if t[i] == '0':
                        total_allowed -= 1
                    val = cap[i] + allowed_after
                    if val < rank:
                        rank = val
                    if t[i] != '0':
                        allowed_after += 1
                if total_allowed < rank:
                    rank = total_allowed
                if rank < K:
                    ok = False

            ans.append(ok)
        return ans
