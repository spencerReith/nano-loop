```python
class Solution:
    def transformStr(self, s, strs):
        n = len(s)
        cap = [0]*n
        c = 0
        for i,ch in enumerate(s):
            if ch == '1': c += 1
            cap[i] = c
        K = c
        ans = []
        for t in strs:
            # suffix count of allowed (not '0')
            ok = True
            # condition 1: forced ones prefix <= cap
            f = 0
            for i,ch in enumerate(t):
                if ch == '1': f += 1
                if f > cap[i]:
                    ok = False
                    break
            if ok:
                # condition 2: min_p cap[p] + allowed_{p+1..n-1} >= K
                # compute suffix allowed counts
                # iterate from right
                allowed_after = 0  # count of t[j] != '0' for j > i
                # we need min over p of cap[p] + allowed_after(p)
                # compute from right to left
                rank = K  # p = n-1 gives cap(n-1) + 0 = K; we'll include in loop
                allowed_after = 0
                for i in range(n-1, -1, -1):
                    # allowed_after = # allowed positions > i
                    if cap[i] + allowed_after < rank:
                        rank = cap[i] + allowed_after
                    if t[i] != '0':
                        allowed_after += 1
                if rank < K:
                    ok = False
            ans.append(ok)
        return ans
```

Wait, rank must be ≥ K but also note rank ≤ K always (p=n-1 term = cap(n-1) = K). So condition is rank == K effectively. Fine.

