For the brute force: 

```python
def reachable(s):
    from collections import deque
    n = len(s)
    seen = {s}
    dq = deque([s])
    while dq:
        cur = dq.popleft()
        # try all subsequences
        for mask in range(1, 1<<n):
            idx = [i for i in range(n) if mask>>i & 1]
            chars = sorted(cur[i] for i in idx)
            lst = list(cur)
            for i,ch in zip(idx, chars):
                lst[i] = ch
            nxt = ''.join(lst)
            if nxt not in seen:
                seen.add(nxt)
                dq.append(nxt)
    return seen

def brute(s, strs):
    R = reachable(s)
    ans = []
    for t in strs:
        # enumerate fillings
        q = t.count('?')
        ok = False
        for m in range(1<<q):
            lst = list(t)
            b = 0
            for i,ch in enumerate(t):
                if ch == '?':
                    lst[i] = '1' if (m>>b)&1 else '0'
                    b += 1
            if ''.join(lst) in R:
                ok = True
                break
        ans.append(ok)
    return ans
```

