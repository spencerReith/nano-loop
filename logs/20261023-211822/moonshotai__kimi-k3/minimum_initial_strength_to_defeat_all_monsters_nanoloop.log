from bisect import bisect_left, bisect_right

class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        
        # Compute bonus[i] for each index using difference array
        diff = [0] * (n + 2)
        for l, r, v in boosts:
            diff[l] += v
            diff[r + 1] -= v
        
        bonus = [0] * n
        cur = 0
        for i in range(n):
            cur += diff[i]
            bonus[i] = cur
        
        # Compute req[i] = minimum initial strength needed if starting at index i
        # Process from right to left, maintain "critical" entries where req == rem
        req = [0] * n
        S = 0  # max(req - rem) over processed indices
        C = 0  # sum of monsters at critical indices (where req - rem == S)
