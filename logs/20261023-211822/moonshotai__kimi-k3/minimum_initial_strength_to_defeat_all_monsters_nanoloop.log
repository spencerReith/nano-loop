            m = monsters[i]
            b = bonus[i]
            S_new = S + m
            if S_new > b:
                C_new = C + m
            else:
                C_new = 0
            req[i] = max(0, S_new - b, C_new)
            rem = req[i] - max(0, m - b)
            if req[i] - rem > S:
                S = req[i] - rem
                C = m
            elif req[i] - rem == S:
                C += m
        
        return req[0]
