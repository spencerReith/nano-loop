class Solution:
    MOD = 10**9 + 7

    def sumDecoded(self, nums: list[int]) -> int:
        mod = self.MOD
        total = 0

        for num in nums:
            width = num % 10
            d = str(num // 10)

            x = int(d[:width])
            y = int(d[width:])

            total = (total + pow(x, y, mod)) % mod

        return total
```
