class Solution:
    def maxPrimeSubset(self, n: int, s: int) -> list[int]:
        # Get all primes <= n
        primes = []
        for i in range(2, n + 1):
            is_prime = True
            for j in range(2, int(i**0.5) + 1):
                if i % j == 0:
                    is_prime = False
                    break
            if is_prime:
                primes.append(i)
        
        if not primes:
            return []
        
        # DP: dp[sum] = (count, subset) for lexicographically smallest subset
        # with minimum count achieving that sum
        # We want max sum <= s, then min count, then lexicographically smallest
        dp = [None] * (s + 1)
        dp[0] = (0, [])
        
        for p in primes:
            # Iterate from high to low to avoid using the same prime twice
            for j in range(s, p - 1, -1):
                if dp[j - p] is not None:
                    new_count = dp[j - p][0] + 1
                    new_subset = dp[j - p][1] + [p]
                    if dp[j] is None or new_count < dp[j][0]:
                        dp[j] = (new_count, new_subset)
        
        # Find max sum <= s with non-empty subset
        best_sum = -1
        best_count = float('inf')
        best_subset = []
        
        for j in range(s, 0, -1):
            if dp[j] is not None:
                if best_sum == -1 or j > best_sum:
                    best_sum = j
                    best_count = dp[j][0]
                    best_subset = dp[j][1]
                elif j == best_sum and dp[j][0] < best_count:
                    best_count = dp[j][0]
                    best_subset = dp[j][1]
        
        return best_subset
