class Solution:
    def generateValidStrings(self, n: int, k: int) -> list[str]:
        res = []

        def dfs(pos: int, cost: int, last: int, cur: list[str]):
            if pos == n:
                res.append("".join(cur))
                return
            # lexicographic order: try '0' before '1'
            cur.append('0')
            dfs(pos + 1, cost, 0, cur)
            cur.pop()
            if last == 0 and cost + pos <= k:
                cur.append('1')
                dfs(pos + 1, cost + pos, 1, cur)
                cur.pop()

        dfs(0, 0, 0, [])
        return res
