class Solution:
    def minCost(self, grid: list[list[int]], k: int) -> int:
        m, n = len(grid), len(grid[0])
        size = m * n
        flat = [grid[i][j] for i in range(m) for j in range(n)]
        INF = 10**30

        # Directions: 0=right, 1=left, 2=down, 3=up.
        # prev[d][v] is the cheapest path to v using exactly the current
        # number of turns, with last movement direction d.
        prev = [[INF] * size for _ in range(4)]
        start_cost = flat[0]
        for d in range(4):
            prev[d][0] = start_cost

        # Build the zero-turn layers: from the start one may only continue
        # along one straight ray.
        # Right
        for r in range(m):
            base = r * n
            run = INF
            for idx in range(base, base + n):
                if run != INF:
                    run += flat[idx]
                if prev[0][idx] < run:
                    run = prev[0][idx]
                prev[0][idx] = run
        # Left
        for r in range(m):
            base = r * n
            run = INF
            for idx in range(base + n - 1, base - 1, -1):
                if run != INF:
                    run += flat[idx]
                if prev[1][idx] < run:
                    run = prev[1][idx]
                prev[1][idx] = run
        # Down
        for c in range(n):
            run = INF
            for r in range(m):
                idx = r * n + c
                if run != INF:
                    run += flat[idx]
                if prev[2][idx] < run:
                    run = prev[2][idx]
                prev[2][idx] = run
        # Up
        for c in range(n):
            run = INF
            for r in range(m - 1, -1, -1):
                idx = r * n + c
                if run != INF:
                    run += flat[idx]
                if prev[3][idx] < run:
                    run = prev[3][idx]
                prev[3][idx] = run

        target = size - 1
        ans = min(prev[d][target] for d in range(4))

        for _ in range(1, k + 1):
            # For every cell, find the best and second-best previous-layer
            # values. This gives min over all directions except d in O(1).
            best1 = [INF] * size
            best2 = [INF] * size
            best_dir = [-1] * size
            for idx in range(size):
                b1 = INF
                b2 = INF
                bd = -1
                for d in range(4):
                    val = prev[d][idx]
                    if val < b1:
                        b2 = b1
                        b1 = val
                        bd = d
                    elif val < b2:
                        b2 = val
                best1[idx] = b1
                best2[idx] = b2
                best_dir[idx] = bd

            cur = [[INF] * size for _ in range(4)]

            # Last direction is right; sweep every row left-to-right.
            for r in range(m):
                base = r * n
                run = INF
                row_cur = cur[0]
                for idx in range(base, base + n):
                    src = best2[idx] if best_dir[idx] == 0 else best1[idx]
                    if run != INF:
                        run += flat[idx]
                    if src < run:
                        run = src
                    row_cur[idx] = run

            # Last direction is left; sweep every row right-to-left.
            for r in range(m):
                base = r * n
                run = INF
                row_cur = cur[1]
                for idx in range(base + n - 1, base - 1, -1):
                    src = best2[idx] if best_dir[idx] == 1 else best1[idx]
                    if run != INF:
                        run += flat[idx]
                    if src < run:
                        run = src
                    row_cur[idx] = run

            # Last direction is down; sweep every column top-to-bottom.
            for c in range(n):
                run = INF
                col_cur = cur[2]
                for r in range(m):
                    idx = r * n + c
                    src = best2[idx] if best_dir[idx] == 2 else best1[idx]
                    if run != INF:
                        run += flat[idx]
                    if src < run:
                        run = src
                    col_cur[idx] = run

            # Last direction is up; sweep every column bottom-to-top.
            for c in range(n):
                run = INF
                col_cur = cur[3]
                for r in range(m - 1, -1, -1):
                    idx = r * n + c
                    src = best2[idx] if best_dir[idx] == 3 else best1[idx]
                    if run != INF:
                        run += flat[idx]
                    if src < run:
                        run = src
                    col_cur[idx] = run

            prev = cur
            best_target = min(prev[d][target] for d in range(4))
            if best_target < ans:
                ans = best_target

        return -1 if ans == INF else ans
