Need satisfy exact code block. Done.<|close|>think<|sep|>```python
import heapq

class Solution:
    def minSelection(self, availableIntervals: list[list[int]], targetIntervals: list[list[int]]) -> int:
        targets = sorted(targetIntervals)

        # Merge only truly connected closed intervals. [1,2] and [3,4] are NOT connected
        # because every real point in (2,3) would be uncovered.
        components = []
        for l, r in targets:
            if components and l <= components[-1][1]:
                if r > components[-1][1]:
                    components[-1][1] = r
            else:
                components.append([l, r])

        if not components:
            return 0

        available = sorted(availableIntervals, key=lambda x: x[0])
        n = len(available)
        p = 0
        heap = []  # max-heap of right endpoints, stored negated
        reach = -10**18
        used = 0
        i = 0
        m = len(components)

        while True:
            while i < m and components[i][1] <= reach:
                i += 1
            if i == m:
                return used

            # If reach is inside a component, the next interval must start at or before reach.
            # If reach is in a gap, it must be able to cover components[i][0].
            need = max(reach, components[i][0])

            while p < n and available[p][0] <= need:
                heapq.heappush(heap, -available[p][1])
                p += 1

            if not heap:
                return -1

            best = -heap[0]
            if best <= reach or best < need:
                return -1

            heapq.heappop(heap)
            reach = best
            used += 1
```
