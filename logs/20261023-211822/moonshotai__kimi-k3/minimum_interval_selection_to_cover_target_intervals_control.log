```python
import heapq

class Solution:
    def minSelection(self, availableIntervals: list[list[int]], targetIntervals: list[list[int]]) -> int:
        # Merge target intervals into connected components of the set that must be covered.
        ts = sorted(targetIntervals)
        comps = []
        for l, r in ts:
            if comps and l <= comps[-1][1]:
                if r > comps[-1][1]:
                    comps[-1][1] = r
            else:
                comps.append([l, r])

        if not comps:
            return 0

        av = sorted(availableIntervals, key=lambda x: x[0])
        n = len(av)
        p = 0
        heap = []  # max-heap of right endpoints via negatives
        reach = -10**18
        ans = 0
        i = 0
        m = len(comps)

        while True:
            while i < m and comps[i][1] <= reach:
                i += 1
            if i == m:
                return ans

            need = comps[i][0] if comps[i][0] > reach else reach
            while p < n and av[p][0] <= need:
                heapq.heappush(heap, -av[p][1])
                p += 1

            if not heap:
                return -1
            best = -heap[0]
            # Must make real progress; if we are before a component, best must reach its start.
            if best <= reach or best < need:
                return -1
            heapq.heappop(heap)
            reach = best
            ans += 1
```

