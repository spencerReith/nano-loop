```python
from collections import defaultdict

class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n = len(source)
        INF = float('inf')
        
        # group rules: length -> {replacement: [(runs, cost), ...]}
        by_len = defaultdict(lambda: defaultdict(list))
        for (pat, rep), c in zip(rules, costs):
            L = len(pat)
            if L > n:
                continue
            cost = c + pat.count('*')
            runs = []
            i = 0
            while i < L:
                if pat[i] == '*':
                    i += 1
                else:
                    j = i
                    while j < L and pat[j] != '*':
                        j += 1
                    runs.append((i, pat[i:j]))
                    i = j
            by_len[L][rep].append((tuple(runs), cost))
        
        dp = [INF] * (n + 1)
        dp[0] = 0
        src = source
        tgt = target
        for l in range(n):
            dl = dp[l]
            if dl == INF:
                continue
            if src[l] == tgt[l]:
                if dl < dp[l+1]:
                    dp[l+1] = dl
            for L, rep_map in by_len.items():
                end = l + L
                if end > n:
                    continue
                lst = rep_map.get(tgt[l:end])
                if lst is None:
                    continue
                best = INF
                for runs, cost in lst:
                    for off, run in runs:
                        if not src.startswith(run, l + off):
                            break
                    else:
                        if cost < best:
                            best = cost
                if best != INF:
                    v = dl + best
                    if v < dp[end]:
                        dp[end] = v
        return dp[n] if dp[n] != INF else -1
```

