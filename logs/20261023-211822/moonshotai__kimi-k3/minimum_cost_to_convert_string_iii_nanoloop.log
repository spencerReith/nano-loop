```python
class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n = len(source)
        INF = float('inf')
        
        # Precompute rule data grouped by length, then by replacement
        from collections import defaultdict
        by_len = [defaultdict(list) for _ in range(21)]  # length -> replacement -> list of (runs, cost)
        lengths = set()
        for (pat, rep), c in zip(rules, costs):
            L = len(pat)
            stars = pat.count('*')
            cost = c + stars
            # literal runs
            runs = []
            i = 0
            while i < L:
                if pat[i] == '*':
                    i += 1
                    continue
                j = i
                while j < L and pat[j] != '*':
                    j += 1
                runs.append((i, pat[i:j]))
                i = j
            by_len[L][rep].append((runs, cost))
            lengths.add(L)
        
        dp = [INF] * (n + 1)
        dp[0] = 0
        for l in range(n):
            dl = dp[l]
            if dl == INF:
                continue
            if source[l] == target[l] and dl < dp[l+1]:
                dp[l+1] = dl
            for L in lengths:
                if l + L > n:
                    continue
                t = target[l:l+L]
                lst = by_len[L].get(t)
                if not lst:
                    continue
                best = INF
                for runs, cost in lst:
                    ok = True
                    for off, run in runs:
                        if not source.startswith(run, l + off):
                            ok = False
                            break
                    if ok and cost < best:
                        best = cost
                if best < INF:
                    v = dl + best
                    if v < dp[l+L]:
                        dp[l+L] = v
        return dp[n] if dp[n] < INF else -1
```

