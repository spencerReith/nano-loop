Key insight: since the rotation distance is symmetric, reversing suffix `s[k..n-1]` keeps all internal suffix edges' costs identical — only the single boundary edge changes (from `s[k-1]→s[k]` to `s[k-1]→s[n-1]`, or `0→s[0]` to `0→s[n-1]` when `k=0`).

```python
class Solution:
    def minRotations(self, n: int, s: str) -> int:
        def d(a: int, b: int) -> int:
            diff = abs(a - b)
            return min(diff, 10 - diff)

        digits = [int(c) for c in s]
        last = digits[n - 1]

        # Original total cost
        total = d(0, digits[0])
        for i in range(1, n):
            total += d(digits[i - 1], digits[i])

        ans = total  # option: do nothing

        # k = 0: reverse whole string; edge 0 -> s[0] becomes 0 -> s[n-1]
        ans = min(ans, total - d(0, digits[0]) + d(0, last))

        # k >= 1: edge s[k-1] -> s[k] becomes s[k-1] -> s[n-1]
        for k in range(1, n):
            cand = total - d(digits[k - 1], digits[k]) + d(digits[k - 1], last)
            if cand < ans:
                ans = cand

        return ans
```
