class Solution:
    def canTransform(self, source: list[int], target: list[int]) -> bool:
        n = len(source)
        if n != len(target):
            return False
        if sum(source) != sum(target):
            return False

        diff = [source[i] - target[i] for i in range(n)]
        total_pos = sum(d for d in diff if d > 0)
        total_neg = -sum(d for d in diff if d < 0)
        if total_pos != total_neg:
            return False
        if total_pos == 0:
            return True

        matches = 0
        for d in diff:
            if d == 0:
                matches += 1
        if matches >= 2:
            return True

        return total_pos > 1
