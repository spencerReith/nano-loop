class Solution:
    def validSubarrays(self, nums: list[int], k: int, queries: list[list[int]]) -> list[bool]:
        from collections import defaultdict
        
        n = len(nums)
        q = len(queries)
        ans = [False] * q
        
        # Mo's algorithm
        block_size = int(n ** 0.5) + 1
        
        # Sort queries using Mo's ordering
        indexed_queries = []
        for i, (l, r) in enumerate(queries):
            indexed_queries.append((l, r, i))
        
        def get_block(pos):
            return pos // block_size
        
        indexed_queries.sort(key=lambda x: (get_block(x[0]), x[1] if get_block(x[0]) % 2 == 0 else -x[1]))
        
        freq = defaultdict(int)
        distinct_count = 0
        odd_count = 0
        
        def add(pos):
            nonlocal distinct_count, odd_count
            val = nums[pos]
            old_f = freq[val]
            new_f = old_f + 1
            freq[val] = new_f
            
            if old_f == 0:
                distinct_count += 1
            
            if old_f % 2 == 1:
                odd_count -= 1
            if new_f % 2 == 1:
                odd_count += 1
        
        def remove(pos):
            nonlocal distinct_count, odd_count
            val = nums[pos]
            old_f = freq[val]
            new_f = old_f - 1
            freq[val] = new_f
            
            if new_f == 0:
                distinct_count -= 1
            
            if old_f % 2 == 1:
                odd_count -= 1
            if new_f % 2 == 1:
                odd_count += 1
        
        cur_l, cur_r = 0, -1
        
        for l, r, idx in indexed_queries:
            while cur_l > l:
                cur_l -= 1
                add(cur_l)
            while cur_r < r:
                cur_r += 1
                add(cur_r)
            while cur_l < l:
                remove(cur_l)
                cur_l += 1
            while cur_r > r:
                remove(cur_r)
                cur_r -= 1
            
            # Valid if exactly k distinct numbers and all frequencies are even (odd_count == 0)
            ans[idx] = (distinct_count == k and odd_count == 0)
        
        return ans
