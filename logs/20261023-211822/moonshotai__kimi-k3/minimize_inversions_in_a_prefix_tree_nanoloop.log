```python
import heapq
from bisect import bisect_left


class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n = len(words)
        pos = [0] * n
        for p, idx in enumerate(target):
            pos[idx] = p

        # Build trie
        children = [{}]          # node -> dict char -> node id
        mark = [-1]              # node -> pos value of word ending here (or -1)

        for i, w in enumerate(words):
            u = 0
            for ch in w:
                d = children[u]
                v = d.get(ch)
                if v is None:
                    v = len(children)
                    d[ch] = v
                    children.append({})
                    mark.append(-1)
                u = v
            mark[u] = pos[i]

        def cross_inv(A, B):
            # count pairs (a in A, b in B) with a > b ; A, B sorted, values distinct
            cnt = 0
            j = 0
            lb = len(B)
            for a in A:
                while j < lb and B[j] < a:
                    j += 1
                cnt += j
            return cnt

        INF = float('inf')

        def dfs(u):
            lists = []
            total = 0
            for v in children[u].values():
                vals, inv = dfs(v)
                lists.append(vals)
                total += inv

            k = len(lists)
            mval = mark[u]

            if k == 0:
                return ([mval] if mval != -1 else []), total

            if k == 1:
                vals = lists[0]
                if mval != -1:
                    i = bisect_left(vals, mval)
                    total += i  # child values < mark (mark is recorded first)
                    vals = vals[:i] + [mval] + vals[i:]
                return vals, total

            # pairwise cross inversion costs: cost[i][j] = inversions if child i
            # is placed before child j
            cost = [[0] * k for _ in range(k)]
            for i in range(k):
                li = lists[i]
                for j in range(k):
                    if i != j:
                        cost[i][j] = cross_inv(li, lists[j])

            # Exact DP over subsets: dp[mask] = min cross inversions when ordering
            # exactly the children in mask.
            size = 1 << k
            # pre[j][mask] = sum_{i in mask} cost[i][j]
            pre = [[0] * size for _ in range(k)]
            for j in range(k):
                pj = pre[j]
                cj = [cost[i][j] for i in range(k)]
                for mask in range(1, size):
                    lsb = mask & (-mask)
                    pj[mask] = pj[mask ^ lsb] + cj[lsb.bit_length() - 1]

            dp = [INF] * size
            dp[0] = 0
            for mask in range(1, size):
                best = INF
                m = mask
                while m:
                    lsb = m & (-m)
                    j = lsb.bit_length() - 1
                    prev = mask ^ lsb
                    cand = dp[prev] + pre[j][prev]
                    if cand < best:
                        best = cand
                    m ^= lsb
                dp[mask] = best
            total += dp[size - 1]

            # inversions between the node's own mark (recorded first) and children
            if mval != -1:
                for vals in lists:
                    total += bisect_left(vals, mval)

            # k-way merge of sorted child lists (order irrelevant to the count now)
            merged = []
            idxs = [0] * k
            heap = [(vals[0], i) for i, vals in enumerate(lists) if vals]
            heapq.heapify(heap)
            while heap:
                val, i = heapq.heappop(heap)
                merged.append(val)
                ni = idxs[i] + 1
                idxs[i] = ni
                if ni < len(lists[i]):
                    heapq.heappush(heap, (lists[i][ni], i))
            if mval != -1:
                i = bisect_left(merged, mval)
                merged = merged[:i] + [mval] + merged[i:]
            return merged, total

        return dfs(0)[1]
