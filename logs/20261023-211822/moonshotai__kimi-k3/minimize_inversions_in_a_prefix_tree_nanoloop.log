```python
from functools import cmp_to_key
import heapq

class Solution:
    def minInversions(self, words, target):
        n = len(words)
        pos = [0]*n
        for p, idx in enumerate(target):
            pos[idx] = p
        # build trie
        # node: children dict, mark value or -1
        children = []  # list of dict
        mark = []
        children.append({})
        mark.append(-1)
        for i, w in enumerate(words):
            node = 0
            for ch in w:
                d = children[node]
                if ch not in d:
                    d[ch] = len(children)
                    children.append({})
                    mark.append(-1)
                node = d[ch]
            mark[node] = pos[i]
        # iterative post-order DFS
        # returns sorted list and inversion count
        ...
```

