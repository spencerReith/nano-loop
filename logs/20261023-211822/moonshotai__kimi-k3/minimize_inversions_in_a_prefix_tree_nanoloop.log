```python
def merge_count(L, R):
    # both sorted, all values distinct globally
    i=j=0
    cnt=0
    out=[]
    while i<len(L) and j<len(R):
        if L[i] < R[j]:
            out.append(L[i]); i+=1
        else:
            out.append(R[j]); j+=1
            cnt += len(L)-i
    out.extend(L[i:]); out.extend(R[j:])
    return out, cnt
```

