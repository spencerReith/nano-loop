from math import gcd
from typing import List


class Solution:
    def maxValidSplits(self, nums: List[int]) -> int:
        n = len(nums)

        # Helper to compute the score of an array:
        # number of indices i where prefix gcd == suffix gcd.
        def score(arr):
            m = len(arr)
            if m < 2:
                return 0
            pref = [0] * m
            suff = [0] * m
            pref[0] = arr[0]
            for k in range(1, m):
                pref[k] = gcd(pref[k - 1], arr[k])
            suff[m - 1] = arr[m - 1]
            for k in range(m - 2, -1, -1):
                suff[k] = gcd(suff[k + 1], arr[k])
            cnt = 0
            for k in range(m - 1):
                if pref[k] == suff[k + 1]:
                    cnt += 1
            return cnt

        # Prefix/suffix gcd of the original array.
        P = [0] * n
        S = [0] * n
        P[0] = nums[0]
        for i in range(1, n):
            P[i] = gcd(P[i - 1], nums[i])
        S[n - 1] = nums[n - 1]
        for i in range(n - 2, -1, -1):
            S[i] = gcd(S[i + 1], nums[i])

        # Option 1: remove nothing.
        ans = score(nums)

        # Option 2: remove each index r, one at a time.
        for r in range(n):
            m = n - 1
            if m < 2:
                continue

            # Prefix gcds of the array after removal (aligned to original indices).
            # pre[i] = gcd of kept elements with original index <= i.
            pre = [0] * n
            if r > 0:
                pre[0] = nums[0]
            for i in range(1, n):
                if i == r:
                    pre[i] = pre[i - 1]
                elif i - 1 == r:
                    pre[i] = gcd(pre[r - 1] if r > 0 else 0, nums[i]) if r > 0 else nums[i]
                else:
                    pre[i] = gcd(pre[i - 1], nums[i])

            # Suffix gcds of the array after removal (aligned to original indices).
            # suf[i] = gcd of kept elements with original index >= i.
            suf = [0] * n
            if r < n - 1:
                suf[n - 1] = nums[n - 1]
            for i in range(n - 2, -1, -1):
                if i == r:
                    suf[i] = suf[i + 1]
                elif i + 1 == r:
                    suf[i] = gcd(suf[r + 1] if r < n - 1 else 0, nums[i]) if r < n - 1 else nums[i]
                else:
                    suf[i] = gcd(suf[i + 1], nums[i])

            # In the kept array, split positions correspond to original indices i
            # (i != r, i < n-1 or i can be n-1 only if r < n-1... handle generally):
            # kept order indices are all j != r; a split occurs between consecutive
            # kept elements (i, next kept after i).
            cnt = 0
            prev_kept = -1
            for i in range(n):
                if i == r:
                    continue
                if prev_kept != -1:
                    # split between prev_kept and i:
                    # left gcd = pre[prev_kept], right gcd = suf[i]
                    if pre[prev_kept] == suf[i]:
                        cnt += 1
                prev_kept = i

            if cnt > ans:
                ans = cnt

        return ans
