Let me write solution.py:

```python
import numpy as np
from collections import defaultdict

class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        BIG = n + 5

        # prefix sums mod k
        mods = np.empty(n + 1, dtype=np.int64)
        mods[0] = 0
        s = 0
        for i, x in enumerate(nums, 1):
            s = (s + x) % k
            mods[i] = s

        first = np.full(k, BIG, dtype=np.int64)
        last = np.full(k, -1, dtype=np.int64)
        idxs = np.arange(n + 1, dtype=np.int64)
        np.minimum.at(first, mods, idxs)
        np.maximum.at(last, mods, idxs)

        # case A: sum already divisible by k
        ans = int((last - first).max())

        # group element indices by v = (2*nums[j]) % k
        pos_by_v = defaultdict(list)
        for j, x in enumerate(nums):
            pos_by_v[(2 * x) % k].append(j)

        arange_k = np.arange(k, dtype=np.int64)
        for v, pos in pos_by_v.items():
            pos_arr = np.asarray(pos, dtype=np.int64)
            m = pos_arr.shape[0]
            q = arange_k + v
            q[q >= k] -= k
            lq = last[q]                    # last occurrence of (p+v)%k for each p
            fp = first
            idx = np.searchsorted(pos_arr, fp)   # per p: first j >= fp
            valid_idx = idx < m
            nxt = pos_arr[np.where(valid_idx, idx, 0)]
            feas = valid_idx & (nxt < lq) & (fp < lq)
            cand = np.where(feas, lq - fp, 0)
            b = int(cand.max())
            if b > ans:
                ans = b

        return ans if ans > 0 else 0
```

