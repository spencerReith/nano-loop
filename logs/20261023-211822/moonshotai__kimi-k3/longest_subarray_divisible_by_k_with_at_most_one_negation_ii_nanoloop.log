```python
import random
from solution import Solution

def brute(nums, k):
    n = len(nums)
    best = 0
    for l in range(n):
        s = 0
        vs = set()
        for r in range(l, n):
            s += nums[r]
            vs.add((2 * nums[r]) % k)
            sm = s % k
            if sm == 0 or sm in vs:
                if r - l + 1 > best:
                    best = r - l + 1
    return best

s = Solution()
print(s.longestSubarray([4,1,2], 3), "expected", 3)
print(s.longestSubarray([5,3,4], 7), "expected", 2)
print(s.longestSubarray([2,2,5], 6), "expected", 2)

random.seed(0)
for t in range(2000):
    n = random.randint(1, 12)
    k = random.randint(1, 8)
    nums = [random.randint(-10, 10) for _ in range(n)]
    got = s.longestSubarray(nums, k)
    exp = brute(nums, k)
    if got != exp:
        print("MISMATCH", nums, k, got, exp)
        break
else:
    print("all small random ok")

