```python
import numpy as np
from collections import defaultdict

class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        BIG = n + 5
        first = np.full(k, BIG, dtype=np.int64)
        last = np.full(k, -1, dtype=np.int64)
        # compute prefix mods
        mods = [0] * (n + 1)
        s = 0
        for i, x in enumerate(nums):
            s = (s + x) % k
            mods[i + 1] = s
        mods_arr = np.array(mods, dtype=np.int64)
        # first/last occurrence
        # use np.minimum.at / maximum.at
        idxs = np.arange(n + 1, dtype=np.int64)
        np.minimum.at(first, mods_arr, idxs)
        np.maximum.at(last, mods_arr, idxs)
        ansA = int((last - first).max())  # may be negative if none; but at least one remainder occurs
        # group positions by v
        pos_by_v = defaultdict(list)
        for j, x in enumerate(nums):
            v = (2 * x) % k
            pos_by_v[v].append(j)
        first_list = first  # np array
        ans = ansA
        arange_k = np.arange(k, dtype=np.int64)
        for v, pos in pos_by_v.items():
            pos_arr = np.asarray(pos, dtype=np.int64)
            m = len(pos_arr)
            q = arange_k + v
            if v >= k:  # v < k always since v = (2x)%k
                q -= k
            q %= k  # q = (p+v)%k
            lq = last[q]
            fp = first_list
            idx = np.searchsorted(pos_arr, fp)  # for each p, smallest j >= fp
            # nxt_j where idx < m
            idxc = np.minimum(idx, m - 1)
            nxt = pos_arr[idxc]
            feasible = (idx < m) & (nxt < lq) & (fp < lq)
            cand = np.where(feasible, lq - fp, 0)
            b = int(cand.max())
            if b > ans:
                ans = b
        return max(ans, 0)
```

