def brute(nums, k):
    n = len(nums)
    best = 0
    for l in range(n):
        s = 0
        vs = set()
        for r in range(l, n):
            s += nums[r]
            vs.add((2*nums[r]) % k)
            sm = s % k
            if sm == 0 or sm in vs:
                best = max(best, r - l + 1)
    return best
```

