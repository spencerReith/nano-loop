Let me write the next-array approach:

```python
class Solution:
    def canMakeSubsequence(self, s: str, t: str) -> bool:
        n, m = len(s), len(t)
        INF = m + 1  # represents impossible / not found
        
        # next[i][c] = smallest index >= i with t[index] == c, or INF
        nxt = [[INF] * 26 for _ in range(m + 1)]
        for i in range(m - 1, -1, -1):
            row = nxt[i]
            prow = nxt[i + 1]
            for c in range(26):
                row[c] = prow[c]
            row[ord(t[i]) - 97] = i
        
        dp0, dp1 = 0, INF
        for ch in s:
            c = ord(ch) - 97
            ndp0 = INF
            ndp1 = INF
            if dp0 <= m:
                p = nxt[dp0][c]
                if p < INF:
                    ndp0 = p + 1
                # replace s[i]: match with any char at position dp0
                if dp0 < m:
                    ndp1 = dp0 + 1
            if dp1 <= m:
                p = nxt[dp1][c]
                if p < INF:
                    ndp1 = min(ndp1, p + 1)
            dp0, dp1 = ndp0, ndp1
            if dp0 > m and dp1 > m:
                return False
        
        return min(dp0, dp1) <= m
```

