# Re-evaluating the simplest approach:
# Use two Fenwick Trees.
class Fenwick:
    def __init__(self, n):
        self.n = n
        self.tree = [0] * (n + 1)
        
    def add(self, i, delta):
        i += 1
        while i <= self.n:
            self.tree[i] += delta
            i += i & (-i)
            
    def query(self, i):
        # prefix sum [0..i]
        i += 1
        res = 0
        while i > 0:
            res += self.tree[i]
            i -= i & (-i)
        return res

class Solution:
    def validSubarrays(self, nums: list[int], k: int, queries: list[list[int]]) -> list[bool]:
        n = len(nums)
        
        # Compress values
        vals = sorted(list(set(nums)))
        v_map = {v: i for i, v in enumerate(vals)}
        a = [v_map[x] for x in nums]
        
        import random
        random.seed(1337)
        hashes = [random.getrandbits(64) for _ in range(len(vals))]
        
        # bit_dist for distinct count (Point Update, Range Query)
        bit_dist = Fenwick(n)
        # bit_hash for XOR hash (Range Update, Point Query)
        bit_hash = Fenwick(n)
        
        from collections import defaultdict
        q_by_r = defaultdict(list)
        for i, (l, r) in enumerate(queries):
            q_by_r[r].append((l, i))
            
        ans = [False] * len(queries)
        last = [-1] * len(vals)
        
        for r in range(n):
            val = a[r]
            prev = last[val]
            
            # Update distinct BIT
            bit_dist.add(r, 1)
            if prev != -1:
                bit_dist.add(prev, -1)
                
            # Update hash BIT
            # Range add [0, r] with h
            h = hashes[val]
            bit_hash.add(0, h)
            if r + 1 < n:
                bit_hash.add(r + 1, -h)
                
            last[val] = r
            
            if r in q_by_r:
                for l, idx in q_by_r[r]:
                    d_count = bit_dist.query(r) - (bit_dist.query(l - 1) if l > 0 else 0)
                    if d_count != k:
                        continue
                        
                    h_val = bit_hash.query(l)
                    if h_val == 0:
                        ans[idx] = True
                        
