class Solution:
    def largestString(self, nums: list[int]) -> list[str]:
        res = []
        for x in nums:
            chars = []
            for k in range(x.bit_length() - 1, -1, -1):
                if (x >> k) & 1:
                    chars.append(chr(97 + k))
            res.append(''.join(chars))
        return res
```

