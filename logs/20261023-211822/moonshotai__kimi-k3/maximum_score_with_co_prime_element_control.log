class Solution:
    def maxScore(self, nums: list[int], maxVal: int) -> int:
        n = len(nums)
        limit = max(maxVal, max(nums))

        freq = [0] * (limit + 1)
        for x in nums:
            freq[x] += 1

        # divisible_by[d] = number of array elements divisible by d
        divisible_by = [0] * (limit + 1)
        for d in range(1, limit + 1):
            for multiple in range(d, limit + 1, d):
                divisible_by[d] += freq[multiple]

        # Linear sieve for Mobius function
        mu = [1] * (limit + 1)
        primes = []
        composite = bytearray(limit + 1)

        for i in range(2, limit + 1):
            if not composite[i]:
                primes.append(i)
                mu[i] = -1

            for p in primes:
                x = i * p
                if x > limit:
                    break
                composite[x] = 1

                if i % p == 0:
                    mu[x] = 0
                    break
                mu[x] = -mu[i]

        # coprime_cnt[v] = number of array elements coprime with v
        coprime_cnt = [0] * (limit + 1)
        for d in range(1, limit + 1):
            if mu[d]:
                add = mu[d] * divisible_by[d]
                if add:
                    for multiple in range(d, limit + 1, d):
                        coprime_cnt[multiple] += add

        best = -10**18

        for v in range(1, limit + 1):
            # Values greater than maxVal are only selectable if already present.
            if v > maxVal and freq[v] == 0:
                continue

            if v == 1:
                cost = 0 if freq[1] else 1
            else:
                not_coprime = n - coprime_cnt[v]

                if freq[v]:
                    # Select an existing v; every other non-coprime element changes.
                    cost = not_coprime - 1
                elif v <= maxVal:
                    # Change one element into v.
                    cost = not_coprime if not_coprime else 1
                else:
                    continue

            best = max(best, v - cost)

        return best
```
