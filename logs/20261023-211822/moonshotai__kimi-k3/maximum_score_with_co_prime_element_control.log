Now code style:
class Solution:
    def maxScore(self, nums: list[int], maxVal: int) -> int:
        n=len(nums)
        limit=max(maxVal, max(nums))
        freq=[0]*(limit+1)
        for x in nums: freq[x]+=1

        divisible=[0]*(limit+1)
        for d in range(1, limit+1):
            # local variables for speed maybe
            for m in range(d, limit+1, d):
                divisible[d] += freq[m]

        mu=[1]*(limit+1)
        primes=[]
        is_comp=bytearray(limit+1)
        for i in range(2, limit+1):
            if not is_comp[i]:
                primes.append(i)
                mu[i] = -1
            for p in primes:
                ip=i*p
                if ip>limit: break
                is_comp[ip]=1
                if i % p ==0:
                    mu[ip]=0
                    break
                mu[ip] = -mu[i]

        coprime=[0]*(limit+1)
        for d in range(1, limit+1):
            md=mu[d]
            if md:
                add=md*divisible[d]
                if add:
                    for m in range(d, limit+1, d):
                        coprime[m] += add

        best=-10**18
        # locals for speed
        freq_l=freq; coprime_l=coprime
        for v in range(1, limit+1):
            if v > maxVal and freq_l[v]==0:
                continue
            if v == 1:
                cost = 0 if freq_l[1] else 1
            else:
                non_coprime = n - coprime_l[v]
                if freq_l[v]:
                    cost = non_coprime - 1
                elif v <= maxVal:
                    cost = non_coprime if non_coprime else 1
                else:
                    continue
            score = v - cost
            if score > best: best = score
        return best

