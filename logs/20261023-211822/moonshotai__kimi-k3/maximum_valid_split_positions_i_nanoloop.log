```python
from math import gcd

class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)
        best = 0
        # Try removing index k; k == n means remove nothing
        for k in range(n + 1):
            # arr = nums without index k (if k < n)
            m = n - (1 if k < n else 0)
            if m < 2:
                continue
            # suffix gcds of arr
            # We'll compute suffix gcd array over arr positions.
            # arr index j corresponds to original index: j if j < k else j+1 (for k < n); if k == n, arr index j = j.
            suf = [0] * m
            g = 0
            for j in range(m - 1, -1, -1):
                idx = j if (k == n or j < k) else j + 1
                g = gcd(g, nums[idx])
                suf[j] = g
            g = 0
            count = 0
            for i in range(m - 1):
                idx = i if (k == n or i < k) else i + 1
                g = gcd(g, nums[idx])
                if g == suf[i + 1]:
                    count += 1
            best = max(best, count)
        return best
```

