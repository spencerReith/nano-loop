```python
class Solution:
    def passwordStrength(self, password: str) -> int:
        seen = set(password)
        strength = 0
        specials = set("!@#$")
        for ch in seen:
            if 'a' <= ch <= 'z':
                strength += 1
            elif 'A' <= ch <= 'Z':
                strength += 2
            elif '0' <= ch <= '9':
                strength += 3
            elif ch in specials:
                strength += 5
        return strength
