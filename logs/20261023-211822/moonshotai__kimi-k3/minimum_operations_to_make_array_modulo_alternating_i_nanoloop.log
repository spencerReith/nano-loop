class Solution:
    def minOperations(self, nums: list[int], k: int) -> int:
        even_cost = [0] * k
        odd_cost = [0] * k

        for i, v in enumerate(nums):
            a = v % k
            costs = even_cost if i % 2 == 0 else odd_cost
            for r in range(k):
                d = (r - a) % k
                costs[r] += min(d, k - d)

        ans = 10**18
        for x in range(k):
            for y in range(k):
                if x != y:
                    ans = min(ans, even_cost[x] + odd_cost[y])
        return ans
