class Solution:
    def minOperations(self, nums: list[int], k: int) -> int:
        even_cost=[0]*k
        odd_cost=[0]*k
        for i,v in enumerate(nums):
            a=v%k
            # target array costs add min((r-a)%k,(a-r)%k) for r
            # loop r 0..k-1
            if i%2==0:
                for r in range(k):
                    d=(r-a)%k
                    if d > k-d: d=k-d
                    even_cost[r]+=d
            else:
                for r in range(k):
                    d=(r-a)%k
                    if d > k-d: d=k-d
                    odd_cost[r]+=d
        ans=10**18
        for x in range(k):
            cx=even_cost[x]
            for y in range(k):
                if x==y: continue
                val=cx+odd_cost[y]
                if val<ans: ans=val
        return ans

