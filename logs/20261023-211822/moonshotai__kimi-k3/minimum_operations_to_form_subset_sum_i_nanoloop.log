Need final. Ensure code block contains entire solution. No trailing explanation. Done.<|close|>think<|sep|>```python
class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        target = sum
        INF = 10**9

        # dp[s] = minimum operations to make a chosen subset sum to s
        dp = [INF] * (target + 1)
        dp[0] = 0

        for x in nums:
            options = []

            # Only multiplications: x, 2x, 4x, ...
            value = x
            cost = 0
            while value <= target:
                options.append((value, cost))
                value *= 2
                cost += 1

            # Only divisions: floor(x/2), floor(x/4), ...
            # Any sequence using both multiplications and divisions is dominated
            # by one of these two chains with the same final value and lower cost.
            value = x // 2
            cost = 1
            while value > 0:
                if value <= target:
                    options.append((value, cost))
                value //= 2
                cost += 1

            ndp = dp[:]  # do not use this element
            for value, cost in options:
                for s in range(value, target + 1):
                    prev = dp[s - value]
                    if prev + cost < ndp[s]:
                        ndp[s] = prev + cost
            dp = ndp

        return dp[target] if dp[target] < INF else -1
```
