```python
from collections import Counter

class Solution:
    def numberOfPairs(self, nums1, nums2, queries):
        n = len(nums2)
        B = 300  # block size
        a = list(nums2)
        # block id of index i: i // B
        nb = (n + B - 1) // B
        lz = [0] * nb
        cnt = [None] * nb
        for b in range(nb):
            cnt[b] = Counter(a[b*B:(b+1)*B])
        
        # nums1 multiplicities
        c1 = Counter(nums1)
        vals = list(c1.items())  # (value, multiplicity)
        
        ans = []
        for q in queries:
            if q[0] == 1:
                _, x, y, val = q
                bx, by = x // B, y // B
                if bx == by:
                    # partial single block
                    b = bx
                    s, e = b*B, min((b+1)*B, n)
                    base = lz[b]
                    c = cnt[b]
                    for i in range(x, y+1):
                        old = a[i]
                        a[i] = old + val
                        # update counter
                        if c[old] == 1:
                            del c[old]
                        else:
                            c[old] -= 1
                        c[old+val] = c.get(old+val, 0) + 1
                else:
                    # left partial block bx: indices x..end of bx
                    # right partial block by: start of by..y
                    # full blocks bx+1..by-1: lazy += val
                    for b in range(bx+1, by):
                        lz[b] += val
                    # left partial
                    b = bx
                    e = min((b+1)*B, n)
                    c = cnt[b]
                    for i in range(x, e):
                        old = a[i]
                        a[i] = old + val
                        if c[old] == 1:
                            del c[old]
                        else:
                            c[old] -= 1
                        c[old+val] = c.get(old+val, 0) + 1
                    # right partial
                    b = by
                    s = b*B
                    c = cnt[b]
                    for i in range(s, y+1):
                        old = a[i]
                        a[i] = old + val
                        if c[old] == 1:
                            del c[old]
                        else:
                            c[old] -= 1
                        c[old+val] = c.get(old+val, 0) + 1
            else:
                tot = q[1]
                total = 0
                for b in range(nb):
                    base = lz[b]
                    c = cnt[b]
                    for v1, m in vals:
                        total += m * c.get(tot - v1 - base, 0)
                ans.append(total)
        return ans
```

