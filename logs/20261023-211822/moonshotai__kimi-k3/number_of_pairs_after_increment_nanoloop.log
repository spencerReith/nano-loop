```python
def range_add(x, y, val):
    bx, by = x // B, y // B
    if bx == by:
        partial_update(bx, x, y, val)
    else:
        for b in range(bx+1, by): lz[b] += val
        partial_update(bx, x, (bx+1)*B - 1, val)
        partial_update(by, by*B, y, val)

def partial_update(b, l, r, val):
    # update a[l..r] within block b
    if r - l + 1 <= 16:
        c = cnt[b]
        for i in range(l, r+1):
            old = a[i]; a[i] = old + val
            if c[old] == 1: del c[old]
            else: c[old] -= 1
            c[old+val] = c.get(old+val, 0) + 1
    else:
        a[l:r+1] = [v + val for v in a[l:r+1]]
        s = b * B; e = min(s + B, n)
        cnt[b] = Counter(a[s:e])
```

This gives good performance for both small and large updates. 

