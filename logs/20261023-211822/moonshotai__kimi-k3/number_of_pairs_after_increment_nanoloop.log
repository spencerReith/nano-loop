```python
from collections import Counter

class Solution:
    def numberOfPairs(self, nums1: list[int], nums2: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums2)
        B = 300
        a = list(nums2)
        nb = (n + B - 1) // B
        lz = [0] * nb
        cnt = [Counter(a[b*B:(b+1)*B]) for b in range(nb)]
        vals = list(Counter(nums1).items())
        ans = []
        for q in queries:
            if q[0] == 1:
                _, x, y, val = q
                bx, by = x // B, y // B
                if bx == by:
                    s = bx * B
                    e = min(s + B, n)
                    a[x:y+1] = [v + val for v in a[x:y+1]]
                    cnt[bx] = Counter(a[s:e])
                else:
                    for b in range(bx + 1, by):
                        lz[b] += val
                    s = bx * B
                    e = s + B
                    a[x:e] = [v + val for v in a[x:e]]
                    cnt[bx] = Counter(a[s:e])
                    s = by * B
                    e = min(s + B, n)
                    a[s:y+1] = [v + val for v in a[s:y+1]]
                    cnt[by] = Counter(a[s:e])
            else:
                tot = q[1]
                total = 0
                for base, c in zip(lz, cnt):
                    t = tot - base
                    for v1, m in vals:
                        total += m * c.get(t - v1, 0)
                ans.append(total)
        return ans
```

