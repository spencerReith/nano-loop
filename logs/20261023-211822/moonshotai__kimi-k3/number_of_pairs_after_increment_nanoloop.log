Let me write it:

```python
from collections import Counter

class Solution:
    def numberOfPairs(self, nums1, nums2, queries):
        n = len(nums2)
        size = 4 * n
        cnt = [None] * size
        lazy = [0] * size

        def build(node, l, r):
            if l == r:
                cnt[node] = {nums2[l]: 1}
                return
            mid = (l + r) // 2
            build(2*node, l, mid)
            build(2*node+1, mid+1, r)
            c = dict(cnt[2*node])
            for k, v in cnt[2*node+1].items():
                c[k] = c.get(k, 0) + v
            cnt[node] = c

        build(1, 0, n-1)

        def add(node, l, r, ql, qr, val):
            if ql <= l and r <= qr:
                lazy[node] += val
                return
            mid = (l + r) // 2
            if ql <= mid:
                add(2*node, l, mid, ql, qr, val)
            if qr > mid:
                add(2*node+1, mid+1, r, ql, qr, val)

        def query(node, l, r, ql, qr, v, acc):
            acc += lazy[node]
            if ql <= l and r <= qr:
                return cnt[node].get(v - acc, 0)
            mid = (l + r) // 2
            res = 0
            if ql <= mid:
                res += query(2*node, l, mid, ql, qr, v, acc)
            if qr > mid:
                res += query(2*node+1, mid+1, r, ql, qr, v, acc)
            return res

        # Deduplicate nums1 values with counts
        from collections import Counter as C
        c1 = C(nums1)

        ans = []
        for q in queries:
            if q[0] == 1:
                _, x, y, val = q
                add(1, 0, n-1, x, y, val)
            else:
                tot = q[1]
                total = 0
                for v, c in c1.items():
                    total += c * query(1, 0, n-1, 0, n-1, tot - v, 0)
                ans.append(total)
        return ans
```

