The solution uses square-root decomposition on `nums2`:
- Each block keeps a `Counter` of its raw values plus a lazy add tag (effective value = raw + tag).
- Type-1 update: full blocks just bump the lazy tag; the ≤2 boundary blocks are updated element-wise (or rebuilt via C-speed `Counter` for large ranges).
- Type-2 query: since `nums1` has ≤5 elements, the answer is `Σ_{v1 in nums1} mult(v1) × freq(tot − v1)` summed over all blocks (looking up `tot − v1 − lazy` in each block's counter).
- Block size is chosen adaptively by pre-scanning the query mix.

```python
from collections import Counter


class Solution:
    def numberOfPairs(self, nums1: list[int], nums2: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums2)
        vals = list(Counter(nums1).items())  # (value, multiplicity) in nums1
        d = len(vals)

        # Pre-scan queries to pick a good block size.
        u = 0  # number of type-1 queries
        w = 0  # number of type-2 queries
        for q in queries:
            if q[0] == 1:
                u += 1
            else:
                w += 1

        if u == 0:
            B = n  # no updates: a single block is optimal
        else:
            B = int(0.7 * (n * (w * d + u) / u) ** 0.5) + 1
            if B < 32:
                B = 32
            elif B > n:
                B = n

        a = list(nums2)
        nb = (n + B - 1) // B
        lz = [0] * nb                       # lazy add per block
        cnt = [Counter(a[b * B:(b + 1) * B]) for b in range(nb)]  # raw-value counter per block
        ans = []

        def partial_update(b: int, l: int, r: int, val: int) -> None:
            # add val to a[l..r], all inside block b
            if r - l + 1 <= 16:
                c = cnt[b]
                for i in range(l, r + 1):
                    old = a[i]
                    a[i] = old + val
                    if c[old] == 1:
                        del c[old]
                    else:
                        c[old] -= 1
                    c[old + val] = c.get(old + val, 0) + 1
            else:
                a[l:r + 1] = [v + val for v in a[l:r + 1]]
                s = b * B
                e = s + B
                if e > n:
                    e = n
                cnt[b] = Counter(a[s:e])

        for q in queries:
            if q[0] == 1:
                _, x, y, val = q
                bx, by = x // B, y // B
                if bx == by:
                    partial_update(bx, x, y, val)
                else:
                    for b in range(bx + 1, by):
                        lz[b] += val
                    partial_update(bx, x, (bx + 1) * B - 1, val)
                    partial_update(by, by * B, y, val)
            else:
                tot = q[1]
                total = 0
                for base, c in zip(lz, cnt):
                    t = tot - base
                    for v1, m in vals:
                        total += m * c.get(t - v1, 0)
                ans.append(total)
        return ans
