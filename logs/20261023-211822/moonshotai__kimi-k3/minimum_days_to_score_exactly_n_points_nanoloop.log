def minDays(n):
    T = []
    k = 1
    while k*(k+1)//2 <= n:
        T.append(k*(k+1)//2)
        k += 1
    mask = (1 << (n+1)) - 1
    A = [1]
    lt = len(T)
    D = 0
    while True:
        D += 1
        bits = (1 << T[D-1]) if D <= lt else 0
        maxk = D-1 if D-1 < lt else lt
        for kk in range(1, maxk+1):
            prev = A[D-kk-1]
            if prev:
                bits |= prev << T[kk-1]
        bits &= mask
        A.append(bits)
        if (bits >> n) & 1:
            return D

