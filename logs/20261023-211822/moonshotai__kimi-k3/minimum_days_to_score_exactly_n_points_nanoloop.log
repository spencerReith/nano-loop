```python
class Solution:
    def minDays(self, n: int) -> int:
        # triangular numbers
        T = []
        k = 1
        while True:
            t = k*(k+1)//2
            if t > n and k > 1 and t - k > n:  # need T_k up to n at least
                break
            T.append(t)
            if t > n:
                break
            k += 1
        # T[k-1] = T_k
        K = len(T)  # T_K >= n
        # bitset DP over days
        mask = (1 << (n+1)) - 1
        A = [0]  # A[D] for D=0: empty, no points: bit 0? 
        # A[0] should represent 0 points in 0 days: bit 0 set, as base for appending runs.
        A0 = 1  # bit 0 set
        A = [A0]
        for D in range(1, ...):
            bits = 1 << T_D if T_D <= n else 0  # single run of length D
            # append runs: A[D-s] << T_{s-1} for s >= 2, D-s >= 0
            for s in range(2, min(D, len(T)) + 1):
                prev = A[D-s]
                if prev:
                    bits |= prev << T[s-2]
            bits &= mask
            A.append(bits)
            if (bits >> n) & 1:
                return D
```

