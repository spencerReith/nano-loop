```python
class Solution:
    def minDays(self, n: int) -> int:
        # triangular numbers <= n
        T = []
        k = 1
        while k*(k+1)//2 <= n:
            T.append(k*(k+1)//2)
            k += 1
        # T[k-1] = k-th triangular
        mask = (1 << (n+1)) - 1
        A = [1]  # A[0]: bit 0
        D = 0
        while True:
            D += 1
            bits = 0
            if D <= len(T):
                bits = 1 << T[D-1]
            # append a run: use s = k+1 slots (1 skip + k earning days), adds T_k
            maxk = min(D-1, len(T))
            for kk in range(1, maxk+1):
                prev = A[D-kk-1]
                if prev:
                    bits |= prev << T[kk-1]
            bits &= mask
            A.append(bits)
            if (bits >> n) & 1:
                return D
```

