class Solution:
    def maxTotal(self, nums: list[int], s: str) -> int:
        n = len(nums)
        total = sum(v for v, c in zip(nums, s) if c == '1')
        moved = 0
        for i in range(1, n):
            if s[i] == '0' and s[i - 1] == '1' and nums[i] > nums[i - 1]:
                moved += nums[i] - nums[i - 1]
        return total + moved
