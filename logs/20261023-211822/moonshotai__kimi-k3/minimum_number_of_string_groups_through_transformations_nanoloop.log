from solution import Solution

def brute_groups(words):
    def transforms(s):
        e=s[0::2]; o=s[1::2]
        erot=[e[-k:]+e[:-k] for k in range(len(e))] if e else ['']
        orot=[o[-k:]+o[:-k] for k in range(len(o))] if o else ['']
        res=[]
        for ee in erot:
            for oo in orot:
                chars=[]
                for i in range(len(s)):
                    chars.append(ee[i//2] if i%2==0 else oo[i//2])
                res.append(''.join(chars))
        return res
    return len({min(transforms(w)) for w in words})

s=Solution()
print(s.minimumGroups(["ntgwz","zwntg"]), "expected", 1)
print(s.minimumGroups(["abc","cab","bac","acb","bca","cba"]), "expected", 3)
print(s.minimumGroups(["leet","abb","bab","deed","edde","code","bba"]), "expected", 5)

# extra randomized cross-check
import random
random.seed(0)
for n in range(1,8):
    for _ in range(200):
        words=[''.join(random.choice('abc') for _ in range(n)) for __ in range(random.randint(1,12))]
        got=s.minimumGroups(words)
        exp=brute_groups(words)
        if got!=exp:
            print('mismatch', words, got, exp)
            raise SystemExit
print('random ok')
```

