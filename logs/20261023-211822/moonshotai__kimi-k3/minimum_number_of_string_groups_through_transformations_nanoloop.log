```python
class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        def least_rotation(s: str) -> int:
            n = len(s)
            if n == 0:
                return 0
            ss = s + s
            i, j, k = 0, 1, 0
            while i < n and j < n and k < n:
                a = ss[i + k]
                b = ss[j + k]
                if a == b:
                    k += 1
                elif a > b:
                    i = i + k + 1
                    if i <= j:
                        i = j + 1
                    k = 0
                else:
                    j = j + k + 1
                    if j <= i:
                        j = i + 1
                    k = 0
            return i if i < j else j

        groups = set()
        for w in words:
            even = w[0::2]
            odd = w[1::2]
            ie = least_rotation(even)
            io = least_rotation(odd)
            key = (even[ie:] + even[:ie], odd[io:] + odd[:io])
            groups.add(key)
        return len(groups)
```
