Now write the code:

```python
class Solution:
    def maxTotalValue(self, value: list[int], decay: list[int], m: int) -> int:
        MOD = 10**9 + 7
        n = len(value)

        def ge(T):
            # count of gains >= T
            c = 0
            for v, d in zip(value, decay):
                if v >= T:
                    c += (v - T) // d + 1
            return c

        def sumGe(T):
            # sum of gains >= T
            s = 0
            for v, d in zip(value, decay):
                if v >= T:
                    k = (v - T) // d + 1
                    # sum of arithmetic: v + (v-d) + ... k terms
                    s += k * (2 * v - (k - 1) * d) // 2
            return s

        if ge(1) <= m:
            return sumGe(1) % MOD

        lo, hi = 1, max(value)
        # find largest T with ge(T) >= m
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if ge(mid) >= m:
                lo = mid
            else:
                hi = mid - 1
        T = lo
        cnt = ge(T + 1)
        s = sumGe(T + 1)
        ans = s + (m - cnt) * T
        return ans % MOD
```

