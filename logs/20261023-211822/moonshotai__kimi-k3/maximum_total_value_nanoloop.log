The approach:
- Each index yields a decreasing arithmetic sequence of gains, so the optimal strategy is to take the top `m` positive gains across all sequences (the prefix constraint is automatically satisfied since each sequence is decreasing).
- Binary search for the largest threshold `T` such that at least `m` gains are `>= T`.
- Take all gains `> T` (summed via arithmetic series formulas per index), then fill the remaining slots with gains equal to `T`.
- If there are fewer than `m` positive gains, just take all positive gains.

This runs in O(n log max(value)) time, which handles n = 10^5 easily.

```python
class Solution:
    def maxTotalValue(self, value: list[int], decay: list[int], m: int) -> int:
        MOD = 10**9 + 7

        def ge(T: int) -> int:
            # number of selection gains that are >= T
            c = 0
            for v, d in zip(value, decay):
                if v >= T:
                    c += (v - T) // d + 1
            return c

        def sumGe(T: int) -> int:
            # sum of selection gains that are >= T
            s = 0
            for v, d in zip(value, decay):
                if v >= T:
                    k = (v - T) // d + 1
                    # arithmetic series: v, v-d, ..., v-(k-1)d
                    s += k * (2 * v - (k - 1) * d) // 2
            return s

        # If there are at most m positive gains, take all of them.
        if ge(1) <= m:
            return sumGe(1) % MOD

        # Find the largest threshold T such that at least m gains are >= T.
        lo, hi = 1, max(value)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if ge(mid) >= m:
                lo = mid
            else:
                hi = mid - 1
        T = lo

        # Take every gain > T, then fill the remaining slots with gains equal to T.
        cnt = ge(T + 1)
        s = sumGe(T + 1)
        ans = s + (m - cnt) * T
        return ans % MOD
```
