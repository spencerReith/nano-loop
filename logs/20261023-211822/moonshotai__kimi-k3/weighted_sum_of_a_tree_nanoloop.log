Assistant: Both examples pass. The solution uses BFS to compute node depths, tracks the tree height, and then sums `nums[i] * (h - depth[i] + 1)` for all nodes. Time complexity is O(n).

```python
from collections import deque


class Solution:
    def weightedSum(self, parent: list[int], nums: list[int]) -> int:
        n = len(parent)
        children = [[] for _ in range(n)]
        for i in range(1, n):
            children[parent[i]].append(i)

        depth = [0] * n
        depth[0] = 1
        h = 1
        q = deque([0])
        while q:
            node = q.popleft()
            for child in children[node]:
                depth[child] = depth[node] + 1
                if depth[child] > h:
                    h = depth[child]
                q.append(child)

        total = 0
        for i in range(n):
            total += nums[i] * (h - depth[i] + 1)
        return total
```
