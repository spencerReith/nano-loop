class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        n = len(intervals)
        intervals.sort(key=lambda x: x[0])
        total = n * (n - 1) // 2
        disjoint = 0
        max_end_so_far = intervals[0][1]
        for i in range(1, n):
            start, end = intervals[i]
            if start > max_end_so_far:
                # This interval is disjoint from all previous intervals
                disjoint += i
            max_end_so_far = max(max_end_so_far, end)
        return total - disjoint
