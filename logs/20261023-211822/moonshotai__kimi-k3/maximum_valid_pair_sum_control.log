class Solution:
    def maxValidPairSum(self, nums: list[int], k: int) -> int:
        ans = 0
        best = nums[0]  # maximum nums[i] seen among indices that can pair with current j
        for j in range(k, len(nums)):
            ans = max(ans, best + nums[j])
            # nums[j - k + 1] becomes eligible as i for future j's
            best = max(best, nums[j - k + 1])
        return ans
