from collections import defaultdict

class Solution:
    def numberOfPairs(self, nums1: list[int], nums2: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums2)
        
        # Block size for square root decomposition
        # We choose a size that balances update and query speeds.
        # Around 256-512 works well for N=50,000.
        block_size = int(n**0.5) + 1
        
        # blocks stores the frequency of numbers in each block
        blocks = [defaultdict(int) for _ in range((n // block_size) + 1)]
        
        # lazy stores the pending addition for each block
        lazy = [0] * ((n // block_size) + 1)
        
        # Initialize blocks
        for i, val in enumerate(nums2):
            blocks[i // block_size][val] += 1
            
        # Count frequencies of nums1 since it's small and constant
        nums1_counts = defaultdict(int)
        for val in nums1:
            nums1_counts[val] += 1
            
        answers = []
        
        for q in queries:
            if q[0] == 1:
                # Update query: [1, x, y, val]
                x, y, val = q[1], q[2], q[3]
                
                b_start = x // block_size
                b_end = y // block_size
                
                if b_start == b_end:
                    # Range is within a single block: Update elements individually
                    b_idx = b_start
                    # Remove old values from block map
                    for i in range(x, y + 1):
                        real_val = nums2[i] + lazy[b_idx]
                        blocks[b_idx][real_val] -= 1
                        if blocks[b_idx][real_val] == 0:
                            del blocks[b_idx][real_val]
                    
                    # Update actual values in nums2
                    for i in range(x, y + 1):
                        nums2[i] += val
                        
                    # Add new values to block map
                    for i in range(x, y + 1):
                        real_val = nums2[i] + lazy[b_idx]
                        blocks[b_idx][real_val] += 1
                else:
                    # Range spans multiple blocks
                    
                    # 1. Update partial block at the start
                    b_idx = b_start
                    limit = (b_idx + 1) * block_size
                    # Remove
                    for i in range(x, limit):
                        real_val = nums2[i] + lazy[b_idx]
                        blocks[b_idx][real_val] -= 1
                        if blocks[b_idx][real_val] == 0:
                            del blocks[b_idx][real_val]
                    # Add
                    for i in range(x, limit):
                        nums2[i] += val
                    # Re-insert
                    for i in range(x, limit):
                        real_val = nums2[i] + lazy[b_idx]
                        blocks[b_idx][real_val] += 1
                        
                    # 2. Update partial block at the end
                    b_idx = b_end
                    limit = b_idx * block_size
                    # Remove
                    for i in range(limit, y + 1):
                        real_val = nums2[i] + lazy[b_idx]
                        blocks[b_idx][real_val] -= 1
                        if blocks[b_idx][real_val] == 0:
                            del blocks[b_idx][real_val]
                    # Add
                    for i in range(limit, y + 1):
                        nums2[i] += val
                    # Re-insert
                    for i in range(limit, y + 1):
                        real_val = nums2[i] + lazy[b_idx]
                        blocks[b_idx][real_val] += 1
                        
                    # 3. Update full blocks in between (Lazy Propagation)
                    for b in range(b_start + 1, b_end):
                        lazy[b] += val
                        
            else:
                # Compute query: [2, tot]
                tot = q[1]
                total_pairs = 0
                
                for n1_val, n1_count in nums1_counts.items():
                    target = tot - n1_val
                    
                    # Iterate through all blocks to find matches
                    for b_idx, block_map in enumerate(blocks):
                        # We want nums2[k] + lazy[b_idx] = target
                        # So we look for (target - lazy[b_idx]) in the raw map
                        needed = target - lazy[b_idx]
                        count = block_map.get(needed)
                        if count:
                            total_pairs += n1_count * count
                            
                answers.append(total_pairs)
                
        return answers
