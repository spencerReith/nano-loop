class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        from math import inf
        
        def generate(x):
            vals = {}
            vals[x] = 0
            seen = {x}
            q = [(x, 0)]
            idx = 0
            while idx < len(q):
                v, d = q[idx]
                idx += 1
                if d > 25:
                    continue
                nv = v * 2
                if nv <= sum:
                    if nv not in seen:
                        seen.add(nv)
                        vals[nv] = d + 1
                        q.append((nv, d + 1))
                nv = v // 2
                if nv not in seen:
                    seen.add(nv)
                    vals[nv] = d + 1
                    q.append((nv, d + 1))
            return list(vals.items())
        
        options = [generate(v) for v in nums]
        
        dp = [inf] * (sum + 1)
        dp[0] = 0
        for opts in options:
            new_dp = dp[:]  # not choosing this element
            for s in range(sum + 1):
                if dp[s] == inf:
                    continue
                for v, c in opts:
                    if s + v <= sum:
                        nc = dp[s] + c
                        if nc < new_dp[s + v]:
                            new_dp[s + v] = nc
            dp = new_dp
        
        return dp[sum] if dp[sum] != inf else -1
