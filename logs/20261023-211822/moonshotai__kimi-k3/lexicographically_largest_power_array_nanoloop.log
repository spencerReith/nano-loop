```
class Solution:
    def largestPower(self, nums):
        B=15; SIZE=1<<B; FULL=SIZE-1
        freq=[0]*SIZE
        for x in nums: freq[x]+=1
        n=len(nums); rem=n; active=FULL; pos=0
        ans=[n]*B
        while rem:
            for m in range(SIZE):
                c=freq[m]
                if c and (m & active)==active:
                    rem-=c; pos+=c; freq[m]=0
            if rem==0: break
            best_key=-1; best_m=0
            for m in range(SIZE):
                if freq[m]:
                    k=m & active
                    if k>best_key:
                        best_key=k; best_m=m
            # output one best_m at position pos
            lost=active ^ best_key  # active bits not present in best_m
            # set ans for lost bits to pos
            # iterate bits in lost
            l=lost
            while l:
                lb=l & -l
                b=lb.bit_length()-1
                ans[14-b]=pos
                l-=lb
            freq[best_m]-=1; rem-=1; pos+=1; active=best_key
        return ans
```
