class Solution:
    def largestPower(self, nums: list[int]) -> list[int]:
        B=15
        FULL=(1<<B)-1
        freq=[0]*(1<<B)
        for x in nums: freq[x]+=1
        rem=len(nums)
        active=FULL
        perm=[]
        while rem:
            # take all numbers containing all active bits
            for m in range(1<<B):
                c=freq[m]
                if c and (m & active)==active:
                    perm.extend([m])*c? # careful [m]*c
                    rem -= c; freq[m]=0
            if rem==0: break
            best_key=-1; best_m=0
            for m in range(1<<B):
                if freq[m]:
                    k=m & active
                    if k>best_key:
                        best_key=k; best_m=m
            freq[best_m]-=1; rem-=1; perm.append(best_m); active=best_key
        n=len(nums)
        ans=[0]*15
        for i in range(15):
            b=14-i
            j=0
            while j<n and (perm[j]>>b)&1:
                j+=1
            ans[i]=j
        return ans
```
