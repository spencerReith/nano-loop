**Approach:** Dijkstra over an expanded state space `(node, c)` where `c` is the number of consecutive trailing characters equal to `labels[node]` at the end of the path. When traversing an edge `u → v`, the new count is `c+1` if `labels[v] == labels[u]` (rejected if it exceeds `k`), otherwise it resets to `1`. The first time the target node `n-1` is popped from the heap (with any valid `c`), the distance is optimal. Complexity is `O((n·k + m·k) log(n·k))`, well within limits for `n, m ≤ 5·10⁴` and `k ≤ 50`.

```python
import heapq


class Solution:
    def shortestPath(self, n: int, edges: list[list[int]], labels: str, k: int) -> int:
        adj = [[] for _ in range(n)]
        for u, v, w in edges:
            adj[u].append((v, w))

        INF = float('inf')
        # dist[u][c] = min weight of a path from 0 to u whose label string
        # ends with exactly c consecutive copies of labels[u]
        dist = [[INF] * (k + 1) for _ in range(n)]
        dist[0][1] = 0
        heap = [(0, 0, 1)]  # (distance, node, consecutive count)

        target = n - 1
        while heap:
            d, u, c = heapq.heappop(heap)
            if d > dist[u][c]:
                continue
            if u == target:
                # Dijkstra guarantees first time we pop target (any c) is minimal
                return d
            lu = labels[u]
            for v, w in adj[u]:
                nc = c + 1 if labels[v] == lu else 1
                if nc > k:
                    continue
                nd = d + w
                if nd < dist[v][nc]:
                    dist[v][nc] = nd
                    heapq.heappush(heap, (nd, v, nc))

        return -1
```
