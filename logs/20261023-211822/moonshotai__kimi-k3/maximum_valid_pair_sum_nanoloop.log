```python
class Solution:
    def maxValidPairSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        best_left = nums[0]  # max of nums[0..j-k]
        ans = float('-inf')
        for j in range(k, n):
            # indices i valid for this j: i <= j - k
            # nums[j-k] has become available now
            if nums[j - k] > best_left:
                best_left = nums[j - k]
            cur = best_left + nums[j]
            if cur > ans:
                ans = cur
        return ans
```
