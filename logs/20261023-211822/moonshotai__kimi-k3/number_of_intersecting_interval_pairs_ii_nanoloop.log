from bisect import bisect_left

class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        n=len(intervals)
        total=n*(n-1)//2
        ends=sorted({e for _, e in intervals})
        bit=[0]*(len(ends)+1)
        def add(i, v=1):
            while i < len(bit):
                bit[i]+=v
                i += i & -i
        def sum_(i):
            s=0
            while i>0:
                s+=bit[i]
                i-=i&-i
            return s
        disjoint=0
        for s,e in sorted(intervals, key=lambda x: (x[0], x[1])):
            k=bisect_left(ends, s) # number of distinct end values < s
            disjoint += sum_(k)
            add(bisect_left(ends,e)+1,1)
        return total-disjoint

