from collections import deque

class Solution:
    def weightedSum(self, parent: list[int], nums: list[int]) -> int:
        n = len(parent)
        children = [[] for _ in range(n)]
        for i in range(1, n):
            children[parent[i]].append(i)

        depth = [0] * n
        q = deque([0])
        depth[0] = 1
        h = 1

        while q:
            node = q.popleft()
            d = depth[node]
            h = max(h, d)
            for child in children[node]:
                depth[child] = d + 1
                q.append(child)

        total = 0
        for i in range(n):
            total += nums[i] * (h - depth[i] + 1)
        return total
