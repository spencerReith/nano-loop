class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        if n == 0:
            return 0

        # Difference array to compute total boost (bonus) at each index
        diff = [0] * (n + 1)
        for l, r, v in boosts:
            diff[l] += v
            diff[r + 1] -= v

        bonus = [0] * n
        cur = 0
        for i in range(n):
            cur += diff[i]
            bonus[i] = cur

        # Binary search minimum initial strength x in [0, sum(monsters)]
        lo, hi = 0, sum(monsters)

        def can_win(x: int) -> bool:
            strength = x
            for i in range(n):
                if strength + bonus[i] < monsters[i]:
                    return False
                strength = max(0, strength - monsters[i])
            return True

        while lo < hi:
            mid = (lo + hi) // 2
            if can_win(mid):
                hi = mid
            else:
                lo = mid + 1

        return lo
