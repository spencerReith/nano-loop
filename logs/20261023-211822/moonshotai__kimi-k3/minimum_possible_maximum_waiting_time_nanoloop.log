```python
def brute(demand, fuel):
    best_served = 0
    best_wait = None
    # enumerate all decision paths
    def rec(i, f0, f1, t0, t1, a, waits):
        nonlocal best_served, best_wait
        # i = next car index, a = allowed time
        if i == len(demand):
            served = i
            mx = max(waits) if waits else 0
            update(served, mx)
            return
        d = demand[i]
        valid = []
        if f0 >= d: valid.append(0)
        if f1 >= d: valid.append(1)
        if not valid:
            served = i
            mx = max(waits) if waits else 0
            update(served, mx)
            return
        for j in valid:
            if j == 0:
                s = max(a, t0)
                rec(i+1, f0-d, f1, s+d, t1, s, waits + [s-a])
            else:
                s = max(a, t1)
                rec(i+1, f0, f1-d, t0, s+d, s, waits + [s-a])
    def update(served, mx):
        nonlocal best_served, best_wait
        if served > best_served:
            best_served = served
            best_wait = mx
        elif served == best_served:
            if mx < best_wait:
                best_wait = mx
    rec(0, fuel[0], fuel[1], 0, 0, 0, [])
    if best_served == 0:
        return -1
    return best_wait
```

