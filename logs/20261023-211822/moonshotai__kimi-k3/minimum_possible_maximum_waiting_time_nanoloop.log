class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        # Step 1: maximize the number of served cars.
        # Cars are served in order, so this is the longest prefix that can be served.
        states = {(fuel[0], fuel[1])}
        K = 0
        for d in demand:
            nxt = set()
            for f0, f1 in states:
                if f0 >= d:
                    nxt.add((f0 - d, f1))
                if f1 >= d:
                    nxt.add((f0, f1 - d))
            if not nxt:
                break
            states = nxt
            K += 1
        if K == 0:
            return -1

        # Step 2: smallest W such that the first K cars can all be served
        # with every waiting time <= W. Any wait is at most max(demand), so
        # W = max(demand) is always feasible.
        max_d = max(demand)
        for W in range(max_d + 1):
            if self._feasible(demand, fuel, K, W):
                return W
        return max_d  # unreachable

    def _feasible(self, demand, fuel, K, W):
        # State: (f0, f1, u0, u1)
        #   fj = remaining fuel of dispenser j
        #   uj = max(0, free_time_j - current_allowed_time)
        # uj never exceeds the demand of the last car served on dispenser j (<= 20),
        # because start times are non-decreasing in car index.
        states = {(fuel[0], fuel[1], 0, 0)}
        for i in range(K):
            d = demand[i]
            nxt = set()
            for f0, f1, u0, u1 in states:
                if f0 >= d and u0 <= W:
                    nxt.add((f0 - d, f1, d, u1 - u0 if u1 > u0 else 0))
                if f1 >= d and u1 <= W:
                    nxt.add((f0, f1 - d, u0 - u1 if u0 > u1 else 0, d))
            if not nxt:
                return False
            states = nxt
        return True
