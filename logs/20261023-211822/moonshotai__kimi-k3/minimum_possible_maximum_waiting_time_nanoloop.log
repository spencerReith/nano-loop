```python
class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        # Step 1: max number of served cars
        states = {(fuel[0], fuel[1])}
        K = 0
        for d in demand:
            new_states = set()
            for f0, f1 in states:
                if f0 >= d:
                    new_states.add((f0 - d, f1))
                if f1 >= d:
                    new_states.add((f0, f1 - d))
            if not new_states:
                break
            states = new_states
            K += 1
        if K == 0:
            return -1
        
        # Step 2: find min W such that first K cars can be served with all waits <= W
        maxD = max(demand)
        for W in range(0, maxD + 1):
            if self.feasible(demand, fuel, K, W):
                return W
        return maxD  # should not happen
    
    def feasible(self, demand, fuel, K, W):
        # state: (f0, f1, u0, u1)
        states = {(fuel[0], fuel[1], 0, 0)}
        for i in range(K):
            d = demand[i]
            new_states = set()
            for f0, f1, u0, u1 in states:
                if f0 >= d and u0 <= W:
                    new_states.add((f0 - d, f1, d, max(0, u1 - u0)))
                if f1 >= d and u1 <= W:
                    new_states.add((f0, f1 - d, max(0, u0 - u1), d))
            if not new_states:
                return False
            states = new_states
        return True
```

