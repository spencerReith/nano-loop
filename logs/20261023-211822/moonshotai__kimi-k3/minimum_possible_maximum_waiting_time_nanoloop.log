```python
class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        # Step 1: maximize number of served cars.
        states = {(fuel[0], fuel[1])}
        K = 0
        for d in demand:
            nxt = set()
            for f0, f1 in states:
                if f0 >= d:
                    nxt.add((f0 - d, f1))
                if f1 >= d:
                    nxt.add((f0, f1 - d))
            if not nxt:
                break
            states = nxt
            K += 1
        if K == 0:
            return -1

        # Step 2: smallest W in [0, max(demand)] such that the first K cars
        # can all be served with every waiting time <= W.
        max_d = max(demand)
        for W in range(max_d + 1):
            if self._feasible(demand, fuel, K, W):
                return W
        return max_d  # unreachable: W = max_d always works

    def _feasible(self, demand, fuel, K, W):
        # State: (f0, f1, u0, u1)
        # fj = remaining fuel of dispenser j
        # uj = max(0, free_time_j - current_allowed_time), always <= max demand
        states = {(fuel[0], fuel[1], 0, 0)}
        for i in range(K):
            d = demand[i]
            nxt = set()
            for f0, f1, u0, u1 in states:
                if f0 >= d and u0 <= W:
                    nxt.add((f0 - d, f1, d, u1 - u0 if u1 > u0 else 0))
                if f1 >= d and u1 <= W:
                    nxt.add((f0, f1 - d, u0 - u1 if u0 > u1 else 0, d))
            if not nxt:
                return False
            states = nxt
        return True
```

