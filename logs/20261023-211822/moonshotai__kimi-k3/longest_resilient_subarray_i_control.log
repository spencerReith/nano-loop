class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        res = [x % k for x in nums]
        best = 1
        for i in range(n):
            r = res[i]
            # max possible length from i is n - i; if <= best, skip? Actually still need to check, but can't beat best.
            if n - i <= best:
                break  # since i increasing, n-i decreasing; no better possible
            for j in range(i, n):
                if res[j] != r:
                    break
                length = j - i + 1
                if (length - 1) * r % k == 0 and length > best:
                    best = length
        return best
```

