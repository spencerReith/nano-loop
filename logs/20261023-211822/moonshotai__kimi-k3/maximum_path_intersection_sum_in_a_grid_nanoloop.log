```python
class Solution:
    def maxScore(self, grid: list[list[int]]) -> int:
        m = len(grid)
        n = len(grid[0])
        ans = -10**18
        # horizontal segments (length >= 2)
        for r in range(m):
            row = grid[r]
            f = row[0] + row[1]
            if f > ans: ans = f
            for j in range(1, n - 1):
                f = max(row[j] + row[j+1], f + row[j+1])
                if f > ans: ans = f
        # vertical segments (length >= 2)
        for c in range(n):
            f = grid[0][c] + grid[1][c]
            if f > ans: ans = f
            for i in range(1, m - 1):
                f = max(grid[i][c] + grid[i+1][c], f + grid[i+1][c])
                if f > ans: ans = f
        # interior single cells
        for r in range(1, m - 1):
            row = grid[r]
            for c in range(1, n - 1):
                if row[c] > ans: ans = row[c]
        return ans
```

