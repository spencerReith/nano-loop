from itertools import combinations

def paths_p1(m, n):
    # from (0,0) to (m-1,n-1), moves R/D
    # represent as list of cells
    res = []
    def rec(r, c, path):
        if r == m-1 and c == n-1:
            res.append(tuple(path))
            return
        if r+1 <= m-1:
            rec(r+1, c, path+[(r+1,c)])
        if c+1 <= n-1:
            rec(r, c+1, path+[(r,c+1)])
    rec(0,0,[(0,0)])
    return res

def paths_p2(m, n):
    # from (m-1,0) to (0,n-1), moves R/U
    res = []
    def rec(r, c, path):
        if r == 0 and c == n-1:
            res.append(tuple(path))
            return
        if r-1 >= 0:
            rec(r-1, c, path+[(r-1,c)])
        if c+1 <= n-1:
            rec(r, c+1, path+[(r,c+1)])
    rec(m-1,0,[(m-1,0)])
    return res
```

