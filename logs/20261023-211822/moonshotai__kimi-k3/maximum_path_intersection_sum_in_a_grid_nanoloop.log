The solution is O(m·n), well within limits for m·n ≤ 5·10⁵.

```python
class Solution:
    def maxScore(self, grid: list[list[int]]) -> int:
        m = len(grid)
        n = len(grid[0])
        ans = -10**18
        # horizontal segments (contiguous, length >= 2) in each row
        for r in range(m):
            row = grid[r]
            f = row[0] + row[1]  # best sum of subarray ending at index 1 with len>=2
            if f > ans:
                ans = f
            for j in range(1, n - 1):
                f = max(row[j] + row[j + 1], f + row[j + 1])
                if f > ans:
                    ans = f
        # vertical segments (contiguous, length >= 2) in each column
        for c in range(n):
            f = grid[0][c] + grid[1][c]
            if f > ans:
                ans = f
            for i in range(1, m - 1):
                f = max(grid[i][c] + grid[i + 1][c], f + grid[i + 1][c])
                if f > ans:
                    ans = f
        # single cells, only strictly interior cells are achievable
        for r in range(1, m - 1):
            row = grid[r]
            for c in range(1, n - 1):
                if row[c] > ans:
                    ans = row[c]
        return ans
```
