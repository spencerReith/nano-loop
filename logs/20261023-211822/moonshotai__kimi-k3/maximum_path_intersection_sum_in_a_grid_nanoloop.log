```python
class Solution:
    def maxScore(self, grid):
        m = len(grid)
        n = len(grid[0])
        NEG = float('-inf')
        ans = NEG
        # horizontal segments: max subarray sum with len >= 2 in each row
        for r in range(m):
            row = grid[r]
            f = row[0] + row[1]  # best sum of subarray ending at current index with len>=2
            ans = max(ans, f)
            for j in range(1, n-1):
                f = max(row[j] + row[j+1], f + row[j+1])
                ans = max(ans, f)
        # vertical segments: max subarray sum with len >= 2 in each column
        for c in range(n):
            f = grid[0][c] + grid[1][c]
            ans = max(ans, f)
            for i in range(1, m-1):
                f = max(grid[i][c] + grid[i+1][c], f + grid[i+1][c])
                ans = max(ans, f)
        # interior single cells
        if m >= 3 and n >= 3:
            for r in range(1, m-1):
                row = grid[r]
                for c in range(1, n-1):
                    if row[c] > ans:
                        ans = row[c]
        return ans
```

