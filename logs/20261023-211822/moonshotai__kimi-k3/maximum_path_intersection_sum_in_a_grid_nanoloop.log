from solution import Solution
import random, itertools

def gen_paths(m, n, second=False):
    paths = []
    if not second:
        start, end, moves = (0,0), (m-1,n-1), ((1,0),(0,1))
    else:
        start, end, moves = (m-1,0), (0,n-1), ((-1,0),(0,1))
    def rec(r, c, path):
        if (r,c) == end:
            paths.append(tuple(path)); return
        for dr, dc in moves:
            nr, nc = r+dr, c+dc
            if 0 <= nr < m and 0 <= nc < n:
                path.append((nr,nc)); rec(nr,nc,path); path.pop()
    rec(*start, [start])
    return paths

def brute(grid):
    m, n = len(grid), len(grid[0])
    P1 = gen_paths(m,n,False); P2 = gen_paths(m,n,True)
    best = None
    achievable = set()
    for p1 in P1:
        s1 = set(p1)
        for p2 in P2:
            inter = frozenset(s1 & set(p2))
            achievable.add(inter)
            s = sum(grid[r][c] for r,c in inter)
            if best is None or s > best: best = s
    return best, achievable
```

