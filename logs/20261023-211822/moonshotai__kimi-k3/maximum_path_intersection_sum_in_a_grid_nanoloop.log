```python
from itertools import product
import random

def gen_paths(m, n, start, moves):
    # moves: list of (dr, dc)
    paths = []
    stack = [(start, [start])]
    # recursive
    def rec(r, c, path):
        if (moves == [(0,1),(1,0)] and r == m-1 and c == n-1) or (moves == [(0,1),(-1,0)] and r == 0 and c == n-1):
            paths.append(path[:])
            return
        for dr, dc in moves:
            nr, nc = r+dr, c+dc
            if 0 <= nr < m and 0 <= nc < n:
                path.append((nr,nc))
                rec(nr, nc, path)
                path.pop()
    rec(start[0], start[1], [start])
    return paths
```

