```python
import numpy as np

class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        S = sum
        INF = 10**9
        dp = np.full(S + 1, INF, dtype=np.int64)
        dp[0] = 0
        for x in nums:
            # compute options: value -> min cost
            opts = {}
            p = x
            k = 0
            while p:
                v = p
                j = k
                while v <= S:
                    if v not in opts or j < opts[v]:
                        opts[v] = j
                    v <<= 1
                    j += 1
                p >>= 1
                k += 1
            nd = dp.copy()
            base = dp
            for v, c in opts.items():
                shifted = base[:S + 1 - v] + c
                tgt = nd[v:]
                np.minimum(tgt, shifted, out=tgt)
            dp = nd
        ans = int(dp[S])
        return -1 if ans >= INF else ans
```

