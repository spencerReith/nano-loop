```python
from itertools import product
from collections import deque

def brute(nums, S):
    # per item reachable (value->cost) via BFS with value cap S and also cost cap
    allopts = []
    for x in nums:
        dist = {x: 0}
        dq = deque([x])
        while dq:
            u = dq.popleft()
            for w in (u*2, u//2):
                if w <= S*2 and w not in dist:  # cap: allow up to 2S to be safe? for validation of option costs up to S, cap S is fine? paths exceeding S... we argued never beneficial; brute with cap 2S validates
                    dist[w] = dist[u] + 1
                    dq.append(w)
        opts = {}
        for v, c in dist.items():
            if v <= S:
                if v not in opts or c < opts[v]: opts[v] = c
        allopts.append(opts)
    best = float('inf')
    # subset: each item either skipped or one option
    def rec(i, s, c):
        nonlocal best
        if s == S:
            best = min(best, c); return
        if i == len(nums) or s > S or c >= best: return
        rec(i+1, s, c)
        for v, cc in allopts[i].items():
            if v > 0 and s + v <= S:
                rec(i+1, s+v, c+cc)
    rec(0,0,0)
    return -1 if best == float('inf') else best
```

