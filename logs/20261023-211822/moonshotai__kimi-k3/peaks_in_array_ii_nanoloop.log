```python
class Fenwick:
    __slots__ = ('n', 'bit')

    def __init__(self, n):
        self.n = n
        self.bit = [0] * (n + 1)

    def add(self, i, delta):
        i += 1
        n = self.n
        bit = self.bit
        while i <= n:
            bit[i] += delta
            i += i & -i

    def sum(self, i):
        # prefix sum over indices [0, i]
        i += 1
        s = 0
        bit = self.bit
        while i > 0:
            s += bit[i]
            i -= i & -i
        return s

    def kth(self, k):
        # smallest 0-based index i with prefix sum >= k (k >= 1)
        idx = 0
        step = 1 << (self.n.bit_length() - 1)
        bit = self.bit
        while step:
            nxt = idx + step
            if nxt <= self.n and bit[nxt] < k:
                idx = nxt
                k -= bit[nxt]
            step >>= 1
        return idx  # 0-based position


class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums)

        def C2(x):
            return x * (x - 1) // 2

        is_peak = [False] * n
        for i in range(1, n - 1):
            if nums[i] > nums[i - 1] and nums[i] > nums[i + 1]:
                is_peak[i] = True

        cntBit = Fenwick(n)
        wBit = Fenwick(n)

        prev = -1
        for i in range(n):
            if is_peak[i]:
                cntBit.add(i, 1)
                wBit.add(i, 0 if prev == -1 else C2(i - prev))
                prev = i

        def pred_peak(i):
            # largest peak index < i, or -1
            c = cntBit.sum(i - 1)
            if c == 0:
                return -1
            return cntBit.kth(c)

        def succ_peak(i):
            # smallest peak index > i, or -1
            c = cntBit.sum(i)
            if cntBit.sum(n - 1) == c:
                return -1
            return cntBit.kth(c + 1)

        def add_peak(i):
            p = pred_peak(i)
            s = succ_peak(i)
            cntBit.add(i, 1)
            wBit.add(i, 0 if p == -1 else C2(i - p))
            if s != -1:
                old = C2(s - p) if p != -1 else 0
                wBit.add(s, C2(s - i) - old)

        def remove_peak(i):
            p = pred_peak(i)
            s = succ_peak(i)
            cntBit.add(i, -1)
            wBit.add(i, -(0 if p == -1 else C2(i - p)))
            if s != -1:
                old = C2(s - i)
                new = C2(s - p) if p != -1 else 0
                wBit.add(s, new - old)

        ans = []
        for q in queries:
            if q[0] == 2:
                idx, val = q[1], q[2]
                if nums[idx] == val:
                    continue
                nums[idx] = val
                for j in (idx - 1, idx, idx + 1):
                    if 1 <= j <= n - 2:
                        now = nums[j] > nums[j - 1] and nums[j] > nums[j + 1]
                        if now and not is_peak[j]:
                            is_peak[j] = True
                            add_peak(j)
                        elif not now and is_peak[j]:
                            is_peak[j] = False
                            remove_peak(j)
            else:
                l, r = q[1], q[2]
                total = C2(r - l)  # subarrays of length >= 3 in [l, r]
                c_l = cntBit.sum(l)
                c_r = cntBit.sum(r - 1)
                cnt = c_r - c_l  # peaks strictly inside (l, r)
                if cnt == 0:
                    ans.append(0)
                    continue
                f = cntBit.kth(c_l + 1)   # first peak in (l, r)
                last = cntBit.kth(c_r)    # last peak in (l, r)
                sumW = wBit.sum(r - 1) - wBit.sum(l)
                p = pred_peak(f)
                wf = 0 if p == -1 else C2(f - p)
                internal = sumW - wf      # sum of C2(gap) between consecutive peaks inside
                nopeak = C2(f - l) + internal + C2(r - last)
                ans.append(total - nopeak)
        return ans
