class Solution:
    def countOfPeaks(self, nums, queries):
        n = len(nums)
        is_peak = [False]*n
        for i in range(1, n-1):
            if nums[i] > nums[i-1] and nums[i] > nums[i+1]:
                is_peak[i] = True
        cntBit = Fenwick(n)
        wBit = Fenwick(n)
        def C2(x):
            return x*(x-1)//2
        # initialize: iterate peaks in order, weight = C2(p - prev)
        prev = -1  # none
        for i in range(n):
            if is_peak[i]:
                cntBit.add(i, 1)
                w = 0 if prev == -1 else C2(i - prev)
                wBit.add(i, w)
                prev = i
        def pred_peak(i):
            # largest peak index < i, or -1
            c = cntBit.sum(i-1)
            if c == 0:
                return -1
            return cntBit.kth(c)
        def succ_peak(i):
            # smallest peak index > i, or -1
            c = cntBit.sum(i)
            total = cntBit.sum(n-1)
            if c == total:
                return -1
            return cntBit.kth(c+1)
        def add_peak(i):
            p = pred_peak(i)
            s = succ_peak(i)
            cntBit.add(i, 1)
            wBit.add(i, 0 if p == -1 else C2(i - p))
            if s != -1:
                old = C2(s - p) if p != -1 else 0  # old weight of s
                new = C2(s - i)
                wBit.add(s, new - old)
        def remove_peak(i):
            p = pred_peak(i)
            s = succ_peak(i)
            cntBit.add(i, -1)
            wBit.add(i, -(0 if p == -1 else C2(i - p)))
            if s != -1:
                old = C2(s - i)
                new = C2(s - p) if p != -1 else 0
                wBit.add(s, new - old)
        ans = []
        for q in queries:
            if q[0] == 2:
                _, idx, val = q
                if nums[idx] == val:
                    continue
                nums[idx] = val
                # recompute peak status for idx-1, idx, idx+1
                for j in (idx-1, idx, idx+1):
                    if 1 <= j <= n-2:
                        now = nums[j] > nums[j-1] and nums[j] > nums[j+1]
                        if now and not is_peak[j]:
                            is_peak[j] = True
                            add_peak(j)
                        elif not now and is_peak[j]:
                            is_peak[j] = False
                            remove_peak(j)
            else:
                _, l, r = q
                total = C2(r - l)
                cnt = cntBit.sum(r-1) - cntBit.sum(l)
                if cnt == 0:
                    ans.append(0)
                    continue
                f = cntBit.kth(cntBit.sum(l) + 1)
                last = cntBit.kth(cntBit.sum(r-1))
                sumW = wBit.sum(r-1) - wBit.sum(l)
                p = pred_peak(f)  # could be l itself if l is peak, or less
                wf = 0 if p == -1 else C2(f - p)
                internal = sumW - wf
                nopeak = C2(f - l) + internal + C2(r - last)
                ans.append(total - nopeak)
        return ans
```

