```python
class Fenwick:
    def __init__(self, n):
        self.n = n
        self.bit = [0]*(n+1)
    def add(self, i, delta):  # i in [0, n-1]
        i += 1
        while i <= self.n:
            self.bit[i] += delta
            i += i & -i
    def sum(self, i):  # prefix [0, i]
        i += 1
        s = 0
        while i > 0:
            s += self.bit[i]
            i -= i & -i
        return s
    def kth(self, k):  # smallest i such that prefix sum >= k, assumes k >= 1
        idx = 0
        step = 1 << (self.n.bit_length())
        while step:
            nxt = idx + step
            if nxt <= self.n and self.bit[nxt] < k:
                idx = nxt
                k -= self.bit[nxt]
            step >>= 1
        return idx  # 0-based index = idx (since idx is count of elements passed) 
```

Standard: after loop, idx is largest with prefix < k, so answer position (1-based) is idx+1, 0-based is idx. Returns idx (0-based). Good.

