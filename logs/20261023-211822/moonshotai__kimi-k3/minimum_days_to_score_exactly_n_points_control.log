import math

class Solution:
    def minDays(self, n: int) -> int:
        best = float('inf')
        # Consider streaks of length up to k where T_k >= n, plus a small margin
        # for cases where overshooting by a little leads to a better answer.
        max_k = int((math.isqrt(8 * n + 1) - 1) // 2) + 5
        for k in range(1, max_k + 2):
            T = k * (k + 1) // 2
            if T < n:
                # We can always add another streak, so this won't beat
                # simply continuing, but keep scanning anyway.
                continue
            d = T - n
            if d == 0:
                best = min(best, k)
            elif d == 1:
                # Removing the 1-point contribution is impossible without
                # breaking the streak, so add a skipped day and restart.
                best = min(best, k + 2)
            elif d == k:
                # Restart the streak to drop the entire k-point last day.
                best = min(best, k + 1)
            else:
                # Skip day T - d (contribution k - d), then restart for the
                # final k-point day. Total: (k - d) + 1 + d = k + 1 days.
                best = min(best, k + 1)
        return best
