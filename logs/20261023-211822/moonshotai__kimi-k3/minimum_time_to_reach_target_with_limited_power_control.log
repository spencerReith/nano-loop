import heapq
from collections import defaultdict


class Solution:
    def minTimeMaxPower(self, n: int, edges: list[list[int]], power: int, cost: list[int], source: int, target: int) -> list[int]:
        if source == target:
            return [0, power]

        adj = defaultdict(list)
        for u, v, t in edges:
            adj[u].append((v, t))

        INF = float('inf')
        dist = [[INF] * (power + 1) for _ in range(n)]

        pq = [(0, power, source)]
        dist[source][power] = 0

        while pq:
            d, p, u = heapq.heappop(pq)
            if d != dist[u][p]:
                continue
            if p < cost[u]:
                continue
            np_ = p - cost[u]
            for v, t in adj[u]:
                nd = d + t
                if nd < dist[v][np_]:
                    dist[v][np_] = nd
                    heapq.heappush(pq, (nd, np_, v))

        best_time = min(dist[target])
        if best_time == INF:
            return [-1, -1]
        best_power = max(p for p in range(power + 1) if dist[target][p] == best_time)
        return [best_time, best_power]
