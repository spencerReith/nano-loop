class Solution:
    def minCost(self, m: int, n: int, penalty: list[list[int]]) -> int:
        total = m * n

        def entry(idx: int) -> int:
            i = idx // n
            j = idx - i * n
            return (i + 1) * (j + 1)

        dist = [10**30] * total
        start = 0
        target = total - 1
        dist[start] = 1

        heap = [(1, start, 1)]

        while heap:
            d, u, parity = heapq.heappop(heap)
            if u == target:
                return d
            if d != dist[u]:
                continue

            i = u // n
            j = u - i * n
            next_parity = 1 - parity

            # Wait (cost paid now, destination cost not paid again)
            nd = d + penalty[i][j]
            if nd < dist[u]:
                dist[u] = nd
                heapq.heappush(heap, (nd, u, next_parity))

            # Down
            if i + 1 < m:
                v = u + n
                nd = d + entry(v)
                if parity == 0:
                    nd += penalty[i][j]
                if nd < dist[v]:
                    dist[v] = nd
                    heapq.heappush(heap, (nd, v, next_parity))

            # Up
            if i > 0:
                v = u - n
                nd = d + entry(v)
                if parity == 1:
                    nd += penalty[i][j]
                if nd < dist[v]:
                    dist[v] = nd
                    heapq.heappush(heap, (nd, v, next_parity))

            # Right
            if j + 1 < n:
                v = u + 1
                nd = d + entry(v)
                if parity == 0:
                    nd += penalty[i][j]
                if nd < dist[v]:
                    dist[v] = nd
                    heapq.heappush(heap, (nd, v, next_parity))

            # Left
            if j > 0:
                v = u - 1
                nd = d + entry(v)
                if parity == 1:
                    nd += penalty[i][j]
                if nd < dist[v]:
                    dist[v] = nd
                    heapq.heappush(heap, (nd, v, next_parity))

        return dist[target]
