class Solution:
    def passwordStrength(self, password: str) -> int:
        strength = 0
        seen = set(password)
        for ch in seen:
            if ch.islower():
                strength += 1
            elif ch.isupper():
                strength += 2
            elif ch.isdigit():
                strength += 3
            else:
                strength += 5
        return strength
