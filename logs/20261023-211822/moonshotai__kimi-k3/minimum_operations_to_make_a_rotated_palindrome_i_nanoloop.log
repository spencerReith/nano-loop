class Solution:
    def minOperations(self, s: str) -> int:
        n = len(s)
        ans = float('inf')

        # Try each possible final left rotation.
        for rot in range(n):
            increments = 0

            # After rot left rotations, position i contains s[(rot + i) % n].
            for i in range(n // 2):
                left = ord(s[(rot + i) % n])
                right = ord(s[(rot + n - 1 - i) % n])

                # Both letters may only be incremented cyclically. The cheapest
                # way to make them equal is to advance `left` until it reaches
                # `right` (wrapping from 'z' to 'a' if needed).
                increments += (right - left) % 26

            ans = min(ans, rot + increments)

        return ans
```
