```python
from collections import Counter

class Solution:
    def getLength(self, nums: list[int]) -> int:
        n = len(nums)
        best = 1
        for start in range(n):
            counts = Counter()
            freqOfFreq = Counter()
            distinct = 0
            for end in range(start, n):
                v = nums[end]
                old = counts[v]
                if old > 0:
                    freqOfFreq[old] -= 1
                    if freqOfFreq[old] == 0:
                        del freqOfFreq[old]
                else:
                    distinct += 1
                counts[v] = old + 1
                freqOfFreq[old + 1] += 1
                
                length = end - start + 1
                if length <= best:
                    continue
                if distinct == 1:
                    best = length
                elif len(freqOfFreq) == 2:
                    a, b = freqOfFreq.keys()
                    if a * 2 == b or b * 2 == a:
                        best = length
        return best
```

Wait, there's a subtle issue: when distinct == 1, freqOfFreq has one key. When distinct >= 2, we need exactly {f, 2f}. The check `len(freqOfFreq) == 2` and one key is double the other handles it.

