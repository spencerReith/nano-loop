```python
from collections import Counter


class Solution:
    def getLength(self, nums: list[int]) -> int:
        n = len(nums)
        best = 1
        for start in range(n):
            counts = Counter()       # value -> occurrences in window
            freq_of_freq = Counter() # occurrence count -> how many distinct values have it
            distinct = 0
            for end in range(start, n):
                v = nums[end]
                old = counts[v]
                if old > 0:
                    freq_of_freq[old] -= 1
                    if freq_of_freq[old] == 0:
                        del freq_of_freq[old]
                else:
                    distinct += 1
                counts[v] = old + 1
                freq_of_freq[old + 1] += 1

                length = end - start + 1
                if length <= best:
                    continue
                if distinct == 1:
                    best = length
                elif len(freq_of_freq) == 2:
                    a, b = freq_of_freq.keys()
                    if a * 2 == b or b * 2 == a:
                        best = length
        return best
```