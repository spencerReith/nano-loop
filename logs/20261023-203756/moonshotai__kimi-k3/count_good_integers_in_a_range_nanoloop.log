from functools import lru_cache

class Solution:
    def goodIntegers(self, l: int, r: int, k: int) -> int:
        def count_upto(n: int) -> int:
            if n < 0:
                return 0
            digits = tuple(map(int, str(n)))
            m = len(digits)

            @lru_cache(maxsize=None)
            def dp(pos: int, prev: int, tight: bool, started: bool) -> int:
                if pos == m:
                    # Counts 0 as good too; it cancels in count_upto(r)-count_upto(l-1)
                    return 1

                limit = digits[pos] if tight else 9
                total = 0
                for d in range(limit + 1):
                    ntight = tight and d == limit
                    if not started and d == 0:
                        total += dp(pos + 1, -1, ntight, False)
                    else:
                        if started and abs(d - prev) > k:
                            continue
                        total += dp(pos + 1, d, ntight, True)
                return total

            return dp(0, -1, True, False)

        return count_upto(r) - count_upto(l - 1)
