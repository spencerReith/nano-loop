class Solution:
    def lastVisitedCell(self, grid: list[list[str]]) -> list[int]:
        m, n = len(grid), len(grid[0])
        r, c = 0, 0
        visited = [[False] * n for _ in range(m)]
        visited[0][0] = True

        while True:
            d = grid[r][c]
            if d == 'L':
                nr, nc = r, c - 1
            elif d == 'R':
                nr, nc = r, c + 1
            elif d == 'U':
                nr, nc = r - 1, c
            else:  # 'D'
                nr, nc = r + 1, c

            if nr < 0 or nr >= m or nc < 0 or nc >= n or visited[nr][nc]:
                break

            visited[nr][nc] = True
            r, c = nr, nc

        return [r, c]
```