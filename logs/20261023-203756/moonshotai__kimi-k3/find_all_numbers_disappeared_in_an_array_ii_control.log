class Solution:
    def findDisappearedNumbers(self, nums: list[int], lower: int, upper: int) -> list[list[int]]:
        # Collect uniqueLoss of ranges missing from [lower, upper].
        present = set()
        for x in nums:
            if lower <= x <= upper:
                present.add(x)

        result = []
        start = None

        for num in range(lower, upper + 2):
            if num <= upper and num in present:
                if start is not None:
                    result.append([start, num - 1])
                    start = None
            else:
                if start is None:
                    start = num

        return result
