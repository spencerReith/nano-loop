from bisect import bisect_left

class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        """
        Total earnings for a selected chain i1 < i2 < ... < ik (by time):

            sum(revenue) + sum(start_{j+1} - end_j)

          = sum over meetings of (revenue - end) + (start of last)

        Define val[i] = revenue_i - end_i.  The answer is

            max over chains of ( sum val[i] + start_last )

        Sweep meetings in order of start time.  For a meeting j, the best
        chain value among chains that can be followed by j (all its meetings
        end <= start_j) is some prefix maximum over end time of

            best[i] = sum(val of best chain ending exactly at meeting i).

        Then best[j] = val[j] + max(0, prefixMax(start_j)).
        Answer = max over j of best[j] + start_j  (j is the last meeting).
        """
        n = len(meetings)
        by_start = sorted(meetings, key=lambda m: (m[0], m[1]))
        by_end   = sorted(meetings, key=lambda m: (m[1], m[0]))

        ends = [m[1] for m in by_end]          # sorted end times
        pref = [0] * n                          # prefix max of `best` over by_end
        best = [0] * n                          # best chain value ending at each by_end meeting
        cur_max = 0
        for i, (s, e, r) in enumerate(by_end):
            # best chain ending exactly at meeting i: just itself, or extend
            # the best chain whose last meeting ends <= s.
            k = bisect_left(ends, s) - 1
            extend = pref[k] if k >= 0 else 0
            best[i] = r - e + max(0, extend)
            cur_max = max(cur_max, best[i])
            pref[i] = cur_max

        ans = 0
        pe = 0  # pointer into by_end for meetings with end <= current start
        running = 0
        for s, e, r in by_start:
            while pe < n and by_end[pe][1] <= s:
                running = max(running, pref[pe])
                pe += 1
            # chain ending with this meeting contributes  best_chain + s
            cand = max(running, r - e) + s
            if cand > ans:
                ans = cand
        return ans
