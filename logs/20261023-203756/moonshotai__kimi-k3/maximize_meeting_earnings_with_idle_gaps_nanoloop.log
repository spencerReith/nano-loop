Assistant: All examples and sanity checks pass. The solution is O(n log n): sort meetings by start time, sweep with a pointer over meetings sorted by end time, maintaining the best value of `dp[j] - end_j` among meetings that can precede the current one.

```python
class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        n = len(meetings)
        # Process meetings in increasing start time.
        idx = sorted(range(n), key=lambda i: meetings[i][0])
        # Pointer over meetings sorted by end time.
        end_order = sorted(range(n), key=lambda i: meetings[i][1])

        dp = [0] * n  # dp[i]: best total of a selection whose last meeting is i
        best = None   # max of (dp[j] - end_j) over meetings with end_j <= current start
        p = 0
        ans = 0

        for i in idx:
            s, e, r = meetings[i]
            # All meetings ending at or before s can precede meeting i.
            # (Their start < end <= s, so they were already processed.)
            while p < n and meetings[end_order[p]][1] <= s:
                j = end_order[p]
                val = dp[j] - meetings[j][1]
                if best is None or val > best:
                    best = val
                p += 1
            if best is None:
                dp[i] = r
            else:
                # dp[j] + r + (s - end_j) = r + s + (dp[j] - end_j)
                dp[i] = r + s + best
            if dp[i] > ans:
                ans = dp[i]
        return ans
```