Cleaner: give each meeting an index after sorting by start. dp[i]. For by_end, store indices.

```python
class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        n = len(meetings)
        idx = sorted(range(n), key=lambda i: meetings[i][0])
        end_order = sorted(range(n), key=lambda i: meetings[i][1])
        dp = [0]*n
        best = None
        p = 0
        ans = 0
        for i in idx:
            s, e, r = meetings[i]
            while p < n and meetings[end_order[p]][1] <= s:
                j = end_order[p]
                val = dp[j] - meetings[j][1]
                if best is None or val > best:
                    best = val
                p += 1
            if best is None:
                dp[i] = r
            else:
                dp[i] = r + s + best
            if dp[i] > ans:
                ans = dp[i]
        return ans
```

