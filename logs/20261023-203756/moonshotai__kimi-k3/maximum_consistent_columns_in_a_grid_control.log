from bisect import bisect_right
from typing import List

class Solution:
    def maxConsistentColumns(self, grid: List[List[int]], limit: int) -> int:
        n = len(grid[0])
        
        # Precompute compatibility between columns in O(n^2 * m)
        compat = [[False] * n for _ in range(n)]
        for j in range(n):
            compat[j][j] = True  # Not strictly needed but keeps matrix consistent
            for k in range(j + 1, n):
                is_compat = True
                for row in grid:
                    if abs(row[k] - row[j]) > limit:
                        is_compat = False
                        break
                compat[j][k] = is_compat
        
        # dp[j] = max length of consistent subsequence ending exactly at column j
        dp = [1] * n
        for j in range(1, n):
            # Keep only compatible previous columns to avoid checking all columns
            prev_cols = [i for i in range(j) if compat[i][j]]
            
            if len(prev_cols) <= 1:
                # If 0 or 1 previous columns, just check directly
                for i in prev_cols:
                    dp[j] = max(dp[j], dp[i] + 1)
            else:
                # Find maximum dp[i] among all i in prev_cols
                max_dp = max(dp[i] for i in prev_cols)
                
                # Collect all dp values strictly less than max_dp
                values = sorted(set(dp[i] for i in prev_cols if dp[i] < max_dp))
                
                # For each dp value v from highest to lowest:
                # If we append j to a subsequence of length v, new length is v+1
                for v in range(len(values) - 1, -1, -1):
                    L = values[v] + 1
                    # We need to know: Is there a valid subsequence of length L ending at j
                    # that uses a previous column with dp value == values[v]?
                    # This is possible iff there is a subset S of prev_cols with:
                    #   - All columns in S have dp value == values[v]  (so they are mutually non-adjacent in any optimal subsequence)
                    #   - |S| >= L - 1  (we need at least L-1 columns from S to form the chain)
                    # Why? Because if dp[i] == values[v], then column i cannot be adjacent to any other column with dp value >= values[v] in any valid subsequence. 
                    # Therefore, any valid subsequence using i as the previous column must have all earlier columns with dp value < values[v].
                    # The earliest columns in any valid subsequence of length v ending at i must have dp values 1, 2, ..., v-1 (or a subset).
                    # So if we have at least L-1 columns with dp value == values[v], we can form a chain of length L-1 using only these columns,
                    # then append j to get length L.
                    if L - 1 <= len(prev_cols) - bisect_right(values, values[v]) + (1 if v < len(values) and values[v] == values[v] else 0):
                        # Simpler: count how many columns have dp value >= values[v] and <= max_dp? 
                        # Actually we need exact count of columns with dp value == values[v]
                        count = sum(1 for i in prev_cols if dp[i] == values[v])
                        if count >= L - 1:
                            dp[j] = L
                            break
                else:
                    # If no smaller dp value works, then we can only extend the maximum dp value
                    dp[j] = max_dp + 1
        
        return max(dp)
```