```python
import numpy as np
from collections import defaultdict

class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        # prefix sums mod k
        P = [0] * (n + 1)
        s = 0
        for i in range(n):
            s = (s + nums[i]) % k
            P[i + 1] = s
        
        INF = n + 1
        F = [INF] * k
        L = [-1] * k
        for idx in range(n + 1):
            v = P[idx]
            if F[v] == INF:
                F[v] = idx
            L[v] = idx
        
        # condition (a): subarray sum divisible by k
        best = 0
        for p in range(k):
            d = L[p] - F[p]
            if d > best:
                best = d
        
        # condition (b): negate one element
        # c_i = 2*nums[i] mod k; group positions by c value
        pos_by_c = defaultdict(list)
        for i in range(n):
            pos_by_c[(2 * nums[i]) % k].append(i)
        
        F_arr = np.array(F, dtype=np.int64)
        L_arr = np.array(L, dtype=np.int64)
        
        for d, pos in pos_by_c.items():
            pos_arr = np.array(pos, dtype=np.int64)
            m = pos_arr.shape[0]
            b = np.roll(L_arr, -d)          # b[p] = L[(p+d) % k]
            a = F_arr                        # a[p] = F[p]
            # first occurrence of d at position >= a
            j = np.searchsorted(pos_arr, a)  # shape (k,)
            in_range = j < m
