Let me now write the numpy solution.

```python
import numpy as np
from collections import defaultdict

class Solution:
    def longestSubarray(self, nums, k):
        n = len(nums)
        # prefix sums mod k
        P = [0] * (n + 1)
        s = 0
        for i, x in enumerate(nums):
            s = (s + x) % k
            P[i + 1] = s
        INF = n + 5
        F = [INF] * k   # first occurrence of each residue in P[0..n]
        L = [-1] * k    # last occurrence
        for idx, v in enumerate(P):
            if F[v] == INF:
                F[v] = idx
            L[v] = idx
        # condition (a): sum divisible by k
        best = 0
        for p in range(k):
            if L[p] > F[p]:
                if L[p] - F[p] > best:
                    best = L[p] - F[p]
        # condition (b)
        # c_i = 2*nums[i] % k
        by_res = defaultdict(list)
        for i, x in enumerate(nums):
            by_res[(2 * x) % k].append(i)
        
        F_arr = np.array(F, dtype=np.int64)
        L_arr = np.array(L, dtype=np.int64)
        p_idx = np.arange(k, dtype=np.int64)
        
        for d, pos in by_res.items():
            pos_arr = np.array(pos, dtype=np.int64)
            q = (p_idx + d) % k
            a = F_arr            # first occurrence of p
            b = L_arr[q]         # last occurrence of q = p + d
            # need a defined (a != INF), b defined (b != -1)
            # witness: exists occurrence in [a, b-1]
            j = np.searchsorted(pos_arr, a)   # first occurrence >= a
            m = len(pos_arr)
            jclamp = np.minimum(j, m - 1)
            occ = pos_arr[jclamp]
            ok = (a != INF) & (b >= 0) & (a <= b - 1) & (j < m) & (occ <= b - 1)
            if ok.any():
                cand = (b - a)
                cand = np.where(ok, cand, -1)
                best = max(best, int(cand.max()))
        return best
```

