```python
from math import isqrt
from collections import defaultdict

class Solution:
    def divisibleGame(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        P = [0]*(n+1)
        for i, x in enumerate(nums):
            P[i+1] = P[i] + x
        mn = min(nums)
        div_map = defaultdict(list)
        for i, x in enumerate(nums):
            if x < 2:
                continue
            r = isqrt(x)
            for d in range(2, r+1):
                if x % d == 0:
                    div_map[d].append(i)
                    q = x // d
                    if q != d:
                        div_map[q].append(i)
            div_map[x].append(i)  # x itself is a divisor >= 2
        if not div_map:
            # all elements are 1
            return (-mn * 2) % MOD
        M = None
        bestk = None
        for k in sorted(div_map):
            idxs = div_map[k]
            # indices appended in increasing i order since we iterate i ascending
            dsum = 0
            minC = 0  # will be set properly
            best = None
            first = True
            for j in idxs:
                C = 2*dsum - P[j]
                if first or C < minC:
                    minC = C
                dsum += nums[j]
                B = 2*dsum - P[j+1]
                cur = B - minC
                if best is None or cur > best:
                    best = cur
                first = False
            f = best  # >= 2 > -mn
            if M is None or f > M:
                M = f
                bestk = k
        return (M % MOD) * (bestk % MOD) % MOD
```

