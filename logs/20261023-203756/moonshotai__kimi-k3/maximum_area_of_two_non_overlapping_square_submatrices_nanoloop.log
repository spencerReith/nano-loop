class Solution:
    def maxArea(self, mat: list[list[int]]) -> int:
        m=len(mat); n=len(mat[0])
        dp=[[0]*n for _ in range(m)]
        for i in range(m):
            row=mat[i]
            dpi=dp[i]
            for j in range(n):
                if row[j]:
                    if i==0 or j==0:
                        dpi[j]=1
                    else:
                        dpi[j]=min(dpi[j-1], dp[i-1][j], dp[i-1][j-1])+1
        def ok(k:int)->bool:
            rows=m-k+1; cols=n-k+1
            if rows<=0 or cols<=0: return False
            row_any=[False]*rows
            col_any=[False]*cols
            # maybe local dp, k
            for i in range(rows):
                br_i=i+k-1
                dpi=dp[br_i]
                # inner j
                for j in range(cols):
                    if dpi[j+k-1] >= k:
                        row_any[i]=True
                        col_any[j]=True
            # check row separation
            # Need exists i1 < i2 with i2-i1>=k. Since rows length maybe. Use prefix max boolean.
            # Simple: find first True and last True; if last-first>=k return True. Because if any true, min and max indices yield max diff. For row_any, if max-min>=k then pair. Same for col.
            # But careful: row_any indices are top-left rows. If min and max diff>=k, yes. No need other combos.
            first=next((i for i,v in enumerate(row_any) if v), None)
            if first is not None:
                last=next((i for i in range(rows-1,-1,-1) if row_any[i]), None)
                if last-first>=k: return True
            first=next((j for j,v in enumerate(col_any) if v), None)
            if first is not None:
                last=next((j for j in range(cols-1,-1,-1) if col_any[j]), None)
                if last-first>=k: return True
            return False
        lo=1; hi=min(m,n); ans=0
        while lo<=hi:
            mid=(lo+hi)//2
            if ok(mid):
                ans=mid
                lo=mid+1
            else:
                hi=mid-1
        return ans*ans

