class Solution:
    def maxArea(self, mat: list[list[int]]) -> int:
        m = len(mat)
        n = len(mat[0])

        # dp[i][j] = side length of the largest all-1 square with bottom-right at (i, j)
        dp = [[0] * n for _ in range(m)]
        for i in range(m):
            for j in range(n):
                if mat[i][j] == 1:
                    if i == 0 or j == 0:
                        dp[i][j] = 1
                    else:
                        dp[i][j] = min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]) + 1

        def possible(k: int) -> bool:
            rows = m - k + 1
            cols = n - k + 1
            if rows <= 0 or cols <= 0:
                return False

            row_has = [False] * rows
            col_has = [False] * cols

            for i in range(rows):
                bottom = i + k - 1
                for j in range(cols):
                    if dp[bottom][j + k - 1] >= k:
                        row_has[i] = True
                        col_has[j] = True

            # If two valid top-left rows are at least k apart, the squares are row-disjoint.
            first = -1
            last = -1
            for i, v in enumerate(row_has):
                if v:
                    if first == -1:
                        first = i
                    last = i
            if first != -1 and last - first >= k:
                return True

            # If two valid top-left columns are at least k apart, the squares are column-disjoint.
            first = -1
            last = -1
            for j, v in enumerate(col_has):
                if v:
                    if first == -1:
                        first = j
                    last = j
            if first != -1 and last - first >= k:
                return True

            return False

        lo, hi = 1, min(m, n)
        best = 0
        while lo <= hi:
            mid = (lo + hi) // 2
            if possible(mid):
                best = mid
                lo = mid + 1
            else:
                hi = mid - 1

        return best * best
