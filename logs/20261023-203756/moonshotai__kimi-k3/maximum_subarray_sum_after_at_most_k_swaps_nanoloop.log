```python
class Solution:
    def maxSum(self, nums, k):
        n = len(nums)
        if k == 0:
            best = cur = nums[0]
            for v in nums[1:]:
                cur = v if v > cur + v else cur + v
                best = best if best > cur else cur
            return best
        vals = sorted(set(nums))
        dn = len(vals)
        D = vals + [0]
        idx = {v: i for i, v in enumerate(vals)}
        aix = [idx[v] for v in nums]
        cntO = [0]*(dn+1)
        cntI = [0]*(dn+1)
        ans = None
        for l in range(n-1, -1, -1):
            # before inner loop, ensure cntO = counts of nums[l..]
            if l == n-1:
                cntO = [0]*(dn+1)
                cntO[aix[n-1]] = 1
            else:
                # cntO currently = cntI from previous iteration (counts of nums[l+1..])
                cntO[aix[l]] += 1
            cntI = [0]*(dn+1)
            ec = dn; L = 0; SL = 0; G = 0; SG = 0
            ui = dn; L2 = 0; SL2 = 0
            vi = dn; G2 = 0; SG2 = 0
            seg = 0
            cntIl = cntI; cntOl = cntO; Dl = D
            kk = k
            best_l = None...
            for r in range(l, n):
                ix = aix[r]; x = nums[r]
                cntIl[ix] += 1
                cntOl[ix] -= 1
                if ix < ec:
                    L += 1; SL += x
                elif ix > ec:
                    G -= 1; SG -= x
                if ix < ui:
                    L2 += 1; SL2 += x
                if ix > vi:
                    G2 -= 1; SG2 -= x
                # move c*
                while ec and L >= G + cntOl[ec]:
                    ec -= 1
                    ci = cntIl[ec]
                    L -= ci; SL -= ci * Dl[ec]
                    co = cntOl[ec+1]
                    G += co; SG += co * Dl[ec+1]
                while ui and L2 >= kk:
                    ui -= 1
                    L2 -= cntIl[ui]; SL2 -= cntIl[ui] * Dl[ui]
                while vi and G2 + cntOl[vi] < kk:
                    vi -= 1
                    G2 += cntOl[vi+1]; SG2 += cntOl[vi+1] * Dl[vi+1]
                seg += x
                t̂ = L if L >= G else G
                if t̂ <= kk:
                    cand = seg + Dl[ec]*L - SL + SG - Dl[ec]*G
                else:
                    cand = seg - (SL2 + (kk - L2)*Dl[ui]) + (SG2 + (kk - G2)*Dl[vi])
                if ans is None or cand > ans: ans = cand
            # transfer cntI to cntO for next l
            cntO = cntIl  # counts of nums[l..]
        return ans
```

