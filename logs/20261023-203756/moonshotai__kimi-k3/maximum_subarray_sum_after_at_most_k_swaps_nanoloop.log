3. Move loops:
   - while ec > 0 and L >= G + cntO[ec]: ec -= 1; L -= cntI[ec]; SL -= cntI[ec]*D[ec]; G += cntO[ec+1]; SG += cntO[ec+1]*D[ec+1].
   - while ui > 0 and L2 >= k: ui -= 1; L2 -= cntI[ui]; SL2 -= cntI[ui]*D[ui].
   - while vi > 0 and G2 + cntO[vi] < k: vi -= 1; G2 += cntO[vi+1]; SG2 += cntO[vi+1]*D[vi+1].
4. seg += x. t_hat = L if L >= G else G. If t_hat <= k: cand = seg + D[ec]*L - SL + SG - D[ec]*G. else: bottom = SL2 + (k - L2)*D[ui]; top = SG2 + (k - G2)*D[vi]; cand = seg - bottom + top. ans = max(ans, cand).

