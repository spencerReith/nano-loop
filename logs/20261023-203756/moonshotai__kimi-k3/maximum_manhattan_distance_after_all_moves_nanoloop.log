class Solution:
    def maxDistance(self, moves: str) -> int:
        x = 0
        y = 0
        wild = 0

        for ch in moves:
            if ch == 'U':
                y += 1
            elif ch == 'D':
                y -= 1
            elif ch == 'R':
                x += 1
            elif ch == 'L':
                x -= 1
            else:  # ch == '_'
                wild += 1

        return abs(x) + abs(y) + wild
