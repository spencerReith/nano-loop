class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)
        INF = float('inf')
        times = [0.0] + [INF] * (n - 1)
        
        for i in range(n - 1, -1, -1):
            if times[i] != INF:
                continue
            current = INF
            for j in range(i, n - 1):
                if speed[j] <= speed[j + 1]:
                    current = 0.0
                    break
                catch = (position[j + 1] - position[j] - distance) / (speed[j] - speed[j + 1])
                current = min(current, catch)
            pos = position[i]
            for j in range(i, n):
                if current != INF:
                    pos = max(pos, position[j] + speed[j] * current)
                times[j] = current
        
        return sum(1 for t in times if t == INF)
