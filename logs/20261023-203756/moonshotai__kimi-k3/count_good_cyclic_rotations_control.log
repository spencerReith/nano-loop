class Solution:
    def countGoodRotations(self, nums: list[int]) -> int:
        n = len(nums)
        half = n // 2
        total = sum(nums)

        window = sum(nums[:half])
        good = 0

        for start in range(n):
            if start:
                window += nums[(start + half - 1) % n] - nums[start - 1]
            if window * 2 > total:
                good += 1

        return good
```