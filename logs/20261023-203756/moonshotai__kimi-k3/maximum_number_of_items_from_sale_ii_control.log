class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        cnt = [0] * (n + 1)
        cheapest = 10**20

        for f, p in items:
            cnt[f] += 1
            if p < cheapest:
                cheapest = p

        # reach[x] = number of items whose factor is divisible by x
        reach = [0] * (n + 1)
        for d in range(1, n + 1):
            s = 0
            for m in range(d, n + 1, d):
                s += cnt[m]
            reach[d] = s

        offers = []
        limit = 2 * cheapest
        for f, p in items:
            free_slots = reach[f] - 1  # exclude the item itself
            # A "double" copy costing >= 2 * cheapest is never better than
            # buying cheapest copies instead.
            if free_slots and p < limit:
                offers.append((p, free_slots))

        offers.sort()

        rem = budget
        doubled = 0
        for p, c in offers:
            if rem < p:
                break
            take = rem // p
            if take > c:
                take = c
            doubled += take
            rem -= take * p

        return doubled * 2 + rem // cheapest
```