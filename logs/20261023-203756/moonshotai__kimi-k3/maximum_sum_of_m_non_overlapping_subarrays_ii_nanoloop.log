```python
from collections import deque

class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        prefix = [0] * (n + 1)
        s = 0
        for i, x in enumerate(nums):
            s += x
            prefix[i + 1] = s

        # maximum sum of a single subarray with length in [l, r]
        best_single = -10**30
        dq = deque()
        for i in range(1, n + 1):
            t = i - l
            if t >= 0:
                pt = prefix[t]
                while dq and prefix[dq[-1]] >= pt:
                    dq.pop()
                dq.append(t)
            if dq and dq[0] < i - r:
                dq.popleft()
            if dq:
                cand = prefix[i] - prefix[dq[0]]
                if cand > best_single:
                    best_single = cand

        if best_single < 0:
            return best_single

        pref = prefix
        def solve(lam):
            best_val = [0] * (n + 1)
            best_cnt = [0] * (n + 1)
            dq = deque()
            ap = dq.append
            pop = dq.pop
            pl = dq.popleft
            for i in range(1, n + 1):
                t = i - l
                if t >= 0:
                    key = best_val[t] - pref[t]
                    cnt = best_cnt[t]
                    while dq:
                        b = dq[-1]
                        if b[1] < key or (b[1] == key and b[2] >= cnt):
                            pop()
                        else:
                            break
                    ap((t, key, cnt))
                lim = i - r
                while dq and dq[0][0] < lim:
                    pl()
                v = best_val[i - 1]
                c = best_cnt[i - 1]
                if dq:
                    f = dq[0]
                    v2 = f[1] + pref[i] - lam
                    c2 = f[2] + 1
                    if v2 > v or (v2 == v and c2 < c):
                        v = v2
                        c = c2
                best_val[i] = v
                best_cnt[i] = c
            return best_val[n], best_cnt[n]

        lo, hi = 0, best_single + 1
        while lo < hi:
            mid = (lo + hi) >> 1
            _, cnt = solve(mid)
            if cnt <= m:
                hi = mid
            else:
                lo = mid + 1
        val, _ = solve(lo)
        return val + lo * m
```

