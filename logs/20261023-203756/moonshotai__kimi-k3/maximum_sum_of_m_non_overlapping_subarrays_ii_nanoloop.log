def brute(nums, m, l, r):
    n = len(nums)
    prefix = [0]*(n+1)
    for i,x in enumerate(nums): prefix[i+1]=prefix[i]+x
    NEG = -10**18
    # dp[i][k] = max sum using first i elements, exactly k subarrays
    dp = [[NEG]*(m+1) for _ in range(n+1)]
