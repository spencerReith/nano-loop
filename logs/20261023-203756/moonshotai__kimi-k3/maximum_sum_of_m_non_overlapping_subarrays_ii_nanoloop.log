```python
from collections import deque

class Solution:
    def maximumSum(self, nums, m, l, r):
        n = len(nums)
        prefix = [0]*(n+1)
        for i, x in enumerate(nums):
            prefix[i+1] = prefix[i] + x
        
        # best single subarray sum with length in [l, r]
        # max over i of prefix[i] - min prefix[t], t in [i-r, i-l]
        best_single = None
        dq = deque()
        for i in range(1, n+1):
            t = i - l
            if t >= 0:
                while dq and prefix[dq[-1]] >= prefix[t]:
                    dq.pop()
                dq.append(t)
            while dq and dq[0] < i - r:
                dq.popleft()
            if dq:
                cand = prefix[i] - prefix[dq[0]]
                if best_single is None or cand > best_single:
                    best_single = cand
        if best_single is None:
            best_single = 0  # shouldn't happen since l <= n
        
        if best_single < 0:
            return best_single
        
        def solve(lam):
            best_val = [0]*(n+1)
            best_cnt = [0]*(n+1)
            dq = deque()
            for i in range(1, n+1):
                t = i - l
                if t >= 0:
                    key = best_val[t] - prefix[t]
                    cnt = best_cnt[t]
                    while dq and (dq[-1][1] < key or (dq[-1][1] == key and dq[-1][2] >= cnt)):
                        dq.pop()
                    dq.append((t, key, cnt))
                while dq and dq[0][0] < i - r:
                    dq.popleft()
                v = best_val[i-1]; c = best_cnt[i-1]
                if dq:
                    v2 = dq[0][1] + prefix[i] - lam
                    c2 = dq[0][2] + 1
                    if v2 > v or (v2 == v and c2 < c):
                        v, c = v2, c2
                best_val[i] = v; best_cnt[i] = c
            return best_val[n], best_cnt[n]
        
        lo, hi = 0, best_single + 1
        # invariant: cnt(hi) <= m
        while lo < hi:
            mid = (lo + hi) >> 1
            val, cnt = solve(mid)
            if cnt <= m:
                hi = mid
            else:
                lo = mid + 1
        val, cnt = solve(lo)
        return val + lo * m
```

