```python
def solve_penalty(nums, prefix, lam, l, r):
    n = len(nums)
    NEG = -(10**30)
    # best_val[i], best_cnt[i]
    best_val = [0]*(n+1)
    best_cnt = [0]*(n+1)
    from collections import deque
    dq = deque()  # stores t values, with key = best_val[t] - prefix[t], count = best_cnt[t]
    for i in range(1, n+1):
        # add t = i - l to window (valid t range for this i: [i-r, i-l])
        t = i - l
        if t >= 0:
            key = best_val[t] - prefix[t]
            cnt = best_cnt[t]
            while dq and (dq[-1][1] < key or (dq[-1][1] == key and dq[-1][2] >= cnt)):
                dq.pop()
            dq.append((t, key, cnt))
        # remove t < i - r
        while dq and dq[0][0] < i - r:
            dq.popleft()
        # option 1: skip
        v, c = best_val[i-1], best_cnt[i-1]
        # option 2: end subarray at i
        if dq:
            t0, key, cnt = dq[0]
            v2 = key + prefix[i] - lam
            c2 = cnt + 1
            if v2 > v or (v2 == v and c2 < c):
                v, c = v2, c2
        best_val[i], best_cnt[i] = v, c
    return best_val[n], best_cnt[n]
```

