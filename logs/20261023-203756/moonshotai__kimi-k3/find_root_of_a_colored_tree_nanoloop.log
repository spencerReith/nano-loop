```python
class Solution:
    def findColoredRoot(self, edges: list[list[int]], colors: str) -> int:
        n = len(colors)
        idx = {'R': 0, 'B': 1, 'W': 2}
        c = [idx[ch] for ch in colors]
        deg = [0] * n
        indeg = [0] * n
        for u, v in edges:
            deg[u] += 1
            deg[v] += 1
            if c[u] == c[v]:
                return -1
            # required direction: from node with color x to node with color (x+1)%3
            if c[v] == (c[u] + 1) % 3:
                # u -> v
                indeg[v] += 1
            else:
                # v -> u
                indeg[u] += 1
        roots = [i for i in range(n) if indeg[i] == 0]
        if len(roots) != 1:
            return -1
        r = roots[0]
        if deg[r] > 2:
            return -1
        return r
```

