class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        from collections import defaultdict
        
        # Merge identical items: count duplicates, keep the cheapest price
        # Buying multiple copies of a factor gives extra free copies per duplicate
        # bought (each duplicate separately triggers the free-copy rule... 
        # wait - same item = same factor+price pair? Let's treat duplicates carefully)
        
        # Group by factor: for each factor, find min price and count of items with that factor
        # Actually items are distinct entries; two entries could have same factor but different prices.
        # A "free copy of item j" means a copy of item type j. Buying item i (at least one copy)
        # gives free copy of every j != i with factor_i | factor_j.
        
        n = len(items)
        factors = [f for f, p in items]
        prices = [p for f, p in items]
        
        # Precompute, for each i, the set of j != i such that factor_i divides factor_j
        # n <= 1000, O(n^2) = 1e6, fine.
        gives = [0] * n  # number of free copies buying item i yields
        for i in range(n):
            cnt = 0
            fi = factors[i]
            for j in range(n):
                if j != i and factors[j] % fi == 0:
                    cnt += 1
            gives[i] = cnt
        
        # Decision: choose subset S of item types to buy at least one copy of,
        # plus extra copies. Extra copies of item i cost price_i and yield 1 item each
        # (no extra free copies). So extra copies should go to the cheapest item overall
        # among ALL items (since buying cheapest gives 1 item per price, same as any).
        # Actually extra copies of ANY item give exactly 1 item per copy, so use global min price.
        
        min_price = min(prices)
        
        # Base: spend remaining budget on cheapest item: budget // min_price items, cost used.
        # If we buy a subset S (at least one each), cost = sum prices, purchased = |S| + extras,
        # free = sum gives[i] for i in S.
        # We want max over S: |S| + sum(gives[i]) + (budget - cost(S)) // min_price
        # subject to cost(S) <= budget.
        # = (budget - cost(S)) // min_price + sum_{i in S} (1 + gives[i])
        
        # DP over budget: dp[c] = max sum of (1 + gives[i]) using items each at most once with exact cost <= c
        # Then answer = max over c<=budget of dp[c] + (budget - c) // min_price
        
        dp = [0] * (budget + 1)
        for i in range(n):
            w = 1 + gives[i]
            p = prices[i]
            for c in range(budget, p - 1, -1):
                if dp[c - p] + w > dp[c]:
                    dp[c] = dp[c - p] + w
        
        ans = budget // min_price  # don't buy any "first copy", just cheapest extras
        for c in range(budget + 1):
            val = dp[c] + (budget - c) // min_price
            if val > ans:
                ans = val
        return ans
