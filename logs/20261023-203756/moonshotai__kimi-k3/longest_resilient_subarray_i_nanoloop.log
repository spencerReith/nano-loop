```python
from math import gcd


class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        # A subarray of length m is resilient iff every element x satisfies
        # (S - x) % k == 0, where S is the subarray sum.
        # This means all elements share one residue r mod k (each x == S mod k),
        # and then S - x == m*r - r = (m-1)*r must be divisible by k.
        # So a resilient subarray is a contiguous run of elements with the same
        # residue r mod k, whose length m satisfies (m-1)*r % k == 0.
        # (m-1) must be a multiple of t = k / gcd(r, k).
        ans = 1
        i = 0
        n = len(nums)
        while i < n:
            r = nums[i] % k
            j = i
            while j < n and nums[j] % k == r:
                j += 1
            L = j - i  # length of this maximal same-residue run
            t = k // gcd(r, k)
            m = 1 + t * ((L - 1) // t)  # largest valid length within the run
            if m > ans:
                ans = m
            i = j
        return ans
```