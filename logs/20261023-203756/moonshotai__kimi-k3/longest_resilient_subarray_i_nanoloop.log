Implementation:

```python
from math import gcd

class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        ans = 1
        i = 0
        n = len(nums)
        while i < n:
            r = nums[i] % k
            j = i
            while j < n and nums[j] % k == r:
                j += 1
            L = j - i
            t = k // gcd(r, k)
            m = 1 + t * ((L - 1) // t)
            ans = max(ans, m)
            i = j
        return ans
```

