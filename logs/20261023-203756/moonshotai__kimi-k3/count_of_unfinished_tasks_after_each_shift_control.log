class Solution:
    def countTasks(self, tasks: list[int], shifts: list[int]) -> list[int]:
        n = len(tasks)
        total = sum(tasks)
        prefix = [0] * (n + 1)
        for i, t in enumerate(tasks):
            prefix[i + 1] = prefix[i] + t
        
        ans = []
        pos = 0  # work already completed in current cycle, range [0, total)
        for s in shifts:
            pos += s
            if pos >= total:
                ans.append(0)
                pos = 0
            else:
                # number of completed tasks = count of prefix[i] <= pos (for i in 1..n-1; prefix[n]=total not done)
                lo, hi = 0, n - 1
                while lo < hi:
                    mid = (lo + hi + 1) // 2
                    if prefix[mid] <= pos:
                        lo = mid
                    else:
                        hi = mid - 1
                ans.append(n - lo)
        return ans
```