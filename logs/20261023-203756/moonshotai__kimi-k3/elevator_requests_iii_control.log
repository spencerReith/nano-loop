from itertools import permutations

class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[list[int]]) -> int:
        k = len(requests)
        ans = float('inf')

        for perm in permutations(range(k)):
            pos = start
            time = 0

            for idx in perm:
                arr, fl = requests[idx]
                time += abs(fl - pos)
                if time < arr:
                    time = arr
                pos = fl

            if time < ans:
                ans = time

        return ans
