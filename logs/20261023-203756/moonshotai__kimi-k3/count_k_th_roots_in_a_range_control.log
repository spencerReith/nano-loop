class Solution:
    def countKthRoots(self, l: int, r: int, k: int) -> int:
        # Count how many x satisfy x^k <= n (with x >= 0)
        def count_upto(n: int) -> int:
            if n < 0:
                return 0
            # Special case k = 1: every number is a 1st power
            if k == 1:
                return n + 1  # x can be 0,1,...,n
            
            # Binary search the maximum x such that x^k <= n
            lo, hi = 0, 1
            # First find an upper bound
            while self._pow_leq(hi, k, n):
                hi *= 2
                if hi > n + 1:  # safety cap
                    hi = n + 1
                    break
            
            lo, hi = 0, hi
            while lo < hi:
                mid = (lo + hi + 1) // 2
                if self._pow_leq(mid, k, n):
                    lo = mid
                else:
                    hi = mid - 1
            return lo + 1  # include x = 0
        
        return count_upto(r) - count_upto(l - 1)
    
    def _pow_leq(self, x: int, k: int, limit: int) -> bool:
        """Check if x^k <= limit, with early exit to avoid overflow concerns."""
        result = 1
        for _ in range(k):
            result *= x
            if result > limit:
                return False
        return True
