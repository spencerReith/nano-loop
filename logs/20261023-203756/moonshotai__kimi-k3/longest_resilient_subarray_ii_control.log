class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        a = [x % k for x in nums]

        # If total sum of subarray is S, deleting element x leaves S - x.
        # We need (S - x) % k == 0 for every x in subarray.
        # This means all elements in the subarray are congruent to S (mod k).
        # So all elements have the same residue r, and S % k == r.
        # If subarray has m elements all with residue r, then S % k = (m * r) % k = r.
        # => (m - 1) * r % k == 0.
        # For r = 0: any length works.
        # For r != 0: need (m - 1) * r % k == 0.

        # For each residue r, find longest subarray where all elements have residue r
        # and ((length - 1) * r) % k == 0 (or r == 0).

        # Group consecutive elements by residue? No — subarray elements must ALL have
        # same residue, but they must be contiguous in the original array.
        # So we need longest contiguous segment where all values equal some residue r,
        # satisfying the length condition.

        # Wait — elements with other residues break the segment. So within a maximal
        # run of residue r, any sub-segment of length m with (m-1)*r % k == 0 works.

        ans = 1  # length 1 always works

        i = 0
        while i < n:
            r = a[i]
            j = i
            while j < n and a[j] == r:
                j += 1
            run = j - i  # maximal run length of residue r

            if r == 0:
                ans = max(ans, run)
            else:
                # need (m - 1) * r % k == 0, i.e., m ≡ 1 (mod k / gcd(r, k))
                g = gcd(r, k)
                step = k // g
                # m - 1 must be a multiple of step
                # max m <= run with m ≡ 1 (mod step), m >= 1
                if run >= 1:
                    m = 1 + ((run - 1) // step) * step
                    ans = max(ans, m)
            i = j

        return ans

from math import gcd
