class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        ans = 0

        for i in range(n):
            total = 0
            count = {}

            for j in range(i, n):
                x = nums[j]
                total += x
                count[x % k] = count.get(x % k, 0) + 1

                length = j - i + 1
                r = total % k

                if r == 0:
                    if length > ans:
                        ans = length
                    continue

                # Need an element y in nums[i..j] such that:
                # total - 2*y == 0 (mod k)  =>  2*y == r (mod k)
                if k % 2 == 1:
                    inv2 = (k + 1) // 2
                    need = (r * inv2) % k
                    if count.get(need, 0) > 0 and length > ans:
                        ans = length
                else:
                    if r % 2 == 0:
                        half = k // 2
                        base = (r // 2) % half
                        if (count.get(base, 0) > 0 or count.get(base + half, 0) > 0) and length > ans:
                            ans = length

        return ans
