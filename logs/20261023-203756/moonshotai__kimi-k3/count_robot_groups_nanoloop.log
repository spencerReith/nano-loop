```python
class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)
        stack = []  # (index, T) ; T None = inf, else (num, den)
        survivors = 0
        for i in range(n - 1, -1, -1):
            Ti = None
            while stack:
                j, Tj = stack[-1]
                gap0 = position[j] - position[i]
                if gap0 <= distance:
                    catch = (0, 1)
                elif speed[i] > speed[j]:
                    catch = (gap0 - distance, speed[i] - speed[j])
                else:
                    catch = None
                if catch is None:
                    if Tj is None:
                        Ti = None
                        break
                    else:
                        stack.pop()
                else:
                    if Tj is None:
                        Ti = catch
                        break
                    c, d = catch
                    e, f = Tj
                    if c * f <= e * d:
                        Ti = catch
                        break
                    else:
                        stack.pop()
            if Ti is None:
                survivors += 1
            stack.append((i, Ti))
        return survivors
```

