from fractions import Fraction

def brute(position, speed, distance):
    leaders = list(range(len(position)))  # current group leaders, left to right
    t = Fraction(0)
    while True:
        # find earliest catch time >= t among adjacent pairs
        best = None
        for idx in range(len(leaders)-1):
            a = leaders[idx]; b = leaders[idx+1]
            gap0 = position[b] - position[a]
            # gap(t) = gap0 + (speed[b]-speed[a]) * t
            cur = gap0 + (speed[b]-speed[a]) * t
            if cur <= distance:
                tau = t
            elif speed[a] > speed[b]:
                tau = Fraction(gap0 - distance, speed[a]-speed[b])
                if tau < t:
                    tau = t  # numerical safety
            else:
                continue
            if best is None or tau < best:
                best = tau
        if best is None:
            break
        t = best
        # find connected components of adjacent pairs with gap(t) <= distance
        # build groups
        n = len(leaders)
        merge_with_next = [False]*(n-1)
        for idx in range(n-1):
            a = leaders[idx]; b = leaders[idx+1]
            cur = (position[b]-position[a]) + (speed[b]-speed[a]) * t
            if cur <= distance:
                merge_with_next[idx] = True
        # absorb: keep rightmost of each component
        new_leaders = []
        i = 0
        while i < n:
            j = i
            while j < n-1 and merge_with_next[j]:
                j += 1
            # component leaders[i..j], rightmost is leaders[j]
            new_leaders.append(leaders[j])
            i = j+1
        if len(new_leaders) == len(leaders):
            break  # no merges (shouldn't happen since best found)
        leaders = new_leaders
    return len(leaders)
```

