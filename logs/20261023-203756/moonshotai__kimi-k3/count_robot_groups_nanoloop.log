```python
class Solution:
    def countGroups(self, position, speed, distance):
        n = len(position)
        INF = None  # represent infinity as None
        # stack entries: (index, T) where T is (num, den) or None(inf)
        stack = []
        survivors = 0
        for i in range(n-1, -1, -1):
            # chase
            Ti = None  # will set
            while stack:
                j, Tj = stack[-1]
                # compute catch(i,j)
                gap0 = position[j] - position[i]
                if gap0 <= distance:
                    catch = (0, 1)
                elif speed[i] > speed[j]:
                    catch = (gap0 - distance, speed[i] - speed[j])
                else:
                    catch = None  # inf
                # condition: catch <= Tj ?
                if catch is None:
                    # inf <= Tj only if Tj is inf
                    if Tj is None:
                        # i survives (never catches survivor j)
                        Ti = None
                        break
                    else:
                        # pop j, chase next from t0 = Tj
                        stack.pop()
                        continue
                else:
                    if Tj is None:
                        # finite <= inf → absorbed
                        Ti = catch
                        break
                    else:
                        # compare catch=(c,d) <= Tj=(e,f): c*f <= e*d
                        c, d = catch
                        e, f = Tj
                        if c * f <= e * d:
                            Ti = catch
                            break
                        else:
                            stack.pop()
                            continue
            else:
                # stack empty → i survives
                Ti = None
            if Ti is None:
                survivors += 1
            stack.append((i, Ti))
        return survivors
```

