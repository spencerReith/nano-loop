```python
class Solution:
    def maxAlternatingSum(self, nums: list[int]) -> int:
        NEG = float('-inf')
        p0 = m0 = p1 = m1 = NEG   # ending exactly at previous index
        pp0 = pm0 = NEG           # ending exactly two indices back
        ans = NEG
        for x in nums:
            np0 = max(x, m0 + x)
            nm0 = p0 - x
            np1 = max(m1 + x, pm0 + x)
            nm1 = max(p1 - x, pp0 - x)
            pp0, pm0 = p0, m0
            p0, m0, p1, m1 = np0, nm0, np1, nm1
            cur = max(p0, m0, p1, m1)
            if cur > ans:
                ans = cur
        return ans
```

