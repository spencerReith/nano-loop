class Solution:
    def maxAlternatingSum(self, nums):
        NEG = float('-inf')
        # states ending exactly at previous index
        p0 = m0 = p1 = m1 = NEG
        # states ending exactly at index before previous (for skip)
        pp0 = pm0 = NEG
        ans = NEG
        for x in nums:
            np0 = max(x, m0 + x if m0 != NEG else NEG)
            nm0 = p0 - x if p0 != NEG else NEG
            np1 = max(m1 + x if m1 != NEG else NEG,
                      pm0 + x if pm0 != NEG else NEG)
            nm1 = max(p1 - x if p1 != NEG else NEG,
                      pp0 - x if pp0 != NEG else NEG)
            pp0, pm0 = p0, m0
            p0, m0, p1, m1 = np0, nm0, np1, nm1
            ans = max(ans, p0, m0, p1, m1)
        return ans
```

