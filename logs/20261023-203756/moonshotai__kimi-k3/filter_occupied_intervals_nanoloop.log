```python
class Solution:
    def filterOccupiedIntervals(self, occupiedIntervals: list[list[int]], freeStart: int, freeEnd: int) -> list[list[int]]:
        # Sort intervals by start
        intervals = sorted(occupiedIntervals, key=lambda x: x[0])
        
        # Merge overlapping or touching intervals.
        # Touching: next.start == current.end + 1
        merged = []
        for start, end in intervals:
            if merged and start <= merged[-1][1] + 1:
                if end > merged[-1][1]:
                    merged[-1][1] = end
            else:
                merged.append([start, end])
        
        # Subtract the free interval [freeStart, freeEnd] from each merged interval
        result = []
        for start, end in merged:
            # No intersection with free interval
            if end < freeStart or start > freeEnd:
                result.append([start, end])
                continue
            # Left part remains
            if start < freeStart:
                result.append([start, freeStart - 1])
            # Right part remains
            if end > freeEnd:
                result.append([freeEnd + 1, end])
        
        return result
```