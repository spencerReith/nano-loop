class Solution:
    MOD = 1_000_000_007

    def countValidSequences(self, n: int, k: int) -> int:
        mod = self.MOD

        fact = [1] * (n + 1)
        for i in range(1, n + 1):
            fact[i] = fact[i - 1] * i % mod

        inv_fact = [1] * (n + 1)
        inv_fact[n] = pow(fact[n], mod - 2, mod)
        for i in range(n, 0, -1):
            inv_fact[i - 1] = inv_fact[i] * i % mod

        def comb(total: int, choose: int) -> int:
            if choose < 0 or choose > total:
                return 0
            return fact[total] * inv_fact[choose] % mod * inv_fact[total - choose] % mod

        # All ordered compositions of n into k positive parts.
        total = comb(n - 1, k - 1)

        # Subtract compositions whose parts are all odd. Write each part as
        # 2*x_i + 1, giving sum(x_i) = (n-k)/2.
        odd_product = 0
        if (n - k) % 2 == 0:
            odd_sum = (n - k) // 2
            odd_product = comb(odd_sum + k - 1, k - 1)

        return (total - odd_product) % mod
