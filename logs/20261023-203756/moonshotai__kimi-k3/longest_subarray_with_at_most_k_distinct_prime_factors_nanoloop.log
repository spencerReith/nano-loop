```python
class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        max_n = max(nums)

        # Precompute distinct prime factors for every value up to max_n
        factors = [[] for _ in range(max_n + 1)]
        for i in range(2, max_n + 1):
            if not factors[i]:  # i is prime
                for j in range(i, max_n + 1, i):
                    factors[j].append(i)

        cnt = [0] * (max_n + 1)  # count of each prime in current window
        distinct = 0
        left = 0
        ans = 0

        for right, x in enumerate(nums):
            for p in factors[x]:
                if cnt[p] == 0:
                    distinct += 1
                cnt[p] += 1

            while distinct > k:
                y = nums[left]
                for p in factors[y]:
                    cnt[p] -= 1
                    if cnt[p] == 0:
                        distinct -= 1
                left += 1

            if right - left + 1 > ans:
                ans = right - left + 1

        return ans
