from collections import deque

class Solution:
    def maximumSum(self, nums, m, l, r):
        n=len(nums)
        pref=[0]*(n+1)
        for i,x in enumerate(nums,1): pref[i]=pref[i-1]+x
        NEG=-10**30
        max_k=min(m, n//l)
        prev=[0]*(n+1)  # exactly 0 subarrays: sum 0 for any prefix
        ans=NEG
        for k in range(1,max_k+1):
            cur=[NEG]*(n+1)
            dq=deque()
            # optional local variables for speed
            for i in range(n+1):
                # carry over not using position i
                if i>0 and cur[i-1]>cur[i]: # cur[i] initialized NEG; but need set cur[i]=cur[i-1]
                    cur[i]=cur[i-1]
                # Actually for i=0 no carry. Simpler: if i: cur[i]=cur[i-1]
                R=i-l
                if R>=0:
                    val=prev[R]-pref[R] if prev[R]!=NEG else NEG
                    if val!=NEG:
                        while dq and (prev[dq[-1]]-pref[dq[-1]]) <= val: # recompute? store vals list maybe
                            dq.pop()
                        dq.append(R)
                    L=i-r
                    if L<0: L=0
                    while dq and dq[0]<L:
                        dq.popleft()
                    if dq:
                        cand=pref[i]+(prev[dq[0]]-pref[dq[0]])
                        if cand>cur[i]: cur[i]=cand
                else:
                    # no window; still maybe remove? L negative, no. dq empty because R<0 for all so far. okay
                    pass
            if cur[n]>ans: ans=cur[n]
            prev=cur
        return ans

