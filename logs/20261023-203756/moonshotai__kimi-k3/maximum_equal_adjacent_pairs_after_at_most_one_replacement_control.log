class Solution:
    def maxEqualPairs(self, nums: list[int]) -> int:
        """
        Approach
        --------
        After the operation, every element is either unchanged or (if it was x) becomes y.
        For any fixed pair (x -> y), an adjacent pair (a, b) is good iff
