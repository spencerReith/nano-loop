class Solution:
    def finishTime(self, n: int, edges: list[list[int]], baseTime: list[int]) -> int:
        children = [[] for _ in range(n)]
        for u, v in edges:
            children[u].append(v)

        finish = [0] * n
        stack = [(0, False)]

        while stack:
            node, processed = stack.pop()

            if not processed:
                stack.append((node, True))
                for child in children[node]:
                    stack.append((child, False))
            else:
                if not children[node]:
                    finish[node] = baseTime[node]
                else:
                    it = iter(children[node])
                    first = next(it)
                    earliest = latest = finish[first]

                    for child in it:
                        f = finish[child]
                        if f < earliest:
                            earliest = f
                        elif f > latest:
                            latest = f

                    # latest + ((latest - earliest) + baseTime[node])
                    finish[node] = baseTime[node] + 2 * latest - earliest

        return finish[0]
