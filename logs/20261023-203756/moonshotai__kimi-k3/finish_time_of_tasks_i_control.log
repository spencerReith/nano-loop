class Solution:
    def finishTime(self, n: int, edges: list[list[int]], baseTime: list[int]) -> int:
        children = [[] for _ in range(n)]
        for u, v in edges:
            children[u].append(v)
        finish = [0]*n
        stack = [(0, False)]
        while stack:
            node, processed = stack.pop()
            if not processed:
                stack.append((node, True))
                for ch in children[node]:
                    stack.append((ch, False))
            else:
                if not children[node]:
                    finish[node] = baseTime[node]
                else:
                    # find min and max among child finishes
                    it = iter(children[node]); first=next(it); mn=mx=finish[first]
                    for ch in it:
                        f=finish[ch]
                        if f<mn: mn=f
                        elif f>mx: mx=f
                    finish[node] = baseTime[node] + 2*mx - mn
        return finish[0]

