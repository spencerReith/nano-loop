class Solution:
    def kthDigit(self, k: int) -> int:
        # Block b = 0 contains 1..9, for 9 digits total.
        remaining = k

        if remaining <= 9:
            return remaining
        remaining -= 9

        # For b in [10^(digits-1), 10^digits - 1], every number
        # 10*b through 10*b+9 has digits+1 decimal digits.
        digits = 1
        while True:
            block_count = 9 * (10 ** (digits - 1))
            number_length = digits + 1
            digits_per_block = 10 * number_length
            group_length = block_count * digits_per_block

            if remaining <= group_length:
                block_offset = remaining - 1
                b = 10 ** (digits - 1) + block_offset // digits_per_block
                offset_in_block = block_offset % digits_per_block

                position = offset_in_block // number_length
                digit_index = offset_in_block % number_length

                if b % 2 == 0:
                    number = 10 * b + position
                else:
                    number = 10 * b + 9 - position

                return int(str(number)[digit_index])

            remaining -= group_length
            digits += 1
