class Solution:
    MOD = 10**9 + 7

    def countValidSubsets(self, parent: list[int], nums: list[int], k: int) -> int:
        n = len(parent)
        children = [[] for _ in range(n)]
        for v in range(1, n):
            children[parent[v]].append(v)

        # excluded[v][r]: subsets in v's subtree where v is not chosen and
        #                 the selected values sum to r modulo k.
        # included[v][r]: same, except v is chosen.
        excluded = [[0] * k for _ in range(n)]
        included = [[0] * k for _ in range(n)]
        mod = self.MOD

        # Since parent[i] < i, processing nodes in reverse order guarantees
        # that every child has already been processed.
        for v in range(n - 1, -1, -1):
            not_taken = [0] * k
            not_taken[0] = 1

            taken = [0] * k
            taken[nums[v] % k] = 1

            for c in children[v]:
                child_excluded = excluded[c]
                child_total = [(child_excluded[r] + included[c][r]) % mod for r in range(k)]

                # If v is not taken, each child may either be taken or not.
                new_not_taken = [0] * k
                for i, a in enumerate(not_taken):
                    if a == 0:
                        continue
                    for j, b in enumerate(child_total):
                        if b:
                            new_not_taken[(i + j) % k] += a * b
                    for r in range(k):
                        new_not_taken[r] %= mod
                not_taken = new_not_taken

                # If v is taken, every child must be excluded.
                new_taken = [0] * k
                for i, a in enumerate(taken):
                    if a == 0:
                        continue
                    for j, b in enumerate(child_excluded):
                        if b:
                            new_taken[(i + j) % k] += a * b
                    for r in range(k):
                        new_taken[r] %= mod
                taken = new_taken

            excluded[v] = not_taken
            included[v] = taken

        # The empty subset is counted in excluded[0][0], but is not valid.
        return (excluded[0][0] + included[0][0] - 1) % mod
