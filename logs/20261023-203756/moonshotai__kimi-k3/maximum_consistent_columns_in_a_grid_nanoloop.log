        # Store columns for faster access.
        cols = [[grid[r][c] for r in range(m)] for c in range(n)]

        def compatible(a: int, b: int) -> bool:
            ca = cols[a]
            cb = cols[b]
            for r in range(m):
                if abs(cb[r] - ca[r]) > limit:
                    return False
            return True

        dp = [1] * n
        ans = 1
        for j in range(n):
            best = 1
            for i in range(j):
                if dp[i] + 1 > best and compatible(i, j):
                    best = dp[i] + 1
            dp[j] = best
            if best > ans:
                ans = best
        return ans
