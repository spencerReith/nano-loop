**Approach summary:** The shared set of the two monotone paths is always either a horizontal run of contiguous cells in one row, a vertical segment in one column, or a single interior cell. Any such run of length ≥ 2 is achievable as the exact shared set, while single cells are only achievable when interior. So the answer is: max over rows of best subarray of length ≥ 2 (Kadane variant), max over columns of same, and max interior cell value.

```python
class Solution:
    def maxScore(self, grid: list[list[int]]) -> int:
        m = len(grid)
        n = len(grid[0])
        NEG = float('-inf')
        best = NEG

        # Horizontal runs (length >= 2) in each row: Kadane variant
        for i in range(m):
            row = grid[i]
            best_run = NEG
            prev = row[0]  # max subarray sum ending at previous index (length >= 1)
            for j in range(1, n):
                cand = prev + row[j]  # subarray of length >= 2 ending at j
                if cand > best_run:
                    best_run = cand
                prev = row[j] if row[j] > prev + row[j] else prev + row[j]
            if best_run > best:
                best = best_run

        # Vertical segments (length >= 2) in each column
        for j in range(n):
            best_seg = NEG
            prev = grid[0][j]
            for i in range(1, m):
                cand = prev + grid[i][j]
                if cand > best_seg:
                    best_seg = cand
                prev = grid[i][j] if grid[i][j] > prev + grid[i][j] else prev + grid[i][j]
            if best_seg > best:
                best = best_seg

        # Single interior cells
        for i in range(1, m - 1):
            row = grid[i]
            for j in range(1, n - 1):
                if row[j] > best:
                    best = row[j]

        return best
```