from collections import deque

class Solution:
    def maximumSum(self, nums: list[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        pref = [0] * (n + 1)
        for i, x in enumerate(nums, 1):
            pref[i] = pref[i - 1] + x

        NEG = -10**30
        prev = [0] * (n + 1)  # exactly 0 chosen subarrays
        ans = NEG

        for _ in range(min(m, n // l)):
            cur = [NEG] * (n + 1)
            dq = deque()

            for i in range(1, n + 1):
                j = i - l
                if j >= 0:
                    val = prev[j] - pref[j]
                    while dq and prev[dq[-1]] - pref[dq[-1]] <= val:
                        dq.pop()
                    dq.append(j)

                low = i - r
                while dq and dq[0] < low:
                    dq.popleft()

                best = NEG
                if dq:
                    best = pref[i] + prev[dq[0]] - pref[dq[0]]

                cur[i] = cur[i - 1] if cur[i - 1] > best else best

            if cur[n] > ans:
                ans = cur[n]
            prev = cur

        return ans
