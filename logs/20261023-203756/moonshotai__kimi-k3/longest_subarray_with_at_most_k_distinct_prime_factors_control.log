class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        # Smallest prime factor sieve up to 1e5
        limit = 100_000
        spf = list(range(limit + 1))
        for i in range(2, int(limit ** 0.5) + 1):
            if spf[i] == i:
                for j in range(i * i, limit + 1, i):
                    if spf[j] == j:
                        spf[j] = i

        from collections import defaultdict
        count = defaultdict(int)
        distinct = 0
        left = 0
        ans = 0

        for right, x in enumerate(nums):
            # Add prime factors of nums[right]
            temp = x
            primes = []
            while temp > 1:
                p = spf[temp]
                primes.append(p)
                while temp % p == 0:
                    temp //= p
            for p in primes:
                count[p] += 1
                if count[p] == 1:
                    distinct += 1

            # Shrink window while too many distinct primes
            while distinct > k:
                temp = nums[left]
                primes = []
                while temp > 1:
                    p = spf[temp]
                    primes.append(p)
                    while temp % p == 0:
                        temp //= p
                for p in primes:
                    count[p] -= 1
                    if count[p] == 0:
                        distinct -= 1
                left += 1

            # Update maximum valid window size
            ans = max(ans, right - left + 1)

        return ans
