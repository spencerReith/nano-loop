import random, itertools

def brute(items, budget):
    n = len(items)
    d = [0]*n
    for i in range(n):
        for j in range(n):
            if i != j and items[j][0] % items[i][0] == 0:
                d[i] += 1
    best = 0
    # BFS/DP over (cost) — maximize items: actually DP over cost: for each cost, max items.
    # Since budget small, DP: dp[c] = max items with exactly cost c... unbounded knapsack with per-copy value depending on count. Do DP over counts via recursion with cap.
    # Simplest: iterate purchases one at a time, state = cost; but value of a copy depends on x_i. Do DP over (i, cost) with counts... 
    # Easier: dp over cost where we add copies: state must include x_i. Since budget small, enumerate via recursion.
    x = [0]*n
    def rec(i, cost):
        nonlocal best
        if i == n:
            total = sum(x) + sum(min(x[k], d[k]) for k in range(n))
            best = max(best, total)
            return
        f, p = items[i]
        maxc = (budget - cost) // p
        for v in range(maxc+1):
            x[i] = v
            rec(i+1, cost + v*p)
        x[i] = 0
    rec(0,0)
    return best

