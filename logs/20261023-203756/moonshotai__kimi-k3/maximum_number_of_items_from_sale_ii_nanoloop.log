```python
class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        cnt = [0] * (n + 1)
        for f, p in items:
            cnt[f] += 1
        # D[f] = number of items whose factor is a multiple of f
        D = [0] * (n + 1)
        for f in range(1, n + 1):
            if cnt[f]:
                for m in range(f, n + 1, f):
                    D[f] += cnt[m]
        # Wait, this iterates f and adds cnt[m]... that's D[f] = sum over multiples. 
        # But we should skip f with... no, we need D[f] for all f that appear.
        c = min(p for _, p in items)
        # candidates with price < 2c and d_i > 0
        cand = []
        for f, p in items:
            d = D[f] - 1
            if d > 0 and p < 2 * c:
                cand.append((p, d))
        cand.sort()
        ans = 0
        B = budget
        for p, d in cand:
            if B < p:
                break
            t = min(d, B // p)
            ans += 2 * t
            B -= t * p
        ans += B // c
        return ans
```

