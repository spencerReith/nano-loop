```python
class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        cnt = [0] * (n + 1)
        for f, _ in items:
            cnt[f] += 1
        D = [0] * (n + 1)
        for f in range(1, n + 1):
            s = 0
            for m in range(f, n + 1, f):
                s += cnt[m]
            D[f] = s
        c = min(p for _, p in items)
        cand = []
        for f, p in items:
            d = D[f] - 1
            if d > 0 and p < 2 * c:
                cand.append((p, d))
        cand.sort()
        ans = 0
        B = budget
        for p, d in cand:
            if B < p:
                break
            t = min(d, B // p)
            ans += 2 * t
            B -= t * p
        ans += B // c
        return ans
```

