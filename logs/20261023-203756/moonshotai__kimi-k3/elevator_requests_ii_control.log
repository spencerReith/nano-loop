from bisect import bisect_left

class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        xs = sorted(requests)
        m = len(xs)

        pos = bisect_left(xs, start)
        if pos < m and xs[pos] == start:
            w = [1] * m
        else:
            xs.insert(pos, start)          # dummy already-visited point
            w = [1] * pos + [0] + [1] * (m - pos)

        N = len(xs)
        pref = [0] * (N + 1)
        run = 0
        for i, wi in enumerate(w, 1):
            run += wi
            pref[i] = run

        INF = 10 ** 30
        at_left = [[INF] * N for _ in range(N)]
        at_right = [[INF] * N for _ in range(N)]
        at_left[pos][pos] = 0
        at_right[pos][pos] = 0

        x = xs
        for length in range(1, N):
            max_l = N - length
            lo = pos - length + 1
            if lo < 0:
                lo = 0
            hi = pos if pos < max_l else max_l

            for l in range(lo, hi + 1):
                r = l + length - 1
                rem = m - (pref[r + 1] - pref[l])
                if rem == 0:
                    continue

                vl = at_left[l][r]
                vr = at_right[l][r]

                if l:
                    nl = l - 1
                    xn = x[nl]
                    best = at_left[nl][r]
                    if vl != INF:
                        cand = vl + (x[l] - xn) * rem
                        if cand < best:
                            best = cand
                    if vr != INF:
                        cand = vr + (x[r] - xn) * rem
                        if cand < best:
                            best = cand
                    at_left[nl][r] = best

                nr = r + 1
                if nr < N:
                    xn = x[nr]
                    best = at_right[l][nr]
                    if vl != INF:
                        cand = vl + (xn - x[l]) * rem
                        if cand < best:
                            best = cand
                    if vr != INF:
                        cand = vr + (xn - x[r]) * rem
                        if cand < best:
                            best = cand
                    at_right[l][nr] = best

        a = at_left[0][N - 1]
        b = at_right[0][N - 1]
        return a if a < b else b
```