Let's formulate code elegantly:
```
from bisect import bisect_left

class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        xs = sorted(requests)
        m = len(xs)
        pos = bisect_left(xs, start)
        if pos < m and xs[pos] == start:
            w = [1] * m
        else:
            xs.insert(pos, start)
            w = [1] * pos + [0] + [1] * (m - pos)
        N = len(xs)
        pref = [0] * (N + 1)
        run = 0
        for i, wi in enumerate(w, 1):
            run += wi
            pref[i] = run
        INF = 10 ** 30
        left = [[INF] * N for _ in range(N)]
        right = [[INF] * N for _ in range(N)]
        left[pos][pos] = right[pos][pos] = 0
        x = xs
        for length in range(1, N):
            max_l = N - length
            lo = pos - length + 1
            if lo < 0:
                lo = 0
            hi = pos if pos < max_l else max_l
            pr = pref
            for l in range(lo, hi + 1):
                r = l + length - 1
                rem = m - (pr[r + 1] - pr[l])
                if rem == 0:
                    continue
                vl = left[l][r]
                vr = right[l][r]
                if l:
                    nl = l - 1
                    xn = x[nl]
                    b = left[nl][r]
                    if vl != INF:
                        c = vl + (x[l] - xn) * rem
                        if c < b: b = c
                    if vr != INF:
                        c = vr + (x[r] - xn) * rem
                        if c < b: b = c
                    left[nl][r] = b
                nr = r + 1
                if nr < N:
                    xn = x[nr]
                    b = right[l][nr]
                    if vl != INF:
                        c = vl + (xn - x[l]) * rem
                        if c < b: b = c
                    if vr != INF:
                        c = vr + (xn - x[r]) * rem
                        if c < b: b = c
                    right[l][nr] = b
        return left[0][N - 1] if left[0][N - 1] < right[0][N - 1] else right[0][N - 1]
```
