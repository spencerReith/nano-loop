Let's define:
```
class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        req = sorted(requests)
        m = len(req)
        # locate start
        import bisect
        p = bisect.bisect_left(req, start)
        if p < m and req[p] == start:
            x = req
            w = None # maybe not needed; total=m; prefix of ones -> sw = r-l+1
            pos = p
            N = m
            pref = list(range(N+1))? # pref[i]=i
        else:
            x = req[:p] + [start] + req[p:]
            N = m+1
            pos = p
            pref = [0]*(N+1)
            # weight: real requests=1 dummy=0
            for i in range(p): pref[i+1]=pref[i]+1
            pref[p+1]=pref[p] # dummy
            for i in range(p+1,N): pref[i+1]=pref[i]+1
```
