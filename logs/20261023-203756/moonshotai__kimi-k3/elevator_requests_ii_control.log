```
from bisect import bisect_left

class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        xs = sorted(requests)
        m = len(xs)
        pos = bisect_left(xs, start)
        if pos == m or xs[pos] != start:
            xs.insert(pos, start)
            w = [1] * pos + [0] + [1] * (m - pos)
        else:
            w = [1] * m
        N = m + (w[pos] == 0) # not good because w exists; use len(xs)
        N = len(xs)
        pref = [0]*(N+1)
        for i, wi in enumerate(w, 1): pref[i]=pref[i-1]+wi
        total = m
        INF = 10**30
        dpL = [[INF]*N for _ in range(N)]
        dpR = [[INF]*N for _ in range(N)]
        dpL[pos][pos]=0
        dpR[pos][pos]=0
        x=xs; p=pref
        for length in range(1,N):
            lo = pos-length+1
            if lo<0: lo=0
            hi = pos if pos < N-length else N-length
            # hi = min(pos,N-length)
            for l in range(lo, hi+1):
                r=l+length-1
                rem=total-(p[r+1]-p[l])
                if rem==0: continue
                vL=dpL[l][r]; vR=dpR[l][r]
                if l:
                    nl=l-1; xn=x[nl]
                    # to left, end at left
                    best = dpL[nl][r]
                    if vL < INF:
                        cand=vL + (x[l]-xn)*rem
                        if cand<best: best=cand
                    if vR < INF:
                        cand=vR + (x[r]-xn)*rem
                        if cand<best: best=cand
                    dpL[nl][r]=best
                if r+1<N:
                    nr=r+1; xn=x[nr]
                    best=dpR[l][nr]
                    if vL < INF:
                        cand=vL + (xn-x[l])*rem
                        if cand<best: best=cand
                    if vR < INF:
                        cand=vR + (xn-x[r])*rem
                        if cand<best: best=cand
                    dpR[l][nr]=best
        ans=dpL[0][N-1]
        if dpR[0][N-1]<ans: ans=dpR[0][N-1]
        return ans
```
