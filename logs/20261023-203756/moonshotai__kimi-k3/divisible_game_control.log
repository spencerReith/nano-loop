class Solution:
    def divisibleGame(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        n = len(nums)

        def transformed_val(k):
            base = nums[0] if nums[0] % k == 0 else -nums[0]
            best = base
            cur = base
            for j in range(1, n):
                x = nums[j] if nums[j] % k == 0 else -nums[j]
                if cur + x < x:
                    cur = x
                else:
                    cur += x
                if cur > best:
                    best = cur
            return best

        candidates = {2}
        for x in nums:
            divs = set()
            d = 2
            while d * d <= x:
                if x % d == 0:
                    divs.add(d)
                    divs.add(x // d)
                d += 1
            if x > 1:
                divs.add(x)
            candidates |= divs

        best_diff = None
        chosen_k = None
        for k in sorted(candidates):
            diff = transformed_val(k)
            if best_diff is None or diff > best_diff or (diff == best_diff and k < chosen_k):
                best_diff = diff
                chosen_k = k

        return ((best_diff % MOD) * chosen_k) % MOD
```