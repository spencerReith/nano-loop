class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        odd = (k & 1) == 1
        if odd:
            mod = k
            inv2 = (k + 1) // 2
        else:
            mod = k // 2

        best = 0
        for i in range(n):
            if n - i <= best:
                break

            counts = {}
            total = 0
            for j in range(i, n):
                x = nums[j]
                total += x

                r = x % mod
                counts[r] = counts.get(r, 0) + 1

                ok = (total % k == 0)
                if not ok:
                    if odd:
                        need = (total % k) * inv2 % k
                        if counts.get(need, 0):
                            ok = True
                    else:
                        if total % 2 == 0:
                            need = (total // 2) % mod
                            if counts.get(need, 0):
                                ok = True

                if ok:
                    best = max(best, j - i + 1)

        return best
```