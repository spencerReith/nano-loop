Let me write the code.

```python
class Solution:
    def maxScore(self, nums: list[int], maxVal: int) -> int:
        n = len(nums)
        M = max(maxVal, max(nums))
        
        # count frequency
        cnt = [0] * (M + 1)
        for x in nums:
            cnt[x] += 1
        
        # mult[d] = number of elements divisible by d
        mult = [0] * (M + 1)
        for d in range(1, M + 1):
            for multiple in range(d, M + 1, d):
                mult[d] += cnt[multiple]
        
        # smallest prime factor sieve
        spf = list(range(M + 1))
        for i in range(2, int(M**0.5) + 1):
            if spf[i] == i:
                for j in range(i * i, M + 1, i):
                    if spf[j] == j:
                        spf[j] = i
        
        def distinct_primes(v):
            primes = []
            while v > 1:
                p = spf[v]
                primes.append(p)
                while v % p == 0:
                    v //= p
            return primes
        
        def bad(v):
            # number of elements with gcd(v, element) > 1
            # = n - (number coprime to v)
            # coprime count = sum over squarefree divisors d of v: mu(d) * mult[d]
            primes = distinct_primes(v)
            coprime = 0
            k = len(primes)
            for mask in range(1 << k):
                d = 1
                bits = 0
                for b in range(k):
                    if mask >> b & 1:
                        d *= primes[b]
                        bits += 1
                if bits % 2 == 0:
                    coprime += mult[d]
                else:
                    coprime -= mult[d]
            return n - coprime
        
        ans = -10**18
        # candidate values: 1..maxVal, plus nums values > maxVal
        # For v in 1..maxVal:
        for v in range(1, maxVal + 1):
            b = bad(v)
            if cnt[v] > 0:
                score = v - b + (1 if v > 1 else 0)
            elif b >= 1:
                score = v - b
            else:
                score = v - 1
            if score > ans:
                ans = score
        # For v in nums with v > maxVal:
        seen = set()
        for x in nums:
            if x > maxVal and x not in seen:
                seen.add(x)
                b = bad(x)
                score = x - b + 1  # x > maxVal >= 1 so x > 1
                if score > ans:
                    ans = score
        
        return ans
```

