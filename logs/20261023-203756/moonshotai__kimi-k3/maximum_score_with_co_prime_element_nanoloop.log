from solution import Solution
from math import gcd
import random

def brute(nums, maxVal):
    n = len(nums)
    best = -10**18
    for i in range(n):
        cands = set(range(1, maxVal+1))
        cands.add(nums[i])
        for v in cands:
            cost = 0
            if nums[i] != v:
                cost += 1
            for j in range(n):
                if j == i:
                    continue
                if gcd(v, nums[j]) != 1:
                    cost += 1
            best = max(best, v - cost)
    return best

s = Solution()
print(s.maxScore([3,4,6], 5), "expected", 4)
print(s.maxScore([1,2,3], 4), "expected", 3)
print(s.maxScore([2,2], 1), "expected", 1)

