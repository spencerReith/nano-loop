```python
class Solution:
    def maxScore(self, nums: list[int], maxVal: int) -> int:
        n = len(nums)
        M = max(maxVal, max(nums))
        
        cnt = [0] * (M + 1)
        for x in nums:
            cnt[x] += 1
        
        mult = [0] * (M + 1)
        for d in range(1, M + 1):
            s = 0
            for m in range(d, M + 1, d):
                s += cnt[m]
            mult[d] = s
        
        mu = [0] * (M + 1)
        mu[1] = 1
        primes = []
        is_comp = [False] * (M + 1)
        for i in range(2, M + 1):
            if not is_comp[i]:
                primes.append(i)
                mu[i] = -1
            for p in primes:
                ip = i * p
                if ip > M:
                    break
                is_comp[ip] = True
                if i % p == 0:
                    mu[ip] = 0
                    break
                mu[ip] = -mu[i]
        
        coprime = [0] * (M + 1)
        for d in range(1, M + 1):
            md = mu[d]
            if md:
                contrib = md * mult[d]
                for v in range(d, M + 1, d):
                    coprime[v] += contrib
        
        ans = None
        for v in range(1, maxVal + 1):
            b = n - coprime[v]
            if cnt[v]:
                score = v - b + (1 if v > 1 else 0)
            elif b:
                score = v - b
            else:
                score = v - 1
            if ans is None or score > ans:
                ans = score
        
        seen = set()
        for x in nums:
            if x > maxVal and x not in seen:
                seen.add(x)
                b = n - coprime[x]
                score = x - b + 1
                if score > ans:
                    ans = score
        
        return ans
```

