    nums = [random.randint(1, 20) for _ in range(n)]
    maxVal = random.randint(1, 20)
    got = s.maxScore(nums, maxVal)
    exp = brute(nums, maxVal)
    if got != exp:
        print("MISMATCH", nums, maxVal, got, exp)
        break
else:
    print("all random tests passed")
```

