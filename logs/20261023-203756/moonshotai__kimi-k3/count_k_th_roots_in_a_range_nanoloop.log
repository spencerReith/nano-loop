class Solution:
    def countKthRoots(self, l: int, r: int, k: int) -> int:
        def kth_root_floor(n: int) -> int:
            # Largest x >= 0 such that x^k <= n. Assumes n >= 0.
            lo = 0
            hi = 1
            while pow(hi, k) <= n:
                hi <<= 1

            while lo + 1 < hi:
                mid = (lo + hi) // 2
                if pow(mid, k) <= n:
                    lo = mid
                else:
                    hi = mid
            return lo

        def count_upto(n: int) -> int:
            # Count x >= 0 with x^k <= n.
            if n < 0:
                return 0
            return kth_root_floor(n) + 1

        return count_upto(r) - count_upto(l - 1)
