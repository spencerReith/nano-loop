from functools import lru_cache

class Solution:
    def goodIntegers(self, l: int, r: int, k: int) -> int:
        def count_le(n: int) -> int:
            if n < 10:
                return 0
            
            digits = list(map(int, str(n)))
            length = len(digits)

            # Count good numbers with fewer digits than n
            count = 0
            for i in range(1, length - 1):
                count += 9 * self._get_good_transitions_count(k, i - 1)

            # Digit DP for numbers with the same length as n
            memo = {}
            def dp(pos: int, prev_digit: int, is_tight: bool) -> int:
                if pos == length:
                    return 1
                
                state = (pos, prev_digit, is_tight)
                if state in memo:
                    return memo[state]

                limit = digits[pos] if is_tight else 9
                res = 0
                for d in range(limit + 1):
                    if pos == 0 and d == 0:
                        continue
                    
                    if pos > 0 and abs(d - prev_digit) > k:
                        continue
                    
                    res += dp(pos + 1, d, is_tight and (d == limit))
                
                memo[state] = res
                return res

            count += dp(0, -1, True)
            return count

        return count_le(r) - count_le(l - 1)

    def _get_good_transitions_count(self, k: int, num_transitions: int) -> int:
        """
        Calculates the number of sequences of length `num_transitions + 1` starting with a fixed digit
        such that adjacent digits differ by at most k.
        """
        if num_transitions == 0:
            return 1

        # dp[j] = number of ways to form a sequence of current length ending with digit j
        dp = [1] * 10
        for _ in range(num_transitions):
            next_dp = [0] * 10
            for prev_d in range(10):
                for curr_d in range(10):
                    if abs(prev_d - curr_d) <= k:
                        next_dp[curr_d] += dp[prev_d]
            dp = next_dp
        
        return sum(dp)
