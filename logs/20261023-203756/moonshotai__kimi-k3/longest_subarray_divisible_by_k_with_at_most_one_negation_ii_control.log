class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        # k = 0 makes divisibility by k meaningless; guard for safety
        if k == 0:
            return 0
        
        n = len(nums)
        
        # prefix[i] = sum of nums[0..i-1]  (prefix[0] = 0)
        prefix = [0] * (n + 1)
        for i, v in enumerate(nums):
            prefix[i + 1] = prefix[i] + v
        
        ans = 0
        
        # First occurrence of each prefix-sum remainder (mod k)
        first = {}
        for i in range(n + 1):
            r = prefix[i] % k
            if r in first:
                ans = max(ans, i - first[r])
            else:
                first[r] = i
        
        # For every pair (i, j), i < j, subarray nums[i..j-1] becomes
        # divisible after negating nums[t]  iff
        #   prefix[j] - prefix[i] == 2*nums[t]   (mod k)
        # which only depends on nums[t] % k. Build earliest prefix index
        # achieving each (remainder, nums[t] % k) combination.
        NEG = -10**18
        earliest = [NEG] * (k * k)
        for i in range(n):
            idx = (prefix[i] % k) * k + (nums[i] % k)
            if earliest[idx] == NEG:
                earliest[idx] = i
        
        for j in range(1, n + 1):
            base = (prefix[j] % k) * k
            row = earliest[base:base + k]          # slice for speed
            L = j - ans                            # need start <= j-ans-1 to beat ans
            if L <= 0:
                continue
            for v in range(k):
                e = row[v]
                if e != NEG and e < L:
                    # subarray nums[e..j-1], negate nums[e]
                    ans = j - e
        
        return ans
