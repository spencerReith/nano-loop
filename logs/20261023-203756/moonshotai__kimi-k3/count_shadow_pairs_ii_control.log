Recursion:
```
sys.setrecursionlimit(1_000_000)

def solve(l,r):
    if l>=r:return0
    mid...
    ans=0
    # arrays perhaps local lists limits length
    fw.begin()
    seen=0
    left_items=[]
    for i in range(mid,l-1,-1):
       a=rank[i]
       before=fw.sum(a)
       if before<seen:
          A=fw.kth(before+1)
       else:
          A=m
       left_items.append((A,a)) # order i descending, irrelevant
       fw.add(a,1); seen+=1
    fw.begin()
    right_items=[]
    for j in range(mid+1,r+1):
       b=rank[j]
       cnt=fw.sum(b-1)
       need=fw.kth(cnt) if cnt else -1
       right_items.append((b,need))
       fw.add(b,1)
    # count
    left_items.sort(key=lambda x:x[0], reverse=True)
    right_items.sort(key=lambda x:x[0], reverse=True)
    cf.begin()
    p=0
    L=len(left_items)
    for b,need in right_items:
        while p<L and left_items[p][0] >= b:
            cf.add(left_items[p][1],1); p+=1
        if b>need: # need≤b-1 if valid range; if need=-1 b>-1
            ans += cf.sum(b-1)-cf.sum(need-1)
    return ans+solve(l,mid)+solve(mid+1,r)
```
