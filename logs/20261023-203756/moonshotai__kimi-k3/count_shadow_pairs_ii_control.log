        import sys
        sys.setrecursionlimit(max(1000, 4*n+100))

        def solve(l,r):
           nonlocal? epoch not modified except begin handles
           length=r-l+1
           if length<2:return0
           if length==2:return 1 if a[l]<a[r] else0
           mid...
           begin()
           left=[]
           seen=0
           for i in range(mid,l-1,-1):
              x=a[i]
              before=prefix(x)
              if before<seen:
                 nxt=kth(before+1)
              else: nxt=m
              left.append((nxt,x))
              add(x)
