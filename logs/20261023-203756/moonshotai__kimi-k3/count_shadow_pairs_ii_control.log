```python
import sys

class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        values = sorted(set(nums))
        m = len(values)
        if m == 1:
            return 0
        comp = {v: i for i, v in enumerate(values)}
        rank = [comp[v] for v in nums]

        bit = [0] * (m + 1)
        mark = [0] * (m + 1)
        epoch = 0
        top = 1 << (m.bit_length() - 1)

        def begin():
            nonlocal epoch
            epoch += 1

        def add(pos):
            i = pos + 1
            e = epoch
            while i <= m:
                if mark[i] != e:
                    mark[i] = e
                    bit[i] = 0
                bit[i] += 1
                i += i & -i

        def prefix(pos):
            if pos < 0:
                return 0
            res = 0
            i = pos + 1
            e = epoch
            while i > 0:
                if mark[i] == e:
                    res += bit[i]
                i -= i & -i
            return res

        def kth(k):
            idx = 0
            step = top
            e = epoch
            while step:
                nxt = idx + step
                if nxt <= m:
                    cur = bit[nxt] if mark[nxt] == e else 0
                    if cur < k:
                        idx = nxt
                        k -= cur
                step >>= 1
            return idx

        sys.setrecursionlimit(200000)

        def solve(l, r):
            if l >= r:
                return 0
            if l + 1 == r:
                return 1 if rank[l] < rank[r] else 0

            mid = (l + r) // 2

            begin()
            left = []
            seen = 0
            for i in range(mid, l - 1, -1):
                x = rank[i]
                before = prefix(x)
                limit = kth(before + 1) if before < seen else m
                left.append((limit, x))
                add(x)
                seen += 1

            begin()
            right = []
            for j in range(mid + 1, r + 1):
                y = rank[j]
                cnt = prefix(y - 1)
                need = kth(cnt) if cnt else -1
                if y:
                    right.append((y, need))
                add(y)

            cross = 0
            if right:
                left.sort(reverse=True)
                right.sort(reverse=True)
                begin()
                p = 0
                ln = len(left)
                for y, need in right:
                    while p < ln and left[p][0] >= y:
                        add(left[p][1])
                        p += 1
                    if p:
                        if need < 0:
                            cross += prefix(y - 1)
                        else:
                            cross += prefix(y - 1) - prefix(need - 1)

            left = None
            right = None
            return cross + solve(l, mid) + solve(mid + 1, r)

        return solve(0, n - 1)
```

