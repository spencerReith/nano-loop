Let's write code fully:

```python
import sys

class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        vals = sorted(set(nums))
        m = len(vals)
        if m == 1:
            return 0
        comp = {v:i for i,v in enumerate(vals)}
        rnk = [comp[x] for x in nums]

        bit = [0]*(m+1)
        mark = [0]*(m+1)
        epoch = 0
        top = 1 << (m.bit_length()-1)

        def new_epoch():
            nonlocal epoch
            epoch += 1

        def add(pos: int) -> None:
            i = pos + 1
            e = epoch
            while i <= m:
                if mark[i] != e:
                    mark[i] = e
                    bit[i] = 0
                bit[i] += 1
                i += i & -i

        def pref(pos: int) -> int:
            if pos < 0:
                return 0
            s=0
            i=pos+1
            e=epoch
            while i:
                if mark[i] == e:
                    s += bit[i]
                i -= i & -i
            return s

        def kth(k: int) -> int:
            idx=0
            step=top
            e=epoch
            while step:
                ni=idx+step
                if ni <= m:
                    v = bit[ni] if mark[ni] == e else 0
                    if v < k:
                        idx = ni
                        k -= v
                step >>=1
            return idx
```
One subtle issue: `add` captures `e=epoch` once; epoch doesn't change during add. good. `pref` same.
`kth`: bit/mark closure.

In solve, call `new_epoch`.

```
