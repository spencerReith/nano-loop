Fenwick class with timestamp:
```
class Fenwick:
    __slots__=("n","bit","tag","cur")
    def __init__(n): bit=[0]*(n+1); tag=[0]*(n+1); cur=0
    def begin(self): self.cur+=1
    def _touch(i): if tag[i]!=cur: tag[i]=cur; bit[i]=0
    def add(idx,delta): i=idx+1; while i<=n: touch; bit[i]+=delta; i+=i&-i
    def sum(idx): # inclusive
       res=0; i=idx+1; while i>0: if tag[i]==cur: res+=bit[i]; i-=i&-i
       return res
    def total(self): return self.sum(n-1)
    def kth(k):
       idx=0; step=1<<(self.n.bit_length()-1)
       while step:
          nxt=idx+step
          if nxt<=self.n:
             val=self.bit[nxt] if self.tag[nxt]==self.cur else 0
             if val<k:
                idx=nxt; k-=val
          step>>=1
       return idx # 0-based
```
