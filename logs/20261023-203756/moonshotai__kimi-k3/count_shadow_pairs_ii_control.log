```
`sys.setrecursionlimit` second arg int; `max` okay. Could simply `sys.setrecursionlimit(200000)`.

```
        def solve(l,r):
            if l>=r:return0
            if r==l+1:return 1 if rnk[l]<rnk[r] else 0
            mid=(l+r)//2
            new_epoch()
            left=[]
            seen=0
            for i in range(mid,l-1,-1):
                x=rnk[i]
                before=pref(x)
                limit = kth(before+1) if before<seen else m
                left.append((limit,x))
                add(x)
                seen +=1
            new_epoch()
            right=[]
            for j in range(mid+1,r+1):
                y=rnk[j]
                c=pref(y-1)
                need=kth(c) if c else -1
                if y:
                    right.append((y,need))
                add(y)
            cross=0
            if right:
                left.sort(reverse=True)
                right.sort(reverse=True)
                new_epoch()
                p=0
                L=len(left)
                for y,need in right:
                    while p<L and left[p][0]>=y:
                        add(left[p][1])
                        p+=1
                    if p:
                        if need<0:
                            cross += pref(y-1)
                        else:
                            cross += pref(y-1)-pref(need-1)
            left = None
            right = None
            return cross + solve(l,mid) + solve(mid+1,r)
        return solve(0,n-1)
```

