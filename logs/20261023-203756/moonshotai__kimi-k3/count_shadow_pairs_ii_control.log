Let's write clean code:

```python
from bisect import bisect_left

class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n=len(nums)
        vals=sorted(set(nums))
        comp={v:i for i,v in enumerate(vals)}
        rank=[comp[v] for v in nums]
        m=len(vals)

        size=1
        while size<m:
            size <<=1
        tree=[[] for _ in range(2*size)]
        for pos,r in enumerate(rank):
            node=pos? no r+size
            while node:
                tree[node].append(pos)
                node >>=1

        def first_pos(left_rank, right_rank, min_pos):
            if left_rank > right_rank:
                return n
            l=left_rank+size
            r=right_rank+size
            res=n
            while l<=r:
                if l&1:
                    arr=tree[l]
                    k=bisect_left(arr,min_pos)
                    if k < len(arr):
                        p=arr[k]
                        if p<res:
                            res=p
                            if res==min_pos:
                                return res
                    l+=1
                if not (r&1):
                    arr=tree[r]
                    k=bisect_left(arr,min_pos)
                    if k<len(arr):
                        p=arr[k]
                        if p<res:
                            res=p
                            if res==min_pos:
                                return res
                    r-=1
                l >>=1
                r >>=1
            return res

        ans=0
        for i,a in enumerate(rank):
            lo=a+1
            hi=m-1
            start=i+1
            while lo<=hi:
                p=first_pos(lo,hi,start)
                if p==n:
                    break
                ans+=1
                hi=rank[p]
                start=p+1
        return ans
```

