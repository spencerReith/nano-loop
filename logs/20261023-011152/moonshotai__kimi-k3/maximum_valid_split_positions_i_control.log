from math import gcd

class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)
        # remove one element (or none); array length m = n-1 or n; count valid splits
        # Use prefix gcds for original.
        pre = [0]*(n+1)  # pre[k] gcd nums[:k]
        for i,x in enumerate(nums,1):
            pre[i]=gcd(pre[i-1],x)
        # suffix gcd from i to end
        suf = [0]*(n+1)  # suf[i] = gcd nums[i:]
        for i in range(n-1,-1,-1):
            suf[i]=gcd(suf[i+1],nums[i])

        ans = 0
        # Option not remove: splits i=0..n-2 compare pre[i+1], suf[i+1]
        cnt=0
        for i in range(n-1):
            if pre[i+1]==suf[i+1]:
                cnt+=1
        ans=max(ans,cnt)

        # Try removing index r (0..n-1), m=n-1, require m>=2 => n-1>=2 (n>=3); splits i=0..m-2 map to positions in arr:
        # For arr index j: if j<r -> nums[j]; if j>=r -> nums[j+1]
        # For split after arr index i:
        # left side consists nums[0..i] if i<r; else nums[0..i+1] minus nums[r] = gcd(nums[0..r-1], nums[r+1..i+1])
        # right side starts at arr i+1: if i+1<r => nums[i+1..]; skip r if within range; else nums[i+2..]
        # Simpler compute prefix/suffix for resulting array in O(n) per removal is O(n^2)=1e6 okay n=1000. But do smarter O(n) total? O(n^2) fine.
        for r in range(n):
            m=n-1
            if m<2: 
                continue
            left=0
            # left gcd as we iterate arr positions
            cnt=0
            # Precompute suffix gcds for arr? We can compute on fly from right using original with skip r.
            # Build right gcd array for arr lazily: rgcd[j] = gcd arr[j:]
            rg=[0]*m
            g=0
            for j in range(m-1,-1,-1):
                val = nums[j] if j<r else nums[j+1]
                g=gcd(g,val)
                rg[j]=g
            g=0
            for j in range(m-1):  # split after j
                val = nums[j] if j<r else nums[j+1]
                g=gcd(g,val)
                if g==rg[j+1]:
                    cnt+=1
            ans=max(ans,cnt)
        return ans
