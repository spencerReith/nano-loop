from typing import List

class Solution:
    def maxConsistentColumns(self, grid: List[List[int]], limit: int) -> int:
        m = len(grid)
        n = len(grid[0])
        
        # Precompute pairwise compatibility
        can = [[True] * n for _ in range(n)]
        
        for i in range(n):
            for j in range(i + 1, n):
                compatible = True
                for row in grid:
                    if abs(row[j] - row[i]) > limit:
                        compatible = False
                        break
                can[i][j] = compatible
        
        # DP: longest chain ending at column j
        dp = [1] * n
        
        for j in range(n):
            for i in range(j):
                if can[i][j]:
                    dp[j] = max(dp[j], dp[i] + 1)
        
        return max(dp)
```