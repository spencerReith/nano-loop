import random
from solution import Solution

def brute(nums, queries):
    nums = nums[:]
    ans = []
    n = len(nums)
    for q in queries:
        if q[0] == 1:
            _, l, r = q
            cnt = 0
            for i in range(l, r+1):
                for j in range(i+2, r+1):
                    ok = False
                    for k in range(i+1, j):
                        if nums[k] > nums[k-1] and nums[k] > nums[k+1]:
                            ok = True
                            break
                    if ok:
                        cnt += 1
            ans.append(cnt)
        else:
            _, idx, val = q
            nums[idx] = val
    return ans
