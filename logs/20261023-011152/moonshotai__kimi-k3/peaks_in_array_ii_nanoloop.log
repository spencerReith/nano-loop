```python
from sortedcontainers import SortedList

class Fenwick:
    def __init__(self, n):
        self.n = n
        self.bit = [0] * (n + 1)
    def add(self, i, delta):  # 0-indexed position i
        i += 1
        while i <= self.n:
            self.bit[i] += delta
            i += i & (-i)
    def sum(self, i):  # prefix sum [0, i], 0-indexed
        i += 1
        s = 0
        while i > 0:
            s += self.bit[i]
            i -= i & (-i)
        return s
    def range_sum(self, l, r):  # sum over [l, r]
        if l > r:
            return 0
        return self.sum(r) - self.sum(l - 1)

class Solution:
    def countOfPeaks(self, nums, queries):
        n = len(nums)
        peaks = SortedList()
        bit = Fenwick(n)
        
        def g(a, b):
            # number of (i,j) with a <= i < j <= b, j >= i+2
            d = b - a
            if d < 2:
                return 0
            return d * (d - 1) // 2
        
        def is_peak(k):
            return 1 <= k <= n - 2 and nums[k] > nums[k-1] and nums[k] > nums[k+1]
        
        # build initial peaks
        for k in range(1, n - 1):
            if is_peak(k):
                peaks.add(k)
        
        # build initial segments in BIT
        # segments: [0, p1], [p1, p2], ..., [pm, n-1]
        prev = 0
        for p in peaks:
            bit.add(prev, g(prev, p))
            prev = p
        bit.add(prev, g(prev, n - 1))
        
        def remove_peak(p):
            # find predecessor and successor
            idx = peaks.index(p)
            pp = peaks[idx - 1] if idx > 0 else 0
            nn = peaks[idx + 1] if idx + 1 < len(peaks) else n - 1
            # remove segments [pp, p] and [p, nn], add [pp, nn]
            bit.add(pp, -g(pp, p))
            bit.add(p, -g(p, nn))
            bit.add(pp, g(pp, nn))
            peaks.remove(p)
        
        def add_peak(p):
            idx = peaks.bisect_left(p)
            pp = peaks[idx - 1] if idx > 0 else 0
            nn = peaks[idx] if idx < len(peaks) else n - 1
            # remove segment [pp, nn], add [pp, p] and [p, nn]
            bit.add(pp, -g(pp, nn))
            bit.add(pp, g(pp, p))
            bit.add(p, g(p, nn))
            peaks.add(p)
        
        ans = []
        for q in queries:
            if q[0] == 1:
                _, l, r = q
                length = r - l + 1
                if length < 3:
                    ans.append(0)
                    continue
                total = (length - 1) * (length - 2) // 2
                # a_L = largest peak <= l, or 0
                idxL = peaks.bisect_right(l) - 1
                aL = peaks[idxL] if idxL >= 0 else 0
                # b_L = smallest peak > l, or n-1
                idxB = peaks.bisect_right(l)
                bL = peaks[idxB] if idxB < len(peaks) else n - 1
                # a_R = largest peak <= r, or 0
                idxR = peaks.bisect_right(r) - 1
                aR = peaks[idxR] if idxR >= 0 else 0
                
                if aL == aR:
                    no_peak = g(l, r)
                else:
                    no_peak = g(l, bL) + g(aR, r) + bit.range_sum(aL + 1, aR - 1)
                ans.append(total - no_peak)
            else:
                _, idx, val = q
                # remove affected peaks
                affected = [k for k in (idx - 1, idx, idx + 1) if 1 <= k <= n - 2]
                for k in affected:
                    if k in peaks:
                        remove_peak(k)
                nums[idx] = val
                for k in affected:
                    if is_peak(k):
                        add_peak(k)
        return ans
```

