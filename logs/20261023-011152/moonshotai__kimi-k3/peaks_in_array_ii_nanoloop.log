The solution uses:
- **Complement counting**: answer = (all length≥3 subarrays) − (subarrays containing no peak).
- **Segments** between consecutive peaks: `[0,p₁], [p₁,p₂], ..., [pₘ,n-1]`; a subarray has no peak iff both endpoints lie in one segment.
- A **Fenwick tree** storing each segment's contribution `g(a,b) = (b-a)(b-a-1)/2` keyed by segment start, so full segments inside a query are summed in O(log n); only the two boundary segments are partial.
- A **treap** (since `sortedcontainers` is unavailable) for predecessor/successor peak queries and O(log n) updates. Point updates only affect peak status at `idx-1, idx, idx+1`, causing local segment splits/merges.

```python
import random


class Fenwick:
    def __init__(self, n):
        self.n = n
        self.bit = [0] * (n + 1)

    def add(self, i, delta):
        i += 1
        while i <= self.n:
            self.bit[i] += delta
            i += i & (-i)

    def sum(self, i):
        i += 1
        s = 0
        while i > 0:
            s += self.bit[i]
            i -= i & (-i)
        return s

    def range_sum(self, l, r):
        if l > r:
            return 0
        return self.sum(r) - self.sum(l - 1)


class Treap:
    """Sorted set of ints supporting insert/erase/pred/succ in O(log n)."""

    __slots__ = ("root",)

    class Node:
        __slots__ = ("key", "prio", "left", "right")

        def __init__(self, key):
            self.key = key
            self.prio = random.random()
            self.left = None
            self.right = None

    def __init__(self):
        self.root = None

    def _rotate_right(self, node):
        l = node.left
        node.left = l.right
        l.right = node
        return l

    def _rotate_left(self, node):
        r = node.right
        node.right = r.left
        r.left = node
        return r

    def insert(self, key):
        def _insert(node, key):
            if node is None:
                return Treap.Node(key)
            if key < node.key:
                node.left = _insert(node.left, key)
                if node.left.prio < node.prio:
                    node = self._rotate_right(node)
            elif key > node.key:
                node.right = _insert(node.right, key)
                if node.right.prio < node.prio:
                    node = self._rotate_left(node)
            return node

        self.root = _insert(self.root, key)

    def erase(self, key):
        def _erase(node, key):
            if node is None:
                return None
            if key < node.key:
                node.left = _erase(node.left, key)
            elif key > node.key:
                node.right = _erase(node.right, key)
            else:
                if node.left is None:
                    return node.right
                if node.right is None:
                    return node.left
                if node.left.prio < node.right.prio:
                    node = self._rotate_right(node)
                    node.right = _erase(node.right, key)
                else:
                    node = self._rotate_left(node)
                    node.left = _erase(node.left, key)
            return node

        self.root = _erase(self.root, key)

    def contains(self, key):
        node = self.root
        while node:
            if key < node.key:
                node = node.left
            elif key > node.key:
                node = node.right
            else:
                return True
        return False

    def pred_le(self, key):
        """Largest element <= key, or None."""
        node = self.root
        res = None
        while node:
            if node.key <= key:
                res = node.key
                node = node.right
            else:
                node = node.left
        return res

    def succ_gt(self, key):
        """Smallest element > key, or None."""
        node = self.root
        res = None
        while node:
            if node.key > key:
                res = node.key
                node = node.left
            else:
                node = node.right
        return res

    def pred_lt(self, key):
        """Largest element < key, or None."""
        node = self.root
        res = None
        while node:
            if node.key < key:
                res = node.key
                node = node.right
            else:
                node = node.left
        return res


class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums)
        peaks = Treap()
        bit = Fenwick(n)

        def g(a, b):
            # number of (i, j) with a <= i < j <= b and j >= i + 2
            d = b - a
            if d < 2:
                return 0
            return d * (d - 1) // 2

        def is_peak(k):
            return 1 <= k <= n - 2 and nums[k] > nums[k - 1] and nums[k] > nums[k + 1]

        # initial peaks
        init = [k for k in range(1, n - 1) if is_peak(k)]
        for k in init:
            peaks.insert(k)

        # initial segments: [0, p1], [p1, p2], ..., [pm, n-1]
        prev = 0
        for p in init:
            bit.add(prev, g(prev, p))
            prev = p
        bit.add(prev, g(prev, n - 1))

        def remove_peak(p):
            pp = peaks.pred_lt(p)
            pp = pp if pp is not None else 0
            nn = peaks.succ_gt(p)
            nn = nn if nn is not None else n - 1
            bit.add(pp, -g(pp, p))
            bit.add(p, -g(p, nn))
            bit.add(pp, g(pp, nn))
            peaks.erase(p)

        def add_peak(p):
            pp = peaks.pred_lt(p)
            pp = pp if pp is not None else 0
            nn = peaks.succ_gt(p)
            nn = nn if nn is not None else n - 1
            bit.add(pp, -g(pp, nn))
            bit.add(pp, g(pp, p))
            bit.add(p, g(p, nn))
            peaks.insert(p)

        ans = []
        for q in queries:
            if q[0] == 1:
                _, l, r = q
                length = r - l + 1
                if length < 3:
                    ans.append(0)
                    continue
                total = (length - 1) * (length - 2) // 2

                aL = peaks.pred_le(l)
                aL = aL if aL is not None else 0
                bL = peaks.succ_gt(l)
                bL = bL if bL is not None else n - 1
                aR = peaks.pred_le(r)
                aR = aR if aR is not None else 0

                if aL == aR:
                    no_peak = g(l, r)
                else:
                    no_peak = g(l, bL) + g(aR, r) + bit.range_sum(aL + 1, aR - 1)
                ans.append(total - no_peak)
            else:
                _, idx, val = q
                affected = [k for k in (idx - 1, idx, idx + 1) if 1 <= k <= n - 2]
                for k in affected:
                    if peaks.contains(k):
                        remove_peak(k)
                nums[idx] = val
                for k in affected:
                    if is_peak(k):
                        add_peak(k)
        return ans
```