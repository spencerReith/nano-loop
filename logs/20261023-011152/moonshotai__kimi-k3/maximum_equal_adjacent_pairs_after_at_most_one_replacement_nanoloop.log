```python
from collections import Counter

class Solution:
    def maxEqualPairs(self, nums: list[int]) -> int:
        base = 0
        pair_counts = Counter()
        for a, b in zip(nums, nums[1:]):
            if a == b:
                base += 1
            else:
                if a > b:
                    a, b = b, a
                pair_counts[(a, b)] += 1
        return base + (max(pair_counts.values()) if pair_counts else 0)
```

