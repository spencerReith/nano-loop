1. For each candidate array (no removal + each single removal), computes prefix and suffix GCDs
2. Counts split positions where `prefix_gcd[i] == suffix_gcd[i+1]`
3. Returns the maximum count

This runs in O(n²) time with O(n) space per check.

```python
from math import gcd

class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)

        def count_splits(arr):
            m = len(arr)
            if m < 2:
                return 0
            pre = [0] * m
            suf = [0] * m
            g = 0
            for i in range(m):
                g = gcd(g, arr[i])
                pre[i] = g
            g = 0
            for i in range(m - 1, -1, -1):
                g = gcd(g, arr[i])
                suf[i] = g
            cnt = 0
            for i in range(m - 1):
                if pre[i] == suf[i + 1]:
                    cnt += 1
            return cnt

        best = count_splits(nums)
        for r in range(n):
            arr = nums[:r] + nums[r + 1:]
            c = count_splits(arr)
            if c > best:
                best = c
        return best
```