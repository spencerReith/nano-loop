Implementation details:
```
class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        V = 500
        cnt = [0]*(V+1)
        viol = 0
        left = 0
        ans = 0

        def contribution(x: int) -> int:
            total = 0
            cx = cnt[x]
            # x as one of the addends
            # y is the other addend; each unordered pair {x,y} counted once by y.
            for y in range(1, V+1):
                if y == x:
                    c = x + x
                    if c <= V and cx >= 2 and cnt[c] > 0:
                        total += 1
                else:
                    c = x + y
                    if c <= V and cx > 0 and cnt[y] > 0 and cnt[c] > 0:
                        total += 1
            # x as the sum
            if cx > 0:
                for a in range(1, x//2 + 1):
                    b = x - a
                    if a == b:
                        if cnt[a] >= 2:
                            total += 1
                    else:
                        if cnt[a] > 0 and cnt[b] > 0:
                            total += 1
            return total

        def change(x: int, d: int) -> None:
            nonlocal viol
            before = contribution(x)
            cnt[x] += d
            after = contribution(x)
            viol += after - before

        for right, x in enumerate(nums):
            change(x, 1)
            while viol > 0:
                change(nums[left], -1)
                left += 1
            if right-left+1 > ans: ans = right-left+1
        return ans
```
