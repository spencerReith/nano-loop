class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        V = 500
        cnt = [0] * (V + 1)
        violations = 0
        left = 0
        ans = 0

        def contribution(x: int) -> int:
            """Number of forbidden unordered value-pairs whose validity involves value x."""
            total = 0
            cx = cnt[x]

            # x is one of the two addends: x + y = c. Only c <= V can matter.
            limit = V - x
            for y in range(1, limit + 1):
                c = x + y
                if cnt[c] == 0:
                    continue
                if y == x:
                    if cx >= 2:
                        total += 1
                elif cx > 0 and cnt[y] > 0:
                    total += 1

            # x is the sum: a + b = x, with a <= b.
            if cx > 0:
                for a in range(1, x // 2 + 1):
                    b = x - a
                    if a == b:
                        if cnt[a] >= 2:
                            total += 1
                    elif cnt[a] > 0 and cnt[b] > 0:
                        total += 1

            return total

        def change(x: int, delta: int) -> None:
            nonlocal violations
            before = contribution(x)
            cnt[x] += delta
            after = contribution(x)
            violations += after - before

        for right, x in enumerate(nums):
            change(x, 1)
            while violations > 0:
                change(nums[left], -1)
                left += 1
            ans = max(ans, right - left + 1)

        return ans
```