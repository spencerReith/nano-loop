class Solution:
    def maxValue(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return nums[0]
        
        # Original pulse value
        base = 0
        for i, x in enumerate(nums):
            base += x if i % 2 == 0 else -x
        
        ans = base
        
        # Left-rotating nums[l..r] by one moves nums[l] to position r,
        # and shifts nums[l+1..r] one position left.
        # Delta in pulse value:
        #   For k in [l+1, r], nums[k] moves from index k to k-1, so its sign flips.
        #   Contribution change for those: sum_{k=l+1}^{r} (-2) * sign(k) * nums[k]
        #     where sign(k) = +1 if k even else -1.
        #   nums[l] moves from index l (sign s) to index r (sign s * (-1)^(r-l)).
        #   Change for nums[l]: nums[l] * (sign(r) - sign(l)).
        #
        # Let t[k] = nums[k] if k even else -nums[k]  (signed pulse coefficient).
        # Then delta = -2 * sum_{k=l+1}^{r} t[k] + nums[l] * (sign(r) - sign(l)).
        # sign(r) - sign(l) = 0 if (r-l) even, else -2*sign(l).
        # So if (r-l) odd: delta = -2 * sum_{k=l+1}^{r} t[k] - 2 * t[l]
        #                        = -2 * sum_{k=l}^{r} t[k].
        # If (r-l) even: delta = -2 * sum_{k=l+1}^{r} t[k].
        
        # We want max delta over all l < r.
        # Case A: (r - l) odd  -> delta = -2 * sum_{k=l}^{r} t[k]
        # Case B: (r - l) even -> delta = -2 * sum_{k=l+1}^{r} t[k]
        
        # Both reduce to: maximize -2 * (subarray sum of t) over subarrays,
        # with parity/length constraints. Equivalently minimize subarray sum of t.
        # Case A: subarray t[l..r] with odd length (r-l+1 even? r-l odd => length even).
        #   length = r - l + 1, r - l odd => length even. Min length 2.
        # Case B: subarray t[l+1..r] with (r-l) even => length = r-l, even. Min length 2.
        #   Let a = l+1, b = r, subarray t[a..b] with (b - a) odd => length even. Min length 2.
        # Both cases: choose a subarray of t of EVEN length (>=2), minimize its sum,
        # delta = -2 * min_sum.
        
        # So answer = base + max(0, -2 * (minimum even-length subarray sum of t)).
        # Minimum even-length subarray sum: use prefix sums.
        # sum t[i..j] (inclusive, length even) = P[j+1] - P[i], where (j+1 - i) even,
        # i.e., P indices have same parity. Minimize P[b] - P[a] with b > a, b and a same parity.
        # For each b, min P[a] over a < b with a % 2 == b % 2.
        
        t = [nums[i] if i % 2 == 0 else -nums[i] for i in range(n)]
        
        INF = float('inf')
        # min prefix sum seen for each parity, for indices a < b
        min_pref = [INF, INF]
        pref = 0
        min_even_sub = INF  # minimum subarray sum with even length >= 2
        
        # prefix sums P[0..n], P[0] = 0. b ranges from 2..n (need a < b, same parity,
        # smallest b with a valid a is b=2, a=0).
        # We iterate b from 0..n, but only query when b >= 2.
        # min_pref should contain P[a] for a <= b-2 (same parity), ensuring a < b and
        # since same parity and a != b, a <= b-2 automatically.
        
        # Initialize: before b=2, we need P[0] in min_pref[0].
        # Let's iterate b from 0 to n, computing P[b], and:
        #   - query using min_pref[b%2] (which holds P[a] for a <= b-2 same parity)
        #   - then add P[b] to min_pref? No—adding P[b] would allow a=b.
        # We add P[b] to min_pref AFTER processing b+... simpler: add P[b] for use by
        # future b' >= b+2. So at step b, first query, then insert P[b].
        # But inserting P[b] then querying b+1 would wrongly use a=b (length 1, odd).
        # Since parity differs for b+1, min_pref[(b+1)%2] doesn't include P[b] anyway.
        # For b+2 same parity, a=b is valid (length 2). Good.
        # However at b=0: query min_pref[0] which is INF (no a<0), fine. Insert P[0]=0.
        # At b=1: query min_pref[1] = INF. Insert P[1].
        # At b=2: query min_pref[0] = P[0]. Valid a=0, length 2. 
        
        for b in range(n + 1):
            if b > 0:
                pref += t[b - 1]
            p = b & 1
            if min_pref[p] != INF:
                cand = pref - min_pref[p]
                if cand < min_even_sub:
                    min_even_sub = cand
            if pref < min_pref[p]:
                min_pref[p] = pref
        
        if min_even_sub < 0:
            ans = base + (-2) * min_even_sub
        
        return ans
