class Solution:
    def maxPrimes(self, n: int, s: int) -> list[int]:
        # Sieve of Eratosthenes to find all primes <= n
        is_prime = [True] * (n + 1)
        if n >= 0:
            is_prime[0] = False
        if n >= 1:
            is_prime[1] = False
        
        for i in range(2, int(n ** 0.5) + 1):
            if is_prime[i]:
                for j in range(i * i, n + 1, i):
                    is_prime[j] = False
        
        primes = [i for i in range(2, n + 1) if is_prime[i]]
        
        if not primes:
            return []
        
        # Find maximum k such that sum of k smallest primes <= s
        # Also compute prefix sums
        prefix_sum = [0]  # prefix_sum[i] = sum of first i primes
        for p in primes:
            prefix_sum.append(prefix_sum[-1] + p)
        
        max_k = 0
        for k in range(len(primes) + 1):
            if prefix_sum[k] <= s:
                max_k = k
            else:
                break
        
        if max_k == 0:
            return []
        
        # Lexicographically largest selection with max_k primes and sum <= s
        # We need to choose max_k primes. Start with first max_k primes.
        # Try to replace with larger primes greedily from the right.
        
        selected = primes[:max_k]
        current_sum = prefix_sum[max_k]
        
        # Try to increase the last element, then second-to-last, etc.
        for i in range(max_k - 1, -1, -1):
            # The positions after i are already as large as possible
            # We want to increase selected[i] to the largest possible prime
            # such that we can still complete the selection
            
            # Sum of elements after position i (they don't change)
            suffix_sum = sum(selected[i+1:])
            
            # We need selected[i] < selected[i+1] (if i+1 < max_k)
            # and new_sum = prefix_sum[i] (sum of first i selected) + new_val + suffix_sum <= s
            
            upper_bound = primes[-1] if i == max_k - 1 else selected[i + 1] - 1
            lower_bound = selected[i] + 1
            
            # Find the largest prime in range [lower_bound, upper_bound]
            # such that prefix_sum[i] + new_val + suffix_sum <= s
            
            max_val_allowed = s - prefix_sum[i] - suffix_sum
            upper_bound = min(upper_bound, max_val_allowed)
            
            if lower_bound <= upper_bound:
                # Binary search for the largest prime <= upper_bound that is >= lower_bound
                lo, hi = 0, len(primes) - 1
                best = -1
                while lo <= hi:
                    mid = (lo + hi) // 2
                    if primes[mid] <= upper_bound:
                        if primes[mid] >= lower_bound:
                            best = primes[mid]
                        lo = mid + 1
                    else:
                        hi = mid - 1
                
                if best != -1:
                    selected[i] = best
        
        return selected
