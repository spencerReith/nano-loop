class Solution:
    def kthDigit(self, k: int) -> int:
        d = 1  # number of digits in current range
        first = 1  # first number in current range
        count = 9  # count of numbers with d digits
        
        # Find the range of d-digit numbers containing the kth digit
        while k > d * count:
            k -= d * count
            d += 1
            first *= 10
            count *= 10
        
        # Find the specific block (each block has 10 numbers)
        block_index = (k - 1) // (d * 10)
        block_start = first + block_index * 10
        
        # Position within the block (0-indexed)
        pos_in_block = (k - 1) % (d * 10)
        
        # For odd blocks, reverse the order
        if block_index % 2 == 1:
            num_index_in_block = 9 - (pos_in_block // d)
        else:
            num_index_in_block = pos_in_block // d
        
        # Get the specific number
        num = block_start + num_index_in_block
        
        # Get the digit within that number
        digit_index = pos_in_block % d
        
        return int(str(num)[digit_index])
