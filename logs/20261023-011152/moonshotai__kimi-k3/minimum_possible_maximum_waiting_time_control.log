from functools import lru_cache

class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        n = len(demand)
        F0, F1 = fuel
        total = sum(demand)

        # -------------------------------------------------
        # 1. Maximum number of cars that can be served
        # -------------------------------------------------
        @lru_cache(None)
        def can_serve(i: int, r0: int, r1: int) -> bool:
            """Can we serve cars i..n-1 with remaining fuel (r0,r1)?"""
            if i == n:
                return True
            d = demand[i]
            nxt = False
            if r0 >= d:
                nxt |= can_serve(i + 1, r0 - d, r1)
            if r1 >= d:
                nxt |= can_serve(i + 1, r0, r1 - d)
            return nxt

        max_served = 0
        for k in range(n):
            if can_serve(k, F0, F1):
                max_served = n - k
                break

        if max_served == 0:
            return -1

        # -------------------------------------------------
        # 2. For a candidate waiting limit W, can we serve
        #    exactly `max_served` cars with max wait <= W ?
        # -------------------------------------------------
        @lru_cache(None)
        def feasible(i: int, t: int, r0: int, r1: int, f0: int, f1: int,
                     served: int) -> bool:
            """
            i      : next car index
            t      : current time (when car i becomes allowed)
            r0,r1  : remaining fuel
            f0,f1  : times when dispensers become free
            served : cars served so far
            """
            if served == max_served:
                return True
            if i == n:
                return False

            d = demand[i]
            # try dispenser 0
            if r0 >= d:
                start = max(t, f0)
                if start - t <= W:
                    if feasible(i + 1, start, r0 - d, r1,
                                start + d, f1, served + 1):
                        return True
            # try dispenser 1
            if r1 >= d:
                start = max(t, f1)
                if start - t <= W:
                    if feasible(i + 1, start, r0, r1 - d,
                                f0, start + d, served + 1):
                        return True
            return False

        # -------------------------------------------------
        # 3. Binary search on the answer
        # -------------------------------------------------
        lo, hi = 0, total  # waiting time never exceeds total demand
        ans = hi
        while lo <= hi:
            mid = (lo + hi) // 2
            W = mid
            feasible.cache_clear()          # W is captured from outer scope
            if feasible(0, 0, F0, F1, 0, 0, 0):
                ans = mid
                hi = mid - 1
            else:
                lo = mid + 1

        return ans
