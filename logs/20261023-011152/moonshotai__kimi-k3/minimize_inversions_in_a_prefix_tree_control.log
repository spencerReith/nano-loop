from bisect import bisect_left, insort

class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n = len(words)
        pos = [0] * n
        for p, idx in enumerate(target):
            pos[idx] = p

        # Build the trie.
        children = [{}]
        mark = [-1]

        for idx, word in enumerate(words):
            u = 0
            for ch in word:
                v = children[u].get(ch)
                if v is None:
                    v = len(children)
                    children[u][ch] = v
                    children.append({})
                    mark.append(-1)
                u = v
            mark[u] = pos[idx]

        bit_index = [0] * 1024
        for b in range(10):
            bit_index[1 << b] = b

        INF = 10**18

        def min_cross(cost: list[list[int]]) -> int:
            """
            cost[i][j] = inversions between blocks i and j if block i
            is placed completely before block j.
            Since there are at most 10 children, use subset DP.
            """
            k = len(cost)
            if k == 2:
                return min(cost[0][1], cost[1][0])

            m = 1 << k

            # before[i][mask] = sum(cost[j][i] for j in mask)
            before = [[0] * m for _ in range(k)]
            rk = range(k)

            for mask in range(1, m):
                lb = mask & -mask
                j = bit_index[lb]
                prev = mask ^ lb
                cj = cost[j]
                for i in rk:
                    before[i][mask] = before[i][prev] + cj[i]

            dp = [0] * m
            for mask in range(1, m):
                best = INF
                bits = mask
                while bits:
                    lb = bits & -bits
                    i = bit_index[lb]
                    prev = mask ^ lb
                    val = dp[prev] + before[i][prev]
                    if val < best:
                        best = val
                    bits ^= lb
                dp[mask] = best

            return dp[m - 1]

        def dfs(u: int) -> tuple[int, list[int]]:
            """
            Returns:
                minimum inversions inside this subtree,
                sorted list of target-ranks in this subtree.
            """
            r = mark[u]
            child_map = children[u]

            if not child_map:
                return (0, [r]) if r >= 0 else (0, [])

            if len(child_map) == 1:
                v = next(iter(child_map.values()))
                total, ranks = dfs(v)
            else:
                total = 0
                child_ranks = []

                for v in child_map.values():
                    sub_total, sub_ranks = dfs(v)
                    total += sub_total
                    child_ranks.append(sub_ranks)

                k = len(child_ranks)

                # Pack rank and child color into one integer for faster sorting.
                packed = [
                    (x << 4) | ci
                    for ci, ranks_list in enumerate(child_ranks)
                    for x in ranks_list
                ]
                packed.sort()

                # Scan ranks increasingly. All previously seen ranks are smaller.
                cost = [[0] * k for _ in range(k)]
                seen = [0] * k

                for p in packed:
                    ci = p & 15
                    row = cost[ci]
                    for cj, cnt in enumerate(seen):
                        if cnt and cj != ci:
                            row[cj] += cnt
                    seen[ci] += 1

                total += min_cross(cost)
                ranks = [p >> 4 for p in packed]

            # A marked node is visited before all its descendants.
            if r >= 0:
                total += bisect_left(ranks, r)
                insort(ranks, r)

            return total, ranks

        return dfs(0)[0]
```