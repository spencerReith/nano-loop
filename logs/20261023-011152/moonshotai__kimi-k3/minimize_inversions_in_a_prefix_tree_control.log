Pseudo:

class Solution:
    def minInversions(self, words, target):
        pos=[0]*len(words)
        for p,i in enumerate(target): pos[i]=p
        children=[{}]
        mark=[-1]
        for i,w in enumerate(words):
            node=0
            for ch in w:
                d=children[node]
                if ch not in d:
                    d[ch]=len(children)
                    children.append({})
                    mark.append(-1)
                node=d[ch]
            mark[node]=pos[i]

        sys.setrecursionlimit maybe.

        def dfs(u):
            child_lists=[]
            child_invs=[]
            for v in children[u].values():
                inv,lst=dfs(v)
                child_invs.append(inv)
                child_lists.append(lst)
            total=sum(child_invs)
            r=mark[u]
            if r!=-1:
                # count desc less
                less=0
                for lst in child_lists:
                    less += bisect_left(lst,r)
                total += less
            k=len(child_lists)
            if k>=2:
                # pair costs
                items=[]
                for ci,lst in enumerate(child_lists):
                    items.extend((rank, ci) for rank in lst)
                items.sort() # sort by rank then color irrelevant
                cost=[[0]*k for _ in range(k)]
                cnt=[0]*k
                for rank,ci in items:
                    # all prior items have lower rank
                    # for each d != ci, cnt[d] pairs ci > d => cost[ci][d]
                    row=cost[ci]
                    # local loop over d
                    for d,c in enumerate(cnt):
                        if d != ci:
                            row[d] += c
                    cnt[ci]+=1
                # subset dp
                m=1<<k
                dp=[inf]*m; dp[0]=0
                # Precompute before_cost_to_i? transition can sum bits.
                for mask in range(1,m):
                    # choose last i
                    best=inf
                    sub=mask
                    # iterate i bits
                    while sub:
                        bit=sub & -sub
                        i=bit.bit_length()-1
                        prev=mask^bit
                        # sum cost[j][i] for j in prev
                        s=dp[prev]
                        # loop j bits
                        jj=prev
                        col? cost[j][i]
                        while jj:
                            b=jj&-jj; j=b.bit_length()-1
                            s += cost[j][i]
                            jj-=b
                        if s<best: best=s
                        sub-=bit
                    dp[mask]=best
                total += dp[m-1]
                # merge lists small-to-large
                base_idx=max(range(k), key=lambda i: len(child_lists[i]))
                base=child_lists[base_idx]
                for i,lst in enumerate(child_lists):
                    if i!=base_idx:
                        for x in lst:
                            insort(base,x)
                merged=base
            elif k==1:
                merged=child_lists[0]
            else:
                merged=[]
            if r!=-1:
                insort(merged,r)
            return total, merged
