```
from bisect import bisect_left, insort

class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n=len(words)
        pos=[0]*n
        for p,idx in enumerate(target):
            pos[idx]=p

        children=[{}]
        marked=[-1]
        for i,w in enumerate(words):
            u=0
            for ch in w:
                nxt=children[u].get(ch)
                if nxt is None:
                    nxt=len(children)
                    children[u][ch]=nxt
                    children.append({})
                    marked.append(-1)
                u=nxt
            marked[u]=pos[i]

        INF=10**18

        def min_cross(cost):
            k=len(cost)
            if k==2:
                return cost[0][1] if cost[0][1] <= cost[1][0] else cost[1][0]
            m=1<<k
            add=[[0]*m for _ in range(k)]
            rng=range(k)
            for mask in range(1,m):
                lb=mask & -mask
                j=lb.bit_length()-1
                prev=mask ^ lb
                row=cost[j]
                for i in rng:
                    add[i][mask] = add[i][prev] + row[i]
            dp=[0]*m
            for mask in range(1,m):
                best=INF
                bits=mask
                while bits:
                    lb=bits & -bits
                    i=lb.bit_length()-1
                    prev=mask ^ lb
                    val=dp[prev] + add[i][prev]
                    if val<best:
                        best=val
                    bits ^= lb
                dp[mask]=best
            return dp[m-1]

        def dfs(u):
            r=marked[u]
            childs=children[u]
            if not childs:
                if r<0:
                    return 0,[]
                return 0,[r]
            if len(childs)==1:
                v=next(iter(childs.values()))
                total, ranks=dfs(v)
            else:
                total=0
                child_ranks=[]
                for v in childs.values():
                    inv,lst=dfs(v)
                    total += inv
                    child_ranks.append(lst)
                k=len(child_ranks)
                items=[]
                for ci,lst in enumerate(child_ranks):
                    items.extend((x,ci) for x in lst)
                items.sort()
                cost=[[0]*k for _ in range(k)]
                seen=[0]*k
                for x,ci in items:
                    row=cost[ci]
                    for d,c in enumerate(seen):
                        if c and d != ci:
                            row[d] += c
                    seen[ci]+=1
                total += min_cross(cost)
                ranks=[x for x,_ in items]
            if r>=0:
                total += bisect_left(ranks,r)
                insort(ranks,r)
            return total,ranks

        return dfs(0)[0]
```

