Full final code with comments:

```
from bisect import bisect_left, insort

class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        pos = [0] * len(words)
        for p, i in enumerate(target):
            pos[i] = p

        children = [{}]
        mark = [-1]
        for i, w in enumerate(words):
            u = 0
            for ch in w:
                v = children[u].get(ch)
                if v is None:
                    v = len(children)
                    children[u][ch] = v
                    children.append({})
                    mark.append(-1)
                u = v
            mark[u] = pos[i]

        bit_no = [0] * 1024
        for b in range(10):
            bit_no[1 << b] = b
        INF = 10 ** 18

        def optimal_child_cross(cost):
            k = len(cost)
            if k == 2:
                return min(cost[0][1], cost[1][0])
            m = 1 << k
            before = [[0] * m for _ in range(k)]
            for mask in range(1, m):
                lb = mask & -mask
                j = bit_no[lb]
                prev = mask ^ lb
                cj = cost[j]
                for i in range(k):
                    before[i][mask] = before[i][prev] + cj[i]
            dp = [0] * m
            for mask in range(1, m):
                best = INF
                bits = mask
                while bits:
                    lb = bits & -bits
                    i = bit_no[lb]
                    prev = mask ^ lb
                    val = dp[prev] + before[i][prev]
                    if val < best:
                        best = val
                    bits ^= lb
                dp[mask] = best
            return dp[-1]

        def dfs(u):
            r = mark[u]
            childs = children[u]
            if not childs:
                return (0, [r]) if r >= 0 else (0, [])
            if len(childs) == 1:
                v = next(iter(childs.values()))
                total, ranks = dfs(v)
            else:
                total = 0
                lists = []
                for v in childs.values():
                    sub_inv, sub_ranks = dfs(v)
                    total += sub_inv
                    lists.append(sub_ranks)

                k = len(lists)
                items = [(x, i) for i, lst in enumerate(lists) for x in lst]
                items.sort()

                cost = [[0] * k for _ in range(k)]
                seen = [0] * k
                for x, i in items:
                    row = cost[i]
                    for j, cnt in enumerate(seen):
                        if cnt and j != i:
                            row[j] += cnt
                    seen[i] += 1

                total += optimal_child_cross(cost)
                ranks = [x for x, _ in items]

            if r >= 0:
                total += bisect_left(ranks, r)
                insort(ranks, r)
            return total, ranks

        return dfs(0)[0]
```

