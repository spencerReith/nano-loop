def min_cross(cost):
    k=len(cost)
    if k==2:
        a=cost[0][1]; b=cost[1][0]
        return a if a<b else b
    m=1<<k
    add=[[0]*m for _ in range(k)]
    for mask in range(1,m):
        lb=mask & -mask
        j=lb.bit_length()-1
        prev=mask ^ lb
        cj=cost[j]
        for i in range(k):
            add[i][mask] = add[i][prev] + cj[i]
    dp=[0]*m
    for mask in range(1,m):
        best=10**18
        mm=mask
        while mm:
            lb=mm & -mm
            i=lb.bit_length()-1
            prev=mask ^ lb
            val=dp[prev] + add[i][prev]
            if val<best: best=val
            mm ^= lb
        dp[mask]=best
    return dp[m-1]
```
