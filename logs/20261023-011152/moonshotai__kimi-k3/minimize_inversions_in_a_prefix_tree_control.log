from bisect import bisect_left, insort

def dfs(u):
    lists=[]
    total=0
    for v in children[u].values():
        inv,lst=dfs(v)
        total += inv
        lists.append(lst)
    k=len(lists)
    r=mark[u]
    if k==0:
       merged=[]
    elif k==1:
       merged=lists[0]
    else:
       items=[]
       for ci,lst in enumerate(lists):
           items.extend((x,ci) for x in lst)
       items.sort()
       cost=[[0]*k for _ in range(k)]
       cnt=[0]*k
       for x,ci in items:
           row=cost[ci]
           # unroll? for d in range(k): if d!=ci row[d]+=cnt[d]
           for d,c in enumerate(cnt):
               if c and d != ci: row[d]+=c
           cnt[ci]+=1
       total += order_cost(cost)
       merged=[x for x,_ in items]
    if r>=0:
       total += bisect_left(merged,r)
       insort(merged,r)
    return total, merged
```
