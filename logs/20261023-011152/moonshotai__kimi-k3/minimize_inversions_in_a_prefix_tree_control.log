from bisect import bisect_left, insort

class Solution:
    def minInversions(self, words: list[str], target: list[int]) -> int:
        n = len(words)
        pos = [0] * n
        for p, idx in enumerate(target):
            pos[idx] = p

        children = [{}]
        mark = [-1]
        for idx, word in enumerate(words):
            u = 0
            for ch in word:
                v = children[u].get(ch)
                if v is None:
                    v = len(children)
                    children[u][ch] = v
                    children.append({})
                    mark.append(-1)
                u = v
            mark[u] = pos[idx]

        bit_index = [0] * 1024
        for b in range(10):
            bit_index[1 << b] = b

        INF = 10 ** 18

        def min_block_cross(cost):
            k = len(cost)
            if k == 2:
                return cost[0][1] if cost[0][1] < cost[1][0] else cost[1][0]
            size = 1 << k
            before = [[0] * size for _ in range(k)]
            rk = range(k)
            for mask in range(1, size):
                lb = mask & -mask
                j = bit_index[lb]
                prev = mask ^ lb
                cj = cost[j]
                for i in rk:
                    before[i][mask] = before[i][prev] + cj[i]

            dp = [0] * size
            for mask in range(1, size):
                best = INF
                bits = mask
                while bits:
                    lb = bits & -bits
                    i = bit_index[lb]
                    prev = mask ^ lb
                    val = dp[prev] + before[i][prev]
                    if val < best:
                        best = val
                    bits ^= lb
                dp[mask] = best
            return dp[size - 1]

        def dfs(u):
            r = mark[u]
            child_map = children[u]

            if not child_map:
                return (0, [r]) if r >= 0 else (0, [])

            if len(child_map) == 1:
                child = next(iter(child_map.values()))
                total, ranks = dfs(child)
            else:
                total = 0
                child_lists = []
                for child in child_map.values():
                    sub_total, sub_ranks = dfs(child)
                    total += sub_total
                    child_lists.append(sub_ranks)

                k = len(child_lists)
                packed = [(x << 4) | ci
                          for ci, lst in enumerate(child_lists)
                          for x in lst]
                packed.sort()

                cost = [[0] * k for _ in range(k)]
                seen = [0] * k
                for p in packed:
                    ci = p & 15
                    row = cost[ci]
                    for cj, cnt in enumerate(seen):
                        if cnt and cj != ci:
                            row[cj] += cnt
                    seen[ci] += 1

                total += min_block_cross(cost)
                ranks = [p >> 4 for p in packed]

            if r >= 0:
                total += bisect_left(ranks, r)
                insort(ranks, r)
            return total, ranks

        return dfs(0)[0]
```

