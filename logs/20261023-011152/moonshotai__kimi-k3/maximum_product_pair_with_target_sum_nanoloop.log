class Solution:
    def maxProductPair(self, nums: list[int], target: int) -> list[int]:
        n = len(nums)
        best = [-1, -1]
        best_prod = None
        for i in range(n):
            for j in range(n):
                if i == j:
                    continue
                if nums[i] + nums[j] != target:
                    continue
                if nums[i] <= nums[j]:
                    continue
                prod = nums[i] * nums[j]
                if best_prod is None or prod > best_prod:
                    best_prod = prod
                    best = [i, j]
                elif prod == best_prod:
                    if i < best[0] or (i == best[0] and j < best[1]):
                        best = [i, j]
        return best
