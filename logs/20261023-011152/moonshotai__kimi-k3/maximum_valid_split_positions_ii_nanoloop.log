from math import gcd
from bisect import bisect_left, bisect_right
from collections import defaultdict


class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)

        pref = [0] * n
        g = 0
        for i, x in enumerate(nums):
            g = gcd(g, x)
            pref[i] = g

        suff = [0] * (n + 1)
        g = 0
        for i in range(n - 1, -1, -1):
            g = gcd(nums[i], g)
            suff[i] = g

        base = 0
        for i in range(n - 1):
            if pref[i] == suff[i + 1]:
                base += 1

        left = self._counts_when_removed_is_on_right(nums)
        rev_left = self._counts_when_removed_is_on_right(nums[::-1])

        ans = base
        for r in range(n):
            # Cuts before r, cuts after r (via reversal), and the new cut
            # created between r-1 and r+1.
            cur = left[r] + rev_left[n - 1 - r]
            if 1 <= r <= n - 2 and pref[r - 1] == suff[r + 1]:
                cur += 1
            if cur > ans:
                ans = cur
        return ans

    def _counts_when_removed_is_on_right(self, a: list[int]) -> list[int]:
        """
        For each removed index r, count valid splits strictly before r
        (the removed element lies in the right part of that split).
        """
        n = len(a)
        pref = [0] * n
        g = 0
        for i, x in enumerate(a):
            g = gcd(g, x)
            pref[i] = g

        suff = [0] * (n + 1)
        g = 0
        for i in range(n - 1, -1, -1):
            g = gcd(a[i], g)
            suff[i] = g

        positions = defaultdict(list)
        for i, v in enumerate(pref):
            positions[v].append(i)

        res = [0] * n
        states = []  # [gcd, count] for subarrays ending at current e, starts decreasing
        get_positions = positions.get
        bl = bisect_left
        br = bisect_right

        for e in range(n - 1):
            x = a[e]
            new_states = [[x, 1]]
            for g, c in states:
                ng = gcd(g, x)
                if ng == new_states[-1][0]:
                    new_states[-1][1] += c
                else:
                    new_states.append([ng, c])
            states = new_states

            r = e + 1
            fixed = suff[r + 1]  # gcd(a[r+1:]); suff[n] == 0 acts as neutral
            total = 0
            hi = e
            for g, c in states:
                lo = hi - c + 1  # this gcd occurs for starts s in [lo, hi]
                left_start = lo if lo > 1 else 1  # split needs s >= 1
                if left_start <= hi:
                    need = gcd(g, fixed)
                    lst = get_positions(need)
                    if lst is not None:
                        # pref index is s-1, so range is [left_start-1, hi-1]
                        total += br(lst, hi - 1) - bl(lst, left_start - 1)
                hi = lo - 1
            res[r] = total

        return res
