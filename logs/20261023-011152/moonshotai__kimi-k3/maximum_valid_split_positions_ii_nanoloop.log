 from math import gcd
from bisect import bisect_left, bisect_right
from collections import defaultdict


class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)

        pref = [0] * n
        g = 0
        for i, x in enumerate(nums):
            g = gcd(g, x)
            pref[i] = g

        suff = [0] * (n + 1)
        g = 0
        for i in range(n - 1, -1, -1):
            g = gcd(nums[i], g)
            suff[i] = g

      

