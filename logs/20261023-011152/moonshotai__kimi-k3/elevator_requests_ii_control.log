def elevatorRequests(self,n,start,requests):
    L=[0]  # L[i] distance for i served left; L[0]=0
    R=[0]
    for r in sorted(requests):
        if r<start: pass
    # build separately
    left = sorted(r for r in requests if r<start)  # ascending floors
    right = sorted(r for r in requests if r>start) # ascending floors
    # L distances increasing: closest left = largest floor < start
    for r in reversed(left):
        L.append(start - r)
    for r in right:
        R.append(r - start)
    a=len(L)-1; b=len(R)-1; m=a+b
    INF=1<<62
    dp0=[[INF]*(b+1) for _ in range(a+1)]
    dp1=[[INF]*(b+1) for _ in range(a+1)]
    dp0[0][0]=0; dp1[0][0]=0
    for i in range(a+1):
        rowL=dp0[i]; rowR=dp1[i]
        Li=L[i]
        for j in range(b+1):
            v0=rowL[j]; v1=rowR[j]
            c=i+j
            rem=m-c
            if rem==0: continue
            # go left
            if i<a:
                d=L[i+1]
                # from side0 pos -Li: delta=d-Li
                if v0<INF:
                    nv=v0+rem*(d-Li)
