class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        # Split requests into left (floor < start) and right (floor > start).
        # A request equal to start is fulfilled at time 0 and contributes nothing.
        left = sorted(r for r in requests if r < start)    # ascending floors
        right = sorted(r for r in requests if r > start)   # ascending floors

        # L[i] = distance from start to the i-th nearest left request (i >= 1), increasing.
        # R[j] = distance from start to the j-th nearest right request (j >= 1), increasing.
        L = [0]
        for r in reversed(left):          # closest left first
            L.append(start - r)
        R = [0]
        for r in right:                   # closest right first
            R.append(r - start)

        a = len(L) - 1
        b = len(R) - 1
        m = a + b

        # Key identity: sum of completion times =
        #   sum over every move of (# requests still unfulfilled during that move) * (move length).
        # Left requests must be served nearest-first, right requests nearest-first,
        # so a state is (i left served, j right served, side elevator ended on).
        INF = 1 << 62
        dp0 = [[INF] * (b + 1) for _ in range(a + 1)]  # end at left  (-L[i])
        dp1 = [[INF] * (b + 1) for _ in range(a + 1)]  # end at right (+R[j])
        dp0[0][0] = 0
        dp1[0][0] = 0

        for i in range(a + 1):
            Li = L[i]
            row0 = dp0[i]
            row1 = dp1[i]
            for j in range(b + 1):
                rem = m - (i + j)          # requests still unfulfilled before the next move
                if rem == 0:
                    continue
                v0 = row0[j]               # currently at -L[i]
                v1 = row1[j]               # currently at +R[j]

                if i < a:                  # serve the (i+1)-th nearest left request
                    d = L[i + 1]
                    if v0 < INF:           # from -L[i] to -d
                        nv = v0 + rem * (d - Li)
                        if nv < dp0[i + 1][j]:
                            dp0[i + 1][j] = nv
                    if v1 < INF:           # from +R[j] to -d
                        nv = v1 + rem * (d + R[j])
                        if nv < dp0[i + 1][j]:
                            dp0[i + 1][j] = nv

                if j < b:                  # serve the (j+1)-th nearest right request
                    d = R[j + 1]
                    if v1 < INF:           # from +R[j] to +d
                        nv = v1 + rem * (d - R[j])
                        if nv < dp1[i][j + 1]:
                            dp1[i][j + 1] = nv
                    if v0 < INF:           # from -L[i] to +d
                        nv = v0 + rem * (d + Li)
                        if nv < dp1[i][j + 1]:
                            dp1[i][j + 1] = nv

        return min(dp0[a][b], dp1[a][b])
```