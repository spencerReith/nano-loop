class Solution:
    def maxPrimeSubset(self, n: int, s: int) -> list[int]:
        # sieve primes up to n
        if n < 2:
            return []
        is_p = [True]*(n+1)
        is_p[0]=is_p[1]=False
        for i in range(2, int(n**0.5)+1):
            if is_p[i]:
                for j in range(i*i, n+1, i):
                    is_p[j]=False
        primes = [i for i in range(2, n+1) if is_p[i]]
        
        NEG = None
        dp = [None]*(s+1)
        dp[0] = (0, ())
        for p in primes:
            if p > s:
                break
            for t in range(s, p-1, -1):
                if dp[t-p] is not None:
                    cand = (dp[t-p][0]+1, dp[t-p][1] + (p,))
                    cur = dp[t]
                    if cur is None or cand[0] < cur[0] or (cand[0]==cur[0] and cand[1] < cur[1]):
                        dp[t] = cand
        # find max reachable sum > 0
        for t in range(s, 0, -1):
            if dp[t] is not None:
                return list(dp[t][1])
        return []
```

