```python
class Solution:
    def maxPrimeSubset(self, n: int, s: int) -> list[int]:
        # Sieve of Eratosthenes to find all primes <= n
        if n < 2:
            return []
        is_prime = [True] * (n + 1)
        is_prime[0] = is_prime[1] = False
        for i in range(2, int(n ** 0.5) + 1):
            if is_prime[i]:
                for j in range(i * i, n + 1, i):
                    is_prime[j] = False
        primes = [i for i in range(2, n + 1) if is_prime[i]]

        # 0/1 knapsack DP:
        # dp[t] = (min_count, lex_smallest_sorted_tuple) achieving exact sum t,
        #         or None if t is unreachable.
        dp = [None] * (s + 1)
        dp[0] = (0, ())
        for p in primes:
            if p > s:
                break
            for t in range(s, p - 1, -1):
                if dp[t - p] is not None:
                    cand = (dp[t - p][0] + 1, dp[t - p][1] + (p,))
                    cur = dp[t]
                    if (cur is None
                            or cand[0] < cur[0]
                            or (cand[0] == cur[0] and cand[1] < cur[1])):
                        dp[t] = cand

        # Largest achievable sum <= s (must be a non-empty subset)
        for t in range(s, 0, -1):
            if dp[t] is not None:
                return list(dp[t][1])
        return []
```