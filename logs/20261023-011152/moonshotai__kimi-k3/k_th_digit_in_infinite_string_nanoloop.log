```python
class Solution:
    def kthDigit(self, k: int) -> int:
        # Block 0: "123456789", 9 digits
        if k <= 9:
            return k
        k -= 9
        
        # Now find block b >= 1
        # Blocks with d-digit b: b in [10^(d-1), 10^d - 1]
        # Each such block has 10 numbers, each with (d+1) digits => 10*(d+1) digits
        d = 1
        while True:
            count_blocks = 9 * 10**(d-1)  # number of blocks with d-digit b
            digits_per_block = 10 * (d + 1)
            total = count_blocks * digits_per_block
            if k > total:
                k -= total
                d += 1
            else:
                break
        
        # Find which block within this group
        block_index = (k - 1) // digits_per_block  # 0-indexed within group
        b = 10**(d-1) + block_index
        pos_in_block = (k - 1) % digits_per_block  # 0-indexed digit position within block
        
        # Each number has (d+1) digits
        num_index = pos_in_block // (d + 1)  # 0-indexed which number in block
        digit_index = pos_in_block % (d + 1)  # 0-indexed digit within number
        
        if b % 2 == 0:
            # increasing: 10*b + num_index
            num = 10 * b + num_index
        else:
            # decreasing: 10*b + 9 - num_index
            num = 10 * b + 9 - num_index
        
        return int(str(num)[digit_index])
```

