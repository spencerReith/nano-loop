```python
class Solution:
    def kthDigit(self, k: int) -> int:
        # Block 0: numbers 1..9 -> "123456789", 9 digits
        if k <= 9:
            return k
        k -= 9

        # For blocks b >= 1 where b has d digits (b in [10^(d-1), 10^d - 1]):
        # each block contains 10 numbers, each with (d+1) digits -> 10*(d+1) digits per block
        d = 1
        while True:
            count_blocks = 9 * 10 ** (d - 1)
            digits_per_block = 10 * (d + 1)
            total = count_blocks * digits_per_block
            if k > total:
                k -= total
                d += 1
            else:
                break

        # Locate the exact block within this digit-length group
        digits_per_block = 10 * (d + 1)
        block_index = (k - 1) // digits_per_block      # 0-indexed within group
        b = 10 ** (d - 1) + block_index
        pos_in_block = (k - 1) % digits_per_block      # 0-indexed digit position in block

        num_index = pos_in_block // (d + 1)            # which number within the block
        digit_index = pos_in_block % (d + 1)           # which digit within that number

        if b % 2 == 0:
            num = 10 * b + num_index                   # increasing order
        else:
            num = 10 * b + 9 - num_index               # decreasing order

        return int(str(num)[digit_index])
