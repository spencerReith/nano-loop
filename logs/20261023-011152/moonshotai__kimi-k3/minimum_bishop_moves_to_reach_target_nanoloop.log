class Solution:
    def minBishopMoves(self, source: list[int], target: list[int]) -> int:
        sr, sc = source
        tr, tc = target

        # A bishop stays on squares of one color.
        if (sr + sc) % 2 != (tr + tc) % 2:
            return -1

        # Same diagonal: |row diff| == |col diff|.
        if abs(sr - tr) == abs(sc - tc):
            return 1

        # Same color but not same diagonal on an 8x8 board: always reachable in 2.
        return 2
```