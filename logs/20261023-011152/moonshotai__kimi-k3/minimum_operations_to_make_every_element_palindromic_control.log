class Solution:
    def minOperations(self, nums: list[int]) -> int:
        ans = 0
        for x in nums:
            if self.is_palindrome(x):
                continue
            # If even, decrement to make odd (since all even palindromes are divisible by 11, and if x mod 11 == 0, it is already palindrome)
            if x % 2 == 0:
                x -= 1
                ans += 1
            # Now x is odd and not palindrome
            ans += min(self.dist_down(x), self.dist_up(x))
        return ans

    def is_palindrome(self, x: int) -> bool:
        if x <= 0:
            return False
        s = str(x)
        return s == s[::-1]

    def dist_down(self, x: int) -> int:
        # x is odd and not palindrome
        # find largest palindrome p < x with same parity (odd)
        s = str(x)
        n = len(s)
        # try same length
        p = self.prev_pal_same_len(s)
        if p < x and p > 0:
            return (x - p) // 2
        # if no same length, then max palindrome of length n-1
        if n == 1:
            # x is single digit odd non-palindrome? But all single digit are palindrome, so not possible
            return 0
        p = 10**(n-1) - 1  # e.g., 99 for n=3
        return (x - p) // 2

    def dist_up(self, x: int) -> int:
        # find smallest palindrome p > x with same parity (odd)
        s = str(x)
        n = len(s)
        p = self.next_pal_same_len(s)
        if p > x:
            return (p - x) // 2
        # else next length
        # smallest palindrome of length n+1 is 10^n + 1 (e.g., 101 for n=2)
        p = 10**n + 1
        return (p - x) // 2

    def prev_pal_same_len(self, s: str) -> int:
        # return largest palindrome with same length as s that is <= original x (which is int(s))
        # but since x is not palindrome, it will be < x
        n = len(s)
        half = (n + 1) // 2
        prefix = s[:half]
        # try decrement prefix until we find palindrome <= s
        # But easier: generate candidate from prefix and prefix-1
        candidates = []
        # candidate1: mirror prefix
        cand1 = self.mirror(prefix, n)
        if cand1 <= int(s):
            candidates.append(cand1)
        # candidate2: prefix-1
        prefix_num = int(prefix)
        if prefix_num > 1 or (n % 2 == 0 and prefix_num > 0):
            prefix2 = str(prefix_num - 1)
            # handle leading zeros? But since n fixed, prefix2 should not have leading zero unless n=1
            if len(prefix2) < half:
                # this means we crossed boundary, e.g., prefix=1000 -> 999
                # but then length changes, we should not use same length
                pass
            else:
                cand2 = self.mirror(prefix2, n)
                candidates.append(cand2)
        if candidates:
            return max(candidates)
        return -1

    def next_pal_same_len(self, s: str) -> int:
        n = len(s)
        half = (n + 1) // 2
        prefix = s[:half]
        candidates = []
        cand1 = self.mirror(prefix, n)
        if cand1 > int(s):
            candidates.append(cand1)
        prefix_num = int(prefix)
        prefix2 = str(prefix_num + 1)
        if len(prefix2) > half:
            # overflow, e.g., 999 -> 1000, so no same length
            pass
        else:
            cand2 = self.mirror(prefix2, n)
            candidates.append(cand2)
        if candidates:
            return min(candidates)
        return -1

    def mirror(self, prefix: str, n: int) -> int:
        if n % 2 == 0:
            s = prefix + prefix[::-1]
        else:
            s = prefix + prefix[-2::-1]
        return int(s)
