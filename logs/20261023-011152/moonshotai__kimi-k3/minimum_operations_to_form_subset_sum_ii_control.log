from functools import lru_cache

class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        n = len(nums)
        LIMIT = 10**9

        @lru_cache(maxsize=None)
        def dfs(idx: int, target: int) -> int:
            if target == 0:
                return 0
            if idx == n:
                return LIMIT
            # option 1: do not use nums[idx]
            res = dfs(idx + 1, target)
            # option 2: use some reachable value from nums[idx]
            seen = set()
            stack = [(nums[idx], 0)]
            while stack:
                val, ops = stack.pop()
                if val in seen:
                    continue
                seen.add(val)
                if val <= target:
                    sub = dfs(idx + 1, target - val)
                    if sub != LIMIT:
                        cand = ops + sub
                        if cand < res:
                            res = cand
                if val > 0:
                    stack.append((val * 2, ops + 1))
                    stack.append((val // 2, ops + 1))
            return res

        ans = dfs(0, sum)
        return -1 if ans >= LIMIT else ans
