from collections import Counter

class Solution:
    def rearrangeArray(self, nums: list[int]) -> list[int]:
        count = Counter(nums)
        ans = []
        while count:
            # Get distinct values currently present, in ascending order
            distinct_vals = sorted(count.keys())
            # Append one occurrence of each distinct value
            ans.extend(distinct_vals)
            # Decrement counts and remove exhausted values
            for val in distinct_vals:
                count[val] -= 1
                if count[val] == 0:
                    del count[val]
        return ans
