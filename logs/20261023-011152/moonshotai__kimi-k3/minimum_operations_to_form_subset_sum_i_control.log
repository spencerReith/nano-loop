class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        target=sum
        INF=10**9
        dp=[INF]*(target+1)
        dp[0]=0
        for a in nums:
            opts=[]
            # divisions, including original
            x=a; c=0
            while x>0:
                if x<=target:
                    opts.append((x,c))
                x//=2; c+=1
            # multiplications excluding original? include x=a*2^k k>=1; original already included. 
            x=a*2; c=1
            while x<=target:
                opts.append((x,c))
                x*=2; c+=1
            # Optional dedupe min cost per value
            # Since no duplicates except maybe a? multiplications start at 2a; divisions include a and lower. no duplicates. But if a=0 no. fine.
            for s in range(target, -1, -1):
                if dp[s]==INF: continue
                for v,c in opts:
                    ns=s+v
                    if ns<=target:
                        nc=dp[s]+c
                        if nc<dp[ns]: dp[ns]=nc
        return -1 if dp[target]==INF else dp[target]

