class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        target = sum
        INF = 10**9

        dp = [INF] * (target + 1)
        dp[0] = 0

        for a in nums:
            best = {}

            x, cost = a, 0
            while x:
                if x <= target and (x not in best or cost < best[x]):
                    best[x] = cost
                x //= 2
                cost += 1

            x, cost = a * 2, 1
            while x <= target:
                if x not in best or cost < best[x]:
                    best[x] = cost
                x *= 2
                cost += 1

            options = list(best.items())
            for s in range(target, 0, -1):
                cur = dp[s]
                for value, ops in options:
                    if value <= s and dp[s - value] != INF:
                        cand = dp[s - value] + ops
                        if cand < cur:
                            cur = cand
                dp[s] = cur

        return -1 if dp[target] == INF else dp[target]
```