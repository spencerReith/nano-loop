Let's formulate final code elegantly:

```python
class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        target = sum
        INF = 10**9
        dp = [INF] * (target + 1)
        dp[0] = 0

        for a in nums:
            best = {}
            x, c = a, 0
            while x:
                if x <= target:
                    best[x] = c
                x //= 2
                c += 1
            x, c = a * 2, 1
            while x <= target:
                if x not in best or c < best[x]:
                    best[x] = c
                x *= 2
                c += 1
            opts = list(best.items())
            for s in range(target, 0, -1):
                cur = dp[s]
                # We need check options; maybe local dp_s=cur
                for v, w in opts:
                    if v > s:
                        continue
                    prev = dp[s - v]
                    if prev != INF and prev + w < cur:
                        cur = prev + w
                dp[s] = cur
        return -1 if dp[target] == INF else dp[target]
```

