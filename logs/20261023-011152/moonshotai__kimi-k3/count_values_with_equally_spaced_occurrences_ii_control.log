class Solution:
    def countSpecialIntegers(self, nums: list[int]) -> int:
        occurrences = {}
        for i, x in enumerate(nums):
            occurrences.setdefault(x, []).append(i)
        
        special_count = 0
        for indices in occurrences.values():
            if len(indices) < 3:
                continue
            diff = indices[1] - indices[0]
            is_special = True
            for j in range(2, len(indices)):
                if indices[j] - indices[j - 1] != diff:
                    is_special = False
                    break
            if is_special:
                special_count += 1
        
        return special_count
