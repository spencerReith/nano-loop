from collections import Counter


class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        cnt = Counter(planks)
        items = list(cnt.items())

        # pair_contrib[s] = maximum number of paired planks (using exactly two
        # original planks) whose heights sum to s.
        pair_contrib = {}

        m = len(items)
        for i in range(m):
            h, c = items[i]
            if c // 2:
                s = 2 * h
                pair_contrib[s] = pair_contrib.get(s, 0) + c // 2
            for j in range(i + 1, m):
                h2, c2 = items[j]
                s = h + h2
                add = c if c < c2 else c2
                pair_contrib[s] = pair_contrib.get(s, 0) + add

        # A fence may also consist only of original planks of one height.
        ans = max(cnt.values())

        for s, pairs in pair_contrib.items():
            # Planks already having height s can be used as single-plank fences.
            total = pairs + cnt.get(s, 0)
            if total > ans:
                ans = total

        return ans
