from typing import List

class Solution:
    def maxProductPair(self, nums: List[int], target: int) -> List[int]:
        best_pair = [-1, -1]
        best_prod = float('-inf')
        n = len(nums)
        for i in range(n):
            for j in range(i + 1, n):
                a, b = nums[i], nums[j]
                if a + b == target and a != b:
                    if a > b:
                        cur_i, cur_j = i, j
                    else:
                        cur_i, cur_j = j, i
                    prod = a * b
                    if (prod > best_prod or
                        (prod == best_prod and (cur_i < best_pair[0] or
                         (cur_i == best_pair[0] and cur_j < best_pair[1])))):
                        best_prod = prod
                        best_pair = [cur_i, cur_j]
        return best_pair
