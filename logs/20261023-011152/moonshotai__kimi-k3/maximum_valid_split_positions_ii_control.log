class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        import math

        n = len(nums)
        if n == 2:
            return 0

        # prefix GCD of the original array
        P = [0] * n
        P[0] = nums[0]
        for i in range(1, n):
            P[i] = math.gcd(P[i - 1], nums[i])

        # suffix GCD of the original array
        S = [0] * n
        S[-1] = nums[-1]
        for i in range(n - 2, -1, -1):
            S[i] = math.gcd(S[i + 1], nums[i])

        def gcd_range(l: int, r: int) -> int:
            """GCD of nums[l..r], assuming there is no removed index inside."""
            if l == 0:
                return P[r]
            return math.gcd(P[l - 1], S[r + 1]) if r + 1 < n else P[l - 1]

        best = 0

        # h = -1 means "no removal"
        for h in range(-1, n):
            if h == -1:
                # baseline: no element removed
                cnt = 0
                for k in range(n - 2, -1, -1):
                    if P[k] == S[k + 1]:
                        cnt += 1
                if cnt > best:
                    best = cnt
                continue

            # Remove index h. Remaining length m = n-1, split count m-1 = n-2.
            # Splits with position < h-1 are unaffected.
            # Split at h-1 (if valid) must be checked.
            # Splits with position >= h are unaffected in structure (only index shift).
            left_end = h - 2                     # splits k <= h-2 untouched on the left
            cnt = (h - 1) if h - 1 > 0 else 0    # number of splits in [0, h-2]

            # check split at original index h-1 (left part nums[0..h-1],
            # right part nums[h+1..n-1])
            if 0 <= h - 1 <= n - 2:
                left_g = P[h - 1]
                right_g = S[h + 1] if h + 1 < n else 0
                if right_g != 0 and left_g == right_g:
                    cnt += 1

            # splits on the right: original split indices k in [h+1, n-2]
            right_cnt = (n - 2 - (h + 1) + 1) if h + 1 <= n - 2 else 0
            cnt += right_cnt

            if cnt > best:
                best = cnt

        return best
