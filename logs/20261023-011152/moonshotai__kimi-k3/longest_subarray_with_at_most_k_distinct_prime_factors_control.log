class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        # Precompute the smallest prime factor (spf) for numbers up to max(nums) 
        # using a linear sieve or standard sieve. Here we use a linear sieve.
        max_val = max(nums)
        spf = list(range(max_val + 1))
        
        for i in range(2, int(max_val**0.5) + 1):
            if spf[i] == i: # i is a prime
                for j in range(i * i, max_val + 1, i):
                    if spf[j] == j:
                        spf[j] = i
                        
        # Sliding window
        counts = {}
        left = 0
        res = 0
        
        for right in range(len(nums)):
            # Factorize the incoming number using spf
            curr = nums[right]
            while curr > 1:
                p = spf[curr]
                counts[p] = counts.get(p, 0) + 1
                # Increment frequency and completely divide it out of curr
                while curr % p == 0:
                    curr //= p
                    
            # Shrink the window if we exceed K distinct prime factors
            while len(counts) > k:
                outgoing = nums[left]
                while outgoing > 1:
                    p = spf[outgoing]
                    counts[p] -= 1
                    if counts[p] == 0:
                        del counts[p]
                    # Decrement frequency and completely divide it out of outgoing
                    while outgoing % p == 0:
                        outgoing //= p
                left += 1
                
            # Record and maximize the valid window length
            res = max(res, right - left + 1)
            
        return res
