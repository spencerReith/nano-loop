Let me now write the code.

```python
import numpy as np

class Solution:
    def longestSubarray(self, nums, k):
        n = len(nums)
        # prefix sums mod k
        P = [0] * (n + 1)
        s = 0
        for i in range(n):
            s = (s + nums[i]) % k
            P[i + 1] = s
        # fc, lc
        NEG = -(10**9)
        fc = [None] * k
        lc = [NEG] * k
        for j in range(n + 1):
            r = P[j]
            if fc[r] is None:
                fc[r] = j
            lc[r] = j
        # answer A
        ans = 0
        for c in range(k):
            if fc[c] is not None and lc[c] > fc[c]:
                v = lc[c] - fc[c]
                if v > ans:
                    ans = v
        # w array
        w = [(2 * x) % k for x in nums]
        # group residues by fc (only fc <= n-1)
        res_by_fc = {}
        for c in range(k):
            f = fc[c]
            if f is not None and f <= n - 1:
                res_by_fc.setdefault(f, []).append(c)
        # sweep
        SENT = n + 1
        cur = [SENT] * k
        lc_arr = np.array(lc)  # has NEG for undefined
        best_B = 0
        for pos in range(n - 1, -1, -1):
            cur[w[pos]] = pos
            if pos in res_by_fc:
                cur_arr = np.array(cur)
                for c in res_by_fc[pos]:
                    rolled = np.roll(lc_arr, -c)
                    mask = cur_arr <= rolled - 1
                    if mask.any():
                        v = int(rolled[mask].max()) - fc[c]
                        if v > best_B:
                            best_B = v
        ans = max(ans, best_B)
        return ans
```

