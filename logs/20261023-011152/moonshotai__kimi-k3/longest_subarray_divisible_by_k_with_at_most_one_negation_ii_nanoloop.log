```python
from solution import Solution
import random

def brute(nums, k):
    n = len(nums)
    best = 0
    for l in range(n):
        s = 0
        for r in range(l, n):
            s += nums[r]
            if s % k == 0:
                if r - l + 1 > best:
                    best = r - l + 1
            else:
                for i in range(l, r + 1):
                    if (s - 2 * nums[i]) % k == 0:
                        if r - l + 1 > best:
                            best = r - l + 1
                        break
    return best

s = Solution()
print(s.longestSubarray([4,1,2], 3), "expected", 3)
print(s.longestSubarray([5,3,4], 7), "expected", 2)
print(s.longestSubarray([2,2,5], 6), "expected", 2)

# random tests
random.seed(0)
for t in range(2000):
    n = random.randint(1, 8)
    k = random.randint(1, 6)
    nums = [random.randint(-5, 5) for _ in range(n)]
    got = s.longestSubarray(nums, k)
    exp = brute(nums, k)
    if got != exp:
        print("MISMATCH", nums, k, got, exp)
        break
else:
    print("all random small tests passed")
