```python
class Solution:
    def longestSubarray(self, nums, k):
        n = len(nums)
        P = [0] * (n + 1)
        s = 0
        for i, x in enumerate(nums):
            s = (s + x) % k
            P[i + 1] = s

        NEG = -10**9
        fc = [-1] * k
        lc = [NEG] * k
        for j in range(n + 1):
            r = P[j]
            if fc[r] == -1:
                fc[r] = j
            lc[r] = j

        ans = 0
        for c in range(k):
            if fc[c] != -1 and lc[c] > fc[c]:
                v = lc[c] - fc[c]
                if v > ans:
                    ans = v

        w = [(2 * x) % k for x in nums]

        res_by_fc = {}
        for c in range(k):
            f = fc[c]
            if f != -1 and f <= n - 1:
                res_by_fc.setdefault(f, []).append(c)

        # residues d sorted by lc[d] descending (only those with lc defined)
        dsorted = sorted((d for d in range(k) if lc[d] != NEG), key=lambda d: -lc[d])
        lc_list = lc  # alias

        SENT = n + 1
        cur = [SENT] * k
        best_B = 0
        for pos in range(n - 1, -1, -1):
            cur[w[pos]] = pos
            lst = res_by_fc.get(pos)
            if lst is not None:
                for c in lst:
                    fcc = fc[c]
                    # prune: max possible for this c
                    # scan d in decreasing lc[d]
                    for d in dsorted:
                        ld = lc_list[d]
                        if ld - fcc <= best_B:
                            break
                        a = d - c
                        if a < 0:
                            a += k
                        if cur[a] <= ld - 1:
                            v = ld - fcc
                            if v > best_B:
                                best_B = v
                            break
        return max(ans, best_B)
```

