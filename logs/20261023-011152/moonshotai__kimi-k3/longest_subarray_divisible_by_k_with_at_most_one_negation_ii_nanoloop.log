Let me write solution.py:

```python
import numpy as np

class Solution:
    def longestSubarray(self, nums, k):
        n = len(nums)
        P = [0] * (n + 1)
        s = 0
        for i, x in enumerate(nums):
            s = (s + x) % k
            P[i + 1] = s
        NEG = -10**9
        fc = [-1] * k          # -1 means undefined
        lc = [NEG] * k
        seen = [False] * k
        for j in range(n + 1):
            r = P[j]
            if not seen[r]:
                seen[r] = True
                fc[r] = j
            lc[r] = j
        # condition A
        ans = 0
        for c in range(k):
            if seen[c] and lc[c] > fc[c]:
                v = lc[c] - fc[c]
                if v > ans:
                    ans = v
        # w residues
        w = [(2 * x) % k for x in nums]
        # group c by fc value (only those that can serve as l, i.e., fc <= n-1)
        res_by_fc = {}
        for c in range(k):
            if seen[c] and fc[c] <= n - 1:
                res_by_fc.setdefault(fc[c], []).append(c)
        SENT = n + 1
        cur = [SENT] * k
        lc_arr = np.array(lc, dtype=np.int64)
        best_B = 0
        for pos in range(n - 1, -1, -1):
            cur[w[pos]] = pos
            lst = res_by_fc.get(pos)
            if lst is not None:
                cur_arr = np.array(cur, dtype=np.int64)
                for c in lst:
                    rolled = np.roll(lc_arr, -c)
                    mask = cur_arr <= (rolled - 1)
                    if mask.any():
                        v = int(rolled[mask].max()) - fc[c]
                        if v > best_B:
                            best_B = v
        if best_B > ans:
            ans = best_B
        return ans
```

