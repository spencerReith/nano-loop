class Solution:
    def countIntersectingIntervals(self, intervals: list[list[int]]) -> int:
        n = len(intervals)
        # Sort by start time
        intervals.sort()
        
        # Total pairs
        total = n * (n - 1) // 2
        
        # Count non-intersecting pairs using sweep line
        # For each interval i, count intervals j > i with start_j > end_i
        # Use binary search on sorted starts
        import bisect
        
        starts = [intervals[i][0] for i in range(n)]
        non_intersecting = 0
        
        for i in range(n):
            end_i = intervals[i][1]
            # Find first index j > i with starts[j] > end_i
            # bisect_right finds insertion point for end_i, giving first index with start > end_i
            idx = bisect.bisect_right(starts, end_i, i + 1)
            non_intersecting += n - idx
        
        return total - non_intersecting
```