class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[list[int]]) -> int:
        m = len(requests)
        arrivals = [r[0] for r in requests]
        floors = [r[1] for r in requests]
        
        # DP over subsets: for each subset, try each request as the last one fulfilled
        # dp[mask][i] = minimum time to fulfill all requests in mask, with request i being the last one
        INF = float('inf')
        size = 1 << m
        dp = [[INF] * m for _ in range(size)]
        
        # Base case: single request
        for i in range(m):
            time_to_reach = abs(floors[i] - start)
            dp[1 << i][i] = max(time_to_reach, arrivals[i])
        
        # Fill DP table
        for mask in range(size):
            for i in range(m):
                if dp[mask][i] == INF:
                    continue
                # Try adding request j as the next request
                for j in range(m):
                    if mask & (1 << j):
                        continue
                    new_mask = mask | (1 << j)
                    time_to_reach = dp[mask][i] + abs(floors[j] - floors[i])
                    arrival_time = max(time_to_reach, arrivals[j])
                    dp[new_mask][j] = min(dp[new_mask][j], arrival_time)
        
        # Find minimum time to fulfill all requests
        full_mask = size - 1
        return min(dp[full_mask][i] for i in range(m))
