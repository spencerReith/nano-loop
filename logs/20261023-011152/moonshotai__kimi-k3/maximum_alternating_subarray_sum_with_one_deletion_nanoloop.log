```python
class Solution:
    def maxAlternatingSum(self, nums: list[int]) -> int:
        NEG = -10**18
        o0 = e0 = o1 = e1 = NEG  # ending at previous index
        p_o0 = p_e0 = NEG        # ending at index before previous (no-del states)
        ans = NEG
        for x in nums:
            no0 = max(x, e0 + x)
            ne0 = o0 - x
            no1 = max(e1 + x, p_e0 + x)
            ne1 = max(o1 - x, p_o0 - x)
            p_o0, p_e0 = o0, e0
            o0, e0, o1, e1 = no0, ne0, no1, ne1
            ans = max(ans, o0, e0, o1, e1)
        return ans
```

