### Let's now formulate final code:

```
import heapq

class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)

        reps = []
        for i in range(1, n + 1):
            if i == n or position[i] - position[i - 1] > distance:
                reps.append(i - 1)

        class Time:
            __slots__ = ("num", "den", "value")
            def __init__(self, num, den=1):
                self.num = num
                self.den = den
                self.value = num / den
            def __lt__(self, other):
                if self.value != other.value:
                    return self.value < other.value
                return self.num * other.den < other.num * self.den
            def __eq__(self, other):
                return self.num * other.den == other.num * self.den

        m = len(reps)
        if m == 1:
            return 1

        left = [-1] * n
        right = [-1] * n
        alive = [False] * n
        for i, r in enumerate(reps):
            alive[r] = True
            if i > 0:
                left[r] = reps[i - 1]
            if i + 1 < m:
                right[r] = reps[i + 1]

        pq = []
        serial = 0

        def add_edge(a, b):
            nonlocal serial
            num = position[b] - position[a] - distance
            if num <= 0:
                heapq.heappush(pq, (Time(0), serial, a, b))
                serial += 1
            elif speed[a] > speed[b]:
                heapq.heappush(pq, (Time(num, speed[a] - speed[b]), serial, a, b))
                serial += 1

        for i in range(m - 1):
            add_edge(reps[i], reps[i + 1])

        groups = m

        def valid(a, b):
            return alive[a] and alive[b] and right[a] == b

        def merge_nodes(nodes):
            nonlocal groups
            start = nodes[0]
            end = nodes[-1]
            l = left[start]
            groups -= len(nodes) - 1
            for g in nodes[:-1]:
                alive[g] = False
                left[g] = -1
                right[g] = -1
            if l == -1:
                left[end] = -1
            else:
                right[l] = end
                left[end] = l
                add_edge(l, end)

        while pq:
            while pq and not valid(pq[0][2], pq[0][3]):
                heapq.heappop(pq)
            if not pq:
                break

            cur_time = pq[0][0]
            batch = []
            while pq and pq[0][0] == cur_time:
                _, _, a, b = heapq.heappop(pq)
                if valid(a, b):
                    batch.append((a, b))

            if not batch:
                continue

            if len(batch) == 1:
                merge_nodes(batch[0])
                continue

            edge = {a: b for a, b in batch}
            seen = set()
            segments = []
            for a, _ in batch:
                if a in seen:
                    continue
                start = a
                while left[start] in edge:
                    start = left[start]
                cur = start
                nodes = []
                while True:
                    nodes.append(cur)
                    seen.add(cur)
                    if cur not in edge:
                        break
                    cur = edge[cur]
                segments.append(nodes)

            for nodes in segments:
                merge_nodes(nodes)

        return groups
```

