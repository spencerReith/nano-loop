```
import heapq

class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)

        reps = []
        for i in range(1, n + 1):
            if i == n or position[i] - position[i - 1] > distance:
                reps.append(i - 1)

        class Rat:
            __slots__ = ("num", "den")
            def __init__(self, num: int, den: int = 1):
                self.num = num
                self.den = den
            def __lt__(self, other) -> bool:
                return self.num * other.den < other.num * self.den
            def __eq__(self, other) -> bool:
                if not isinstance(other, Rat):
                    return NotImplemented
                return self.num * other.den == other.num * self.den

        m = len(reps)
        left = [-1] * n
        right = [-1] * n
        alive = [False] * n
        for i, r in enumerate(reps):
            alive[r] = True
            if i:
                left[r] = reps[i - 1]
            if i + 1 < m:
                right[r] = reps[i + 1]

        heap = []
        serial = 0
        def add_edge(a: int, b: int) -> None:
            nonlocal serial
            num = position[b] - position[a] - distance
            if num <= 0:
                heapq.heappush(heap, (Rat(0), serial, a, b))
                serial += 1
            elif speed[a] > speed[b]:
                heapq.heappush(heap, (Rat(num, speed[a] - speed[b]), serial, a, b))
                serial += 1

        for i in range(m - 1):
            add_edge(reps[i], reps[i + 1])

        groups = m
        def valid(a,b):
            return alive[a] and alive[b] and right[a] == b

        while heap:
            while heap and not valid(heap[0][2], heap[0][3]):
                heapq.heappop(heap)
            if not heap:
                break
            t = heap[0][0]
            batch = []
            while heap and heap[0][0] == t:
                _, _, a, b = heapq.heappop(heap)
                if valid(a,b):
                    batch.append((a,b))
            if not batch:
                continue

            edge = {a:b for a,b in batch}
            seen=set()
            segments=[]
            for a,_ in batch:
                if a in seen:
                    continue
                start=a
                while left[start] in edge:
                    start=left[start]
                cur=start
                nodes=[]
                while True:
                    nodes.append(cur)
                    seen.add(cur)
                    if cur not in edge:
                        break
                    cur=edge[cur]
                segments.append((start,cur,nodes))

            for start,end,nodes in segments:
                groups -= len(nodes)-1
                for g in nodes[:-1]:
                    alive[g]=False
                    left[g]=right[g]=-1
                l=left[start]
                if l==-1:
                    left[end]=-1
                else:
                    right[l]=end
                    left[end]=l
                    add_edge(l,end)
        return groups
```

