```
import heapq

class Solution:
    def countGroups(...):
        n=len(position)
        reps=[]
        for i in range(1,n+1):
            if i==n or position[i]-position[i-1]>distance:
                reps.append(i-1)

        class Time:
           ...

        m=len(reps)
        prev=[-1]*n; nxt=[-1]*n; alive=[False]*n
        ...
        pq=[]; stamp=0
        def add(a,b):
            nonlocal stamp
            diff=position[b]-position[a]-distance
            if diff <= 0:
                heapq.heappush(pq,(Time(0),stamp,a,b)); stamp+=1
            elif speed[a]>speed[b]:
                heapq.heappush(pq,(Time(diff,speed[a]-speed[b]),stamp,a,b)); stamp+=1
        ...
        ans=m
        while pq:
            while pq:
                _,_,a,b=pq[0]
                if alive[a] and alive[b] and nxt[a]==b: break
                heapq.heappop(pq)
            if not pq: break
            tm=pq[0][0]
            batch=[]
            while pq and pq[0][0] == tm:
                _,_,a,b=heapq.heappop(pq)
                if alive[a] and alive[b] and nxt[a]==b:
                    batch.append((a,b))
            if not batch: continue
            edge={}
            for a,b in batch: edge[a]=b
            seen=set(); segs=[]
            for a,_ in batch:
                if a in seen: continue
                s=a
                while prev[s] in edge:
                    s=prev[s]
                cur=s; nodes=[]
                while True:
                    nodes.append(cur); seen.add(cur)
                    if cur not in edge: break
                    cur=edge[cur]
                segs.append((s,cur,nodes))
            for s,e,nodes in segs:
                l=prev[s]
                ans -= len(nodes)-1
                for g in nodes[:-1]:
                    alive[g]=False
                    prev[g]=nxt[g]=-1
                if l>=0:
                    nxt[l]=e
                    prev[e]=l
                    add(l,e)
                else:
                    prev[e]=-1
        return ans
```

