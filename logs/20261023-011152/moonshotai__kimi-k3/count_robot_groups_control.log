### Let's now final answer.<|close|>think<|sep|>```python
import heapq

class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)

        # Initially, every connected run with consecutive gaps <= distance merges.
        # Store the rightmost robot of each resulting group.
        reps = []
        for i in range(1, n + 1):
            if i == n or position[i] - position[i - 1] > distance:
                reps.append(i - 1)

        groups = len(reps)
        if groups == 1:
            return 1

        m = groups
        left = [-1] * n
        right = [-1] * n
        alive = [False] * n

        for i, r in enumerate(reps):
            alive[r] = True
            if i > 0:
                left[r] = reps[i - 1]
            if i + 1 < m:
                right[r] = reps[i + 1]

        # Event times are rational numbers. Since denominators are speed
        # differences, this scale makes the floored key collision-free.
        max_speed = max(speed)
        scale = 1 << (2 * max_speed.bit_length())

        pq = []

        def add_edge(a: int, b: int) -> None:
            # Solve:
            # position[b] + speed[b] * t
            # - (position[a] + speed[a] * t) <= distance
            num = position[b] - position[a] - distance

            if num <= 0:
                key = 0
            else:
                ds = speed[a] - speed[b]
                if ds <= 0:
                    return
                key = (num * scale) // ds

            heapq.heappush(pq, (key, a, b))

        for i in range(m - 1):
            add_edge(reps[i], reps[i + 1])

        def valid(a: int, b: int) -> bool:
            return alive[a] and alive[b] and right[a] == b

        def merge_nodes(nodes) -> None:
            nonlocal groups

            start = nodes[0]
            end = nodes[-1]
            l = left[start]

            groups -= len(nodes) - 1

            for g in nodes[:-1]:
                alive[g] = False
                left[g] = -1
                right[g] = -1

            if l == -1:
                left[end] = -1
            else:
                right[l] = end
                left[end] = l
                add_edge(l, end)

        while pq:
            while pq and not valid(pq[0][1], pq[0][2]):
                heapq.heappop(pq)

            if not pq:
                break

            cur_time = pq[0][0]
            batch = []

            # All events at the same time must be merged together.
            while pq and pq[0][0] == cur_time:
                _, a, b = heapq.heappop(pq)
                if valid(a, b):
                    batch.append((a, b))

            if not batch:
                continue

            if len(batch) == 1:
                merge_nodes(batch[0])
            else:
                edge = {a: b for a, b in batch}
                seen = set()
                segments = []

                # Events form connected runs in the current linked list.
                for a, _ in batch:
                    if a in seen:
                        continue

                    start = a
                    while left[start] in edge:
                        start = left[start]

                    nodes = []
                    cur = start
                    while True:
                        nodes.append(cur)
                        seen.add(cur)
                        if cur not in edge:
                            break
                        cur = edge[cur]

                    segments.append(nodes)

                for nodes in segments:
                    merge_nodes(nodes)

            if groups == 1:
                return 1

        return groups
```