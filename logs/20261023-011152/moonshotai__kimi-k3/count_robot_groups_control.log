### Let's now prepare final code text:

```
import heapq

class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)

        reps = []
        for i in range(1, n + 1):
            if i == n or position[i] - position[i - 1] > distance:
                reps.append(i - 1)

        m = len(reps)
        if m == 1:
            return 1

        left = [-1] * n
        right = [-1] * n
        alive = [False] * n
        ...

        SCALE = 1 << 60
```

