import heapq

class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)

        reps = []
        for i in range(1, n + 1):
            if i == n or position[i] - position[i - 1] > distance:
                reps.append(i - 1)

        groups = len(reps)
        if groups == 1:
            return 1

        m = groups
        left = [-1] * n
        right = [-1] * n
        alive = [False] * n
        for i, r in enumerate(reps):
            alive[r] = True
            if i:
                left[r] = reps[i - 1]
            if i + 1 < m:
                right[r] = reps[i + 1]

        max_speed = max(speed)
        scale = 1 << (2 * max_speed.bit_length())
        pq = []

        def add_edge(a: int, b: int) -> None:
            num = position[b] - position[a] - distance
            if num <= 0:
                key = 0
            else:
                ds = speed[a] - speed[b]
                if ds <= 0:
                    return
                key = (num * scale) // ds
            heapq.heappush(pq, (key, a, b))

        ...
```

