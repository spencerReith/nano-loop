Let me code:

```python
class Solution:
    def maxEarnings(self, meetings):
        n = len(meetings)
        # sort by start
        by_start = sorted(range(n), key=lambda i: meetings[i][0])
        # sort by end
        by_end = sorted(range(n), key=lambda i: meetings[i][1])
        
        dp = [0]*n
        best = -float('inf')
        p = 0
        ans = 0
        for i in by_start:
            s, e, r = meetings[i]
            while p < n and meetings[by_end[p]][1] <= s:
                j = by_end[p]
                val = dp[j] - meetings[j][1]
                if val > best:
                    best = val
                p += 1
            # option: alone
            cur = r
            if best != -float('inf'):
                cand = r + s + best
                if cand > cur:
                    cur = cand
            dp[i] = cur
            if cur > ans:
                ans = cur
        return ans
```

