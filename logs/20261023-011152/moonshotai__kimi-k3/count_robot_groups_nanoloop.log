class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        n = len(position)

        def catch_time(i: int, j: int):
            """Earliest t >= 0 when robot i gets within distance of robot j.
            Returns (numerator, denominator), or None if it never happens."""
            gap = position[j] - position[i]
            if gap <= distance:
                return (0, 1)
            if speed[i] > speed[j]:
                return (gap - distance, speed[i] - speed[j])
            return None

        # Stack entries: (rightmost_robot_index, deadline_num, deadline_den)
        # deadline_num is None means the entry never merges to its right.
        stack = []

        for i in range(n - 1, -1, -1):
            if not stack:
                stack.append((i, None, 1))
                continue

            while True:
                j, dn, dd = stack[-1]
                ct = catch_time(i, j)

                if ct is not None:
                    tn, td = ct
                    if dn is None or tn * dd <= dn * td:
                        # Robot i joins this entry at time tn/td.  It can also
                        # serve as a bridge for robots further left until that time.
                        stack.append((i, tn, td))
                        break

                if dn is None:
                    # The nearest group to the right never merges away and robot i
                    # can never reach it, so robot i starts a new final group.
                    stack.append((i, None, 1))
                    break

                # Entry j will merge farther right before robot i can use it.
                stack.pop()
                if not stack:
                    stack.append((i, None, 1))
                    break

        return sum(1 for _, dn, _ in stack if dn is None)
