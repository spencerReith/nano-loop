class Solution:
    def maxArea(self, mat: list[list[int]]) -> int:
        m, n = len(mat), len(mat[0])

        # Prefix sums of usable cells.
        ps = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(m):
            row_sum = 0
            for j in range(n):
                row_sum += mat[i][j]
                ps[i + 1][j + 1] = ps[i][j + 1] + row_sum

        def possible(k: int) -> bool:
            if k == 0:
                return True
            rows = m - k + 1
            cols = n - k + 1
            if rows <= 0 or cols <= 0:
                return False

            need = k * k
            min_r = 10**9
            max_r = -1
            min_c = 10**9
            max_c = -1

            for i in range(rows):
                i2 = i + k
                psi = ps[i]
                psi2 = ps[i2]
                for j in range(cols):
                    j2 = j + k
                    total = psi2[j2] - psi[j2] - psi2[j] + psi[j]
                    if total == need:
                        if i < min_r:
                            min_r = i
                        if i > max_r:
                            max_r = i
                        if j < min_c:
                            min_c = j
                        if j > max_c:
                            max_c = j
                        # Two k x k squares are disjoint iff their row ranges
                        # are disjoint or their column ranges are disjoint.
                        if max_r - min_r >= k or max_c - min_c >= k:
                            return True
            return False

        lo, hi = 0, min(m, n)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if possible(mid):
                lo = mid
            else:
                hi = mid - 1
        return lo * lo
