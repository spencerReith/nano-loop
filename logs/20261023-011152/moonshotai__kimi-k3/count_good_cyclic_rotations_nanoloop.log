class Solution:
    def countGoodRotations(self, nums: list[int]) -> int:
        n = len(nums)
        half = n // 2

        first_half_sum = sum(nums[:half])
        second_half_sum = sum(nums[half:])
        difference = first_half_sum - second_half_sum

        good_rotations = 0
        for start in range(n):
            if difference > 0:
                good_rotations += 1

            # Moving the rotation start by one removes nums[start] from the
            # first half and adds nums[start + half]; the reverse happens in
            # the second half.
            difference += 2 * (nums[(start + half) % n] - nums[start])

        return good_rotations
```