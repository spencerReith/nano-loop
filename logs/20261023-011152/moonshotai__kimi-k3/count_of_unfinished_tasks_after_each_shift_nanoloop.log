```python
from bisect import bisect_right


class Solution:
    def countTasks(self, tasks: list[int], shifts: list[int]) -> list[int]:
        n = len(tasks)
        prefix = [0] * (n + 1)
        for i, t in enumerate(tasks):
            prefix[i + 1] = prefix[i] + t
        total = prefix[n]

        ans = []
        idx = 0      # current task index (0-based)
        offset = 0   # work already done on tasks[idx]

        for s in shifts:
            # work completed before current position (prefix[idx] counts full
            # tasks before idx, but offset of idx is consumed, not remaining)
            completed_before = prefix[idx] + offset
            remaining = total - completed_before

            if s >= remaining:
                # all tasks completed during this shift; unused time discarded,
                # next shift restarts from task 0
                idx = 0
                offset = 0
                ans.append(0)
            else:
                done = completed_before + s
                # largest i such that prefix[i] <= done
                new_idx = bisect_right(prefix, done) - 1
                new_offset = done - prefix[new_idx]
                idx, offset = new_idx, new_offset
                # tasks 0..idx-1 fully completed; task idx is in progress
                # (in-progress counts as unfinished)
                ans.append(n - idx)

        return ans
