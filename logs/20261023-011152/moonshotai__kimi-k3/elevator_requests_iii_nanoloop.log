**Approach:** Since at most 16 requests exist and fulfillment is instantaneous, any optimal schedule can be represented as an ordered sequence of stops at request floors (a request fulfilled in passing is a zero-cost stop, since passing time depends only on the departure time). Direct travel between consecutive stops is optimal. So `dp[mask][j]` = earliest time to fulfill exactly `mask` ending at request `j`'s floor, with transition `nt = max(dp[mask][j] + |floor_j - floor_k|, arrival_k)`. Complexity `O(2^m · m²)`.

```python
class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[list[int]]) -> int:
        m = len(requests)
        arr = [0] * m
        fl = [0] * m
        for i, (a, f) in enumerate(requests):
            arr[i] = a
            fl[i] = f

        dist = [[0] * m for _ in range(m)]
        for i in range(m):
            fi = fl[i]
            di = dist[i]
            for j in range(m):
                d = fi - fl[j]
                di[j] = d if d >= 0 else -d

        INF = 1 << 62
        size = 1 << m
        full = size - 1
        dp = [[INF] * m for _ in range(size)]
        for j in range(m):
            d = start - fl[j]
            if d < 0:
                d = -d
            dp[1 << j][j] = arr[j] if arr[j] > d else d

        # lowbit value -> request index
        bidx = [0] * ((1 << (m - 1)) + 1)
        for i in range(m):
            bidx[1 << i] = i

        for mask in range(1, size):
            dpm = dp[mask]
            rem0 = full ^ mask
            mm = mask
            while mm:
                lb = mm & -mm
                j = bidx[lb]
                mm ^= lb
                t = dpm[j]
                dj = dist[j]
                rem = rem0
                while rem:
                    bk = rem & -rem
                    k = bidx[bk]
                    rem ^= bk
                    nt = t + dj[k]
                    ak = arr[k]
                    if nt < ak:
                        nt = ak
                    row = dp[mask | bk]
                    if nt < row[k]:
                        row[k] = nt

        return min(dp[full])
