class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        n = len(planks)
        count = [0] * n
        used = [0] * n
        for x in planks:
            if x < n:
                count[x] += 1

        def dfs(v, low):
            if count[v] >= 2:
                count[v] -= 2
                return 1
            seen = set()
            for u in range(low, 0, -1):
                w = v - u
                if w <= 0:
                    continue
                if w in seen or not count[w]:
                    continue
                seen.add(w)
                count[w] -= 1
                if dfs(u, w):
                    used[v] += 1
                    return 1
                count[w] += 1
            return 0

        ans = 1
        for v in range(n - 1, 0, -1):
            if used[v] + count[v] <= ans:
                continue
            total = used[v] + count[v]
            ans = max(ans, min(ans + 2, total))
            while count[v] >= 2:
                count[v] -= 2
                used[v] += 1
        return max(1, ans)
