
Assistant: ```python
import heapq
import itertools
import math
from typing import List, Optional, Tuple

class Solution:
    def minCost(self, m: int, n: int, penalty: List[List[int]]) -> int:
        N = m * n
        goal = N - 1
        
        # Use a unique counter to prevent the heap from comparing tuples 
        # if two nodes have the exact same cost.
        counter = itertools.count()
        
        # Format: (cost, unique_counter, flattened_index)
        # We start at node 0 with cost = (0 + 1) * (0 + 1) = 1
        # The heap naturally acts as our visited set. A node is popped exactly once with its min cost.
        pq = [(1, next(counter), 0)]
        
        while pq:
            cost, _, u = heapq.heappop(pq)
            
            # If we reach the target, this is the absolute minimum cost
            if u == goal:
                return cost
            
            # Decode 1D state back to 2D coordinates
            r, c = divmod(u, n)
            
            # Determine if the *next* action is odd-numbered or even-numbered.
            # An odd action number means parity = 1, even means parity = 0.
            # The number of actions taken so far = number of edges traversed = r + c - dist_mod_2(u)
            # We only care if it's even or odd, so we use bitwise AND with 1.
            actions_taken_parity = (r + c - (u & 1)) & 1
            next_parity = 1 - actions_taken_parity  # 1 if next action is odd, 0 if even
            
            p_val = penalty[r][c]
            
            # --- Generate the 5 possible state transitions ---
            
            # 1. Wait in place
            v = u + N
            heapq.heappush(pq, (cost + p_val, next(counter), v))
            
            # 2. Move Down
            if r + 1 < m:
                # On odd parity, moving down follows the rules (no penalty)
                w = p_val if next_parity == 0 else 0
                v = u + n
                edge_cost = ((r + 2) * (c + 1)) + w
                heapq.heappush(pq, (cost + edge_cost, next(counter), v))
                
            # 3. Move Up
            if r - 1 >= 0:
                # On even parity, moving up follows the rules (no penalty)
                w = p_val if next_parity == 1 else 0
                v = u - n
                edge_cost = (r * (c + 1)) + w
                heapq.heappush(pq, (cost + edge_cost, next(counter), v))
                
            # 4. Move Right
            if c + 1 < n:
                # On odd parity, moving right follows the rules (no penalty)
                w = p_val if next_parity == 0 else 0
                v = u + 1
                edge_cost = ((r + 1) * (c + 2)) + w
                heapq.heappush(pq, (cost + edge_cost, next(counter), v))
                
            # 5. Move Left
            if c - 1 >= 0:
                # On even parity, moving left follows the rules (no penalty)
                w = p_val if next_parity == 1 else 0
                v = u - 1
                edge_cost = ((r + 1) * c) + w
                heapq.heappush(pq, (cost + edge_cost, next(counter), v))
                
        return -1
