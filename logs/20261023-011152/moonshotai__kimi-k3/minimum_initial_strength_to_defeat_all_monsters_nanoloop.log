class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        diff = [0] * (n + 1)
        for l, r, v in boosts:
            diff[l] += v
            diff[r + 1] += -v
        bonus = [0] * n
        cur = 0
        for i in range(n):
            cur += diff[i]
            bonus[i] = cur
        f = 0
        for i in range(n - 1, -1, -1):
            if f == 0:
                f = max(0, monsters[i] - bonus[i])
            else:
                f += monsters[i]
        return f
```

