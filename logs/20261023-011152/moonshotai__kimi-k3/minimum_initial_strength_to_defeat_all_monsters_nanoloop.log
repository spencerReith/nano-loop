**Approach:** Compute the per-index bonus with a difference array (O(n + m)). Then work backwards: let `f` be the minimum strength needed just before the current monster. If `f == 0` (nothing needed afterward), we only need `strength + bonus >= monsters[i]`. If `f > 0`, we need `strength - monsters[i] >= f`, so `f += monsters[i]` (the bonus condition is then automatically satisfied since bonuses are non-negative).

```python
class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        # Compute bonus at each index via difference array
        diff = [0] * (n + 1)
        for l, r, v in boosts:
            diff[l] += v
            diff[r + 1] -= v

        # Process from right to left.
        # f = minimum strength needed just before fighting monster i
        # to defeat monsters i..n-1.
        f = 0
        cur_bonus = 0
        # We need bonus per index; compute on the fly by precomputing array
        bonus = [0] * n
        for i in range(n):
            cur_bonus += diff[i]
            bonus[i] = cur_bonus

        for i in range(n - 1, -1, -1):
            if f == 0:
                # After this fight strength just needs to be >= 0,
                # so we only need s + bonus[i] >= monsters[i]
                need = monsters[i] - bonus[i]
                f = need if need > 0 else 0
            else:
                # After this fight we need strength >= f, so
                # s - monsters[i] >= f  =>  s >= monsters[i] + f
                # (this automatically satisfies s + bonus[i] >= monsters[i]
                #  because bonus[i] >= 0)
                f += monsters[i]
        return f
```