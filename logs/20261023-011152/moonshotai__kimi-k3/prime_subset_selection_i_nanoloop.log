1. **Sieve** all primes ≤ n.
2. **Maximize count**: find max k such that the k smallest primes sum to ≤ s.
3. **Lexicographically largest**: greedily pick each position left-to-right, binary searching for the largest prime such that the cheapest valid completion (the next r smallest primes after it) still fits the budget.

```python
class Solution:
    def maxPrimes(self, n: int, s: int) -> list[int]:
        if n < 2:
            return []
        # Sieve of Eratosthenes
        is_prime = bytearray(b'\x01') * (n + 1)
        is_prime[0] = is_prime[1] = 0
        for i in range(2, int(n ** 0.5) + 1):
            if is_prime[i]:
                is_prime[i * i::i] = bytearray((n - i * i) // i + 1)
        primes = [i for i in range(2, n + 1) if is_prime[i]]

        m = len(primes)
        pre = [0] * (m + 1)
        for i, p in enumerate(primes):
            pre[i + 1] = pre[i] + p

        # Maximum number of primes we can select
        k = 0
        while k < m and pre[k + 1] <= s:
            k += 1
        if k == 0:
            return []

        # Greedily build lexicographically largest selection of size k.
        # For position j, pick the largest prime such that the remaining
        # positions can still be filled (cheapest completion) within budget.
        res = []
        budget = s
        prev = -1
        for j in range(k):
            r = k - 1 - j  # primes still needed after this position
            lo = prev + 1
            hi = m - k + j  # must leave at least r primes after chosen index
            best = -1
            while lo <= hi:
                mid = (lo + hi) // 2
                # cost of choosing primes[mid] plus the r cheapest primes after it
                if pre[mid + r + 1] - pre[mid] <= budget:
                    best = mid
                    lo = mid + 1
                else:
                    hi = mid - 1
            res.append(primes[best])
            budget -= primes[best]
            prev = best
        return res
