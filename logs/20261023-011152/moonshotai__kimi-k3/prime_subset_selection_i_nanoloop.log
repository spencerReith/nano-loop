```python
class Solution:
    def maxPrimes(self, n: int, s: int) -> list[int]:
        # Sieve
        if n < 2:
            return []
        is_prime = bytearray(b'\x01') * (n + 1)
        is_prime[0] = is_prime[1] = 0
        for i in range(2, int(n**0.5) + 1):
            if is_prime[i]:
                is_prime[i*i::i] = bytearray(len(is_prime[i*i::i]))
        primes = [i for i in range(2, n+1) if is_prime[i]]
        
        m = len(primes)
        pre = [0]*(m+1)
        for i, p in enumerate(primes):
            pre[i+1] = pre[i] + p
        
        # find max k
        k = 0
        while k < m and pre[k+1] <= s:
            k += 1
        if k == 0:
            return []
        
        res = []
        budget = s
        prev = -1
        for j in range(k):
            r = k - 1 - j
            lo = prev + 1
            hi = m - k + j  # max index allowed so that r primes remain after
            # binary search largest cand in [lo, hi] with pre[cand+r+1]-pre[cand] <= budget
            best = -1
            while lo <= hi:
                mid = (lo+hi)//2
                if pre[mid+r+1] - pre[mid] <= budget:
                    best = mid
                    lo = mid + 1
                else:
                    hi = mid - 1
            res.append(primes[best])
            budget -= primes[best]
            prev = best
        return res
```

