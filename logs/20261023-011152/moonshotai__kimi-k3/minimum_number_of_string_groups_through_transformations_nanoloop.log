```python
class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        def least_rotation(s: str) -> str:
            # Booth's algorithm: find lexicographically minimal rotation
            n = len(s)
            if n <= 1:
                return s
            s2 = s + s
            i, j, k = 0, 1, 0
            while i < n and j < n and k < n:
                a = s2[i + k]
                b = s2[j + k]
                if a == b:
                    k += 1
                elif a > b:
                    i = i + k + 1
                    if i <= j:
                        i = j + 1
                    k = 0
                else:
                    j = j + k + 1
                    if j <= i:
                        j = i + 1
                    k = 0
            start = min(i, j)
            return s2[start:start + n]

        seen = set()
        for w in words:
            e = w[0::2]
            o = w[1::2]
            key = (least_rotation(e), least_rotation(o))
            seen.add(key)
        return len(seen)
```