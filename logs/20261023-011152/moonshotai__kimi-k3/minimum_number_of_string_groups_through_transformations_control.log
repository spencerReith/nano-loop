class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        def canon(s: str):
            even = s[::2]
            odd = s[1::2]
            # canonical rotation of even
            e = even + even
            i = 0; j = 1; k = 0
            n = len(even)
            if n:
                while i < n and j < n and k < n:
                    a = e[i+k]; b = e[j+k]
                    if a == b:
                        k += 1
                    elif a > b:
                        i = i + k + 1
                        if i <= j: i = j + 1
                        k = 0
                    else:
                        j = j + k + 1
                        if j <= i: j = i + 1
                        k = 0
                start = min(i, j)
                ev = even[start:] + even[:start]
            else:
                ev = ""
            # canonical rotation of odd
            o = odd + odd
            i = 0; j = 1; k = 0
            m = len(odd)
            if m:
                while i < m and j < m and k < m:
                    a = o[i+k]; b = o[j+k]
                    if a == b:
                        k += 1
                    elif a > b:
                        i = i + k + 1
                        if i <= j: i = j + 1
                        k = 0
                    else:
                        j = j + k + 1
                        if j <= i: j = i + 1
                        k = 0
                start = min(i, j)
                od = odd[start:] + odd[:start]
            else:
                od = ""
            return (ev, od)
        
        seen = set()
        count = 0
        for w in words:
            c = canon(w)
            if c not in seen:
                seen.add(c)
                count += 1
        return count
