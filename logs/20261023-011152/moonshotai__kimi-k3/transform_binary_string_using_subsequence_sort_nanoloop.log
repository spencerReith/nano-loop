# solution.py
class Solution:
    def transformStr(self, s: str, strs: list[str]) -> list[bool]:
        n = len(s)
        z = [0] * n
        c = 0
        for i, ch in enumerate(s):
            if ch == '0':
                c += 1
            z[i] = c
        Z = c
        ans = []
        for q in strs:
            a = 0
            placed = 0
            b = 0
            stack = []
            ok = True
            for i, ch in enumerate(q):
                if ch == '0':
                    a += 1
                elif ch == '?':
                    b += 1
                    stack.append(i)
                need = z[i] - a
                while placed < need:
                    if not stack:
                        ok = False
                        break
                    stack.pop()
                    placed += 1
                if not ok:
                    break
            if not ok:
                ans.append(False)
                continue
            r = Z - a
            ans.append(0 <= r <= b and placed <= r)
        return ans
```

Wait, there's a bug: `need = z[i] - a` — but `a` counts definite zeros in q's prefix, and `placed` counts '?'-zeros in prefix. Constraint: a + placed ≥ z[i], i.e., placed ≥ z[i] - a. ✓.

