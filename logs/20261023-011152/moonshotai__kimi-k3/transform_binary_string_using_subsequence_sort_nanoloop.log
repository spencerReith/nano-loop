```python
class Solution:
    def transformStr(self, s: str, strs: list[str]) -> list[bool]:
        n = len(s)
        # prefix zeros of s
        z = [0] * n  # z[i] = zeros in s[0..i]
        c = 0
        for i, ch in enumerate(s):
            if ch == '0':
                c += 1
            z[i] = c
        Z = c
        ans = []
        for q in strs:
            a = 0          # definite zeros so far
            placed = 0     # '?' set to 0
            stack = []     # positions of '?' currently 1
            feasible = True
            b = 0          # total '?'
            for i, ch in enumerate(q):
                if ch == '0':
                    a += 1
                elif ch == '?':
                    b += 1
                    stack.append(i)
                need = z[i] - a
                while placed < need:
                    if not stack:
                        feasible = False
                        break
                    stack.pop()
                    placed += 1
                if not feasible:
                    break
            if not feasible:
                ans.append(False)
                continue
            r = Z - a  # total '?' that must be 0
            if r < 0 or r > b or placed > r:
                ans.append(False)
            else:
                ans.append(True)
        return ans
```

