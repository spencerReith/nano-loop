```python
from math import gcd


class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        # A subarray is resilient iff for every element a in it, (S - a) % k == 0,
        # where S is the subarray sum. This forces all elements to share one residue
        # r mod k, and then S % k == (n * r) % k must equal r, i.e. (n - 1) * r % k == 0.
        # With g = gcd(r, k) and m = k // g, valid lengths are n ≡ 1 (mod m).
        # So within each maximal run of equal residues, the best length is
        # 1 + ((L - 1) // m) * m. (For r == 0, m == 1, giving L.)
        ans = 1
        i = 0
        n = len(nums)
        while i < n:
            r = nums[i] % k
            j = i
            while j < n and nums[j] % k == r:
                j += 1
            L = j - i
            m = k // gcd(r, k)
            best = 1 + ((L - 1) // m) * m
            if best > ans:
                ans = best
            i = j
        return ans
```