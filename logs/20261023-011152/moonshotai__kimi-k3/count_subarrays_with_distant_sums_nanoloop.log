class Solution:
    def distantSubarrays(self, nums: list[int], goal: int, k: int) -> int:
        n = len(nums)
        # Build prefix sums
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + nums[i]
        
        # For each prefix[j], count previous prefix[i] (i < j) with:
        # prefix[i] <= prefix[j] - goal - k  OR  prefix[i] >= prefix[j] - goal + k
        # Note: if k == 0, then abs(sum - goal) >= 0 is always true.
        # But careful: conditions overlap when k == 0 (both bounds equal).
        # If k == 0, all subarrays count. Total = n*(n+1)//2.
        if k == 0:
            return n * (n + 1) // 2
        
        # Coordinate compression
        # We need to query count of values <= X and >= Y among inserted values.
        # Inserted values are prefix sums. Query bounds are prefix[j] - goal - k and prefix[j] - goal + k.
        # Compress all prefix values plus the bounds.
        
        values = set()
        for p in prefix:
            values.add(p)
            values.add(p - goal - k)
            values.add(p - goal + k)
        
        sorted_vals = sorted(values)
        comp = {v: i + 1 for i, v in enumerate(sorted_vals)}  # 1-indexed
        size = len(sorted_vals)
        
        bit = [0] * (size + 2)
        
        def update(i):
            while i <= size:
                bit[i] += 1
                i += i & (-i)
        
        def query(i):  # count of values with compressed index <= i
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & (-i)
            return s
        
        # Helper: count inserted values <= x
        def count_le(x):
            # find compressed index of largest value <= x
            import bisect
            idx = bisect.bisect_right(sorted_vals, x)
            return query(idx)
        
        def count_ge(x):
            import bisect
            idx = bisect.bisect_left(sorted_vals, x)
            # values with comp index >= idx+1 → count = total - query(idx)
            return None  # handle inline
        
        import bisect
        ans = 0
        inserted = 0
        update(comp[prefix[0]])
        inserted = 1
        
        for j in range(1, n + 1):
            p = prefix[j]
            low = p - goal - k   # count previous <= low
            high = p - goal + k  # count previous >= high
            
            # count <= low
            idx_low = bisect.bisect_right(sorted_vals, low)
            cnt_low = query(idx_low)
            
            # count >= high
            idx_high = bisect.bisect_left(sorted_vals, high)
            cnt_high = inserted - query(idx_high)
            
            ans += cnt_low + cnt_high
            
            update(comp[p])
            inserted += 1
        
        return ans
