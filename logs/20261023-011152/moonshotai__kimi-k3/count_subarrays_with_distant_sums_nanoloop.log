```python
import bisect


class Solution:
    def distantSubarrays(self, nums: list[int], goal: int, k: int) -> int:
        n = len(nums)

        # |sum - goal| >= k is always true when k == 0
        if k == 0:
            return n * (n + 1) // 2

        # prefix sums
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + nums[i]

        # For each j, count previous prefix[i] (i < j) with:
        #   prefix[j] - prefix[i] >= goal + k  ->  prefix[i] <= prefix[j] - goal - k  (low)
        #   prefix[j] - prefix[i] <= goal - k  ->  prefix[i] >= prefix[j] - goal + k  (high)

        # Coordinate compression of prefix values and query bounds
        values = set()
        for p in prefix:
            values.add(p)
            values.add(p - goal - k)
            values.add(p - goal + k)
        sorted_vals = sorted(values)
        comp = {v: i + 1 for i, v in enumerate(sorted_vals)}  # 1-indexed
        size = len(sorted_vals)

        bit = [0] * (size + 2)

        def update(i: int) -> None:
            while i <= size:
                bit[i] += 1
                i += i & (-i)

        def query(i: int) -> int:  # number of inserted values with comp index <= i
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & (-i)
            return s

        ans = 0
        update(comp[prefix[0]])
        inserted = 1

        for j in range(1, n + 1):
            p = prefix[j]
            low = p - goal - k
            high = p - goal + k

            # count of previous prefix values <= low
            idx_low = bisect.bisect_right(sorted_vals, low)
            cnt_low = query(idx_low)

            # count of previous prefix values >= high
            idx_high = bisect.bisect_left(sorted_vals, high)
            cnt_high = inserted - query(idx_high)

            ans += cnt_low + cnt_high

            update(comp[p])
            inserted += 1

        return ans
```