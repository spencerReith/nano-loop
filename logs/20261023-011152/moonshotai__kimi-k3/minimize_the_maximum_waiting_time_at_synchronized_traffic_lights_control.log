class Solution:
    def minPenalty(self, period: int, lights: list[int], arrivalTime: list[int]) -> int:
        best_green = max(lights)
        worst_r = 0
        found_bad = False

        for t in arrivalTime:
            r = t % period
            if r >= best_green:
                found_bad = True
                if r > worst_r:
                    worst_r = r

        # If every arrival falls in the green window [0, best_green),
        # all cars can wait 0 seconds.
        if not found_bad:
            return 0

        # Otherwise the largest residue in the red window forces
        # the minimum possible maximum waiting time.
        return period - worst_r
```