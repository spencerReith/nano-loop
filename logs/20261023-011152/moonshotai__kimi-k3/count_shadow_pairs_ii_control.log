from bisect import bisect_left
from operator import itemgetter

class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        INF = 1 << 62
        NEG_INF = -INF
        BLOCK = 32

        class Fenwick:
            __slots__ = ("n", "t")
            def __init__(self, n):
                self.n = n
                self.t = [0] * (n + 1)
            def add(self, i):
                i += 1
                t = self.t
                n = self.n
                while i <= n:
                    t[i] += 1
                    i += i & -i
            def pref(self, i):
                s = 0
                t = self.t
                while i > 0:
                    s += t[i]
                    i -= i & -i
                return s
            def kth(self, k):
                i = 0
                step = 1 << (self.n.bit_length() - 1)
                t = self.t
                n = self.n
                while step:
                    j = i + step
                    if j <= n and t[j] < k:
                        i = j
                        k -= t[j]
                    step >>= 1
                return i
```
