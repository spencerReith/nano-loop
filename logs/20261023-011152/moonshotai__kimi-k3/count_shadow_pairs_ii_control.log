        def solve(l,r):
            if r-l+1 <= CUT:
                return brute(l,r)
            mid=(l+r)//2
            ans=solve(l,mid)+solve(mid+1,r)
            left,coords=build_left(nums[l:mid+1])
            right=build_right(nums[mid+1:r+1])
            return ans+cross_count(left,right,coords)
