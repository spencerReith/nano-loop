from bisect import bisect_left
from operator import itemgetter

class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        INF = 1 << 62
        NEG_INF = -INF
        BLOCK = 32

        class Fenwick:
            __slots__ = ("n", "t")

            def __init__(self, n: int):
                self.n = n
                self.t = [0] * (n + 1)

            def add(self, i: int) -> None:
                i += 1
                t = self.t
                n = self.n
                while i <= n:
                    t[i] += 1
                    i += i & -i

            def pref(self, i: int) -> int:
                s = 0
                t = self.t
                while i > 0:
                    s += t[i]
                    i -= i & -i
                return s

            def kth(self, k: int) -> int:
                i = 0
                step = 1 << (self.n.bit_length() - 1)
                t = self.t
                n = self.n
                while step:
                    j = i + step
                    if j <= n and t[j] < k:
                        i = j
                        k -= t[j]
                    step >>= 1
                return i

        def brute(l: int, r: int) -> int:
            a = nums
            ans = 0
            for i in range(l, r):
                x = a[i]
                limit = INF
                for j in range(i + 1, r + 1):
                    y = a[j]
                    if x < y:
                        if y <= limit:
                            ans += 1
                        if y < limit:
                            limit = y
            return ans

        def left_limits(vals: list[int]):
            coords = sorted(set(vals))
            rank = {v: i for i, v in enumerate(coords)}
            bit = Fenwick(len(coords))
            pref = bit.pref
            kth = bit.kth
            add = bit.add

            items = []
            active = 0
            for x in reversed(vals):
                r = rank[x]
                leq = pref(r + 1)
                if leq < active:
                    limit = coords[kth(leq + 1)]
                else:
                    limit = INF
                items.append((limit, r))
                add(r)
                active += 1
            return items, coords

        def right_limits(vals: list[int]):
            coords = sorted(set(vals))
            rank = {v: i for i, v in enumerate(coords)}
            bit = Fenwick(len(coords))
            pref = bit.pref
            kth = bit.kth
            add = bit.add

            items = []
            for x in vals:
                r = rank[x]
                less = pref(r)
                if less:
                    low = coords[kth(less)]
                else:
                    low = NEG_INF
                items.append((x, low))
                add(r)
            return items

        def cross_count(left: list[tuple[int, int]],
                       right: list[tuple[int, int]],
                       coords: list[int]) -> int:
            left.sort(key=itemgetter(0), reverse=True)
            right.sort(key=itemgetter(0), reverse=True)

            bit = Fenwick(len(coords))
            add = bit.add
            pref = bit.pref
            bl = bisect_left

            p = 0
            ans = 0
            m = len(left)
            for y, low in right:
                while p < m and left[p][0] >= y:
                    add(left[p][1])
                    p += 1
                ans += pref(bl(coords, y)) - pref(bl(coords, low))
            return ans

        def solve(l: int, r: int) -> int:
            if r - l + 1 <= BLOCK:
                return brute(l, r)

            mid = (l + r) // 2
            ans = solve(l, mid) + solve(mid + 1, r)

            left, coords = left_limits(nums[l:mid + 1])
            right = right_limits(nums[mid + 1:r + 1])
            return ans + cross_count(left, right, coords)

        return solve(0, len(nums) - 1)
```