def left_limits(a): # values segment [l..mid], returns [(M,x)] in scan order
    uniq=sorted(set(a))
    rank={v:i for i,v in enumerate(uniq)}
    bit=Fenwick(len(uniq))
    res=[None]*len(a)
    for idx in range(len(a)-1,-1,-1):
       x=a[idx]; r=rank[x]
       le=bit.pref(r+1)
       if le < active: # active number inserted
          M=uniq[bit.kth(le+1)]
       else INF
       res[idx]=(M,x)
       bit.add(r); active+=1
    return res
```
