Full code:
```
from bisect import bisect_left
from operator import itemgetter

class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        INF = 1 << 62
        NEG_INF = -INF
        CUT = 32

        class Fenwick:
            __slots__ = ("n", "t")
            def __init__(self, n: int):
                self.n = n
                self.t = [0] * (n + 1)
            def add(self, idx: int) -> None:
                idx += 1
                n = self.n
                t = self.t
                while idx <= n:
                    t[idx] += 1
                    idx += idx & -idx
            def pref(self, idx: int) -> int:
                s = 0
                t = self.t
                while idx > 0:
                    s += t[idx]
                    idx -= idx & -idx
                return s
            def kth(self, k: int) -> int:
                idx = 0
                step = 1 << (self.n.bit_length() - 1)
                t = self.t
                while step:
                    nxt = idx + step
                    if nxt <= self.n and t[nxt] < k:
                        idx = nxt
                        k -= t[nxt]
                    step >>= 1
                return idx
```
`kth` returns zero-based. Good.

