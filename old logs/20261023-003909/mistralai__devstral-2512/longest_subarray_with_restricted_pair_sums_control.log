```python
class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        max_len = 0
        left = 0
        freq = {}

        for right in range(len(nums)):
            num = nums[right]
            # Check if there exists any two elements in the current window that sum to num
            # So, for each x in freq, check if (num - x) is in freq
            # But we need to ensure that x and (num -x) are distinct elements or same elements with count >=2
            found = False
            for x in freq:
                y = num - x
                if y in freq:
                    if x != y or freq[x] >= 2:
                        found = True
                        break
            # If found, move left forward until the condition is no longer met
            while found:
                left_num = nums[left]
                freq[left_num] -= 1
                if freq[left_num] == 0:
                    del freq[left_num]
                left += 1
                # Re-check the condition
                found = False
                for x in freq:
                    y = num - x
                    if y in freq:
                        if x != y or freq[x] >= 2:
                            found = True
                            break
            # Add the current num to freq
            freq[num] = freq.get(num, 0) + 1
            current_len = right - left + 1
            if current_len > max_len:
                max_len = current_len
        return max_len
```

