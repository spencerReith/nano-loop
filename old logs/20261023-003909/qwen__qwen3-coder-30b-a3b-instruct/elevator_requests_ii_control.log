        for l in range(n_floors):  
            for r in range(l, n_floors):
                if l <= start_index <= r:
                    # Compute cost of visiting floors from left to right  
                    cost_l_to_r = 0
                    time_so_far = 0
                    i = l
                    # Cost of visiting floors in order:
                    if i == start_index:
                        time_so_far += 0  # Penalty at start is 0 
                    else:
                        time_so_far = abs(floors[start_index] - floors[i])
                        
                    cost_l_to_r += time_so_far  
                    # If i = start_index, we've already visited, skew cost for next.  
                    for j in range(i+1, r+1):
                        time_so_far += abs(floors[j-1] - floors[j]) 
                        cost_l_to_r += time_so_far
                        
                    # Compute cost of visiting floors from right to left  
                    cost_r_to_l = 0
                    time_so_far = 0
                    # Last to go first, starts at last
                    if r == start_index:
                        time_so_far = 0
                    else:
                        time_so_far = abs(floors[start_index] - floors[r])
                    cost_r_to_l += time_so_far
                    for j in range(r-1, l-1, -1):  # backwards
                        time_so_far += abs(floors[j+1] - floors[j])
                        cost_r_to_l += time_so_far
                        
                    min_cost = min(min_cost, cost_l_to_r, cost_r_to_l)
                    
        return min_cost
```