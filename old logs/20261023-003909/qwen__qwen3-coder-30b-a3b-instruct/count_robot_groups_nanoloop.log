```python
class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        # Each element is [position, speed]
        robots = [[position[i], speed[i]] for i in range(len(position))]
        
        # Keep merging while possible
        while True:
            # Create groups from current robots
            groups = []
            if not robots:
                return 0
            
            # Group adjacent robots that are within distance
            i = 0
            while i < len(robots):
                current_group = [robots[i]]
                j = i + 1
                # Merge robots that are within distance
                while j < len(robots) and robots[j][0] - current_group[-1][0] <= distance:
                    current_group.append(robots[j])
                    j += 1
                groups.append(current_group)
                i = j
            
            # If no merges happened, return number of groups
            if len(groups) == len(robots):
                return len(groups)
            
            # Update robots list with merged groups
            robots = []
            for group in groups:
                # The new group has the position and speed of the rightmost robot
                # (the one with largest position in the group)
                rightmost = max(group, key=lambda x: x[0])
                robots.append(rightmost)
        
        return len(robots)
```

