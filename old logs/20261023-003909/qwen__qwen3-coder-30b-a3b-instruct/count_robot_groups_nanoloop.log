```python
class Solution:
    def countGroups(self, position: list[int], speed: list[int], distance: int) -> int:
        # Initial state: each robot is its own group  
        groups = [[position[i], speed[i]] for i in range(len(position))]
        
        # Keep merging groups while possible
        while True:
            new_groups = []
            i = 0
            merged = False
            
            # Process groups and merge consecutive ones that are within distance
            while i < len(groups):
                # Start a new group
                pos = groups[i][0]
                speed_val = groups[i][1]
                
                # Merge with consecutive groups that are within distance
                j = i + 1
                while j < len(groups) and groups[j][0] - pos <= distance:
                    pos = groups[j][0] 
                    speed_val = groups[j][1]
                    merged = True
                    j += 1
                    
                new_groups.append([pos, speed_val])
                i = j
                
            # If no merging occurred, we're done
            if not merged:
                return len(new_groups)
                
            groups = new_groups
```