class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        result = 0
        stack = []  # Store (value, valid_count) pairs
        
        for j in range(n):
            # Count how many i < j can form valid shadow pairs with current j
            valid_count = 0
            
            # Remove elements from stack that are smaller than nums[j]
            # These elements cannot possibly be valid starting points anymore because 
            # if nums[i] < nums[j], a later element would be able to form more pairs
            while stack and stack[-1][0] < nums[j]:
                # Pop elements - they can't be valid starting points anymore
                stack.pop()
            
            # All remaining elements in stack can form shadow pairs with j  
            # (because their values are >= nums[j])
            valid_count = len(stack)
            
            # Store current value with valid count so far
            stack.append((nums[j], valid_count))
            result += valid_count
            
        return result
