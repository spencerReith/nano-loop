class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        result = 0
        
        for i in range(n):
            for j in range(i + 1, n):
                if nums[i] < nums[j]:
                    # Check if there's an element in between i and j such that 
                    # it lies between nums[i] and nums[j]
                    valid = True
                    for k in range(i + 1, j):
                        if nums[i] < nums[k] < nums[j]:
                            valid = False
                            break
                    
                    if valid:
                        result += 1
                        
        return result
