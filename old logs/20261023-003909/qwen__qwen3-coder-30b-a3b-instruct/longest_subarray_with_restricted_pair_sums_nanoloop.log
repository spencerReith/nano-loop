class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        if not nums:
            return 0
            
        max_length = 1
        
        # Try all possible starting positions
        for i in range(len(nums)):
            # For each starting point, extend the subarray as far as possible
            for j in range(i, len(nums)):
                # Check if subarray nums[i:j+1] is valid
                valid = True
                
                # Check if there are three distinct indices where nums[k1] + nums[k2] = nums[k3]
                for k1 in range(i, j+1):
                    for k2 in range(i, j+1):
                        if k2 == k1:
                            continue
                        for k3 in range(i, j+1):
                            if k3 == k1 or k3 == k2:
                                continue
                            if nums[k1] + nums[k2] == nums[k3]:
                                valid = False
                                break
                        if not valid:
                            break
                    if not valid:
                        break
                
                if valid:
                    max_length = max(max_length, j - i + 1)
                else:
                    # Since subarray starting at i with length j-i+1 is invalid,
                    # further extending it (j+1, j+2, ...) will also be invalid 
                    break
                    
        return max_length
