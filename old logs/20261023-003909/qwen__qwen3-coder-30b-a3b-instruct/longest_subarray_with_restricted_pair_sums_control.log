class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 0:
            return 0
        
        max_len = 1
        
        # Sliding window approach
        left = 0
        # Keep track of elements in current window and their indices
        element_indices = {}  # element -> set of indices in current window
        
        for right in range(n):
            current_element = nums[right]
            
            # Check if adding current_element creates forbidden triplets
            # We need to check if there exists two elements in current window
            # such that their sum equals current_element
            
            # For optimization: we can iterate through elements in current window
            # and check if (current_element - element) exists in current window
            # But we also need to make sure indices are distinct
            
            # Check all elements in current window
            for element in element_indices:
                required = current_element - element
                if required in element_indices:
                    # Check if there's a valid index for required element that's different from current right
                    # and check if there's a way to form a triplet with elements at indices i,j,k
                    # This is complex to check properly, let me approach differently
            
            # Simpler approach: for each element in current window, 
            # check if there's a sum that gives us the current element
            found_invalid = False
            
            # Check all combinations of elements in current window with current element
            # to see if any triplets are formed
            for element in element_indices:
                required = current_element - element
                # Check if required is in window and index is different from current
                if required in element_indices:
                    # Check if we can form a valid triplet: 
                    # need three distinct indices, one of which is the current position
                    # So we need two other elements such that their sum equals current element
                    # and all indices are different
                    found_invalid = True
                    break
            
            if found_invalid:
