```python
class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        
        # For each valid pair (i,j) where i < j and nums[i] < nums[j]
        for i in range(n):
            for j in range(i + 1, n):
                if nums[i] < nums[j]:
                    # Check if there exists k in (i,j) such that nums[i] < nums[k] < nums[j]
                    valid = True
                    for k in range(i + 1, j):
                        if nums[i] < nums[k] < nums[j]:
                            valid = False
                            break
                    if valid:
                        count += 1
        
        return count
```