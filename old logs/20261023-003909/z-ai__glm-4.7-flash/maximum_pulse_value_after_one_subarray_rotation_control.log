class Solution:
    def maxValue(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 2:
            return max(nums) - min(nums)
            
        # Calculate the original pulse value (P0)
        # P0 = sum(0) - sum(1) + sum(2) - sum(3) ...
        # P0 = nums[0] - nums[1] + nums[2] - nums[3] + ...
        total = 0
        is_pos = True
        for i in range(n):
            if is_pos:
                total += nums[i]
            else:
                total -= nums[i]
            is_pos = not is_pos
            
        # Optimal Gain calculation using prefix sums
        # We want to maximize: P_final - P_initial = -2 * (even_index) + 2 * (odd_index) within the window [l, r]
        # Let target index set be X.
        # If window length is even (M is even), we want to maximize (-arr[X] + arr[Y]) in window.
        # If window length is odd (M is odd), the boundary indices must be picked from valid set.
        # Formula: gain(l, r) = (prefix_odds[r+1] - prefix_odds[l]) - (prefix_evens[r+1] - prefix_evens[l]) * -1
        
        prefix_odds = [0] * (n + 1)
        prefix_evens = [0] * (n + 1)
        
        for i in range(n):
            prefix_odds[i + 1] = prefix_odds[i] + nums[i] if i % 2 == 0 else prefix_odds[i]
            prefix_evens[i + 1] = prefix_evens[i] + nums[i] if i % 2 == 1 else prefix_evens[i]
        
        # Max_gain stores the maximum difference (-2 * Even_Sum + 2 * Odd_Sum) achievable within any window
        max_gain = 0
        
        # To optimize and avoid O(N^2), we iterate for possible lengths M.
        # If M is even, effect is uniform: -2 * sum(even) + 2 * sum(odd) on window. 
        # To maximize this, we just find the difference between sum(odd) and sum(even) in the whole array.
        # If M is odd, we need to compare window starts.
        
        sum_odd = prefix_odds[n]
        sum_even = prefix_evens[n]
        
        if (n - 1) % 2 == 0:
            # Window length must be even
            gain = sum_odd - sum_even
            max_gain = max(0, gain)
        else:
            # Window length must be odd
            # If l is even, window is [l, r]. Indices: even, odd, even...
            # gain(l) = -2*sum(l..even) + 2*sum(l+1..odd)
            # If l is odd, window is [l, r]. Indices: odd, even, odd...
            # gain(l) = -2*sum(l..odd) + 2*sum(l+1..even)
            
            max_gain = 0
            for l in range(n):
                m = n - 1  # Length M = n-1
                # Indices from l to l+m-1
                end = l + m - 1
                # M is odd (n-1 is even? wait)
                # If n is even, n-1 is odd. Window is odd length.
                # If n is odd, n-1 is even. Window is even length.
                # constraint says n >= 1.
                # Case 1: n is odd (e.g. 3). M=2 (even). Apply simple gain formula.
                # Case 2: n is even (e.g. 4). M=3 (odd). Need logic.
                
                if n % 2 == 1:
                    # Window is even length
                    r = l + 2
                    if r < n:
                        # sum(odd) - sum(even) in window
                        w_sum_odd = prefix_odds[r] - prefix_odds[l]
                        w_sum_even = prefix_evens[r] - prefix_evens[l]
                        gain = (w_sum_odd - w_sum_even)
                        max_gain = max(max_gain, gain)
                else:
                    # n is even, M=3 (odd length)
                    # r = l + 2
                    # if l is even: even, odd, even
                    #   indices 0, 2 are even. 1 is odd.
                    #   -arr[0] + arr[1] - arr[2]
                    #   = -(prefix_odds[l+3]-prefix_odds[l]) + (prefix_odds[l+3]-prefix_odds[l+1])...
                    #   LHS: - (E3-El) = -E3 + El. 
                    #   RHS: (O3-O1) + (-E3+O1) = O3 - El.
                    #   Wait, let's re-verify.
                    #   w = l (even). P = -a + b - c.
                    #   sum_even(l, l+2) = a + c. sum_odd(l+1, l+2) = b.
                    #   -2*sum_even + 2*sum_odd = -2(a+c) + 2b. Correct.
                    
                    w_sum_odd = prefix_odds[l + 3] - prefix_odds[l]
                    w_sum_even = prefix_evens[l + 3] - prefix_evens[l]
                    gain = -(w_sum_even) + (w_sum_odd)
                    max_gain = max(max_gain, gain)
                    
                    # if l is odd: odd, even, odd
                    # indices 0, 2 are odd. 1 is even.
                    # a - b + c
                    # sum_odd = a + c. sum_even = b.
                    # -2*sum_even + 2*sum_odd = -2b + 2(a+c). Correct.
                    
                    w_sum_odd = prefix_odds[l + 3] - prefix_odds[l + 1]
                    w_sum_even = prefix_evens[l + 3] - prefix_evens[l + 1]
                    gain = -(w_sum_even) + (w_sum_odd)
                    max_gain = max(max_gain, gain)
        
        # Return the maximum pulse value
        return total + 2 * max_gain
