class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        from functools import lru_cache
        
        k = len(requests)
        if k == 0:
            return 0
        
        # Sort requests
        reqs = sorted(requests)
        
        # Use bitmask to represent visited floors
        all_mask = (1 << k) - 1
        
        @lru_cache(maxsize=None)
        def dp(mask, current_pos):
            """
            dp(mask, current_pos) = minimum penalty to visit all unvisited floors
            starting from current_pos, given the visited set is 'mask'
            """
            if mask == all_mask:
                return 0
            
            min_penalty = float('inf')
            
            for i in range(k):
                if not (mask & (1 << i)):
                    # Visit floor i
