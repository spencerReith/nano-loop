```python
class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        k = len(requests)
        if k == 0:
            return 0
        
        # Sort requests
        reqs = sorted(requests)
        visited = [False] * k
        
        # Find the index of start (if present)
        start_idx = -1
        for i, r in enumerate(reqs):
            if r == start:
                start_idx = i
                visited[i] = True
                break
        
        total_penalty = 0
        current_pos = start
        num_visited = (start_idx >= 0)
        
        while num_visited < k:
            # Find closest unvisited floor
            min_dist = float('inf')
            closest = -1
            for i in range(k):
                if not visited[i]:
                    dist = abs(reqs[i] - current_pos)
                    if dist < min_dist:
                        min_dist = dist
                        closest = i
            
            if closest == -1:
                break
            
            # Add penalty for this floor
            total_penalty += num_visited + min_dist
            
            # Update state
            visited[closest] = True
            current_pos = reqs[closest]
            num_visited += 1
        
        return total_penalty
```

