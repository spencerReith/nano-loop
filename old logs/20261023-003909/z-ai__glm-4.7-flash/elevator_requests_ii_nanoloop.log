```python
class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        k = len(requests)
        if k == 0:
            return 0
        
        # Sort requests
        reqs = sorted(requests)
        visited = [False] * k
        
        # Find and mark start (if present)
        start_idx = -1
        for i, r in enumerate(reqs):
            if r == start:
                start_idx = i
                visited[i] = True
                break
        
        # Start conditions
        current_pos = start
