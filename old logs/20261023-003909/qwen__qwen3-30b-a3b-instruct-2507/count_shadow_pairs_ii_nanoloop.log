                max_so_far = max(max_so_far, nums[j])
                
                # Check if nums[i] < nums[j] and no element in between
                if nums[i] < nums[j]:
                    if max_so_far <= nums[i] or min_so_far >= nums[j]:
                        count += 1
        
        return count
```

