```python
class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        
        for i in range(n):
            min_between = float('inf')
            max_between = float('-inf')
            
            for j in range(i + 1, n):
                # Update min and max for the range (i+1, j-1)
                if j > i + 1:
                    min_between = min(min_between, nums[j-1])
                    max_between = max(max_between, nums[j-1])
                
                # Check if nums[i] < nums[j] and no element in between
                if nums[i] < nums[j]:
                    if j == i + 1:  # No elements between i and j
                        count += 1
                    else:  # Check if any element in between is in (nums[i], nums[j])
                        if max_between <= nums[i] or min_between >= nums[j]:
                            count += 1
        
        return count
```