F(5)=F(4)+F(3)=3+2=5, f(5)=2*5=10

So the answer is 2 * F(n) where F(n) is the nth Fibonacci number with F(1)=1, F(2)=1.

Let me implement this with matrix exponentiation for large n.

```python
class Solution:
    def countGoodStrings(self, n: int) -> int:
        MOD = 10**9 + 7
        
        # Fibonacci number F(n) with F(1)=1, F(2)=1
        # F(n) = F(n-1) + F(n-2)
        # We want 2 * F(n) mod MOD
        
        if n == 1:
            return 2
        if n == 2:
            return 2
            
        # Matrix exponentiation for Fibonacci
        # [[F(n+1), F(n)], [F(n), F(n-1)]] = [[1,1],[1,0]]^(n-1)
        
        def matrix_mult(A, B):
            return [
                [(A[0][0]*B[0][0] + A[0][1]*B[1][0]) % MOD, (A[0][0]*B[0][1] + A[0][1]*B[1][1]) % MOD],
                [(A[1][0]*B[0][0] + A[1][1]*B[1][0]) % MOD, (A[1][0]*B[0][1] + A[1][1]*B[1][1]) % MOD]
            ]
        
        def matrix_power(mat, power):
            if power == 1:
                return mat
            if power % 2 == 0:
                half = matrix_power(mat, power // 2)
                return matrix_mult(half, half)
            else:
                return matrix_mult(mat, matrix_power(mat, power - 1))
        
        # Base matrix for Fibonacci
        base_matrix = [[1, 1], [1, 0]]
        result_matrix = matrix_power(base_matrix, n - 1)
        
        # F(n) = result_matrix[0][1] for this calculation
        # Because [[F(2), F(1)], [F(1), F(0)]] = [[1,1],[1,0]]^(n-1) gives F(n) = result_matrix[0][1] if F(1)=1, F(0)=0
        # Actually: if we have [[F(k+1), F(k)], [F(k), F(k-1)]] = [[1,1],[1,0]]^k
        # For k = n-1, we get [[F(n), F(n-1)], [F(n-1), F(n-2)]]
        # So F(n) = result_matrix[0][0]
        
        fibonacci_n = result_matrix[0][0]  # This is F(n)
        return (2 * fibonacci_n) % MOD
```

