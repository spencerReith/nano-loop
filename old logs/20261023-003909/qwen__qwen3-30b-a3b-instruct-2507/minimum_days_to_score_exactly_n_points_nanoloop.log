```python
class Solution:
    def minDays(self, n: int) -> int:
        # Find the maximum k such that k*(k+1)/2 <= n
        k = 0
        while (k + 1) * (k + 2) // 2 <= n:
            k += 1
        
        # If we can exactly reach n with a complete streak, return k
        if k * (k + 1) // 2 == n:
            return k
        
        # Otherwise, we have a remainder
        remainder = n - k * (k + 1) // 2
        
        # Find minimum m such that m*(m+1)/2 >= remainder
        m = 0
        while m * (m + 1) // 2 < remainder:
            m += 1
        
        # Total days: k (first streak) + 1 (skip) + m (second streak)
        return k + 1 + m
```