class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        max_length = 1  # At least one element is always valid
        
        # Try all possible subarrays
        for start in range(n):
            # We'll expand the window from start
            seen = set()
            for end in range(start, n):
                # Add current element to seen set
                current = nums[end]
                seen.add(current)
                
                # Check if current subarray is valid
                valid = True
                subarray = nums[start:end+1]
                length = len(subarray)
                
                # Check all possible sums of two distinct elements
                # We only need to check if the sum exists as a third distinct element
                for i in range(length):
                    for j in range(length):
                        if i == j:
                            continue
                        sum_val = subarray[i] + subarray[j]
                        # Check if this sum exists at a different index
                        for k in range(length):
                            if k != i and k != j and subarray[k] == sum_val:
                                valid = False
                                break
                        if not valid:
                            break
                    if not valid:
                        break
                
                if valid:
                    max_length = max(max_length, length)
                else:
                    # If current subarray is invalid, we can't extend it further
                    # But we can still check other starting positions
                    pass
        
        return max_length
