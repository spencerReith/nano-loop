class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        
        # For each j from 1 to n-1
        for j in range(1, n):
            # Check all i < j
            for i in range(j):
                if nums[i] < nums[j]:
                    # Check if there exists k in (i, j) such that nums[i] < nums[k] < nums[j]
                    has_blocking = False
                    for k in range(i + 1, j):
                        if nums[i] < nums[k] < nums[j]:
                            has_blocking = True
                            break
                    
                    if not has_blocking:
                        count += 1
        
        return count
```

