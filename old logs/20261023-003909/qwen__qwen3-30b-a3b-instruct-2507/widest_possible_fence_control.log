class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        from collections import Counter
        
        # Count frequency of each plank height
        count = Counter(planks)
        
        # Get all unique heights
        heights = list(count.keys())
        
        # Try each possible target height
        max_width = 1  # At minimum, we can always use one plank
        
        # We can use any height that appears in the original planks
        # or any sum of two distinct planks
        possible_heights = set(heights)
        
        # Add all possible sums of two distinct planks
        for i in range(len(heights)):
            for j in range(i + 1, len(heights)):
                possible_heights.add(heights[i] + heights[j])
        
        # For each possible target height, calculate maximum width
        for target in possible_heights:
            # We can use a plank as is or combine two planks
            # We need to count how many planks of each height we have
            # and how many pairs we can form
            
            # Start with the count of original planks
            available = count.copy()
            width = 0
            
            # Try to use as many planks as possible to form the target height
            # We can form target height in two ways:
            # 1. Use a single plank of height 'target'
            # 2. Use two distinct planks whose sum is 'target'
            
            # First, use single planks of height target
            if target in available:
                width += available[target]
                available[target] = 0
            
            # Then, for each possible combination (a, b) such that a + b = target
            # where a <= b to avoid double counting
            # and a != b for distinct planks
            for a in heights:
                if a >= target:
                    continue
                b = target - a
                if b not in available or b == a:
                    continue
                # We can form min(available[a], available[b]) pairs
                pairs = min(available[a], available[b])
                width += pairs
                available[a] -= pairs
                available[b] -= pairs
            
            max_width = max(max_width, width)
        
        return max_width
