from typing import List

class Solution:
    def aggregateTimeSeries(self, series1: List[List[int]], series2: List[List[int]]) -> List[List[int]]:
        result = []
        i = 0
        j = 0
        n = len(series1)
        m = len(series2)
        while i < n or j < m:
            t1 = series1[i][0] if i < n else None
            t2 = series2[j][0] if j < m else None
            if t1 is not None and (t2 is None or t1 <= t2):
                t = t1
            else:
                t = t2
            if i < n and series1[i][0] <= t:
                v1 = series1[i][1]
                i += 1
            else:
                v1 = 0
            if j < m and series2[j][0] <= t:
                v2 = series2[j][1]
                j += 1
            else:
                v2 = 0
            result.append([t, v1 + v2])
        return result
```