class Solution:
    def maximumValue(self, n: int, s: int, m: int) -> int:
        if n == 1:
            return s
        # Best pattern: +m, -1, +m, -1, ...
        # There are n//2 useful upward moves before the maximum peak.
        return s + (n // 2) * (m - 1) + 1
```