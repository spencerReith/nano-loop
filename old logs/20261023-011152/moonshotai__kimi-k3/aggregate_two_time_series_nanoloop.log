Option A: Using bisect for clarity:

from bisect import bisect_left
class Solution:
    def aggregateTimeSeries(self, series1, series2):
        def values(series):
            times=[x[0] for x in series]; vals=[x[1] for x in series]
            def get(t):
                i=bisect_left(times,t)
                return vals[i] if i < len(vals) else 0
            return get
        f1=values(series1); f2=values(series2)
        timestamps = sorted({t for t,_ in series1} | {t for t,_ in series2})
        return [[t, f1(t)+f2(t)] for t in timestamps]

