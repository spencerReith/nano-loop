class Solution:
    def aggregateTimeSeries(self, series1: list[list[int]], series2: list[list[int]]) -> list[list[int]]:
        i = j = 0
        n1, n2 = len(series1), len(series2)
        ans = []

        while i < n1 or j < n2:
            t1 = series1[i][0] if i < n1 else None
            t2 = series2[j][0] if j < n2 else None

            if t1 is None:
                t = t2
            elif t2 is None:
                t = t1
            else:
                t = min(t1, t2)

            # Invariant: series1[i] and series2[j] are the first entries with
            # timestamp >= t, so they are either exact matches or the next values.
            v1 = series1[i][1] if i < n1 else 0
            v2 = series2[j][1] if j < n2 else 0
            ans.append([t, v1 + v2])

            while i < n1 and series1[i][0] == t:
                i += 1
            while j < n2 and series2[j][0] == t:
                j += 1

        return ans
