```python
class Solution:
    def largestString(self, nums: list[int]) -> list[str]:
        M = 1 << 25
        res = []
        for x in nums:
            q, r = divmod(x, M)
            parts = ['z'] * q
            for i in range(24, -1, -1):
                if r >> i & 1:
                    parts.append(chr(ord('a') + i))
            res.append(''.join(parts))
        return res
```

