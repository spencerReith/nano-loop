class Solution:
    def validSubarrays(self, nums: list[int], k: int, queries: list[list[int]]) -> list[bool]:
        n = len(nums)
        q = len(queries)

        comp = {}
        ids = [0] * n
        for i, v in enumerate(nums):
            j = comp.get(v)
            if j is None:
                j = len(comp)
                comp[v] = j
            ids[i] = j
        m = len(comp)

        MASK = (1 << 64) - 1
        fp = [0] * m
        s = 0x243F6A8885A308D3
        for i in range(m):
            s = (s + 0x9E3779B97F4A7C15) & MASK
            z = s
            z = ((z ^ (z >> 30)) * 0xBF58476D1CE4E5B9) & MASK
            z = ((z ^ (z >> 27)) * 0x94D049BB133111EB) & MASK
            h1 = z ^ (z >> 31)

            s = (s + 0x9E3779B97F4A7C15) & MASK
            z = s
            z = ((z ^ (z >> 30)) * 0xBF58476D1CE4E5B9) & MASK
            z = ((z ^ (z >> 27)) * 0x94D049BB133111EB) & MASK
            h2 = z ^ (z >> 31)

            fp[i] = h1 | (h2 << 64)

        pref = [0] * (n + 1)
        x = 0
        for i, j in enumerate(ids, 1):
            x ^= fp[j]
            pref[i] = x

        by_right = [[] for _ in range(n)]
        for qi, (l, r) in enumerate(queries):
            by_right[r].append((l, qi))

        bit = [0] * (n + 1)

        def add(pos: int, delta: int) -> None:
            i = pos + 1
            while i <= n:
                bit[i] += delta
                i += i & -i

        def presum(i: int) -> int:
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & -i
            return s

        ans = [False] * q
        last = [-1] * m
        need = k << 1

        for r, j in enumerate(ids):
            lp = last[j]
            if lp != -1:
                add(lp, -1)
            add(r, 1)
            last[j] = r

            br = by_right[r]
            if not br:
                continue

            base = pref[r + 1]
            right_sum = presum(r + 1)
            for l, qi in br:
                length = r - l + 1
                if length < need or (length & 1):
                    continue
                if right_sum - presum(l) == k and pref[l] == base:
                    ans[qi] = True

        return ans
```