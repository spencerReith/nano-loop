Algorithm code:
```
from collections import defaultdict

class Solution:
    def validSubarrays(self, nums: list[int], k: int, queries: list[list[int]]) -> list[bool]:
        n = len(nums)
        # compress values
        vals = sorted(set(nums))
        comp = {v:i for i,v in enumerate(vals)}
        m = len(vals)
        MASK = (1 << 64) - 1
        def sm64(x):
            x = (x + 0x9E3779B97F4A7C15) & MASK
            x = ((x ^ (x >> 30)) * 0xBF58476D1CE4E5B9) & MASK
            x = ((x ^ (x >> 27)) * 0x94D049BB133111EB) & MASK
            return x ^ (x >> 31)
        # fingerprint for each compressed id: two independent 64-bit halves packed
        fp = [0] * m
        for i, v in enumerate(vals):
            a = sm64(v + 0x100000001B3)  #? need use i maybe
            b = sm64((v << 1) ^ 0xA0761D6478BD642F)
            fp[i] = a | (b << 64)
        pref = [0] * (n + 1)
        x = 0
        for i, v in enumerate(nums, 1):
            x ^= fp[comp[v]]
            pref[i] = x
        # group queries by right endpoint
        qs = [[] for _ in range(n)]
        for qi,(l,r) in enumerate(queries):
            qs[r].append((l,qi))
        bit = [0]*(n+1)
        def add(idx, delta):
            i = idx + 1
            while i <= n:
                bit[i] += delta
                i += i & -i
        def sum_(idx): # sum [0..idx]
            s=0
            i=idx+1
            while i>0:
                s += bit[i]
                i -= i & -i
            return s
        ans = [False]*len(queries)
        last = [-1]*m
        for r, v in enumerate(nums):
            c = comp[v]
            if last[c] != -1:
                add(last[c], -1)
            add(r, 1)
            last[c] = r
            base = pref[r+1]
            for l,qi in qs[r]:
                # distinct in [l,r]
                d = sum_(r) - (sum_(l-1) if l else 0)
                if d == k and pref[l] == base:
                    ans[qi] = True
        return ans
```
