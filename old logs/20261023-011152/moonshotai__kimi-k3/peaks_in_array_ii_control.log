class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums)
        
        # is_peak[i] = 1 if i is a peak (1 <= i <= n-2), else 0
        is_peak = [0] * n
        for i in range(1, n - 1):
            if nums[i] > nums[i - 1] and nums[i] > nums[i + 1]:
                is_peak[i] = 1
        
        # Fenwick tree over is_peak
        bit = [0] * (n + 1)
        
        def bit_add(i: int, delta: int) -> None:
            i += 1  # 1-indexed
            while i <= n:
                bit[i] += delta
                i += i & (-i)
        
        def bit_sum(i: int) -> int:
            # prefix sum of is_peak[0..i]
            if i < 0:
                return 0
            s = 0
            i += 1
            while i > 0:
                s += bit[i]
                i -= i & (-i)
            return s
        
        for i in range(n):
            if is_peak[i]:
                bit_add(i, 1)
        
        def count_subarrays(l: int, r: int) -> int:
            # p = number of peaks in (l, r) => indices l+1..r-1
            if r - l < 2:
                return 0
            p = bit_sum(r - 1) - bit_sum(l)
            # total subarrays of length >= 3 in [l, r] minus those with no peak
            length = r - l + 1
            total = (length - 1) * (length - 2) // 2
            m = length - 2  # number of internal positions
            no_peak = (m - p) * (m - p + 1) // 2
            return total - no_peak
        
        def refresh(idx: int) -> None:
            # recompute peak status for idx (only valid if 1 <= idx <= n-2)
            if idx <= 0 or idx >= n - 1:
                return
            new_val = 1 if (nums[idx] > nums[idx - 1] and nums[idx] > nums[idx + 1]) else 0
            if new_val != is_peak[idx]:
                is_peak[idx] = new_val
                bit_add(idx, 1 if new_val == 1 else -1)
        
        ans = []
        for q in queries:
            if q[0] == 1:
                _, l, r = q
                ans.append(count_subarrays(l, r))
            else:
                _, idx, val = q
                nums[idx] = val
                # only idx-1, idx, idx+1 can change peak status
                refresh(idx - 1)
                refresh(idx)
                refresh(idx + 1)
        
        return ans
```