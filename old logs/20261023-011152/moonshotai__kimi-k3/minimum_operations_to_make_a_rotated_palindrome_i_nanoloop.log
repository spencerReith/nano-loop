class Solution:
    def minOperations(self, s: str) -> int:
        a = [ord(c) - 97 for c in s]
        n = len(a)
        half = n // 2
        ans = 10**9
        for k in range(n):
            total = k
            # compare mirrored positions in s[k:] + s[:k]
            for i in range(half):
                x = k + i
                if x >= n:
                    x -= n
                y = k + (n - 1 - i)
                if y >= n:
                    y -= n
                d = a[x] - a[y]
                if d < 0:
                    d = -d
                if d > 13:
                    d = 26 - d
                total += d
            if total < ans:
                ans = total
        return ans

Check y index: y = k+n-1-i. Max k=n-1, i=0 => y=2n-2; subtract n once => n-2? Wait if k=n-1 and i=0, rotated index for j=n-1 is (k+j)%n = (n-1+n-1)%n = (2n-2)%n = n-2 for n>2. Is that correct? t = s[n-1:]+s[:n-1] = [s_{n-1}, s_0, ..., s_{n-2}]. Mirrored pair i=0,j=n-1: t[0]=s_{n-1}, t[n-1]=s_{n-2}. Yes y=n-2. Good. For n=2,k=1,i=0: y=1+1=2; subtract n=2 ->0; t=[s1,s0], pair s1,s0. Good. For n=2,k=0 y=1 no subtract. Good.

