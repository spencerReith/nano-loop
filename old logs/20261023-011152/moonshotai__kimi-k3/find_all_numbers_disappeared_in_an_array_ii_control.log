class Solution:
    def findDisappearedNumbers(self, nums: list[int], lower: int, upper: int) -> list[list[int]]:
        present = set(x for x in nums if lower <= x <= upper)
        
        ans = []
        start = -1
        for x in range(lower, upper + 2):
            if x <= upper and x not in present:
                if start == -1:
                    start = x
            else:
                if start != -1:
                    ans.append([start, x - 1])
                    start = -1
        return ans
```