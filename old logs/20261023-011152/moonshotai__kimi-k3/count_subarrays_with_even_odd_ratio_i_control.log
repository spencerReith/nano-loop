class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        # Transform: even -> b, odd -> -a
        # Valid iff y > 0 and b*x - a*y <= 0, i.e. prefix sum P[j] <= P[i] with at least one odd in (i, j]
        n = len(nums)
        vals = [b if v % 2 == 0 else -a for v in nums]
        
        # Coordinate compress all prefix sums
        P = [0] * (n + 1)
        for i in range(n):
            P[i + 1] = P[i] + vals[i]
        sorted_vals = sorted(set(P))
        comp = {v: i + 1 for i, v in enumerate(sorted_vals)}  # 1-indexed for BIT
        m = len(sorted_vals)
        
        bit = [0] * (m + 2)
        
        def update(i: int, delta: int) -> None:
            while i <= m:
                bit[i] += delta
                i += i & (-i)
        
        def query(i: int) -> int:
            s = 0
            while i > 0:
                s += bit[i]
                i -= i & (-i)
            return s
        
        ans = 0
        odd_seen = 0
        update(comp[P[0]], 1)  # insert P[0]
        
        for j in range(1, n + 1):
            if nums[j - 1] % 2 == 1:
                odd_seen += 1
            if odd_seen > 0:
                # count previous prefix sums <= P[j]
                ans += query(comp[P[j]])
            update(comp[P[j]], 1)
        
        return ans
