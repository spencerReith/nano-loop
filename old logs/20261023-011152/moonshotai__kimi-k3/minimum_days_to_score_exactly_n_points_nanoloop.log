def dp_all(N):
    tri = [k*(k+1)//2 for k in range(1, 400) if k*(k+1)//2 <= N]
    INF = float('inf')
    f = [INF]*(N+1)
    f[0] = -1
    for s in range(1, N+1):
        best = INF
        for k, t in enumerate(tri, start=1):
            if t > s: break
            v = f[s-t] + k + 1
            if v < best: best = v
        f[s] = best
    return f
```

