```python
def dp_all(N):
    tri = []
    k = 1
    while k*(k+1)//2 <= N:
        tri.append(k*(k+1)//2)
        k += 1
    INF = float('inf')
    f = [INF]*(N+1)
    f[0] = -1
    g = [0]*(N+1)  # min streaks
    for x in range(1, N+1):
        best = INF
        bg = 0
        fx = f  # local
        for i, t in enumerate(tri):
            if t > x: break
            v = fx[x-t] + i  # i+1+1 = i+2; use i then add 2
            ...
        ...
```

