```python
class Solution:
    def minDays(self, n: int) -> int:
        # triangular numbers T_k = k*(k+1)//2 for k >= 0
        # n = T_a + T_b + T_c always possible (Gauss)
        # cost = a + b + c + (number of nonzero) - 1
        # minimize over a, b >= 0, c determined
        import math
        # max k with T_k <= n
        K = int((math.isqrt(8*n + 1) - 1) // 2) + 1
        tri = [k*(k+1)//2 for k in range(K+1)]
        is_tri = [False]*(n+1)
        tri_idx = [-1]*(n+1)
        for k, t in enumerate(tri):
            if t <= n:
                is_tri[t] = True
                tri_idx[t] = k
        INF = float('inf')
        ans = INF
        # precompute best pair value pb[r] = min over b,c>=0, T_b+T_c=r of b+c+nonzero(b)+nonzero(c)
        # then ans = min over a>=0 of a + nonzero(a) + pb[n - T_a] - 1
        pb = [INF]*(n+1)
        # b, c loops
        for b in range(len(tri)):
            Tb = tri[b]
            if Tb > n: break
            nb = 1 if b > 0 else 0
            for c in range(b, len(tri)):  # c >= b to avoid dup; fine for min
                Tc = tri[c]
                s = Tb + Tc
                if s > n: break
                val = b + c + nb + (1 if c > 0 else 0)
                if val < pb[s]:
                    pb[s] = val
        for a in range(len(tri)):
            Ta = tri[a]
            if Ta > n: break
            r = n - Ta
            if pb[r] == INF: continue
            cand = a + (1 if a > 0 else 0) + pb[r] - 1
            if cand < ans:
                ans = cand
        return ans
```

