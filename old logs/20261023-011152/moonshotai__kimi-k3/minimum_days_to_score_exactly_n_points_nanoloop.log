Let me write the code.

def minDays(self, n):
    # build triangular numbers up to n
    tri = [0]
    k = 1
    while k*(k+1)//2 <= n:
        tri.append(k*(k+1)//2)
        k += 1
    INF = float('inf')
    pb = [INF]*(n+1)
    L = len(tri)
    for b in range(L):
        Tb = tri[b]
        nb = 1 if b else 0
        for c in range(b, L):
            s = Tb + tri[c]
            if s > n:
                break
            val = b + c + nb + (1 if c else 0)
            if val < pb[s]:
                pb[s] = val
    ans = INF
    for a in range(L):
        Ta = tri[a]
        r = n - Ta
        v = pb[r]
        if v == INF:
            continue
        cand = a + (1 if a else 0) + v - 1
        if cand < ans:
            ans = cand
    return ans

