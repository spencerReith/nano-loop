from bisect import bisect_left

class Solution:
    def distantSubarrays(self, nums: list[int], goal: int, k: int) -> int:
        # A subarray sum S is distant iff |S - goal| >= k
        # That means S <= goal - k or S >= goal + k.
        # We'll count subarrays with sum <= (goal - k) and those with sum >= (goal + k).

        def count_at_most(T: int) -> int:
            # Count subarrays with sum <= T using prefix sums + Fenwick tree
            n = len(nums)
            prefix = [0] * (n + 1)
            for i in range(n):
                prefix[i + 1] = prefix[i] + nums[i]

            # We need pairs i < j with prefix[j] - prefix[i] <= T
            # => prefix[i] >= prefix[j] - T
            # Coordinate compress all prefix values
            all_vals = sorted(set(prefix))
            idx = {v: i + 1 for i, v in enumerate(all_vals)}  # 1-based for BIT
            size = len(all_vals)

            bit = [0] * (size + 2)

            def bit_add(i, v):
                while i <= size:
                    bit[i] += v
                    i += i & -i

            def bit_sum(i):
                s = 0
                while i > 0:
                    s += bit[i]
                    i -= i & -i
                return s

            count = 0
            # Insert prefix[0]
            bit_add(idx[prefix[0]], 1)

            for j in range(1, n + 1):
                # Need prefix[i] >= prefix[j] - T among i < j
                threshold = prefix[j] - T
                # Find first index in all_vals >= threshold
                pos = bisect_left(all_vals, threshold)  # 0-based
                if pos < size:
                    # Count all inserted prefix values with index >= pos+1 (1-based)
                    count += bit_sum(size) - bit_sum(pos)  # bit_sum(pos) sums 1..pos
                # Insert current prefix
                bit_add(idx[prefix[j]], 1)

            return count

        def count_at_least(T: int) -> int:
            # Count subarrays with sum >= T
            # Equivalent to total - count_at_most(T - 1)
            # But sums can be large; better to do directly.
            n = len(nums)
            prefix = [0] * (n + 1)
            for i in range(n):
                prefix[i + 1] = prefix[i] + nums[i]

            all_vals = sorted(set(prefix))
            idx = {v: i + 1 for i, v in enumerate(all_vals)}
            size = len(all_vals)

            bit = [0] * (size + 2)

            def bit_add(i, v):
                while i <= size:
                    bit[i] += v
                    i += i & -i

            def bit_sum(i):
                s = 0
                while i > 0:
                    s += bit[i]
                    i -= i & -i
                return s

            count = 0
            bit_add(idx[prefix[0]], 1)

            for j in range(1, n + 1):
                # Need prefix[i] <= prefix[j] - T among i < j
                threshold = prefix[j] - T
                # Find last index in all_vals <= threshold
                pos = bisect_left(all_vals, threshold + 1)  # first > threshold
                # pos is count of elements <= threshold (0-based count)
                if pos > 0:
                    count += bit_sum(pos)  # 1-based prefix sum up to pos
                bit_add(idx[prefix[j]], 1)

            return count

        lower = goal - k  # S <= lower
        upper = goal + k  # S >= upper

        return count_at_most(lower) + count_at_least(upper)
