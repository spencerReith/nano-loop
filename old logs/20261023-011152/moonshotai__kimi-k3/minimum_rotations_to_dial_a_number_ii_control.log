class Solution:
    def minRotations(self, n: int, s: str) -> int:
        def d(a, b):
            diff = abs(a - b)
            return min(diff, 10 - diff)
        
        digits = [int(c) for c in s]
        original = d(0, digits[0]) + sum(d(digits[i-1], digits[i]) for i in range(1, n))
        
        # suffix[i] = cost of dialing s[i..n-1] starting from pointer at s[i]
        # i.e., sum of d(s[j], s[j+1]) for j in [i, n-2]
        suffix = [0] * (n + 1)
        for i in range(n - 2, -1, -1):
            suffix[i] = suffix[i + 1] + d(digits[i], digits[i + 1])
        
        # prefix costs: cost of dialing s[0..j] from pointer at 0
        prefix_cost = 0
        ans = original
        for k in range(n):
            # prefix s[0..k-1] dialed normally, then reverse s[k..n-1]
            # last pointer after prefix: 0 if k==0 else digits[k-1]
            # reversed suffix: s[n-1], s[n-2], ..., s[k]
            # cost = prefix + d(last, s[n-1]) + suffix[k]
            last = 0 if k == 0 else digits[k - 1]
            cost = prefix_cost + d(last, digits[n - 1]) + suffix[k]
            if cost < ans:
                ans = cost
            if k < n - 1:
                prefix_cost += d(digits[k], digits[k + 1])
        
        return ans
