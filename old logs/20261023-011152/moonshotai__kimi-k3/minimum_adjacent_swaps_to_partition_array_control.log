class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        MOD = 10**9 + 7

        low = mid = high = 0
        ans = 0

        for x in nums:
            if x < a:
                # Previous elements in [a, b] or > b are inversions with this < a element.
                ans += mid + high
                low += 1
            elif x <= b:
                # Previous elements > b are inversions with this middle element.
                ans += high
                mid += 1
            else:
                high += 1

            ans %= MOD

        return ans
```