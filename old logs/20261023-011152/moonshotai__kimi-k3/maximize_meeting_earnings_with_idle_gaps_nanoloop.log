from itertools import combinations
def brute(meetings):
    n = len(meetings)
    best = 0
    for mask in range(1, 1 << n):
        sel = [meetings[i] for i in range(n) if mask >> i & 1]
        sel.sort()
        ok = True
        for a, b in zip(sel, sel[1:]):
            if b[0] < a[1]:
                ok = False
                break
        if not ok:
            continue
        total = sum(r for _, _, r in sel)
        for a, b in zip(sel, sel[1:]):
            total += b[0] - a[1]
        best = max(best, total)
    return best
```

