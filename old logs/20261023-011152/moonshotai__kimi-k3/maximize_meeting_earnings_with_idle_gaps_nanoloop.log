**Approach:** For a selection ending with meeting $j$, the total decomposes as $dp[j] = \max(revenue_j,\; revenue_j + start_j + \max_{i:\,end_i \le start_j}(dp[i] - end_i))$ — the idle gap term folds neatly into each predecessor's stored value $dp[i] - end_i$. Processing meetings sorted by end time guarantees every compatible predecessor is already in the structure; a Fenwick tree over compressed end coordinates provides prefix-max queries and point max-updates in $O(\log n)$ each, giving $O(n \log n)$ overall.

```python
from bisect import bisect_right


class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        # Coordinate-compress all end times
        ends = sorted({e for _, e, _ in meetings})
        m = len(ends)
        NEG = float('-inf')

        # Fenwick tree (1-indexed) for prefix maximum
        bit = [NEG] * (m + 1)

        def query(i: int):
            # prefix max over compressed positions [0, i]
            res = NEG
            i += 1
            while i > 0:
                if bit[i] > res:
                    res = bit[i]
                i -= i & (-i)
            return res

        def update(i: int, v: int) -> None:
            # point "max" update at compressed position i
            i += 1
            while i <= m:
                if v > bit[i]:
                    bit[i] = v
                i += i & (-i)

        ans = 0
        # Process in increasing end time so every compatible predecessor
        # (end_i <= start_j < end_j) is inserted before meeting j is queried.
        for s, e, r in sorted(meetings, key=lambda x: x[1]):
            # latest compressed end that is <= s (compatible predecessors)
            idx = bisect_right(ends, s) - 1
            best = query(idx) if idx >= 0 else NEG
            dp = r  # take this meeting alone
            if best != NEG:
                cand = r + s + best  # append after best compatible chain
                if cand > dp:
                    dp = cand
            # insert this meeting as a potential predecessor
            pos = bisect_right(ends, e) - 1  # exact position of e
            update(pos, dp - e)
            if dp > ans:
                ans = dp
        return ans
```