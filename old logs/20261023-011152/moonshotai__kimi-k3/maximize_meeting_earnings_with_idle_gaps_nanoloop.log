```python
from bisect import bisect_right

class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        ends = sorted({e for _, e, _ in meetings})
        m = len(ends)
        NEG = float('-inf')
        bit = [NEG] * (m + 1)  # 1-indexed Fenwick for prefix max

        def query(i: int) -> int:  # prefix max over [0, i]
            res = NEG
            i += 1
            while i > 0:
                if bit[i] > res:
                    res = bit[i]
                i -= i & (-i)
            return res

        def update(i: int, v: int) -> None:
            i += 1
            while i <= m:
                if v > bit[i]:
                    bit[i] = v
                i += i & (-i)

        ans = 0
        for s, e, r in meetings:
            idx = bisect_right(ends, s) - 1  # last end <= s
            best = query(idx) if idx >= 0 else NEG
            dp = r
            if best != NEG:
                cand = r + s + best
                if cand > dp:
                    dp = cand
            pos = bisect_right(ends, e) - 1  # exact position of e
            update(pos, dp - e)
            if dp > ans:
                ans = dp
        return ans
```

