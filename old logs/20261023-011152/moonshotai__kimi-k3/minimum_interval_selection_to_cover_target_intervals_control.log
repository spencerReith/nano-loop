class Solution:
    def minSelection(self, availableIntervals: list[list[int]], targetIntervals: list[list[int]]) -> int:
        """
        1. The union of the target intervals is a collection of disjoint components
           [curL, curR].  Because the target set is closed, every component is a
           single closed interval (two components can never just touch at one point –
           that point would belong to both target intervals and they would be merged).
        2. Inside one component we solve the classic “minimum number of intervals to
           cover [curL, curR]” greedily:
                 reach = curL
                 while reach <= curR:
                     take the unused interval with l <= reach and maximum r
                     if none exists -> impossible
                     reach = maxR (+ eps because intervals are closed)
           For real points the next start only has to be > maxR, which is handled
           by allowing l == reach (we set reach = maxR and accept equality – a point
           is already covered, the next interval may start exactly there).
        3. Intervals are sorted by left end, a simple pointer walk gives O(n log n).
        """
        # ---- merge target intervals into disjoint components -----------------
        t = sorted(targetIntervals)
        comps = []
        curL, curR = t[0]
        for l, r in t[1:]:
            if l <= curR:                # overlapping or touching -> same component
                if r > curR:
                    curR = r
            else:                        # l > curR, a real gap exists
                comps.append((curL, curR))
                curL, curR = l, r
        comps.append((curL, curR))

        # ---- sort available intervals by left endpoint -----------------------
        a = sorted(availableIntervals)
        n = len(a)
        idx = 0
        ans = 0

        # ---- cover each component independently ------------------------------
        for L, R in comps:
            # skip intervals that end before this component
            while idx < n and a[idx][1] < L:
                idx += 1

            reach = L                  # everything < reach is already covered
            while reach <= R:
                best = -1
                j = idx
                # among intervals starting not after reach take the farthest right end
                while j < n and a[j][0] <= reach:
                    if a[j][1] > best:
                        best = a[j][1]
                    j += 1
                if best < reach:       # no interval can cover the point `reach`
                    return -1
                ans += 1
                # closed interval -> point `best` itself is covered,
                # next interval may start at best as well, so reach = best works.
                reach = best
                if reach > R:
                    break
                # move the base pointer forward; intervals with l <= reach are useless now
                # (they end <= best = reach, otherwise best would have been larger)
                idx = j
            # finished this component

        return ans
```