class Solution:
    def maxPrimeSubset(self, n: int, s: int) -> list[int]:
        # Get all primes <= n using Sieve of Eratosthenes
        if n < 2:
            return []
        is_prime = [True] * (n + 1)
        is_prime[0] = is_prime[1] = False
        for i in range(2, int(n ** 0.5) + 1):
            if is_prime[i]:
                for j in range(i * i, n + 1, i):
                    is_prime[j] = False
        primes = [i for i in range(2, n + 1) if is_prime[i]]
        
        # DP[sum] = (count, tuple of primes)
        # We want to maximize sum first, then minimize count, then lexicographically smallest tuple
        dp = [-1] * (s + 1)
        dp[0] = (0, ())
        
        for p in primes:
            for j in range(s, p - 1, -1):
                if dp[j - p] != -1:
                    count, subset = dp[j - p]
                    new_count = count + 1
                    new_subset = subset + (p,)
                    
                    if dp[j] == -1:
                        dp[j] = (new_count, new_subset)
                    else:
                        old_count, old_subset = dp[j]
                        # Fewer primes is better
                        if new_count < old_count:
                            dp[j] = (new_count, new_subset)
                        # Same count: lexicographically smaller is better
                        elif new_count == old_count and new_subset < old_subset:
                            dp[j] = (new_count, new_subset)
        
        # Find maximum sum <= s with a valid subset
        for j in range(s, -1, -1):
            if dp[j] != -1:
                if dp[j][0] == 0:  # empty subset
                    return []
                return list(dp[j][1])
        
        return []
