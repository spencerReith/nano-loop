class Solution:
    def maxEqualPairs(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 1:
            return 0

        base = 0
        freq = {}
        pos = {}
        pattern_count = {}
        v_count = {}

        for i, a in enumerate(nums):
            freq[a] = freq.get(a, 0) + 1
            if a in pos:
                pos[a].append(i)
            else:
                pos[a] = [i]
            if i > 0:
                if nums[i - 1] == a:
                    base += 1
                else:
                    k = (nums[i - 1], a)
                    pattern_count[k] = pattern_count.get(k, 0) + 1

        for i in range(1, n - 1):
            a = nums[i - 1]
            b = nums[i]
            c = nums[i + 1]
            if a != b and b != c and a != c:
                k = (a, b, c)
                v_count[k] = v_count.get(k, 0) + 1

        ans = base

        for x in freq:
            cntx = freq[x]
            for y in freq:
                if y == x:
                    continue

                gain = 0

                if cntx >= 2:
                    lst = pos[x]
                    run = 1
                    for idx in range(1, len(lst)):
                        if lst[idx] == lst[idx - 1] + 1:
                            run += 1
                        else:
                            if run >= 2:
                                gain -= run - 1
                            run = 1
                    if run >= 2:
                        gain -= run - 1

                gain += pattern_count.get((x, y), 0)
                gain += pattern_count.get((y, x), 0)

                gain += v_count.get((x, y, x), 0)

                total = base + gain
                if total > ans:
                    ans = total

        return ans
