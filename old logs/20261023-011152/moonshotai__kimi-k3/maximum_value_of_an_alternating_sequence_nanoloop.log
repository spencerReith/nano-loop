class Solution:
    def maximumValue(self, n: int, s: int, m: int) -> int:
        if n == 1:
            return s

        # The best pattern starts by increasing.  Its first peak is s + m.
        # After each peak P, the next value must be at most P - 1 (strict
        # integer decrease), so the next peak is at most (P - 1) + m.
        # Thus every additional pair of positions increases the best peak
        # by m - 1.  There are floor(n / 2) peaks, hence the formula below.
        return s + m + (n // 2 - 1) * (m - 1)
```