class Solution:
    def weightedSum(self, parent: list[int], nums: list[int]) -> int:
        n = len(parent)
        depth = [0] * n
        depth[0] = 1
        height = 1
        # Nodes are guaranteed to be a valid tree rooted at 0.
        # Since parent[i] < i is not guaranteed, we should compute depths in topological order.
        # But note that the parent of node i always has a smaller depth, so we can use BFS from root.
        from collections import deque
        
        children = [[] for _ in range(n)]
        for i in range(1, n):
            children[parent[i]].append(i)
        
        q = deque([0])
        while q:
            node = q.popleft()
            for child in children[node]:
                depth[child] = depth[node] + 1
                height = max(height, depth[child])
                q.append(child)
        
        total = 0
        for i in range(n):
            total += nums[i] * (height - depth[i] + 1)
        return total
