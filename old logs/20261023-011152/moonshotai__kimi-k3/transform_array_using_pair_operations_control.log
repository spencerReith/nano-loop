class Solution:
    def canTransform(self, source: list[int], target: list[int]) -> bool:
        n = len(source)
        if n == 2:
            return sorted(source) == sorted(target)
        diff = 0
        for s, t in zip(source, target):
            diff += t - s
            if diff < 0:
                return False
        return True
