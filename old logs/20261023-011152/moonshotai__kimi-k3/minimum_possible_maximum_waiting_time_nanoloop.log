```python
def canServe(k, W):
    # states: (s0, s1, u0); u1 = prefix[i] - u0
    # before car 0: arrival t=0, f0=f1=0 => s0=s1=0, u0=0
    states = {(0, 0, 0)}
    pref = 0
    for i in range(k):
        d = demand[i]
        pref += d
        new_states = set()
        for (s0, s1, u0) in states:
            u1 = pref - d - u0  # fuel used on dispenser 1 before car i
            # choose dispenser 0
            if u0 + d <= fuel0 and max(0, s0) <= W:
                w = s0 if s0 > 0 else 0
                new_states.add((d, s1 - w, u0 + d))
            # choose dispenser 1
            if u1 + d <= fuel1 and max(0, s1) <= W:
                w = s1 if s1 > 0 else 0
                new_states.add((s0 - w, d, u0))
        states = new_states
        if not states:
            return False
    return True
```

