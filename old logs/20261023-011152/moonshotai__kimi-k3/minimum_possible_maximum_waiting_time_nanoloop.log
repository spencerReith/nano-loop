The solution works in two phases:
1. **Maximize served cars**: bitset subset-sum DP finds the longest prefix that can be partitioned between the two dispensers' fuel capacities.
2. **Minimize max wait**: binary search on W with a DP over "slack" states `(s0, s1, u0)` where `s_d = (free time of dispenser d) − (current arrival time)`. The key insight is that absolute time cancels out — choosing dispenser `d` costs `wait = max(0, s_d)`, sets `s_d = demand[i]`, and decreases the other slack by the wait.

```python
class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        n = len(demand)
        f0, f1 = fuel[0], fuel[1]

        # Step 1: find the longest servable prefix.
        # A prefix is servable iff its demands can be split so that the sum on
        # dispenser 0 <= f0 and the sum on dispenser 1 <= f1.
        reachable = 1                      # bitset of achievable sums on dispenser 0
        mask = (1 << (f0 + 1)) - 1
        total = 0
        k = 0
        for i in range(n):
            total += demand[i]
            reachable = ((reachable | (reachable << demand[i])) & mask)
            lo = total - f1                # need s >= total - f1 so dispenser 1 fits
            if lo < 0:
                lo = 0
            if lo > f0 or (reachable >> lo) == 0:
                break
            k = i + 1

        if k == 0:
            return -1

        # Step 2: minimize the maximum waiting time over assignments of the
        # first k cars.  State = (s0, s1, u0):
        #   s_d = (time dispenser d becomes free) - (current arrival time)
        #   u0  = fuel used on dispenser 0 (u1 = prefix_sum - u0)
        # Choosing dispenser d: wait = max(0, s_d); afterwards s_d = demand[i]
        # and the other slack drops by the wait.  Absolute time never matters.
        def can(W: int) -> bool:
            states = {(0, 0, 0)}
            pref = 0
            for i in range(k):
                d = demand[i]
                nxt = set()
                for (s0, s1, u0) in states:
                    u1 = pref - u0
                    # use dispenser 0
                    if u0 + d <= f0 and s0 <= W:
                        w = s0 if s0 > 0 else 0
                        nxt.add((d, s1 - w, u0 + d))
                    # use dispenser 1
                    if u1 + d <= f1 and s1 <= W:
                        w = s1 if s1 > 0 else 0
                        nxt.add((s0 - w, d, u0))
                states = nxt
                pref += d
                if not states:
                    return False
            return True

        # A wait never exceeds the largest demand (slack is set to a demand
        # value and only decreases afterwards), so answer lies in [0, 20].
        lo, hi = 0, max(demand[:k])
        while lo < hi:
            mid = (lo + hi) // 2
            if can(mid):
                hi = mid
            else:
                lo = mid + 1
        return lo
```