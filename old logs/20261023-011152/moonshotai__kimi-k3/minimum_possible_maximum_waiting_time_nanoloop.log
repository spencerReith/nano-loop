```python
class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        n = len(demand)
        f0, f1 = fuel[0], fuel[1]
        
        # Step 1: max servable prefix k
        reachable = 1
        mask = (1 << (f0 + 1)) - 1
        total = 0
        k = 0
        for i in range(n):
            total += demand[i]
            reachable = ((reachable | (reachable << demand[i])) & mask)
            lo = total - f1
            if lo < 0:
                lo = 0
            if lo > f0 or (reachable >> lo) == 0:
                break
            k = i + 1
        
        if k == 0:
            return -1
        
        # Step 2: binary search min max wait
        def can(W):
            states = {(0, 0, 0)}
            pref = 0
            for i in range(k):
                d = demand[i]
                new_states = set()
                for (s0, s1, u0) in states:
                    u1 = pref - u0
                    # dispenser 0
                    if u0 + d <= f0 and s0 <= W:
                        w = s0 if s0 > 0 else 0
                        new_states.add((d, s1 - w, u0 + d))
                    # dispenser 1
                    if u1 + d <= f1 and s1 <= W:
                        w = s1 if s1 > 0 else 0
                        new_states.add((s0 - w, d, u0))
                states = new_states
                pref += d
                if not states:
                    return False
            return True
        
        lo, hi = 0, 20
        while lo < hi:
            mid = (lo + hi) // 2
            if can(mid):
                hi = mid
            else:
                lo = mid + 1
        return lo
```

