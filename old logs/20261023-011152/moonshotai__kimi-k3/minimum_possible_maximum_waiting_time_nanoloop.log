```python
def maxServable():
    # bitset of reachable sums on dispenser 0 (0..fuel0)
    # process cars one by one; after i cars, check if total_i - s <= fuel1 for some reachable s
    reachable = 1  # bit 0 set
    total = 0
    k = 0
    for i in range(n):
        total += demand[i]
        reachable |= reachable << demand[i]
        # mask to bits 0..fuel0
        reachable &= (1 << (fuel0 + 1)) - 1
        # check if any s with total - s <= fuel1, i.e., s >= total - fuel1
        lo = max(0, total - fuel1)
        hi = fuel0
        if lo > hi:
            break
        # check any bit in [lo, hi]
        if (reachable >> lo) == 0:
            break
        k = i + 1
    return k
```

