```python
from bisect import bisect_left

def _build_palindromes():
    pals = []
    for length in range(1, 11):
        half_len = (length + 1) // 2
        start = 10 ** (half_len - 1)
        end = 10 ** half_len
        for h in range(start, end):
            s = str(h)
            if length % 2 == 0:
                p = s + s[::-1]
            else:
                p = s + s[-2::-1]
            pals.append(int(p))
    return pals

_PALS = _build_palindromes()
_EVEN = sorted(p for p in _PALS if p % 2 == 0)
_ODD = sorted(p for p in _PALS if p % 2 == 1)

class Solution:
    def minOperations(self, nums: list[int]) -> int:
        total = 0
        for n in nums:
            arr = _EVEN if n % 2 == 0 else _ODD
            i = bisect_left(arr, n)
            best = float('inf')
            if i < len(arr):
                best = arr[i] - n
            if i > 0:
                best = min(best, n - arr[i-1])
            total += best // 2
        return total
```

