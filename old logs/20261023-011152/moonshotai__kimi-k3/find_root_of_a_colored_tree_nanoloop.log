```python
class Solution:
    def findColoredRoot(self, edges: list[list[int]], colors: str) -> int:
        n = len(colors)
        val = {'R': 0, 'B': 1, 'W': 2}
        v = [val[c] for c in colors]
        degree = [0] * n
        indeg = [0] * n
        for u, w in edges:
            degree[u] += 1
            degree[w] += 1
            diff = (v[w] - v[u]) % 3
            if diff == 0:
                # same color on both ends: no orientation of this edge works
                return -1
            elif diff == 1:
                indeg[w] += 1   # forced u -> w
            else:
                indeg[u] += 1   # forced w -> u

        root = -1
        for i in range(n):
            if indeg[i] == 0:
                if root != -1:
                    return -1  # more than one candidate -> inconsistent
                root = i

        if root == -1:
            return -1
        # root's children == its degree; must be <= 2
        if degree[root] > 2:
            return -1
        return root
```