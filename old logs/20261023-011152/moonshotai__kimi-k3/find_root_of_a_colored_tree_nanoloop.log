Let me write the solution.

```python
class Solution:
    def findColoredRoot(self, edges: list[list[int]], colors: str) -> int:
        n = len(colors)
        val = {'R': 0, 'B': 1, 'W': 2}
        v = [val[c] for c in colors]
        degree = [0] * n
        indeg = [0] * n
        for u, w in edges:
            degree[u] += 1
            degree[w] += 1
            diff = (v[w] - v[u]) % 3
            if diff == 0:
                return -1
            elif diff == 1:
                indeg[w] += 1
            else:
                indeg[u] += 1
        root = -1
        for i in range(n):
            if indeg[i] == 0:
                if root != -1:
                    return -1  # multiple candidates
                root = i
        if root == -1:
            return -1
        if degree[root] > 2:
            return -1
        return root
```

