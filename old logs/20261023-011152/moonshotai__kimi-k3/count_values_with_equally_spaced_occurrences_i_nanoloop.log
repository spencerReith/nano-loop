class Solution:
    def countEquallySpaced(self, nums: list[int]) -> int:
        positions = {}
        for idx, val in enumerate(nums):
            positions.setdefault(val, []).append(idx)
        count = 0
        for val, inds in positions.items():
            if len(inds) == 3:
                i1, i2, i3 = inds
                if i2 - i1 == i3 - i2:
                    count += 1
        return count
