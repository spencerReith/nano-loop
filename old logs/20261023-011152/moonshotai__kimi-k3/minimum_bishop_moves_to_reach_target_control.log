class Solution:
    def minBishopMoves(self, source: list[int], target: list[int]) -> int:
        sr, sc = source
        tr, tc = target

        # Bishops stay on squares of the same color
        if (sr + sc) % 2 != (tr + tc) % 2:
            return -1

        # Same diagonal: |dr| == |dc|
        if abs(sr - tr) == abs(sc - tc):
            return 1

        # Same color but not same diagonal: always 2 moves on an 8x8 board
        return 2
```