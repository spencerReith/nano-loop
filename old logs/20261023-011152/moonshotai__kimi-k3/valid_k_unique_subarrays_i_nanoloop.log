from collections import defaultdict
import sys

class Solution:
    def validSubarrays(self, nums: list[int], k: int, queries: list[list[int]]) -> list[bool]:
        n = len(nums)
        q = len(queries)
        block_size = int(n**0.5) + 1
        
        # Sort queries using Mo's ordering
        # (L_block, R, parity of L_block for R sorting order)
        sorted_queries = []
        for i, (l, r) in enumerate(queries):
            block = l // block_size
            if block % 2 == 0:
                sorted_queries.append((block, r, i, l))
            else:
                sorted_queries.append((block, -r, i, l))
        
        sorted_queries.sort()
        
        ans = [False] * q
        freq = defaultdict(int)
        distinct = 0
        odd_count = 0  # Numbers with odd frequency
        
        cur_l, cur_r = 0, -1  # Current range is empty
        
        def add(pos):
            nonlocal distinct, odd_count
            val = nums[pos]
            if freq[val] == 0:
                distinct += 1
            freq[val] += 1
            if freq[val] % 2 == 1:
                odd_count += 1
            else:
                odd_count -= 1
        
        def remove(pos):
            nonlocal distinct, odd_count
            val = nums[pos]
            freq[val] -= 1
            if freq[val] % 2 == 1:
                odd_count += 1
            else:
                odd_count -= 1
            if freq[val] == 0:
                distinct -= 1
        
        for _, _, idx, l, r in sorted_queries:
            # Expand/shrink current range to [l, r]
            while cur_l > l:
                cur_l -= 1
                add(cur_l)
            while cur_r < r:
                cur_r += 1
                add(cur_r)
            while cur_l < l:
                remove(cur_l)
                cur_l += 1
            while cur_r > r:
                remove(cur_r)
                cur_r -= 1
            
            # Valid if exactly k distinct and no odd frequencies
            ans[idx] = (distinct == k and odd_count == 0)
        
        return ans
