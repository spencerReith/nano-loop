class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        ans = 0

        k_odd = (k % 2 == 1)
        inv2 = (k + 1) // 2 if k_odd else 0  # 2 * inv2 == 1 (mod k) for odd k
        half = k // 2

        for i in range(n):
            total = 0
            cnt = {}

            for j in range(i, n):
                x = nums[j]
                total += x
                r = total % k

                xr = x % k
                cnt[xr] = cnt.get(xr, 0) + 1

                length = j - i + 1

                # Already divisible by k.
                if r == 0:
                    if length > ans:
                        ans = length
                    continue

                # Need an element y in nums[i..j] with:
                # total - 2*y == 0 (mod k)  <=>  2*y == r (mod k)
                if k_odd:
                    need = (r * inv2) % k
                    if cnt.get(need, 0):
                        ans = max(ans, length)
                else:
                    # 2*y == r (mod k) has solutions only when r is even.
                    if (r & 1) == 0:
                        base = r // 2  # modulo k/2
                        if cnt.get(base, 0) or cnt.get(base + half, 0):
                            ans = max(ans, length)

        return ans
