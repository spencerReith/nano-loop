from math import gcd

class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n=len(nums)
        ans=0
        odd = (k % 2 == 1)
        inv2 = (k + 1)//2 if odd else 0
        half = k//2
        for i in range(n):
            total=0
            cnt={}
            for j in range(i,n):
                x=nums[j]
                total += x
                r = total % k
                res = x % k
                cnt[res]=cnt.get(res,0)+1
                length=j-i+1
                if r == 0:
                    if length>ans: ans=length
                    continue
                if odd:
                    m=(r*inv2)%k
                    if cnt.get(m,0):
                        ans=max(ans,length)
                else:
                    if (r & 1)==0:
                        m0=r//2  # < half
                        if cnt.get(m0,0) or cnt.get(m0+half,0):
                            ans=max(ans,length)
        return ans

