from solution import Solution

def brute(nums,k):
    n=len(nums); best=0
    for i in range(n):
        s=0
        for j in range(i,n):
            s+=nums[j]
            ok = (s % k ==0)
            if not ok:
                for x in nums[i:j+1]:
                    if (s - 2*x) % k ==0:
                        ok=True; break
            if ok: best=max(best,j-i+1)
    return best

s=Solution()
print(s.longestSubarray([4,1,2],3), "expected", 3)
print(s.longestSubarray([5,3,4],7), "expected", 2)
print(s.longestSubarray([2,2,5],6), "expected", 2)
# edge
print(s.longestSubarray([1],1), "expected", 1)
print(s.longestSubarray([1],2), "expected", 0)
print(s.longestSubarray([2],2), "expected", 1)
