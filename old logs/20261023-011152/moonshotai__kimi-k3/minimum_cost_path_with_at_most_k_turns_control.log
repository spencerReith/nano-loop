import heapq
from typing import List

class Solution:
    def minCost(self, grid: list[list[int]], k: int) -> int:
        m, n = len(grid), len(grid[0])
        if m == 1 and n == 1:
            return grid[0][0]

        # State: (cost, r, c, turns_used, dir)
        # dir: 0=Up, 1=Down, 2=Left, 3=Right. 4=Start (no direction).
        # We use a large enough initial cost or float('inf')
        
        # dist[r][c][turns][dir] stores the minimum cost to reach (r,c) with `turns` turns and last move `dir`
        # Optimization: we only need dist[r][c][turns] but keep track of direction separately in the heap
        # Actually, standard Dijkstra handles this best by just keeping the state in the priority queue.
        
        pq = [(grid[0][0], 0, 0, 0, 4)]  # (cost, r, c, turns, last_dir)
        
        # visited[r][c][turns][dir] = min_cost
        # m, n <= 75, k < min(m, n) <= 75. States = 75 * 75 * 75 * 5 ~ 2.1M.
        # This might be large for pure Python dictionary, but okay for list of lists if k is small.
        # Given k < min(m,n), max k is around 75. 75*75*75*5 is too much memory (approx 2GB).
        # Better visited approach: dist[r][c] is a (k+1) x 5 grid.
        
        # Let's use a 4D array-like structure if memory allows, or just dict.
        # Since k < min(m, n), k is at most 74. 75*75*75*5 = 2,109,375 states.
        # Each state storing an int, this is feasible in C++ but might be borderline in Python lists.
        # Let's try a slightly more memory efficient way or just use a dictionary for visited.
        # Actually, we can just store the min cost for (r, c, turns, dir).
        
        # Dijkstra's algorithm
        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]
        
        # dist[r][c][t][d] -> min cost
        # To save memory, we can use a dictionary or a 5D list if k is small.
        # Since k < min(m, n), the max value of k is ~75.
        # 75 * 75 * 75 * 5 = ~2.1 million states. A list of this size is fine.
        # We can flatten it: index = ((r * n + c) * (k + 1) + t) * 5 + d
        
        # Wait, k can be up to 74. 75*75*75*5 = 2,109,375.
        # This is perfectly fine for a list of floats/ints in Python (approx 16MB).
        
        INF = float('inf')
        # dimensions: m x n x (k+1) x 5
        dist = [[[[INF] * 5 for _ in range(k + 1)] for _ in range(n)] for _ in range(m)]
        
        dist[0][0][0][4] = grid[0][0]
        
        while pq:
            cost, r, c, t, d = heapq.heappop(pq)
            
            if cost > dist[r][c][t][d]:
                continue
            
            if r == m - 1 and c == n - 1:
                return cost
            
            for i, (dr, dc) in enumerate(directions):
                nr, nc = r + dr, c + dc
                
                if 0 <= nr < m and 0 <= nc < n:
                    nt = t
                    if d != 4 and i != d:
                        nt += 1
                    
                    if nt <= k:
                        new_cost = cost + grid[nr][nc]
                        if new_cost < dist[nr][nc][nt][i]:
                            dist[nr][nc][nt][i] = new_cost
                            heapq.heappush(pq, (new_cost, nr, nc, nt, i))
                            
        return -1
