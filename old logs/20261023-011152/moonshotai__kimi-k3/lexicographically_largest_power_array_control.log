class Solution:
    def largestPower(self, nums: list[int]) -> list[int]:
        cnt = [0] * 15
        for x in nums:
            for b in range(15):
                if x >> b & 1:
                    cnt[b] += 1
        n = len(nums)
        pow2 = [1 << i for i in range(16)]
        # smallest number having bit b
        low = [(0 if cnt[b] == 0 else (1 << b)) for b in range(15)]
        pow_arr = [0] * 15

        for b in range(14, -1, -1):
            i = 14 - b
            # find maximum feasible p for this bit
            max_p = cnt[b]
            for p in range(max_p, -1, -1):
                g = low[b] * p
                ok = True
                for c in range(b + 1, 15):
                    prev_p = pow_arr[14 - c]
                    base = low[c] * prev_p
                    if g * pow2[c - b] > base + pow2[c] - 1:
                        ok = False
                        break
                if ok:
                    pow_arr[i] = p
                    low[b] = (g + n - 1) // p if p else 0
                    break
        return pow_arr
