import math


class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 1:
            return 0

        threshold = int(math.sqrt(n))

        # Precompute prefix counts for values <= threshold.
        small = [x <= threshold for x in nums]
        max_small_val = min(threshold, max(nums)) if any(small) else 0

        freq_small = [0] * (max_small_val + 1)
        for x in nums:
            if x <= max_small_val:
                freq_small[x] += 1

        prefix_small = [0] * (max_small_val + 1)
        run = 0
        for x in range(max_small_val + 1):
            run += freq_small[x]
            prefix_small[x] = run

        # For every position r, precompute the first position q > r where nums[q] < nums[r].
        next_lower = [n] * n
        stack = []
        for i in range(n - 1, -1, -1):
            while stack and nums[stack[-1]] >= nums[i]:
                stack.pop()
            if stack:
                next_lower[i] = stack[-1]
            stack.append(i)

        # Block decomposition of indices by position (needed for O(1) prefix small queries).
        block_size = max(1, threshold + 1)
        start_of_block = [(b * block_size) for b in range((n + block_size - 1) // block_size)]
        block_id = [b for b in range(len(start_of_block)) for _ in range(block_size)][:n]
        block_start = [start_of_block[b] for b in block_id]

        ans = 0

        # Enumerate all pairs (l, r) with nums[l] < nums[r] and no value in
        # (nums[l], nums[r]) lying strictly between them. Such a pair is a
        # "critical pair": if another strictly smaller element than nums[l]
        # exists before r, it must be a larger value, hence the forbidden k
        # never exists, so every critical pair is a shadow pair.
        # This enumeration counts each shadow pair exactly once.
        #
        # Complexity is O(number of shadow pairs + n * threshold).
        #
        # For each right endpoint r, walk left while nums[l] < nums[r],
        # tracking the minimum value seen strictly between l+1 and r-1.
        # When the running minimum drops below nums[l], the pair stops being
        # critical; any earlier l' also has the same witness, so we can stop.
        for r in range(n):
            # Fast-forward over earlier right endpoints for which no new pair can start.
            # (The loop below is already linear in the number of emitted pairs.)
