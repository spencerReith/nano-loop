                # Update min_mid using nums[l+1] when moving l leftwards.
                if l + 1 < r:
                    v = nums[l + 1]
                    if v < min_mid:
                        min_mid = v
                if nums[l] < min_mid:
                    ans += 1
                    l -= 1
                else:
                    break

        return ans
