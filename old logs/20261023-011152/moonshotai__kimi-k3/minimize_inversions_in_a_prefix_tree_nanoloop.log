```python
from bisect import bisect_right, bisect_left
from functools import cmp_to_key

class Solution:
    def minInversions(self, words, target):
        n = len(words)
        pos = [0]*n
        for p, idx in enumerate(target):
            pos[idx] = p
        # build trie
        # node: [children(dict char->int), mark]
        children = []  # list of dict
        mark = []
        children.append({})
        mark.append(-1)
        for i, w in enumerate(words):
            u = 0
            for ch in w:
                d = children[u]
                v = d.get(ch)
                if v is None:
                    v = len(children)
                    d[ch] = v
                    children.append({})
                    mark.append(-1)
                u = v
            mark[u] = i
        import sys
        sys.setrecursionlimit(1 << 25)
        
        def cross(A, B):
            # # (a in A, b in B) with a > b ; A,B sorted asc
            la = len(A)
            s = 0
            br = bisect_right
            for b in B:
                s += la - br(A, b)
            return s
        
        def dfs(u):
            d = children[u]
            total = 0
            child_lists = []
            for v in d.values():
                Lv, invv = dfs(v)
                child_lists.append(Lv)
                total += invv
            # own mark fixed contribution
            if mark[u] != -1:
                pu = pos[mark[u]]
                for L in child_lists:
                    total += bisect_left(L, pu)  # descendants with value < pu → inversion (pu before them, pu > x)
                own = [pu]
            else:
                own = []
            k = len(child_lists)
            if k > 1:
                # cross matrix
                # order children to minimize sum cross
                idxs = list(range(k))
                # precompute M[i][j] = cross(L_i, L_j) for i!=j
                M = [[0]*k for _ in range(k)]
                for i in range(k):
                    Li = child_lists[i]
                    for j in range(k):
                        if i != j:
                            M[i][j] = cross(Li, child_lists[j])
                def cmp(a, b):
                    return M[a][b] - M[b][a]
                idxs.sort(key=cmp_to_key(cmp))
                for x in range(k):
                    for y in range(x+1, k):
                        total += M[idxs[x]][idxs[y]]
            # build L_u
            concat = own
            for L in child_lists:
                concat = concat + L
            concat.sort()
            return concat, total
        _, ans = dfs(0)
        return ans
```

