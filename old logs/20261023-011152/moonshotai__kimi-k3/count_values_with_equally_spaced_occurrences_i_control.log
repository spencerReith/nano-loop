class Solution:
    def countEquallySpaced(self, nums: list[int]) -> int:
        positions = {}
        for i, x in enumerate(nums):
            positions.setdefault(x, []).append(i)
        
        ans = 0
        for idxs in positions.values():
            if len(idxs) == 3:
                if idxs[1] - idxs[0] == idxs[2] - idxs[1]:
                    ans += 1
        return ans
