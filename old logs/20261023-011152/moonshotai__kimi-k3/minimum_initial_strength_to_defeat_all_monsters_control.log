class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        # Difference array to get the bonus at every index.
        diff = [0] * (n + 1)
        for l, r, v in boosts:
            diff[l] += v
            diff[r + 1] -= v

        required = 0   # minimum initial strength needed up to current index
        strength = 0   # simulated current strength using `required`
        bonus = 0

        for i in range(n):
            bonus += diff[i]
            need = monsters[i] - bonus
            if need > strength:
                # Not enough strength for this monster; increase the initial strength.
                required += need - strength
                strength = need
            strength -= monsters[i]
            if strength < 0:
                strength = 0

        return required
```