class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        target = sum
        INF = 10**9

        # For one starting value x, using both multiplications and divisions is never optimal:
        # if divisions <= multiplications, the divisions exactly cancel trailing multiplications;
        # if divisions > multiplications, the multiplications are completely cancelled.
        # So the cheapest reachable values are just x * 2^m and floor(x / 2^d).
        dp = [INF] * (target + 1)
        dp[0] = 0

        for x in nums:
            best = {}

            v = x
            cost = 0
            while v <= target:
                if cost < best.get(v, INF):
                    best[v] = cost
                v <<= 1
                cost += 1

            v = x
            cost = 0
            while v > 0:
                if v <= target and cost < best.get(v, INF):
                    best[v] = cost
                v >>= 1
                cost += 1

            items = list(best.items())
            for s in range(target, -1, -1):
                if dp[s] == INF:
                    continue
                base = dp[s]
                for v, c in items:
                    ns = s + v
                    if ns <= target and base + c < dp[ns]:
                        dp[ns] = base + c

        return dp[target] if dp[target] != INF else -1
