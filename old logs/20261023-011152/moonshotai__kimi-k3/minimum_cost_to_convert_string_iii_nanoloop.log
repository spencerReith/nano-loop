class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n=len(source)
        MAXL=20
        INF=10**18
        best=[[INF]*(MAXL+1) for _ in range(n)]
        s=source; t=target
        for idx,(pat,rep) in enumerate(rules):
            L=len(pat)
            if L>n: continue
            c=costs[idx] + pat.count('*')
            # optional if c already >=? no
            nonstar=[(j,ch) for j,ch in enumerate(pat) if ch != '*']
            limit=n-L
            # local vars for speed
            for st in range(limit+1):
                ok=True
                for j,ch in nonstar:
                    if s[st+j] != ch:
                        ok=False; break
                if not ok: continue
                if t.startswith(rep, st):
                    if c < best[st][L]: best[st][L]=c
        dp=[INF]*(n+1); dp[0]=0
        for i in range(n):
            cur=dp[i]
            if cur==INF: continue
            if s[i]==t[i]:
                if cur<dp[i+1]: dp[i+1]=cur
            row=best[i]
            maxL=min(MAXL,n-i)
            # if mismatch, still can start interval; if match can start too
            for L in range(1,maxL+1):
                c=row[L]
                if c!=INF:
                    ni=i+L
                    val=cur+c
                    if val<dp[ni]: dp[ni]=val
        return -1 if dp[n]==INF else dp[n]

