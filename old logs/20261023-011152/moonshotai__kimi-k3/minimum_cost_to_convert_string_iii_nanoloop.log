class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n = len(source)
        MAXL = 20
        INF = 10**18

        # best[i][L] = minimum cost of one rule application covering exactly
        # source[i:i+L] and producing target[i:i+L].
        best = [[INF] * (MAXL + 1) for _ in range(n)]

        s = source
        t = target

        for idx, (pat, rep) in enumerate(rules):
            L = len(pat)
            if L > n:
                continue
            cost = costs[idx] + pat.count('*')
            fixed = [(j, ch) for j, ch in enumerate(pat) if ch != '*']
            limit = n - L

            for st in range(limit + 1):
                ok = True
                for j, ch in fixed:
                    if s[st + j] != ch:
                        ok = False
                        break
                if not ok:
                    continue
                if t.startswith(rep, st) and cost < best[st][L]:
                    best[st][L] = cost

        dp = [INF] * (n + 1)
        dp[0] = 0

        for i in range(n):
            cur = dp[i]
            if cur == INF:
                continue

            # Leave an already-correct position unused.
            if s[i] == t[i] and cur < dp[i + 1]:
                dp[i + 1] = cur

            row = best[i]
            max_l = min(MAXL, n - i)
            for L in range(1, max_l + 1):
                c = row[L]
                if c != INF:
                    ni = i + L
                    val = cur + c
                    if val < dp[ni]:
                        dp[ni] = val

        return -1 if dp[n] == INF else dp[n]
