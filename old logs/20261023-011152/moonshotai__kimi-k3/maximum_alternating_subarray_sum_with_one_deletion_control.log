```python
class Solution:
    def maxAlternatingSum(self, nums: list[int]) -> int:
        NEG = -10**15
        A2 = B2 = NEG          # states at i-2
        A1 = B1 = C1 = D1 = NEG  # states at i-1
        ans = NEG
        for x in nums:
            A = max(x, B1 + x)
            B = A1 - x
            C = max(D1 + x, B2 + x)
            D = max(C1 - x, A2 - x)
            ans = max(ans, A, B, C, D)
            A2, B2 = A1, B1
            A1, B1, C1, D1 = A, B, C, D
        return ans
```

