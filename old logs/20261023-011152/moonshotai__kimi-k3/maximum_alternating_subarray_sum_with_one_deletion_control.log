    def maxAlternatingSum(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return nums[0]

        # prefix alternating sums
        pref_even = [0] * (n + 1)
        pref_odd = [0] * (n + 1)
        for i in range(n):
            pref_even[i + 1] = pref_even[i]
            pref_odd[i + 1] = pref_odd[i]
            if i % 2 == 0:
