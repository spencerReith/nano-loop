```python
class Solution:
    def maxAlternatingSum(self, nums: list[int]) -> int:
        NEG = -10**15  # effectively -infinity (values are bounded by ~1e10)

        # DP states for a subarray whose last taken element is the current index:
        #   A: last element has sign '+', no deletion used
        #   B: last element has sign '-', no deletion used
        #   C: last element has sign '+', one deletion used
        #   D: last element has sign '-', one deletion used
        # Signs alternate over the *taken* elements, so deleting one element
        # simply removes it without changing the sign pattern of the rest.

        A2 = B2 = NEG             # A, B at index i-2
        A1 = B1 = C1 = D1 = NEG   # states at index i-1
        ans = NEG

        for x in nums:
            # take x with sign '+': start fresh, or previous taken had sign '-'
            A = max(x, B1 + x)
            # take x with sign '-': previous taken had sign '+'
            B = A1 - x
            # one deletion already used, or delete the previous element (i-1)
            C = max(D1 + x, B2 + x)
            D = max(C1 - x, A2 - x)

            ans = max(ans, A, B, C, D)

            A2, B2 = A1, B1
            A1, B1, C1, D1 = A, B, C, D

        return ans
```