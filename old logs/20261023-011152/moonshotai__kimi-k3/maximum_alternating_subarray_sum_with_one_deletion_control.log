class Solution:
    def maxAlternatingSum(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return nums[0]

        NEG = -10**30

        # best[i][p] = max alternating sum of a subarray ending at index i,
        # where the subarray length has parity p (0=even, 1=odd).
        # An alternating sum with odd length is always >= its even-length extension,
        # so we mainly need odd lengths for combining.
        end_odd = [0] * n
        end_even = [0] * n
        end_odd[0] = nums[0]
        end_even[0] = NEG
        for i in range(1, n):
            end_odd[i] = max(nums[i], end_even[i - 1] + nums[i])
            end_even[i] = max(nums[i] - nums[i - 1], end_odd[i - 1] + nums[i])

        # start_odd[i] = max alternating sum of a subarray starting at index i with odd length
        # start_even[i] = ... with even length
        start_odd = [0] * n
        start_even = [0] * n
        start_odd[n - 1] = nums[n - 1]
        start_even[n - 1] = NEG
        for i in range(n - 2, -1, -1):
            start_odd[i] = max(nums[i], nums[i] - start_even[i + 1])
            start_even[i] = max(nums[i] - nums[i + 1], nums[i] - start_odd[i + 1])

        ans = max(end_odd)  # no deletion, best subarray (odd length is optimal)

        # delete exactly one element k: combine left (ending at k-1, odd length)
        # with right (starting at k+1, odd length)
        for k in range(n):
            cur = 0
            if k - 1 >= 0:
                cur = max(cur, end_odd[k - 1])
            if k + 1 < n:
                cur = max(cur, cur + start_odd[k + 1]) if cur > 0 else max(cur, start_odd[k + 1])
                # simpler: allow empty left or empty right
            ans = max(ans, cur)

        # redo deletion loop cleanly
        for k in range(n):
            best = 0
            left = end_odd[k - 1] if k - 1 >= 0 else 0
            right = start_odd[k + 1] if k + 1 < n else 0
            if k - 1 >= 0 and k + 1 < n:
                best = left + right
            elif k - 1 >= 0:
                best = left
            elif k + 1 < n:
                best = right
            ans = max(ans, best)

        return ans
