class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        ans = 0
        for l in range(n):
            if n - l <= ans:  # can't beat current best
                break
            s = 0
            residues = set()  # values of (2 * x) % k for x in current window
            for r in range(l, n):
                x = nums[r]
                s += x
                residues.add((2 * x) % k)
                m = s % k
                # valid if sum % k == 0, or negating one element x works:
                # (s - 2x) % k == 0  <=>  s % k == (2x) % k
                if m == 0 or m in residues:
                    ans = max(ans, r - l + 1)
        return ans
