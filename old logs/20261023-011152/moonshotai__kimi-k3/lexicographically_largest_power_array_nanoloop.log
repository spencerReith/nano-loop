class Solution:
    def largestPower(self, nums: list[int]) -> list[int]:
        n = len(nums)
        B = 15
        size = 1 << B

        # sup[s] = how many numbers contain every bit in s
        sup = [0] * size
        for x in nums:
            sup[x] += 1
        for b in range(B):
            bit = 1 << b
            for mask in range(size):
                if (mask & bit) == 0:
                    sup[mask] += sup[mask | bit]

        chosen: list[tuple[int, int]] = []  # (bit, survival time), for higher bits already fixed

        def feasible(bit: int, k: int) -> bool:
            # Test whether `bit` can survive at least k, keeping all previously
            # chosen (more significant) bits at their already maximal values.
            vals = [k]
            for _, t in chosen:
                vals.append(t)
            for v in set(vals):
                if v == 0:
                    continue
                need = 0
                if k >= v:
                    need |= 1 << bit
                for b2, t in chosen:
                    if t >= v:
                        need |= 1 << b2
                if sup[need] < v:
                    return False
            return True

        ans_by_bit = [0] * B
        for bit in range(14, -1, -1):
            lo, hi = 0, n
            while lo < hi:
                mid = (lo + hi + 1) // 2
                if feasible(bit, mid):
                    lo = mid
                else:
                    hi = mid - 1
            ans_by_bit[bit] = lo
            chosen.append((bit, lo))

        return [ans_by_bit[14 - i] for i in range(15)]
```