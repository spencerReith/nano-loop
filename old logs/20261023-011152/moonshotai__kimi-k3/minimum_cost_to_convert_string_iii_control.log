```python
class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n = len(source)
        R = len(rules)
        
        # Split each pattern into concrete segments (runs of lowercase letters)
        # and compute application cost = base cost + number of wildcards.
        segLists = []   # segLists[i] = list of (segment_string, offset)
        appCost = [0] * R
        for i in range(R):
            pat, rep = rules[i]
            wilds = pat.count('*')
            appCost[i] = costs[i] + wilds
            segs = []
            j = 0
            m = len(pat)
            while j < m:
                if pat[j] != '*':
                    k = j
                    while k < m and pat[k] != '*':
                        k += 1
                    segs.append((pat[j:k], j))
                    j = k
                else:
                    j += 1
            segLists.append(segs)
        
        # Find maximal region [minL, maxR] where source and target differ.
        # Positions outside this region don't need any rule, and since rules
        # only fire where they can make progress toward target, no optimal
        # solution touches clean positions outside the diff region either.
        minL, maxR = n, -1
        for i in range(n):
            if source[i] != target[i]:
                if i < minL:
                    minL = i
                maxR = i
        if maxR == -1:
            return 0  # already equal
        
        # Precompute start[l][r] = list of rule indices that can be applied
        # starting at position l and producing exactly target[l:l+len].
        start = [[] for _ in range(n)]
        for i in range(R):
            pat, rep = rules[i]
            L = len(pat)
            if L == 0:
                continue
            segs = segLists[i]
            for l in range(0, n - L + 1):
                # replacement must exactly equal the target substring
                if rep != target[l:l + L]:
                    continue
                ok = True
                for s, off in segs:
                    if not source.startswith(s, l + off):
                        ok = False
                        break
                if ok:
                    start[l].append(i)
        
        # Build interval lists: rulesByLen[L] = sorted list of (l, r, ruleIndex)
        # for applicable placements whose span lies inside the diff region.
        maxLen = 0
        for i in range(R):
            maxLen = max(maxLen, len(rules[i][0]))
        rulesByLen = [[] for _ in range(maxLen + 1)]
        for l in range(n):
            for i in start[l]:
                L = len(rules[i][0])
                r = l + L - 1
                if minL <= l and r <= maxR:
                    rulesByLen[L].append((l, r, i))
        for L in range(maxLen + 1):
            if rulesByLen[L]:
                rulesByLen[L].sort()
        
        INF = float('inf')
        NEG = -10**18
        
        # For each length L, build the full segment tree matrices over positions
        # [minL, maxR] (these matrices are position-independent), then use a
        # sparse-table (doubling) style decomposition to answer the matrix
        # product over any queried interval [l, r] in O(log^2) matmuls.
        # Matrix multiplication here is min-plus, size = L (states are
        # "positions mod L" relative frontier offsets).
        intervalMats = [None] * (maxLen + 1)
        intervalSTs = [None] * (maxLen + 1)
        
        for L in range(1, maxLen + 1):
            lst = rulesByLen[L]
            if not lst:
                continue
            P = maxR - minL + 1
            size = P + 1
            d = [INF] * (L * L)
            # base transitions: "take nothing" keeps state, "take rule ending
            # at current boundary" adds cost.
            for s in range(L):
                d[s * L + s] = 0
            for (l, r, i) in lst:
                s1 = l % L
                s2 = (r + 1) % L
                c = appCost[i]
                idx = s1 * L + s2
                if c < d[idx]:
                    d[idx] = c
            
            def makeMat():
                M = [NEG] * (L * L)
                for a in range(L):
                    M[a * L + a] = 0
                    rowA = a * L
                    da = d[rowA:rowA + L]
                    b0 = -1
                    best = INF
                    for b in range(L):
                        v = da[b]
                        if v < best:
                            best = v
                            b0 = b
                    if b0 < 0:
                        continue
                    prev = INF
                    for b in range(b0, -1, -1):
                        v = da[b]
                        if v < prev:
                            prev = v
                            M[rowA + b] = v
                    prev = INF
                    for b in range(b0 + 1, L):
                        v = da[b]
                        if v < prev:
                            prev = v
                            M[rowA + b] = v
                return M
            
            def matmul(A, B):
                C = [NEG] * (L * L)
                for i in range(L):
                    Ci = i * L
                    Ai = i * L
                    # iterate k where A[i][k] > NEG
                    ks = [k for k in range(L) if A[Ai + k] > NEG // 2]
                    for k in ks:
                        aik = A[Ai + k]
                        Bk = k * L
                        for j in range(L):
                            bkj = B[Bk + j]
                            if bkj > NEG // 2:
                                v = aik + bkj
                                if v > C[Ci + j]:
                                    C[Ci + j] = v
                return C
            
            M = makeMat()
            mats = [M]
            # Build segment tree matrices bottom-up; store level by level.
            # cur = list of matrices for blocks of size 2^level.
            cur = [M] * size
            levels = [cur]
            length = size
            while length > 1:
                half = length // 2
                nxt = [matmul(cur[2 * b], cur[2 * b + 1]) for b in range(half)]
                levels.append(nxt)
                cur = nxt
                length = half
            intervalMats[L] = d  # not strictly needed later
            intervalSTs[L] = (levels, size, matmul)
        
        # Doubling (sparse table) decomposition for interval queries:
        # query(l, r) returns matrix for positions [l, r] (inclusive).
        def buildQuery(L):
            levels, size, matmul = intervalSTs[L]
            import math
            LOG = max(1, size.bit_length())
            # stDown[k][i]: matrix over [i, i+2^k)
            stDown = []
            stDown.append(levels[0])
            k = 1
            length = size
            while length > 1:
                half = length // 2
                stDown.append(levels[k])
                length = half
                k += 1
            def query(l, r):
                length = r - l + 1
                k = length.bit_length() - 1
                rem = length - (1 << k)
                end = r - rem  # last 2^k block ends at r => starts at r-2^k+1
                if rem == 0:
                    return stDown[k][l - minL]
                A = stDown[k][l - minL]
                B = stDown[k][end - minL]
                return matmul(A, B)
            return query
        
        queries = {}
        for L in range(1, maxLen + 1):
            if intervalSTs[L] is not None:
                queries[L] = buildQuery(L)
        
        # DP over region positions: dp[i] = min cost to transform
        # region[minL .. minL+i-1]; gaps are positions already clean.
        regionLen = maxR - minL + 1
        dp = [INF] * (regionLen + 1)
        dp[0] = 0
        # Precompute dirty[l] meaning source[l] != target[l]
        dirty = [False] * n
        for i in range(minL, maxR + 1):
            dirty[i] = source[i] != target[i]
        
        for l in range(minL, maxR + 1):
            li = l - minL
            cur = dp[li]
            if cur >= INF:
                continue
            # option: leave position l untouched (must already match target)
            if not dirty[l]:
                if cur < dp[li + 1]:
                    dp[li + 1] = cur
            # option: fire a rule starting at l
            for i in start[l]:
                L = len(rules[i][0])
                r = l + L - 1
                if r > maxR:
                    continue
                cost = appCost[i]
                if L == 1:
                    v = cur + cost
                    if v < dp[li + 1]:
                        dp[li + 1] = v
                else:
                    q = queries.get(L)
                    if q is None:
                        continue
                    M = q(l + 1, r - 1) if r - 1 >= l + 1 else None
                    s0 = (l + 1) % L
                    s1 = (l + 1) % L  # need M[s0][j] for gap-close state j==s0? 
                    # gap close requires clean path => state stays s0
                    if M is None:
                        inner = 0
                    else:
                        inner = M[s0 * L + s0]
                        if inner <= NEG // 2:
                            continue
                    v = cur + inner + cost
                    ri = r - minL + 1
                    if v < dp[ri]:
                        dp[ri] = v
        
        ans = dp[regionLen]
        return -1 if ans >= INF else int(ans)
