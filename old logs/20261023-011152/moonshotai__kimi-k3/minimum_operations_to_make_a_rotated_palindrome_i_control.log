class Solution:
    def minOperations(self, s: str) -> int:
        n = len(s)
        a = [ord(c) - ord('a') for c in s]
        b = a + a

        ans = float('inf')

        for rot in range(n):
            operations = rot

            for i in range(n // 2):
                left = b[rot + i]
                right = b[rot + n - 1 - i]

                diff = abs(left - right)
                operations += min(diff, 26 - diff)

            ans = min(ans, operations)

        return ans
```