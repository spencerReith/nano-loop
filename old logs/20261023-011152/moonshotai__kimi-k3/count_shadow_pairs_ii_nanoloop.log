Assistant: The solution passed all examples and extensive randomized/structured testing against a brute-force reference, and runs in under 1 second on n = 5·10⁴ worst-case inputs.

**Approach:** Divide & conquer on index ranges. For a pair (i, j) crossing the midpoint, the "no k with nums[i] < nums[k] < nums[j]" condition splits into two independent halves:
- `minAbove_i` = min value in `(i, mid]` strictly greater than `nums[i]` → requires `nums[j] ≤ minAbove_i`
- `maxBelow_j` = max value in `[mid+1, j)` strictly less than `nums[j]` → requires `maxBelow_j ≤ nums[i]`

These are computed with BIT scans (prefix-min on reversed ranks, prefix-max on ranks) over per-node compressed coordinates, then pairs satisfying `maxBelow_j ≤ nums[i] < nums[j] ≤ minAbove_i` are counted with a sort + Fenwick sweep. Small segments are brute-forced directly.

```python
import sys


class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        sys.setrecursionlimit(1 << 20)
        T = 64  # brute-force threshold

        def solve(l, r):
            m = r - l + 1
            if m <= T:
                cnt = 0
                for i in range(l, r):
                    ai = nums[i]
                    cur = None
                    for j in range(i + 1, r + 1):
                        aj = nums[j]
                        if ai < aj:
                            if cur is None or aj <= cur:
                                cnt += 1
                            if cur is None or aj < cur:
                                cur = aj
                return cnt
            mid = (l + r) >> 1
            ans = solve(l, mid) + solve(mid + 1, r)

            sub = nums[l:r + 1]
            vals = sorted(set(sub))
            sz = len(vals)
            v2i = {v: i for i, v in enumerate(vals)}

            # minAbove for i in [l, mid]:
            #   min value in (i, mid] strictly greater than nums[i]
            # BIT (prefix-min) over reversed local rank
            bitmin = [sz] * sz
            left = []  # (bidx, la): bidx = local idx of minAbove (sz == +inf)
            for i in range(mid, l - 1, -1):
                la = v2i[nums[i]]
                rev = sz - 1 - la
                p = rev - 1
                best = sz
                while p >= 0:
                    v = bitmin[p]
                    if v < best:
                        best = v
                    p = (p & (p + 1)) - 1
                left.append((best, la))
                p = rev
                while p < sz:
                    if la < bitmin[p]:
                        bitmin[p] = la
                    p |= p + 1

            # maxBelow for j in [mid+1, r]:
            #   max value in [mid+1, j) strictly less than nums[j]
            # BIT (prefix-max) over local rank
            bitmax = [-1] * sz
            right = []  # (ld, cidx): cidx = local idx of maxBelow (-1 == -inf)
            for j in range(mid + 1, r + 1):
                ld = v2i[nums[j]]
                p = ld - 1
                best = -1
                while p >= 0:
                    v = bitmax[p]
                    if v > best:
                        best = v
                    p = (p & (p + 1)) - 1
                right.append((ld, best))
                p = ld
                while p < sz:
                    if ld > bitmax[p]:
                        bitmax[p] = ld
                    p |= p + 1

            # count pairs with  cidx <= la <= ld-1  and  bidx >= ld
            left.sort(reverse=True)
            right.sort(reverse=True)
            fen = [0] * sz
            pl = 0
            L = len(left)
            for ld, cidx in right:
                while pl < L and left[pl][0] >= ld:
                    q = left[pl][1]
                    while q < sz:
                        fen[q] += 1
                        q |= q + 1
                    pl += 1
                x = cidx if cidx >= 0 else 0
                s = 0
                q = ld - 1
                while q >= 0:
                    s += fen[q]
                    q = (q & (q + 1)) - 1
                q = x - 1
                while q >= 0:
                    s -= fen[q]
                    q = (q & (q + 1)) - 1
                ans += s
            return ans

        return solve(0, len(nums) - 1)
