                    if cur is None or aj < cur:
                        cur = aj
        return cnt
    mid = (l+r) >> 1
    ans = solve(l, mid) + solve(mid+1, r)
    sub = nums[l:r+1]
    vals = sorted(set(sub))
    sz = len(vals)
    v2i = {v: i for i, v in enumerate(vals)}
    # minAbove for left half
    bitmin = [sz] * sz
    left = []  # (bidx, la)
    for i in range(mid, l-1, -1):
        la = v2i[nums[i]]
        rev = sz - 1 - la
        p = rev - 1
        best = sz
        while p >= 0:
            v = bitmin[p]
            if v < best:
                best = v
            p = (p & (p+1)) - 1
        left.append((best, la))  # best == sz means +inf
        p = rev
        while p < sz:
            if la < bitmin[p]:
