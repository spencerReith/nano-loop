                # Actually: valid if ai < aj ≤ cur where cur = min over (i, j) of values > ai.
                cur = None
                for j in range(i+1, r+1):
                    aj = nums[j]
                    if aj > ai and (cur is None or aj <= cur):
                        cnt += 1
                    # update cur with aj... careful: cur = min over k in (i, j]... we update after checking with cur over (i, j):
                    # At step j: condition uses cur over (i, j) i.e., previous elements. Then incorporate aj.
                    if aj > ai and (cur is None or aj < cur):
                        cur = aj
            return cnt
