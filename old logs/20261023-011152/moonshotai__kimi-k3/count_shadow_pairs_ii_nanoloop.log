                        if aj <= cur: cnt += 1
                        if aj < cur: cur = aj
                Fine.
        
        mid = (l + r) >> 1
        ans = solve(l, mid) + solve(mid+1, r)
        
        # local compression of nums[l..r]
        sub = nums[l:r+1]
        vals = sorted(set(sub))
        v2i = {v:i for i,v in enumerate(vals)}
        sz = len(vals)
        
        # minAbove for i in [l, mid]: scan i from mid down to l
        # BITmin over local ranks, reversed index for suffix-min.
        INF = sz + 5
        bitmin = [INF] * (sz)   # prefix-min BIT on reversed index
        # reversed rank: rev = sz-1 - localidx; query prefix [0, rev-1] → min local idx > current
        leftItems = []  # (a_local, b_value)
        for i in range(mid, l-1, -1):
            ai = nums[i]; la = v2i[ai]
            rev = sz - 1 - la
            # query min over local idx > la: prefix over rev' <= rev-1
            p = rev - 1
            best = INF
            bm = bitmin
            while p >= 0:
                if bm[p] < best: best = bm[p]
                p = (p & (p+1)) - 1
            b = vals[best] if best != INF else BIG
            leftItems.append((la, b))  # store local rank of a, and b as value... 
            # update at rev with la
            p = rev
            while p < sz:
                if la < bm[p]: bm[p] = la
                p |= p+1
        # careful: BIT-min query returns min local index stored; we inserted la values at position rev. Min over inserted la's where original idx > la_current. Since compression order preserves value order, min la = min value. But duplicates: values equal to ai have la' == la, excluded since we query idx > la strictly (rev' ≤ rev-1 ⟺ idx' ≥ la+1). Good.
        
        # maxBelow for j in [mid+1, r]: scan left to right, BITmax over local ranks
        bitmax = [-1] * sz
        rightItems = []  # (c_value, d_value) with d = nums[j]
        for j in range(mid+1, r+1):
            aj = nums[j]; ld = v2i[aj]
            p = ld - 1
            best = -1
            bx = bitmax
            while p >= 0:
                if bx[p] > best: best = bx[p]
                p = (p & (p+1)) - 1
            c = vals[best] if best != -1 else -BIG  # -inf
            rightItems.append((c, aj))
            p = ld
            while p < sz:
                if ld > bx[p]: bx[p] = ld
                p |= p+1
        
        # 2D counting: left (a_local, b), right (c, d): c ≤ a_val < d ≤ b
        # sort left by b desc; right by d desc; Fenwick over a_local.
        leftItems.sort(key=lambda t: -t[1])   # b desc; BIG for inf
        rightItems.sort(key=lambda t: -t[1])  # d desc (d = aj)
        fen = [0] * sz
        p_left = 0
        L = len(leftItems)
