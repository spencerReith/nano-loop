class Solution:
    def maxValue(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return nums[0]

        # w[i] is the contribution of nums[i] to the original pulse value.
        w = [0] * n
        for i, x in enumerate(nums):
            w[i] = x if (i & 1) == 0 else -x

        base = sum(w)

        NEG = -10**30
        # best_same[p]  = max prefix sum W[l] for already seen l < r with l % 2 == p
        # best_prev[p]  = max prefix sum W[l - 1] for already seen l < r with l % 2 == p
        best_same = [NEG, NEG]
        best_prev = [NEG, NEG]

        prefix = w[0]          # W[0]
        best_same[0] = prefix  # l = 0 for a future even r
        best_prev[0] = 0       # W[-1] for l = 0 and a future odd r

        max_delta = 0
        for r in range(1, n):
            prefix += w[r]     # W[r]
            p = r & 1

            if best_same[p] != NEG:
                # l and r have the same parity: delta = 2 * (W[l] - W[r])
                max_delta = max(max_delta, 2 * (best_same[p] - prefix))

            if best_prev[1 - p] != NEG:
                # l and r have opposite parity: delta = 2 * (W[l - 1] - W[r])
                max_delta = max(max_delta, 2 * (best_prev[1 - p] - prefix))

            # Make l = r available for future right endpoints.
            if prefix > best_same[p]:
                best_same[p] = prefix
            prev_prefix = prefix - w[r]  # W[r - 1]
            if prev_prefix > best_prev[p]:
                best_prev[p] = prev_prefix

        return base + max_delta
