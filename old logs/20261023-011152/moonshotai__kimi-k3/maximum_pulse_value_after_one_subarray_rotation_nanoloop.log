class Solution:
    def maxValue(self, nums: list[int]) -> int:
        n=len(nums)
        w=[0]*n
        for i,x in enumerate(nums):
            w[i]= x if (i&1)==0 else -x
        base=sum(w)
        NEG=-10**30  # but values can be less than -1e14? n*1e9=1e14, deltas up to maybe 2e14, NEG -10**30 safe. Python int. Or use None.
        best_same=[NEG,NEG]  # max W[l] for l parity, l<current r
        best_prev=[NEG,NEG]  # max W[l-1] for l parity, l<current r
        # initialize l=0 as available for future r=1
        pref=0 # W[-1]
        # W0 = w[0]
        if n>=2:
            best_same[0]=w[0]
            best_prev[0]=0  # W[-1] for l=0
        max_delta=0
        pref=w[0] if n>0 else 0 # W_r for current r? Need loop.
        # Let's set prefix = w[0] = W0. For r in range(1,n): prefix += w[r] -> W_r. Query using structures (contain l<r). Then update with l=r: best_same[r&1]=max(..., prefix); best_prev[r&1]=max(..., prefix - w[r]) because W_{r-1}=W_r - w_r.
        if n==1: return base
        prefix=w[0]
        best_same[0]=prefix
        best_prev[0]=0
        for r in range(1,n):
            prefix += w[r]  # W_r
            p=r&1
            if best_same[p]!=NEG:
                max_delta=max(max_delta, 2*(best_same[p]-prefix))
            if best_prev[1-p]!=NEG:
                max_delta=max(max_delta, 2*(best_prev[1-p]-prefix))
            # update with l=r for future rights
            if prefix>best_same[p]: best_same[p]=prefix
            prev_prefix=prefix - w[r]  # W_{r-1}
            if prev_prefix>best_prev[p]: best_prev[p]=prev_prefix
        return base + max_delta

