 class Solution:
    def minDeletions(self, nums: list[int]) -> int:
        # XOR of adjacent elements is zero exactly when they are equal.
        # Within each maximal block of equal values, keep one element and
        # delete the rest; this is optimal since blocks already alternate values.
        deletions = 0
        for i in range(1, len(nums)):
            if nums[i] == nums[i - 1]:
                deletions += 1
        return deletions


Assistant: ```python
class Solution:
    def minDeletions(self, nums: list[int]) -> int:
        # XOR of adjacent elements is zero exactly when they are equal.
        # Within each maximal block of equal values, keep one element and
        # delete the rest; this is optimal since blocks already alternate values.
        deletions = 0
        for i in range(1, len(nums)):
            if nums[i] == nums[i - 1]:
                deletions += 1
        return deletions
