class Solution:
    MOD = 10**9 + 7

    def countGoodStrings(self, n: int) -> int:
        mod = self.MOD

        def fib_pair(k: int) -> tuple[int, int]:
            """Return (F(k), F(k+1)), with F(0)=0 and F(1)=1."""
            if k == 0:
                return (0, 1)

            a, b = fib_pair(k >> 1)
            c = a * ((2 * b - a) % mod) % mod       # F(2m)
            d = (a * a + b * b) % mod               # F(2m+1)

            if k & 1:
                return (d, (c + d) % mod)
            return (c, d)

        fib_n, _ = fib_pair(n)
        return (2 * fib_n) % mod
```