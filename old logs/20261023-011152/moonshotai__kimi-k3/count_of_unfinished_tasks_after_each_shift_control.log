class Solution:
    def countTasks(self, tasks: list[int], shifts: list[int]) -> list[int]:
        n = len(tasks)
        total = sum(tasks)
        
        ans = []
        i = 0          # current task index
        remain = tasks[0]  # remaining work on current task
        
        for s in shifts:
            # finish all tasks if possible within this shift
            if remain + sum(tasks[i+1:]) <= s:
                ans.append(0)
                i = 0
                remain = tasks[0]
            else:
                t = s
                while t >= remain:
                    t -= remain
                    i += 1
                    remain = tasks[i]
                remain -= t
                ans.append(n - i)
        
        return ans
