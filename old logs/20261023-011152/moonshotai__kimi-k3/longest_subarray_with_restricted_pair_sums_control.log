class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        V = 500
        cnt = [0] * (V + 1)
        bad = 0
        left = 0
        ans = 0

        def target_pairs(x: int) -> int:
            total = 0
            for a in range(1, x // 2 + 1):
                b = x - a
                if a == b:
                    c = cnt[a]
                    total += c * (c - 1) // 2
                else:
                    total += cnt[a] * cnt[b]
            return total

        def add(x: int) -> None:
            nonlocal bad
            delta = target_pairs(x)
            for y in range(1, V - x + 1):
                delta += cnt[y] * cnt[x + y]
            cnt[x] += 1
            bad += delta

        def remove(x: int) -> None:
            nonlocal bad
            delta = target_pairs(x)
            old = cnt[x]
            for y in range(1, V - x + 1):
                if y == x:
                    delta += (old - 1) * cnt[x + y]
                else:
                    delta += cnt[y] * cnt[x + y]
            cnt[x] -= 1
            bad -= delta

        for right, x in enumerate(nums):
            add(x)
            while bad > 0:
                remove(nums[left])
                left += 1
            length = right - left + 1
            if length > ans:
                ans = length
        return ans

