class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        V=500
        cnt=[0]*(V+1)
        bad=0
        left=0
        best=0

        def add(x):
            nonlocal bad
            old=cnt[x]
            delta=0
            limit=V-x
            # y loop
            for y in range(1, limit+1):
                if y == x:
                    delta += old * cnt[x+y] # 2x
                else:
                    delta += cnt[y] * cnt[x+y]
            # Could optimize equal outside to avoid branch:
            for y in range(1, V-x+1): delta += cnt[y]*cnt[x+y]
            # But this includes y=x term cnt[x]*cnt[2x] using old cnt[x]; correct old. Since cnt[x] still old. So no branch! For y=x, derivative equal is old*c[2x], exactly cnt[x]*cnt[2x]. Wait non-equal formula for y=x would c[x]*c[2x], same as increment equal delta old*c2. Yes! So can simply loop all y including x while cnt[x] old. Nice.
            # target pairs
            for a in range(1, x//2+1):
                b=x-a
                if a==b:
                    ca=cnt[a]; delta += ca*(ca-1)//2
                else: delta += cnt[a]*cnt[b]
            cnt[x]=old+1; bad += delta

