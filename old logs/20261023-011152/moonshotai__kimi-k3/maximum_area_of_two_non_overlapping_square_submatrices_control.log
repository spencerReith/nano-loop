class Solution:
    def maxArea(self, mat: list[list[int]]) -> int:
        m = len(mat)
        n = len(mat[0])

        # Prefix sum of usable cells.
        ps = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(m):
            run = 0
            above = ps[i]
            cur = ps[i + 1]
            row = mat[i]
            for j in range(n):
                run += row[j]
                cur[j + 1] = above[j + 1] + run

        def possible(k: int) -> bool:
            if k == 0:
                return True

            need = k * k
            min_r, max_r = m, -1
            min_c, max_c = n, -1

            for i in range(m - k + 1):
                top = ps[i]
                bot = ps[i + k]
                for j in range(n - k + 1):
                    if bot[j + k] - top[j + k] - bot[j] + top[j] == need:
                        if i < min_r:
                            min_r = i
                        if i > max_r:
                            max_r = i
                        if j < min_c:
                            min_c = j
                        if j > max_c:
                            max_c = j

                        # Two equal k x k squares are disjoint iff their
                        # top-left rows differ by >= k or cols differ by >= k.
                        if max_r - min_r >= k or max_c - min_c >= k:
                            return True
            return False

        lo, hi = 0, min(m, n)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if possible(mid):
                lo = mid
            else:
                hi = mid - 1

        return lo * lo
