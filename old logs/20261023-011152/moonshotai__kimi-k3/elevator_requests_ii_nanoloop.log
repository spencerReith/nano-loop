```python
def brute(n, start, requests):
    reqs = sorted(set(requests) - {start})
    m = len(reqs)
    import heapq
    # nodes: indices -1 for start
    # precompute for each pair movement... simpler: Dijkstra state (pos_floor, mask)
    INF = float('inf')
    dist = {}
    start_state = (start, 0)
    dist[start_state] = 0
    pq = [(0, start, 0)]
    full = (1<<m)-1
    ans = INF
    while pq:
        d, pos, mask = heapq.heappop(pq)
        if d != dist.get((pos,mask)): continue
        if mask == full:
            ans = d; break
        u = m - bin(mask).count('1')
        for i, f in enumerate(reqs):
            if mask>>i & 1: continue
            nmask = mask
            lo, hi = min(pos,f), max(pos,f)
            for j, g in enumerate(reqs):
                if lo <= g <= hi: nmask |= 1<<j
            nd = d + abs(f-pos)*u
            st = (f, nmask)
            if nd < dist.get(st, INF):
                dist[st] = nd
                heapq.heappush(pq, (nd, f, nmask))
    return ans
```

