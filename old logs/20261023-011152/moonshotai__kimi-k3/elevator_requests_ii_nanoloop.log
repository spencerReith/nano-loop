Pseudo:

```python
from bisect import bisect_left

class Solution:
    def elevatorRequests(self, n, start, requests):
        reqs = sorted(requests)
        # remove start if present
        i = bisect_left(reqs, start)
        if i < len(reqs) and reqs[i] == start:
            reqs.pop(i)
        m = len(reqs)
        if m == 0:
            return 0
        p = reqs
        idx = bisect_left(p, start)  # requests < start count
        INF = float('inf')
        cur0 = [INF]*m
        cur1 = [INF]*m
        if idx > 0:
            cur0[idx-1] = cur1[idx-1] = (start - p[idx-1]) * m
        if idx < m:
            cur0[idx] = cur1[idx] = (p[idx] - start) * m
        length = 1
        while length < m:
            u = m - length
            nxt0 = [INF]*m
            nxt1 = [INF]*m
            # l ranges so that r = l+length-1 < m
            for l in range(0, m - length + 1):
                c0 = cur0[l]; c1 = cur1[l]
                if c0 == INF and c1 == INF:
                    continue
                r = l + length - 1
                pl = p[l]; pr = p[r]
                if l > 0:
                    a = p[l-1]
                    cand = c0 + (pl - a)*u
                    cand2 = c1 + (pr - a)*u
                    best = cand if cand < cand2 else cand2
                    if best < nxt0[l-1]:
                        nxt0[l-1] = best
                if r < m-1:
                    b = p[r+1]
                    cand = c0 + (b - pl)*u
                    cand2 = c1 + (b - pr)*u
                    best = cand if cand < cand2 else cand2
                    if best < nxt1[l]:
                        nxt1[l] = best
            cur0, cur1 = nxt0, nxt1
            length += 1
        return min(cur0[0], cur1[0])
```

