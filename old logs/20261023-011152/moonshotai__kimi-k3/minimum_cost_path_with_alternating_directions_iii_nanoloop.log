```python
import heapq


class Solution:
    def minCost(self, m: int, n: int, penalty: list[list[int]]) -> int:
        # State: (i, j, p) where p == 1 means the next action number is odd,
        # p == 0 means it is even.
        INF = float('inf')
        dist = [[[INF, INF] for _ in range(n)] for _ in range(m)]
        # Start at (0, 0), pay its entrance cost (0+1)*(0+1) = 1.
        # The first action is action 1 (odd).
        dist[0][0][1] = 1
        pq = [(1, 0, 0, 1)]  # (cost, i, j, parity_of_next_action)
        ti, tj = m - 1, n - 1

        while pq:
            cost, i, j, p = heapq.heappop(pq)
            if cost > dist[i][j][p]:
                continue
            if i == ti and j == tj:
                return cost
            np_ = 1 - p
            pen = penalty[i][j]

            # Option 1: wait in the current cell
            wcost = cost + pen
            if wcost < dist[i][j][np_]:
                dist[i][j][np_] = wcost
                heapq.heappush(pq, (wcost, i, j, np_))

            # Option 2: move to an adjacent cell
            for di, dj in ((0, 1), (0, -1), (1, 0), (-1, 0)):
                ni, nj = i + di, j + dj
                if 0 <= ni < m and 0 <= nj < n:
                    entry = (ni + 1) * (nj + 1)
                    if p == 1:
                        # Odd action: right (dj==1) or down (di==1) follows the rule
                        ok = (dj == 1 or di == 1)
                    else:
                        # Even action: left (dj==-1) or up (di==-1) follows the rule
                        ok = (dj == -1 or di == -1)
                    ncost = cost + entry + (0 if ok else pen)
                    if ncost < dist[ni][nj][np_]:
                        dist[ni][nj][np_] = ncost
                        heapq.heappush(pq, (ncost, ni, nj, np_))

        return -1  # unreachable, should not happen
```