```python
import heapq

class Solution:
    def minCost(self, m: int, n: int, penalty: list[list[int]]) -> int:
        # State: (i, j, p) where p = 1 if next action is odd, 0 if even
        # Start at (0, 0) with next action = 1 (odd), cost = entry(0,0) = 1
        INF = float('inf')
        # dist[i][j][p]
        dist = [[[INF, INF] for _ in range(n)] for _ in range(m)]
        dist[0][0][1] = 1  # entry cost (0+1)*(0+1) = 1
        pq = [(1, 0, 0, 1)]  # (cost, i, j, p)
        target = (m - 1, n - 1)
        
        while pq:
            cost, i, j, p = heapq.heappop(pq)
            if cost > dist[i][j][p]:
                continue
            if (i, j) == target:
                return cost
            np = 1 - p
            # Wait
            wcost = cost + penalty[i][j]
            if wcost < dist[i][j][np]:
                dist[i][j][np] = wcost
                heapq.heappush(pq, (wcost, i, j, np))
            # Moves
            for di, dj in ((0,1),(0,-1),(1,0),(-1,0)):
                ni, nj = i + di, j + dj
                if 0 <= ni < m and 0 <= nj < n:
                    entry = (ni + 1) * (nj + 1)
                    # Determine if move follows parity rule
                    if p == 1:  # odd action: right or down is ok
                        ok = (di == 1 or dj == 1)
                    else:  # even action: left or up is ok
                        ok = (di == -1 or dj == -1)
                    extra = 0 if ok else penalty[i][j]
                    ncost = cost + entry + extra
                    if ncost < dist[ni][nj][np]:
                        dist[ni][nj][np] = ncost
                        heapq.heappush(pq, (ncost, ni, nj, np))
        return -1  # should not happen
```

