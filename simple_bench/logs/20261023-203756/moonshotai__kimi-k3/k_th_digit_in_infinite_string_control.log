class Solution:
    def kthDigit(self, k: int) -> int:
        # Find the length (number of digits) of the target number
        d = 1
        count = 9
        
        while k > d * count:
            k -= d * count
            d += 1
            count *= 10
        
        # Calculate the starting range for d-digit numbers
        start = 10**(d - 1)
        
        # Determine which block of 10 numbers we are in
        # b is the 0-indexed block number within the d-digit range
        b = (k - 1) // (10 * d)
        
        # Get the 0-indexed offset within the block
        offset = (k - 1) % (10 * d)
        
        # Determine if the block is increasing or decreasing
        # The problem states "if b is even". 
        # Since the first block of any digit length is index 0 (even) and increasing,
        # the parity of the relative index matches the requirement.
        if b % 2 == 0:
            # Increasing order
            num_idx = offset // d
            num = start + b * 10 + num_idx
        else:
            # Decreasing order
            num_idx = offset // d
            num = start + b * 10 + (9 - num_idx)
            
        # Extract the specific digit from the number
        digit_idx = offset % d
        
        return int(str(num)[digit_idx])
