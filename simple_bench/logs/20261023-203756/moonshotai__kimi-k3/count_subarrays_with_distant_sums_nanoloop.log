from bisect import bisect_left, bisect_right


class Solution:
    def distantSubarrays(self, nums: list[int], goal: int, k: int) -> int:
        n = len(nums)
        if k == 0:
            return n * (n + 1) // 2

        pref = [0] * (n + 1)
        for i, x in enumerate(nums, 1):
            pref[i] = pref[i - 1] + x

        coords = sorted(set(pref))
        m = len(coords)
        bit = [0] * (m + 1)

        def add(idx: int, delta: int) -> None:
            while idx <= m:
                bit[idx] += delta
                idx += idx & -idx

        def sum_(idx: int) -> int:
            s = 0
            while idx > 0:
                s += bit[idx]
                idx -= idx & -idx
            return s

        ans = 0
        seen = 0
        # Insert prefix sum 0 before processing subarrays ending at position 1.
        add(bisect_left(coords, pref[0]) + 1, 1)
        seen = 1

        for r in range(1, n + 1):
            t = pref[r] - goal
            left = sum_(bisect_right(coords, t - k))
            right = seen - sum_(bisect_left(coords, t + k))
            ans += left + right

            add(bisect_left(coords, pref[r]) + 1, 1)
            seen += 1

        return ans
