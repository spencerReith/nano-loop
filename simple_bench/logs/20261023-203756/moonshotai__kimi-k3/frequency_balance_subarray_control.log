```python
class Solution:
    def getLength(self, nums: list[int]) -> int:
        n = len(nums)
        ans = 1
        for i in range(n):
            freq = {}
            fcnt = {}
            distinct = 0
            for j in range(i, n):
                x = nums[j]
                old = freq.get(x, 0)
                new = old + 1
                freq[x] = new
                if old:
                    c = fcnt[old] - 1
                    if c:
                        fcnt[old] = c
                    else:
                        del fcnt[old]
                else:
                    distinct += 1
                fcnt[new] = fcnt.get(new, 0) + 1
                # check
                if distinct == 1:
                    ans = max(ans, j - i + 1)
                elif len(fcnt) == 2:
                    lo = min(fcnt)
                    hi = max(fcnt)
                    if hi == 2 * lo:
                        ans = max(ans, j - i + 1)
        return ans
```

