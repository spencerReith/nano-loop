from math import isqrt

class Solution:
    def maxArea(self, mat: list[list[int]]) -> int:
        m = len(mat)
        n = len(mat[0])

        ps = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(1, m + 1):
            row_sum = 0
            for j in range(1, n + 1):
                row_sum += mat[i - 1][j - 1]
                ps[i][j] = ps[i - 1][j] + row_sum

        def possible(k: int) -> bool:
            rows = m - k + 1
            cols = n - k + 1
            need = k * k

            min_r, max_r = m, -1
            min_c, max_c = n, -1

            for r in range(rows):
                top = ps[r]
                bottom = ps[r + k]
                for c in range(cols):
                    if bottom[c + k] - top[c + k] - bottom[c] + top[c] == need:
                        if r < min_r:
                            min_r = r
                        if r > max_r:
                            max_r = r
                        if c < min_c:
                            min_c = c
                        if c > max_c:
                            max_c = c

                        # Two equal squares are disjoint iff their top-left corners
                        # differ by at least k in row or in column.
                        if max_r - min_r >= k or max_c - min_c >= k:
                            return True
            return False

        lo = 1
        hi = min(m, n, isqrt(ps[m][n] // 2))
        best = 0

        while lo <= hi:
            mid = (lo + hi) // 2
            if possible(mid):
                best = mid
                lo = mid + 1
            else:
                hi = mid - 1

        return best * best
