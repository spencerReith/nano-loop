class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        ans = 0

        for start in range(n):
            even = 0
            odd = 0
            for end in range(start, n):
                if nums[end] % 2 == 0:
                    even += 1
                else:
                    odd += 1

                # x / y <= a / b  <=>  x * b <= y * a, with y > 0
                if odd > 0 and even * b <= odd * a:
                    ans += 1

        return ans
```