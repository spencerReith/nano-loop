class Solution:
    def countGoodStrings(self, n: int) -> int:
        MOD = 1_000_000_007
        a, b = 0, 1
        for bit in bin(n)[2:]:
            two_b_minus_a = (2*b - a) % MOD
            c = a * two_b_minus_a % MOD
            d = (a*a + b*b) % MOD
            if bit == '0':
                a, b = c, d
            else:
                a, b = d, (c + d) % MOD
        return (2*a) % MOD

