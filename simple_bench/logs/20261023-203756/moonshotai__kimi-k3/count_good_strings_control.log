def fib(n):
    a,b=0,1 # F(0),F(1)
    for bit in bin(n)[2:]:
        # double (a,b)=(F(k),F(k+1)) -> (F(2k),F(2k+1))
        c = (a * ((b << 1) - a)) % MOD  # F(2k)=F(k)*(2F(k+1)-F(k))
        d = (a*a + b*b) % MOD          # F(2k+1)
        if bit == '0':
            a,b = c,d
        else:
            a,b = d, (c+d)%MOD
    return a
