class Solution:
    def countLocalMaximums(self, matrix: list[list[int]]) -> int:
        n, m = len(matrix), len(matrix[0])
        count = 0
        
        for r in range(n):
            for c in range(m):
                x = matrix[r][c]
                if x == 0:
                    continue
                
                is_max = True
                # Search space is within x rows and x columns
                for nr in range(max(0, r - x), min(n - 1, r + x) + 1):
                    if not is_max:
                        break
                    rd = abs(nr - r)
                    for nc in range(max(0, c - x), min(m - 1, c + x) + 1):
                        cd = abs(nc - c)
                        
                        # Ignore cells where both row and column distance are exactly x
                        if rd == x and cd == x:
                            continue
                        
                        # If any considered cell is greater, current is not local max
                        if matrix[nr][nc] > x:
                            is_max = False
                            break
                
                if is_max:
                    count += 1
                    
        return count
