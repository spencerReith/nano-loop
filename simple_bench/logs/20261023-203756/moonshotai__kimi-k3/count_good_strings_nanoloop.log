            endB[1] = 1
        
        for length in range(2, n + 1):
            # Case 1: odd length, one distinct character
            if length % 2 == 1:
                f[length] += 2
                startA[length] += 1  # "a"*length
                endA[length] += 1
                startB[length] += 1  # "b"*length
                endB[length] += 1
            
            # Case 2: concatenation
            for k in range(1, length):
                # s1 length k ending with 'a', s2 length length-k starting with 'b'
