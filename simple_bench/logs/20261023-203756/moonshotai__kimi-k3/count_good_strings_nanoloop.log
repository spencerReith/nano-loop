            M[1][0][0] = 1  # "a"
            M[1][1][1] = 1  # "b"
            total[1] = 2
        
        for length in range(2, n+1):
            # Base: odd length one-distinct-char strings
            if length % 2 == 1:
                M[length][0][0] += 1
                M[length][1][1] += 1
                total[length] += 2
            
