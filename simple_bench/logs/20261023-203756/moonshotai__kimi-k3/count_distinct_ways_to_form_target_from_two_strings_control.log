class Solution:
    def interleaveCharacters(self, word1: str, word2: str, target: str) -> int:
        MOD = 10**9 + 7
        n1, n2, m = len(word1), len(word2), len(target)

        # suffix[i][c] = number of indices j >= i with word[j] == c (for each string)
        def build_suffix(word):
            n = len(word)
            suff = [[0]*26 for _ in range(n+1)]
            for i in range(n-1, -1, -1):
                suff[i] = suff[i+1].copy()
                suff[i][ord(word[i]) - 97] += 1
            return suff

        suff1 = build_suffix(word1)
        suff2 = build_suffix(word2)

        # DP from the end: dp[i1][i2] = ways to form target[k:] where
        # k = (n1 - i1) + (n2 - i2), using word1[i1:] and word2[i2:]
        NEG = -10**18
        dp = [[NEG]*(n2+1) for _ in range(n1+1)]
        dp[n1][n2] = 1

        for k in range(m-1, -1, -1):
            c = ord(target[k]) - 97
            new = [[NEG]*(n2+1) for _ in range(n1+1)]
            for i1 in range(n1+1):
                row = new[i1]
                dprow = dp[i1]
                for i2 in range(n2+1):
                    take = m - k
                    if (n1 - i1) + (n2 - i2) != take:
                        continue
                    best = NEG
                    # use word1 for target[k]
                    if suff1[i1][c] > 0:
                        nxt = dp[i1+1][i2]
                        if nxt > NEG:
                            best = max(best, nxt)
                    # use word2 for target[k]
                    if suff2[i2][c] > 0:
                        nxt = dp[i1][i2+1]
                        if nxt > NEG:
                            best = max(best, nxt)
                    row[i2] = best
            dp = new

        # dp[*][*] now holds f(target[0:], ...) — value = f(target) for full suffix
        # g[i][j] = number of ways to pick target[:j] entirely from word1[i:]
        INF_HALF = MOD  # cap values at MOD to keep them small
        g = [[0]*(m+1) for _ in range(n1+1)]
        g[n1][0] = 1
        # process i from n1 down to 0; g[i][0] = 1 (empty prefix needs nothing)
        for i in range(n1, -1, -1):
            if i < n1:
                g[i][0] = 1
            for j in range(1, m+1):
                c = ord(target[j-1]) - 97
                cnt = suff1[i][c]
                if cnt and i < n1:
                    g[i][j] = (g[i+1][j-1] * cnt) % MOD
                else:
                    g[i][j] = 0

        total = 0
        for i1 in range(n1+1):
            for j in range(m+1):
                if g[i1][j] == 0:
                    continue
                i2 = n2 - (j - (n1 - i1))
                if 0 <= i2 <= n2:
                    v = dp[i1][i2]
                    if v > NEG:
                        total = (total + g[i1][j] * v) % MOD
        return total
