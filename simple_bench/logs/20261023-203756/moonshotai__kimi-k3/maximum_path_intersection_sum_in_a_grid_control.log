class Solution:
    def maxScore(self, grid: list[list[int]]) -> int:
        m, n = len(grid), len(grid[0])
        NEG = -10**18
        ans = NEG

        # Shared cells must form a contiguous horizontal segment (same row)
        # or a contiguous vertical segment (same column).
        # For a segment of length >= 2 in a row/col, we can always route the
        # two monotone paths so that exactly this segment is shared.
        # A single shared cell is feasible only when it is strictly interior
        # (the two paths can cross there using 4 distinct neighbours).

        # Best horizontal segment (length >= 2) in every row via prefix sums.
        for i in range(m):
            pref = 0
            # minPref = minimum prefix P[a] with a <= b-1 (so length b-a+1 >= 2)
            P = [0] * (n + 1)
            for j in range(n):
                P[j + 1] = P[j] + grid[i][j]
            min_pre = P[0]
            for b in range(1, n):               # segment ends at index b
                cand = P[b + 1] - min_pre       # a in [0, b-1] -> len >= 2
                if cand > ans:
                    ans = cand
                if P[b] < min_pre:              # allow a = b for the next b
                    min_pre = P[b]

        # Best vertical segment (length >= 2) in every column.
        for j in range(n):
            P = [0] * (m + 1)
            for i in range(m):
                P[i + 1] = P[i] + grid[i][j]
            min_pre = P[0]
            for b in range(1, m):
                cand = P[b + 1] - min_pre
                if cand > ans:
                    ans = cand
                if P[b] < min_pre:
                    min_pre = P[b]

        # Single strictly-interior shared cell (a true crossing).
        for i in range(1, m - 1):
            row = grid[i]
            for j in range(1, n - 1):
                if row[j] > ans:
                    ans = row[j]

        return ans
