class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        pref = [0]*(len(nums)+1)
        p=0
        for i,v in enumerate(nums,1):
            p += b if v%2==0 else -a
            pref[i]=p
        vals=sorted(set(pref))
        comp={v:i+1 for i,v in enumerate(vals)}
        bit=[0]*(len(vals)+1)
        def add(i):
           while i < len(bit): bit[i]+=1; i += i&-i
        def sum_(i):
           s=0
           while i>0: s+=bit[i]; i-=i&-i
           return s
        ans=0
        seen=0
        for p in pref:
           idx=comp[p]
           # prior >= p
           ans += seen - sum_(idx-1)
           add(idx)
           seen+=1
        return ans

