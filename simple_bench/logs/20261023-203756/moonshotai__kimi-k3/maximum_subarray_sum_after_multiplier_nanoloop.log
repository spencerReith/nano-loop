Now write solution.

```python
class Solution:
    def maxSubarraySum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        NEG = float('-inf')
        
        # Kadane
        best = cur = nums[0]
        for x in nums[1:]:
            cur = max(x, cur + x)
            best = max(best, cur)
        ans = best
        
        def boostDP(b):
            nonlocal ans
            f0 = 0          # a-only part ending here (possibly empty)
            f1 = NEG        # inside boost (non-empty)
            f2 = NEG        # boost finished
            for i in range(n):
                ai = nums[i]; bi = b[i]
                nf0 = max(0, f0 + ai)
                nf1 = max(f0, f1) + ai + bi
                nf2 = max(f1, f2) + ai
                if nf1 > ans: ans = nf1
                if nf2 > ans: ans = nf2
                f0, f1, f2 = nf0, nf1, nf2
        
        b_mul = [(k-1)*x for x in nums]
        boostDP(b_mul)
        b_div = []
        for x in nums:
            if x >= 0:
                d = x // k
            else:
                d = -((-x) // k)
            b_div.append(d - x)
        boostDP(b_div)
        return ans
```

