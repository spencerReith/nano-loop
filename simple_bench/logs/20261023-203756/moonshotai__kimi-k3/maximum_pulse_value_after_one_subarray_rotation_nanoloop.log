class Solution:
    def maxValue(self, nums: list[int]) -> int:
        pulse = 0
        best_delta = 0

        # odd_prev: minimum alternating-sum of an odd-length subarray ending at previous index
        # even_prev: minimum alternating-sum of an even-length subarray ending at previous index
        odd_prev = 0
        even_prev = None

        for i, v in enumerate(nums):
            x = v if (i & 1) == 0 else -v
            pulse += x

            if i == 0:
                odd_prev = x
                even_prev = None
                continue

            # Even-length subarray ending at i: extend best odd-length subarray ending at i-1.
            even_cur = odd_prev + x
            best_delta = max(best_delta, -2 * even_cur)

            # Odd-length subarray ending at i: start fresh at i, or extend an even-length one.
            if even_prev is None:
                odd_cur = x
            else:
                odd_cur = min(x, even_prev + x)

            odd_prev = odd_cur
            even_prev = even_cur

