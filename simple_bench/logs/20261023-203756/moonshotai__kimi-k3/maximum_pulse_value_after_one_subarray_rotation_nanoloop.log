Let's write:

class Solution:
    def maxValue(self, nums: list[int]) -> int:
        pulse = 0
        best_delta = 0
        odd_prev = 0
        even_prev = None
        for i, v in enumerate(nums):
            x = v if (i & 1) == 0 else -v
            pulse += x
            if i == 0:
                odd_prev = x
                even_prev = None
                continue
            even_cur = odd_prev + x
            delta = -2 * even_cur
            if delta > best_delta:
                best_delta = delta
            if even_prev is None:
                odd_cur = x
            else:
                extend = even_prev + x
                odd_cur = x if x < extend else extend
            odd_prev = odd_cur
            even_prev = even_cur
        return pulse + best_delta

