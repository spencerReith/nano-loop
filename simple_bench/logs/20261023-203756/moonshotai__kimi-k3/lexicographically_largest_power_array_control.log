class Solution:
    def largestPower(self, nums: list[int]) -> list[int]:
        cnt = [0] * 15
        for x in nums:
            for b in range(15):
                cnt[b] += (x >> b) & 1
        nums.sort(reverse=True)
        power = [0] * 15
        for i, x in enumerate(nums):
            for b in range(15):
                if (x >> b) & 1:
                    j = 14 - b
                    if i + 1 > power[j]:
                        power[j] = i + 1
        return power
