```python
class Solution:
    def countLocalMaximums(self, matrix):
        n = len(matrix)
        m = len(matrix[0])
        
        # 2D Fenwick tree
        bit = [[0]*(m+1) for _ in range(n+1)]
        
        def update(r, c, delta):
            i = r+1
            while i <= n:
                j = c+1
                row = bit[i]
                while j <= m:
                    row[j] += delta
                    j += j & -j
                i += i & -i
        
        def query(r, c):
            # sum of [0..r][0..c]
            s = 0
            i = r+1
            while i > 0:
                j = c+1
                row = bit[i]
                while j > 0:
                    s += row[j]
                    j -= j & -j
                i -= i & -i
            return s
        
        def rectSum(r1, c1, r2, c2):
            if r1 > r2 or c1 > c2:
                return 0
            res = query(r2, c2)
            if r1 > 0:
                res -= query(r1-1, c2)
            if c1 > 0:
                res -= query(r2, c1-1)
            if r1 > 0 and c1 > 0:
                res += query(r1-1, c1-1)
            return res
        
        # group cells by value
        from collections import defaultdict
        byVal = defaultdict(list)
        for r in range(n):
            for c in range(m):
                v = matrix[r][c]
                if v > 0:
                    byVal[v].append((r,c))
        
        ans = 0
        for v in sorted(byVal.keys(), reverse=True):
            cells = byVal[v]
            # query phase
            for (r, c) in cells:
                x = v
                r1 = r - x
                if r1 < 0: r1 = 0
                r2 = r + x
                if r2 >= n: r2 = n-1
                c1 = c - x
                if c1 < 0: c1 = 0
                c2 = c + x
                if c2 >= m: c2 = m-1
                cnt = rectSum(r1, c1, r2, c2)
                # subtract corners (r±x, c±x) inside matrix
                for dr in (-x, x):
                    rr = r + dr
                    if 0 <= rr < n:
                        for dc in (-x, x):
                            cc = c + dc
                            if 0 <= cc < m:
                                cnt -= rectSum(rr, cc, rr, cc)
                if cnt == 0:
                    ans += 1
            # update phase
            for (r, c) in cells:
                update(r, c, 1)
        
        return ans
```

