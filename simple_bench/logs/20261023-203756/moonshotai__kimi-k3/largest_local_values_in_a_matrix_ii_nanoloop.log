```python
class Solution:
    def countLocalMaximums(self, matrix: list[list[int]]) -> int:
        n = len(matrix)
        m = len(matrix[0])
        bit = [[0] * (m + 1) for _ in range(n + 1)]

        # group non-zero cells by value
        by_val = {}
        for r in range(n):
            row = matrix[r]
            for c in range(m):
                v = row[c]
                if v:
                    by_val.setdefault(v, []).append((r, c))

        def prefix(i, j):
            # sum over rows [0, i), cols [0, j)
            s = 0
            while i > 0:
                brow = bit[i]
                jj = j
                while jj > 0:
                    s += brow[jj]
                    jj -= jj & -jj
                i -= i & -i
            return s

        ans = 0
        for x in sorted(by_val, reverse=True):
            cells = by_val[x]
            for r, c in cells:
                r1 = r - x
                if r1 < 0:
                    r1 = 0
                r2 = r + x
                if r2 >= n:
                    r2 = n - 1
                c1 = c - x
                if c1 < 0:
                    c1 = 0
                c2 = c + x
                if c2 >= m:
                    c2 = m - 1
                cnt = (prefix(r2 + 1, c2 + 1)
                       - prefix(r1, c2 + 1)
                       - prefix(r2 + 1, c1)
                       + prefix(r1, c1))
                # subtract excluded corners that have greater value
                mrow = matrix
                for rr in (r - x, r + x):
                    if 0 <= rr < n:
                        rowv = mrow[rr]
                        for cc in (c - x, c + x):
                            if 0 <= cc < m and rowv[cc] > x:
                                cnt -= 1
                if cnt == 0:
                    ans += 1
            # add these cells
            for r, c in cells:
                i = r + 1
                while i <= n:
                    brow = bit[i]
                    j = c + 1
                    while j <= m:
                        brow[j] += 1
                        j += j & -j
                    i += i & -i
        return ans
```

