```python
from math import gcd

class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        ans = 1
        n = len(nums)
        i = 0
        while i < n:
            r = nums[i] % k
            j = i
            while j < n and nums[j] % k == r:
                j += 1
            L = j - i
            t = k // gcd(r, k)
            m = 1 + (L - 1) // t * t
            if m > ans:
                ans = m
            i = j
        return ans
```

