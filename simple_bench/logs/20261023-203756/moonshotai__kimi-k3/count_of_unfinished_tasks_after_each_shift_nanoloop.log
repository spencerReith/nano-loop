from bisect import bisect_right

class Solution:
    def countTasks(self, tasks: list[int], shifts: list[int]) -> list[int]:
        n=len(tasks)
        prefix=[0]*(n+1)
        s=0
        for i,x in enumerate(tasks,1):
            s+=x
            prefix[i]=s
        total=s
        ans=[]
        done=0  # time completed in current pass since last restart
        for time in shifts:
            done += time
            if done >= total:
                ans.append(0)
                done = 0
            else:
                completed = bisect_right(prefix, done) - 1
                ans.append(n - completed)
        return ans

