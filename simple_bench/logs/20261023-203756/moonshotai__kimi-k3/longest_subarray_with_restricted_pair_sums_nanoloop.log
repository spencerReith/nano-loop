from solution import Solution
import itertools, random

def valid(sub):
    m=len(sub)
    for i in range(m):
      for j in range(m):
        if j==i: continue
        for k in range(m):
          if k==i or k==j: continue
          if sub[i]+sub[j]==sub[k]: return False
    return True
