Let's write solution.py:
MAXV = 500
_BY_VAL = [[] for _ in range(MAXV + 1)]
for _a in range(1, MAXV + 1):
    for _b in range(_a, MAXV + 1):
        _c = _a + _b
        if _c > MAXV:
            break
        _t = (_a, _b, _c)
        _BY_VAL[_a].append(_t)
        if _b != _a:
            _BY_VAL[_b].append(_t)
        _BY_VAL[_c].append(_t)

class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        cnt = [0] * (MAXV + 1)
        by_val = _BY_VAL
        n = len(nums)
        r = 0
        ans = 0
        for l, x in enumerate(nums):
            while r < n:
                y = nums[r]
                cnt[y] += 1
                bad = False
                for a,b,c in by_val[y]:
                    if a == b:
                        if cnt[a] >= 2 and cnt[c]:
                            bad = True; break
                    elif cnt[a] and cnt[b] and cnt[c]:
                        bad = True; break
                if bad:
                    cnt[y] -= 1
                    break
                r += 1
            if r - l > ans: ans = r - l
            cnt[x] -= 1
        return ans

