```python
class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        MAXV = 500
        freq = [0] * (MAXV + 1)
        violations = 0
        left = 0
        ans = 0

        def pair_count(s: int) -> int:
            total = 0
            for a in range(1, (s - 1) // 2 + 1):
                total += freq[a] * freq[s - a]
            if s % 2 == 0:
                c = freq[s // 2]
                total += c * (c - 1) // 2
            return total

        for right, x in enumerate(nums):
            added = pair_count(x)
            limit = MAXV - x
            for a in range(1, limit + 1):
                added += freq[a] * freq[a + x]
            freq[x] += 1
            violations += added

            while violations > 0:
                y = nums[left]
                freq[y] -= 1
                removed = pair_count(y)
                limit = MAXV - y
                for a in range(1, limit + 1):
                    removed += freq[a] * freq[a + y]
                violations -= removed
                left += 1

            ans = max(ans, right-left+1)
        return ans
```

