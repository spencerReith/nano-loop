```python
class Solution:
    def aggregateTimeSeries(self, series1: list[list[int]], series2: list[list[int]]) -> list[list[int]]:
        times1 = [item[0] for item in series1]
        vals1 = [item[1] for item in series1]
        times2 = [item[0] for item in series2]
        vals2 = [item[1] for item in series2]

        n1, n2 = len(times1), len(times2)
        i = j = 0          # merge pointers for the union of timestamps
        p1 = p2 = 0        # first index with timestamp >= current timestamp
        ans = []

        while i < n1 or j < n2:
            if j >= n2 or (i < n1 and times1[i] < times2[j]):
                t = times1[i]
                i += 1
            elif i >= n1 or times2[j] < times1[i]:
                t = times2[j]
                j += 1
            else:
                t = times1[i]
                i += 1
                j += 1

            while p1 < n1 and times1[p1] < t:
                p1 += 1
            while p2 < n2 and times2[p2] < t:
                p2 += 1

            v1 = vals1[p1] if p1 < n1 else 0
            v2 = vals2[p2] if p2 < n2 else 0
            ans.append([t, v1 + v2])

        return ans
