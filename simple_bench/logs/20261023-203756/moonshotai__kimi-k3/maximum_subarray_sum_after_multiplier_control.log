class Solution:
    def maxSubarraySum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        t = int(1e18)

        # Function to divide by k with specified rounding
        def div(x, k):
            if x >= 0:
                return x // k
            else:
                # Ceiling division for negative numbers
                return -((-x) // k) if (-x) % k != 0 else x // k

        # Arrays to store values after applying operations to each element
        mul = [0] * n
        divv = [0] * n
        for i in range(n):
            x = nums[i]
            mul[i] = x * k
            # Using the div function for proper rounding
            if x >= 0:
                divv[i] = x // k
            else:
                # Ceiling division for negative numbers
                if x % k == 0:
                    divv[i] = x // k
                else:
                    divv[i] = x // k + 1

        # dp arrays for 4 states: 
        # 0: no operation, 1: multiply, 2: divide, 3: operation used
        f0 = [0] * (n + 1)  # no operation used yet
        f1 = [-t] * (n + 1)  # multiply operation in progress
        f2 = [-t] * (n + 1)  # divide operation in progress
        f3 = [-t] * (n + 1)  # operation already used

        # Initialize with first element
        f0[0] = nums[0]
        f1[0] = mul[0]
        f2[0] = divv[0]

        ans = max(f0[0], f1[0], f2[0])

        for i in range(1, n):
            # State 0: No operation used yet
            f0[i] = max(f0[i-1] + nums[i], nums[i])

            # State 1: Multiply operation in progress
            # Can start new multiply or continue previous multiply
            f1[i] = max(f0[i-1] + mul[i], f1[i-1] + mul[i], mul[i])

            # State 2: Divide operation in progress
            # Can start new divide or continue previous divide
            f2[i] = max(f0[i-1] + divv[i], f2[i-1] + divv[i], divv[i])

            # State 3: Operation already used
            # Can come from states 1, 2, or 3
            f3[i] = max(f1[i-1] + nums[i], f2[i-1] + nums[i], f3[i-1] + nums[i], nums[i])

            ans = max(ans, f0[i], f1[i], f2[i], f3[i])

        return ans
```