class Solution:
    def generateValidStrings(self, n: int, k: int) -> list[str]:
        result = []

        def backtrack(pos: int, prev_one: bool, current_cost: int, current: list[str]):
            if pos == n:
                result.append("".join(current))
                return
            # Try placing '0'
            current.append('0')
            backtrack(pos + 1, False, current_cost, current)
            current.pop()
            # Try placing '1' if allowed
            if not prev_one:
                new_cost = current_cost + pos
                if new_cost <= k:
                    current.append('1')
                    backtrack(pos + 1, True, new_cost, current)
                    current.pop()

        backtrack(0, False, 0, [])
        return result
