from typing import List

class Solution:
    def minBishopMoves(self, source: List[int], target: List[int]) -> int:
        sr, sc = source
        tr, tc = target
        
        if sr == tr and sc == tc:
            return 0
        
        if abs(sr - tr) == abs(sc - tc):
            return 1
        
        if (sr + sc) % 2 != (tr + tc) % 2:
            return -1
        
        return 2
```
