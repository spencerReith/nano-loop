class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        ans = 0
        # i is the left bound of the subarray
        for i in range(n):
            # freq holds counts of numbers currently in the window [i, j-1]
            freq = {}
            # j expands the right bound
            for j in range(i, n):
                x = nums[j]
                # Check if adding x would create a forbidden triple:
                # there must be two distinct indices (could be the same value
                # but different positions) whose sum equals x.
                bad = False
                # We need two existing numbers a, b (at distinct indices) with a + b == x.
                # Iterate over possible a values present in freq.
                for a in freq:
                    b = x - a
                    if b in freq:
                        # If a != b we already have two distinct values.
                        # If a == b we need at least two occurrences of that value.
                        if a != b or freq[a] > 1:
                            bad = True
                            break
                if bad:
                    # Further expansion will only add more numbers,
                    # so the window cannot be extended past this j.
                    break
                # Window [i, j] is valid
                ans = max(ans, j - i + 1)
                # Add current x to freq for future checks
                freq[x] = freq.get(x, 0) + 1
        return ans
