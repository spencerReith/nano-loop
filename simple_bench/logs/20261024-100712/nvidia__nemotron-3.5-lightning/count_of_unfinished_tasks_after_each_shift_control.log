class Solution:
    def countTasks(self, tasks: list[int], shifts: list[int]) -> list[int]:
        n = len(tasks)
        # Prefix sums of task times (1-indexed for convenience)
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + tasks[i]
        total = pref[n]

        ans = []
        pos = 0          # index of the next task to work on (0‑based)
        rem = 0          # remaining time of the current task that is already in progress

        for sh in shifts:
            time = sh
            # If we already started a task in the previous shift, we have `rem` time left.
            # If the shift time is enough to finish it, we finish it and subtract.
            if rem > 0:
                if time >= rem:
                    time -= rem
                    rem = 0
                    # task is now finished; pos stays at the same index (next task to start)
                else:
                    # shift ends before finishing the current task
                    rem -= time
                    # no more tasks can be started in this shift
                    # record unfinished tasks count and continue to next shift
                    ans.append(n - pos)
                    continue

            # Now time > 0 and rem == 0, we can start new tasks from pos
            while time > 0 and pos < n:
                # How much time is needed to finish the current task?
                need = tasks[pos] - rem  # rem is 0 here, but keep formula general
                if time >= need:
                    time -= need
                    rem = 0
                    pos += 1
                    # If we finished all tasks, break and discard remaining time
                    if pos == n:
                        break
                else:
                    # Partially finish the task
                    rem = tasks[pos] - time
                    time = 0
                    # pos stays unchanged (same task continues next shift)
                    break

            # After the while loop, if all tasks are finished, discard remaining time
            if pos == n:
                # all tasks completed during this shift, reset pos for next shift
                pos = 0
                rem = 0

            # Number of unfinished tasks = total tasks - tasks already fully completed (pos)
            # If a task is in progress (rem > 0), it also counts as unfinished.
            # The count is simply n - pos because pos tasks have been fully completed.
            # If rem > 0, the task at index pos is partially done and not counted in pos,
            # but it is still unfinished, which is correctly represented by n - pos.
            ans.append(n - pos)

        return ans

