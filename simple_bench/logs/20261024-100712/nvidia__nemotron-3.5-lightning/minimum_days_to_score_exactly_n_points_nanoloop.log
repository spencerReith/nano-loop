import math

class Solution:
    def minDays(self, n: int) -> int:
        # Reformulation: we need to represent n as sum of triangular numbers T_k = k*(k+1)/2
        # where using T_k costs k+1 days (and we subtract 1 at the end because total days = sum cost - 1).
        # We want to minimize total cost = sum (k_i + 1) = sum k_i + m, where m is number of streaks.
        # Then answer = min_cost - 1.
        
        # DP: dp[v] = minimum cost to achieve exactly v points.
        # dp[0] = 0.
        # For v from 1 to n:
        #   dp[v] = min over k>=1 with T_k <= v of (k + 1 + dp[v - T_k])
        
        # Triangular numbers T_k for k=1,2,... up to max_k where T_k <= n.
        # T_k = k*(k+1)//2. Max k approx sqrt(2n).
        
        max_k = int(math.isqrt(2 * n)) + 2  # safe upper bound
        # generate (k, T_k) pairs
        tri = []
        for k in range(1, max_k + 1):
            t = k * (k + 1) // 2
            if t > n:
                break
            tri.append((k, t))
        
        dp = [float('inf')] * (n + 1)
        dp[0] = 0
        
        for v in range(1, n + 1):
            best = float('inf')
            for k, t in tri:
                if t > v:
                    break  # since tri is sorted by k, and T_k increases with k
                # cost of using this triangular number is k + 1
                cand = k + 1 + dp[v - t]
                if cand < best:
                    best = cand
            dp[v] = best
        
        return dp[n] - 1
