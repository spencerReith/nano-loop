```python
from typing import List
import heapq

class Solution:
    def minCost(self, grid: List[List[int]], k: int) -> int:
        m = len(grid)
        n = len(grid[0])
        INF = float('inf')
        # dist[r][c][d][t] = min cost to reach (r,c) with direction d and t turns
        # d: 0=up, 1=down, 2=left, 3=right, 4=none (start)
        dist = [[[[INF] * (k + 1) for _ in range(5)] for _ in range(n)] for _ in range(m)]
        # priority queue: (cost, r, c, dir, turns)
        pq = []
        # start at (0,0) with cost grid[0][0], dir=4 (none), turns=0
        heapq.heappush(pq, (grid[0][0], 0, 0, 4, 0))
        dist[0][0][4][0] = grid[0][0]
        ans = INF
        dirs = [(-1, 0, 0), (1, 0, 1), (0, -1, 2), (0, 1, 3)]  # (dr, dc, dir_index)
        while pq:
            cost, r, c, d, turns = heapq.heappop(pq)
            if cost > dist[r][c][d][turns]:
                continue
            # If we reached target, update answer (but don't expand further from target)
            if r == m - 1 and c == n - 1:
                if turns <= k:
                    ans = min(ans, cost)
                continue
            # Explore neighbors
            for dr, dc, ndir in dirs:
                nr, nc = r + dr, c + dc
                if 0 <= nr < m and 0 <= nc < n:
                    # determine new turns
                    if d == 4:
                        # first move, no turn cost
                        new_turns = 0
                    else:
                        if ndir == d:
                            new_turns = turns
                        else:
                            new_turns = turns + 1
                    if new_turns > k:
                        continue
                    new_cost = cost + grid[nr][nc]
                    if new_cost < dist[nr][nc][ndir][new_turns]:
                        dist[nr][nc][ndir][new_turns] = new_cost
                        heapq.heappush(pq, (new_cost, nr, nc, ndir, new_turns))
        if ans == INF:
            return -1
        return ans
