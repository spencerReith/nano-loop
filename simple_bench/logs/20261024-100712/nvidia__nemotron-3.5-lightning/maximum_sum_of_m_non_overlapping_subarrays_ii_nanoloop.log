from collections import deque
from typing import List

class Solution:
    def maximumSum(self, nums: List[int], m: int, l: int, r: int) -> int:
        n = len(nums)
        # Prefix sums: pref[i] = sum of nums[0..i-1]
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]

        NEG_INF = -10**15
        # prev holds dp[k-1][i] for all i (0..n)
        # dp[0][i] = 0 for all i (0 subarrays selected gives sum 0)
        prev = [0] * (n + 1)
        ans = NEG_INF

        # We want the maximum sum using at most m subarrays (at least one).
        # We compute dp[k][n] for k = 1..m and take the max.
        for k in range(1, m + 1):
            curr = [NEG_INF] * (n + 1)  # curr[i] = dp[k][i]
            dq = deque()  # stores indices j, maintaining decreasing (prev[j] - pref[j])

            for i in range(1, n + 1):
                # Valid previous cut positions j = i - len, where len in [l, r]
                # => j in [i - r, i - l]
                L = max(0, i - r)
                R = i - l

                # Add the new valid j = R to the sliding window deque
                if R >= 0 and prev[R] != NEG_INF:
                    val = prev[R] - pref[R]
                    # Maintain deque in decreasing order of (prev[j] - pref[j])
                    while dq and (prev[dq[-1]] - pref[dq[-1]]) <= val:
                        dq.pop()
                    dq.append(R)
                    # Remove indices that are now out of the left bound
                    while dq and dq[0] < L:
                        dq.popleft()

                # Get the maximum value in the current window
                if dq:
                    max_val = prev[dq[0]] - pref[dq[0]]
                else:
                    max_val = NEG_INF

                # Candidate sum: take a subarray ending at i-1 with best start
                candidate = max_val + pref[i] if max_val != NEG_INF else NEG_INF

                # dp[k][i] = max(skip nums[i-1], take a subarray ending at i-1)
                curr[i] = max(curr[i - 1], candidate)

            # Update answer with the best sum using exactly k subarrays from the whole array
            if curr[n] > ans:
                ans = curr[n]

            # Move to next k: current becomes previous
            prev = curr

        return ans
```
