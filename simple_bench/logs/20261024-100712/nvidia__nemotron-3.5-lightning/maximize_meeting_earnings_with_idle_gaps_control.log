import bisect

class Solution:
    def maxEarnings(self, meetings: list[list[int]]) -> int:
        # Collect all end times for coordinate compression
        ends = [m[1] for m in meetings]
        unique_ends = sorted(set(ends))
        M = len(unique_ends)
        
        # Sort meetings by start time
        meetings.sort(key=lambda x: x[0])
        
        # Fenwick tree (Binary Indexed Tree) for prefix maximum
        INF_NEG = -10**18
        tree = [INF_NEG] * (M + 1)  # 1-indexed
        
        def update(idx, val):
            while idx <= M:
                if val > tree[idx]:
                    tree[idx] = val
                idx += idx & -idx
        
        def query(idx):
            res = INF_NEG
            while idx > 0:
                if tree[idx] > res:
                    res = tree[idx]
                idx -= idx & -idx
            return res
        
        max_ans = 0
        for s, e, r in meetings:
            # Find how many unique end times are <= s
            idx_q = bisect.bisect_right(unique_ends, s)
            if idx_q > 0:
                best = query(idx_q)
            else:
                best = INF_NEG
            
            # dp for this meeting as the last selected
            dp = r + max(0, best + s)
            if dp > max_ans:
                max_ans = dp
            
            # Update Fenwick tree with (dp - e) at the position of end time e
            idx_u = bisect.bisect_left(unique_ends, e) + 1
            val = dp - e
            update(idx_u, val)
        
        return max_ans
