   ```python
   class Solution:
       def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
           n = len(nums)
           N = n - 2  # number of possible peak positions (1..n-2)
           # segment tree over seg indices 0..N-1
           cnt = [0] * (4 * N) if N > 0 else []
           
           # function to update segment tree
           def update_seg(node, l, r, idx, val):
               if l == r:
                   cnt[node] = val
                   return
               mid = (l + r) // 2
               if idx <= mid:
                   update_seg(node*2, l, mid, idx, val)
               else:
                   update_seg(node*2+1, mid+1, r, idx, val)
               cnt[node] = cnt[node*2] + cnt[node*2+1]
           
           # function to build initial peaks
           def build():
               # we can just update each peak initially
               # but we need to know initial nums
               for i in range(1, n - 1):  # original indices 1 to n-2
                   if nums[i-1] < nums[i] > nums[i+1]:
                       update_seg(1, 0, N-1, i-1, 1)
           
           build()
           
           # function to collect peaks in [ql, qr] (seg indices, inclusive)
           def collect_peaks(node, l, r, ql, qr, res):
               if ql > r or qr < l or cnt[node] == 0:
                   return
               if l == r:
                   res.append(l + 1)  # convert to original 1-indexed
                   return
               mid = (l + r) // 2
               collect_peaks(node*2, l, mid, ql, qr, res)
               collect_peaks(node*2+1, mid+1, r, ql, qr, res)
           
           ans = []
           for q in queries:
               if q[0] == 1:
                   l, r = q[1], q[2]
                   if r - l < 2:
                       ans.append(0)
                   else:
                       A = l + 1
                       B = r - 1
                       # A and B are original indices in 1..n-2
                       # seg indices: ql = A-1, qr = B-1
                       # but need to ensure ql <= qr, which is true since A <= B
                       res = []
                       if N > 0:  # always true since n>=3
                           collect_peaks(1, 0, N-1, A-1, B-1, res)
                       Q = res  # already sorted because we go left then right
                       k = len(Q)
                       if k == 0:
                           total_len = B - A + 1
                           peak_free = total_len * (total_len + 1) // 2
                       else:
                           peak_free = 0
                           # Gap 0: [A, Q[0] - 1]
                           if A <= Q[0] - 1:
                               len0 = Q[0] - A
                               peak_free += len0 * (len0 + 1) // 2
                           # Middle gaps
                           for i in range(1, k):
                               s = Q[i-1] + 1
                               e = Q[i] - 1
                               if s <= e:
                                   leni = e - s + 1
                                   peak_free += leni * (leni + 1) // 2
                           # Gap k: [Q[-1] + 1, B]
                           if Q[-1] + 1 <= B:
                               lenk = B - Q[-1]
                               peak_free += lenk * (lenk + 1) // 2
                       total_pairs = (B - A + 1) * (B - A + 2) // 2
                       ans.append(total_pairs - peak_free)
               else:  # q[0] == 2
                   idx, val = q[1], q[2]
                   nums[idx] = val
                   # update peaks at idx-1, idx, idx+1 if in 1..n-2
                   for i in (idx - 1, idx, idx + 1):
                       if 1 <= i <= n - 2:
                           is_peak = (nums[i-1] < nums[i] > nums[i+1])
                           update_seg(1, 0, N-1, i-1, 1 if is_peak else 0)
           return ans
   ```

