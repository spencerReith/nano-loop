class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        
        # free_count[i] = number of item types j (j != i) such that factor_i divides factor_j
        free_count = [0] * n
        for i in range(n):
            fi = items[i][0]
            for j in range(n):
                if i != j and items[j][0] % fi == 0:
                    free_count[i] += 1
        
        # value[i] = 1 (the first purchased copy) + free_count[i] (free copies from buying i)
        value = [1 + fc for fc in free_count]
        min_price = min(items[i][1] for i in range(n))
        
        # dp[c] = maximum sum of value[i] for a subset S with total purchased cost exactly c
        dp = [-1] * (budget + 1)
        dp[0] = 0
        
        # 0/1 knapsack over distinct item types (each bought at least once)
        for i in range(n):
            p = items[i][1]
            v = value[i]
            for c in range(budget, p - 1, -1):
                if dp[c - p] != -1:
                    if dp[c] < dp[c - p] + v:
                        dp[c] = dp[c - p] + v
        
        # After buying the chosen subset S, remaining budget is used to buy additional copies
        # of the globally cheapest item (each gives exactly 1 item per its price)
        ans = 0
        for c in range(budget + 1):
            if dp[c] != -1:
                total = dp[c] + (budget - c) // min_price
                if total > ans:
                    ans = total
        return ans
