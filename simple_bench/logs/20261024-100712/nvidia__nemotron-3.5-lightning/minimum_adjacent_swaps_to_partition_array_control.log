class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        MOD = 10**9 + 7

        # Categorise elements into three types:
        # 0: less than a
        # 1: in [a, b]
        # 2: greater than b
        types = []
        for x in nums:
            if x < a:
                types.append(0)
            elif x <= b:
                types.append(1)
            else:
                types.append(2)

        n = len(types)
        # prefix0[i] = number of type 0 elements in types[:i]
        prefix0 = [0] * (n + 1)
        for i in range(n):
            prefix0[i + 1] = prefix0[i] + (types[i] == 0)

        # prefix1[i] = number of type 1 elements in types[:i]
        prefix1 = [0] * (n + 1)
        for i in range(n):
            prefix1[i + 1] = prefix1[i] + (types[i] == 1)

        # prefix2[i] = number of type 2 elements in types[:i]
        prefix2 = [0] * (n + 1)
        for i in range(n):
            prefix2[i + 1] = prefix2[i] + (types[i] == 2)

        total0 = prefix0[n]
        total1 = prefix1[n]
        total2 = prefix2[n]

        ans = float('inf')

        # Split point k is the length of the first part.
        # First part occupies indices [0, k-1]  (type 0)
        # Second part occupies indices [k, k+m-1] (type 1)
        # Third part occupies indices [k+m, n-1] (type 2)
        # k can range from 0 to n, and m from 0 to n-k.
        for k in range(n + 1):
            # m is the length of the second part.
            # The third part starts at index k+m.
            # We iterate m from 0 to n-k.
            for m in range(n - k + 1):
                # Count misplaced elements in each region.
                # Region 1 (indices 0..k-1): should be type 0 only.
                # Number of type 1 or type 2 inside = k - prefix0[k]
                mis1 = k - prefix0[k]

                # Region 2 (indices k .. k+m-1): should be type 1 only.
                # Number of type 0 or type 2 inside = m - (prefix1[k+m] - prefix1[k])
                mis2 = m - (prefix1[k + m] - prefix1[k])

                # Region 3 (indices k+m .. n-1): should be type 2 only.
                # Number of type 0 or type 1 inside = (n - (k+m)) - (prefix2[n] - prefix2[k+m])
                mis3 = (n - k - m) - (prefix2[n] - prefix2[k + m])

                # Minimum adjacent swaps to fix this partition equals the number
                # of misplaced elements in any one region (they are equal).
                # We take mis1 as the cost.
                cost = mis1
                if cost < ans:
                    ans = cost

        return ans % MOD

