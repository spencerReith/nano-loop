from typing import List

class Solution:
    def shadowPairs(self, nums: List[int]) -> int:
        n = len(nums)
        
        # For each i, find the next index k > i where nums[k] < nums[i]
        # This gives us the right boundary beyond which no shadow pair can start at i
        next_smaller = [n] * n
        
        # Use monotonic increasing stack to find next smaller element
        stack = []
        for i in range(n):
            while stack and nums[i] < nums[stack[-1]]:
                idx = stack.pop()
                next_smaller[idx] = i
            stack.append(i)
        
        # Coordinate compression for nums values
        sorted_nums = sorted(set(nums))
        rank_map = {val: i + 1 for i, val in enumerate(sorted_nums)}
        max_rank = len(sorted_nums)
        
        # Binary Indexed Tree (Fenwick Tree) operations
        bit = [0] * (max_rank + 2)
        
        def bit_add(idx, val):
            while idx <= max_rank:
                bit[idx] += val
                idx += idx & -idx
        
        def bit_sum(idx):
            s = 0
            while idx > 0:
                s += bit[idx]
                idx -= idx & -idx
            return s
        
        def count_less_than(rank_val):
            return bit_sum(rank_val - 1) if rank_val > 1 else 0
        
        # Create events: add i at position i, remove at next_smaller[i]
        add_events = [[] for _ in range(n)]
        remove_events = [[] for _ in range(n)]
        
        for i in range(n):
            r = rank_map[nums[i]]
            add_events[i].append(r)
            if next_smaller[i] < n:
                remove_events[next_smaller[i]].append(r)
        
        count = 0
        # Process each j from 0 to n-1
        # At each position j:
        #   1. Remove i's whose next_smaller == j (no longer valid)
        #   2. Count shadow pairs ending at j: query BIT for nums[i] < nums[j]
        #   3. Add nums[j] to BIT for future positions
        for j in range(n):
            for r in remove_events[j]:
                bit_add(r, -1)
            
            r_j = rank_map[nums[j]]
            count += count_less_than(r_j)
            
            bit_add(r_j, 1)
        
        return count
```

This solution efficiently counts shadow pairs in O(n log n) time using:
1. A monotonic increasing stack to compute `next_smaller[i]` for each index - the first position to the right where a value smaller than `nums[i]` appears
2. Coordinate compression to map nums values to ranks 1..m for BIT operations
3. A Fenwick Tree (BIT) with event processing: as we iterate through the array, we add each index's value to the BIT and remove it when its `next_smaller` boundary is reached. For each position j, we query the BIT to count how many active starting indices i satisfy `nums[i] < nums[j]`, which corresponds to valid shadow pairs (i, j).

