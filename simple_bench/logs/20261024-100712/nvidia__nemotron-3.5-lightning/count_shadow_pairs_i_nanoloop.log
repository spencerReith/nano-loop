```python
from typing import List

class Solution:
    def shadowPairs(self, nums: List[int]) -> int:
        n = len(nums)
        
        next_smaller = [n] * n
        
        stack = []
        for i in range(n):
            while stack and nums[i] < nums[stack[-1]]:
                idx = stack.pop()
                next_smaller[idx] = i
            stack.append(i)
        
        sorted_nums = sorted(set(nums))
        rank_map = {val: i + 1 for i, val in enumerate(sorted_nums)}
        max_rank = len(sorted_nums)
        
        bit = [0] * (max_rank + 2)
        
        def bit_add(idx, val):
            while idx <= max_rank:
                bit[idx] += val
                idx += idx & -idx
        
        def bit_sum(idx):
            s = 0
            while idx > 0:
                s += bit[idx]
                idx -= idx & -idx
            return s
        
        def count_less_than(rank_val):
            return bit_sum(rank_val - 1) if rank_val > 1 else 0
        
        add_events = [[] for _ in range(n)]
        remove_events = [[] for _ in range(n)]
        
        for i in range(n):
            r = rank_map[nums[i]]
            add_events[i].append(r)
            if next_smaller[i] < n:
                remove_events[next_smaller[i]].append(r)
        
        count = 0
        for j in range(n):
            for r in remove_events[j]:
                bit_add(r, -1)
            
            r_j = rank_map[nums[j]]
            count += count_less_than(r_j)
            
            bit_add(r_j, 1)
        
        return count
```


