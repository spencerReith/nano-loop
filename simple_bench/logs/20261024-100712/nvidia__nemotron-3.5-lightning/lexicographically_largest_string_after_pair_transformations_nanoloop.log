```python
from typing import List

class Solution:
    def largestString(self, nums: List[int]) -> List[str]:
        ans = []
        for x in nums:
            s = 'a' * x
            ans.append(self._transform(s))
        return ans

    def _transform(self, s: str) -> str:
        # Greedy left-to-right merging using a stack.
        # Each element in stack is an integer 0-25 representing 'a'-'z'.
        arr = [ord(c) - 97 for c in s]
        stack = []
        for val in arr:
            stack.append(val)
            # While the last two letters are equal and not 'z', merge them.
            while len(stack) >= 2 and stack[-1] == stack[-2] and stack[-1] < 25:
                v = stack.pop()      # pop the top
                stack.pop()          # pop the new top (which equals v)
                stack.append(v + 1)  # push the next letter
        return ''.join(chr(v + 97) for v in stack)
```
