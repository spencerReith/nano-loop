class Solution:
    def maxEqualPairs(self, nums: list[int]) -> int:
        n = len(nums)
        # base: number of adjacent equal pairs in the original array
        base = 0
        for i in range(n - 1):
            if nums[i] == nums[i + 1]:
                base += 1

        # neighbour[v] will be a dict: neighbour_value -> count of unequal pairs (v, neighbour) or (neighbour, v)
        neighbour = {}

        for i in range(n - 1):
            a, b = nums[i], nums[i + 1]
            if a != b:
                # record neighbour relationship for both directions
                if a not in neighbour:
                    neighbour[a] = {}
                neighbour[a][b] = neighbour[a].get(b, 0) + 1

                if b not in neighbour:
                    neighbour[b] = {}
                neighbour[b][a] = neighbour[b].get(a, 0) + 1

        ans = base
        # For each value that appears in at least one unequal adjacent pair,
        # the best gain is the maximum frequency of a single neighbour.
        for v, freq in neighbour.items():
            if freq:
                best_gain = max(freq.values())
                if base + best_gain > ans:
                    ans = base + best_gain

        return ans
