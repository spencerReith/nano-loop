class Solution:
    def minEnergy(self, n: int, brightness: int, intervals: list[list[int]]) -> int:
        """
        Returns the minimum total energy required to maintain at least
        `brightness` illuminated positions at every integer time unit
        covered by at least one interval in `intervals`.

        Each bulb that is on consumes 1 unit of energy per time unit.
        A bulb on at position i illuminates positions i-1, i, i+1 (if they exist).
        Positions are counted at most once for total illumination.

        The problem reduces to: we need to cover the union of intervals with
        a set of bulbs such that at any time unit, the total number of illuminated
        positions >= brightness. Since bulbs only affect a local window of 3
        positions, we can place bulbs to maximize coverage. The optimal strategy
        is to place bulbs spaced 3 apart so each new bulb adds 3 new illuminated
        positions (except at boundaries). To achieve `brightness` illumination,
        we need ceil(brightness / 3) bulbs. However, bulbs can overlap across
        time, and intervals may merge. The minimum energy is:
            (minimum bulbs per time unit) * (total length of merged active intervals).

        More precisely, the minimum number of bulbs needed at any time unit is
        ceil(brightness / 3). Because the intervals may merge into contiguous
        blocks, the total energy is ceil(brightness / 3) * (total merged length).
        """
        import math
        min_bulbs = (brightness + 2) // 3  # ceil(brightness / 3)

        # Merge intervals to find total active time (union length).
        if not intervals:
            return 0

        # Sort intervals by start time.
        intervals_sorted = sorted(intervals, key=lambda x: x[0])
        merged_start, merged_end = intervals_sorted[0]
        total_length = 0

        for start, end in intervals_sorted[1:]:
            if start <= merged_end + 1:  # overlapping or touching
                merged_end = max(merged_end, end)
            else:
                total_length += merged_end - merged_start + 1
                merged_start, merged_end = start, end
        total_length += merged_end - merged_start + 1

        return min_bulbs * total_length
