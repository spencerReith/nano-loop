class Solution:
    def minOperations(self, nums: list[int], k: int) -> int:
        n = len(nums)
        sum_even = [0] * k
        sum_odd = [0] * k

        for i, num in enumerate(nums):
            rem = num % k
            for r in range(k):
                c = min((r - rem) % k, (rem - r) % k)
                if i % 2 == 0:
                    sum_even[r] += c
                else:
                    sum_odd[r] += c

        ans = float('inf')
        for x in range(k):
            for y in range(k):
                if x != y:
                    ans = min(ans, sum_even[x] + sum_odd[y])
        return ans
