```python
from typing import List

class Solution:
    def maxEarnings(self, meetings: List[list[int]]) -> int:
        meetings.sort(key=lambda m: m[1])
        n = len(meetings)
        ends = []
        prefr_max = []
        dp = [0] * n
        ans = 0
        
        import bisect
        
        for i, (start, end, rev) in enumerate(meetings):
            idx = bisect.bisect_right(ends, start) - 1
            best = 0
            if idx >= 0:
                best = prefr_max[idx] + start
            dp_i = rev + max(0, best)
            dp[i] = dp_i
            ans = max(ans, dp_i)
            
            ends.append(end)
            val = dp_i - end
            if prefr_max:
                prefr_max.append(max(prefr_max[-1], val))
            else:
                prefr_max.append(val)
        
        return ans
```


