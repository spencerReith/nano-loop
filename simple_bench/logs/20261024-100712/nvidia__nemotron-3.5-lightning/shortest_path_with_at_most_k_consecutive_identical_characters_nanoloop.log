Assistant: All three examples from the problem statement pass. The solution uses Dijkstra's algorithm where the state is `(node, last_char, consecutive_count)`, ensuring that the path never has more than `k` consecutive identical characters. The first time we pop node `n-1` from the min-heap, we have found the minimum total edge weight.

Here is the final `solution.py`:

```python
from collections import defaultdict
import heapq

class Solution:
    def shortestPath(self, n: int, edges: list[list[int]], labels: str, k: int) -> int:
        # Build adjacency list
        adj = defaultdict(list)
        for u, v, w in edges:
            adj[u].append((v, w))

        # (distance, node, last_char, consecutive_count)
        # Start from node 0
        start_char = labels[0]
        pq = [(0, 0, start_char, 1)]
        best = {}
        best[(0, start_char, 1)] = 0

        while pq:
            dist, node, last_char, consec = heapq.heappop(pq)
            if best.get((node, last_char, consec), float('inf')) < dist:
                continue
            if node == n - 1:
                return dist

            for nxt, w in adj[node]:
                nxt_char = labels[nxt]
                if nxt_char == last_char:
                    new_consec = consec + 1
                else:
                    new_consec = 1
                if new_consec > k:
                    continue
                new_dist = dist + w
                state = (nxt, nxt_char, new_consec)
                if new_dist < best.get(state, float('inf')):
                    best[state] = new_dist
                    heapq.heappush(pq, (new_dist, nxt, nxt_char, new_consec))

        return -1
