class Solution:
    def maxValidPairSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        # dp_max[i] will store the maximum nums[j] for indices j <= i
        # (i is a valid left index for future j's)
        dp_max = [0] * n
        current_max = nums[0]
        for i in range(n):
            if nums[i] > current_max:
                current_max = nums[i]
            dp_max[i] = current_max

        ans = 0
        # j is the right index; valid i's are those with i <= j - k
        # dp_max[j - k] gives the maximum nums[i] for all i <= j - k
        for j in range(k, n):
            candidate = dp_max[j - k] + nums[j]
            if candidate > ans:
                ans = candidate
        return ans
