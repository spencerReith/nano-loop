```python
from typing import List

class Solution:
    def elevatorRequests(self, n: int, start: int, requests: List[list[int]]) -> int:
        m = len(requests)
        if m == 0:
            return 0

        INF = float('inf')
        dp = [[INF] * m for _ in range(1 << m)]

        # Initialize: go from start to each request i
        for i in range(m):
            travel = abs(start - requests[i][1])
            fulfill = max(travel, requests[i][0])
            dp[1 << i][i] = fulfill

        # Fill DP
        for mask in range(1 << m):
            for last in range(m):
                if dp[mask][last] == INF:
                    continue
                for nxt in range(m):
                    if mask & (1 << nxt):
                        continue
                    travel = abs(requests[last][1] - requests[nxt][1])
                    arrive = dp[mask][last] + travel
                    fulfill = max(arrive, requests[nxt][0])
                    new_mask = mask | (1 << nxt)
                    if fulfill < dp[new_mask][nxt]:
                        dp[new_mask][nxt] = fulfill

        full_mask = (1 << m) - 1
        return min(dp[full_mask][i] for i in range(m))
