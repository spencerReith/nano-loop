class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        # difference array to compute the temporary bonus at each index
        diff = [0] * (n + 1)
        for l, r, v in boosts:
            diff[l] += v
            diff[r + 1] -= v

        bonus = 0
        cur_strength = 0          # strength after processing previous monsters (never negative)
        ans = 0                   # we will track the maximum deficit

        for i in range(n):
            bonus += diff[i]                 # temporary bonus for monster i
            # requirement: cur_strength + bonus >= monsters[i]
            # => cur_strength >= monsters[i] - bonus
            need = monsters[i] - bonus
            if need > cur_strength:
                # we must have started with at least (need - cur_strength) more
                ans = max(ans, need - cur_strength)
                cur_strength = need
            # after defeating the monster
            cur_strength -= monsters[i]
            if cur_strength < 0:
                cur_strength = 0

        return ans
