```python
import bisect

class Solution:
    def minOperations(self, nums: list[int]) -> int:
        # Generate all positive palindromes with 1 to 11 digits
        palindromes = []
        for length in range(1, 12):
            if length == 1:
                for d in range(1, 10):
                    palindromes.append(d)
            else:
                half = (length + 1) // 2
                start = 10**(half - 1)
                end = 10**half - 1
                for prefix in range(start, end + 1):
                    s = str(prefix)
                    if length % 2 == 0:
                        pal_str = s + s[::-1]
                    else:
                        pal_str = s + s[-2::-1]
                    pal = int(pal_str)
                    palindromes.append(pal)
        
        # Split into even and odd, and sort
        even_pals = sorted(p for p in palindromes if p % 2 == 0)
        odd_pals = sorted(p for p in palindromes if p % 2 == 1)
        
        total_ops = 0
        for x in nums:
            if x % 2 == 0:
                pals = even_pals
            else:
                pals = odd_pals
            
            # Find closest palindrome
            idx = bisect.bisect_left(pals, x)
            best_diff = float('inf')
            if idx < len(pals):
                best_diff = min(best_diff, abs(pals[idx] - x))
            if idx > 0:
                best_diff = min(best_diff, abs(pals[idx-1] - x))
            
            total_ops += best_diff // 2
        
        return total_ops
```

