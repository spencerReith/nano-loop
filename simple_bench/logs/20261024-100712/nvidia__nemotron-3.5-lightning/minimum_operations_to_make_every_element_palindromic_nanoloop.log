```python
def nearest_palindrome_same_parity(x: int) -> int:
    if is_palindrome(x):
        return 0
    
    s = str(x)
    L = len(s)
    parity = x % 2
    
    candidates = set()
    
    # Helper to add palindrome candidate
    def add_candidate(val: int):
        if val > 0 and is_palindrome(val) and val % 2 == parity:
            candidates.add(val)
    
    # Generate from prefix mirroring
    half = (L + 1) // 2
    prefix = int(s[:half])
    
    for delta in (-1, 0, 1):
        new_pre = prefix + delta
        if new_pre <= 0:
            continue
        new_pre_str = str(new_pre)
        # construct palindrome of length L
        if L % 2 == 0:
            cand_str = new_pre_str + new_pre_str[::-1]
        else:
            cand_str = new_pre_str + new_pre_str[-2::-1]  # mirror all but last digit
        # cand_str might have leading zero if new_pre_str starts with '0'? new_pre >=1 so no leading zero unless new_pre=0 skipped.
        # But length might differ from L. That's okay, we'll add it.
        cand = int(cand_str)
        add_candidate(cand)
    
    # Boundary candidates
    # largest (L-1)-digit palindrome: 10^(L-1) - 1
    if L > 1:
        add_candidate(10**(L-1) - 1)
    # smallest L-digit palindrome: 10^(L-1) + 1
    add_candidate(10**(L-1) + 1)
    # smallest (L+1)-digit palindrome: 10^L + 1
    add_candidate(10**L + 1)
    # single digit 1
    add_candidate(1)
    
    # find closest
    best_diff = None
    for c in candidates:
        diff = abs(x - c)
        if best_diff is None or diff < best_diff:
            best_diff = diff
    return best_diff // 2
```

