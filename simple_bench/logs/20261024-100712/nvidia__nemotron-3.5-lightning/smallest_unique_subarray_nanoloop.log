```python
def smallestUniqueSubarray(self, nums: list[int]) -> int:
    n = len(nums)
    # Build SAM
    size = 1
    last = 0
    max_states = 2 * n
    length = [0] * max_states
    link = [-1] * max_states
    next_dict = [{} for _ in range(max_states)]
    cnt = [0] * max_states
    
    # We'll also need to track which states are 'cur' to initialize cnt
    # We can just set cnt[cur] = 1 after each extend
    
    for c in nums:
        # extend
        cur = size
        size += 1
        length[cur] = length[last] + 1
        cnt[cur] = 1  # this state represents the whole prefix
        p = last
        while p != -1 and c not in next_dict[p]:
            next_dict[p][c] = cur
            p = link[p]
        if p == -1:
            link[cur] = 0
        else:
            q = next_dict[p][c]
            if length[p] + 1 == length[q]:
                link[cur] = q
            else:
                clone = size
                size += 1
                length[clone] = length[p] + 1
                next_dict[clone] = next_dict[q].copy()
                link[clone] = link[q]
                while p != -1 and next_dict[p].get(c) == q:
                    next_dict[p][c] = clone
                    p = link[p]
                link[q] = link[cur] = clone
        last = cur
    
    # Now propagate cnt
    # We need to process states in descending order of length
    # We can use counting sort since length <= n
    max_len = n
    bucket = [[] for _ in range(max_len + 1)]
    for i in range(size):
        if length[i] <= max_len:
            bucket[length[i]].append(i)
    
    for l in range(max_len, -1, -1):
        for v in bucket[l]:
            if link[v] != -1:
                cnt[link[v]] += cnt[v]
    
    # Find min link.len + 1 among states with cnt == 1 and link != -1
    ans = n  # worst case
    for v in range(size):
        if cnt[v] == 1 and link[v] != -1:
            ans = min(ans, length[link[v]] + 1)
    return ans
```

