```python
class SAM:
    def __init__(self, s):
        self.size = 1
        self.last = 0
        self.len = [0] * (2 * len(s))
        self.link = [-1] * (2 * len(s))
        self.next = [dict() for _ in range(2 * len(s))]
        # s is list of integers
        for c in s:
            self.extend(c)
    
    def extend(self, c):
        cur = self.size
        self.size += 1
        self.len[cur] = self.len[self.last] + 1
        p = self.last
        while p != -1 and c not in self.next[p]:
            self.next[p][c] = cur
            p = self.link[p]
        if p == -1:
            self.link[cur] = 0
        else:
            q = self.next[p][c]
            if self.len[p] + 1 == self.len[q]:
                self.link[cur] = q
            else:
                clone = self.size
                self.size += 1
                self.len[clone] = self.len[p] + 1
                self.next[clone] = self.next[q].copy()
                self.link[clone] = self.link[q]
                while p != -1 and self.next[p].get(c) == q:
                    self.next[p][c] = clone
                    p = self.link[p]
                self.link[q] = self.link[cur] = clone
        self.last = cur
```

