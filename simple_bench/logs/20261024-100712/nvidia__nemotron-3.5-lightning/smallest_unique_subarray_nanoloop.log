class Solution:
    def smallestUniqueSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        # Build Suffix Automaton
        max_states = 2 * n
        length = [0] * max_states
        link = [-1] * max_states
        next_dict = [{} for _ in range(max_states)]
        cnt = [0] * max_states
        
        size = 1  # number of states, state 0 is root
        last = 0
        
        for c in nums:
            cur = size
            size += 1
            length[cur] = length[last] + 1
            cnt[cur] = 1  # this state corresponds to a prefix
            p = last
            while p != -1 and c not in next_dict[p]:
                next_dict[p][c] = cur
                p = link[p]
            if p == -1:
                link[cur] = 0
            else:
                q = next_dict[p][c]
                if length[p] + 1 == length[q]:
                    link[cur] = q
                else:
                    clone = size
                    size += 1
                    length[clone] = length[p] + 1
                    next_dict[clone] = next_dict[q].copy()
                    link[clone] = link[q]
                    while p != -1 and next_dict[p].get(c) == q:
                        next_dict[p][c] = clone
                        p = link[p]
                    link[q] = link[cur] = clone
            last = cur
        
        # Propagate cnt using counting sort by length
        max_len = n
        bucket = [[] for _ in range(max_len + 1)]
        for i in range(size):
            l = length[i]
            if l <= max_len:
                bucket[l].append(i)
        
        for l in range(max_len, -1, -1):
            for v in bucket[l]:
                if link[v] != -1:
                    cnt[link[v]] += cnt[v]
        
        ans = n  # worst case: whole array is unique
        for v in range(size):
            if cnt[v] == 1 and link[v] != -1:
                ans = min(ans, length[link[v]] + 1)
        return ans
```

