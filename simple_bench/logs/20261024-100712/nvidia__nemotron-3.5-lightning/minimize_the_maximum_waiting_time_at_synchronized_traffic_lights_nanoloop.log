```python
class Solution:
    def minPenalty(self, period: int, lights: list[int], arrivalTime: list[int]) -> int:
        n = len(arrivalTime)
        m = len(lights)

        # For each car, compute the best (minimum) waiting time across all lights
        min_wait = []
        for t in arrivalTime:
            best = period  # max possible waiting time is period - 1
            for L in lights:
                r = t % period
                if r < L:
                    w = 0
                else:
                    w = period - r
                if w < best:
                    best = w
            min_wait.append(best)

        # The answer is the maximum of the best waiting times
        return max(min_wait) if min_wait else 0
