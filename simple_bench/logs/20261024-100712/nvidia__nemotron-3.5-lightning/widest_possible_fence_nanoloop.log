```python
from collections import Counter
from typing import List

class Solution:
    def maximumWidth(self, planks: List[int]) -> int:
        freq = Counter(planks)
        distinct = list(freq.keys())
        total_groups = {}

        # Singles: each plank of height H forms a group of height H by itself
        for h in distinct:
            total_groups[h] = total_groups.get(h, 0) + freq[h]

        # Pairs of distinct heights (a, b) with a < b, summing to H = a + b
        d = len(distinct)
        for i in range(d):
            a = distinct[i]
            for j in range(i + 1, d):
                b = distinct[j]
                H = a + b
                total_groups[H] = total_groups.get(H, 0) + min(freq[a], freq[b])

        # Pairs of identical heights: two planks of height a combine to height 2a
        for a in distinct:
            H = 2 * a
            total_groups[H] = total_groups.get(H, 0) + freq[a] // 2

        return max(total_groups.values())
