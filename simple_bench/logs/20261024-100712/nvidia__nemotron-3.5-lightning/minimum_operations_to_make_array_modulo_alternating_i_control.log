class Solution:
    def minOperations(self, nums: list[int], k: int) -> int:
        # Count frequencies of remainders for even and odd positions
        cnt_even = [0] * k
        cnt_odd = [0] * k
        
        for i, val in enumerate(nums):
            rem = val % k
            if i % 2 == 0:
                cnt_even[rem] += 1
            else:
                cnt_odd[rem] += 1
                
        n = len(nums)
        # Number of even/odd positions (ceil and floor)
        even_pos = (n + 1) // 2
        odd_pos = n // 2
        
        # best_x = remainder that minimizes operations for even positions
        # best_y = remainder that minimizes operations for odd positions
        # We need x != y, so we consider the top two frequencies for each parity
        
        # Find top two remainders with highest count for even positions
        top_even = []  # list of (count, remainder) sorted descending
        for r in range(k):
            top_even.append((cnt_even[r], r))
        top_even.sort(reverse=True)
        
        # Find top two remainders with highest count for odd positions
        top_odd = []
        for r in range(k):
            top_odd.append((cnt_odd[r], r))
        top_odd.sort(reverse=True)
        
        # Helper to get best count for a given forbidden remainder
        # Returns (min_ops, best_remainder) where best_remainder != forbidden
        def best_for(forbidden, top_list, total_pos):
            # top_list[0] has highest count
            if top_list[0][1] != forbidden:
                best_rem = top_list[0][1]
                best_cnt = top_list[0][0]
            else:
                # need second best
                if len(top_list) > 1:
                    best_rem = top_list[1][1]
                    best_cnt = top_list[1][0]
                else:
                    # only one remainder possible (k >= 2 guarantees at least two, but safe)
                    best_rem = top_list[0][1]
                    best_cnt = 0
            # operations = total positions - number already having best remainder
            min_ops = total_pos - best_cnt
            return min_ops, best_rem
        
        # Evaluate all valid (x, y) pairs using top candidates
        ans = float('inf')
        # we only need to check top few remainders; checking first 3 from each is enough
        # because k <= 100, but we just check all combos of top 3 to be safe
        candidates_even = [top_even[i][1] for i in range(min(3, len(top_even)))]
        candidates_odd = [top_odd[i][1] for i in range(min(3, len(top_odd)))]
        
        for x in candidates_even:
            for y in candidates_odd:
                if x == y:
                    continue
                # compute operations for this pair
                # even positions need remainder x
                # odd positions need remainder y
                # we can compute ops directly from counts
                # ops_even = even_pos - cnt_even[x]
                # ops_odd = odd_pos - cnt_odd[y]
                ops = (even_pos - cnt_even[x]) + (odd_pos - cnt_odd[y])
                if ops < ans:
                    ans = ops
                    
        return ans
