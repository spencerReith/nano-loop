class Solution:
    def maxRatings(self, units: list[list[int]]) -> int:
        # Compute the current rating (minimum unit capacity) for each device
        ratings = [min(device) for device in units]
        
        # Collect all unit capacities into a single list
        all_units = []
        for device in units:
            all_units.extend(device)
        
        # Sort all capacities in descending order
        all_units.sort(reverse=True)
        
        # We can improve at most (m - 1) devices (all but one).
        # The best we can do is to give the top (m-1) capacities to those devices.
        m = len(units)
        k = m - 1  # number of devices we can potentially raise
        
        total = 0
        # For the first k devices (in any order), replace their rating with the best available units
        for i in range(k):
            # The new rating for this device will be the i-th largest unit capacity
            total += all_units[i]
        
        # The remaining device keeps its original minimum rating
        total += ratings[k]
        
        return total
