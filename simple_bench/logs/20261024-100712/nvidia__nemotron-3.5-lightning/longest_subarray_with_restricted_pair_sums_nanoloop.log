We have:
```python
class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        best = 0
        for left in range(n):
            freq = defaultdict(int)
            pair_sum_counts = defaultdict(int)
            for right in range(left, n):
                x = nums[right]
                if pair_sum_counts[x] > 0:
                    break
                # check condition 2
                valid = True
                for v, cnt in freq.items():
                    if (x + v) in freq:
                        valid = False
                        break
                if not valid:
                    break
                # add x to window: update pair sums
                for val, cnt in freq.items():
                    s = val + x
                    pair_sum_counts[s] += cnt
                freq[x] += 1
                cur_len = right - left + 1
                if cur_len > best:
                    best = cur_len
        return best
```

