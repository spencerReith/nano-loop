class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        best = 0
        left = 0
        freq = [0] * 501
        pair_sum = [0] * 1001
        
        for right in range(n):
            x = nums[right]
            while True:
                cond1 = (pair_sum[x] == 0)
                cond2 = True
                for v in range(1, 501):
                    if freq[v] > 0:
                        s = x + v
                        if s <= 500 and freq[s] > 0:
                            cond2 = False
                            break
                if cond1 and cond2:
                    break
                y = nums[left]
                for v in range(1, 501):
                    if freq[v] > 0:
                        if v != y:
                            pair_sum[y + v] -= freq[v]
                        else:
                            pair_sum[2 * y] -= (freq[y] - 1)
                freq[y] -= 1
                left += 1
            
            for v in range(1, 501):
                if freq[v] > 0:
                    s = v + x
                    pair_sum[s] += freq[v]
            freq[x] += 1
            
            cur_len = right - left + 1
            if cur_len > best:
                best = cur_len
                
        return best
```

