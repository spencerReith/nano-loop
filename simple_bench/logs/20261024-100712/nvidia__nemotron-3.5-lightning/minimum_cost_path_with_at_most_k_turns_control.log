class Solution:
    def minCost(self, grid: list[list[int]], k: int) -> int:
        m, n = len(grid), len(grid[0])
        # If start is the destination, cost is just grid[0][0] (0 turns needed).
        if m == 1 and n == 1:
            return grid[0][0]
        # k must be at least 1 to leave start and go somewhere; with k=0 impossible if not 1x1.
        if k == 0:
            return -1

        # directions: up, down, left, right
        dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]

        # dist[r][c][d][t] = minimum cost to reach (r,c) moving in direction d with t turns used.
        # d in 0..3, t in 0..k
        INF = 10**15
        dist = [[[[INF] * (k + 1) for _ in range(4)] for _ in range(n)] for _ in range(m)]

        # Initialise from (0,0) to its four possible first moves.
        # The first move has 0 turns used; cost includes start cell + next cell.
        for d, (dx, dy) in enumerate(dirs):
            nx, ny = 0 + dx, 0 + dy
            if 0 <= nx < m and 0 <= ny < n:
                cost = grid[0][0] + grid[nx][ny]
                dist[nx][ny][d][0] = cost

        # Priority queue: (cost, r, c, dir, turns)
        import heapq
        pq = []
        for d in range(4):
            for t in range(k + 1):
                if dist[0][0][d][t] < INF:  # actually only t=0 is set, but safe
                    heapq.heappush(pq, (dist[0][0][d][t], 0, 0, d, t))
        # However we only pushed initial moves from (0,0) above; to avoid duplicate pushes we just push the starts we set.
        # Let's redo init more cleanly:

        # Clear and reinitialize pq with only valid starts
        # We'll just push the states we set.
        pq = []
        for d, (dx, dy) in enumerate(dirs):
            nx, ny = 0 + dx, 0 + dy
            if 0 <= nx < m and 0 <= ny < n:
                cost = grid[0][0] + grid[nx][ny]
                if cost < dist[nx][ny][d][0]:
                    dist[nx][ny][d][0] = cost
                    heapq.heappush(pq, (cost, nx, ny, d, 0))

        ans = INF

        while pq:
            cost, r, c, d, t = heapq.heappop(pq)
            if cost != dist[r][c][d][t]:
                continue

            # If we are at destination, we can consider this cost as candidate answer.
            if r == m - 1 and c == n - 1:
                # Since we use Dijkstra, the first time we pop the destination we have the minimal cost
                # for any (t <= k). But we must ensure we don't return prematurely if a path with fewer turns
                # could be better? Actually Dijkstra pops in increasing cost order, so first pop of dest is global min.
                return cost

            # Explore neighbours
            for nd, (dx, dy) in enumerate(dirs):
                nr, nc = r + dx, c + dy
                if 0 <= nr < m and 0 <= nc < n:
                    nt = t + (1 if nd != d else 0)
                    if nt > k:
                        continue
                    ncost = cost + grid[nr][nc]
                    if ncost < dist[nr][nc][nd][nt]:
                        dist[nr][nc][nd][nt] = ncost
                        heapq.heappush(pq, (ncost, nr, nc, nd, nt))

        return -1
