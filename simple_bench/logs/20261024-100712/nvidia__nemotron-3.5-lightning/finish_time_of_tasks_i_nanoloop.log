class Solution:
    def finishTime(self, n: int, edges: list[list[int]], baseTime: list[int]) -> int:
        children = [[] for _ in range(n)]
        for u, v in edges:
            children[u].append(v)

        def dfs(u: int) -> int:
            if not children[u]:
                return baseTime[u]
            child_times = [dfs(v) for v in children[u]]
            earliest = min(child_times)
            latest = max(child_times)
            ownDuration = (latest - earliest) + baseTime[u]
            return latest + ownDuration

        return dfs(0)
