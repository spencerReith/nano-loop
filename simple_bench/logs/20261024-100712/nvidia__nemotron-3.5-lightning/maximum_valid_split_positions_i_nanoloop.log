```python
from math import gcd
from typing import List

class Solution:
    def maxValidSplits(self, nums: List[int]) -> int:
        n = len(nums)
        # Without removing any element
        best = 0
        # Compute prefix and suffix gcds for original array
        pref = [0] * n
        cur = 0
        for i in range(n):
            cur = gcd(cur, nums[i])
            pref[i] = cur
        suff = [0] * n
        cur = 0
        for i in range(n - 1, -1, -1):
            cur = gcd(cur, nums[i])
            suff[i] = cur
        for i in range(n - 1):
            if pref[i] == suff[i + 1]:
                best += 1
        
        # Try removing each element j
        for j in range(n):
            # Build array without j
            arr = nums[:j] + nums[j+1:]
            m = len(arr)
            if m < 2:
                continue
            # Prefix gcds for arr
            pref2 = [0] * m
            cur2 = 0
            for i in range(m):
                cur2 = gcd(cur2, arr[i])
                pref2[i] = cur2
            # Suffix gcds for arr
            suff2 = [0] * m
            cur2 = 0
            for i in range(m - 1, -1, -1):
                cur2 = gcd(cur2, arr[i])
                suff2[i] = cur2
            # Count valid split positions
            score = 0
            for i in range(m - 1):
                if pref2[i] == suff2[i + 1]:
                    score += 1
            if score > best:
                best = score
        
        return best
