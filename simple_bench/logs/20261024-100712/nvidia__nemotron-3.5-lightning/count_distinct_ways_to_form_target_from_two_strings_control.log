```python
class Solution:
    def interleaveCharacters(self, word1: str, word2: str, target: str) -> int:
        n1, n2, nt = len(word1), len(word2), len(target)
        MOD = 10**9 + 7

        # Helper to count ways to form target as a subsequence of a single string S.
        def count_subseq(S: str, T: str) -> int:
            ns, nt = len(S), len(T)
            dp = [[0] * (nt + 1) for _ in range(ns + 1)]
            for i in range(ns + 1):
                dp[i][0] = 1
            for i in range(1, ns + 1):
                for k in range(1, nt + 1):
                    dp[i][k] = dp[i - 1][k]
                    if S[i - 1] == T[k - 1]:
                        dp[i][k] = (dp[i][k] + dp[i - 1][k - 1]) % MOD
            return dp[ns][nt]

        ways1 = count_subseq(word1, target)   # ways using only word1
        ways2 = count_subseq(word2, target)   # ways using only word2

        # dp[i][j][k][c] = number of ways to form target[:k] using word1[:i] and word2[:j],
        #                   with the k-th character taken from string c (0 = word1, 1 = word2).
        # We compute total ways without the "at least one from both" constraint,
        # then subtract ways1 and ways2.
        dp = [[[[0] * 2 for _ in range(nt + 1)] for __ in range(n2 + 1)] for ___ in range(n1 + 1)]

        # Base: k = 1 (first character of target)
        for i in range(1, n1 + 1):
            for j in range(n2 + 1):
                if word1[i - 1] == target[0]:
                    dp[i][j][1][0] = 1
                if j > 0 and word2[j - 1] == target[0]:
                    dp[i][j][1][1] = 1

        # Recurrence for k >= 2
        for k in range(2, nt + 1):
            for i in range(1, n1 + 1):
                for j in range(n2 + 1):
                    # Take k-th character from word1
                    if word1[i - 1] == target[k - 1]:
                        dp[i][j][k][0] = (dp[i - 1][j][k][0] + dp[i - 1][j][k - 1][1]) % MOD
                    # Take k-th character from word2
                    if j > 0 and word2[j - 1] == target[k - 1]:
                        dp[i][j][k][1] = (dp[i][j - 1][k][1] + dp[i][j - 1][k - 1][0]) % MOD

        total_ways = (dp[n1][n2][nt][0] + dp[n1][n2][nt][1]) % MOD
        ans = (total_ways - ways1 - ways2) % MOD
        return ans if ans >= 0 else ans + MOD
