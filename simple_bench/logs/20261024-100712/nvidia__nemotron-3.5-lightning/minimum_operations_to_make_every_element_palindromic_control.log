class Solution:
    def minOperations(self, nums: list[int]) -> int:
        # helper: minimum operations to turn n into a palindrome (non-negative integer)
        def min_ops_to_palindrome(n: int) -> int:
            if n < 10:
                # single digit numbers are already palindromes and positive
                return 0
            s = str(n)
            # candidate palindromes generated from the left half
            L = len(s)
            # generate lower and upper bound palindromes based on the first half
            def generate_pal(prefix: str) -> int:
                # mirror to form palindrome
                if L % 2 == 0:
                    return int(prefix + prefix[::-1])
                else:
                    return int(prefix + prefix[:-1][::-1])
            
            # prefix is the left part including the middle digit if odd length
            prefix = s[:(L + 1) // 2]
            
            # three candidates: unchanged prefix, prefix-1, prefix+1
            candidates = set()
            for p in (prefix, str(int(prefix) - 1), str(int(prefix) + 1)):
                if p and int(p) > 0:  # ensure positive palindrome (no leading zero -> 0 not allowed)
                    candidates.add(generate_pal(p))
            
            # also consider the nearest powers of 10 boundaries (e.g., 9, 99, 100... etc.)
            # generating palindrome of length L-1 (all 9's) and L+1 (10...01)
            if L > 1:
                candidates.add(10**(L-1) - 1)   # e.g., 9, 99, 999 ...
            candidates.add(10**L + 1)           # e.g., 101, 1001 ...
            
            # filter to positive palindromes only ( > 0 )
            best = None
            for cand in candidates:
                if cand > 0:
                    diff = abs(n - cand)
                    ops = diff // 2
                    if best is None or ops < best:
                        best = ops
            return best if best is not None else 0
        
        total = 0
        for x in nums:
            total += min_ops_to_palindrome(x)
        return total
