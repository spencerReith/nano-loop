class Solution:
    def maxPrimeSubset(self, n: int, s: int) -> list[int]:
        # generate primes <= n
        primes = []
        for x in range(2, n + 1):
            is_prime = True
            for d in range(2, int(x ** 0.5) + 1):
                if x % d == 0:
                    is_prime = False
                    break
            if is_prime:
                primes.append(x)

        best_sum = -1
        best_len = float('inf')
        best_subset = []

        # enumerate all subsets via bitmask
        m = len(primes)
        for mask in range(1, 1 << m):
            total = 0
            subset = []
            for i in range(m):
                if mask & (1 << i):
                    total += primes[i]
                    subset.append(primes[i])
            if total > s:
                continue
            # compare
            if total > best_sum:
                best_sum = total
                best_len = len(subset)
                best_subset = subset[:]
            elif total == best_sum:
                if len(subset) < best_len:
                    best_len = len(subset)
                    best_subset = subset[:]
                elif len(subset) == best_len:
                    # lexicographic compare
                    if subset < best_subset:
                        best_subset = subset[:]

        return best_subset
