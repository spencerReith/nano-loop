class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        from collections import Counter

        cnt = Counter(planks)
        # get unique heights sorted descending
        heights = sorted(cnt.keys(), reverse=True)
        
        ans = 1  # at least one plank can be used
        
        for target in heights:
            # we have cnt[target] original planks of this height
            pieces = cnt[target]
            # try to combine smaller planks to form more pieces of 'target'
            # we iterate over smaller heights in increasing order
            for h in heights:
                if h >= target:
                    break
                if h not in cnt:
                    continue
                # how many pairs of (h, target - h) can we form?
                comp = target - h
                if comp not in cnt:
                    continue
                if h == comp:
                    # pairs within the same height
                    pairs = cnt[h] // 2
                else:
                    pairs = min(cnt[h], cnt[comp])
                if pairs:
                    pieces += pairs
                    # update the counts of the used smaller planks
                    if h == comp:
                        cnt[h] -= 2 * pairs
                    else:
                        cnt[h] -= pairs
                        cnt[comp] -= pairs
            ans = max(ans, pieces)
        
        return ans
