class Solution:
    def findDisappearedNumbers(self, nums: list[int], lower: int, upper: int) -> list[list[int]]:
        nums_set = set(nums)
        result = []
        start = None
        for i in range(lower, upper + 1):
            if i not in nums_set:
                if start is None:
                    start = i
            else:
                if start is not None:
                    result.append([start, i - 1])
                    start = None
        if start is not None:
            result.append([start, upper])
        return result
