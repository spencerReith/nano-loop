```python
from typing import List

class Solution:
    def maxArea(self, mat: List[List[int]]) -> int:
        m = len(mat)
        n = len(mat[0])
        
        # dp[i][j] = side length of largest square of 1s ending at (i-1, j-1)
        dp = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(1, m + 1):
            for j in range(1, n + 1):
                if mat[i-1][j-1] == 1:
                    dp[i][j] = 1 + min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1])
        
        # prefixMax[i][j] = largest square side entirely within rows 0..i-1 and cols 0..j-1
        prefixMax = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(1, m + 1):
            for j in range(1, n + 1):
                prefixMax[i][j] = max(prefixMax[i-1][j], prefixMax[i][j-1], dp[i][j])
        
        # suffixMax[i][j] = largest square side entirely within rows i..m-1 and cols j..n-1
        # We compute it by reversing the matrix logic.
        revMat = [[mat[m-1-i][n-1-j] for j in range(n)] for i in range(m)]
        # Now compute prefixMax on revMat
        dpRev = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(1, m + 1):
            for j in range(1, n + 1):
                if revMat[i-1][j-1] == 1:
                    dpRev[i][j] = 1 + min(dpRev[i-1][j], dpRev[i][j-1], dpRev[i-1][j-1])
        prefixMaxRev = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(1, m + 1):
            for j in range(1, n + 1):
                prefixMaxRev[i][j] = max(prefixMaxRev[i-1][j], prefixMaxRev[i][j-1], dpRev[i][j])
        # suffixMax[i][j] = prefixMaxRev[m-i][n-j]
        suffixMax = [[0] * (n + 1) for _ in range(m + 1)]
        for i in range(m + 1):
            for j in range(n + 1):
                suffixMax[i][j] = prefixMaxRev[m-i][n-j] if i <= m and j <= n else 0
        
        ans = 0
        
        # Horizontal splits: split after row i (top rows 0..i-1, bottom rows i..m-1)
        for i in range(m + 1):
            topMax = prefixMax[i][n]
            bottomMax = suffixMax[i][0]
            equal = min(topMax, bottomMax)
            if equal > 0:
                ans = max(ans, equal * equal)
        
        # Vertical splits: split after col j (left cols 0..j-1, right cols j..n-1)
        for j in range(n + 1):
            leftMax = prefixMax[m][j]
            rightMax = suffixMax[0][j]
            equal = min(leftMax, rightMax)
            if equal > 0:
                ans = max(ans, equal * equal)
        
        return ans
