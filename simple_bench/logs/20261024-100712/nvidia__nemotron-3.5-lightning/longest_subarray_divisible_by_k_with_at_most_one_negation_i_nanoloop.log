class Solution:
    def longestSubarray(self, nums: list[int], k: int) -> int:
        n = len(nums)
        # Prefix sums for O(1) subarray sum queries
        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]

        best = 0
        # Check every subarray nums[i:j] (i inclusive, j exclusive)
        for i in range(n):
            for j in range(i + 1, n + 1):
                sub_sum = pref[j] - pref[i]
                # Condition 1: sum already divisible by k
                if sub_sum % k == 0:
                    best = max(best, j - i)
                    continue
                # Condition 2: negating one element x makes sum divisible
                # i.e., (sub_sum - 2*x) % k == 0  <=>  sub_sum % k == (2*x) % k
                target = sub_sum % k
                for idx in range(i, j):
                    x = nums[idx]
                    if (2 * x) % k == target:
                        best = max(best, j - i)
                        break

        return best
