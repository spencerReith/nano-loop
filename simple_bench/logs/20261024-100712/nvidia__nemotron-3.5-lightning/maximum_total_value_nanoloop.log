from typing import List
import heapq

class Solution:
    def maxTotalValue(self, value: List[int], decay: List[int], m: int) -> int:
        MOD = 10**9 + 7
        n = len(value)
        heap = []
        for i in range(n):
            heapq.heappush(heap, (-value[i], i, decay[i]))
        
        total = 0
        picks = [0] * n
        
        for _ in range(m):
            if not heap:
                break
            neg_val, i, dec = heapq.heappop(heap)
            cur = -neg_val
            total = (total + cur) % MOD
            picks[i] += 1
            next_val = value[i] - dec * picks[i]
            if next_val > 0:
                heapq.heappush(heap, (-next_val, i, dec))
        
        return total % MOD
