class Solution:
    def minOperations(self, s: str) -> int:
        n = len(s)
        # Duplicate the string to easily handle cyclic shifts
        ss = s + s  # length 2n
        # Prefix sums of increments needed for each adjacent pair in ss
        # inc[i] = operations to make ss[i] and ss[i+1] equal (circularly)
        inc = [0] * (2 * n)
        for i in range(2 * n - 1):
            diff = (ord(ss[i + 1]) - ord(ss[i])) % 26
            inc[i + 1] = diff
        # prefix sum of inc, pref[k] = sum_{i=0}^{k-1} inc[i]
        pref = [0] * (2 * n + 1)
        for i in range(2 * n):
            pref[i + 1] = pref[i] + inc[i]

        ans = float('inf')
        # Try every left rotation k (0 .. n-1)
        for k in range(n):
            # sum of increments for pairs completely inside the rotated string
            # rotated string = ss[k : k+n]
            # pairs: (k, k+1), (k+1, k+2), ..., (k+n-2, k+n-1)
            sum_inc = pref[k + n - 1] - pref[k]
            # Now we have a linear string of length n starting at k.
            # We may also change the last character to match the first,
            # which costs (first - last) % 26.
            first = ord(ss[k]) - 97
            last = ord(ss[k + n - 1]) - 97
            last_to_first = (first - last) % 26
            total = sum_inc + last_to_first
            if total < ans:
                ans = total
        return ans
