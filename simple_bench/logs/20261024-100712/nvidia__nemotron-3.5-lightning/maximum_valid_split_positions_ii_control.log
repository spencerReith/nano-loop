```python
import math
from typing import List

class Solution:
    def maxValidSplits(self, nums: List[int]) -> int:
        n = len(nums)
        if n == 2:
            # Only possible splits are i=0 in arr of length 2 (if no removal) or length 1 (score 0).
            # Without removal: arr=[nums[0], nums[1]], split i=0: gcd(nums[0]) vs gcd(nums[1]).
            # Return 1 if equal else 0.
            return 1 if math.gcd(nums[0], nums[1]) == nums[0] == nums[1]? Wait, gcd(a) = a.
            # Actually gcd(arr[0..0]) = nums[0], gcd(arr[1..1]) = nums[1].
            # Valid if nums[0] == nums[1].
            # But we can also remove one element, giving arr length 1, score 0.
            # So max is 1 if nums[0]==nums[1] else 0.
            # But wait, example 3: [2,4] output 0. [10,10] would output 1?
            # Constraints: 2 <= nums.length. Example 3: [2,4] -> 0.
            # Let's just compute generally.
            pass

        # Build sparse table for range gcd
        log2 = [0] * (n + 1)
        for i in range(2, n + 1):
            log2[i] = log2[i // 2] + 1
        K = log2[n] + 1
        st = [[0] * n for _ in range(K)]
        for i in range(n):
            st[0][i] = nums[i]
        for j in range(1, K):
            step = 1 << (j - 1)
            for i in range(n - (1 << j) + 1):
                st[j][i] = math.gcd(st[j-1][i], st[j-1][i + step])

        def query_gcd(l: int, r: int) -> int:
            if l > r:
                return 0
            length = r - l + 1
            j = log2[length]
            return math.gcd(st[j][l], st[j][r - (1 << j) + 1])

        # Function to compute score when removing index k
        def score_with_removal(k: int) -> int:
            m = n - 1  # length of virtual array
            if m <= 1:
                return 0  # no valid split positions
            cnt = 0
            # valid split positions i: 0 <= i < m - 1  i.e., 0 <= i <= n - 3
            for i in range(m - 1):
                # compute left_gcd = gcd(arr[0..i])
                # compute right_gcd = gcd(arr[i+1..m-1])
                if i < k:
                    # left part: arr[0..i] = nums[0..i]
                    left = query_gcd(0, i)
                    # right part: arr[i+1..m-1]
                    # Since i < k, i+1 <= k.
                    # The right part original indices: nums[i+1 .. k-1] and nums[k+1 .. n-1]
                    # (if k = n-1, nums[k+1 .. n-1] is empty)
                    right = query_gcd(i + 1, k - 1) if i + 1 <= k - 1 else 0
                    if k < n - 1:
                        right = math.gcd(right, query_gcd(k + 1, n - 1))
                    # if k == n-1, right = query_gcd(i+1, n-2) but k-1 = n-2, so right = query_gcd(i+1, n-2)
                    # our formula with k < n-1 false, so right stays as query_gcd(i+1, k-1) = query_gcd(i+1, n-2). Correct.
                else:
                    # i >= k
                    # left part: arr[0..i] = nums[0..k-1] + nums[k+1..i+1]
                    left = query_gcd(0, k - 1) if k > 0 else 0
                    if k + 1 <= i + 1:
                        left = math.gcd(left, query_gcd(k + 1, i + 1))
                    # right part: arr[i+1..m-1]
                    # Since i >= k, i+1 >= k+1.
                    # arr[i+1] = nums[i+2], and goes to arr[m-1] = nums[n-1] (if k < n-1) or nums[n-2] (if k = n-1, but i >= n-1 impossible).
                    # So right part original indices: nums[i+2 .. n-1]
                    right = query_gcd(i + 2, n - 1)
                if left == right:
                    cnt += 1
            return cnt

        # Compute score without removal
        # We can just use the same logic with k = -1 (no removal) or compute directly.
        # Let's compute without removal separately for clarity, or we can just try k = -1 in the function
        # by adjusting indices. Easier: compute directly.
        # Without removal: arr = nums, m = n.
        # valid i: 0 <= i < n - 1
        # left = query_gcd(0, i), right = query_gcd(i+1, n-1)
        # We can just loop i from 0 to n-2.
        ans = 0
        for i in range(n - 1):
            if query_gcd(0, i) == query_gcd(i + 1, n - 1):
                ans += 1

        # Try removing each element
        # Early exit if ans already maximum possible (n-2, since m=n-1, max splits n-2)
        if ans == n - 2:
            return ans

        for k in range(n):
            # small optimization: if current best is already n-2, break
            if ans == n - 2:
                break
            sc = score_with_removal(k)
            if sc > ans:
                ans = sc
                if ans == n - 2:
                    break

        return ans
