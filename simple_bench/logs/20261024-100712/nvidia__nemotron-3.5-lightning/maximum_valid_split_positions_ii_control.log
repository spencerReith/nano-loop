import math
from typing import List

class Solution:
    def maxValidSplits(self, nums: List[int]) -> int:
        n = len(nums)
        # n == 2: only one split position possible without removal.
        # With removal the array length becomes 1 (score 0).
        if n == 2:
            return 1 if nums[0] == nums[1] else 0

        # ---------- sparse table for O(1) range gcd ----------
        log2 = [0] * (n + 1)
        for i in range(2, n + 1):
            log2[i] = log2[i // 2] + 1
        K = log2[n] + 1
        st = [[0] * n for _ in range(K)]
        for i in range(n):
            st[0][i] = nums[i]
        for j in range(1, K):
            step = 1 << (j - 1)
            for i in range(n - (1 << j) + 1):
                st[j][i] = math.gcd(st[j - 1][i], st[j - 1][i + step])

        def query_gcd(l: int, r: int) -> int:
            if l > r:
                return 0
            length = r - l + 1
            j = log2[length]
            return math.gcd(st[j][l], st[j][r - (1 << j) + 1])

        # ---------- score without removing any element ----------
        ans = 0
        for i in range(n - 1):
            if query_gcd(0, i) == query_gcd(i + 1, n - 1):
                ans += 1
        # maximum possible without removal is n-1
        if ans == n - 1:
            return ans

        # ---------- try removing exactly one element ----------
        # with one removal the virtual array length is m = n-1,
        # valid split positions i satisfy 0 <= i < m-1  =>  i in [0, n-3]
        # the absolute maximum score with one removal is n-2
        for k in range(n):
            if ans == n - 2:          # cannot be improved further
                break
            m = n - 1
            if m <= 1:
                continue
            cnt = 0
            for i in range(m - 1):          # i = 0 .. n-3
                if i < k:
                    left = query_gcd(0, i)
                    right = query_gcd(i + 1, k - 1) if i + 1 <= k - 1 else 0
                    if k < n - 1:
                        right = math.gcd(right, query_gcd(k + 1, n - 1))
                    # when k == n-1 the block above is skipped,
                    # and right stays as query_gcd(i+1, n-2)
                else:  # i >= k
                    left = query_gcd(0, k - 1) if k > 0 else 0
                    if k + 1 <= i + 1:
                        left = math.gcd(left, query_gcd(k + 1, i + 1))
                    right = query_gcd(i + 2, n - 1)
                if left == right:
                    cnt += 1
            if cnt > ans:
                ans = cnt
                if ans == n - 2:
                    break

        return ans
```
