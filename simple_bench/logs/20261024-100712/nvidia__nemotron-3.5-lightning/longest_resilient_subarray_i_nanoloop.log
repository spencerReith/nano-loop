```python
from typing import List
import math

class Solution:
    def resilientSubarray(self, nums: List[int], k: int) -> int:
        n = len(nums)
        max_len = 1  # at least 1 since single element always works

        # Find all unique remainders
        remainders = set(num % k for num in nums)

        for rem in remainders:
            # Find contiguous segments where nums[i] % k == rem
            start = 0
            while start < n and nums[start] % k != rem:
                start += 1
            seg = start
            while seg < n:
                # process segment from start to seg-1 if nums[seg] % k != rem
                if nums[seg] % k != rem:
                    L = seg - start
                    if L > 0:
                        if rem == 0:
                            max_len = max(max_len, L)
                        else:
                            g = math.gcd(rem, k)
                            period = k // g
                            # max m <= L with m ≡ 1 (mod period)
                            # valid m are 1, 1+period, 1+2*period, ...
                            # largest such m ≤ L is: 1 + ((L - 1) // period) * period
                            m = 1 + ((L - 1) // period) * period
                            max_len = max(max_len, m)
                    start = seg + 1
                seg += 1
            # process last segment from start to n-1
            L = n - start
            if L > 0:
                if rem == 0:
                    max_len = max(max_len, L)
                else:
                    g = math.gcd(rem, k)
                    period = k // g
                    m = 1 + ((L - 1) // period) * period
                    max_len = max(max_len, m)

        return max_len
