from typing import List
import bisect

class Solution:
    def distantSubarrays(self, nums: List[int], goal: int, k: int) -> int:
        n = len(nums)
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + nums[i]
        
        total_subarrays = n * (n + 1) // 2
        
        # Count subarrays where |sum - goal| < k, then subtract from total.
        # |sum - goal| < k  <=>  goal - k < sum < goal + k
        # With prefix sums: goal - k < prefix[j] - prefix[i] < goal + k
        # => prefix[j] - goal - k < prefix[i] < prefix[j] - goal + k
        # For each j, count i < j with prefix[i] in (L, R) exclusive, where L = prefix[j] - goal - k, R = prefix[j] - goal + k.
        
        vals = set()
        for p in prefix:
            vals.add(p)
        for j in range(1, n + 1):
            pj = prefix[j]
            vals.add(pj - goal - k)
            vals.add(pj - goal + k - 1)
        
        sorted_vals = sorted(vals)
        comp = {v: i + 1 for i, v in enumerate(sorted_vals)}
        m = len(sorted_vals)
        
        bit = [0] * (m + 2)
        
        def bit_add(idx, delta):
            while idx <= m:
                bit[idx] += delta
                idx += idx & -idx
        
        def bit_query(idx):
            s = 0
            while idx > 0:
                s += bit[idx]
                idx -= idx & -idx
            return s
        
        close_count = 0
        # Insert prefix[0] = 0
        bit_add(comp[prefix[0]], 1)
        
        for j in range(1, n + 1):
            pj = prefix[j]
            L = pj - goal - k
            R = pj - goal + k
            # Count prefix[i] with L < prefix[i] < R  <=  count <= R-1  -  count <= L
            cnt_Rm1 = bit_query(bisect.bisect_right(sorted_vals, R - 1))
            cnt_L = bit_query(bisect.bisect_right(sorted_vals, L))
            close_count += cnt_Rm1 - cnt_L
            
            bit_add(comp[pj], 1)
        
        return total_subarrays - close_count
