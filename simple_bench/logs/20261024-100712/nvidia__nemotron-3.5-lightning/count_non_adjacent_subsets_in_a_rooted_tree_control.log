class Solution:
    def countValidSubsets(self, parent: list[int], nums: list[int], k: int) -> int:
        MOD = 10**9 + 7
        n = len(parent)

        # build children list
        children = [[] for _ in range(n)]
        root = -1
        for i, p in enumerate(parent):
            if p == -1:
                root = i
            else:
                children[p].append(i)

        # dp[u][0] = ways for subtree of u, u is NOT taken (mod k remainders)
        # dp[u][1] = ways for subtree of u, u IS taken (mod k remainders)
        dp0 = [[0] * k for _ in range(n)]
        dp1 = [[0] * k for _ in range(n)]

        # post-order traversal (iterative)
        order = []
        stack = [root]
        parent_vis = [-1] * n
        while stack:
            u = stack.pop()
            order.append(u)
            for v in children[u]:
                stack.append(v)
        # reverse to get children before parents
        order.reverse()

        for u in order:
            # start with base cases for node u alone
            # dp0[u] : u not taken, initially empty product = 1 way with sum 0
            cur0 = [0] * k
            cur0[0] = 1
            # dp1[u] : u taken, initially just the node itself
            val_mod = nums[u] % k
            cur1 = [0] * k
            cur1[val_mod] = 1

            # combine children
            for v in children[u]:
                # we have already computed dp0[v] and dp1[v]
                # new cur0 = cur0 * (dp0[v] + dp1[v])  (u not taken, child can be either)
                # new cur1 = cur1 * dp0[v]               (u taken, child MUST NOT be taken)
                new0 = [0] * k
                new1 = [0] * k
                for r1 in range(k):
                    if cur0[r1] == 0 and cur1[r1] == 0:
                        continue
                    for r2 in range(k):
                        c0 = dp0[v][r2]
                        c1 = dp1[v][r2]
                        if c0 == 0 and c1 == 0:
                            continue
                        # combine cur0 with (dp0[v] + dp1[v])
                        # case: cur0[r1] * (c0 + c1) -> new0[(r1+r2)%k]
                        ways = (c0 + c1) % MOD
                        if ways:
                            nr = (r1 + r2) % k
                            new0[nr] = (new0[nr] + cur0[r1] * ways) % MOD
                        # case: cur1[r1] * c0 -> new1[(r1+r2)%k]  (child not taken)
                        if c0:
                            nr = (r1 + r2) % k
                            new1[nr] = (new1[nr] + cur1[r1] * c0) % MOD
                cur0, cur1 = new0, new1

            dp0[u] = cur0
            dp1[u] = cur1

        # answer: subsets with sum % k == 0, non-empty.
        # subsets where root is not taken: dp0[root][0] includes empty subset (sum 0)
        # subsets where root is taken: dp1[root][0] (non-empty because root taken)
        ans = (dp0[root][0] + dp1[root][0]) % MOD
        # subtract the empty subset counted in dp0[root][0]
        ans = (ans - 1) % MOD
        return ans
