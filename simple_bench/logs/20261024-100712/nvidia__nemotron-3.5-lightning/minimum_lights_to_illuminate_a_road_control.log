def minLights(self, lights: list[int]) -> int:
    n = len(lights)
    diff = [0] * (n + 1)
    for i, v in enumerate(lights):
        if v > 0:
            L = max(0, i - v)
            R = min(n - 1, i + v)
            diff[L] += 1
            if R + 1 < n:
                diff[R + 1] -= 1
    covered = [False] * n
    cur = 0
    for j in range(n):
        cur += diff[j]
        covered[j] = (cur > 0)
    count = 0
    i = 0
    while i < n:
        if covered[i]:
            i += 1
            continue
        # place extra bulb
        pos = i + 1 if i + 1 < n else i
        left = max(0, pos - 1)
        right = min(n - 1, pos + 1)
        for j in range(left, right + 1):
            covered[j] = True
        count += 1
        # loop will check covered[i] again, which is now True, so i will increment
    return count

