```python
class Solution:
    def minSelection(self, availableIntervals, targetIntervals):
        # merge targets
        t = sorted(targetIntervals)
        comps = []
        for l, r in t:
            if comps and l <= comps[-1][1]:
                comps[-1][1] = max(comps[-1][1], r)
            else:
                comps.append([l, r])
        a = sorted(availableIntervals)
        n = len(a)
        i = 0
        count = 0
        covered = -1  # use 0 since coords >= 1
        ci = 0
        m = len(comps)
        # skip components fully covered... initially none
        while ci < m:
            L, R = comps[ci]
            if covered >= R:
                ci += 1
                continue
            pos = max(L, covered)
            # gather max reach among start <= pos
            reach = covered  # current reach baseline
            while i < n and a[i][0] <= pos:
                if a[i][1] > reach:
                    reach = a[i][1]
                i += 1
            if reach <= pos:
                return -1
            count += 1
            covered = reach
        return count
```

