The algorithm:
1. Merge overlapping target intervals into disjoint components (sorted)
2. Sweep through with a pointer into sorted available intervals: at each uncovered point `pos`, consider all intervals with `start <= pos`, pick the max reach. If nothing extends past `pos`, return -1
3. Components fully covered by a previous selection are skipped (handles intervals spanning gaps)

Time complexity: O(n log n + m log m) for sorting, then a linear sweep — well within limits for 5×10⁴.

```python
class Solution:
    def minSelection(self, availableIntervals: list[list[int]], targetIntervals: list[list[int]]) -> int:
        # Merge overlapping/touching target intervals into disjoint components
        comps = []
        for l, r in sorted(targetIntervals):
            if comps and l <= comps[-1][1]:
                if r > comps[-1][1]:
                    comps[-1][1] = r
            else:
                comps.append([l, r])

        avail = sorted(availableIntervals)
        n = len(avail)
        i = 0          # pointer into avail
        count = 0
        covered = 0    # everything <= covered is covered (coords >= 1)
        ci = 0
        m = len(comps)

        while ci < m:
            L, R = comps[ci]
            if covered >= R:        # this component already fully covered
                ci += 1
                continue
            pos = max(L, covered)   # next point that must be coverable
            reach = covered
            while i < n and avail[i][0] <= pos:
                if avail[i][1] > reach:
                    reach = avail[i][1]
                i += 1
            if reach <= pos:        # no interval can extend coverage past pos
                return -1
            count += 1
            covered = reach

        return count
```
