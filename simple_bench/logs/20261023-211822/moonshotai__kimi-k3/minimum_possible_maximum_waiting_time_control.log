Let's decide final code style:
```
class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        f0, f1 = fuel
        n = len(demand)
        pref = [0] * (n + 1)
        for i, d in enumerate(demand, 1):
            pref[i] = pref[i-1] + d

        reachable = {0}
        served = n
        for i, d in enumerate(demand):
            nt = pref[i+1]
            nxt = set()
            for x in reachable:
                y = x + d
                if y <= f0 and nt - y <= f1:
                    nxt.add(y)
                if x <= f0 and nt - x <= f1:
                    nxt.add(x)
            if not nxt:
                served = i
                break
            reachable = nxt
        if served == 0:
            return -1

        limit = max(demand[:served])
        d0 = demand[0]
        for W in range(limit + 1):
            states = set()
            if d0 <= f0:
                states.add((d0, 0, 0))
            if d0 <= f1:
                states.add((0, 1, 0))
            for i in range(1, served):
                prev = demand[i-1]
                cur = demand[i]
                nt = pref[i+1]
                nxt = set()
                for x, last, off in states:
                    # use dispenser 0
                    nx = x + cur
                    if nx <= f0 and nt - nx <= f1:
                        if last == 0:
                            w = prev
                            no = off - prev if off > prev else 0
                        else:
                            w = off
                            no = prev - off if prev > off else 0
                        if w <= W:
                            nxt.add((nx, 0, no))
                    # use dispenser 1
                    nx = x
                    if nx <= f0 and nt - nx <= f1:
                        if last == 1:
                            w = prev
                            no = off - prev if off > prev else 0
                        else:
                            w = off
                            no = prev - off if prev > off else 0
                        if w <= W:
                            nxt.add((nx, 1, no))
                states = nxt
                if not states:
                    break
            if states:
                return W
        return -1
```
