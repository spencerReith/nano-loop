Code direct:
```
class Solution:
    def minMaxWaitingTime(self, demand: list[int], fuel: list[int]) -> int:
        f0,f1=fuel
        n=len(demand)
        pref=[0]*(n+1)
        for i in range(n): pref[i+1]=pref[i]+demand[i]
        # max prefix that fits in the two fuel tanks
        reach={0}
        K=n
        for i,d in enumerate(demand):
            tot=pref[i+1]
            nxts=set()
            for x in reach:
                y=x+d
                if y<=f0 and tot-y<=f1: nxts.add(y)
                if x<=f0 and tot-x<=f1: nxts.add(x)
            if not nxts:
                K=i; break
            reach=nxts
        if K==0: return -1
        d0=demand[0]
        states={}
        if d0<=f0: states[(d0,0,0)]=0
        if d0<=f1: states[(0,1,0)]=0
        for i in range(1,K):
            prev=demand[i-1]; cur=demand[i]; tot=pref[i+1]
            nd={}
            for (x,last,off), best in states.items():
                # dispenser 0
                nx=x+cur
                if nx<=f0 and tot-nx<=f1:
                    if last==0:
                        w=prev
                        no=off-prev if off>prev else 0
                    else:
                        w=off
                        no=prev-off if prev>off else 0
                    val=best if best>=w else w
                    key=(nx,0,no)
                    if key not in nd or val<nd[key]: nd[key]=val
                # dispenser 1
                nx=x
                if nx<=f0 and tot-nx<=f1:
                    if last==1:
                        w=prev
                        no=off-prev if off>prev else 0
                    else:
                        w=off
                        no=prev-off if prev>off else 0
                    val=best if best>=w else w
                    key=(nx,1,no)
                    if key not in nd or val<nd[key]: nd[key]=val
            states=nd
            if not states: break
        return min(states.values()) if states else -1
```
Check direct transition value: `best` is minimal max waiting up to previous car. New max = max(best,w). We keep min per key. Good.

