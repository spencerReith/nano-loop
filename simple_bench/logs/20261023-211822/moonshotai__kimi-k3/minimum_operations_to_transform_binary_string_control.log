class Solution:
    def minOperations(self, s1: str, s2: str) -> int:
        n=len(s1)
        if n==1:
            if s1==s2: return 0
            if s1=="0" and s2=="1": return 1
            return -1
        add=0
        ans=0
        i=0
        while i<n:
            if s1[i]=='0' and s2[i]=='1':
                add+=1
                i+=1
            elif s1[i]=='1' and s2[i]=='0':
                j=i
                while j<n and s1[j]=='1' and s2[j]=='0':
                    j+=1
                L=j-i
                if L%2==0:
                    ans += L//2
                else:
                    ans += L//2 + 2
                i=j
            else:
                i+=1
        return ans+add

