class Solution:
    def minOperations(self, s1: str, s2: str) -> int:
        n = len(s1)

        if n == 1:
            if s1 == s2:
                return 0
            if s1 == "0" and s2 == "1":
                return 1
            return -1

        ops = 0
        i = 0

        while i < n:
            if s1[i] == '0' and s2[i] == '1':
                ops += 1
                i += 1
            elif s1[i] == '1' and s2[i] == '0':
                j = i
                while j < n and s1[j] == '1' and s2[j] == '0':
                    j += 1

                length = j - i
                ops += length // 2 + (0 if length % 2 == 0 else 2)
                i = j
            else:
                i += 1

        return ops
```
