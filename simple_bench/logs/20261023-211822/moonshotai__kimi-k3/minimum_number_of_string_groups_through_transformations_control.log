from collections import defaultdict

class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        groups = set()
        
        for word in words:
            # Separate even and odd indexed characters
            even_chars = word[::2]
            odd_chars = word[1::2]
            
            # Get canonical form of each cyclic sequence
            even_canonical = self._get_canonical(even_chars)
            odd_canonical = self._get_canonical(odd_chars)
            
            groups.add((even_canonical, odd_canonical))
        
        return len(groups)
    
    def _get_canonical(self, s: str) -> str:
        """Return lexicographically smallest rotation using Booth's algorithm."""
        if not s:
            return ""
        
        n = len(s)
        doubled = s + s
        i, j, k = 0, 1, 0
        
        while i < n and j < n and k < n:
            a = doubled[i + k]
            b = doubled[j + k]
            if a == b:
                k += 1
            elif a > b:
                i = i + k + 1
                if i <= j:
                    i = j + 1
                k = 0
            else:
                j = j + k + 1
                if j <= i:
                    j = i + 1
                k = 0
        
        start = min(i, j)
        return doubled[start:start + n]
