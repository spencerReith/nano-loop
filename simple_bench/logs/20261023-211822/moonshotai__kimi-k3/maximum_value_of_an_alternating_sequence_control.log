class Solution:
    def maximumValue(self, n: int, s: int, m: int) -> int:
        if n == 1:
            return s

        # Starting orientation is "down" iff n is even:
        #   seq = s, s+m, s, s+m, ...       (n even)
        #   seq = s, s-m, s, s+m, s, ...    (n odd)
        # Peak height at index 2k is s + (k+1)*m, at index 2k+1 is s + (k+1)*m.
        # There are two possible shapes; the best achievable max is:
        k = n // 2
        if n % 2 == 0:
            # length 2k: peaks s + k*m (odd indices), and possibly the last element
            return s + k * m
        else:
            # length 2k+1: last element can be s + (k+1)*m if we start by going down
            # (values must stay integers, no positivity constraint), or s + k*m otherwise.
            return s + (k + 1) * m
