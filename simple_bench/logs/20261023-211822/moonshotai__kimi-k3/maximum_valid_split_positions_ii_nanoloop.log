```python
from math import gcd

class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)
        
        # Sparse table for range GCD
        log = [0] * (n + 1)
        for i in range(2, n + 1):
            log[i] = log[i >> 1] + 1
        K = log[n] + 1
        st = [nums[:]]
        j = 1
        while (1 << j) <= n:
            prev = st[-1]
            cur = [0] * (n - (1 << j) + 1)
            half = 1 << (j - 1)
            for i in range(len(cur)):
                cur[i] = gcd(prev[i], prev[i + half])
            st.append(cur)
            j += 1
        
        def range_gcd(l, r):
            # gcd of nums[l..r] inclusive; returns 0 if l > r
            if l > r:
                return 0
            j = log[r - l + 1]
            row = st[j]
            return gcd(row[l], row[r - (1 << j) + 1])
        
        pre = [0] * n
        suf = [0] * (n + 1)  # suf[n] = 0
        pre[0] = nums[0]
        for i in range(1, n):
            pre[i] = gcd(pre[i-1], nums[i])
        suf[n-1] = nums[n-1]
        for i in range(n-2, -1, -1):
            suf[i] = gcd(suf[i+1], nums[i])
        
        def bs_first(P, lo, hi):
            # smallest i in [lo,hi] with P(i) True; P monotone False->True
            if lo > hi or not P(hi):
                return None
            while lo < hi:
                mid = (lo + hi) >> 1
                if P(mid):
                    hi = mid
                else:
                    lo = mid + 1
            return lo
        
        def bs_last(Q, lo, hi):
            # largest i in [lo,hi] with Q(i) True; Q monotone True->False
            if lo > hi or not Q(lo):
                return None
            while lo < hi:
                mid = (lo + hi + 1) >> 1
                if Q(mid):
                    lo = mid
                else:
                    hi = mid - 1
            return lo
        
        ans = 0
        
        # No removal
        cnt = 0
        for i in range(n - 1):
            if pre[i] == suf[i+1]:
                cnt += 1
        ans = cnt
        
        for k in range(n):
            score = 0
            pk1 = pre[k-1] if k > 0 else 0      # pre[k-1], 0 if k==0
            sk1 = suf[k+1] if k + 1 <= n else 0  # suf[k+1], suf[n]=0 when k=n-1
            # Actually suf has size n+1, suf[n]=0, so suf[k+1] works for k=n-1
            sk1 = suf[k+1]
            
            # Bridge: exists iff 1 <= k <= n-2
            if 1 <= k <= n - 2:
                if pre[k-1] == suf[k+1]:
                    score += 1
            
            # Category 1: i in [0, k-2]
            lo, hi = 0, k - 2
            if lo <= hi:
                def g(i, k=k, sk1=sk1):
                    return gcd(range_gcd(i + 1, k - 1), sk1)
                i1 = bs_first(lambda i: pre[i] <= g(i), lo, hi)
                i2 = bs_last(lambda i: pre[i] >= g(i), lo, hi)
                if i1 is not None and i2 is not None and i1 <= i2:
                    score += i2 - i1 + 1
            
            # Category 3: i in [k+1, n-2]
            lo, hi = k + 1, n - 2
            if lo <= hi:
                def f(i, k=k, pk1=pk1):
                    return gcd(pk1, range_gcd(k + 1, i))
                i1 = bs_first(lambda i: f(i) <= suf[i+1], lo, hi)
                i2 = bs_last(lambda i: f(i) >= suf[i+1], lo, hi)
                if i1 is not None and i2 is not None and i1 <= i2:
                    score += i2 - i1 + 1
            
            if score > ans:
                ans = score
        
        return ans
