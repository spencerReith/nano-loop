```python
import math
from math import gcd

class SparseTable:
    def __init__(self, arr):
        n = len(arr)
        self.log = [0] * (n + 1)
        for i in range(2, n + 1):
            self.log[i] = self.log[i // 2] + 1
        K = self.log[n] + 1
        self.st = [[0] * n for _ in range(K)]
        self.st[0] = arr[:]
        j = 1
        while (1 << j) <= n:
            i = 0
            while i + (1 << j) <= n:
                self.st[j][i] = gcd(self.st[j-1][i], self.st[j-1][i + (1 << (j-1))])
                i += 1
            j += 1
    
    def query(self, l, r):  # gcd of arr[l..r] inclusive
        if l > r:
            return 0
        j = self.log[r - l + 1]
        return gcd(self.st[j][l], self.st[j][r - (1 << j) + 1])

class Solution:
    def maxValidSplits(self, nums):
        n = len(nums)
        pre = [0] * n
        suf = [0] * (n + 1)
        pre[0] = nums[0]
        for i in range(1, n):
            pre[i] = gcd(pre[i-1], nums[i])
        suf[n-1] = nums[n-1]
        for i in range(n-2, -1, -1):
            suf[i] = gcd(suf[i+1], nums[i])
        suf[n] = 0  # identity
        
        st = SparseTable(nums)
        
        def range_gcd(l, r):
            if l > r:
                return 0
            return st.query(l, r)
        
        ans = 0
        
        # Case: no removal
        count = 0
        for i in range(n - 1):
            if pre[i] == suf[i+1]:
                count += 1
        ans = max(ans, count)
        
        # Case: remove element k
        for k in range(n):
            score = 0
            pk_1 = pre[k-1] if k > 0 else 0  # pre[k-1]
            sk_1 = suf[k+1] if k < n - 1 else 0  # suf[k+1], suf[n]=0
            
            # Category 2: bridge (k-1 split), exists iff 1 <= k <= n-2
            if 1 <= k <= n - 2:
                if pre[k-1] == suf[k+1]:
                    score += 1
            
            # Category 1: i in [0, k-2], also i <= n-3 (auto since k-2 <= n-3 when k <= n-1)
            lo, hi = 0, k - 2
            if lo <= hi:
                # g(i) = gcd(range_gcd(i+1, k-1), suf[k+1])
                def g(i):
                    return gcd(range_gcd(i+1, k-1), sk_1)
                # Find smallest i1 in [lo,hi] with pre[i1] <= g(i1)
                # Find largest i2 in [lo,hi] with pre[i2] >= g(i2)
                # pre non-increasing, g non-decreasing
                # Binary search for i1: first index where pre[i] <= g(i)
                i1 = self.bs_first_le(pre, g, lo, hi)
                i2 = self.bs_last_ge(pre, g, lo, hi)
                if i1 is not None and i2 is not None and i1 <= i2:
                    score += i2 - i1 + 1
            
            # Category 3: i in [k+1, n-2]
            lo, hi = k + 1, n - 2
            if lo <= hi:
                # f(i) = gcd(pre[k-1], range_gcd(k+1, i))
                def f(i):
                    return gcd(pk_1, range_gcd(k+1, i))
                # f non-increasing, suf[i+1] non-decreasing
                # Find smallest i1 with f(i1) <= suf[i1+1]
                # Find largest i2 with f(i2) >= suf[i2+1]
                i1 = self.bs_first_le2(f, suf, lo, hi)
                i2 = self.bs_last_ge2(f, suf, lo, hi)
                if i1 is not None and i2 is not None and i1 <= i2:
                    score += i2 - i1 + 1
            
            ans = max(ans, score)
        
        return ans
```

