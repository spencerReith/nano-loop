Let's craft final code:
```
class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        n=len(source)
        max_len=0
        for p,_ in rules:
            if len(p)>max_len: max_len=len(p)
        INF=10**18
        best=[[INF]*(max_len+1) for _ in range(n)]
        s=source; t=target
        for idx,(pat,rep) in enumerate(rules):
            L=len(pat)
            if L>n: continue
            cost=costs[idx] + pat.count('*')
            lim=n-L
            # optional store fixed positions? not needed
            for l in range(lim+1):
                ok=True
                # local vars for row
                for j in range(L):
                    if rep[j] != t[l+j]:
                        ok=False; break
                    pj=pat[j]
                    if pj != '*' and pj != s[l+j]:
                        ok=False; break
                if ok and cost < best[l][L]:
                    best[l][L]=cost
        dp=[INF]*(n+1)
        dp[0]=0
        for i in range(1,n+1):
            if s[i-1]==t[i-1]:
                dp[i]=dp[i-1]
            max_l=max_len if max_len<i else i
            # iterate starts
            for L in range(1,max_l+1):
                c=best[i-L][L]
                if c != INF:
                    prev=dp[i-L]
                    if prev != INF:
                        cand=prev+c
                        if cand<dp[i]: dp[i]=cand
        return -1 if dp[n]==INF else dp[n]
```
