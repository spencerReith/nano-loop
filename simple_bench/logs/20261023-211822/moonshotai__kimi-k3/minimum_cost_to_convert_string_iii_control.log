class Solution:
    def minCost(self, source: str, target: str, rules: list[list[str]], costs: list[int]) -> int:
        if source == target:
            return 0

        n = len(source)
        max_len = max(len(rule[0]) for rule in rules)
        INF = 10**18

        # best[l][L] = minimum cost of one rule application covering [l, l + L)
        best = [[INF] * (max_len + 1) for _ in range(n)]
        s, t = source, target

        for idx, (pat, rep) in enumerate(rules):
            L = len(pat)
            if L > n:
                continue

            cost = costs[idx] + pat.count('*')
            fixed = [(j, ch) for j, ch in enumerate(pat) if ch != '*']

            for l in range(n - L + 1):
                # Since used positions can never be changed again, the replacement
                # must already match the target on this whole segment.
                if not t.startswith(rep, l):
                    continue

                ok = True
                for j, ch in fixed:
                    if s[l + j] != ch:
                        ok = False
                        break

                if ok and cost < best[l][L]:
                    best[l][L] = cost

        dp = [INF] * (n + 1)
        dp[0] = 0

        for i in range(1, n + 1):
            if s[i - 1] == t[i - 1]:
                dp[i] = dp[i - 1]

            limit = max_len if max_len < i else i
            for L in range(1, limit + 1):
                c = best[i - L][L]
                if c != INF:
                    cand = dp[i - L] + c
                    if cand < dp[i]:
                        dp[i] = cand

        return -1 if dp[n] == INF else dp[n]
```
