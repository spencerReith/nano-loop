```
class Solution:
    def minCost(...):
        if source == target:
            return 0
        n = len(source)
        max_len = max(len(r[0]) for r in rules)
        INF = 10**18
        best = [[INF] * (max_len + 1) for _ in range(n)]
        s, t = source, target
        for k, (pat, rep) in enumerate(rules):
            L = len(pat)
            if L > n:
                continue
            add = pat.count('*')
            c = costs[k] + add
            fixed = [(j, ch) for j, ch in enumerate(pat) if ch != '*']
            last_start = n - L
            row_best = best  # local? not needed
            for l in range(last_start + 1):
                if not t.startswith(rep, l):
                    continue
                ok = True
                base = l
                for j, ch in fixed:
                    if s[base + j] != ch:
                        ok = False
                        break
                if ok and c < best[l][L]:
                    best[l][L] = c
        dp=[INF]*(n+1); dp[0]=0
        for i in range(1,n+1):
            if s[i-1] == t[i-1]:
                dp[i]=dp[i-1]
            hi = max_len if max_len < i else i
            for L in range(1, hi+1):
                c=best[i-L][L]
                if c != INF:
                    cand=dp[i-L]+c
                    if cand<dp[i]: dp[i]=cand
        ans=dp[n]
        return -1 if ans==INF else ans
```
