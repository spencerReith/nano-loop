class Solution:
    def minEnergy(self, n: int, brightness: int, intervals: list[list[int]]) -> int:
        # One bulb illuminates at most three positions.  Conversely, for any
        # k bulbs with 3*k <= n, placing them at positions 1, 4, 7, ...
        # illuminates 3*k distinct positions, so this bound is attainable.
        bulbs_needed = (brightness + 2) // 3

        # The same minimum number of bulbs is needed at every covered time.
        # Therefore, only the total length of the union of intervals matters.
        intervals.sort()
        active_time = 0
        cur_start, cur_end = intervals[0]

        for start, end in intervals[1:]:
            if start <= cur_end + 1:
                if end > cur_end:
                    cur_end = end
            else:
                active_time += cur_end - cur_start + 1
                cur_start, cur_end = start, end

        active_time += cur_end - cur_start + 1
        return bulbs_needed * active_time
```
