class Solution:
    def shortestPath(self, n: int, edges: list[list[int]], labels: str, k: int) -> int:
        import heapq

        adj = [[] for _ in range(n)]
        for u, v, w in edges:
            adj[u].append((v, w))

        # state: (node, run length of current identical label ending at node)
        start_label = labels[0]
        start_run = 1

        INF = 10**30
        dist = [[INF] * (k + 1) for _ in range(n)]
        dist[0][start_run] = 0

        pq = [(0, 0, start_run)]  # (cost, node, run)

        while pq:
            cost, u, run = heapq.heappop(pq)
            if cost != dist[u][run]:
                continue
            if u == n - 1:
                return cost
            for v, w in adj[u]:
                if labels[v] == labels[u]:
                    new_run = run + 1
                else:
                    new_run = 1
                if new_run > k:
                    continue
                new_cost = cost + w
                if new_cost < dist[v][new_run]:
                    dist[v][new_run] = new_cost
                    heapq.heappush(pq, (new_cost, v, new_run))

        return -1
