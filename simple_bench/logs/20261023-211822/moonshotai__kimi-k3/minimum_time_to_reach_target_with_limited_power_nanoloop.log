```python
import heapq


class Solution:
    def minTimeMaxPower(self, n: int, edges: list[list[int]], power: int, cost: list[int], source: int, target: int) -> list[int]:
        adj = [[] for _ in range(n)]
        for u, v, t in edges:
            adj[u].append((v, t))

        INF = float('inf')
        # dist[node][p] = minimum time to reach `node` with exactly `p` power remaining
        dist = [[INF] * (power + 1) for _ in range(n)]
        dist[source][power] = 0

        # Heap ordered by (time, -power): minimum time first, then maximum power
        heap = [(0, -power, source)]

        while heap:
            time, negp, u = heapq.heappop(heap)
            p = -negp
            if time > dist[u][p]:
                continue
            if u == target:
                # First time we pop target: minimum time, and max power among those
                return [time, p]
            if p < cost[u]:
                continue
            np = p - cost[u]
            for v, t in adj[u]:
                nt = time + t
                if nt < dist[v][np]:
                    dist[v][np] = nt
                    heapq.heappush(heap, (nt, -np, v))

        return [-1, -1]
```
