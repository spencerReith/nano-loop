class Solution:
    def minOperations(self, s1: str, s2: str) -> int:
        n = len(s1)
        set_ops = 0          # positions 0 -> 1
        clear_cnt = 0        # positions 1 -> 0
        matched_pairs = 0    # adjacent pairs of 1 -> 0 handled by one operation

        i = 0
        while i < n:
            if s1[i] == '1' and s2[i] == '0':
                if n == 1:
                    return -1
                j = i
                while j < n and s1[j] == '1' and s2[j] == '0':
                    j += 1
                run = j - i
                clear_cnt += run
                matched_pairs += run // 2
                i = j
            else:
                if s1[i] == '0' and s2[i] == '1':
                    set_ops += 1
                i += 1

        return set_ops + 2 * clear_cnt - 3 * matched_pairs
