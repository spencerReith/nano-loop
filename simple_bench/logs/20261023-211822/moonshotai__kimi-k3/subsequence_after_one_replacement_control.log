class Solution:
    def canMakeSubsequence(self, s: str, t: str) -> bool:
        n, m = len(s), len(t)

        # suff[i] = the rightmost index j such that s[j:] is a subsequence of t[i:]
        # (n means "not possible")
        suff = [n] * (m + 1)
        j = n
        for i in range(m - 1, -1, -1):
            if j > 0 and s[j - 1] == t[i]:
                j -= 1
            suff[i] = j

        # If s is already a subsequence of t, we can replace any character with itself.
        if suff[0] == 0:
            return True

        # Try matching a prefix of s directly, replace one character with t[i],
        # then check the remaining suffix can be matched after position i.
        j = 0
        for i in range(m):
            if j < n and s[j] == t[i]:
                j += 1
                continue
            # Use the replacement at s[j] -> t[i]
            if j < n and suff[i + 1] <= j + 1:
                return True

        return False
