class Solution:
    def minPenalty(self, period: int, lights: list[int], arrivalTime: list[int]) -> int:
        if not lights:
            return 0
        
        sorted_lights = sorted(lights)
        unique_residues = sorted(set(t % period for t in arrivalTime))
        
        if not unique_residues:
            return 0
        
        # Check if a given max waiting time 'max_w' is achievable
        def can_achieve(max_w: int) -> bool:
            current = 0
            n = len(unique_residues)
            
            for g in sorted_lights:
                if current >= n:
                    return True
                
                # Find the first residue that cannot be assigned to this light
                target = g + max_w
                
                # Binary search for the first residue > target
                # Using bisect for efficiency
                import bisect
                next_idx = bisect.bisect_right(unique_residues, target)
                
                # If no progress can be made with this light
                if next_idx <= current:
                    return False
                
                current = next_idx
            
            return current >= n
        
        # Binary search for the minimum penalty
        low = 0
        high = period - 1
        
        while low < high:
            mid = (low + high) // 2
            if can_achieve(mid):
                high = mid
            else:
                low = mid + 1
        
        return low
