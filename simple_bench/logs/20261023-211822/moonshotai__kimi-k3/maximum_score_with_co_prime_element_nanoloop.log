from math import gcd

class Solution:
    def maxScore(self, nums: list[int], maxVal: int) -> int:
        n = len(nums)
        M = max(maxVal, max(nums))

        freq = [0] * (M + 1)
        for v in nums:
            freq[v] += 1

        # Mobius function up to M
        mu = [0] * (M + 1)
        primes = []
        is_comp = [False] * (M + 1)
        mu[1] = 1
        for i in range(2, M + 1):
            if not is_comp[i]:
                primes.append(i)
                mu[i] = -1
            for p in primes:
                ip = i * p
                if ip > M:
                    break
                is_comp[ip] = True
                if i % p == 0:
                    mu[ip] = 0
                    break
                mu[ip] = -mu[i]

        # cntMult[d] = how many array values are divisible by d
        cntMult = [0] * (M + 1)
        for d in range(1, M + 1):
            s = 0
            for m in range(d, M + 1, d):
                s += freq[m]
            cntMult[d] = s

        # good[x] = how many original array values are coprime with x
        good = [0] * (M + 1)
        for d in range(1, M + 1):
            md = mu[d]
            if md == 0:
                continue
            c = cntMult[d]
            if c == 0:
                continue
            if md == 1:
                for x in range(d, M + 1, d):
                    good[x] += c
            else:
                for x in range(d, M + 1, d):
                    good[x] -= c

        ans = -10**18

        # Select an already existing value x > 1 and leave it unchanged.
        # This is also valid when x > maxVal, because unchanged elements may stay as they are.
        for x in range(2, M + 1):
            if freq[x]:
                score = x + good[x] - n + 1
                if score > ans:
                    ans = score

        # Value 1 is special because gcd(1, 1) = 1.
        if freq[1]:
            if ans < 1:
                ans = 1
        else:
            # Change any one element to 1; all other elements are coprime with 1.
            if ans < 0:
                ans = 0

        # Select a value x <= maxVal that does not already occur, changing one index to x.
        for x in range(2, maxVal + 1):
            if freq[x] == 0:
                bad = n - good[x]
                if bad:
                    # Change an originally non-coprime index to x.
                    score = x + good[x] - n
                else:
                    # Everything is already coprime with x; pay only for the selected index.
                    score = x - 1
                if score > ans:
                    ans = score

        return ans
