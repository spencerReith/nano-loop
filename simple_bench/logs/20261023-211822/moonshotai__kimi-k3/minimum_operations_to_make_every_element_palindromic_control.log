class Solution:
    def minOperations(self, nums: list[int]) -> int:
        palindromes = self._precompute_palindromes(10**9)
        
        total = 0
        for x in nums:
            total += self._min_ops_to_palindrome(x, palindromes)
        
        return total
    
    def _precompute_palindromes(self, limit: int) -> list[int]:
        palindromes = set()
        
        for length in range(1, 11):
            if length == 1:
                for d in range(1, 10):
                    palindromes.add(d)
            elif length == 2:
                for d in range(1, 10):
                    palindromes.add(d * 11)
            else:
                half_len = (length + 1) // 2
                start = 10 ** (half_len - 1)
                end = 10 ** half_len
                
                for h in range(start, end):
                    s = str(h)
                    if length % 2 == 1:
                        p = s + s[:-1][::-1]
                    else:
                        p = s + s[::-1]
                    val = int(p)
                    if val <= limit:
                        palindromes.add(val)
        
        return sorted(palindromes)
    
    def _min_ops_to_palindrome(self, x: int, palindromes: list[int]) -> int:
        if x < 1:
            return (1 - x) // 2
        
        parity = x % 2
        best = float('inf')
        
        idx = self._bisect_left(palindromes, x)
        
        for i in range(max(0, idx - 2), min(len(palindromes), idx + 2)):
            p = palindromes[i]
            if p < 1:
                continue
            if p % 2 == parity:
                best = min(best, abs(x - p) // 2)
        
        if best == float('inf'):
            idx_low = self._bisect_right(palindromes, x) - 1
            while idx_low >= 0 and (palindromes[idx_low] % 2 != parity or palindromes[idx_low] < 1):
                idx_low -= 1
            if idx_low >= 0:
                best = (x - palindromes[idx_low]) // 2
            
            idx_high = self._bisect_left(palindromes, x)
            while idx_high < len(palindromes) and palindromes[idx_high] % 2 != parity:
                idx_high += 1
            if idx_high < len(palindromes):
                best = min(best, (palindromes[idx_high] - x) // 2)
        
        return best
    
    def _bisect_left(self, arr: list[int], x: int) -> int:
        lo, hi = 0, len(arr)
        while lo < hi:
            mid = (lo + hi) // 2
            if arr[mid] < x:
                lo = mid + 1
            else:
                hi = mid
        return lo
    
    def _bisect_right(self, arr: list[int], x: int) -> int:
        lo, hi = 0, len(arr)
        while lo < hi:
            mid = (lo + hi) // 2
            if arr[mid] <= x:
                lo = mid + 1
            else:
                hi = mid
        return lo
