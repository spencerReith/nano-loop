class Solution:
    def generateValidStrings(self, n: int, k: int) -> list[str]:
        res = []
        cur = []

        def dfs(i: int, cost: int, prev_one: bool):
            if cost > k:
                return
            if i == n:
                res.append("".join(cur))
                return

            # Lexicographic order means trying '0' before '1'.
            cur.append('0')
            dfs(i + 1, cost, False)
            cur.pop()

            if not prev_one:
                cur.append('1')
                dfs(i + 1, cost + i, True)
                cur.pop()

        dfs(0, 0, False)
        return res
