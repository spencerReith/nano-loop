from collections import Counter


class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        cnt = Counter(planks)
        items = list(cnt.items())

        # pair_contrib[s] = maximum number of two-plank combinations whose sum is s.
        pair_contrib = {}

        # Pairs made from two planks of the same height v: floor(cnt[v] / 2), target 2*v.
        for v, c in items:
            if c >= 2:
                s = v + v
                pair_contrib[s] = pair_contrib.get(s, 0) + (c // 2)

        # Pairs made from two different heights v and w: min(cnt[v], cnt[w]), target v+w.
        m = len(items)
        for i in range(m):
            vi, ci = items[i]
            for j in range(i + 1, m):
                vj, cj = items[j]
                s = vi + vj
                add = ci if ci < cj else cj
                pair_contrib[s] = pair_contrib.get(s, 0) + add

        # For a target height s, we may also use every original plank already having height s.
        ans = 0
        for v, c in cnt.items():
            val = c + pair_contrib.get(v, 0)
            if val > ans:
                ans = val
        for s, p in pair_contrib.items():
            val = p + cnt.get(s, 0)
            if val > ans:
                ans = val
        return ans
