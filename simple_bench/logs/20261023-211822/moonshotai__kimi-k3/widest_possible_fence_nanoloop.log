from solution import Solution
from itertools import combinations
from functools import lru_cache
import random

def brute(planks):
    n=len(planks)
    cand=set(planks)
    for i in range(n):
        for j in range(i+1,n):
            cand.add(planks[i]+planks[j])
    a=planks
    @lru_cache(None)
    def dp(mask, S): # S int; lru with two args okay
        if mask==0: return 0
        # find first set bit
        lsb = mask & -mask
        i = lsb.bit_length()-1
        m2 = mask ^ lsb
        best = dp(m2, S) # skip i
        if a[i] == S:
            best = max(best, 1 + dp(m2, S))
        # pair i with j
        mm = m2
        while mm:
            lsbj = mm & -mm
            j = lsbj.bit_length()-1
            if a[i] + a[j] == S:
                best = max(best, 1 + dp(m2 ^ lsbj, S))
            mm ^= lsbj
        return best
    full=(1<<n)-1
    return max(dp(full,S) for S in cand) if cand else 0

