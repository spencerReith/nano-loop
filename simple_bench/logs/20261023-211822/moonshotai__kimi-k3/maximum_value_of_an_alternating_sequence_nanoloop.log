```python
class Solution:
    def maximumValue(self, n: int, s: int, m: int) -> int:
        if n == 1:
            return s
        # Start with an up step; up transitions are at indices 1,3,5,... among n-1 transitions.
        U = n // 2          # ceil((n-1)/2)
        D = (n - 1) - U     # remaining down transitions
        if n % 2 == 0:
            # Ends with an up step; last element is the peak.
            # Minimize each down step to 1 (strict alternation, integers).
            return s + U * m - D
        else:
            # Ends with a down step; peak is the second-to-last element.
            # All down steps except the last are minimal (1); the peak ignores the final down.
            return s + U * m - (D - 1)
```
