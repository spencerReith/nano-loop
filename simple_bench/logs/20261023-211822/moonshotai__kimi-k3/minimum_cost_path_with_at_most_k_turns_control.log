class Solution:
    def minCost(self, grid: list[list[int]], k: int) -> int:
        import heapq

        m, n = len(grid), len(grid[0])
        INF = float('inf')
        # dist[t][r][c][d]: min cost at cell (r,c) having used t turns and arriving from direction d
        # d: 0=up,1=down,2=left,3=right
        dist = [[[ [INF]*4 for _ in range(n)] for _ in range(m)] for __ in range(k+1)]

        pq = []  # (cost, r, c, turns, dir)
        # Starting cell: no moves made yet. We'll push neighbors with turns=0 and initial direction.
        srccost = grid[0][0]
        dirs = [(-1,0),(1,0),(0,-1),(0,1)]

        # initialize moves from start
        for d,(dr,dc) in enumerate(dirs):
            nr, nc = dr, dc
            if 0 <= nr < m and 0 <= nc < n:
                cst = srccost + grid[nr][nc]
                if cst < dist[0][nr][nc][d]:
                    dist[0][nr][nc][d] = cst
                    heapq.heappush(pq, (cst, nr, nc, 0, d))

        # handle case start == target
        if m == 1 and n == 1:
            return srccost

        while pq:
            cost, r, c, t, d = heapq.heappop(pq)
            if cost != dist[t][r][c][d]:
                continue
            if r == m-1 and c == n-1:
                return cost
            for nd,(dr,dc) in enumerate(dirs):
                nr, nc = r+dr, c+dc
                if 0 <= nr < m and 0 <= nc < n:
                    nt = t + (0 if nd == d else 1)
                    if nt > k:
                        continue
                    ncost = cost + grid[nr][nc]
                    if ncost < dist[nt][nr][nc][nd]:
                        dist[nt][nr][nc][nd] = ncost
                        heapq.heappush(pq, (ncost, nr, nc, nt, nd))

        # If target never popped, check minimal dist over states (shouldn't be needed since first pop is optimal)
        ans = min(dist[t][m-1][n-1][d] for t in range(k+1) for d in range(4))
        return -1 if ans == INF else ans
