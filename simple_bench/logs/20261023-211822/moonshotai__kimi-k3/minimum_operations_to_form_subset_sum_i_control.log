Let's prepare final code:

```python
class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        target = sum
        INF = 10**9
        dp = [INF] * (target + 1)
        dp[0] = 0

        for x in nums:
            opts = {}
            r = 0
            while True:
                v = x << r
                if v > target:
                    break
                if r < opts.get(v, INF):
                    opts[v] = r
                r += 1
            q = 0
            while True:
                v = x >> q
                if v == 0:
                    break
                if v <= target and q < opts.get(v, INF):
                    opts[v] = q
                q += 1
            ndp = dp[:]  # not using this element
            items = list(opts.items())
            for s in range(target + 1):
                cur = dp[s]
                if cur == INF:
                    continue
                for v, c in items:
                    ns = s + v
                    if ns > target:
                        continue
                    nc = cur + c
                    if nc < ndp[ns]:
                        ndp[ns] = nc
            dp = ndp

        return -1 if dp[target] == INF else dp[target]
```

