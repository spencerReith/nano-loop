Let's final.<|close|>think<|sep|>```python
class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        target = sum
        INF = 10**9

        dp = [INF] * (target + 1)
        dp[0] = 0

        for x in nums:
            opts = {}

            v, c = x, 0
            while v <= target:
                if c < opts.get(v, INF):
                    opts[v] = c
                v <<= 1
                c += 1

            v, c = x, 0
            while v:
                if v <= target and c < opts.get(v, INF):
                    opts[v] = c
                v >>= 1
                c += 1

            ndp = dp[:]
            items = list(opts.items())
            for s in range(target + 1):
                if dp[s] == INF:
                    continue
                for val, cost in items:
                    ns = s + val
                    if ns <= target and dp[s] + cost < ndp[ns]:
                        ndp[ns] = dp[s] + cost
            dp = ndp

        return -1 if dp[target] == INF else dp[target]
```
