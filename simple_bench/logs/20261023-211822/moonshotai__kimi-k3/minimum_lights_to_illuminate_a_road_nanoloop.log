The approach: use a difference array to compute which positions are already illuminated by existing bulbs (O(n)), then greedily scan left to right — whenever an unlit position `i` is found, install a bulb at `i+1` (lighting `i..i+2`, the farthest rightward reach) and skip ahead. This greedy is optimal because any bulb covering the first unlit position `i` must be placed in `{i-1, i, i+1}`, and placing it at `i+1` dominates the other choices.

```python
class Solution:
    def minLights(self, lights: list[int]) -> int:
        n = len(lights)

        # Mark ranges covered by existing working bulbs using a difference array.
        diff = [0] * (n + 1)
        for i, v in enumerate(lights):
            if v > 0:
                l = i - v
                if l < 0:
                    l = 0
                r = i + v
                if r > n - 1:
                    r = n - 1
                diff[l] += 1
                diff[r + 1] -= 1

        cur = 0
        covered = [False] * n
        for i in range(n):
            cur += diff[i]
            covered[i] = cur > 0

        # Greedy: at the first unlit position i, place a bulb at i + 1,
        # which lights i, i + 1, i + 2 (the farthest reach to the right).
        ans = 0
        i = 0
        while i < n:
            if covered[i]:
                i += 1
            else:
                ans += 1
                i += 3

        return ans
```
