```python
class Solution:
    def minLights(self, lights: list[int]) -> int:
        n = len(lights)
        diff = [0] * (n + 1)
        for i, v in enumerate(lights):
            if v > 0:
                l = max(0, i - v)
                r = min(n - 1, i + v)
                diff[l] += 1
                diff[r + 1] -= 1
        cur = 0
        covered = [False] * n
        for i in range(n):
            cur += diff[i]
            covered[i] = cur > 0
        ans = 0
        i = 0
        while i < n:
            if covered[i]:
                i += 1
            else:
                ans += 1
                i += 3
        return ans
```

