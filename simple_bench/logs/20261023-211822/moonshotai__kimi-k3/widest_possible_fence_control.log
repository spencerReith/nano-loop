class Solution:
    def maximumWidth(self, planks: list[int]) -> int:
        planks.sort()
        n = len(planks)
        ans = 1
        lo, hi = 0, n - 1
        while lo < hi:
            s = planks[lo] + planks[hi]
            l, r = lo, hi
            cnt = 0
            while l < r:
                cur = planks[l] + planks[r]
                if cur == s:
                    cnt += 1
                    l += 1
                    r -= 1
                elif cur < s:
                    l += 1
                else:
                    r -= 1
            cnt += sum(1 for x in planks if x == s)
            if cnt > ans:
                ans = cnt
            lo += 1
            hi -= 1
        return ans
