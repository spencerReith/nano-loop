class Solution:
    def getSum(self, nums: list[int]) -> int:
        n = len(nums)
        pref = [0] * (n + 1)
        for i, x in enumerate(nums, 1):
            pref[i] = pref[i - 1] + x

        # d1[i] = k means nums[i-k+1 : i+k] is the longest odd palindrome centered at i.
        d1 = [0] * n
        l, r = 0, -1
        for i in range(n):
            k = 1 if i > r else min(d1[l + r - i], r - i + 1)
            while i - k >= 0 and i + k < n and nums[i - k] == nums[i + k]:
                k += 1
            d1[i] = k
            if i + k - 1 > r:
                l, r = i - k + 1, i + k - 1

        # d2[i] = k means nums[i-k : i+k] is the longest even palindrome centered between i-1 and i.
        d2 = [0] * n
        l, r = 0, -1
        for i in range(n):
            k = 0 if i > r else min(d2[l + r - i + 1], r - i + 1)
            while i - k - 1 >= 0 and i + k < n and nums[i - k - 1] == nums[i + k]:
                k += 1
            d2[i] = k
            if i + k - 1 > r:
                l, r = i - k, i + k - 1

        ans = 0
        for i, k in enumerate(d1):
            # All values are positive, so for this center the longest radius has the largest sum.
            cur = pref[i + k] - pref[i - k + 1]
            if cur > ans:
                ans = cur
        for i, k in enumerate(d2):
            if k:
                cur = pref[i + k] - pref[i - k]
                if cur > ans:
                    ans = cur
        return ans
