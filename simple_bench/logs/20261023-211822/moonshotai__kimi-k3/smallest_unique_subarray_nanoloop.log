```python
class Solution:
    def smallestUniqueSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        MOD1 = (1 << 61) - 1
        MOD2 = (1 << 31) - 1
        BASE = 1000003  # must be > max(nums[i])? Not necessary but good.
        
        # Precompute prefix hashes
        pre1 = [0] * (n + 1)
        pre2 = [0] * (n + 1)
        for i, x in enumerate(nums):
            pre1[i+1] = (pre1[i] * BASE + x) % MOD1
            pre2[i+1] = (pre2[i] * BASE + x) % MOD2
        
        pow1 = [1] * (n + 1)
        pow2 = [1] * (n + 1)
        for i in range(1, n + 1):
            pow1[i] = pow1[i-1] * BASE % MOD1
            pow2[i] = pow2[i-1] * BASE % MOD2
        
        def has_unique(l):
            counts = {}
            for i in range(n - l + 1):
                h1 = (pre1[i+l] - pre1[i] * pow1[l]) % MOD1
                h2 = (pre2[i+l] - pre2[i] * pow2[l]) % MOD2
                key = (h1 << 32) | h2
                counts[key] = counts.get(key, 0) + 1
            return any(v == 1 for v in counts.values())
        
        lo, hi = 1, n
        ans = n
        while lo <= hi:
            mid = (lo + hi) // 2
            if has_unique(mid):
                ans = mid
                hi = mid - 1
            else:
                lo = mid + 1
        return ans
```

