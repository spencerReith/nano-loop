```python
from bisect import bisect_left

def _gen_palindromes():
    pals = []
    for i in range(1, 100000):
        s = str(i)
        pals.append(int(s + s[::-1]))       # even length
        pals.append(int(s + s[-2::-1]))     # odd length
    return pals

_PALS = sorted(set(_gen_palindromes()))
_EVEN = [p for p in _PALS if p % 2 == 0]
_ODD = [p for p in _PALS if p % 2 == 1]

class Solution:
    def minOperations(self, nums: list[int]) -> int:
        total = 0
        for x in nums:
            arr = _EVEN if x % 2 == 0 else _ODD
            i = bisect_left(arr, x)
            best = float('inf')
            if i < len(arr):
                best = min(best, arr[i] - x)
            if i > 0:
                best = min(best, x - arr[i-1])
            total += best // 2
        return total
```

