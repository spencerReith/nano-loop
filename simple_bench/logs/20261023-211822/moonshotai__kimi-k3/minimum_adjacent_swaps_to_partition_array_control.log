            elif x <= b:
                grp.append(1)
            else:
                grp.append(2)
        
        # dp[g1][g2]: after processing some prefix, the number of elements
        # currently in group 1 (mid) is g1 and group 2 (high) is g2.
        # Group 0 count is determined by prefix length - g1 - g2.
        # Since the relative order of elements within the same group is irrelevant
