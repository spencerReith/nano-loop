class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        
        # Assign each element to a group: 0 = <a, 1 = [a,b], 2 = >b
        grp = []
