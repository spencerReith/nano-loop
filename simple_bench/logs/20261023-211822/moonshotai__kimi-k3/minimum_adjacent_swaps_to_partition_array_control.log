        # track counts of each group placed so far.
        
        # When we take the i-th element (0-indexed) with group g:
        #   - If placed as group 0: all previously placed group-1 and group-2 items
        #     come before it, causing (g1 + g2) inversions.
        #   - If placed as group 1: all previously placed group-2 items cause g2 inversions.
        #   - If placed as group 2: 0 additional inversions.
        
        # dp over (count1, count2)
        INF = float('inf')
