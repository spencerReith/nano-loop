```python
class Fenwick:
    def __init__(self, n):
        self.n = n
        self.tree = [0] * (n + 1)

    def add(self, i, delta):
        # i is 1-indexed
        n = self.n
        tree = self.tree
        while i <= n:
            tree[i] += delta
            i += i & -i

    def sum(self, i):
        s = 0
        tree = self.tree
        while i > 0:
            s += tree[i]
            i -= i & -i
        return s

    def range_sum(self, l, r):
        if l > r:
            return 0
        return self.sum(r) - self.sum(l - 1)

    def select(self, k):
        # smallest i with prefix sum >= k (k >= 1)
        i = 0
        bitmask = 1 << (self.n.bit_length() - 1)
        tree = self.tree
        while bitmask:
            t = i + bitmask
            if t <= self.n and tree[t] < k:
                i = t
                k -= tree[t]
            bitmask >>= 1
        return i + 1
```

Use 1-indexed Fenwick with positions shifted by +1: position `x` (array index) maps to Fenwick index `x+1`.

