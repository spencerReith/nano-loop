class Fenwick:
    __slots__ = ('n', 'tree')

    def __init__(self, n):
        self.n = n
        self.tree = [0] * (n + 1)

    def add(self, i, delta):
        tree = self.tree
        n = self.n
        while i <= n:
            tree[i] += delta
            i += i & -i

    def sum(self, i):
        s = 0
        tree = self.tree
        while i > 0:
            s += tree[i]
            i -= i & -i
        return s

    def select(self, k):
        # smallest index i with prefix sum >= k (assumes k >= 1 and valid)
        i = 0
        tree = self.tree
        bitmask = 1 << (self.n.bit_length() - 1)
        while bitmask:
            t = i + bitmask
            if t <= self.n and tree[t] < k:
                i = t
                k -= tree[t]
            bitmask >>= 1
        return i + 1


class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        n = len(nums)
        # Fenwick trees, position x (array index) -> fenwick index x + 1
        bitCnt = Fenwick(n + 2)   # peak indicators
        bitC = Fenwick(n + 2)     # sum of c[p] over peaks
        bitCP = Fenwick(n + 2)    # sum of c[p] * p over peaks

        def is_peak(x):
            return nums[x] > nums[x - 1] and nums[x] > nums[x + 1]

        def prev_peak(x):
            # greatest peak index < x, or 0 if none
            c = bitCnt.sum(x)          # peaks at positions <= x-1
            if c == 0:
                return 0
            return bitCnt.select(c) - 1

        def next_peak(x):
            # smallest peak index > x, or -1 if none
            c = bitCnt.sum(x + 1)      # peaks at positions <= x
            if bitCnt.sum(n + 1) > c:
                return bitCnt.select(c + 1) - 1
            return -1

        def add_peak(p):
            prev = prev_peak(p)
            nxt = next_peak(p)
            c = p - prev - 1
            bitCnt.add(p + 1, 1)
            bitC.add(p + 1, c)
            bitCP.add(p + 1, c * p)
            if nxt != -1:
                diff = (nxt - p - 1) - (nxt - prev - 1)
                bitC.add(nxt + 1, diff)
                bitCP.add(nxt + 1, diff * nxt)

        def remove_peak(p):
            prev = prev_peak(p)
            nxt = next_peak(p)
            c = p - prev - 1
            bitCnt.add(p + 1, -1)
            bitC.add(p + 1, -c)
            bitCP.add(p + 1, -c * p)
            if nxt != -1:
                diff = (nxt - prev - 1) - (nxt - p - 1)
                bitC.add(nxt + 1, diff)
                bitCP.add(nxt + 1, diff * nxt)

        for x in range(1, n - 1):
            if is_peak(x):
                add_peak(x)

        ans = []
        for q in queries:
            if q[0] == 1:
                l, r = q[1], q[2]
                # peaks p with l < p < r
                cnt = bitCnt.sum(r) - bitCnt.sum(l + 1)
                if cnt == 0:
                    ans.append(0)
                    continue
                p0 = bitCnt.select(bitCnt.sum(l + 1) + 1) - 1
                total = (p0 - l) * (r - p0)
                sumC = bitC.sum(r) - bitC.sum(p0 + 1)
                sumCP = bitCP.sum(r) - bitCP.sum(p0 + 1)
                total += r * sumC - sumCP
                ans.append(total)
            else:
                idx, val = q[1], q[2]
                if nums[idx] == val:
                    continue
                affected = [x for x in (idx - 1, idx, idx + 1)
                            if 1 <= x <= n - 2]
                old = {}
                for x in affected:
                    old[x] = is_peak(x)
                nums[idx] = val
                for x in affected:
                    now = is_peak(x)
                    if now and not old[x]:
                        add_peak(x)
                    elif old[x] and not now:
                        remove_peak(x)
        return ans
```

**Approach:** A subarray `[i, j]` is a peak subarray iff it contains a peak index `p` (`nums[p]` greater than both neighbors) with `i < p < j`. Each qualifying subarray has a unique **leftmost** peak `p`, where `i` ranges over `(prevPeak[p], p-1]` and `j` over `[p+1, r]`. For query `[l, r]`, the answer is:

- `(p0 - l) * (r - p0)` for the first peak `p0 > l`, plus
- `Σ (p - prevPeak[p] - 1) * (r - p)` over remaining peaks `p` in `(p0, r)`, which splits as `r·Σc[p] − Σc[p]·p`.

Three Fenwick trees maintain peak indicators, `Σc[p]`, and `Σc[p]·p`; the count Fenwick also supports order-statistic selection (predecessor/successor) via binary lifting. Updates only affect peak status at indices `idx-1, idx, idx+1` and the `c` value of the successor peak, all in `O(log n)`. Total complexity: `O((n + q) log n)`.
