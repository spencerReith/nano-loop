class Solution:
    def countOfPeaks(self, nums, queries):
        n = len(nums)
        bitCnt = Fenwick(n + 2)
        bitC = Fenwick(n + 2)
        bitCP = Fenwick(n + 2)

        def is_peak(x):
            return 0 < x < n - 1 and nums[x] > nums[x - 1] and nums[x] > nums[x + 1]

        def prev_peak(x):
            c = bitCnt.sum(x)  # fenwick idx x => positions <= x-1
            if c == 0:
                return 0
            return bitCnt.select(c) - 1

        def next_peak(x):
            c = bitCnt.sum(x + 1)  # positions <= x
            if bitCnt.sum(n + 1) > c:
                return bitCnt.select(c + 1) - 1
            return -1
```

