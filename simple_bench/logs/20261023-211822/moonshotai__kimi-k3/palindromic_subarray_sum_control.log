class Solution:
    def getSum(self, nums: list[int]) -> int:
        n = len(nums)

        pref = [0] * (n + 1)
        for i in range(n):
            pref[i + 1] = pref[i] + nums[i]

        # Odd-length palindromes: d1[i] = k means nums[i-k+1 : i+k] is palindrome
        d1 = [0] * n
        l, r = 0, -1
        for i in range(n):
            k = 1 if i > r else min(d1[l + r - i], r - i + 1)
            while i - k >= 0 and i + k < n and nums[i - k] == nums[i + k]:
                k += 1
            d1[i] = k
            k -= 1
            if i + k > r:
                l, r = i - k, i + k

        # Even-length palindromes: d2[i] = k means nums[i-k : i+k] is palindrome
        d2 = [0] * n
        l, r = 0, -1
        for i in range(n):
            k = 0 if i > r else min(d2[l + r - i + 1], r - i + 1)
            while i + k < n and i - k - 1 >= 0 and nums[i + k] == nums[i - k - 1]:
                k += 1
            d2[i] = k
            k -= 1
            if i + k > r:
                l, r = i - k - 1, i + k

        ans = 0
        for i, k in enumerate(d1):
            cur = pref[i + k] - pref[i - k + 1]
            if cur > ans:
                ans = cur

        for i, k in enumerate(d2):
            if k:
                cur = pref[i + k] - pref[i - k]
                if cur > ans:
                    ans = cur

        return ans
