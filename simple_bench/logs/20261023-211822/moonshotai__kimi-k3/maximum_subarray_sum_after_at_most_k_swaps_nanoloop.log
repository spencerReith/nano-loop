Let me code:

```python
import random, bisect

def kadane(e):
    best = e[0]; cur = e[0]
    for x in e[1:]:
        cur = x if x > cur + x else cur + x
        if cur > best: best = cur
    return best

def brute(nums, k):
    n = len(nums)
    best = -10**18
    for l in range(n):
        for r in range(l, n):
            inside = sorted(nums[l:r+1])
            outside = sorted(nums[:l] + nums[r+1:], reverse=True)
            base = sum(inside)
            cur = 0; gain = 0
            for i in range(min(k, len(inside), len(outside))):
                cur += outside[i] - inside[i]
                if cur > gain: gain = cur
            if base + gain > best: best = base + gain
    return best

def dual(nums, k):
    vals = sorted(set(nums))
    n = len(nums)
    best = 10**18
    for a in vals:
        for b in vals:
            if a > b: continue
            e = [a if x < a else (b if x > b else x) for x in nums]
            C = 0
            for x in nums:
                if x > b: C += x - b
            R = k*(b-a) + C + kadane(e)
            if R < best: best = R
    return best

random.seed(0)
for trial in range(20000):
    n = random.randint(1, 8)
    mx = random.choice([3, 5, 20])
    nums = [random.randint(-mx, mx) for _ in range(n)]
    k = random.randint(0, n)
    b1 = brute(nums, k)
    b2 = dual(nums, k)
    if b1 != b2:
        print("MISMATCH", nums, k, b1, b2)
        break
else:
    print("all ok")
```

