from itertools import *
def brute(nums,k):
    n=len(nums); INF=float('inf'); best=-INF
    for l in range(n):
        for r in range(l,n):
            inside=sorted(nums[l:r+1])
            outside=sorted(nums[:l]+nums[r+1:],reverse=True)
            base=sum(inside); cur=0; gain=0
            for i in range(min(k,len(inside),len(outside))):
                d=outside[i]-inside[i]
                cur+=d
                if cur>gain: gain=cur
            if base+gain>best: best=base+gain
    return best

Since increments nonincreasing, cur max at some prefix; tracking max works. (Also t=0 gives gain 0.)

def kadane(arr): max subarray non-empty.
def dual(nums,k):
    vals=sorted(set(nums)); n=len(nums)
    total... C(b)=sum(max(0,x-b) for x in nums)
    best=inf
    for a in vals:
        for b in vals:
            if a>b: continue
            e=[min(max(x,a),b) for x in nums]
            m=kadane(e)
            R=k*(b-a)+C(b)+m
            best=min(best,R)
    return best

