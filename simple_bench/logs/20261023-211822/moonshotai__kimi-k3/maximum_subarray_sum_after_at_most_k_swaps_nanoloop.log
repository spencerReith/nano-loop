from bisect import bisect_left, bisect_right, insort_left


class Solution:
    def maxSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        if k == 0:
            # plain max subarray (Kadane)
            best = cur = nums[0]
            for x in nums[1:]:
                cur = x if x > cur + x else cur + x
                if cur > best:
                    best = cur
            return best
        gsorted = sorted(nums)
        bl = bisect_left
        br = bisect_right
        insort = insort_left
        ans = -10**30
        for l in range(n):
            xl = nums[l]
            Sin = [xl]
            Sout = sorted(nums[:l] + nums[l + 1:])
            Sout_len = n - 1
            kk = 1 if n >= 2 else 0
            A = xl if kk else 0
            B = Sout[-1] if kk else 0
            if n >= 2:
                v = gsorted[n - 2]
                if xl < v:
                    In_c = 1
                    In_s = xl
                else:
                    In_c = 0
                    In_s = 0
                q2 = br(Sout, v)
                Out_c = Sout_len - q2
                Out_s = sum(Sout[q2:])
            else:
                v = 0
                In_c = In_s = Out_c = Out_s = 0
            if kk == 0:
                gain = 0
            elif Sout[Sout_len - kk] >= Sin[kk - 1]:
                gain = B - A
            else:
                gain = v * In_c - In_s + Out_s - v * Out_c
            base = xl
            cand = base + gain
            if cand > ans:
                ans = cand
            nm = n - 1
            m = 1
            Sout_pop = Sout.pop
            for r in range(l + 1, n):
                x = nums[r]
                m += 1
                nm -= 1
                # v* update: v* = gsorted[n - m - 1] = gsorted[nm - 1]
                if nm >= 1:
                    v_new = gsorted[nm - 1]
                    if v_new != v:
                        q1 = bl(Sin, v_new)
                        q2 = bl(Sin, v)
                        if q2 > q1:
                            In_c -= q2 - q1
                            In_s -= sum(Sin[q1:q2])
                        q1 = br(Sout, v_new)
                        q2 = br(Sout, v)
                        if q2 > q1:
                            Out_c += q2 - q1
                            Out_s += sum(Sout[q1:q2])
                        v = v_new
                kk_new = k if k < m else m
                if nm < kk_new:
                    kk_new = nm
                # insert x into inside (old kk), fused bisect+insert
                insort(Sin, x)
                if kk:
                    if x <= Sin[kk - 1]:
                        A += x - Sin[kk]
                if x < v:
                    In_c += 1
                    In_s += x
                if kk_new > kk:
                    A += Sin[kk_new - 1]
                elif kk_new < kk:
                    A -= Sin[kk_new]
                # remove x from outside
                p = bl(Sout, x)
                if kk_new < kk:
                    B -= Sout[Sout_len - kk]
                    if p >= Sout_len - kk_new:
                        B -= x
                        B += Sout[Sout_len - kk_new - 1]
                    Sout_pop(p)
                else:
                    if p >= Sout_len - kk:
                        B -= x
                        if Sout_len - kk - 1 >= 0:
                            B += Sout[Sout_len - kk - 1]
                    Sout_pop(p)
                    if kk_new > kk:
                        B += Sout[Sout_len - 1 - kk_new]
                Sout_len -= 1
                if x > v:
                    Out_c -= 1
                    Out_s -= x
                kk = kk_new
                # evaluate window [l, r]
                base += x
                if kk == 0:
                    gain = 0
                else:
                    a0 = Sin[kk - 1]
                    b0 = Sout[Sout_len - kk]
                    if b0 >= a0:
                        gain = B - A
                    else:
                        gain = v * In_c - In_s + Out_s - v * Out_c
                cand = base + gain
                if cand > ans:
                    ans = cand
        return ans
