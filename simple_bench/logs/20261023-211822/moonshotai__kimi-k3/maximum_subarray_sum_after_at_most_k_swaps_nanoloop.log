def brute(nums, k):
    n=len(nums); best=-inf
    for l in range(n):
        for r in range(l,n):
            inside=sorted(nums[l:r+1]); outside=sorted((nums[:l]+nums[r+1:]), reverse=True)
            base=sum(inside); gain=0; t=0; cur=0
            for i in range(min(k,len(inside),len(outside))):
                d=outside[i]-inside[i]
                if d>0: cur+=d
                # keep track max
                gain=max(gain,cur)  # but only while d>0? cur increases then decreases; max tracked
            best=max(best,base+gain)
    return best

