class Solution:
    def minLights(self, lights: list[int]) -> int:
        n = len(lights)
        i = 0
        count = 0
        while i < n:
            if lights[i] > 0:
                # Existing working bulb covers up to i + lights[i]
                i += lights[i] + 1
            else:
                # Install an additional bulb at i + 1 (covers i to i + 2)
                count += 1
                i += 3
        return count
