class Solution:
    def countGoodStrings(self, n: int) -> int:
        MOD = 10**9 + 7
        
        # fast doubling Fibonacci: F(0)=0, F(1)=1
        def fib(n):
            if n == 0:
                return (0, 1)
            else:
                a, b = fib(n >> 1)
                c = (a * (2 * b - a)) % MOD
                d = (a * a + b * b) % MOD
                if n & 1:
                    return (d, (c + d) % MOD)
                else:
                    return (c, d)
        
        fn = fib(n)[0]  # F_n
        return (2 * fn) % MOD
```
