 class Solution:
    def getLength(self, nums: list[int]) -> int:
        # brute force all subarrays O(n^2) since n <= 1000
        n = len(nums)
        best = 1  # at least one element
        
        # Precompute frequencies for each subarray efficiently using sliding?
        # Since n <= 1000, O(n^2) is fine.
        from collections import Counter
        
        for i in range(n):
            freq = Counter()
            for j in range(i, n):
                freq[nums[j]] += 1
                # Check if subarray nums[i:j+1] is frequency balanced
                vals = list(freq.values())
                if len(vals) == 1:
                    # all same distinct value -> balanced
                    best = max(best, j - i + 1)
                else:
                    # find min and max frequencies
                    min_f = min(vals)
                    max_f = max(vals)
                    # check if frequencies are only min_f and 2*min_f, and both appear
                    # and min_f > 0 obviously
                    # also need that max_f == 2 * min_f and all values are either min_f or 2*min_f
                    # and at least one freq == min_f and at least one freq == 2*min_f
                    if max_f == 2 * min_f:
                        # check all frequencies are either min_f or max_f
                        ok = True
                        for f in vals:
                            if f != min_f and f != max_f:
                                ok = False
                                break
                        if ok:
                            # also need both min_f and max_f appear
                            if min_f in vals and max_f in vals:
                                best = max(best, j - i + 1)
        
        return best
```

