from math import gcd

class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)
        # Brute-force over no removal and removal of exactly one element
        best = 0
        
        # no removal
        sub = nums[:]
        m = len(sub)
        if m >= 2:
            # compute prefix gcds
            pref = [sub[0]]
            for x in sub[1:]:
                pref.append(gcd(pref[-1], x))
            # compute suffix gcds for right part starting at i+1
            suff = [0] * m
            suff[-1] = sub[-1]
            for i in range(m-2, -1, -1):
                suff[i] = gcd(suff[i+1], sub[i])
            cnt = 0
            for i in range(m - 1):
                if pref[i] == suff[i + 1]:
                    cnt += 1
            best = max(best, cnt)
        
        # removal of exactly one element
        for idx in range(n):
            sub = nums[:idx] + nums[idx+1:]
            m = len(sub)
            if m < 2:
                continue
            # compute prefix gcds
            pref = [sub[0]]
            for x in sub[1:]:
                pref.append(gcd(pref[-1], x))
            # compute suffix gcds
            suff = [0] * m
            suff[-1] = sub[-1]
            for i in range(m-2, -1, -1):
                suff[i] = gcd(suff[i+1], sub[i])
            cnt = 0
            for i in range(m - 1):
                if pref[i] == suff[i + 1]:
                    cnt += 1
            best = max(best, cnt)
        
        return best
