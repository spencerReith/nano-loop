class Solution:
    def minOperations(self, s1: str, s2: str) -> int:
        # BFS for small strings (n <= 20) else attempt simple greedy? 
        # But examples are small, so BFS works.
        n = len(s1)
        if n != len(s2):
            return -1
        if s1 == s2:
            return 0
        from collections import deque
        start = s1
        target = s2
        visited = set([start])
        q = deque([(start, 0)])
        while q:
            cur, dist = q.popleft()
            if cur == target:
                return dist
            # operation 1: flip '0' -> '1'
            for i in range(n):
                if cur[i] == '0':
                    nxt = cur[:i] + '1' + cur[i+1:]
                    if nxt not in visited:
                        visited.add(nxt)
                        q.append((nxt, dist+1))
            # operation 2: flip two adjacent '1' -> '0'
            for i in range(n-1):
                if cur[i] == '1' and cur[i+1] == '1':
                    nxt = cur[:i] + '00' + cur[i+2:]
                    if nxt not in visited:
                        visited.add(nxt)
                        q.append((nxt, dist+1))
        return -1
