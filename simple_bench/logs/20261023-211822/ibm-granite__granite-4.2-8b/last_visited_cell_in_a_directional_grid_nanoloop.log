 class Solution:
    def lastVisitedCell(self, grid: list[list[str]]) -> list[int]:
        m = len(grid)
        n = len(grid[0]) if m > 0 else 0
        
        # Track visited cells
        visited = set()
        # Start at (0, 0)
        row, col = 0, 0
        visited.add((row, col))
        
        # Directions mapping
        dirs = {'L': (0, -1), 'R': (0, 1), 'U': (-1, 0), 'D': (1, 0)}
        
        # Current position
        cur_row, cur_col = 0, 0


