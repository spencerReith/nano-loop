```python
class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        factors = [items[i][0] for i in range(n)]
        prices = [items[i][1] for i in range(n)]
        
        maxF = max(factors)
        cnt = [0] * (maxF + 1)
        for f in factors:
            cnt[f] += 1
        
        # divCount[f] = number of items with factor multiple of f
        divCount = [0] * (maxF + 1)
        for f in range(1, maxF + 1):
            for m in range(f, maxF + 1, f):
                divCount[f] += cnt[m]
        
        L = [divCount[f] - 1 for f in factors]   # max good copies per item
        
        # create list with (price, L, idx) and sort by price
        items_info = [(prices[i], L[i], i) for i in range(n)]
        items_info.sort(key=lambda x: x[0])
        
        taken_good = [0] * n
        rem = budget
        
        # take as many good copies as possible from cheapest items
        for price, L_val, idx in items_info:
            if rem < price:
                # cannot take even one good copy of this item
                continue
            take = min(L_val, rem // price)
            if take > 0:
                taken_good[idx] = take
                rem -= take * price
        
        total_good = sum(taken_good)
        
        # collect prices of items where we used all good capacity
        eligible_prices = []
        for idx in range(n):
            if taken_good[idx] == L[idx]:
                eligible_prices.append(prices[idx])
        
        eligible_prices.sort()
        
        # take bad copies from cheapest eligible items
        total_bad = 0
        for p in eligible_prices:
            if rem < p:
                continue
            take_b = rem // p
            if take_b > 0:
                total_bad += take_b
                rem -= take_b * p
        
        # total items = purchased copies (good + bad) + free copies (good)
        # purchased copies = total_good + total_bad, free copies = total_good
        # total = (total_good + total_bad) + total_good = 2*total_good + total_bad
        return 2 * total_good + total_bad
