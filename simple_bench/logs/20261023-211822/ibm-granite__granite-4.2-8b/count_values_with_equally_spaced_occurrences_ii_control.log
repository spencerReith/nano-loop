class Solution:
    def countSpecialIntegers(self, nums: list[int]) -> int:
        from collections import defaultdict
        
        pos = defaultdict(list)
        for i, v in enumerate(nums):
            pos[v].append(i)
        
        count = 0
        for v, indices in pos.items():
            m = len(indices)
            if m < 3:
                continue
            # check equal spacing
            d = indices[1] - indices[0]
            ok = True
            for k in range(2, m):
                if indices[k] - indices[k-1] != d:
                    ok = False
                    break
            if ok:
                count += 1
        return count
