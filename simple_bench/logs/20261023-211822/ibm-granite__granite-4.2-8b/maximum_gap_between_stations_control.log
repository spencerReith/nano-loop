        # Complexity: O(n log L) where L is list length per skill, total O(n log m) since each station appears in one list.

        import bisect

        n = len(skill)
        m = len(station)

        stations_by_skill = defaultdict(list)
        for idx, ch in enumerate(station):
            stations_by_skill[ch].append(idx)

        # No need to sort because indices are increasing as we append in order.

        pref = [0] * n
        prev = -1
        for i in range(n):
            lst = stations_by_skill[skill[i]]
            # find first index > prev
            pos = bisect.bisect_right(lst, prev)
            # guaranteed pos < len(lst)
            pref[i] = lst[pos]
            prev = pref[i]

        suff = [0] * n
        nxt = m
        for i in range(n-1, -1, -1):
            lst = stations_by_skill[skill[i]]
            # find largest index < nxt
            pos = bisect.bisect_left(lst, nxt) - 1
            # guaranteed pos >= 0
            suff[i] = lst[pos]
            nxt = suff[i]

        ans = 0
        for i in range(n-1):
            gap = suff[i+1] - pref[i]
            if gap > ans:
                ans = gap

        return ans
