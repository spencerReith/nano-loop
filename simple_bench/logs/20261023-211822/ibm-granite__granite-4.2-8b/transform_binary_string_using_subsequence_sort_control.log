```python
class Solution:
    def transformStr(self, s: str, strs: list[str]) -> list[bool]:
        n = len(s)
        # prefix count of ones in s
        ones_s = [0] * n
        cur = 0
        for i, ch in enumerate(s):
            if ch == '1':
                cur += 1
            ones_s[i] = cur
        total_ones_s = ones_s[-1] if n > 0 else 0
        
        ans = []
        for pat in strs:
            # pat length == n
            fixed_ones = pat.count('1')
            q = pat.count('?')
            k = total_ones_s - fixed_ones
            if k < 0 or k > q:
                ans.append(False)
                continue
            
            # compute fixed ones prefix and collect ? indices
            fixed_pref = []
            cur_fixed = 0
            q_indices = []
            for ch in pat:
                if ch == '1':
                    cur_fixed += 1
                elif ch == '?':
                    q_indices.append(len(fixed_pref))  # current index
                # else '0' does nothing
                fixed_pref.append(cur_fixed)
            
            # check fixed_pref <= ones_s pointwise
            ok = True
            for i in range(n):
                if fixed_pref[i] > ones_s[i]:
                    ok = False
                    break
            if not ok:
                ans.append(False)
                continue
            
            # choose k rightmost ? as ones
            q_indices.sort(reverse=True)  # descending
            # take first k indices
            assign_one = [False] * n
            for idx in q_indices[:k]:
                assign_one[idx] = True
            
            # verify with x_pref
            x = 0
            feasible = True
            for i in range(n):
                if pat[i] == '?' and assign_one[i]:
                    x += 1
                if fixed_pref[i] + x > ones_s[i]:
                    feasible = False
                    break
            ans.append(feasible)
        
        return ans
