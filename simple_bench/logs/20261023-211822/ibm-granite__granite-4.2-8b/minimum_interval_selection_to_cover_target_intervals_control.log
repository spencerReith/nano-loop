```python
class Solution:
    def minSelection(self, availableIntervals: list[list[int]], targetIntervals: list[list[int]]) -> int:
        # If no target intervals, nothing to cover
        if not targetIntervals:
            return 0
        
        # Merge target intervals (closed intervals, merge if overlapping or touching)
        target_sorted = sorted(targetIntervals, key=lambda x: x[0])
        merged_target = []
        cur_s, cur_e = target_sorted[0]
        for s, e in target_sorted[1:]:
            if s <= cur_e:  # overlap or touch
                cur_e = max(cur_e, e)
            else:
                merged_target.append([cur_s, cur_e])
                cur_s, cur_e = s, e
        merged_target.append([cur_s, cur_e])
        
        # Sort available intervals by start
        avail = sorted(availableIntervals, key=lambda x: x[0])
        
        # If no available intervals but merged_target not empty -> impossible
        if not avail:
            return -1
        
        m = len(merged_target)
        n = len(avail)
        avail_idx = 0
        selected = 0
        cur = merged_target[0][0]  # smallest required point
        
        j = 0  # index in merged_target
        while j < m:
            # Skip intervals already fully covered
            while j < m and merged_target[j][1] <= cur:
                j += 1
            if j >= m:
                break
            
            # Ensure cur is at least the start of the current merged interval
            if cur < merged_target[j][0]:
                cur = merged_target[j][0]
            
            # Scan all available intervals that start <= cur
            max_r = cur
            while avail_idx < n and avail[avail_idx][0] <= cur:
                max_r = max(max_r, avail[avail_idx][1])
                avail_idx += 1
            
            if max_r <= cur:
                # Cannot extend coverage
                return -1
            
            selected += 1
            cur = max_r
        
        # All merged_target intervals should be covered now
        return selected
