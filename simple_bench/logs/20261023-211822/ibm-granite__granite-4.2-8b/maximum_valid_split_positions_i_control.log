import math
from functools import lru_cache

class Solution:
    def maxValidSplits(self, nums: list[int]) -> int:
        n = len(nums)
        
        def gcd_seg(arr):
            # compute gcd of entire list
            g = arr[0]
            for v in arr[1:]:
                g = math.gcd(g, v)
                if g == 1:
                    break
            return g
        
        def gcd_left(i):
            # gcd of nums[0..i] inclusive
            g = nums[0]
            for j in range(1, i+1):
                g = math.gcd(g, nums[j])
                if g == 1:
                    break
            return g
        
        def gcd_right(i):
            # gcd of nums[i..n-1] inclusive
            g = nums[i]
            for j in range(i+1, n):
                g = math.gcd(g, nums[j])
                if g == 1:
                    break
            return g
        
        # Precompute gcd for all prefixes and suffixes
        pref_g = [0] * n
        g = nums[0]
        pref_g[0] = g
        for i in range(1, n):
            g = math.gcd(g, nums[i])
            pref_g[i] = g
        
        suff_g = [0] * n
        g = nums[n-1]
        suff_g[n-1] = g
        for i in range(n-2, -1, -1):
            g = math.gcd(g, nums[i])
            suff_g[i] = g
        
        # Function to compute score for array after removing one element at idx (idx = -1 means no removal)
        def score_after_remove(rem):
            # rem = -1 means no removal
            if rem == -1:
                arr = nums
            else:
                arr = nums[:rem] + nums[rem+1:]
            m = len(arr)
            if m < 2:
                return 0
            # precompute gcd of prefixes and suffixes for arr
            arr_pref = [0] * m
            g = arr[0]
            arr_pref[0] = g
            for i in range(1, m):
                g = math.gcd(g, arr[i])
                arr_pref[i] = g
            arr_suff = [0] * m
            g = arr[m-1]
            arr_suff[m-1] = g
            for i in range(m-2, -1, -1):
                g = math.gcd(g, arr[i])
                arr_suff[i] = g
            cnt = 0
            for i in range(m-1):
                if arr_pref[i] == arr_suff[i+1]:
                    cnt += 1
            return cnt
        
        # Try all possibilities: no removal or removal of exactly one element
        best = 0
        # no removal
        best = max(best, score_after_remove(-1))
        # removal of one element
        for i in range(n):
            best = max(best, score_after_remove(i))
        
        return best
