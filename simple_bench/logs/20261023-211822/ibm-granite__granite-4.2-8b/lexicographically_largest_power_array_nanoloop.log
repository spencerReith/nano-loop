 class Solution:
    def largestPower(self, nums: list[int]) -> list[int]:
        nums.sort(reverse=True)
        n = len(nums)
        power = [0] * 15
        for k in range(14, -1, -1):  # k from 14 (MSB) down to 0 (LSB)
            mask = 1 << k
            idx = 0
            while idx < n and (nums[idx] & mask) != 0:
                idx += 1
            power[14 - k] = idx
        return power

