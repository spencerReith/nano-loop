class Solution:
    def divisibleGame(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        if all(x == 1 for x in nums):
            return (MOD - 2) % MOD  # -2 mod MOD
        
        primes = set()
        for num in nums:
            if num == 1:
                continue
            temp = num
            d = 2
            while d * d <= temp:
                if temp % d == 0:
                    primes.add(d)
                    while temp % d == 0:
                        temp //= d
                d += 1
            if temp > 1:
                primes.add(temp)
        
        best_D = None
        best_k = None
        for p in primes:
            # compute max subarray sum of A_p
            a0 = nums[0] if nums[0] % p == 0 else -nums[0]
            cur = a0
            max_cur = a0
            for i in range(1, n):
                val = nums[i]
                a = val if val % p == 0 else -val
                cur = max(a, cur + a)
                max_cur = max(max_cur, cur)
            D_k = max_cur
            if best_D is None or D_k > best_D or (D_k == best_D and p < best_k):
                best_D = D_k
                best_k = p
        
        ans = (best_D * best_k) % MOD
        return ans
```

