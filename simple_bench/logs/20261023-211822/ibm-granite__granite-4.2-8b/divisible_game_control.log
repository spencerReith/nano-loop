class Solution:
    def divisibleGame(self, nums: list[int]) -> int:
        MOD = 10**9+7
        n = len(nums)
        min_nums = min(nums)
        D0 = -min_nums
        
        # collect prime divisors
        primes = set()
        for num in nums:
            if num == 1:
                continue
            temp = num
            d = 2
            while d * d <= temp:
                if temp % d == 0:
                    primes.add(d)
                    while temp % d == 0:
                        temp //= d
                d += 1
            if temp > 1:
                primes.add(temp)
        primes = sorted(primes)  # optional
        
        best_D_S = None
        best_k_S = None
        
        for p in primes:
            # compute max subarray sum of A_p
            # first element
            a0 = nums[0] if nums[0] % p == 0 else -nums[0]
            cur = a0
            max_cur = a0
            for i in range(1, n):
                val = nums[i]
                a = val if val % p == 0 else -val
                cur = max(a, cur + a)
                max_cur = max(max_cur, cur)
            D_k = max_cur
            if best_D_S is None or D_k > best_D_S or (D_k == best_D_S and p < best_k_S):
                best_D_S = D_k
                best_k_S = p
        
        # compute k0
        k0 = 2
        while any(num % k0 == 0 for num in nums):
            k0 += 1
        
        if best_D_S is None:  # primes empty
            best_D = D0
            best_k = k0
        else:
            if best_D_S > D0:
                best_D = best_D_S
                best_k = best_k_S
            elif best_D_S < D0:
                best_D = D0
                best_k = k0
            else:  # equal
                best_D = D0  # same
                best_k = min(best_k_S, k0)
        
        ans = (best_D * best_k) % MOD
        return ans

