class Solution:
    def divisibleGame(self, nums: list[int]) -> int:
        MOD = 10**9+7
        n = len(nums)
        if all(x == 1 for x in nums):
            # only ones
            return (-2) % MOD  # which is MOD-2
        # collect prime divisors
        primes = set()
        for num in nums:
            if num == 1:
                continue
            temp = num
            d = 2
            while d * d <= temp:
                if temp % d == 0:
                    primes.add(d)
                    while temp % d == 0:
                        temp //= d
                d += 1
            if temp > 1:
                primes.add(temp)
        # primes set non-empty because at least one num >1
        best_D = None
        best_k = None
        for p in primes:
            # compute Kadane
            a0 = nums[0] if nums[0] % p == 0 else -nums[0]
            cur = a0
