class Solution:
    def minimumGroups(self, words: list[str]) -> int:
        # Booth's algorithm for minimal rotation
        def min_rotation(s: str) -> str:
            n = len(s)
            if n == 0:
                return ""
            ss = s + s
            i = 0
            j = 1
            k = 0
            while i < n and j < n and k < n:
                a = ss[i + k]
                b = ss[j + k]
                if a == b:
                    k += 1
                    continue
                if a > b:
                    i = i + k + 1
                    if i <= j:
                        i = j + 1
                    k = 0
                else:  # a < b
                    j = j + k + 1
                    if j <= i:
                        j = i + 1
                    k = 0
            start = min(i, j)
            return ss[start:start + n]
        
        from collections import defaultdict
        groups = defaultdict(int)
        for word in words:
            even = []
            odd = []
            for idx, ch in enumerate(word):
                if idx % 2 == 0:
                    even.append(ch)
                else:
                    odd.append(ch)
            e_str = ''.join(even)
            o_str = ''.join(odd)
            key = (min_rotation(e_str), min_rotation(o_str))
            groups[key] += 1
        return len(groups)
