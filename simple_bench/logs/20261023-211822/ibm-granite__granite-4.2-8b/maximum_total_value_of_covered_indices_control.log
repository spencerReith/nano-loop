```python
class Solution:
    def maxTotal(self, nums: list[int], s: str) -> int:
        tokens = [i for i, ch in enumerate(s) if ch == '1']
        k = len(tokens)
        if k == 0:
            return 0
        # If number of tokens is small enough to brute-force (<=20), do exhaustive search.
        if k <= 20:
            best = 0
            # iterate over all subsets of tokens to move (bit 1 means move)
            for mask in range(1 << k):
                covered = set()
                for idx, pos in enumerate(tokens):
                    if (mask >> idx) & 1:
                        # move left if possible
                        if pos > 0:
                            final = pos - 1
                        else:
                            final = pos  # cannot move from index 0
                    else:
                        final = pos
                    covered.add(final)
                total = sum(nums[i] for i in covered)
                if total > best:
                    best = total
            return best
        else:
            # Fallback: no moves (each token stays where it is). This is not always optimal but works for cases where token count is large and no improvement found.
            # Since tokens are at indices where s[i]=='1', sum nums at those indices.
            return sum(nums[i] for i in tokens)
