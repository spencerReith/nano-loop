class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        n = len(nums)
        # Precompute pairs for each num: v -> min ops
        pairs_list = []
        for x in nums:
            pairs = {}
            d = 0
            while True:
                # y = floor(x / 2^d)
                # 1 << d is 2^d, for d=0,1,2,...
                if d > 30:  # safety, 2^30 > 500
                    break
                denom = 1 << d
                y = x // denom
                if y == 0:
                    break
                m = 0
                v = y
                ops = d + m
                while v <= sum:
                    if v not in pairs or ops < pairs[v]:
                        pairs[v] = ops
                    m += 1
                    v = y * (1 << m)
                d += 1
            # Convert to list of (v, ops)
            pairs_list.append(list(pairs.items()))
        
        INF = 10**9
        dp = [INF] * (sum + 1)
        dp[0] = 0
        
        for i in range(n):
            pairs_i = pairs_list[i]
            new_dp = [INF] * (sum + 1)
            for s in range(sum + 1):
                if dp[s] == INF:
                    continue
                for v, d in pairs_i:
                    # not include in subset
                    if new_dp[s] > dp[s] + d:
                        new_dp[s] = dp[s] + d
                    # include in subset
                    if s + v <= sum:
                        if new_dp[s + v] > dp[s] + d:
                            new_dp[s + v] = dp[s] + d
            dp = new_dp
        
        ans = dp[sum]
        return -1 if ans >= INF else ans

Wait, in pairs_list[i], d is the ops value, I used d in loop but also d as loop variable; rename:

In pairs computation:
d_div = 0  # number of divisions
while True:
    y = x // (1 << d_div)
    if y == 0: break
    m_mul = 0  # number of multiplications
    v = y
    ops = d_div + m_mul
    while v <= sum:
        ...
    d_div += 1

In the loop, avoid name conflict.

In code above, I used d for d_div and also d in for v,d in pairs_i where d is ops; that's fine since d in pairs_i is ops.

But in pairs computation, `d` is reused; better:

for x in nums:
    pairs = {}
    d_div = 0
    while True:
        denom = 1 << d_div
        y = x // denom
        if y == 0:
            break
        m_mul = 0
        v = y
        ops = d_div + m_mul
        while v <= sum:
            if v not in pairs or ops < pairs[v]:
                pairs[v] = ops
            m_mul += 1
            v = y * (1 << m_mul)
        d_div += 1
    pairs_list.append(list(pairs.items()))

