Now write test.py:

from solution import Solution

def test():
    sol = Solution()
    # Example 1
    nums = [10, 2]
    sum_val = 13
    res = sol.minOperations(nums, sum_val)
    print(f"Example 1: nums={nums}, sum={sum_val}, result={res}, expected=3")
    assert res == 3, f"Got {res}, expected 3"
    
    # Example 2
    nums = [6, 3]
    sum_val = 8
    res = sol.minOperations(nums, sum_val)
    print(f"Example 2: nums={nums}, sum={sum_val}, result={res}, expected=2")
    assert res == 2, f"Got {res}, expected 2"
    
    # Example 3
    nums = [2, 2]
    sum_val = 7
    res = sol.minOperations(nums, sum_val)
    print(f"Example 3: nums={nums}, sum={sum_val}, result={res}, expected=-1")
    assert res == -1, f"Got {res}, expected -1"
    
    # Additional test: nums=[1], sum=1, should be 0
    nums = [1]
    sum_val = 1
    res = sol.minOperations(nums, sum_val)
    print(f"Test 4: nums={nums}, sum={sum_val}, result={res}, expected=0")
    assert res == 0, f"Got {res}, expected 0"
    
    # nums=[1], sum=2: 1→2 in 1 op
    nums = [1]
    sum_val = 2
    res = sol.minOperations(nums, sum_val)
    print(f"Test 5: nums={nums}, sum={sum_val}, result={res}, expected=1")
    assert res == 1, f"Got {res}, expected 1"
    
    # nums=[1], sum=0: impossible since sum>=1 per constraints, but sum>=1, so skip
    # nums=[2], sum=1: 2→1 in 1 op
    nums = [2]
    sum_val = 1
    res = sol.minOperations(nums, sum_val)
    print(f"Test 6: nums={nums}, sum={sum_val}, result={res}, expected=1")
    assert res == 1, f"Got {res}, expected 1"
    
    # nums=[3], sum=2: 3→1→2 in 2 ops
    nums = [3]
    sum_val = 2
    res = sol.minOperations(nums, sum_val)
    print(f"Test 7: nums={nums}, sum={sum_val}, result={res}, expected=2")
    assert res == 2, f"Got {res}, expected 2"
    
    # nums=[3], sum=3: 0 ops
    nums = [3]
    sum_val = 3
    res = sol.minOperations(nums, sum_val)
    print(f"Test 8: nums={nums}, sum={sum_val}, result={res}, expected=0")
    assert res == 0, f"Got {res}, expected 0"
    
    # nums=[3], sum=1: 3→1 in 1 op
    nums = [3]
    sum_val = 1
    res = sol.minOperations(nums, sum_val)
    print(f"Test 9: nums={nums}, sum={sum_val}, result={res}, expected=1")
    assert res == 1, f"Got {res}, expected 1"
    
    print("All tests passed!")

