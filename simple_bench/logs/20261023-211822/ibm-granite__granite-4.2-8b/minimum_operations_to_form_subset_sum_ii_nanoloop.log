def get_pairs(x, total_sum):
    from collections import deque
    queue = deque()
    queue.append((x, 0))  # (value, ops)
    best = {}  # value -> min ops
    best[x] = 0
    while queue:
        val, ops = queue.popleft()
        if ops != best[val]:  # already have better ops, skip
            continue
        # Generate neighbors
        half = val // 2
        if half > 0:
            if half not in best or ops + 1 < best[half]:
                best[half] = ops + 1
                queue.append((half, ops + 1))
        new_val = val * 2
        if new_val <= total_sum:  # only consider <= total_sum
            if new_val not in best or ops + 1 < best[new_val]:
                best[new_val] = ops + 1
                queue.append((new_val, ops + 1))
    return [(v, best[v]) for v in best]

