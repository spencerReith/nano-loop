Revised:

def get_pairs(x, total_sum):
    from collections import deque
    best = {}
    queue = deque()
    # start
    if x <= total_sum:  # always true since x>=1, total_sum>=1
        best[x] = 0
        queue.append((x, 0))
    while queue:
        val, ops = queue.popleft()
        # It's possible ops > best[val] if we pushed val again with higher ops, so check
        if ops > best[val]:
            continue
        # half = val // 2
        half = val // 2
        if half > 0:
            if half not in best or ops + 1 < best[half]:
                best[half] = ops + 1
                queue.append((half, ops + 1))
        new_val = val * 2
        if new_val <= total_sum:
            if new_val not in best or ops + 1 < best[new_val]:
                best[new_val] = ops + 1
                queue.append((new_val, ops + 1))
    return [(v, best[v]) for v in best]

