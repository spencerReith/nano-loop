class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        n = len(nums)
        # Precompute pairs for each num
        pairs_list = []
        for x in nums:
            pairs = {}
            d = 0
            while True:
                y = x // (1 << d)  # floor(x / 2^d)
                if y == 0:
                    break
                m = 0
                v = y
                ops = d + m
                while v <= sum:
                    if v not in pairs or ops < pairs[v]:
                        pairs[v] = ops
                    m += 1
                    v = y * (1 << m)
                d += 1
            pairs_list.append(list(pairs.items()))  # list of (v, ops)
        
        INF = 10**9
        dp = [INF] * (sum + 1)
        dp[0] = 0
        
        for (v_list, ops_list) in zip(pairs_list, map(list, ...)) no, pairs_list[i] is list of (v,ops)
        
        for i in range(n):
            pairs_i = pairs_list[i]
            new_dp = [INF] * (sum + 1)
            for s in range(sum + 1):
                if dp[s] == INF:
                    continue
                for v, d in pairs_i:
                    # not include
                    if new_dp[s] > dp[s] + d:
                        new_dp[s] = dp[s] + d
                    # include
                    if s + v <= sum:
                        if new_dp[s + v] > dp[s] + d:
                            new_dp[s + v] = dp[s] + d
            dp = new_dp
        
        ans = dp[sum]
        return -1 if ans >= INF else ans

But wait, pairs_list[i] should be list of (v,ops), and d in pair is ops.

In get_pairs, ops = d + m, correct.

