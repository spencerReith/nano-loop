Now implement get_pairs:

def get_pairs(x, total_sum):
    pairs = {}  # v -> min ops
    d = 0
    while True:
        y = x >> d  # floor(x / 2^d), since x integer, x// (2**d), but 2**d might be large, better x // (1 << d) if d small
        # Actually, x // (2**d) for d up to log2(x) ~ 9, 2**9=512, fine
        if y == 0:
            break
        m = 0
        v = y
        ops = d + m
        # v = y * 2^m
        while v <= total_sum:
            if v not in pairs or ops < pairs[v]:
                pairs[v] = ops
            m += 1
            v = y * (1 << m)  # y * 2^m
        d += 1
    return list(pairs.items())  # list of (v, ops)

But y = x // (2**d), and 2**d grows fast, d up to about 9 (x<=500), m up to about 13 (sum<=5000), so loop small.

Better:

def get_pairs(x, total_sum):
    pairs = {}
    d = 0
    while True:
        y = x // (1 << d)  # floor(x / 2^d)
        if y == 0:
            break
        m = 0
        v = y
        ops = d + m
        while v <= total_sum:
            if v not in pairs or ops < pairs[v]:
                pairs[v] = ops
            m += 1
            v = y * (1 << m)
        d += 1
    return [(v, pairs[v]) for v in pairs]

