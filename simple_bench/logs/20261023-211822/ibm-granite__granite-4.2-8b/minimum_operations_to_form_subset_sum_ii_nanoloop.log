class Solution:
    def minOperations(self, nums: list[int], sum: int) -> int:
        n = len(nums)
        # Precompute pairs for each num: v -> min ops
        pairs_list = []
        for x in nums:
            pairs = {}
            d_div = 0
            while True:
                denom = 1 << d_div
                y = x // denom
                if y == 0:
                    break
                m_mul = 0
                v = y
                # Generate all v = y * 2^m_mul <= sum
                while v <= sum:
                    ops = d_div + m_mul
                    if v not in pairs or ops < pairs[v]:
                        pairs[v] = ops
                    m_mul += 1
                    v = y * (1 << m_mul)
                d_div += 1
            # Convert to list of (v, ops)
            pairs_list.append(list(pairs.items()))
        
        INF = 10**9
        dp = [INF] * (sum + 1)
        dp[0] = 0
        
        for i in range(n):
            pairs_i = pairs_list[i]
            new_dp = [INF] * (sum + 1)
            for s in range(sum + 1):
                if dp[s] == INF:
                    continue
                for v, d in pairs_i:
                    # not include in subset
                    if new_dp[s] > dp[s] + d:
                        new_dp[s] = dp[s] + d
                    # include in subset
                    if s + v <= sum:
                        if new_dp[s + v] > dp[s] + d:
                            new_dp[s + v] = dp[s] + d
            dp = new_dp
        
        ans = dp[sum]
        return -1 if ans >= INF else ans
```

