```python
class Solution:
    def canMakeSubsequence(self, s: str, t: str) -> bool:
        # check if s is already a subsequence of t
        i = 0
        for ch in t:
            if i < len(s) and s[i] == ch:
                i += 1
        if i == len(s):
            return True

        m, n = len(s), len(t)
        INF = n                     # any value >= n works as "infinite"

        # L[i] = earliest index in t where s[i] is matched when scanning left to right
        L = [INF] * m
        idx = 0
        for j, ch in enumerate(t):
            if idx < m and s[idx] == ch:
                L[idx] = j
                idx += 1

        # R[i] = latest index in t where s[i] is matched when scanning right to left
        R = [-1] * m
        idx = m - 1
        for j in range(n - 1, -1, -1):
            if idx >= 0 and s[idx] == t[j]:
                R[idx] = j
                idx -= 1

        # try replacing exactly one character in s
        for i in range(m):
            # prefix s[0..i-1] must be matchable naturally
            if i > 0 and L[i - 1] == INF:
                continue
            # suffix s[i+1..] must be matchable naturally
            if i + 1 < m and R[i + 1] == -1:
                continue

            left_bound = L[i - 1] if i > 0 else -1
            right_bound = R[i + 1] if i + 1 < m else n

            # need a position p with left_bound < p < right_bound
            if left_bound + 1 < right_bound:
                return True

        return False
