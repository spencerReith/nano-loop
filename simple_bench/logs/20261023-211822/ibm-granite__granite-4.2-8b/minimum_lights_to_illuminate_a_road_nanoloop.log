class Solution:
    def minLights(self, lights: list[int]) -> int:
        n = len(lights)
        if n == 0:
            return 0
        
        # Use difference array to mark coverage from working bulbs
        diff = [0] * (n + 1)
        for i in range(n):
            v = lights[i]
            if v > 0:
                left = max(0, i - v)
                right = min(n - 1, i + v)
                diff[left] += 1
                if right + 1 < n:
                    diff[right + 1] -= 1
        
        # Compute prefix sum to get illumination
        illum = [False] * n
        cur = 0
        for i in range(n):
            cur += diff[i]
            illum[i] = (cur > 0)
        
        # Greedy: iterate through positions, place additional bulbs when needed
        additional = 0
        i = 0
        while i < n:
            if illum[i]:
                # Already illuminated, skip forward
                i += 1
            else:
                # Need to place an additional bulb. Place it at i+1 (covers i, i+1, i+2)
                # If i+1 >= n, place at n-1
                pos = min(i + 1, n - 1)
                additional += 1
                # Mark coverage from this additional bulb
                left = max(0, pos - 1)
                right = min(n - 1, pos + 1)
                for j in range(left, right + 1):
                    illum[j] = True
                # Move forward past the coverage
                i += 3  # bulb covers up to pos+1 = i+2, so next uncovered could be i+3
                if i >= n:
                    break
        
        return additional
