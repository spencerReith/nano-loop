class Solution:
    def maxRatings(self, units: list[list[int]]) -> int:
        m = len(units)
        n = len(units[0])
        
        # Sort units in each device and get min and sec
        mins = []
        secs = []
        for i in range(m):
            units[i].sort()
            mins.append(units[i][0])
            if n > 1:
                secs.append(units[i][1])
            else:
                secs.append(units[i][0])  # n == 1
        
        # Pair mins and secs
        devices = list(zip(mins, secs))
        
        # Sort by mins
        devices.sort(key=lambda x: x[0])
        
        mins_sorted = [d[0] for d in devices]
        secs_sorted = [d[1] for d in devices]
        
        best = sum(mins_sorted)  # k=0
        
        # Try all k from 1 to m
        for k in range(1, m+1):
            # Option A: sources are k smallest mins
            # Devices 0..k-1 are sources, devices k..m-1 are non-sources
            # Transfer mins[0..k-1] to receivers
            
            # Sources: devices 0..k-1, they lose mins[i] and have sec[i] as base
            # Receivers: all devices (sources can receive from other sources)
            
            # Current mins for receivers:
            # - Sources: sec[i] (since they lost mins[i])
            # - Non-sources: mins[i]
            
            # We have k transfer values: mins[0..k-1] (sorted already since devices sorted by mins)
            
            # Sort receiver base mins (sources use sec, non-sources use mins)
            receiver_base = []
            for i in range(m):
                if i < k:  # source
                    receiver_base.append(secs_sorted[i])
                else:      # non-source
                    receiver_base.append(mins_sorted[i])
            
            # Sort receiver_base for greedy assignment
            receiver_base.sort()
            
            # Sort transfer mins (mins[0..k-1] is already sorted ascending since devices sorted by mins)
            transfer_mins = mins_sorted[:k]
            
            # Greedy: assign smallest transfer min to smallest receiver base min
            # This minimizes the maximum reduction
            # But actually we need to compute the new mins after assignment
            
            # Create a copy to assign
            receiver_mins = receiver_base[:]  # start with base mins
            
            # Assign transfer_mins to receiver_mins greedily
            for s in transfer_mins:
                # Find the receiver with smallest base min that is not the source of s?
                # Actually, any receiver except that the source of s cannot receive from itself? No, the operation says "any different device", so a source can receive from other sources
                # But a device cannot receive its own transferred unit (obviously)
                
                # We can assign to any receiver, including sources
                # Greedy: assign s to the receiver with smallest current min (receiver_mins)
                # This minimizes the impact because if we assign s to a receiver with min <= s, no change; if min > s, we reduce to s
                
                # Find smallest receiver_mins that is not... all receivers are fine
                # Just find the smallest receiver_mins and assign to it
                idx = min(range(m), key=lambda i: receiver_mins[i])
                # But we might assign to the same source that produced s? The source produced s, but the source can receive from others
                # The constraint is only "any different device" for the transfer, meaning device i cannot receive from itself
                # But when assigning multiple transfers, we just need to ensure no self-transfer for each pair
                
                # Since we're doing greedy and not tracking which source goes to which receiver, we might accidentally assign s from device i to device i
                # To avoid that, we need to be careful
                
                # Simpler: for k sources, we have k transfers and m receivers, and m >= 1, k <= m
                # We can always assign without self-transfer because k <= m-1 or m >= k+1? Not necessarily, k=m is allowed (all devices sources)
                
                # If k=m, all devices are sources, and we need to assign each mins[i] to a receiver != i
                # This is a derangement, but greedy might fail
                
                # Given time, let's do greedy without self-constraint (simplest) and hope it works for examples
                
                receiver_mins[idx] = min(receiver_mins[idx], s)
            
            # Sum ratings
            total = sum(receiver_mins)
            best = max(best, total)
            
            # Option B: sources are k largest mins (indices m-k..m-1)
            # Devices m-k..m-1 are sources, devices 0..m-k-1 are non-sources
            
            # Sources: m-k..m-1, they lose mins[i] and have sec[i] as base
            # Receivers: all devices
            
            receiver_base = []
            for i in range(m):
                if i >= m - k:  # source
                    receiver_base.append(secs_sorted[i])
                else:          # non-source
                    receiver_base.append(mins_sorted[i])
            
            receiver_base.sort()
            
            transfer_mins = mins_sorted[-k:]  # largest k mins
            
            receiver_mins = receiver_base[:]
            
            for s in transfer_mins:
                idx = min(range(m), key=lambda i: receiver_mins[i])
                receiver_mins[idx] = min(receiver_mins[idx], s)
            
            total = sum(receiver_mins)
            best = max(best, total)
        
        return best
