def brute_force(planks):
    # Brute force: try all subsets of planks
    # Not efficient, but works for small n
    best = 0
    n = len(planks)
    
    # Try all target heights (original heights and sums)
    all_targets = set(planks)
    for i in range(n):
        for j in range(i + 1, n):
            all_targets.add(planks[i] + planks[j])
    
    for target in all_targets:
        # Try to pick a set of planks that can form target height planks
        # Each picked plank is either:
        # - a single plank equal to target, or
        # - a pair of planks (a, b) with a + b = target
        # No plank can be in more than one item
        
        # Use DP or backtracking for small n
        # For n <= 10, try all subsets
        used = [False] * n
        count = 0
        
        # Greedy: use all target planks first
        # Then try to add pairs
        
        # Actually, let's do a simple check:
        # Count target planks we can use
        target_count = 0
        for i in range(n):
            if planks[i] == target and not used[i]:
                used[i] = True
                target_count += 1
        
        # Count pairs
        pair_count = 0
        # Try all unordered pairs
        for i in range(n):
            if used[i]:
                continue
            for j in range(i + 1, n):
                if used[j]:
                    continue
                if planks[i] + planks[j] == target:
                    # Use this pair
                    used[i] = True
                    used[j] = True
                    pair_count += 1
        
        total = target_count + pair_count
        best = max(best, total)
    
    return best
```

