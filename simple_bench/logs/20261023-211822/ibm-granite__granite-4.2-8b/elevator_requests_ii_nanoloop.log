def dp_solve(start, points):
    m = len(points)
    INF = 10**18
    full = 1<<m
    penalty = [[INF]*m for _ in range(full)]
    time = [[0]*m for _ in range(full)]
    for i in range(m):
        mask = 1<<i
        d0 = abs(start - points[i])
        penalty[mask][i] = d0
        time[mask][i] = d0
    for mask in range(full):
        for i in range(m):
            if not (mask & (1<<i)): continue
            if penalty[mask][i] == INF: continue
            for j in range(m):
                if mask & (1<<j): continue
                new_mask = mask | (1<<j)
                d = abs(points[i] - points[j])
                nt = time[mask][i] + d
                np = penalty[mask][i] + nt
                if np < penalty[new_mask][j]:
                    penalty[new_mask][j] = np
                    time[new_mask][j] = nt
    full_mask = full-1
    best = min(penalty[full_mask][i] for i in range(m))
    # print penalty[full_mask]
    return best
```

