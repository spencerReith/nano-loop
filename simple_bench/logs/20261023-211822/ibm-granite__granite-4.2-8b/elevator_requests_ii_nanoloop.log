```python
class Solution:
    def elevatorRequests(self, n: int, start: int, requests: list[int]) -> int:
        # Remove start if present (already fulfilled at time 0)
        reqs = requests[:]
        if start in reqs:
            reqs.remove(start)
        m = len(reqs)
        if m == 0:
            return 0
        if m <= 15:  # use DP over subsets
            points = reqs
            # sort? DP works on original order? The DP considers points in given order? It should work regardless of order, but to reduce state maybe sort? Actually DP over subsets doesn't require sorting; it considers all permutations. Sorting might help with symmetry but not needed. We'll keep as is.
            # However we need to ensure that the points are distinct (they are).
            # We'll use DP as described.
            INF = 10**18
            full = 1 << m
            penalty = [[INF] * m for _ in range(full)]
            time = [[0] * m for _ in range(full)]
            for i in range(m):
                mask = 1 << i
                d0 = abs(start - points[i])
                penalty[mask][i] = d0
                time[mask][i] = d0
            for mask in range(full):
                for i in range(m):
                    if not (mask & (1 << i)):
                        continue
                    if penalty[mask][i] == INF:
                        continue
                    for j in range(m):
                        if mask & (1 << j):
                            continue
                        new_mask = mask | (1 << j)
                        d = abs(points[i] - points[j])
                        new_time = time[mask][i] + d
                        new_penalty = penalty[mask][i] + new_time
                        if new_penalty < penalty[new_mask][j]:
                            penalty[new_mask][j] = new_penalty
                            time[new_mask][j] = new_time
            full_mask = full - 1
            ans_dp = min(penalty[full_mask][i] for i in range(m))
            return ans_dp
        else:
            # heuristic: left and right sides
            left = [x for x in reqs if x < start]
            right = [x for x in reqs if x > start]
            left.sort()
            right.sort()
            left_order = list(reversed(left))
            right_order = right
            def penalty(order):
                cur = start
                t = 0
                total = 0
                for r in order:
                    dist = abs(cur - r)
                    cur = r
                    t += dist
                    total += t
                return total
            p1 = penalty(left_order + right_order)
            p2 = penalty(right_order + left_order)
            return min(p1, p2)
```

