class Solution:
    def filterOccupiedIntervals(self, occupiedIntervals: list[list[int]], freeStart: int, freeEnd: int) -> list[list[int]]:
        if not occupiedIntervals:
            return []
        
        # Sort by start time
        occupiedIntervals.sort(key=lambda x: x[0])
        
        # Merge intervals
        merged = []
        cur_start, cur_end = occupiedIntervals[0]
        for start, end in occupiedIntervals[1:]:
            if start <= cur_end + 1:  # overlap or touch
                cur_end = max(cur_end, end)
            else:
                merged.append([cur_start, cur_end])
                cur_start, cur_end = start, end
        merged.append([cur_start, cur_end])
        
        # Remove free interval
        result = []
        for start, end in merged:
            # No overlap
            if end < freeStart:
                result.append([start, end])
            # No overlap after free interval
            elif start > freeEnd:
                result.append([start, end])
            # Overlaps with free interval - split if needed
            else:
                # interval starts before or inside free interval and ends after or inside free interval
                # We need to take parts outside [freeStart, freeEnd]
                if start < freeStart:
                    # part before freeStart
                    result.append([start, freeStart - 1])
                if end > freeEnd:
                    # part after freeEnd
                    result.append([freeEnd + 1, end])
        return result
