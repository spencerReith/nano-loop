def minAdjacentSwaps(self, nums, a, b):
    MOD = 10**9+7
    n = len(nums)
    cat = []
    for x in nums:
        if x < a:
            cat.append(0)  # L
        elif x <= b:  # a <= x <= b
            cat.append(1)  # M
        else:
            cat.append(2)  # R
    # But note: condition is a <= x <= b for M. Since a < b, and x integer.
    # We'll compute counts
    cntL = cat.count(0)
    cntM = cat.count(1)
    cntR = cat.count(2)
    # assign targets
    target = [0]*n
    l_pos = 0
    m_pos = cntL
    r_pos = cntL+cntM
    for i, c in enumerate(cat):
        if c == 0:
            target[i] = l_pos
            l_pos += 1
        elif c == 1:
            target[i] = m_pos
            m_pos += 1
        else:
            target[i] = r_pos
            r_pos += 1
    # inversion count using BIT
    size = n
    bit = [0]*(size+1)
    def bit_update(i, delta):
        i += 1  # 1-indexed BIT
        while i <= size:
            bit[i] += delta
            i += i & -i
    def bit_query(i):  # prefix sum [0,i] inclusive? We'll implement prefix sum up to index i (0-indexed). We'll use 1-indexed internally.
        # query sum of indices 0..i
        i += 1
        s = 0
        while i > 0:
            s += bit[i]
            i -= i & -i
        return s
    # To count numbers greater than current target[j] among previous: total_seen - prefix_sum(target[j])
    total = 0
    inversions = 0
    for val in target:
        # query count of previous elements with value <= val
        le = bit_query(val)  # includes those equal? Since permutation, no equal except itself, but fine.
        # total seen so far = number of previous elements
        seen = total
        greater = seen - le
        inversions += greater
        bit_update(val, 1)
        total += 1
    return inversions % MOD

But we must be careful: bit_query(val) returns count of previous elements with index <= val. Since val is unique, le = number of previous with target <= val. Then greater = seen - le counts previous with target > val, which are inversions where earlier element has larger target value. That's correct.

