Now output the code block.
```python
class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        # categorize elements
        cat = []
        for x in nums:
            if x < a:
                cat.append(0)          # L
            elif x <= b:               # a <= x <= b
                cat.append(1)          # M
            else:
                cat.append(2)          # R
        
        cntL = cat.count(0)
        cntM = cat.count(1)
        cntR = cat.count(2)
        
        # assign target positions: all L first (in original order), then M, then R
        target = [0] * n
        l_pos = 0
        m_pos = cntL
        r_pos = cntL + cntM
        for i, c in enumerate(cat):
            if c == 0:
                target[i] = l_pos
                l_pos += 1
            elif c == 1:
                target[i] = m_pos
                m_pos += 1
            else:
                target[i] = r_pos
                r_pos += 1
        
        # Fenwick tree to count inversions in target permutation
        bit = [0] * (n + 1)
        def update(idx, delta):
            idx += 1
            while idx <= n:
                bit[idx] += delta
                idx += idx & -idx
        def query(idx):
            # prefix sum [0..idx]
            idx += 1
            res = 0
            while idx > 0:
                res += bit[idx]
                idx -= idx & -idx
            return res
        
        inv = 0
        seen = 0
        for val in target:
            le = query(val)            # # previous with value <= val
            greater = seen - le        # # previous with value > val  -> inversions
            inv += greater
            update(val, 1)
            seen += 1
        
        return inv % MOD
```
