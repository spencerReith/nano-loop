class Solution:
    def minAdjacentSwaps(self, nums: list[int], a: int, b: int) -> int:
        MOD = 10**9 + 7
        n = len(nums)
        cat = []
        for x in nums:
            if x < a:
                cat.append(0)
            elif x <= b:  # since a < b, and x integer, x <= b ensures x >= a? Not necessarily if x < a already caught, so yes.
                cat.append(1)
            else:
                cat.append(2)
        cntL = cat.count(0)
        cntM = cat.count(1)
        cntR = cat.count(2)
        target = [0]*n
        l_pos = 0
        m_pos = cntL
        r_pos = cntL + cntM
        for i, c in enumerate(cat):
            if c == 0:
                target[i] = l_pos
                l_pos += 1
            elif c == 1:
                target[i] = m_pos
                m_pos += 1
            else:
                target[i] = r_pos
                r_pos += 1
        # Fenwick tree
        bit = [0]*(n+1)
        def update(idx, delta):
            idx += 1
            while idx <= n:
                bit[idx] += delta
                idx += idx & -idx
        def query(idx):
            # prefix sum [0..idx]
            idx += 1
            res = 0
            while idx > 0:
                res += bit[idx]
                idx -= idx & -idx
            return res
        inv = 0
        seen = 0
        for val in target:
            # number of previous elements with value > val
            le = query(val)  # count of previous <= val
            greater = seen - le
            inv += greater
            update(val, 1)
            seen += 1
        return inv % MOD
```

But we need to ensure that query(val) returns count of previous elements with index <= val. Since we update after counting, at the point we process val, we haven't updated for current val, so seen = number of previous elements. le = query(val) gives count of previous elements with target <= val. Then greater = seen - le gives previous elements with target > val, which are inversions where earlier element has larger target. That's correct.

