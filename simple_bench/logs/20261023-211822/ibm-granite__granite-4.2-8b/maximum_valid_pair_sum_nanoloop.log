write_file('solution.py', '''
class Solution:
    def maxValidPairSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        max_sum = 0
        
        # For each i, the smallest j we can pair with is i+k
        # So for each i, we need to consider nums[i] + max(nums[i+k:n])
        # We can precompute suffix maximums to make this efficient
        
        # suffix_max[j] = max(nums[j:])
        suffix_max = [0] * n
        suffix_max[-1] = nums[-1]
        for i in range(n-2, -1, -1):
            suffix_max[i] = max(nums[i], suffix_max[i+1])
        
        max_sum = 0
        for i in range(n - k):
            # j must be at least i+k
            # suffix_max[i+k] gives us max(nums[i+k:])
            current_max = nums[i] + suffix_max[i+k]
            if current_max > max_sum:
                max_sum = current_max
        
        return max_sum
''')

