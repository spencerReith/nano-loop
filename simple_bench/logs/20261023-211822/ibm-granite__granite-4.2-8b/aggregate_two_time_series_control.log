class Solution:
    def aggregateTimeSeries(self, series1: list[list[int]], series2: list[list[int]]) -> list[list[int]]:
        # Helper to get value at timestamp t given series
        def get_val(series, t):
            # Find the smallest timestamp >= t
            i = 0
            while i < len(series) and series[i][0] < t:
                i += 1
            if i < len(series):
                return series[i][1]
            return 0
        
        # Merge all unique timestamps from both series
        timestamps = set()
        for ts, _ in series1:
            timestamps.add(ts)
        for ts, _ in series2:
            timestamps.add(ts)
        
        # Sort timestamps
        timestamps = sorted(timestamps)
        
        # Build aggregated series
        res = []
        for ts in timestamps:
            v1 = get_val(series1, ts)
            v2 = get_val(series2, ts)
            res.append([ts, v1 + v2])
        
        return res
