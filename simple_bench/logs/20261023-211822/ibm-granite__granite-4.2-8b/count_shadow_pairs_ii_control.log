class Solution:
    def shadowPairs(self, nums: list[int]) -> int:
        n = len(nums)
        count = 0
        for j in range(n):
            # max_less is the maximum value among elements in (i, j) that are < nums[j]
            # Initialize to -1 because all nums[i] >= 1, so -1 works as -inf.
            max_less = -1
            for i in range(j - 1, -1, -1):
                if nums[i] < nums[j]:
                    if nums[i] >= max_less:
                        count += 1
                    if nums[i] > max_less:
                        max_less = nums[i]
        return count
