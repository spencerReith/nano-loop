class Solution:
    def countOfPeaks(self, nums: list[int], queries: list[list[int]]) -> list[int]:
        # brute force for small n
        # we need to process queries sequentially: type 1 query answer depends on current nums state after previous updates
        n = len(nums)
        # make a copy of nums that we will update
        cur = nums[:]
        answers = []
        for q in queries:
            if q[0] == 1:
                l = q[1]
                r = q[2]
                # count peak subarrays within [l, r]
                cnt = 0
                # iterate all subarrays of length >=3 within [l, r]
                # but that's O(n^2) which may be too slow for n up to 1e5 in worst case
                # however for small examples it works
                for i in range(l, r - 1):  # i is start
                    for j in range(i + 2, r + 1):  # j is end inclusive
                        # check if there exists k with i < k < j such that cur[k] > cur[k-1] and cur[k] > cur[k+1]
                        found = False
                        for k in range(i + 1, j):
                            if cur[k] > cur[k-1] and cur[k] > cur[k+1]:
                                found = True
                                break
                        if found:
                            cnt += 1
                answers.append(cnt)
            else:  # type 2 update
                idx = q[1]
                val = q[2]
                cur[idx] = val
        return answers
