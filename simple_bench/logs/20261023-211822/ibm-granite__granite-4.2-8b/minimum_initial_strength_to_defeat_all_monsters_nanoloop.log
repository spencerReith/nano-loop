from solution import Solution
import random

def brute(monsters, boosts):
    n = len(monsters)
    # compute bonus
    diff = [0] * (n + 1)
    for l, r, v in boosts:
        diff[l] += v
        diff[r + 1] -= v
    bonus = [0] * n
    cur = 0
    for i in range(n):
        cur += diff[i]
        bonus[i] = cur
    
    def simulate(init):
        cur_s = init
        for i in range(n):
            if cur_s + bonus[i] < monsters[i]:
                return False
            cur_s = max(0, cur_s - monsters[i])
        return True
    
    # try from 0 to sum(monsters)
    total = sum(monsters)
    for init in range(total + 1):
        if simulate(init):
            return init
    return total  # should not happen

def test_random():
    sol = Solution()
    random.seed(123)
    for _ in range(1000):
        n = random.randint(1, 5)
        monsters = [random.randint(1, 10) for _ in range(n)]
        m = random.randint(0, 3)
        boosts = []
        for __ in range(m):
            l = random.randint(0, n-1)
            r = random.randint(l, n-1)
            v = random.randint(1, 10)
            boosts.append([l, r, v])
        
        ans_sol = sol.minInitialStrength(monsters, boosts)
        ans_brute = brute(monsters, boosts)
        if ans_sol != ans_brute:
            print("Mismatch!")
            print(f"monsters={monsters}")
            print(f"boosts={boosts}")
            print(f"sol={ans_sol}, brute={ans_brute}")
            return False
    print("All random small tests passed")
    return True

if __name__ == "__main__":
    test_random()

