class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        if n == 0:
            return 0
        
        # compute bonus array
        diff = [0] * (n + 1)
        for l, r, v in boosts:
            diff[l] += v
            if r + 1 < n:
                diff[r + 1] -= v
            # if r == n-1, diff[n] would be used but we don't need it for bonus[0..n-1]
        
        bonus = [0] * n
        cur_bonus = 0
        for i in range(n):
            cur_bonus += diff[i]
            bonus[i] = cur_bonus
        
        def simulate(init):
            cur = init
            for i in range(n):
                if cur + bonus[i] < monsters[i]:
                    return False
                cur = max(0, cur - monsters[i])
            return True
        
        lo = 0
        hi = sum(monsters)  # inclusive? we'll use lo < hi style
        
        # binary search for smallest init that works
        while lo < hi:
            mid = (lo + hi) // 2
            if simulate(mid):
                hi = mid
            else:
                lo = mid + 1
        return lo

