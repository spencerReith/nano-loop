class Solution:
    def minInitialStrength(self, monsters: list[int], boosts: list[list[int]]) -> int:
        n = len(monsters)
        if n == 0:
            return 0
        
        # compute bonus array
        diff = [0] * (n + 1)
        for l, r, v in boosts:
            diff[l] += v
            diff[r + 1] -= v
        
        bonus = [0] * n
        cur_bonus = 0
        for i in range(n):
            cur_bonus += diff[i]
            bonus[i] = cur_bonus
        
        def simulate(init):
            cur = init
            for i in range(n):
                if cur + bonus[i] < monsters[i]:
                    return False
                cur = max(0, cur - monsters[i])
            return True
        
        lo = 0
        hi = sum(monsters)
        
        while lo < hi:
            mid = (lo + hi) // 2
            if simulate(mid):
                hi = mid
            else:
                lo = mid + 1
        return lo
