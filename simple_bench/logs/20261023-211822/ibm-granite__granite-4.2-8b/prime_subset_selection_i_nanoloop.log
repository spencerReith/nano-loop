```python
class Solution:
    def maxPrimes(self, n: int, s: int) -> list[int]:
        if n < 2:
            return []
        
        # sieve
        is_prime = [True] * (n + 1)
        is_prime[0] = is_prime[1] = False
        if n >= 4:
            for i in range(2, int(n ** 0.5) + 1):
                if is_prime[i]:
                    for j in range(i * i, n + 1, i):
                        is_prime[j] = False
        primes = [i for i, val in enumerate(is_prime) if val]
        m = len(primes)
        
        # prefix sums
        prefix = [0] * (m + 1)
        for i in range(1, m + 1):
            prefix[i] = prefix[i - 1] + primes[i - 1]
        
        # find max k
        k = 0
        for i in range(1, m + 1):
            if prefix[i] <= s:
                k = i
            else:
                break
        
        if k == 0:
            return []
        
        # greedy with binary search
        start = 0
        remaining = k
        total = 0
        result = []
        
        for _ in range(k):
            r = remaining
            budget = s - total
            lo = start
            hi = m - r
            # binary search for largest i in [lo, hi] with prefix[i+r] - prefix[i] <= budget
            ans = lo - 1
            while lo <= hi:
                mid = (lo + hi) // 2
                diff = prefix[mid + r] - prefix[mid]  # sum of r primes starting at mid
                if diff <= budget:
                    ans = mid
                    lo = mid + 1
                else:
                    hi = mid - 1
            # ans is the largest valid index
            # sanity check: ans should be >= start
            i = ans
            result.append(primes[i])
            total += primes[i]
            start = i + 1
            remaining -= 1
        
        return result
```

