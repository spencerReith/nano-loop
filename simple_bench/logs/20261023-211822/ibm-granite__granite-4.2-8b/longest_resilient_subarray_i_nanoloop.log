In Python:

import math

class Solution:
    def resilientSubarray(self, nums: list[int], k: int) -> int:
        if not nums:
            return 0
        
        max_len = 0
        i = 0
        n = len(nums)
        
        while i < n:
            r = nums[i] % k
            j = i
            while j < n and nums[j] % k == r:
                j += 1
            M = j - i  # length of block
            
            g = math.gcd(r, k)
            k_prime = k // g
            
            # m = 1 + t*k_prime, max m <= M
            # t_max = floor((M-1)/k_prime)
            m_max = 1 + k_prime * ((M - 1) // k_prime)
            
            if m_max > max_len:
                max_len = m_max
            
            i = j
        
        return max_len

