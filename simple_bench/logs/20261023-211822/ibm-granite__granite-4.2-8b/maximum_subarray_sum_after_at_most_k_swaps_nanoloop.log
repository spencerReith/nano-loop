class Solution:
    def maxSum(self, nums: list[int], k: int) -> int:
        n = len(nums)
        if k == 0:
            # Kadane
            best = nums[0]
            cur = nums[0]
            for i in range(1, n):
                cur = max(nums[i], cur + nums[i])
                best = max(best, cur)
            return best
        
        best = max(nums)  # at least max element
        
        def dfs(arr, depth_left):
            nonlocal best
            # compute current max subarray sum
            cur_best = arr[0]
            cur = arr[0]
            for val in arr[1:]:
                cur = max(val, cur + val)
                cur_best = max(cur_best, cur)
            best = max(best, cur_best)
            
            if depth_left == 0:
                return
            for i in range(n):
                for j in range(i+1, n):
                    arr[i], arr[j] = arr[j], arr[i]
                    dfs(arr, depth_left-1)
                    arr[i], arr[j] = arr[j], arr[i]
        
        dfs(nums[:], k)
        return best
```

