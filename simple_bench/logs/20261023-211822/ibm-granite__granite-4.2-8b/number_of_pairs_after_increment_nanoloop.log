```python
class Solution:
    def numberOfPairs(self, nums1: list[int], nums2: list[int], queries: list[list[int]]) -> list[int]:
        # Make copies to avoid modifying input
        nums1 = nums1[:]
        nums2 = nums2[:]
        n1 = len(nums1)
        n2 = len(nums2)
        answer = []
        
        for q in queries:
            if q[0] == 1:
                _, x, y, val = q
                # Add val to nums2[x..y]
                for k in range(x, y+1):
                    nums2[k] += val
            else:  # q[0] == 2
                _, tot = q
                # Count pairs (j, k) such that nums1[j] + nums2[k] == tot
                count = 0
                # For each nums1[j], count how many nums2[k] equal tot - nums1[j]
                # Since nums1 is small, we can iterate through nums1 and scan nums2
                # Or use a frequency map for nums2
                from collections import Counter
                freq = Counter(nums2)
                for num1 in nums1:
                    target = tot - num1
                    if target in freq:
                        count += freq[target]
                answer.append(count)
        
        return answer
```

