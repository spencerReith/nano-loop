```python
class Solution:
    def numberOfPairs(self, nums1: list[int], nums2: list[int], queries: list[list[int]]) -> list[int]:
        nums1 = nums1[:]
        base_nums2 = nums2[:]
        n2 = len(base_nums2)
        diff = [0] * (n2 + 1)
        answer = []
        
        for q in queries:
            if q[0] == 1:
                _, x, y, val = q
                diff[x] += val
                if y + 1 < n2 + 1:
                    diff[y + 1] -= val
            else:  # q[0] == 2
                _, tot = q
                # Reconstruct nums2 from base_nums2 and diff
                nums2_current = [0] * n2
                current = 0
                for k in range(n2):
                    current += diff[k]
                    nums2_current[k] = base_nums2[k] + current
                
                # Count pairs
                from collections import Counter
                freq = Counter(nums2_current)
                count = 0
                for num1 in nums1:
                    target = tot - num1
                    if target in freq:
                        count += freq[target]
                answer.append(count)
        
        return answer
```

