class Solution:
    def shortestPath(self, n: int, edges: list[list[int]], labels: str, k: int) -> int:
        from collections import defaultdict
        INF = 10**18
        
        # adjacency list
        adj = defaultdict(list)
        for u, v, w in edges:
            adj[u].append((v, w))
        
        # Dijkstra's priority queue with state (dist, node, consecutive_same, last_char)
        import heapq
        pq = []
        # start at node 0, consecutive_same = 0 because we haven't traversed any character yet?
        # But the path starts with node 0's label, so consecutive count = 1 for first node?
        # We'll treat state after including node 0's label.
        start_char = labels[0]
        # initial consecutive same = 1
        heapq.heappush(pq, (0, 0, 1, start_char))
        
        # best[node][c][cnt] = minimal distance to reach node with last character c and consecutive count cnt (1 <= cnt <= k)
        # c is a character, cnt up to k.
        # We'll use dict: best[(node, c, cnt)] = dist
        best = defaultdict(lambda: INF)
        best[(0, start_char, 1)] = 0
        
        while pq:
            dist, node, cnt, ch = heapq.heappop(pq)
            if dist != best[(node, ch, cnt)]:
                continue
            if node == n - 1:
                # we can return dist immediately? Not necessarily, because there might be a shorter path with different cnt/ch?
                # But since we are using Dijkstra, the first time we pop node n-1 we have the minimal distance for that state.
                # However there might be another state for node n-1 with smaller dist? Dijkstra guarantees that the first popped for node n-1 is minimal overall? 
                # Actually, because we have multiple states (cnt,ch), the global minimum for node n-1 might be in another state not popped yet? 
                # But Dijkstra pops by distance, so the smallest distance among all states of node n-1 will be popped first. So we can return dist when we pop node n-1.
                # However, we must ensure that the state we popped satisfies the constraint (cnt <= k). It does because we only push states with cnt <= k.
                return dist
            
            for nxt, w in adj[node]:
                nxt_char = labels[nxt]
                if nxt_char == ch:
                    new_cnt = cnt + 1
                    if new_cnt <= k:
                        new_state = (nxt, nxt_char, new_cnt)
                        new_dist = dist + w
                        if new_dist < best[new_state]:
                            best[new_state] = new_dist
                            heapq.heappush(pq, (new_dist, nxt, new_cnt, nxt_char))
                else:
                    # different character, reset consecutive count to 1
                    new_cnt = 1
                    new_state = (nxt, nxt_char, 1)
                    new_dist = dist + w
                    if new_dist < best[new_state]:
                        best[new_state] = new_dist
                        heapq.heappush(pq, (new_dist, nxt, 1, nxt_char))
        
        # if we exit loop, no valid path
        return -1
