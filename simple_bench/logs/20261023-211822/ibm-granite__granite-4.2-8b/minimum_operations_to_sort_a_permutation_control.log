class Solution:
    def minOperations(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return 0
        
        # Check if nums is a rotation of sorted [0,1,...,n-1]
        c1 = (nums[0] - 0) % n
        ok1 = all((nums[i] - i) % n == c1 for i in range(n))
        
        # Check if nums is a rotation of rev_sorted [n-1, n-2, ..., 0]
        c2 = (nums[0] + 0) % n
        ok2 = all((nums[i] + i) % n == c2 for i in range(n))
        
        if not ok1 and not ok2:
            return -1
        
        INF = 10**9
        ans = INF
        
        # helper to get index of 0
        def idx_zero(arr):
            return arr.index(0)
        
        rev = nums[::-1]
        
        if ok1:
            # rotations only
            idx0 = (n - nums[0]) % n  # left rotations to bring 0 to front
            ans = min(ans, idx0)
            # check if rev is a rotation of sorted
            c1_rev = (rev[0] - 0) % n
            if all((rev[i] - i) % n == c1_rev for i in range(n)):
                idx0_rev = idx_zero(rev)
                ans = min(ans, 1 + idx0_rev)
        
        if ok2:
            # reverse first then rotate
            idx0_rev = idx_zero(rev)
            c1_rev = (rev[0] - 0) % n
            if all((rev[i] - i) % n == c1_rev for i in range(n)):
                ans = min(ans, 1 + idx0_rev)
            # rotate then reverse
            d = (n - 1 - c2) % n
            k_needed = (n - d) % n
            ans = min(ans, k_needed + 1)
        
        return ans if ans != INF else -1
