```python
class Solution:
    def largestPower(self, nums: list[int]) -> list[int]:
        nums.sort(reverse=True)
        n = len(nums)
        power = [0] * 15
        for b in range(14, -1, -1):
            j = 0
            while j < n and (nums[j] >> b) & 1:
                j += 1
            power[14 - b] = j
        return power
