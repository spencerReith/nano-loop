```python
class Solution:
    def countGoodRotations(self, nums: list[int]) -> int:
        n = len(nums)
        half = n // 2
        total_sum = sum(nums)
        
        # Precompute prefix sums
        prefix = [0] * (n + 1)
        for i in range(n):
            prefix[i + 1] = prefix[i] + nums[i]
        
        def sum_range(start, length):
            """Get sum of nums[start:start+length] with wrap-around."""
            if start + length <= n:
                return prefix[start + length] - prefix[start]
            else:
                # Wrap around: nums[start:] + nums[0:start+length-n]
                return (prefix[n] - prefix[start]) + (prefix[start + length - n] - prefix[0])
        
        count = 0
        for k in range(n):
            # For rotation by k, first half is nums[k:k+half]
            first_half_sum = sum_range(k, half)
            if first_half_sum * 2 > total_sum:  # first_half_sum > total_sum / 2
                count += 1
        
        return count
```
