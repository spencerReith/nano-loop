from solution import Solution

def test():
    sol = Solution()
    
    # Example 1
    items1 = [[1,6],[2,4],[3,5]]
    budget1 = 19
    res1 = sol.maximumSaleItems(items1, budget1)
    print(f"Example 1: items={items1}, budget={budget1}, res={res1}, expected=5, {'PASS' if res1==5 else 'FAIL'}")
    
    # Example 2
    items2 = [[2,8],[1,10],[6,6],[4,12],[5,20],[5,17]]
    budget2 = 35
    res2 = sol.maximumSaleItems(items2, budget2)
    print(f"Example 2: items={items2}, budget={budget2}, res={res2}, expected=7, {'PASS' if res2==7 else 'FAIL'}")
    
    # Edge: no items
    items3 = []
    budget3 = 10
    res3 = sol.maximumSaleItems(items3, budget3)
    print(f"Edge no items: res={res3}, expected=0, {'PASS' if res3==0 else 'FAIL'}")
    
    # Edge: one item, no free
    items4 = [[1,5]]
    budget4 = 10
    res4 = sol.maximumSaleItems(items4, budget4)
    # d=0, only low-value, buy floor(10/5)=2 copies, total=2
    print(f"One item: items={items4}, budget={budget4}, res={res4}, expected=2, {'PASS' if res4==2 else 'FAIL'}")
    
    # Edge: two items both f=1
    items5 = [[1,5],[1,3]]
    budget5 = 6
    res5 = sol.maximumSaleItems(items5, budget5)
    # d=[1,1], sort prices [3,5]
    # phase1: (3,1) buy1 cost3, total_copies=2, rem=3; (5,1) rem<5 skip
    # phase2: (3,1) buy1 cost3, total_copies=3
    print(f"Two f=1: items={items5}, budget={budget5}, res={res5}, expected=3, {'PASS' if res5==3 else 'FAIL'}")
    
    # Edge: budget insufficient for high-value
    items6 = [[1,10]]  # f=1, d=0 (only one item), no other, d=0
    budget6 = 5
    res6 = sol.maximumSaleItems(items6, budget6)
    # only low-value, buy 0
    print(f"Insufficient: items={items6}, budget={budget6}, res={res6}, expected=0, {'PASS' if res6==0 else 'FAIL'}")

if __name__ == "__main__":
    test()

