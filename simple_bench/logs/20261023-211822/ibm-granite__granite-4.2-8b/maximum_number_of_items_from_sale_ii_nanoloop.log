class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        if n == 0:
            return 0
        
        factors = [item[0] for item in items]
        prices = [item[1] for item in items]
        
        max_f = max(factors)
        freq = [0] * (max_f + 1)
        for f in factors:
            freq[f] += 1
        
        total_div = [0] * (max_f + 1)
        for f in range(1, max_f + 1):
            for m in range(f, max_f + 1, f):
                total_div[f] += freq[m]
        
        d_list = [total_div[f] - 1 for f in factors]
        
        # Pair (price, d) and sort by price
        items_with_d = [(prices[i], d_list[i]) for i in range(n)]
        items_with_d.sort(key=lambda x: x[0])
        
        rem = budget
        total_copies = 0
        
        # Phase 1: high-value copies (each gives 2 copies: purchased + free)
        for p, d in items_with_d:
            if d == 0:
                continue
            if rem < p:
                continue
            max_high = d
            buy_high = min(max_high, rem // p)
            if buy_high > 0:
                total_copies += 2 * buy_high
                rem -= buy_high * p
        
        # Phase 2: low-value copies (each gives 1 copy: purchased only)
        for p, d in items_with_d:
            if rem < p:
                continue
            buy_low = rem // p
            if buy_low > 0:
                total_copies += buy_low
                rem -= buy_low * p
        
        return total_copies

