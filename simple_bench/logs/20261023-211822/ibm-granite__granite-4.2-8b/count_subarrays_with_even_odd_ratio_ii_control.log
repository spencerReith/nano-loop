import bisect

class Fenwick:
    def __init__(self, n):
        self.n = n
        self.bit = [0] * (n + 1)
    
    def add(self, i, delta):
        # i is 1-based
        while i <= self.n:
            self.bit[i] += delta
            i += i & -i
    
    def sum(self, i):
        # prefix sum 1..i, i can be 0
        s = 0
        while i > 0:
            s += self.bit[i]
            i -= i & -i
        return s

class Solution:
    def countRatioSubarrays(self, nums: list[int], a: int, b: int) -> int:
        n = len(nums)
        prefix = [0] * (n + 1)
        for i in range(n):
            if nums[i] % 2 == 1:
                prefix[i+1] = prefix[i] + a
            else:
                prefix[i+1] = prefix[i] - b
        
        unique = sorted(set(prefix))
        m = len(unique)
        
        def get_idx(v):
            # 1-based index
            return bisect.bisect_left(unique, v) + 1
        
        fenwick = Fenwick(m)
        last_odd = -1
        next_idx = 0
        ans = 0
        
        for r in range(n):
            if nums[r] % 2 == 1:
                last_odd = r
                while next_idx <= last_odd:
                    v = prefix[next_idx]
                    idx = get_idx(v)
                    fenwick.add(idx, 1)
                    next_idx += 1
            vq = prefix[r+1]
            pos = bisect.bisect_right(unique, vq)   # number of unique values <= vq
            ans += fenwick.sum(pos)
        
        return ans
