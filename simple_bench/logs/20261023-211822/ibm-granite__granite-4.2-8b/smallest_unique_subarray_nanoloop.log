class Solution:
    def smallestUniqueSubarray(self, nums: list[int]) -> int:
        from collections import defaultdict
        count = defaultdict(int)
        n = len(nums)
        for i in range(n):
            for j in range(i, n):
                sub = tuple(nums[i:j+1])
                count[sub] += 1
        ans = n + 1
        for sub, cnt in count.items():
            if cnt == 1:
                l = len(sub)
                if l < ans:
                    ans = l
        return ans if ans <= n else n

But note that if ans remains n+1 (should not happen), return n.

