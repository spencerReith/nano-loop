```python
from typing import List

class Solution:
    def findColoredRoot(self, edges: List[List[int]], colors: str) -> int:
        n = len(colors)
        if n == 0:
            return -1
        
        # Build adjacency list
        adj = [[] for _ in range(n)]
        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)
        
        # Candidate roots: nodes with degree ≤ 2
        candidates = [i for i in range(n) if len(adj[i]) <= 2]
        
        # Valid color cycles
        color_cycles = {
            'R': ['R', 'B', 'W'],
            'B': ['B', 'W', 'R'],
            'W': ['W', 'R', 'B']
        }
        
        for root in candidates:
            # DFS to check both conditions
            # We'll use depth array and parent array
            depth = [-1] * n
            parent = [-1] * n
            color_at_depth = {}  # depth -> color
            valid = True
            
            stack = [root]
            depth[root] = 0
            parent[root] = -1
            color_at_depth[0] = colors[root]
            
            while stack and valid:
                node = stack.pop()
                cur_color = colors[node]
                
                # Check if current node's color matches the depth color
                if depth[node] in color_at_depth:
                    if color_at_depth[depth[node]] != cur_color:
                        valid = False
                        break
                else:
                    color_at_depth[depth[node]] = cur_color
                
                # Check children (neighbors except parent)
                children = []
                for neighbor in adj[node]:
                    if neighbor == parent[node]:
                        continue
                    if depth[neighbor] == -1:  # not visited
                        depth[neighbor] = depth[node] + 1
                        parent[neighbor] = node
                        stack.append(neighbor)
                        children.append(neighbor)
                    # If already visited, it should be parent only (tree has no cycles)
                    
                # Check binary-tree property: node should have ≤ 2 children
                if len(children) > 2:
                    valid = False
                    break
                
                # After assigning children, check color for depth+1
                # Get expected colors for all nodes at depth+1
                # All children at depth+1 should have same color
                if depth[node] + 1 in color_at_depth:
                    expected_color = color_at_depth[depth[node] + 1]
                    for child in children:
                        if colors[child] != expected_color:
                            valid = False
                            break
                else:
                    # First depth+1 level
                    # Determine cycle from root color
                    root_color = colors[root]
                    cycle = color_cycles[root_color]
                    # depth 0: cycle[0], depth 1: cycle[1], etc.
                    next_color = cycle[1] if depth[node] == 0 else cycle[(depth[node] % 3)]
                    # Wait, need consistent cycle
                    
                    # Better: check all children have same color and it matches cycle
                    child_colors = [colors[child] for child in children]
                    if len(set(child_colors)) > 1:
                        valid = False
                        continue
                    # Check if child color follows cycle from root
                    cycle = color_cycles[root_color]
                    expected = cycle[(depth[node] + 1) % 3]  # depth 0 -> cycle[0], depth 1 -> cycle[1]
                    for child in children:
                        if colors[child] != expected:
                            valid = False
                            break
                    if valid:
                        color_at_depth[depth[node] + 1] = child_colors[0]
            
            if valid:
                # Double-check all depths have consistent color
                # Already checked during DFS, but let's verify all nodes at same depth have same color
                for d in range(max(depth) + 1):
                    depth_color = None
                    for i in range(n):
                        if depth[i] == d:
                            if depth_color is None:
                                depth_color = colors[i]
                            elif colors[i] != depth_color:
                                valid = False
                                break
                    if not valid:
                        break
                
                # Double-check color follows cycle
                if valid:
                    root_color = colors[root]
                    cycle = color_cycles[root_color]
                    for i in range(n):
                        exp_color = cycle[depth[i] % 3]
                        if colors[i] != exp_color:
                            valid = False
                            break
                
                if valid:
                    return root
        
        return -1
```

