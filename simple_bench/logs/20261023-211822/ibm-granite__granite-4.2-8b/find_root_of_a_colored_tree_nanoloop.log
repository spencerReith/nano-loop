```python
from typing import List

class Solution:
    def findColoredRoot(self, edges: List[List[int]], colors: str) -> int:
        n = len(colors)
        if n == 0:
            return -1
        
        # Build adjacency list
        adj = [[] for _ in range(n)]
        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)
        
        # Candidate roots: nodes with degree ≤ 2 (root can have ≤ 2 children)
        candidates = [i for i in range(n) if len(adj[i]) <= 2]
        
        # Helper: expected color at depth d given root color
        def expected_color(root_c, depth):
            if root_c == 'R':
                return ['R', 'B', 'W'][depth % 3]
            elif root_c == 'B':
                return ['B', 'W', 'R'][depth % 3]
            else:  # 'W'
                return ['W', 'R', 'B'][depth % 3]
        
        for root in candidates:
            root_c = colors[root]
            # DFS/BFS from root
            from collections import deque
            q = deque([root])
            depth = [-1] * n
            parent = [-1] * n
            depth[root] = 0
            parent[root] = -1
            
            valid = True
            while q and valid:
                node = q.popleft()
                
                # Check node's color
                exp_c = expected_color(root_c, depth[node])
                if colors[node] != exp_c:
                    valid = False
                    break
                
                # Check children
                children = []
                for neighbor in adj[node]:
                    if neighbor == parent[node]:
                        continue
                    if depth[neighbor] == -1:
                        depth[neighbor] = depth[node] + 1
                        parent[neighbor] = node
                        q.append(neighbor)
                        children.append(neighbor)
                
                # Binary-tree property: ≤ 2 children
                if len(children) > 2:
                    valid = False
                    break
            
            # If DFS didn't fail, re-check all nodes at same depth have correct color
            # (DFS already checked each node's color, but let's verify all nodes at depth d have same color)
            if valid:
                # Check all nodes have correct color for their depth
                for i in range(n):
                    if depth[i] == -1:
                        # Node not visited (shouldn't happen in tree DFS from root)
                        valid = False
                        break
                    exp_c = expected_color(root_c, depth[i])
                    if colors[i] != exp_c:
                        valid = False
                        break
            
            if valid:
                return root
        
        return -1
```

