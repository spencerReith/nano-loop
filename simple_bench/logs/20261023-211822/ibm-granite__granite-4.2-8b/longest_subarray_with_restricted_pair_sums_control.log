```python
class Solution:
    def maxSubarray(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 0:
            return 0
        best = 0
        MAX_VAL = 500
        # Iterate over left boundary
        for l in range(n):
            freq = [0] * (MAX_VAL + 1)  # index from 0 to 500, we use 1..500
            # Expand right as far as possible
            for r in range(l, n):
                x = nums[r]
                # Check if adding nums[r] to the current window [l, r-1] would create a forbidden triple
                invalid = False
                # Check if x + y == z for some y in window and z in window
                # Since z = x+y <= 500 to possibly exist in the array
                for y in range(1, MAX_VAL + 1):
                    if freq[y] == 0:
                        continue
                    if x + y <= MAX_VAL and freq[x + y] > 0:
                        invalid = True
                        break
                if not invalid:
                    # Check if y + z == x for some y,z in window (distinct indices)
                    for y in range(1, MAX_VAL + 1):
                        if freq[y] == 0:
                            continue
                        z = x - y
                        if z < 1 or z > MAX_VAL:
                            continue
                        if freq[z] > 0:
                            # If y == z, need at least two occurrences of y in the window
                            if y == z and freq[y] < 2:
                                continue
                            else:
                                invalid = True
                                break
                if invalid:
                    # Cannot include nums[r]; stop expanding for this l
                    break
                # Otherwise, add nums[r] to window and update best
                freq[x] += 1
                cur_len = r - l + 1
                if cur_len > best:
                    best = cur_len
        return best
