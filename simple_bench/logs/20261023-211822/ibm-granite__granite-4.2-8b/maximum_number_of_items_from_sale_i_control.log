class Solution:
    def maximumSaleItems(self, items: list[list[int]], budget: int) -> int:
        n = len(items)
        if n == 0:
            return 0
        factors = [it[0] for it in items]
        prices = [it[1] for it in items]
        
        maxF = max(factors)
        cnt_factor = [0] * (maxF + 1)
        for f in factors:
            cnt_factor[f] += 1
        
        div_cnt = [0] * (maxF + 1)
        for f in range(1, maxF + 1):
            for m in range(f, maxF + 1, f):
                div_cnt[f] += cnt_factor[m]
        
        benefits = []
        for f, p in zip(factors, prices):
            deg = div_cnt[f] - 1
            benefits.append(1 + deg)
        
        distinct_prices = sorted(set(prices))
        INF_NEG = -10**9
        ans = 0  # empty set gives 0
        
        for c in distinct_prices:
            if c > budget:
                continue
            # collect indices with price >= c
            indices = []
            for i in range(n):
                if prices[i] >= c:
                    indices.append(i)
            
            dp0 = [INF_NEG] * (budget + 1)
            dp1 = [INF_NEG] * (budget + 1)
            dp0[0] = 0
            
            for i in indices:
                p = prices[i]
                b = benefits[i]
                if p == c:
                    # can only add to dp1 (from dp0 or dp1)
                    for t in range(budget, p - 1, -1):
                        if dp0[t - p] != INF_NEG:
                            dp1[t] = max(dp1[t], dp0[t - p] + b)
                        if dp1[t - p] != INF_NEG:
                            dp1[t] = max(dp1[t], dp1[t - p] + b)
                else:  # p > c
                    for t in range(budget, p - 1, -1):
                        if dp0[t - p] != INF_NEG:
                            dp0[t] = max(dp0[t], dp0[t - p] + b)
                        if dp1[t - p] != INF_NEG:
                            dp1[t] = max(dp1[t], dp1[t - p] + b)
            
            for t in range(budget + 1):
                if dp1[t] != INF_NEG:
                    total = dp1[t] + (budget - t) // c
                    if total > ans:
                        ans = total
        
        return ans
