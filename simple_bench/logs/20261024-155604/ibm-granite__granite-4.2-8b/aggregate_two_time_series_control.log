class Solution:
    def aggregateTimeSeries(self, series1: list[list[int]], series2: list[list[int]]) -> list[list[int]]:
        # helper to get value at a given timestamp t from a series
        # series is a list of [timestamp, value] sorted strictly increasing by timestamp
        # returns the value at the smallest timestamp >= t, else 0
        def get_val(series, t):
            # binary search for first timestamp >= t
            lo, hi = 0, len(series)
            while lo < hi:
                mid = (lo + hi) // 2
                if series[mid][0] < t:
                    lo = mid + 1
                else:
                    hi = mid
            if lo == len(series):
                return 0
            return series[lo][1]
        
        # collect all unique timestamps from both series
        timestamps = set()
        for ts_val in series1:
            timestamps.add(ts_val[0])
        for ts_val in series2:
            timestamps.add(ts_val[0])
        timestamps = sorted(timestamps)
        
        # build aggregated series
        res = []
        for ts in timestamps:
            v1 = get_val(series1, ts)
            v2 = get_val(series2, ts)
            res.append([ts, v1 + v2])
        
        return res
